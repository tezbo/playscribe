{
  "name": "Playscribe",
  "voice": {
    "tagline": "The story of every update",
    "trademarkNotice": "PlayStation, PS5 and the PlayStation Family Mark are trademarks of Sony Interactive Entertainment Inc. Playscribe is not affiliated with or endorsed by Sony Interactive Entertainment."
  },
  "color": {
    "ink":       { "950": "#09080C", "900": "#0F0E14", "800": "#18161F", "700": "#24212D", "600": "#34303F" },
    "vellum":    { "100": "#FBF4E6", "300": "#EBDDC1", "500": "#CDB68D" },
    "vellumDim": { "100": "#DCD0BA", "300": "#C9B996", "500": "#A8916A" },
    "ember":     { "300": "#FFC86A", "500": "#FFA94D", "600": "#F2813A" },
    "accent":    { "base": "#FFB04F", "pressed": "#FFC679", "on": "#2A1600", "soft": "rgba(255,176,79,0.16)" },
    "text":      { "primary": "#F4EEE3", "secondary": "#B9B1C3", "tertiary": "#958DA0" },
    "icon":      { "bgTop": "#3B2D57", "bgBottom": "#141019", "darkTop": "#1C1824", "darkBottom": "#08070B" },
    "glass":     { "fill": "rgba(15,14,20,0.55)", "stroke": "rgba(251,244,230,0.18)" }
  },
  "type": {
    "display": "Literata (OFL), static 72pt and 24pt optical instances",
    "text": "Instrument Sans (OFL)",
    "ios": {
      "largeTitle":  { "font": "Literata72pt-SemiBold",      "size": 34, "relativeTo": "largeTitle" },
      "title":       { "font": "Literata72pt-SemiBold",      "size": 28, "relativeTo": "title" },
      "title2":      { "font": "Literata24pt-SemiBold",      "size": 22, "relativeTo": "title2" },
      "title3":      { "font": "Literata24pt-SemiBold",      "size": 20, "relativeTo": "title3" },
      "pullQuote":   { "font": "Literata24pt-MediumItalic",  "size": 20, "relativeTo": "title3" },
      "headline":    { "font": "InstrumentSans-SemiBold",    "size": 17, "relativeTo": "headline" },
      "body":        { "font": "InstrumentSans-Regular",     "size": 17, "relativeTo": "body" },
      "callout":     { "font": "InstrumentSans-Regular",     "size": 16, "relativeTo": "callout" },
      "subheadline": { "font": "InstrumentSans-Regular",     "size": 15, "relativeTo": "subheadline" },
      "footnote":    { "font": "InstrumentSans-Regular",     "size": 13, "relativeTo": "footnote" },
      "caption":     { "font": "InstrumentSans-Medium",      "size": 12, "relativeTo": "caption" },
      "caption2":    { "font": "InstrumentSans-Medium",      "size": 11, "relativeTo": "caption2" }
    }
  },
  "motion": {
    "splashHoldMs": 800, "splashFadeMs": 300,
    "coverBugOpenMs": 2000, "coverBugSpring": "response 0.35, damping 0.85"
  }
}
