  {
   "id": "upin-ipin-universe-347867@1",
   "gameId": "upin-ipin-universe-347867",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-08-12T07:03:56.000Z",
   "notes": [
    {
     "title": "First Patch",
     "items": [
      {
       "text": "We’ve been listening to your feedback and working hard to bring you a smoother, more enjoyable experience in Upin & Ipin Universe. Patch 1 delivers a variety of improvements, bug fixes, and polish to make your adventures even better! Here’s what’s new: - Better visuals & lighting – Nighttime scenes now look more atmospheric, with smoother motion and",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "reduced ghosting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45684481/b9ef410c7340238d50621c0e5c42ffa4bb6029f3.jpg\"]- Gameplay fixes – Improved bike controls, RC racing updates, and more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quest adjustments – “Chef Ehsan” quest is now easier to master.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fixes – From animations to trophies, we’ve tackled player-reported issues.: Whether you’re racing RC cars, completing quests, or just enjoying the world, we hope these updates make your journey even more fun.: Please do check out the full patch notes below: [img src=\"{STEAM_CLAN_IMAGE}/45684481/5566c7277ae05bbb1c9c0b511b0796e604908234.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch 1 Notes – Steam",
     "items": [
      {
       "text": "Tarik Upih Animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Tarik Upih now displays the correct in-air animation when airborne.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bike Camera Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Auto-centering camera is now disabled by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bike camera is now fully controllable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Trophy System Bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue preventing trophies from unlocking properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Nighttime Lighting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved nighttime lighting for better atmosphere and visibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "RC Car Racing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added player indicators for both Upin and Ipin in RC car racing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "RC units no longer collide with players, and players no longer block each other.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save System",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved save system stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced the risk of data corruption.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "“Chef Ehsan” Quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made it significantly easier to achieve the “Perfect Chef” ranking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed dialogue freeze during the “Chef Ehsan” quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "NPCs Near Water",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where NPCs would appear near rivers and ponds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "General Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General bug fixes and polish based on player feedback and internal testing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General Visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced motion blur and TAA for smoother visuals and reduced ghosting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Jumping Animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed T-pose issue when jumping onto beds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Note: Existing progress and saved data remain unaffected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing and supporting Upin & Ipin Universe! Keep sharing your feedback, it helps us make the game even better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
