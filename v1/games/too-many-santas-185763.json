   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-01-12T14:32:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ho ho ho, merry—uh, January! I've got the traditional January present for you! It's an update for Too Many Santas! Enjoy!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added to our stable of creepy animations by making Sexy Santa dance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an auto-text button to the bottom of the screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a quit button to the bottom of the screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made a line less creepy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed someone's pajamas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected various typos in both Achievements and the game (sorry, Nathaniel \"Hover\"!!!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
