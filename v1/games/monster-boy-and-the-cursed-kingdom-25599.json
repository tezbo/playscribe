  {
   "id": "monster-boy-and-the-cursed-kingdom-25599@2",
   "gameId": "monster-boy-and-the-cursed-kingdom-25599",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-06-26T12:55:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we hope you're all enjoying summer! BTW: Please play Bloodstained! ^_^",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we'd like to inform you about a new update of the demo, addressing the crash bugs that some users encountered. It was caused by non-Ascii character Windows User names and should now be fixed. Please update the demo and try if it works now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always your feedback is very welcome!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "..just a few more weeks until the PC release of Monster Boy and the Cursed Kingdom ..(finally!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
