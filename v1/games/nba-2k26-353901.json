  {
   "id": "nba-2k26-353901@7.0",
   "gameId": "nba-2k26-353901",
   "displayName": "Patch 7.0",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-05-14T18:46:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update is expected to release on Steam on May 15, 2026.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "🔗 http://discord.gg/nba2k",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GENERAL",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Preparations for NBA 2K26 Season 7, launching on Friday, May 15, at 8 AM PT / 11 AM ET / 4 PM BST. Stay tuned for what we have in store!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "WNBA",
     "items": [
      {
       "text": "The Portland Fire and Toronto Tempo are now available as playable teams in WNBA Quick Play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Uniforms and court floors for all WNBA teams are now updated with the latest changes for the 2026 season.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "GAMEPLAY",
     "items": [
      {
       "text": "Refined drive transitions from standing stepback moves to better align with real-world player momentum and physics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "MyNBA",
     "items": [
      {
       "text": "Fixed a blocker that could occur during the NBA Cup when using a non-standard schedule.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
