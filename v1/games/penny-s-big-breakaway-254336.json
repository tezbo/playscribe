     "items": [
      {
       "text": "Penny's Big Breakaway 1.2.20240313 is now live",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This is a hotfix build with the following changes",
     "items": [
      {
       "text": "Adjusted ice physics behavior and turn momentum",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
