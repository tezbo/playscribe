   "announcedAt": "2023-11-13T14:44:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This small patch contains various minor improvements and fixes to issues, some of which were reported by players. Thanks to all who have helped us to spot and diagnose issues, and we hope you're enjoying your time with Saltsea Chronicles!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an audio bug which prevented music from playing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an audio bugs which led to several overlapping music tracks playing at once",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several bugs in the card game which may have previously blocked some players from playing Spoils",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Altered Spoils slightly: removed the hoarding and bidding rules from the early chapters, where those rules haven’t been introduced by tutorials yet",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug related to scrolling after interrupted lines in a conversation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Pressing the cancel button while in a conversation now also moves the conversation forward",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a problem with Crew Issues and Crew Issue resolution conversations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a visible version number in the Main Menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Replaced save icon graphic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor bug fixes and polish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
