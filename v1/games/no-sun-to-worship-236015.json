 "releases": [
  {
   "id": "no-sun-to-worship-236015@major-2025-06-04",
   "gameId": "no-sun-to-worship-236015",
   "displayName": "More Sun to Worship - New Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-04T17:32:50.000Z",
   "notes": [
    {
     "title": "New Update, New Trailer, New Friends",
     "items": [
      {
       "text": "Merlino Games and Hyperstrange are joining development and publishing forces. Together we’re not only planning to bring No Sun To Worship to any major console, but also to deliver some well-deserved updates to the current Steam version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "The First of Many",
     "items": [
      {
       "text": "In today’s update we bring you not only an additional game difficulty and improved gamepad experience, but also a plethora of small fixes and additional localizations. You can find full patch notes here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player can now select if he wants to hold or toggle for a specific action (like aiming, crouching, etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player can now change weapons when aiming",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We added speedrun timer that can be now visible during the run (it can also be turned off)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Easy mode - enemies have less health, their perception range is decreased and they deal less damage to the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Best times are now shown separately for each difficulty mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved gamepad navigation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Implemented localization to: Spanish, Polish, Japanese, Korean, French, German & Brazilian Portuguese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Various bug fixes implemented",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a tutorial explaining how to shoot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added ability to browse the menu using both the stick and D-Pad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed sneaking boots - now correctly mute footsteps when turned on",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed menu's UI styling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed player getting stuck in locker when spamming the action button",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed saving/loading of all settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the player could jump out of the map by interacting with a \"Climb\" prompt on the side of a rock shelf",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed \"Master Volume\" functionality — it now properly affects music, SFX, UI, and videos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed stealth kills failing when the enemy was moving or rotating",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed chest containing 5 pistol bullets incorrectly giving 10 bullets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed camera sensitivity and invert Y settings not taking effect until reloading the level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where selecting Mission 1 might not work properly after completing the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the first prisoner in Mission 1 - now faces away from the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed misaligned hitboxes for light sources",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed unlocked doors can now be opened instantly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed dead bodies - now they no longer provide cover from enemy attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed broken light collider that blocked enemy AI line of sight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
