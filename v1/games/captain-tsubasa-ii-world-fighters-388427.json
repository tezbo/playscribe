  {
   "id": "captain-tsubasa-ii-world-fighters-388427@1.05",
   "gameId": "captain-tsubasa-ii-world-fighters-388427",
   "displayName": "Update 1.05",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-16T04:41:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for your continued support of \"Captain Tsubasa 2: WORLD FIGHTERS.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As of September 16, 2026, we have released the Ver. 1.05 patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To ensure you can enjoy the game comfortably, please be sure to apply the latest update file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Update Details]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed an issue where a crash would occur after Santana's post-match goal animation in the Vs. La Boca Youth story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Adjusted the timing and frequency of when the CPU opponent uses Tackles and Super Tackles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Other minor fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your continued support of \"Captain Tsubasa 2: WORLD FIGHTERS.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
