   "kindBasis": "studio",
   "announcedAt": "2026-08-31T09:21:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for your continued support of \"Captain Tsubasa 2: WORLD FIGHTERS.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As of August 31, 2026, we have released the Ver.1.04 patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To ensure you can enjoy the game comfortably, please be sure to apply the latest update file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Update Details]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed an issue where a crash would occur after some parts in the story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed an issue in some languages where the text incorrectly implied that multiple Custom Players could be created, contrary to the intended game specification.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed an issue where Goalkeeper Skills could sometimes activate for certain teams even when the required activation conditions were not met.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Other minor fixes and improvements..",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your continued support of \"Captain Tsubasa 2: WORLD FIGHTERS.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
