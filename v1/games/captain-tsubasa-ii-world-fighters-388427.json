 "releases": [
  {
   "id": "captain-tsubasa-ii-world-fighters-388427@1.06",
   "gameId": "captain-tsubasa-ii-world-fighters-388427",
   "displayName": "Update 1.06",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-11-02T11:35:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As of November 2, 2026, we have released the Ver. 1.06 patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To ensure continued enjoyment,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "please be sure to update to the latest version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[In-Game Pacing Improvements]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Reduced Tackle movement speed by 10%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Expanded the collision detection area for dribbling to the sides and rear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Reduced the time required to activate Super Shot/Super Pass/Super Dribble.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased the charge speed of Shoot at Chain Levels 1–3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Shortened some animations for the three general-purpose S-rank tackles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Pass Tempo Improvement]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Reduced recovery time when receiving a short pass.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Full-Power Dribble Adjustment]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Reduced the startup time for Full-Power Dribble.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Reduced damage taken while sprinting at full speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Dash and Stamina Adjustments]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased stamina consumption when dashing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased the rate at which stamina recovers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Aerial Shot Adjustment]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased the distance to goal when performing a regular aerial shot from a cross.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Camera Adjustment]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted all camera distances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted the camera zoom distance when a dribble connects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Improved Controls]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted dribble activation direction to prioritize the direction of the stick input over the player's facing direction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue where the controlled player would automatically switch during Tackle Charge/R1 Dash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Balance Adjustments for Each Team]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Indonesia",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased the amount of Super Move Gauge gained from Jawato's passive ability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Changed the HP condition required for Jawato to activate the Team Move \"Great Heart Saving\" from \"40% or less\" to \"60% or less,\" increasing the activation rate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■USA",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased the amount of Super Move Gauge reduced by Azwan's passive ability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Uzbekistan",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Changed the score requirement for activating the team move \"Atrophy Blaster\" from \"2 or more\" to \"1 or more.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Extended the duration of the effect that prevents the enemy team's Super Move Gauge from increasing when using the Team Move \"Atrophy Blaster.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Argentina",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Changed the number of dribble breakthroughs required by Diaz to activate the Team Move \"Untouchable Genius\" from \"10 or more\" to \"7 or more.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased the stat boost Diaz receives from the Team Move \"Untouchable Genius.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Mexico",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Changed the number of required matching directional inputs for Espadas to activate the team move \"Warriors of the Sun\" from \"3 or more\" to \"2 or more.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Senegal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Extended the duration of the Team Move \"Raging Torrent.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Cameroon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased the potency of Chandler's stat boost from the Team Move \"Lightning Bolt.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Sweden",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Changed the number of Levin's shoot moves required to activate the team move \"Destroyer Attack\" from \"3 or more\" to \"2 or more.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■France",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Shortened the duration of the Team Move \"Field of Dreams\" effect that prevents Pierre's and Napoleon's Super Move Gauges from decreasing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Japan",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased the amount of Super Move Gauge required from your team to activate the Team Move \"Full Power Skydive.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[STORY and Mission Adjustments]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Mission completion requirements have been relaxed for certain missions in the following matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Target Match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Toho Match / Saudi Arabia Match / Uruguay Match / Sweden Match / Argentina Match / France Match / Italy Match / South Korea Match / England Match / Senegal Match / Germany Match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In STORY mode, we have reduced the normal shot and normal aerial shot performance of the target players in the following matches/difficulty levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Target Match/Player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rio Match: Carlos Santana (Easy/Normal) / Narugahama Academy Match: Ryoma Hino (Easy/Normal) / RJ7 Match: Ryoma Hino (Easy/Normal) / Thailand Match: Konsawatt Brothers (Easy/Normal) / Cameroon Match: Raymond Chandler (Normal) / Argentina Match: Juan Diaz (Normal)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted the probability of goalkeepers performing a \"PERFECT SAVING\" in specific situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Improved In-Match Display]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted the display animation to make it easier to distinguish between confirmed damage and damage that will be healed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Enhanced the display when there is little time remaining in a match.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Improved Match Start Guidance]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added text in the upper left corner of the screen during the pre-match entrance sequence to indicate that it can be skipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your continued support of \"Captain Tsubasa 2: WORLD FIGHTERS.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
