  {
   "id": "motogp-23-243215@patch-2023-07-10",
   "gameId": "motogp-23-243215",
   "displayName": "New Patch Released",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-10T14:24:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new game patch for MotoGP™23 has been released.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The riders and bikes of the Moto2™ current season are now available! But that's not all: we have also found a better balance for the AI performances to make your experience even more realistic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discover more below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GAME CONTENT",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Riders & Bikes of the Moto2™ has been updated to the latest changes of the current season.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "COMMUNITY FEEDBACK",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Following your comments, we have worked a lot to improve AI: we have found a better balance for the AI performances in managing the PWR electronic help to make your experience even more balanced and realistic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
