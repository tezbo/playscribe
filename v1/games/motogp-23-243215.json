  {
   "id": "motogp-23-243215@patch-2023-06-21",
   "gameId": "motogp-23-243215",
   "displayName": "NEW PATCH RELEASED",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-06-21T09:02:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Enjoy the Moto3™ class update on MotoGP™23! Also, thanks to your feedback, we have worked on the stuttering and disconnection issues in LiveGP events to improve your experience. Find out more below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GAME CONTENT",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Riders & Bikes of the Moto3™ has been updated to the latest changes of the current season.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "COMMUNITY FEEDBACK",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Following your comments, we have worked a lot to improve game performances and reduce stuttering issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also have investigated disconnection issues on the LiveGP events to improve the overall experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ONLINE",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Online matches: It’s now possible to see how many warnings & penalties has each opponent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve slightly changed the format of the events of the LiveGP. Now it’ll be possible to join events during all the planned time slot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "CAREER",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Manufacturer Leader now changes according to the riders’ final championship position.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added combined sessions screen during the P2 of Moto2™ & Moto3™.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "GAME INTERFACE",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New curve indicators added on all circuits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Low Fuel indicator in the HUD.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
