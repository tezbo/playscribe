  {
   "id": "knockout-city-143615@post-2021-06-23",
   "gameId": "knockout-city-143615",
   "displayName": "Bug Report: RESOLVED",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-06-23T16:57:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "RESOLVED",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We deployed an update to fix the bug that impacted some players on PC with non-ASCII Windows usernames. Please re-launch the game, and have fun out there on the field!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "---",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve found a bug that impacts some players on PC with non-ASCII Windows usernames. If you’re affected, the game might crash at launch. The team is already working quickly on a patch to fix the issue and will update you with more information as soon as we have more to share.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
