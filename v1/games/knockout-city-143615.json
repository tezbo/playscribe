  {
   "id": "knockout-city-143615@major-2022-06-01",
   "gameId": "knockout-city-143615",
   "displayName": "Knockout City Season 6: City of Tomorrow",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-01T12:06:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 6.0 brings a ton of new features and updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Free-to-Play - All players can now play Knockout City for free, with no restrictions!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boomerang Ball - This high-tech Special Ball will come back to you after a hit, armed and ready to throw again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hideout Expansions - Brawlers now have a new rooftop with a soccer ball and goals, basketball hoops, new parkour paths, and more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A lot more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For full details, see our patch notes here: https://www.reddit.com/r/KnockoutCity/comments/v2fbcm/patch_notes_60/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
