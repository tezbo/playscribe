  {
   "id": "colossal-cave-215119@1.1",
   "gameId": "colossal-cave-215119",
   "displayName": "UPDATE 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-01-27T22:15:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Music pauses when opening a menu and resumes when closing, instead of stopping it altogether.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Localization/translation fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Grate hint particle effect properly appears after first time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Maps can fully reset without needing to close and reopen the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added a more detailed description when taking instructions, offers additional chance to confirm if you want to take instructions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Maze Different now offers a hint if you haven't taken it in Maze Alike. Hint shows after 50 moves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fix to Repository camera.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
