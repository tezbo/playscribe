  {
   "id": "house-140372@1.5.1",
   "gameId": "house-140372",
   "displayName": "Patch 1.5.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-02-01T23:12:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some of these changes have already been implemented, but I'm going to condense them all here. We have more bugfixes & balance changes on the way, but here is a comprehensive list of what has changed so far. Patch notes contain spoilers for 1.5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "The piano demon will no longer follow you out of rooms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pressing S while holding wine now works as intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now speak to dad while he is squirming",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Playing Grandma’s song will now summon her if you play it before 2AM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the Piano Demon speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the Lady Spirit speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Talking to The Seamstress has been streamlined",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the \"Family\" ending visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the \"Memories\" ending visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue that caused the cat not to spawn in the tv scene, despite being saved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some sound mixing issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that allowed players to change the channel after selecting Tabby/Melody channels on TV",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the doll to disappear when picked up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused mom’s chat box interface to not appear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the “toggle fullscreen” button not to work",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the achievement “Hey Girl,” to not unlock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the tv scene to stop taking inputs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where loading Tabby’s loop from the TV scene would cause the lights in the hallway to remain off",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where if you died in Tabby's loop you would restart as Melody",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Known Issues",
     "items": [
      {
       "text": "Crashing upon dying / randomly crashing in Melody's loop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Long load times on startup",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are still working on optimizing the new content and hope to get everything as smooth as possible for y'all. Thanks again so much for playing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
