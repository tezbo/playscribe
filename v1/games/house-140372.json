  {
   "id": "house-140372@1.6.1",
   "gameId": "house-140372",
   "displayName": "Update 1.6.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-08-09T10:09:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we've been hard at work optimizing our engine in preparation for the release of house 2. finally found some time to port over house 1 to the new engine. this should hopefully eliminate the crashes that have plagued the game. thank you all for your patience. i was working with a slightly older build than the one that was most recently on here, so there may be some missed bugs that have returned or new ones from this engine upgrade. there will be more fixes to come in the near future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "house 2 launch is imminent! love you all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
