  {
   "id": "house-140372@1.4.3",
   "gameId": "house-140372",
   "displayName": "Patch 1.4.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-25T02:34:27.000Z",
   "notes": [
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "The Frog Lord no longer teabags your corpse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where saying no to Marty and then talking to Dolly would cause the game to lock up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the length of Frog Lord stun to 1.5 seconds from 1.0 seconds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted giggling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The Centipede wiggle sound now pauses if you are in conversation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed multiple sound-related issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Killing Melody while sitting now plays the correct facing animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added additional dialog for Marty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some visual inconsistencies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused some characters and UI to appear mirrored",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that disabled the ability to pick up the rubber ducky when time is frozen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue the caused mom to get frozen after placing sandwiches on the table",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The slingshot no longer collides with certain objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Seamstress now slips on water",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The time for Seamstress tripping has been decreased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Frog Lord now appears closer to the door he spawns into",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the slingshot would collide with empty space",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
