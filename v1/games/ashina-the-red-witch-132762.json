  {
   "id": "ashina-the-red-witch-132762@post-2021-09-30",
   "gameId": "ashina-the-red-witch-132762",
   "displayName": "Beta patch notes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-09-30T12:39:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello beta testers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[ CHAPTER SELECT MENU ]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Before I post the patch notes, I would just like to inform you all that I've added a debug key to access the chapter select menu in case of save file corruption when updating the beta. To activate it, start a new game then wait until you have control of Ash, press the key and a message should display then restart the game. The chapter select menu should appear in the title menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the latest patch notes",
     "items": [
      {
       "text": "28/09/2021",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Options menu will scroll back to top if past last option and vise versa",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed some collisions in the bathhouse baths area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed dialogue with oven after Tanto burns it down",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed dialogue with Blue lady repeating bath salt request",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed colour puzzle with the chomin in bathhouse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed collisions in Shiruta chapter, especially with stairs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed collisions in Bathhouse chapter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Locked Yoko's door when Ash has to take a bath stopping Yoko's repeating dialogue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Removed re-entering the foyer in the witch's house from the theatre",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Removed old debug keys causing Ash to disappear and freeze the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "29/09/2021",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed Proofread.tra error on start up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed missing audio when returning to Chikara via bus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed Nikuya's dialog mixing the 2nd and 3rd task",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed Tanto's graphical glitching in the CHikara chapter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Added a key to skip the item found screen, press anything to skip it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Shortened \"Stranga Games Presents Intro\" by pre-loading data in the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "30/09/2021",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed a few spelling/ grammatical errors in Shirtua chapter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed bathhouse graphics with more up to date ones",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-) Fixed more collisions in bathouse.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
