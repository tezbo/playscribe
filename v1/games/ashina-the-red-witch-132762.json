   "kindBasis": "studio",
   "announcedAt": "2023-01-11T10:31:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone, this is just a quick patch that includes fixes for:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chinese font for dialogue choices",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Locked being able to explore the bathhouse before seeing Muma first",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Gus's Shiruta puzzle with repeating dialogue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Trix's line about the boombox",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some more grammatical errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various small improvements with code.: Warning: Updating could result in possible corrupted save files, here's how to fix them!: To fix the save file issue, you will have to revert to a previous update. To do this; right click the game in your steam library and go to properties, under the beta tab select the dropdown box and select a rollback version (rollbackversion0.2 to be precise) until your save files work again",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
