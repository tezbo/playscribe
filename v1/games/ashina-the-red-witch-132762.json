   "id": "ashina-the-red-witch-132762@post-2022-11-03",
   "gameId": "ashina-the-red-witch-132762",
   "displayName": "Fix corrupted save files",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-03T19:41:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone, firstly, I am deeply sorry for the save files breaking after the last two updates, I should have sent a warning about this happening as it frequently does with all my games due to using outdated software.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I HAVE A FIX!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To fix the save file issue, you will have to revert to a previous update. To do this; right click the game in your steam library and go to properties, under the beta tab select the dropdown box and select a roll back version until your save files work again",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
