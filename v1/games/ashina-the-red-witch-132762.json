   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-05T02:06:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hope you are all enjoying the game :) I've received a lot of great feedback and I've added some minor fixes to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch includes",
     "items": [
      {
       "text": "Fixed some repeating interactions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Grammatical errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cutscene in Chikara not triggering after leaving sushi restaurant (This will need a previous save in order: to work properly, before you retrieve the cigarettes for Nikuya )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Tanto's face sprite in HUD when switching back to Ash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other small minor improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "IF YOUR SAVE FILE HAS CORRUPTED AFTER THE UPDATE",
     "items": [
      {
       "text": "You can access the previous version by heading into the Steam library settings and accessing the betas tab, then selecting rollbackversion0.0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
