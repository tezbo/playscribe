  {
   "id": "trek-to-yomi-152203@1.01",
   "gameId": "trek-to-yomi-152203",
   "displayName": "Update 1.01",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-05-20T15:28:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey there Samurai Warriors! Thank you for playing our game and sharing your experience with us! We appreciate all the feedback that we have received. It really helped us in the process of working on our first patch for Trek To Yomi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please keep the feedback coming, we are open to suggestions and would love to hear from you. The best way to reach us through is our Discord server or by opening a discussion here in the steam forums!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full Patch notes",
