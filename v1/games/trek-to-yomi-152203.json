   "id": "trek-to-yomi-152203@1.03",
   "gameId": "trek-to-yomi-152203",
   "displayName": "Update 1.03",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-02T16:46:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings Samurai! Today's Trek To Yomi update provides quality-of-life and performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "without further ado here are the patch notes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Adjusted loading screen timing so terrain segments load properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed crashes caused by random error",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "General UI optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed player transition in Chapter 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with Hiroki landing and attacking enemies who still haven't entered the combat in Chapter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Disabled the ability to climb on some environmental elements in Chapter 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed improper camera placement after using a shrine in Chapter 6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed constant camera shake in chapter 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed enemy spawn in chapter 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted collisions in chapter 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Disabled the ability to climb and jump off the wall in Chapter 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Audio update and optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
