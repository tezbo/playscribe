  {
   "id": "trek-to-yomi-152203@1.02",
   "gameId": "trek-to-yomi-152203",
   "displayName": "Patch 1.02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-06T14:05:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings Samurai! In today’s patch we are addressing the game’s combat system and more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As you can see in the patch notes, there are several changes done to the parry and counter attack system as well as other combat changes. We really hope that they are move in the right direction and that you- the players, will approve those changes. We are looking forward to your feedback, so make sure to share your experience with the new patch, here on Steam or on our Discord Server!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Improvements to Counter/Parry tutorial part were made",
     "items": [
      {
       "text": "Time stops and the tutorial pauses for the moment of the 1st successful Parry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Time stops and the tutorial pauses again, for the moment of the 1st successful Counter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Counter attacking was tweaked",
     "items": [
      {
       "text": "Slow motion was removed after successful Parry to make counter attacking easier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Successful Counter attack can be now performed slightly earlier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Parrying was improved",
     "items": [
      {
       "text": "Some of enemies initial attacks were slightly slowed down, to increase the chance of a Player reaction",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Successful parry window for some enemies has been tweaked - according to the their attacks animation: Other changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed stun from light overhead combo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed timings of some animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Player path is now more visible and clear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player now can use a double counterattack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ghoul counter attacks were tweaked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player now rotates automatically while falling down",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue with NPCs collapsing if certain conditions are met",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "D-pad icon now turns white when used",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localization improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue with losing health and stamina upgrades after saving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "HP points now instantly disappear after being hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a rare bug with losing inputs after performing a specific combo and switching shots during its animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjustments to Sadatame in chapter 5 were made",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a glitch with turn around animation while in tired state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a glitch with NPC in cages on chapter 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the parry distance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue with puzzles on chapter 5 and chapter 6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improvements to UI in the inventory menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed rare bug when players are losing all upgrades while entering chapter 7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with skipping dialogues with a few NPCs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with hiding a katana while attacking enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with Heavy Brute attacks not affecting the player in certain conditions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ashigaru Marksman shooting speed was adjusted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where player was unable to rotate or move after using bo-shuriken in tired state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
