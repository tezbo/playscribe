   "notes": [
    {
     "title": "Full Changelist",
     "items": [
      {
       "text": "Bonus Materials",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added \"The Dead Shall Rise” Kickstarter Backers list to the Credits section.",
