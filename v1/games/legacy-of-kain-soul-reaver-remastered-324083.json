  {
   "id": "legacy-of-kain-soul-reaver-remastered-324083@1",
   "gameId": "legacy-of-kain-soul-reaver-remastered-324083",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-01-30T17:14:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1 for Legacy of Kain™ Soul Reaver 1 & 2 Remastered is here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Below is a list of resolved issues and various updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full Changelist",
     "items": [
      {
       "text": "The lighthouse’s beam is no longer missing (after being activated to obtain the Glyph).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An additional prompt has been added to the Underworld tutorial in SR1 for accessing the Glyph menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A toggle has been added to enable/disable the Day/Night cycle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Bell in the Silenced Cathedral is no longer cut off after being hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an occasional crash issue triggered when Raziel was killed by a flamethrower hunter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the environment to de-spawn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Great Old One Achievement in SR1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the backward hand in SR1 for the vampire hunter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Raziel could occasionally become stuck in a room with a T-pose Moebius after skipping a cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Black cubes are no longer present on the Air Forge mummies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When playing through the Oracle Caves, Cubes will no longer get stuck in each other.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The display no longer squishes horizontally to fit the screen instead of cropping the sides when the aspect ratio is narrower than 16:9 on PC Steam and Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "After disconnecting the controller, the game will automatically open the pause menu in either title.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A visual effect is now present when accessing and leaving the visions in the Chronoplast.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Split trophy / achievement no longer progresses when killing a Sorcerer Thrall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Directional inputs can now be bound to the arrow keys.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now press pause while watching the Bonus Materials movies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Certain tutorial prompts no longer display the incorrect button prompt in non-English languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that the addition of the Kickstarter backer names will be implemented for the Day 60 patch, which is anticipated to be released in Late March 2025. More information soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
