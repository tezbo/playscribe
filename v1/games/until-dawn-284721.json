   "gameId": "until-dawn-284721",
   "displayName": "Patch 1.05",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-12T11:01:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Welcome back, friends and fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Until Dawn Patch 1.05 is now live for PS5 & PC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "🔧 Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for Mike sliding around the Sanatorium in Chapter 9",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for Chris dropping into place after viewing the Wanted Poster clue in Chapter 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Performance fixes to address black screens and frame drops",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Performance improvements for lower spec PCs & Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Touchpad for certain interactions on DualSense wireless controller now enabled by default (if you have already installed the game, reverting controller settings to 'Default' will apply this fix)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for AMD FSR's Frame Generation not working as intended",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for VSync setting not working as intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for Resolution Scale setting issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for dll error causing Steam Deck to fail on boot",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for crash which occurred when booting the game whilst it is still installing on PS5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fix for transcript scrolling not working via mouse",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for a crash that occurs around the shed in Chapter 8",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for HDR settings not functioning as intended on PC",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixes for some frame pacing issues on PS5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fix for Screen Resolution % resetting to 25 when settings were changed, which resulted in pixelated visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for settings not being saved when exiting the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for UI prompts appearing off-screen when playing in 16:9 aspect ratio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Upgraded to FSR 3.1.1 (Unreal) which fixed some Frame Generation feature issues",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for Sam being trapped outside of the Sanatorium in Chapter 9",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed stuttering when viewing in-game movies (Butterfly Effect, Sam Bus sequence)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Save/Load fixes to address blockers when hitting Continue to play (fixes progression blockers throughout the whole game. This fix will retroactively fix any previously affected saves, also)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for Dolby Atmos not working as intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other miscellaneous fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🧠 Known Issues/Fixes to come (issues we are aware of, and are actively working on fixes for)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Frame Generation is not fully independent of using an upscaler",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Full monitor selection support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Raytracing tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes for potential login issues with the PlayStation Overlay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fix for anti-virus interfering with the game and the crash reporter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some people have reported issues with anti-aliasing and DLSS. We will be investigating this with NVIDIA",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Temporal Super Resolution is getting an upgrade to fix some of the issues with aliasing on hair and other areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "HDR is currently exclusively fullscreen only, and will be changed to support Borderless etc.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We are working with our partners at AMD to address any ongoing issues with FSR and Frame Generation. If you experience issues when using it (such as crashes) please let us know. We will continue to closely monitor player bug reports in preparation for our next update.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Stay safe... it's dark out there. 💀⛰️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Ballistic Moon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
