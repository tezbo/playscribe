   "notes": [
    {
     "title": "Update 8th November 2024: 1.06 is now live for PC!",
     "items": [
      {
       "text": "Welcome back, friends and fans!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Until Dawn Patch 1.06 is now live for PS5 and PC. To avoid spoilers, we've included some spoiler tags below. You've been warned!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "This major update brings a boat-load of fixes for commonly reported issues, plus new Performance and Fidelity modes for both PlayStation 5 and PlayStation 5 Pro.",
       "ps5ProOnly": true,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "✨What's New for 1.06",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Performance Mode (PS5 & PS5 Pro only, prioritises FPS)",
       "ps5ProOnly": true,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fidelity Mode (PS5 & PS5 Pro only, prioritises Graphics)",
       "ps5ProOnly": true,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Monitor switching support for PC",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "🔧 Fixes",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for anti-virus interfering with the game and the crash reporter",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for a crash that occurred when pausing the game during pre-rendered videos",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for character models appearing briefly when pausing the game",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for CPU performance issues on PCs where the system supports Ray tracing but it is not enabled",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for Mike being stuck in the Sanatorium during Chapter 5 (Wolfie cutscene not triggering)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
