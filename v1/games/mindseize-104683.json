  {
   "id": "mindseize-104683@hotfix-2020-09-28",
   "gameId": "mindseize-104683",
   "displayName": "Dash Kick Boots + Shadow Dash hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2020-09-28T15:42:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just updated MindSeize with a small hotfix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prior to the patch, if the player had both the Dash Kick Boots and the Shadow Dash, it was possible to get stuck to enemies for a second if trying to dash through them while not having enough energy to perform a shadow dash (10).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That should not happen anymore after the hotfix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
