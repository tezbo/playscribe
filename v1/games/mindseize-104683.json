  {
   "id": "mindseize-104683@1.2.4",
   "gameId": "mindseize-104683",
   "displayName": "Patch 1.2.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-07-06T15:49:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "MindSeize was patched to version 1.2.4. The patch includes some bugfixes, as well as a two new short radio conversations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "Added 2 radio conversations on Takomo 7. One after a certain accident and one when first entering a dark area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Guardians on Takomo 7 sometimes receiving no damage when they should",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a possible bug with the mushrooms on Verdant Gamma",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The achievement for beating the Boss Rush can no longer be accidentally obtained by playing just boss rematches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nerfed the damage reduction of U1M4 Gear (black armor) a bit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Boosted the touch damage of the electric Lurkers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slight update to weather effect performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And that would be all for now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kamina Dimension Crew",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
