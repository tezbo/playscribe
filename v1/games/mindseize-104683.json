  {
   "id": "mindseize-104683@1.3.1",
   "gameId": "mindseize-104683",
   "displayName": "Update 1.3.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2020-09-25T17:12:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We just released a small patch to MindSeize, bringing the game to version 1.3.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's changelog",
     "items": [
      {
       "text": "Made the area containing the secondary elevator to Takomo Rooftops more memorable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the attack speed of Jet Spear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a recently surfaced bug that would cause your drone to freeze if killing Thyr's drone while hacking it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some enemies and Frederik's dog sometimes getting stuck in turn animation loop, especially when near a ledge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "And that's all for now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
