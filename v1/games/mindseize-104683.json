  {
   "id": "mindseize-104683@patch-2020-07-31",
   "gameId": "mindseize-104683",
   "displayName": "A tiny patch with 2 small improvements, internal resource management improved.",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-07-31T14:59:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "MindSeize was just updated with a small patch that simplifies and improves the internal memory and resource management that happens when the game is saved, gets paused or when the player moves to a different room. This will mostly not be visible to the player, but in some cases might improve the loading times a bit. It should (hopefully) also fix a rare crash tied to the system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The patch also adds a \"Game Saved!\" text when entering your base ship and fixes the Grenadiers on Research Facility sometimes shooting towards wrong direction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kamina Dimension Crew",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
