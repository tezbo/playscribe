  {
   "id": "mindseize-104683@major-2020-08-01",
   "gameId": "mindseize-104683",
   "displayName": "A quick platforming update that was omitted from the yesterday's patch",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-08-01T10:27:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Just released a small patch that improves some of the platforming sections on the Research Facility and a bit on Takomo 7.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This one comes very quickly after the last patch, but we figured it would still be worth patching in without waiting for the next bigger update. We've actually had these updated sections ready for a couple of weeks, but as we were watching some of the content you guys have been creating on YouTube and Twitch we noticed, that they were not brought over to the Steam version from the Switch port we are currently finishing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch simply brings the updated rooms to the Steam version, slightly improving some of the platforming areas and the \"outdoors section\" of the Research Facility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
