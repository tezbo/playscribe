   "id": "drift-streets-japan-34167@2.6.0",
   "gameId": "drift-streets-japan-34167",
   "displayName": "Update 2.6.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2016-10-02T21:36:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks for all feedback! So we decided to bring back Old January Physics!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So now you are able to do Back Entries, 360s, and more again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Change Log",
     "items": [
      {
       "text": "January arcadic physics!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Manual Clutch (X - by default on Keyboard, also supported for Pedal in input settings): We decided to listen much more the community, so new physics was a mistake, in the future we will listen only community, so the game will grow up, give your feedback and ideas in comments! Thank you, keep playing! See you in game!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
