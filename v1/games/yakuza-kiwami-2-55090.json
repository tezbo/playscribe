  {
   "id": "yakuza-kiwami-2-55090@2.12",
   "gameId": "yakuza-kiwami-2-55090",
   "displayName": "Patch 2.12",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-01-15T03:59:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing Yakuza Kiwami 2. We have fixed the below issues in patch 2.12 (released December 19, 2025).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue with combat behavior at high FPS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue in advanced graphics settings where setting anti-aliasing to TAA did not function correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue in advanced graphics settings that was causing Realtime Reflections and SSAO not to function correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the \"High\" setting for Movie Quality was not applied to some cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed various other minor issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "パッチ2.12リリースのお知らせ",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "『龍が如く 極２』をプレイいただき、誠にありがとうございます。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2025年12月19日に配信したパッチ2.12にて、下記の修正を行いました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■修正内容",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・高フレームレート動作時のバトルの挙動を修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・グラフィックス詳細設定 アンチエイリアスをTAAに設定すると正しく動作していなかった問題を修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・グラフィックス詳細設定の リアルタイム・リフレクションとSSAOの項目が機能していなかった問題を修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ムービー品質「高」に設定している際に、一部のムービーに設定が反映されていなかった問題を修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・その他、軽微な不具合を修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "今後とも「龍が如く」シリーズを、宜しくお願い致します",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
