  {
   "id": "worms-rumble-135554@major-2021-06-25",
   "gameId": "worms-rumble-135554",
   "displayName": "Server Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-06-25T14:53:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're making some changes to our servers to fix several connection problems across all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This will not require a game update, but if you are playing then please close your game and restart for these changes to take effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues with Worms Rumble, please post a thread in our Report A Problem forum or contact our support team via the Team17 website",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
