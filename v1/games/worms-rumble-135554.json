     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you're enjoying day 2 of the Worms Rumble Beta!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The team have been watching and taking note of your feedback and have put it into action...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
