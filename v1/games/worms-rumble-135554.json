  {
   "id": "worms-rumble-135554@post-2021-08-11",
   "gameId": "worms-rumble-135554",
   "displayName": "Worms Rumble - Bug Fixed & Expanded Parties!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-08-11T10:28:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Worms Rumble has just gone live with a new patch to make your experience smoother and filled with wormy chaotic goodness! Check out the patch notes below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Increased party size from 3 to 6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "All 3 daily challenges can now be re-rolled each day",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional messaging added to the matchmaking search bar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements to the network to fix rubber banding issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with the team sizes and balancing in Team Deathmatch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes to instabilities on servers to improve player experience",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug which would show player in the wrong position after being killed in Last Worm Standing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
