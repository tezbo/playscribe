  {
   "id": "worms-rumble-135554@patch-2021-03-15",
   "gameId": "worms-rumble-135554",
   "displayName": "Worms Rumble Patch - Bug fixes, achievement fixes and more...",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-03-15T12:05:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let's kick off the week with a patch for Worms Rumble...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been working hard on fixes for issues reported by our players, including problems with movement and that pesky Hammerhead audio bug!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It also includes a fix for the last two trophies that players were having problems unlocking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've also added a DLC tab into the main menu of the game to make it easier to find the extra (paid) content that is available for Worms Rumble.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Check out the full patch notes below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Fixes for unlocking the Geared Up and Tooled Up achievements if criteria had already been met before previous patch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue which prevented the held button commands to work on elevators, crates and weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an additional issue where the player was unable to move when the game starts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the pre-game scoreboard cursor was not dismissed when the game starts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Hammerhead firing audio was played repeatedly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the moving platforms in Deadly Dockyards could become desynced after the level event.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the controller disconnection was not displayed in game if the controller was disconnected in the main menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where fake projectiles could be seen but would deal no damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players stuttered during spectate mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a DLC tab into the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
