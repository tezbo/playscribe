  {
   "id": "hidden-cats-in-paris-195373@major-2023-08-15",
   "gameId": "hidden-cats-in-paris-195373",
   "displayName": "New Content Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-08-15T17:53:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are very happy to announce that now Hidden Cats in Paris, our very first from the series, now have more fun stuff for you! The game now has more fit with its brothers London and New York!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Additional Content",
     "items": [
      {
       "text": "Revised Normal Mode: 100 cats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Advanced Mode: 150 cats + special cats + characters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "6 bonus levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enjoy the game and give us your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "* tier price will change to $2 USD soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
