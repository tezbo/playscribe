  {
   "id": "hidden-cats-in-paris-195373@major-2025-11-04",
   "gameId": "hidden-cats-in-paris-195373",
   "displayName": "Game Security Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-04T21:04:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! This is a quick update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Recently there was a security issue related to Unity's game engine world wide, for this reason we have updated the game to a new version that is free from this problem!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We have also fixed the following issues",
     "items": [
      {
       "text": "-Achievement counter stuck at 424 cats;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-City people not being clickable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Let us know if everything runs smoothly on your end, happy finding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
