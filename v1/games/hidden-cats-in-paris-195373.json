  {
   "id": "hidden-cats-in-paris-195373@post-2024-01-16",
   "gameId": "hidden-cats-in-paris-195373",
   "displayName": "Recent Updates",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-01-16T16:59:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello friends, we have been working on all games from Hidden Cats Series to fix reported issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here are the last updates for Paris.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FIXED - Achievements problems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Camera keyboard (WASD) controls;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "FIXED - Meow SFX options not working properly;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "NOTE",
     "items": [
      {
       "text": "Due to the technical nature of the game, sometimes updates can be quite big compared to the game size already installed, even when the update itself is a small thing. But, make note that this won't increase too much of your install files as it is already.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
