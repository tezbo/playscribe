  {
   "id": "hidden-cats-in-paris-195373@post-2026-09-28",
   "gameId": "hidden-cats-in-paris-195373",
   "displayName": "General Bug Fixing:",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-09-28T16:50:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! We bring good news! We are happy to say we have fixed some bugs you've reported to us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Completing advanced level doesn't show congratulations screen;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-600 cat achievement not playing;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Normal mode, when restarting for an instant has wrong UI;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Camera Sensibility is too strong even at minimum settings;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Removed yellow banner appearing at the bottom of the screen when restarting level;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Steam Cloud not working properly;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You may now enjoy the game without these issues happening!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let us know if everything runs smoothly on your end!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "HAPPY FINDING!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
