  {
   "id": "shepherd-s-crossing-246758@major-2024-07-16",
   "gameId": "shepherd-s-crossing-246758",
   "displayName": "0716　UPDATE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-16T03:22:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "With this update, you can now edit in-game text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can only edit text, not graphics with embedded characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "# About text editing functions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Operate the following folders.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Install Path) \\SheepVillage_Data\\StreamingAssets\\text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Configuration File",
     "items": [
      {
       "text": "splocalize.ini.txt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enable/disable the User Localization function",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Folder specification for used text: Check the file for details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "About Translations",
     "items": [
      {
       "text": "The text in the ko, sc and tc folders is to be translated. Part of it has been translated for testing purposes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The en and ja folders contain the actual text used. Please translate and use it with reference to this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update also includes minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
