  {
   "id": "shepherd-s-crossing-246758@post-2025-10-02",
   "gameId": "shepherd-s-crossing-246758",
   "displayName": "Fixed the issue related to the red fox.",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-02T02:51:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We sincerely apologize for the long wait.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have fixed the issue where the game would stop progressing after the Red Fox capture event.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "To use the game in Japanese, please edit the following file",
     "items": [
      {
       "text": "SheepVillage_Data/StreamingAssets/text/splocalize.ini.txt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Make the following changes",
     "items": [
      {
       "text": "textset=1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "dir=ja",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fontset=def",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After saving these settings, you will be able to play the game in Japanese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
