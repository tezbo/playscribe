  {
   "id": "lost-in-fantaland-157064@20250916",
   "gameId": "lost-in-fantaland-157064",
   "displayName": "Update 20250916",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-16T09:42:44.000Z",
   "notes": [
    {
     "title": "Fixes",
     "items": [
      {
       "text": "The Mage's Staff Strike card didn't ​make the Snowball roll.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hint text still showed “Too many targets” when there were no clickable tiles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Desert events can remove Burden cards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "English translation issue of Mage's Inlaid Gem.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Card Ferocious applied to the Golden Axe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Stress Block + Emergency Dodge could sometimes pick a card already moved to the “Exhausted” pile.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "With Rattan Whip, taking damage at the end of the turn could cause card loss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Other Changes",
     "items": [
      {
       "text": "Enemies already stunned or frozen now show “…” as their intent instead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stun description updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added “Fixed Reward” text to coin rewards in boss fights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Special Thanks",
     "items": [
      {
       "text": "Huge thanks to our Discord friend Paradoxica for providing tons of valuable feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
