   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new sorting option by type has been added to the card list in the backpack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In Chapter 3, Cold Air Mass will only drift in the direction of the wind during strong wind weather.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stronger indicators have been added in Chapter 3 about ice tiles and movement range highlights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some English keywords have been changed following translation corrections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed incorrect triggers for General's Quill and General's Seal under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
