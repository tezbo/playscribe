  {
   "id": "metal-gear-solid-3-snake-eater-master-collection-version-383391@1.3.0",
   "gameId": "metal-gear-solid-3-snake-eater-master-collection-version-383391",
   "displayName": "Update 1.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-14T09:17:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ver.1.3.0 is now available for users on all platforms!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Ver.1.3.0 Patch Notes",
     "items": [
      {
       "text": "Please check the list of changes below for details on the main improvements and fixes in this patch. Fixes of previously known issues are marked with an asterisk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where some buttons were assigned multiple functions (Details on the updated controls are available in the Online Manual)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the audio was out of sync with certain videos*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the Online Manual",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed the \"Download\" section from the game launcher (Check here for our guide on how to install/uninstall the DLCs)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some other minor issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Issues Under Investigation",
     "items": [
      {
       "text": "We are investigating the issues below and working to resolve them. We will provide further details regarding fixes for these issues at a later time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue where some face paints are displayed in a lower resolution",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue to provide regular updates on future improvements and fixes as further details are finalized.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
