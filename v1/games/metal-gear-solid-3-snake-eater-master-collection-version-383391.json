   "gameId": "metal-gear-solid-3-snake-eater-master-collection-version-383391",
   "displayName": "Update 1.4",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-01-29T02:05:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ver.1.4.1/Ver.1.4.1D releases Jan. 29th, 2024.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The version for users playing on Steam Deck™ will be noted as Ver.1.4.1D in the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Ver.1.4.1/Ver.1.4.1D Patch Notes",
     "items": [
      {
       "text": "Please check the list of changes below for details on the main improvements and fixes in this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes of previously known issues are marked with an asterisk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Steam Deck™ support",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where inputs via the keyboard were registered for the game even when the Alt key was held down*",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some other minor issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Issues Under Investigation",
     "items": [
      {
       "text": "We are investigating the issues below and working to resolve them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will provide further details regarding fixes for these issues at a later time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue where a portion of character textures are displayed at a low resolution: We will continue to provide regular updates on future improvements and fixes: as further details are finalized.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
