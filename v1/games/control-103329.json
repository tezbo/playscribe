  {
   "id": "control-103329@major-2025-03-13",
   "gameId": "control-103329",
   "displayName": "Control Ultimate Edition: March 2025 Update Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-13T14:07:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Director!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're happy to announce that all owners of Control Ultimate Edition will be receiving a free content update. This includes three outfits, a previously platform-exclusive mission, HDR, DLSS 4, and several other improvements. Read on for the full update notes!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "OUTFITS",
     "items": [
      {
       "text": "The following outfits are now available to all players. The outfits can be accessed and equipped from the Control Point in the Central Executive Sector area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Astral Dive Suit (formerly a pre-order exclusive)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tactical Response Gear (formerly a pre-order exclusive)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Urban Response Gear (formerly a pre-order exclusive)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "MISSIONS",
     "items": [
      {
       "text": "All players will receive the mission Dr. Yoshimi Tokui’s Guided Imagery Experience, featuring voiceover by Hideo Kojima. The mission is playable when you pick up the Dr Tokui Tapes collectible in the Extrasensory Lab of the Research Sector. (This mission was previously exclusive to the PlayStation 4 Digital Deluxe version of Control.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    },
    {
     "title": "GRAPHICS",
     "items": [
      {
       "text": "Added HDR support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new Ultra ray tracing preset, which gets you more rays per pixel and higher temporal stability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed shadow flickering on new NVIDIA Series 5000 GPUs",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added Super Sampling support. The game can now render at resolutions higher than your output resolution.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new High Quality Post Process setting. All post processes should now look better – depth of field, bloom, Hiss effects…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new higher quality Anisotropic Filtering setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added ultrawide monitor support for up to 48:9 monitors",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added an FOV scaling setting for the gameplay camera",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated SDR to 10bit (from 8bit), which reduces visible color banding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved graphics adapter detection at startup, with automatic selection between DX11 and DX12",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved the quality of our own in-house TAA solution. This results in less ghosting and better textures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Implemented screen aspect ratio fixes for ultrawide monitors",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Your current monitor resolution can now reliably be selected from the screen resolution and rendering resolution menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added rendering resolution support beyond 4K",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Implemented texture streaming fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ray tracing bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "DLSS SUPPORT",
     "items": [
      {
       "text": "Added DLSS support for arbitrary resolutions",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added DLAA support",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Updated DLSS to DLSS 4, with higher temporal stability",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Film grain added back to DLSS SR",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed shadow resolution when DLSS is enabled",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added resolution dependent mip map bias for DLSS. This enhances texture quality, for example when applying the DLSS Performance setting.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "GENERAL",
     "items": [
      {
       "text": "Updated the audio on cinematics and end credits to remove unintended channel mixing. You will no longer hear anything that isn’t intended to be heard. (It wasn’t the Hiss, it was us. Sorry.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several bug and crash fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
