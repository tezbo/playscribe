  {
   "id": "control-103329@1.13",
   "gameId": "control-103329",
   "displayName": "UPDATE 1.13",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-09-25T09:11:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "CONTROL SEPTEMBER UPDATE (1.13)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update is specifically fixing issues in the PC version of Control / Ultimate Edition",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "GENERAL",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On PC, NVIDIA DLSS now has the Ultra-Performance mode option, enabling upto 9X AI super resolution (for example 1440p -> 8K).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed instances when the Hedron Chamber door would not open in the main story mission Polaris.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed PlayStation button prompts not displaying on PC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5",
        "pc"
       ]
      },
      {
       "text": "Fixed input icons appearing corrupted on the input binding menu on PC.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "STEAM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed various save game issues, like saving appearing \"stuck\", crashes on player death and the game rolling back to old saves on death.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various progress-based achievements which appeared to reset when the game was closed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
