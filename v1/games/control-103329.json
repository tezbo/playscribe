  {
   "id": "control-103329@major-2020-09-04",
   "gameId": "control-103329",
   "displayName": "CONTROL ULTIMATE EDITION UPDATE PATCH NOW LIVE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-09-04T08:13:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all, latest patch is now live. Thank you for all your feedback and involvement from launch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is the list of changes made",
     "items": [
      {
       "text": "PATCH NOTES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Control can now be played offline on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Removed redundant developer info from the window title bar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AWE content and opening mission will unlock properly when importing save files from the Epic Games Store version of the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixes to Japanese localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Foundation: Fixed a bug that could potentially prevent players from completing side missions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
