 "releases": [
  {
   "id": "overboss-214604@major-2024-11-08",
   "gameId": "overboss-214604",
   "displayName": "Update on the game's State - November",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-08T14:40:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We wanted to give you a quick update on how Overboss is doing right now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Recently, we pushed the 1.01.00 update, addressing most of the game's issues. Thanks to your feedback and reviews, we worked hard to smooth things out and make Overboss a much more enjoyable experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We took extra time with these changes to make sure they’d meet your expectations. After extensive testing and feedback, we’re confident that Overboss is now where it should be. A recent reviewer even said, “Overboss is fixed! Overboss is fixed!!!” — and that gave us the final push to share this news with you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A huge thank you for sticking with us! We know a lot of you were excited to play Overboss on PC, and we’re thrilled to finally bring you the experience we envisioned from the start.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "So, if you’ve been waiting to jump back in, now’s a perfect time to rediscover Overboss!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I’ll be hanging out on the Steam Forums and keeping an eye on reviews, so don’t hesitate to share your thoughts—whether it’s positive feedback or suggestions for improvement, we’d love to hear from you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wishing you all a wonderful day!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
