  {
   "id": "tails-of-iron-ii-whiskers-of-winter-292877@1.14555",
   "gameId": "tails-of-iron-ii-whiskers-of-winter-292877",
   "displayName": "Update 1.14555",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-11T11:05:12.000Z",
   "notes": [
    {
     "title": "Hey Ratdom,",
     "items": [
      {
       "text": "We’ve been hard at work squashing grub bugs and making improvements to ensure your journey through the Northern Wastes is as smooth (and brutal) as ever!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Just a quick update: We’re actively investigating the crashing issue on Intel GPUs and testing a fix. We’ll keep you posted as soon as we have more information to share.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Fixed an issue where The Undead Sky Scorcher Vangor could get stuck mid-air during the fight in Mount Cauldron.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed The Outskirts Tomb opening too early after performing specific steps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Mole Parts not being available for purchase in the Crimson Keep if the shop was upgraded beyond Level 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Slither Scale Hatchlings not dropping loot as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Shrimp Parts being incorrectly required for crafting the Slither Scale Tier 3 Gun.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Elementas cooldowns were not resetting upon death.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you're having a blast with the game, we’d love to hear your thoughts! Dropping a Steam review means the world to us and helps shape the future of Tails of Iron 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're committed to bringing even more fixes and improvements, so stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "United Label & Odd Bug Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
