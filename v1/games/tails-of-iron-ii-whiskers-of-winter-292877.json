  {
   "id": "tails-of-iron-ii-whiskers-of-winter-292877@14932",
   "gameId": "tails-of-iron-ii-whiskers-of-winter-292877",
   "displayName": "Update 14932",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-14T16:38:19.000Z",
   "notes": [
    {
     "title": "Happy Easter Ratdom,",
     "items": [
      {
       "text": "Spring has sprung in the Northern Wastes, and we’re celebrating with a 25% off sale on Tails of Iron 2: Whiskers of Winter! Now’s the perfect time to dive into our latest update, brimming with Easter-themed goodies, balance tweaks, and polish to make your adventure sharper than a rat’s claw. Hop into Update v14932 and discover what’s new!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy egg-hunting,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "United Label & Odd Bug Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Get ready to crack some eggs with these festive additions",
     "items": [
      {
       "text": "A brittle Easter Eggshell Armour Set – this delicate gear offers minimal protection, daring bold rats to rely on skill alone. Think you’ve got what it takes to conquer the entire game wearing this and this alone?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A One-Handed Easter Sword, brimming with seasonal spirit, for slicing foes with festive flair.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Exclusive upgrade paths for both the armour and sword.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Boss Fight Tuning",
     "items": [
      {
       "text": "Based on player feedback, we’ve rebalanced these encounters for a smoother experience:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Scorchlin Rider – now easier to ease new players into the adventure",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Baron Frostavik – fine-tuned for a fairer fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Elder WereOwl – adjusted for better balance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "WereOwl (side quest variant) – tweaked to match the main quest’s flow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Crafting Adjustment",
     "items": [
      {
       "text": "Refined the crafting requirements for WereOwl Bows – now requiring beaks and feathers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "In-game Credits Adjustment",
     "items": [
      {
       "text": "Added missing names to give proper shout-outs to our team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Enhanced image quality for sharper, clearer visuals – give ‘em a look!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fix",
     "items": [
      {
       "text": "Fixed an issue where players could get stuck in an execution animation during the combat tutorial, including Arlo’s issue with Backstabber Pups on the left edge of the arena.: https://store.steampowered.com/app/2473480/Tails_of_Iron_2_Whiskers_of_Winter/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
