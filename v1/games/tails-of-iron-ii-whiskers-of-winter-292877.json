  {
   "id": "tails-of-iron-ii-whiskers-of-winter-292877@major-2025-02-14",
   "gameId": "tails-of-iron-ii-whiskers-of-winter-292877",
   "displayName": "Update: 'Happy Valentails' - New DLC, Intel GPU Fix, Subtitle Adjustment & More",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-14T13:51:41.000Z",
   "notes": [
    {
     "title": "Happy Valentails, Ratdom! ❤️🐀",
     "items": [
      {
       "text": "Love is in the air... and so are arrows! 💘 Whether you're braving the Northern Wastes solo or battling side-by-side with your most loyal rat companion, we’ve got a little something to help you wear your heart on your sleeve, literally!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Valentine's Day Update🏹",
     "items": [
      {
       "text": "New Valentine's Day DLC – Dress to impress with the Cupid-themed armour set featuring a new Helmet, Pauldron, winged Cuirass, and Bow, plus full upgrade trees!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "How to Unlock",
     "items": [
      {
       "text": "New Game: Some items and blueprints are earned after completing the intro quest (automatically added to Inventory).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Existing Saves: If you've already passed the intro, the items will be automatically added to Arlo's Inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Integrated Intel GPU Update",
     "items": [
      {
       "text": "We've resolved launch crashes for systems using integrated Intel GPUs through the addition of a new Texture Quality setting from within the main menu. However, we’re also aware of Fast Travel crashes that can occur after long play sessions on those systems. Such crashes don’t corrupt saves or block progress, and are the result of a limitation of the hardware.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features & Improvements",
     "items": [
      {
       "text": "Texture Quality setting – Intel GPU users can now launch the game using the Low setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Subtitle Size setting – Adjust text size to make sure every rat gets the perfect reading experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Steam Cloud Save Support – Transfer saves seamlessly between Windows and MacOS.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Fixes & Adjustments",
     "items": [
      {
       "text": "Fixed controller issues on MacOS (M1 and above).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the 'Load Game' menu not opening if a save file was corrupted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a game freeze caused by Mudwyrms using the Dig circle marker attack simultaneously.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed WereOwl Pauldron items displaying awkwardly while sprinting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted crafting requirements for:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fire Wyrm Sting (One-Handed Spear)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Electric Slash (One-Handed Axe)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "TH Ice Katana (Two-Handed Sword)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "TH Long Winter Slammer (Two-Handed Axe): Stay sharp, stay fierce, and spread the love (or the carnage)! 💕⚔️: United Label & Odd Bug Studio: https://store.steampowered.com/app/2473480/Tails_of_Iron_2_Whiskers_of_Winter/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
