  {
   "id": "mamon-king-375641@1.0.1",
   "gameId": "mamon-king-375641",
   "displayName": "Update 1.0.1",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-12-16T23:35:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "🌟 New Feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a \"Pass\" option to the shortcut keys during battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "(Using \"Pass\" causes the player's Mammon to take no action.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚙️ Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Modified some dialogue and UI text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the success rate of the \"Dr. Mammon's Skill Acquisition\" and \"Training Drink Event.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced the amount of money requested by the beggar, and lowered the cost required to obtain powerful cards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed the default volume setting to 75.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the parameter experience points gained from part-time jobs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "🐛 Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where an incorrect number of dice rolls was displayed immediately after starting an Expedition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a game crash that occurred when pressing the \"Tournament\" shortcut key without Mammon present.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the icon for \"Great Shield\" was incorrectly set to be the same as the \"Defense\" icon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a game crash that occurred when repeatedly pressing the button while attempting to sell Mammon to Marco.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the effect animation and evasion animation would not play if the second hit of \"Inescapable Bite\" was evaded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a game crash that occurred when evading an attack after a double knockout.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
