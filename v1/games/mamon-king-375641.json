  {
   "id": "mamon-king-375641@1.1.0",
   "gameId": "mamon-king-375641",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-23T01:56:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added: Achievements System",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can now access the Achievements page from the title screen to unlock achievements you’ve already earned. Please note that some achievements are triggered at the exact moment of completion, so you may need to earn those again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added: Self-Legend Battles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can now battle Mamon that you have registered as Legends. (To start a battle, go to Manage → Legends and select a Mamon.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed: Character Names",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated the names of certain characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed: Dialogue Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Refined the dialogue for certain characters, such as Dr. Mamon, to make the instructions and story clearer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed: Legend Mamon Stamina Display",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mamon registered as Legends will now be displayed with their Stamina bars full.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed: Navi Naming Confirmation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When asking Navi to name a Mamon, you can now review the suggested name before choosing whether to accept or cancel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed: Skill Sorting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated the skill list to group Evolved Skills together in addition to alphabetical/name-based sorting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Expedition Crash Bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue where players could become stuck in an Expedition if the game crashed immediately after defeating the Mamon in the deepest area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
