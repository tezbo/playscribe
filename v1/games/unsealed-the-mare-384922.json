 "releases": [
  {
   "id": "unsealed-the-mare-384922@1.2",
   "gameId": "unsealed-the-mare-384922",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-26T13:10:53.000Z",
   "notes": [
    {
     "title": "Happy Halloween! A new bigger update is here!",
     "items": [
      {
       "text": "Over the past months, we've gone through the whole game with a focus on performance, quality of life, game feel, level design, balancing, visual and audio improvements and more. Everything below is in the build you're playing now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We'd also like to take this opportunity to announce our next game, Unsealed: Vigil. It already has a Steam page, and a wishlist helps us a lot:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Unsealed: Vigil",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "The Mare",
     "items": [
      {
       "text": "Her vision now comes from her actual eyes rather than her controller rotation. This will prevent her from noticing you when she doesn't appear to look at you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "She now accelerates more smoothly from walking to chasing to make it feel more natural and give you a brief moment of reaction time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You will now hear your heartbeat playing when she's after you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The humming Mare reacts when she spots you, giving you a moment before the chase begins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "She will now better search for you in the vicinity where she lost line of sight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New visual and sound effects when you look at her or she's near.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Her hair now has physics and moves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player death animation is faster and more violent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Game feel & Gameplay",
     "items": [
      {
       "text": "Reworked head bob and footsteps - smoother walking and a stronger sense of weight when running. Sprinting widens the view slightly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Some scare events now briefly pull your view towards them, so they hit harder and cannot be missed as easily.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The equipped item now moves like something carried. It swings with your steps and trails your turns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Small actions have weight to make interactions feel more impactful, like burning a teddy, lighting a candle, opening a door, picking something up and switching items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reading a note slightly blurs the room behind it. Paper notes have a new old-paper look and glow when you're near to make them easier to spot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Anything you can pick up or use has a soft outline while you look at it. In focus memory, memories have a soft outline and can be spotted through walls and objects if close enough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Doors you can chain shut with a focus memory lock now show a broken lock on the floor until you lock them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The lighter now spawns a fire particle when burning a teddy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new sound marks the moment a puzzle is lost.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new death animation plays when you die as a result of a failed puzzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can no longer sprint backwards as it could keep chases from feeling as dangerous.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Mare plays an audio cue before chasing you in a specific encounter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Chapter 3",
     "items": [
      {
       "text": "Dying no longer sends you back to zero teddies, instead up to half the teddies you burned stay burned, and the speedrun clock scales to match.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Scare events happen more often.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added subtle guidance in the final encounter for players who got stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "One of her events now builds rage as intended when she gets close.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Levels and menus",
     "items": [
      {
       "text": "Layout edits have been made to many areas to improve flow and readability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some doors now have a brown tint to guide you in the general direction of hiding teddies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The house now starts showing bits and pieces in chapter 1 as you regain memories.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A limited-time Halloween event has arrived in all maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an optional Focus Memory shortcut in an encounter in chapter 1, giving you another way to escape the Mare.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The main menu shows our next game, Unsealed: Vigil, with a Steam page link.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed an issue where certain interactions like doors opening or the car moving played at different speeds depending on your framerate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare case where a damaged save file could leave the main menu unresponsive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare checkpoint saving issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed texts on walls that could vanish early.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed chase sounds that could keep playing after you died.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a case where the Mare could stand still instead of revealing herself during a sprint scare.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the pizza spot showing the wrong prompt.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the lamp achievement not counting some lamps in chapter 3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "More minor bugfixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Performance",
     "items": [
      {
       "text": "Optimized enemies, props, AI, physics, particles and collision across the game to use less CPU and GPU. Expect smoother and higher frame rates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Localization",
     "items": [
      {
       "text": "Reworked and improved all translations (German, Spanish, French, Italian, Japanese, Portuguese, Russian, Simplified Chinese): fixed mistranslations, grammar and wording.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a candle riddle to be easier to solve in several languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several typos in the English text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for playing Unsealed: The Mare, and I hope your Halloween will be filled with spooky games and movies!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
