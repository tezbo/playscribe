  {
   "id": "unsealed-the-mare-384922@1.1.2",
   "gameId": "unsealed-the-mare-384922",
   "displayName": "Update 1.1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-26T09:42:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here are the patch notes for the latest small update 1.1.2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch mainly focuses on improving gameplay clarity, giggle audio, and balance in certain encounters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The giggle audio does no longer get occluded by smaller objects and props, like shelves, boxes, furniture etc. This makes teddies easier to hear and pinpoint when getting closer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slightly increased audio clarity in a certain encounter for better counter play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "White paper notes now glow briefly when the player is near.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Certain white paper notes are slightly bigger.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where certain long messages in the Lore Journal got cut.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Focus Memory edge effect lingered for too long in a certain area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always - I'm still working on some more updates for the game and will continue to monitor gameplay and reading feedback for future updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
