  {
   "id": "unsealed-the-mare-384922@1.0.13",
   "gameId": "unsealed-the-mare-384922",
   "displayName": "Update 1.0.13",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-14T17:16:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another small update is live. This patch focuses on improving gameplay clarity, audio feedback, and balance in certain encounters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed positioning of the \"Remember\" note.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved flashlight flicker feedback to better indicate when the Mare is nearby.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased lamp flicker audio for better awareness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the Mare's speed in specific encounters, giving players a better chance to escape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Teddy giggles are slightly easier to hear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an additional chase audio cue during certain encounters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Various small balance adjustments, visual improvements, and quality of life changes.: Thank you again for all the support and feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
