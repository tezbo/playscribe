   "id": "exstetra-399308@major-2026-08-20",
   "gameId": "exstetra-399308",
   "displayName": "EXSTETRA Update Now Available, Including Bug Fixes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-20T10:54:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Steam® version of EXSTETRA has received an update that includes bug fixes and various adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Bug Fixes]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Fixed an issue where UI messages could sometimes appear in Japanese when the game was set to a language other than Japanese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Fixed an issue where the game could sometimes crash when pressing the confirm button at interactable points in dungeons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We sincerely apologize for any inconvenience and frustration this may have caused our players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
