  {
   "id": "die-after-sunset-158966@3",
   "gameId": "die-after-sunset-158966",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-07-20T11:54:29.000Z",
   "notes": [
    {
     "title": "DEFENDERS!",
     "items": [
      {
       "text": "Gear up for the most complete Die After Sunset Experience Yet!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👉 Major Content Update 3 is out for FREE RIGHT NOW, including:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brand new level 5: Time-travel back to the present day and take on the murkors at their own base!🕙",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All-new mega boss, the Negamurk: Bring the fight for humanity directly to the Murkor’s boss! 👊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Seven new missions: Some exclusive to level 5, other new missions can be found randomly in other stages! 🙌",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fixes and balancing: Including performance upgrades! 🪛: https://store.steampowered.com/app/1440010/Die_After_Sunset/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
