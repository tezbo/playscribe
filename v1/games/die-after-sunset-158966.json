  {
   "id": "die-after-sunset-158966@2",
   "gameId": "die-after-sunset-158966",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-05-18T11:00:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "What's up everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to bring you the next brand new Early Access content update for this roguelite shooter, Die After Sunset.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please welcome our new playable character, Hune! Her backstory and more unique information surrounding her will be in an article to come this Friday, so keep your eyes peeled for that.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "However here is a brief list of what to expect",
     "items": [
      {
       "text": "New special transporting ability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New unique style of weapon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New distinctive manoeuvrability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "With this new character we now have 3 playable characters to explore and all with very unique skills and abilities to try out. Who will take the top spot as your favourite overall character to play?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
