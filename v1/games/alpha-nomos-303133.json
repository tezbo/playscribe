  {
   "id": "alpha-nomos-303133@07.0035",
   "gameId": "alpha-nomos-303133",
   "displayName": "Patch 07.0035",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-04-03T11:01:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update sharpens the connection between your inputs, the beat, and the world around you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Two new input settings, \"Responsive\" and \"Rhythmic\", give you more control over how your actions sync with the music, while sound effect timing, attack feedback and the visual metronome have all been improved. Several Flanger powerup variants have also been reworked to feel clearer and more intuitive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On the stability side, this patch resolves a range of collision and boundary issues, along with several edge-case bugs affecting combat flow and environment visuals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
