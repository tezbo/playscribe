  {
   "id": "alpha-nomos-303133@1.0.0005",
   "gameId": "alpha-nomos-303133",
   "displayName": "Patch 1.0.0005",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-30T09:06:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This patch reworks weapon move unlocks, tones down some SaXword moves, and fixes a batch of combat, enemy and level bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New",
     "items": [
      {
       "text": "Added a Credits option to the start menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Changes & Balance",
     "items": [
      {
       "text": "Reworked which weapon moves are unlocked from the start, and the requirements for unlocking the rest, so new moves open up at a smoother pace.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "SaXword: adjusted some combos that could be performed faster than intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "SaXword: reduced the damage of some aerial moves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Salvaging items now uses a hold input.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved the selection in the base level store.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Combat & Power-ups",
     "items": [
      {
       "text": "Fixed a bug with Pitch Shifter power-up evolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Ping Pong Delay visuals not matching its effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bugs with the Vengeance Amulet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Enemies",
     "items": [
      {
       "text": "Fixed enemies sometimes acting too passive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed enemies sometimes getting stuck in attack animations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed lost scrubs locking out non-movement actions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the first tutorial scrub being too eager to fight and cutting his intro short.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Levels",
     "items": [
      {
       "text": "Fixed missing collision in some areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added colliders to prevent some softlocks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Out-of-bounds protection now returns you to the active combat encounter instead of the start of the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Fixed the beat falling out of sync at the start of the first boss track.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Rody not being counted toward an achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a few bugs with graphics settings (PC only).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
