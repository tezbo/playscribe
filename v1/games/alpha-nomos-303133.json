      },
      {
       "text": "Reworked several variations of the Flanger powerup to make them clearer and easier to use",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved visual metronome consistency and function",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
