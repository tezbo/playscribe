  {
   "id": "alpha-nomos-303133@07.0037",
   "gameId": "alpha-nomos-303133",
   "displayName": "Patch 07.0037",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-05-08T11:38:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update is a big one. The powerup system has been revamped to make run progression clearer and more impactful, all powerups have been rebalanced, and a new miniboss, SnaggleTooth, now closes out the demo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rhythm sync, SFX timing and input feel have all been improved, and we've added music-contextual click tracks with controllable volume to give you more control over how you lock into the beat. Lighting has been improved across all scenes, graphical performance has been optimized for lower-end GPUs and new settings for Vsync, framerate, and other graphical options are now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch also includes new plugins from our design competition winners, added enemy SFX across the board, and a long list of stability fixes and bug squashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Notes demo version 07.0037",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved behavior and feel of rhythm sync",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved SFX timing for better syncing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved and adjusted input mode settings and terminology for better clarity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved lighting in all game scenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved graphical optimizations especially on lower end GPUs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added settings for Vsync, framerate and other graphical settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed HUD metronome related bugs and issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Revamped powerup system to make run progression more clear and impactful",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rebalanced run items and drop rates to support new powerup revamp",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added new plugins including design competition winners!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added enemy SFX for all enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added more general SFX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Implemented improved enemy stagger mechanic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a few bugs in specific powerups",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed another rare bug causing softlocks in certain combat scenarios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rebalanced all powerups",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved powerup musical effect on attack SFX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Implemented music-contextual click tracks with controllable volume",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added SnaggleTooth, a new miniboss, to the end of the demo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved physics and enemy collision",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rebalanced Maestros shop prices",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved consistency of hold combos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General stability improvements and bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
