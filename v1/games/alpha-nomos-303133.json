  {
   "id": "alpha-nomos-303133@post-2025-11-27",
   "gameId": "alpha-nomos-303133",
   "displayName": "Demo Patch Notes for 27/11/2025",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-27T15:53:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45006334/a56678ae76119149f32cd0d06303f87c6139dffe.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Demo Patch notes for version 0.7.0022",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Teddy room softlock: Previously there was an issue which made the level portal not activate after picking a trade from Teddy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enemy spawn softlock: Enemy spawns would sometimes break on rare cases locking the player in the arena and preventing progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enemies stopped attacking: Sometimes enemies would lose their spines and stop attacking the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Death clock SFX bug: the sound effect that is triggered when dying would sometimes mute partially",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Control sequence bugs: Some sequences allowed the player to control the character when they should not be able to",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rare tutorial crashes: In some rare cases the game could crash when moving to the second level of the tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enemy animation bugs: Enemies could get stuck in animations in certain scenarios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Removed clicker track: this feature turned out to be more trouble than it's worth, we don't feel like it is necessary and it had a tendency to create new problems and hide existing ones",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy telegraphing for attacks now works differently allowing players to use action game style reactive dodging to get back into the rhythm",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New musical arena barrier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Some minor combo changes like cancellation windows and followups",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Locked some combos in preparation for a new mechanic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visual improvements in UI and VFX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
