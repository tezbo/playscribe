  {
   "id": "alpha-nomos-303133@07.0039",
   "gameId": "alpha-nomos-303133",
   "displayName": "Patch 07.0039",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-29T19:10:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "While building the full game we made some improvements we thought would make the demo better while you wait. Many of these come straight from player feedback, so thank you to everyone who played and helped us make Alpha Nomos better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's new",
     "items": [
      {
       "text": "Improved input handling across input modes. Auto mode now only misses when inputs are rapid",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Smoother physics between player and enemies. No more getting stuck against groups",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enemy stun states added so stagger breaks read clearly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed ground detection bug causing odd behaviour in some environments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed damage indicators not accounting for pausing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved SFX and volume defaults",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Moved input type config from first startup to the tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More consistent cancel windows",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Easier hold input timing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Various other fixes and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Keep the feedback coming. See you in the beat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/2529960/Alpha_Nomos/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
