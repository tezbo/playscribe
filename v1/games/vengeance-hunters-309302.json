  {
   "id": "vengeance-hunters-309302@post-2026-03-26",
   "gameId": "vengeance-hunters-309302",
   "displayName": "Vengeance Mode Timers",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2026-03-26T14:32:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The timer for the game is to short when playing on Vengeance Mode in the final stage. A timer reset will now happen when you get to certain parts of waves avoid this issue (all modes).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We still want the timer to be part of the game and influence play, but it was influencing grindy play-styles more than anticipated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
