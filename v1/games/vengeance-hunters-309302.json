   "id": "vengeance-hunters-309302@post-2026-04-07",
   "gameId": "vengeance-hunters-309302",
   "displayName": "Steam Deck Bluetooth and automatic glyph support for third party controllers",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2026-04-07T18:42:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "With this small update, you should now be able to connect any Sony/MS/Nintendo OEM controller without issue and the glyphs will automatically change in game on any platform (this fix targets Steam Deck/OS).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Also, we added support for more third party controllers so that they identify correctly when connected. And if you use a controller that is not supported, you can still change the glyphs manually in the Options screen at any time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
