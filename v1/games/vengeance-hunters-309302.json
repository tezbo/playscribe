  {
   "id": "vengeance-hunters-309302@post-2026-03-23",
   "gameId": "vengeance-hunters-309302",
   "displayName": "A few fixes and some minor features adds",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-03-23T04:47:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added High Score screen to the Options menu. Now you can view High Scores whenever you want",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed High Score countdown to properly display and count down from 45 seconds (previously showed 20 seconds incorrectly)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated Attract Mode sequences to reflect the latest changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Boss Select positioning so the player now spawns correctly in front of the boss room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Candy would incorrectly use the alternate palette after continuing or when using Scene Select",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Restored Desert Cave to Scene Select (previously unavailable due to technical issues)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
