  {
   "id": "nascar-25-362067@post-2025-12-08",
   "gameId": "nascar-25-362067",
   "displayName": "Patch Notes - December 8",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-12-08T19:04:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Improved AI speeds when exiting pit road.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "3 New Kyle Larson schemes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for Championship mode winner winning the championship even if not in the final four.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated Driver Ratings through 2025 season.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an online issue with AI drivers sometimes being out of sync.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Re-tuned AI Incident Slider.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue in the paint kit where shapes would sometimes disappear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue that could potentially cause a server connect error when loading a track online.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the Goodyear blimp.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Support for December DLC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
