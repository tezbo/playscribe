   "id": "case-files-behind-closed-doors-273651@major-2025-07-07",
   "gameId": "case-files-behind-closed-doors-273651",
   "displayName": "Case Files: Internal Affairs (Development Update)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-07T17:24:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Development of Case Files: Internal Affairs, the 3rd installment in the Case Files series, continues to go as planned. We are aiming for a Q4 release. Currently, we are in the post-production phase of cleaning up all video files. The footage is turning out great, with all actors delivering stellar performances. We are very excited to get this installment into the hands of the players. Be sure to wishlist this new case HERE!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
