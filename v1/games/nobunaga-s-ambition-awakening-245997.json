  {
   "id": "nobunaga-s-ambition-awakening-245997@1.1.2",
   "gameId": "nobunaga-s-ambition-awakening-245997",
   "displayName": "Update 1.1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-07T06:13:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Windows: 1.1.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Functional Improvements and Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added the \"Random Affiliation\" feature to shuffle officer's affiliation randomly for \"Scenario Editing\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added several events, including the fictional event \"Escape from Honnōji\", which depicts new endings for \"The Honnōji Incident\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*New events will occur when beginning the game with a certain scenario, such as \"Like A Dream\" with ・the Oda (Nobunaga) Clan, and when certain conditions are met before \"The Honnōji Incident\" occurs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a setting to make other clans form alliances aggressively.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a feature to allow Council Officials to be reappointed for the \"Discretionary Power Assignment\" policy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added 6 new unique policies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Strengthened several unique policies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted several Conservator Traits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted the condition to issue the \"Postal System\" and \"Gunji System\" policy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a feature that allows you to limit the change of dominions for the castles managed by your province.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a feature to choose the Daimyō's province, or your regent's province, to employ officers captured by your regent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a feature to open the officer info screen for several situations, such as when employing officers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Some features from this update (such as added events and traits) will require you to start a new game with the 1.1.2 update applied.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed the special reward for clan target \"Trade Port\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where marks were not displayed for already seen movie events.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed other minor issues such as typos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
