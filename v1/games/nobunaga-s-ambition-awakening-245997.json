  {
   "id": "nobunaga-s-ambition-awakening-245997@1.1.6",
   "gameId": "nobunaga-s-ambition-awakening-245997",
   "displayName": "Update 1.1.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-05T03:07:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The following content will be released on June 5th(5th June):",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "＜1.1.6 Update＞",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional Features/Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the feature “Grand Battles,” where huge clans clash to determine who will gain supremacy over the land.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new trait for multiple officers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a setting enabling players to pause at certain points.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a feature enabling players to set “Castle Town Plan” to “delegate” for all castles that do not have one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the option “Best Graphic Quality” to the graphics settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the UI quality for 4K.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "＜Bug Fixes＞",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bugs relating to the affiliated forces of officers at the start of scenarios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with squad locations on battle maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed other minor bugs, text errors, etc.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "＜Six New Scenarios DLC＞",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“The Birth of Nobunaga”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Fateful Clash”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Kyūshū Conquest”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Absence of Great Conflict”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Tenbun Upheaval”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Widespread Might”: ※In addition to the above, the scenarios \"Battle of Nagashino\" and \"Battle of Tetorigawa,\" which were released as early purchase bonuses for the Asian version of \"NOBUNAGA'S AMBITION: Awakening\", will also be included.: ※The scenario \"Battle of Nagashino\" is new to the English version.: Official website: https://www.koeitecmoeurope.com/nobunaga/awakening/ce/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
