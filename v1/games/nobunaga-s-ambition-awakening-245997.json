   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Windows: 1.0.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Functional Improvements and Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the condition for traits to be activated during Event Battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the condition for the trait \"Faithful Adjutant\" to be activated.: Critical Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue that caused the game to sometimes stop responding after accepting a negotiation suggestion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the game to stop under certain condition after selecting an advice for a \"Siege\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where saved data for DLC scenario cannot be loaded under certain condition.: Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several issues related to Event Battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused Construction to not occur while Castle Town Plan is set.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused Direct Talks to not occur after occupying an enemy castle using a Province War Tactic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused Loyalty to not increase under certain condition.",
       "ps5ProOnly": false,
