 "releases": [
  {
   "id": "distant-bloom-215851@major-2024-09-12",
   "gameId": "distant-bloom-215851",
   "displayName": "Update Notes for September 12th Patch",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-12T12:24:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added extra precautions when saving and exiting the game, in order to make sure quest related information is saved properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added extra precautions when loading a save file, in order to make sure completed quests would not re-activate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where multiple dialogue options would be incorrectly available during certain quests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rebalanced the revitalization amount needed for unlocking the ascended pillars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue with the \"A use for jelly\" quest, where the Elder would refuse jelly from the player if they quit the game during the related quest step.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where holding the \"jelly\" inventory item and pressing the interact key could cause a crash when no appropriate actor was nearby.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where planting plots would not update their completion correctly on the map if the player moved to far away during their completion process.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Construction boxes spawned inside walls or other objects will now be placed in the hearthship upon reloading the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added precautions to prevent NPC's from getting stuck behind the kitchen area when trying to navigate up the nearby ramp.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue for the quest \"Probe 13-L\" when it was not activated through the hearthship's computer, causing the probe to not be interactable unless the player backtracked to a previous quest waypoint.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjustements and optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements to NPC dialogue management.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted certain vista views.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
