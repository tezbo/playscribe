  {
   "id": "distant-bloom-215851@major-2024-04-08",
   "gameId": "distant-bloom-215851",
   "displayName": "Update Notes - April 8th",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-08T12:33:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• NPC´s should now spawn correctly in base after main questline has been completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Sick beasts should now properly display the \"New Recipe Unlocked\" notification on being scanned.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• WASD movement in UI should now be fully functioning (W key was not functioning properly).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Foliage suppression for buildings should now be functioning properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a loading zone issue when moving between Marshy Fields Giant Grove areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a collision issue for the ascended architecture staircase near the Mederi vista point in Giant Grove.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug in critter/creep monster spawn logic that could multiply the amount.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug where Ruin icons on the map incorrectly greyed out upon completion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added QOL improvement for the base area where we increase the amount of critters when planting in the Hot Springs and Quarry areas, as well as in the base it self.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Due to inconsistent behavior when root bridges and snot monsters were both interacting with a planting plot, the snot monsters near the Deep Timberlands crystalite has been removed and the nearby root bridge replaced with a static bridge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
