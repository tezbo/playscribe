  {
   "id": "distant-bloom-215851@major-2024-04-18",
   "gameId": "distant-bloom-215851",
   "displayName": "Update Notes for April 18th",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-18T11:32:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue where the crew's wishes were being reset upon having completed the main story.: Wishes regarding decorations and repaired artifacts should be restored to their previous state but food items will unfortunately have to be re-gifted to the crew in order to be updated correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Elder, Usluk and Kei’ki were sometimes not spawning in the base properly after having completed the main story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where planting plots accessible after the main story were not displaying their compass markers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some map markers were overlapping.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where ruin markers were not displaying correctly on the map screen.: Due to the circumstances around this specific issue, save files where the ruins in the Carved Slope have already been explored might not have that ruins specific map marker update correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues where certain paths could avoid loading triggers, causing some areas to not load in properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
