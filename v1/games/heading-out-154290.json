  {
   "id": "heading-out-154290@1.028",
   "gameId": "heading-out-154290",
   "displayName": "Patch 1.028",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-23T15:01:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Heading Out v 1.028 Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Based on your feedback over the past couple of weeks, we've fixed up some things to make your road travels a bit less bumpy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Steam Deck Bug Fixes",
     "items": [
      {
       "text": "We have locked the settings to “medium” to ensure consistent, quality gameplay",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue of videos not playing on specific Steam Deck devices",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "PC Bug Fixes",
     "items": [
      {
       "text": "Fixed a general issue that caused the resolution to default to minimum settings. Now, it defaults to Ultra",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The anti-aliasing menu selection option has been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Occasional issues with stuttering have been addressed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "New loading map images now include day and night variants",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Extended the ghost car teleport audio radius to make it more audible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Trimmed the outro length for the “Same Old Road” full song",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "All mastered songs + WEM files have been updated both in the game and in the stand-alone OST download",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Police busting speed threshold has been lowered in special chase sequences",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the HUD reporting the wrong gear at the start of a race when using manual transmission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the manual gearbox displaying the wrong gear when exiting the pause screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Highlighting the menu difficulty option with a mouse is now fixed",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue with being unable to select different cars when using a controller after unlocking them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused a billboard to appear in the road on Oklahoma Plains",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some crashes that occur during random race sequences have been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some layout issues of the narrative comic sequences have been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several issues of missing or incorrect road signs in Act 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some instances of the road being transparent in some places in the City Outskirts map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some cases of unaligned haystacks appearing in the Iowa Farms map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed sound effect issues with the wooden bridge in the Minnesota Lakes map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a display issue with the resolution in a narrative comic sequence encounter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the term \"Bet\" was not being translated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that occasionally caused a player to become stuck when pressing the accelerate or brake button in the pause menu while moving around in map mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "To all who’ve joined us on this awesome road trip, a sincere “Thank You!” Working on Heading Out has been an amazing journey over the years, and we’re happy to have shared it with you. Safe travels!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
