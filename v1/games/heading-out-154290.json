  {
   "id": "heading-out-154290@major-2025-06-12",
   "gameId": "heading-out-154290",
   "displayName": "Patch Update + Console Release Announcement!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-12T16:48:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're thrilled to roll out a brand-new update for Heading Out, live today! This patch brings a smoother, more polished experience—especially for those of you playing on Steam Deck—and sets the stage for the road ahead. Here's what's under the hood:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "🛠️ Patch Notes",
     "items": [
      {
       "text": "✅ Optimized interface scaling for a more seamless experience on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "⚙️ Performance enhancements and overall quality-of-life improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎬 Stability improvements for in-game video playback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚫ Fixed black screen issues that were causing softlocks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎮 New setting: Option to disable controller vibration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔧 Upgraded game engine to support future updates and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And that’s not all...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🎉 Coming Soon to Console!",
     "items": [
      {
       "text": "We're excited to officially announce that Heading Out is shifting gears and heading to PlayStation 5 and Xbox Series X|S! Stay tuned for more details on the console launch soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "Come join us for a Live Stream on our Steam page with KingArgaroth today at 10 AM PDT / 7 PM CEST!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep on driving 🤙",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
