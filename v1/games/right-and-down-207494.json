  {
   "id": "right-and-down-207494@1.1.2",
   "gameId": "right-and-down-207494",
   "displayName": "Update 1.1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-21T17:59:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update is focused on the frozen altered status. Its effect has been diminished and we introduced five new artifacts and two skills that synergize with it. We hope that with this changes you show some love to the Snowland biome!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v1.1.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balancing: Impact of the frozen altered status has been reduced. From now on, the number of frozen artifacts is equal to your frozen points.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Content: 5 new artifacts, one for each biome and all related to the Frozen altered status.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Content: 2 new skills, both related to the Frozen altered status.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix: Improved the Japanese translation of the Daily Dungeon Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We are working on more stuff, more news soon. As always, let us know your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kiko",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
