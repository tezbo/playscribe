  {
   "id": "right-and-down-207494@1.0.2",
   "gameId": "right-and-down-207494",
   "displayName": "Update 1.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-20T17:28:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "v1.0.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quality of Life Feature: New feedback when you don't have enough experience to acquire a skill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Translation: Fixed minor errors in italian and english.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Translation: Fixed errors in the japanese tooltips (special thanks to 地獄変).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix: There was a problem displaying some tooltips when using chinese, japanese or korean language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Engineering Skills now doesn't activate Big Explosives artifact if there are no enemies available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Some artifacts that maxed HP were not stacking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: When two padlock cards were dealt a softlock where the player did not have movement options could happen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
