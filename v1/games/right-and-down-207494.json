  {
   "id": "right-and-down-207494@1.1.0",
   "gameId": "right-and-down-207494",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-07T14:53:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For this update, we have a new game mode: the Daily Dungeon Mode! There is available a new Dungeon each 24 hours, with three randomly selected modifiers. There are also 4 new achivements that you will unlock winning runs in the Daily Dungeon Mode :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are working on a Ledearbord for the Elemental Dungeon and Daily Dungeon Mode and also on controller support and keeping on eye on some balance stuff.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kiko",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "v1.1.0 Update",
     "items": [
      {
       "text": "New Game Mode: Play a randomly generated dungeon each day in the Daily Dungoen Mode!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix: Selection of the Gold Ripper artifact from the Perks was not working correctly (fixed again).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Ice Potion sound effect was too loud.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Tooltips in the Collection Section could be bugged when you returned to the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Improved navegation between different menus and sections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Some Artifacts where not getting highlighted when checking the next biome cards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Hunting Dagger artifact now gives the correct amount of MaxHP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
