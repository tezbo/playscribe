  {
   "id": "right-and-down-207494@1.0.4",
   "gameId": "right-and-down-207494",
   "displayName": "Update 1.0.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-24T14:34:00.000Z",
   "notes": [
    {
     "title": "v1.0.4 Changes",
     "items": [
      {
       "text": "Fix: It could happen that in Boss Levels the Campsite card was not dealt leading to a softlock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Poison tooltip was showing the incorrect poison damage value.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Some artifacts sound effects were too loud (Wine Bottle, Philosopher's Stone).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Balance: Reinforced Ring Artifact changed cost (7 to 8) and armor given (4 to 3).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balance: Dwarven Armor Artifact changed armor given (6 to 4).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balance: New Parts Skill changed armor given (8 to 6).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Translation: Fixed minor errors in english.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Translation: Improved japanese translation (special thanks again to 地獄変).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
