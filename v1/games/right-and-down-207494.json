  {
   "id": "right-and-down-207494@1.2.0",
   "gameId": "right-and-down-207494",
   "displayName": "Update 1.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-22T09:14:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "With this update we added controller support for the game! Although the control of the character is done using only two buttons, controller integration has required an effort to replace the mouse functionality, for example to check the tooltips of other cards or your current artifacts, but we are happy with the result!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you have any feedback about controller support or something is not working as intended, let us know about it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kiko",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v1.2.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Feature: Added Controller support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Translation: Added missing skills in spanish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
