  {
   "id": "bunny-park-127749@post-2020-02-11",
   "gameId": "bunny-park-127749",
   "displayName": "Bug fixes & Improvements",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2020-02-11T04:47:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! I've just released a small patch to fix some issues that have been reported since the launch of Bunny Park.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the butterfly AI. The butterflies don’t get stuck anymore and fly around faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added mouse camera controls. Move the camera by bringing your cursor to the edge of the screen. Rotate the camera by holding down the middle mouse button.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved game performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased the camera movement speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
