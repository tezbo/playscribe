   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Spring is here with a new set of decorations for Bunny Park!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Grow cherry and orange trees to feed your bunnies!",
