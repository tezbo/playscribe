  {
   "id": "the-ouroboros-king-215098@post-2023-03-16",
   "gameId": "the-ouroboros-king-215098",
   "displayName": "New difficulty 30 achievement, bugfixing",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-03-16T17:13:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added the witch hunter achievement after defeating the Coven at 30 difficulty, you should also get it upon loading the game if you beat the game at 30 difficulty in the past.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the consecutive stalemates bug, the softlock bug and some bugs regarding the interaction of marching boots with other items and relics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
