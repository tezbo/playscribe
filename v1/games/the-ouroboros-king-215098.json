   "displayName": "Infinity mode, bug fixes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-03-29T13:32:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I've added infinity mode (at the end of a run, you can keep fighting increasingly difficult enemies) and fixed some bugs (enemy taking over your army, smoke bomb on boss fights).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
