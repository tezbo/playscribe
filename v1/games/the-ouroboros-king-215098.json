  {
   "id": "the-ouroboros-king-215098@major-2023-04-07",
   "gameId": "the-ouroboros-king-215098",
   "displayName": "Infinity mode update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-07T12:45:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I've added progression to both the player and the enemies on infinity mode:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players will be able to complete their build, getting recruits, upgrades, new relics (up to 8 total), sacrifices and shops every 2 fights",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemies will get stronger with better units and get an extra relic every 10 fights (up to 8 total): Additionally, you can now skip any reward screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
