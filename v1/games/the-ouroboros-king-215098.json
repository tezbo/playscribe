  {
   "id": "the-ouroboros-king-215098@major-2023-05-18",
   "gameId": "the-ouroboros-king-215098",
   "displayName": "Content update + practice mode",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-18T16:29:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added more than 20 new units, including Agents * and L, a mysterious egg that has 2 upgrades and the powerful gorgon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted game balance, nerfing the power of blade dancer to a max of 2 moves per turn (can still do infinite, but you'll need a relic) as it was too powerful and easy to get.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Introduced Practice mode, where you can create arbitrary situations to play vs the AI, or use it to play local multiplayer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
