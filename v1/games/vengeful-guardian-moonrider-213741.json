   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings Moonriders,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It has been a while, but our team is excited to bring you new a patch containing:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚙️Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚖️Balancing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✨Revamped CRT Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "..and more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "BUG FIXES",
     "items": [
      {
       "text": "Fixed a bug where the player took damage before the Super Drone mid-boss in Asura's Fleet stage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Darkportal special weapon MP usage (it was using the Stormshot MP usage before): |*]Fixed a bug where Sunseeker would get stuck after an animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a map switch bug in the map screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed collisions in stage 2-2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the player sprite would disappear if it left the screen in stage 4-2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the player could drop out of the screen in stage 5-2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "BALANCING",
     "items": [
      {
       "text": "Lowered amount of iframes and damage to the Geocrash special weapon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Doubled the Firerang special weapon's damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made the Hydroshadow special weapon deal more damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made the big robot in level 8-1 stop spinning if the player shoots at it (it will now only spins once, then stop)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "NEW FEATURES",
     "items": [
      {
       "text": "Revamped CRT mode (Windows only) - 2 CRT modes (with and without border) and a CRT.ini file in the game's folder that can be customized",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a menu option to turn off double-tap to run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "MUSIC",
     "items": [
      {
       "text": "Added new music for the following parts : submarine boss, serpent boss, and brain jar boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated some music (Flamestalker Area 1, Geocrusher Area 2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎧 Treat your ears to the beats of Moonrider's OST, now available on all streaming platforms! https://idol-io.link/Moonrider",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
