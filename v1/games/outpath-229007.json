  {
   "id": "outpath-229007@1.1.1",
   "gameId": "outpath-229007",
   "displayName": "Update 1.1.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-09T03:00:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey! David here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Outpath v1.1.1 is out! Bug fixes from your reports, cheaper monoliths and some wind.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes from your reports",
     "items": [
      {
       "text": "I went through the Discussions and the reviews, and fixed the bugs you found.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Suppliers now feed every crafting station in their range, whatever you built first.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Cauldron of Spirits no longer loses your creatures: putting in a different one swaps them and gives you back the ones inside.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Deleting a save works again, and beds now tell you when you are too hungry to sleep.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Cheaper monoliths",
     "items": [
      {
       "text": "The first monolith now asks for 40 Wood instead of 150.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other monoliths and the Amberpath expansions are cheaper too, also in games you already started.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Monoliths now take items or credits only when you have the full amount, so a click by mistake can't leave you without them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Wind",
     "items": [
      {
       "text": "Plants and trees now sway in the wind, with faint air currents around you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Animals and pets now face where they are going.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Multiplayer (experimental)",
     "items": [
      {
       "text": "Your Steam friends can now join your game from their friends list, even if they were offline when you invited them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Added",
     "items": [
      {
       "text": "Plants and trees sway in the wind, with faint air currents.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Changed",
     "items": [
      {
       "text": "Monoliths only take items or credits all at once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheaper monoliths and Amberpath expansions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Friends can join you from their Steam friends list.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed the Island eater achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Animals and pets now face where they are going.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixed",
     "items": [
      {
       "text": "The Output required achievement now always unlocks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The expansion monolith no longer gets stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Suppliers now feed every station in their range.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Deleting a save works again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cauldron of Spirits now swaps creatures and empties properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Beds now say when you are too hungry to sleep.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chill mode no longer blocks the bed after loading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Negative craft amounts no longer give free materials.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you like my work and want to support me, I really appreciate a review of the game! ːluvː ːwinter2019happybulbː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Check the Official Discord where I am active.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "David ːwinter2019happyyulː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
