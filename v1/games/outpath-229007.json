  {
   "id": "outpath-229007@1.0.6",
   "gameId": "outpath-229007",
   "displayName": "Update 1.0.6",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-20T02:29:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
