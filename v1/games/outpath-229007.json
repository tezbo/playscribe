      }
     ]
    },
    {
     "title": "Change Log",
     "items": [
      {
       "text": "+ A system has been added to prevent Save Files from the full game from being used in the Demo. Avoiding losing all progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NOTE: It is also NOT possible to transfer the FULL VERSION Save File to the prologue (First Journey). I couldn't update that version, sorry.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Buffed quantity of luslite drops and luslite deposit's health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed some translation words.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Honey creation speed has been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Next thing I will fix are the achievements and a few more bugs!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Have a nice day/night! :winter2019happyyul",
     "items": [
      {
       "text": "David",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
