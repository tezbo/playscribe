  {
   "id": "outpath-229007@1.0.11",
   "gameId": "outpath-229007",
   "displayName": "Update 1.0.11",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-28T22:16:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It took me a lot of time to fix some of these, I hope you like this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Change Log",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Added load system so corrupted/lost save files will be replaced with an older save file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ New resource in biome 1 and 2: Bush.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ New craft: Fishbone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ You can obtain the 8th letter now in game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Added icon when saving manually or auto-save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Decreased Chlorophyll needed in Reinforced Thread and Reinforced Leather.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Celestial View can be automated with the Clicker.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fuser can be automated with the Clicker.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Suppliers will not take items from your inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Reduce building cost of the Advanced Research Table.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Marshmallow now spawns more often.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you like my work and want to support me, I really appreciate a review of the game! ːluvː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ːwinter2019happybulbː Check the Official Discord where I am always active.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "David ːwinter2019happyyulː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
