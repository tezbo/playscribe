  {
   "id": "a-night-on-the-farm-266431@post-2024-02-28",
   "gameId": "a-night-on-the-farm-266431",
   "displayName": "Patch Notes for February 27, 2024",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-02-28T00:38:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all! I added a couple more Options to the game based on feedback and fixed a small bug as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an Option to toggle the Gameplay UI On or Off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an Option to set the Opacity of the Aiming Reticle. (You can set it all the way down to zero if you don't want to see it at all.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bug Fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that would prompt the player to interact with certain objects that weren't supposed to be interacted with. (Broken keyboards, for example.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
