   "id": "a-night-on-the-farm-266431@patch-2024-02-23",
   "gameId": "a-night-on-the-farm-266431",
   "displayName": "Patch (3) Notes for February 22, 2024",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-02-23T03:29:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all! One more patch for the day. (Third time's the charm!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a small visual bug where we'd see the player's POV settling down onto the ground when we loaded into a scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Refactored code (to prevent a possible bug) related to spawning the player into the correct position in the game world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's all! (It was a long day.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
