  {
   "id": "a-night-on-the-farm-266431@1.2",
   "gameId": "a-night-on-the-farm-266431",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-02-21T02:21:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all! Here's Build 1.2! As you'll see below, this patch added controller vibration support, and I tweaked a couple of things as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
