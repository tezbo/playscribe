  {
   "id": "a-night-on-the-farm-266431@patch-2024-02-22",
   "gameId": "a-night-on-the-farm-266431",
   "displayName": "Patch (1) Notes for February 22, 2024",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-02-22T19:24:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all! This patch contains 1 Bug Fix and 1 Performance Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an Animation bug that would make the game scene not fade out properly when accessing the cellar doors by the house.: NOTE: This bug occurred due to the changes I made in the last update, when I adjusted the Animator on the \"Car Fade In\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Performance Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game's Shadow Map Texture has been cut in half. It was 4096, but only on accident. I have halved it to 2048. Because of this, you'll notice the shadows on the fence and house are softer. Doing this retains the game's intended visual style, but should help (at least a little) with performance on low-end machines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That is all! As always, thanks for the support and bringing these issues to my attention!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
