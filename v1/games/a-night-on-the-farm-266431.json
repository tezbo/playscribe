  {
   "id": "a-night-on-the-farm-266431@1.4",
   "gameId": "a-night-on-the-farm-266431",
   "displayName": "Patch 1.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-16T03:06:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all! Here's Build 1.4! (The \"SUPER PERFORMANCE BOOST\" build!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update increases the game's performance across the board by drastically reducing CPU Draw Calls and using some new optimization techniques.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game will now run at a constant 90 FPS on Steam Deck OLED! (99.9% of the time.)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "I also fixed a few \"fringe case\" bugs that I stumbled into while updating/testing this new version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now that the game runs silky-smooth this might be the last update for a while, unless someone reports a new bug.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thanks a bunch for the amazing support and all the kind words about the game! Happy Farming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
