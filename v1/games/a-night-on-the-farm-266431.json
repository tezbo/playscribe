   "announcedAt": "2024-02-16T23:02:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added and FOV Option. (Field of View can be set from 40 - 60, in increments of 5).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased \"Interaction Distance\" on all interactable objects in the game. (You can now select objects from farther away, which should make navigating the game world easier.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the animation on the drawer you find the flashlight in.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Configured animations on certain objects in the game, so you don't see them initializing when loading into certain scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the position on a certain game object that points to a certain area (I'm trying to avoid spoilers here), to make it a TINY bit more understandable as to where you're supposed to search.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Other miscellaneous touchups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
