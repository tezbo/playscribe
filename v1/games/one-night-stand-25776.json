  {
   "id": "one-night-stand-25776@2.3",
   "gameId": "one-night-stand-25776",
   "displayName": "Update 2.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-14T11:06:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone, it's been a while! ːons_shewavesː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A small new update has just released for One Night Stand. It features:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A clearer credits page",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Translation fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "...and a whole new look for Kinmoku (that's me!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please update so you have the latest version of the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Inspired by the early roots of visual novels – from PC-98 to Sega Saturn – the new splash artwork features Kinmoku in their studio. If you look closely you can see references to Kinmoku's games, and even their dog, Goro!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To learn more about the developer, please check out the new website at www.kinmoku.games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
