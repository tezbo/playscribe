  {
   "id": "one-night-stand-25776@2.32",
   "gameId": "one-night-stand-25776",
   "displayName": "Update 2.32",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-03T10:55:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update has gone live today (2.32) which updates the game engine and fixes three ending achievements that had stopped working. If you recently played the game and these achievements didn't unlock for you, please update and load the game. The missing achievements should unlock immediately! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Apologies for the inconvenience and thank you to those who alerted me to the problem. If anyone is still having issues, please contact me at contact (at) kinmoku (dot) games and I will take a look.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
