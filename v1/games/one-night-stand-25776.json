  {
   "id": "one-night-stand-25776@2.282",
   "gameId": "one-night-stand-25776",
   "displayName": "Update 2.282",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-03-25T11:37:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone. This update fixes achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Yesterday, some users reported that achievements had stopped working after the big update. This was caused by the latest engine updates not supporting Steam achievements correctly. This unfortunately means that Mac OSX 10.15+ can no longer be supported. I have contacted the Ren'Py developers directly and hope this issue will soon be resolved so Mac OSX 10.15+ will be fully compatible. Until then, I advise Mac OSX 10.15+ users to download One Night Stand on itch.io, as this version is 64bit.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
