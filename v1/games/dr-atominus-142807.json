  {
   "id": "dr-atominus-142807@post-2021-07-06",
   "gameId": "dr-atominus-142807",
   "displayName": "Bug fixes & controller instructions",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-07-06T15:20:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here is a little update for Dr. Atominus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This is mostly bug fixes. These bugs were fixed",
     "items": [
      {
       "text": "Fixed player getting key when it wasn't supposed to get it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Disabled room restart button where it shouldn't be used",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that slowed down performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated Finnish translation: Also controller instructions were added. When playing with a controller, it shows for example, press \"A\", instead of press \"Z\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
