  {
   "id": "hell-is-us-196954@post-2025-08-12",
   "gameId": "hell-is-us-196954",
   "displayName": "HELL IS US – New Demo Patch Notes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-08-12T08:16:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Hell is Us demo is back! It will be available at 3 PM CEST / 6 AM PT.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Months after its first appearance, the demo returns — now enhanced with new features, quality-of-life improvements, and refined gameplay to make your return to Hadea even smoother. Here’s what’s changed since the last time you played:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🎥 New Camera Options",
     "items": [
      {
       "text": "Camera Follow toggle on/off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Movement Lag and Rotation Lag adjustments for smoother control.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "📦 New Inventory Organisation",
     "items": [
      {
       "text": "Added Favorites and Archives tabs for quicker access to your items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "⚙️ New Difficulty Screen",
     "items": [
      {
       "text": "Choose your preferred difficulty level more easily.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "📟 Optimisation",
     "items": [
      {
       "text": "Graphics improvements — now playable in 4K at 60 FPS, among other enhancements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "📸 Photo Mode Added",
     "items": [
      {
       "text": "Capture your most stunning moments directly in-game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🌍 Added Localisations",
     "items": [
      {
       "text": "French voice-over now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Text language support for Chinese and Japanese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🗡️ Parry & Riposte Tweaks",
     "items": [
      {
       "text": "While all attacks can be blocked, only certain attacks can now be parried, triggering a counter-attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added a visual cue for parryable attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "New dedicated tutorial.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Riposte camera sequence now only plays once every 5 to 10 ripostes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "🎯 Lock-On / Targeting Tweaks",
     "items": [
      {
       "text": "Added up/down switching when enemies, at the centre of the screen, are in front of one another.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Smoother camera movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "📟 Miscellaneous",
     "items": [
      {
       "text": "Datapad full boot screen only shows the first time you open it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Multiple bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various optimisations for better performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Whether you played the first demo or are discovering Hell is Us for the very first time, now’s the perfect moment to jump back in and see what’s new.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We look forward to hearing your feedback — see you in Hadea.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
