  {
   "id": "hell-is-us-196954@major-2026-09-04",
   "gameId": "hell-is-us-196954",
   "displayName": "Teaser Trailer - Major Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-04T17:41:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42249540/ac001c05fd0649bce95b77f76993a1f0ed34908f.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today marks the first anniversary of Hell is Us, when you stepped into Hadea as Remi to fight the Calamity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the last 12 months, we've been listening.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On October 8th, alongside the release of the Nintendo Switch 2 version, a major update is coming to all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To the 1.5 million players: THANK YOU!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
