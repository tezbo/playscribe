  {
   "id": "hell-is-us-196954@post-2025-09-23",
   "gameId": "hell-is-us-196954",
   "displayName": "Hell is Us | Patch Notes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-23T13:17:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42249540/c46b763bbe78c771a5b21a71d595ccabf3357204.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[p align=\"start\"]· Interact actions can now be remapped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[p align=\"start\"]· Weapon information panel now displays charge attack damage values.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[p align=\"start\"]· Timeloop designation (tier and codename) is now shown in the Exploration tab of the datapad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[p align=\"start\"]· Drone Translation and Observation screens feature a larger text window.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[p align=\"start\"]· Last consumable item now remains in the loadout with a quantity of 0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[p align=\"start\"]· Crafting of items is blocked if there isn’t enough inventory space.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[p align=\"start\"]· Player’s HUD bar will dynamically hide even when a permanent buff is active.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Fixed a rare issue preventing interaction with the rotating door puzzle after the Monsters Do Exist cinematic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Endgame save is now created after the cinematic, allowing players to retrigger it in case of a crash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Fixed a potential crash when traveling to the Auriga Museum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Gluttony Glyph behavior now correctly matches its description.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Various fixes for input remapping and display.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Removed stutter when sliding down ladders with camera movement lag value below 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Fixed potential issue with incorrect character rotation when using ladders.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Exiting the Navigation map while selecting a travel destination no longer causes a soft lock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Subtitles now behave correctly when crafting, researching, or pausing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Fixed multiple level collision issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Fixed various audio issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Fixed various rare crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Fixed multiple UI issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Fixed several combat issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]· Achievements/Trophies now calculate correctly if data was accumulated in another save slot or in the demo. This affects the following:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]o Man of the People",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]o Super-Sleuth",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]o Good Vibrations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]o Tech-Savvy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]o Emotional Damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]o Emotional Warfade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]o Curator",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]o Antiquarian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]o Keymaster",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "[p align=\"start\"]· Default HDR minimum luminance changed to 3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "[p align=\"start\"]· Animosity Glyph behavior improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "[p align=\"start\"]· Teleport skills now better detect the environment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "PC Only",
     "items": [
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[p align=\"start\"]· Monitor selection is now available in video settings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[p align=\"start\"]· DLSS Frame Generation no longer requires a game restart.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[p align=\"start\"]· Upscalers and Frame Generators now exclude themselves correctly.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Xbox Series X Only",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[p align=\"start\"]· Potential fix for crash in Quality Mode when traveling to APC or another map.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[p align=\"start\"]Additionally, multiple optimizations and bug fixes have also been applied to improve overall stability and gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
