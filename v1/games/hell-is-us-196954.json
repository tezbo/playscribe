  {
   "id": "hell-is-us-196954@major-2026-10-08",
   "gameId": "hell-is-us-196954",
   "displayName": "Hell is Us Major Update | Patch Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-08T13:05:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42249540/6eda5944fb1b732b49bb1b5357dd1dd59b8c81fc.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Whether you’re returning to Hadea or joining the over 2 million players who have already stepped into its world, there’s something new waiting for you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update 1.8 is now available, adding 10 new Hollow Walkers to Hell is Us, alongside fixes for the save system and collision issues. We heard your feedback on enemy variety, and these new additions bring more diversity to the foes you’ll encounter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New content",
     "items": [
      {
       "text": "10 new Hollow Walkers to encounter on your journey through Hadea.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed a memory corruption issue affecting the save system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several collision issues across different maps that could leave players stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various other bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Steam build: 1.8.125.51687",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for playing and sharing your feedback. See you in Hadea!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
