  {
   "id": "doors-paradox-174803@major-2022-10-28",
   "gameId": "doors-paradox-174803",
   "displayName": "🎃 Halloween Demo Update — Play Now! 🎃",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-28T10:46:58.000Z",
   "notes": [
    {
     "title": "Happy Halloween, puzzlers! ːsteamhappyː",
     "items": [
      {
       "text": "You know it’s Halloween time when the leaves have fallen, everyone drinks pumpkin spice latte and your neighborhood looks like a scary Doors level — vampire houses, spiderwebs everywhere, black cats and a creepy goat head that came straight from your nightmares.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Take out your candy bag, because boy do we have a treat for you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "For the whole month of Spooktober all the way till 4th of November, Doors: Paradox will treat the horror enthusiasts with a spoopy Halloween demo, which features",
     "items": [
      {
       "text": "A vampire mansion riddled with mysteries",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A spiritual séance in the middle of a cemetery",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The tormented souls of a creepy mental asylum",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A spider lair entangled with the voices of the past",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "13 Languages localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
