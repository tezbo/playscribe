   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some players reflected that the localization of Japanese Korean was not done well enough, so we re-invited more experienced translation teachers to optimize it, and added eight new languages, Russian, Polish, Spanish, Portuguese (Brazil), Arabic, French, Italian, German, hoping to reach more players around the globe, and if you have any questions and comments and suggestions, please feel free to contact us ( shanyuhai@shanhaixingchen.com).",
       "ps5ProOnly": false,
