  {
   "id": "superscout-296238@major-2024-07-21",
   "gameId": "superscout-296238",
   "displayName": "Second update of the official version",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-21T11:37:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The second update of the official version, updated as follows:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1、Fixed the problem that the branch in chapter 7 cannot be solved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Optimized the correct display of achievement names.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Fixed the problem that achievements were triggered incorrectly if the conditions were not met.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Fixed incorrect display of story line titles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Fixed the problem that the text is displayed incorrectly when giving flowers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
