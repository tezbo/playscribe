  {
   "id": "destroy-all-humans-2-reprobed-171214@post-2022-12-14",
   "gameId": "destroy-all-humans-2-reprobed-171214",
   "displayName": "It's beginning to sound a lot like Patch Notes!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-12-14T13:52:09.000Z",
   "notes": [
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "General",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed so the Ninja Bodyguard mutator is no longer visible in certain cutscenes during mission 9 – “The Majestic File”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a replay issue from the Holopox deck (mission 06 – “No Pox Please We're British”).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed that the subtitles do not follow the voice over during a cutscene in Oddjob 01 – “I Left My Parts In San Fran... Err, Bay City”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an audio issue encountered in the cutscene after completing Arkvoodle mission 16 – “The Coming of Arkvoodle”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed so the Dislocator will not lose ammo under certain circumstances in Solaris.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed SFX issues in Takoshima",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a number of respawn issues in water",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Stability issues",
     "items": [
      {
       "text": "• Fixed a rare crash in Takoshima when the alert level is raised",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed a rare crash after an attack wave in mission 20 - \"The Comrade Who Came From The Cold\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed a rare crash at the end of mission 2 - \"Where Have All The Flower Children Gone?\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Community reported issues fixed",
     "items": [
      {
       "text": "• Fixed a rare crash whilst exiting the Jukebox",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed that the Moghra egg in OddJob 18 – “The Ravages of Mohgra” is overly sensitive to disturbance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed so the proximity detector is now functioning when discovering Furotech Cell or Artefacts in Takoshima.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed an issue after Photo Mode in Solaris, where Crypto's breathing bubble is active in Bodysnatch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed the Jukebox, so every song is playing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed audio issues during a cutscene after completing Arkvoodle mission 16 – “The Coming of Arkvoodle”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed audio issues during a cutscene in mission 16 – “Kojira Kaiju Battle”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed an audio issue during a cutscene in OddJob 01 – “I Left My Parts In San Fran... Err, Bay City”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
