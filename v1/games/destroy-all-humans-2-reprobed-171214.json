  {
   "id": "destroy-all-humans-2-reprobed-171214@2",
   "gameId": "destroy-all-humans-2-reprobed-171214",
   "displayName": "Patch 2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-19T15:12:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The controller layout for the saucer has now correct information",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues when the second player joins whilst the first player is in the saucer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed that the mission “Space 1969” could not be finished when the player respawned during the last objective",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Natalya’s NPC behavior during “You Only Live 137 Times” mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple collision issues in Takoshima",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the low height limit for the Saucer in Solaris",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed collisions on the moon rovers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the camera posts disappearing in “On Natalya’s Secret Service”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crashes about the Photo Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Blisk mutants getting stuck outside the gameplay area during the mission “Le Femme Natalya”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed unwanted controller feedback when using PK slam on NPC’s",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some issues with the traffic system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bodysnatch and Bodysnatch cancel is now again triggered with the same key (default: F)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added some more keybinding options: Cloak: Dismiss Tutorial: Expand Tutorial: Open Map: Player Facing Cheats",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Issues still being investigated",
     "items": [
      {
       "text": "On PC, certain rare Nvidia hardware/software configurations may experience a persistent issue causing the game to crash: We are currently investigating this with Nvidia.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
