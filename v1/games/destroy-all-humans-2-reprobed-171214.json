  {
   "id": "destroy-all-humans-2-reprobed-171214@1",
   "gameId": "destroy-all-humans-2-reprobed-171214",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-09-20T13:14:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a rare issue after Mission 8 where the button to land the saucer would not work for some players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare issue that could block progress with on-screen HUD ‘NaviCom’ (shortcut from saucer) to display / disable correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare issue preventing the player from landing the saucer during Mission 16",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue related to Crypto dying and respawning several times that would cause enemy pop-up turrets to not activate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with enemy turrets in Mission 15 not correctly respawning if destroyed in ‘open world’ play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that spamming the Saucer’s SlurpMaster and Abduct-o-Beam together could cause a crash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an urgent issue causing Albion world to remain locked after exiting the ‘No Pox Please We’re British’ if the player travels back to Bay City",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue preventing the bonus ‘Salad Days’ videos from playing fully",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a common issue with the player not receiving the announced Furotech reward after completing ‘Lights Out For Lobsters’ side-mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could break mission access in savegames if the player used the Navicom to travel during an active mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a common issue with the player not receiving the announced Furotech reward after completing Mission 27 ‘Dark Side of the Moon’",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash (and possible savegame corruption) caused by selecting ‘continue’ after leaving the HoloPox deck during ‘Guns of Alcatraz’ mission with certain Mutators active",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an urgent issue causing access to Takoshima world to be incorrectly locked after completing ‘Revenge of the Ninja’ mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an urgent issue preventing progress after selecting ‘Freaky Flyers’ Arkvoodle quest via the HoloPox deck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an urgent issue causing Tunguska world to remain locked incorrectly after completing ‘The Siberian Job’ mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue preventing the Weapon Selector (Q key) from being remapped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare issue that could cause a crash during Mission 12 while fighting Black Ninjas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a keybinding / remapping issue to allow ‘cancel bodysnatch’ to be changed correctly",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Bug with workaround fix",
     "items": [
      {
       "text": "In HoloPox Deck, leaving the mission “Guns of Alcatraz” during the Destroy the Nuke Vans step and then selecting Continue, removes the nuke vans, preventing progress and leading to a corrupted save game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Happens if the following mutators are active",
     "items": [
      {
       "text": "Transmog Mork Mod",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Murica",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Silhouette’s Mask",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graviton Lunaformer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This issue is fixed now, but to fix the save game, please restart the mission from the beginning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
