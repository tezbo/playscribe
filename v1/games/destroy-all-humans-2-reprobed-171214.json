  {
   "id": "destroy-all-humans-2-reprobed-171214@patch-2023-06-21",
   "gameId": "destroy-all-humans-2-reprobed-171214",
   "displayName": "Summer Patch! Tell me more, tell me more…",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-06-21T15:01:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "… like, did he throw a car? Tell me more, tell me more, did it fly really far? (you know the melody ;) )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General fixes",
     "items": [
      {
       "text": "Fixed various performance issues for PC and Steamdeck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed that the “Meteor Strike” is disabled when the player is leaving Photo Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a display issue with one of the skins in a cutscene in the first mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed that a mission step in Arkvoodle mission “Con Mods“ didn’t fail if the building targeted by the enemy gets destroyed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed that Gastro’s voice-over lines did not play correctly in some instances in German",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the hours played entry displayed in the Statisticon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed shaders issue in the Takoshima environment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed random potential blocker issue with the turret behavior in the Mission 15 “You only Live 137 Times”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Player-reported issues",
     "items": [
      {
       "text": "Fixed an unlocking issue with the Quantum Deconstructor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed that the mission “The Ravages of Mohgra” is not failing any longer when the eggs are dropped in the volcano incorrectly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed that Crypto's body-snatched body will no longer disappear after being abandoned and hit by a car.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed that if the player is in a body-snatched NPC and gets hit by a car, the NPC will continuously screams and not stop (I kinda miss that one)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed so the player is now able to change key bindings for PK Slam whilst in bodysnatch",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed that in Mission “The Alien Who Probed Me” Bongwater does not get stuck in running animation after his attack has been cancelled by a Dislocator hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the proximity detector to ensure it works more consistently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enjoy the Summerfest and spread the Good Pick-up (this game) Line of the Great Arkvoodle!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
