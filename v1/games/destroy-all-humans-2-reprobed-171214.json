  {
   "id": "destroy-all-humans-2-reprobed-171214@6.9",
   "gameId": "destroy-all-humans-2-reprobed-171214",
   "displayName": "Patch 6.9",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-09-15T15:00:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "General performance improvements and switch from DirectX11 to DirectX12",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reworked Landscape setup:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Four times the amount of component tiles allow for improved lodding of the landscape",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed unnecessary landscape component tiles that are under water or not visible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Landscape, LOD and occluder improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reworked complex lighting scenarios in Cutscenes and Dialogues, reducing lights and shadow casting to improve visual readability and performance of the scenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reworked falling rocks behaviour in the Volcano in Takoshima and in the bunkers in Tunguska",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Optimized Kojira Boss Fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kojira building destruction doesn't cause the navigation to constantly regenerate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Amount of active NPCs and vehicles is reduced when in the Flying Saucer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visibility fixes and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed visibility issues in the Volcano where the player would disappear at a certain spot during the lava escape segment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Created additional visibility zones when inside the Blisk base on the moon, skipping rendering of the Solaris base when it's not needed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated Map in Solaris so the Blisk bases are treated as an underground area and only rendered when appropriate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
