  {
   "id": "r-type-tactics-i-ii-cosmos-225776@1.0.7",
   "gameId": "r-type-tactics-i-ii-cosmos-225776",
   "displayName": "Update 1.0.7",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-14T18:10:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello commanders,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released version 1.0.7, which fixes the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue in certain missions where the background was rendered in front of the hex grid.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the combat effects for certain units on the mission screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where it was difficult to move the cursor straight up and down when selecting hexes with the analog stick during missions, causing only diagonal inputs to be available. Note: If you want to input directions precisely in the four cardinal directions, we recommend using the directional buttons (D-pad).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where, if the game window was unfocused then refocused such as through Alt+Tab, the Max FPS Setting would no longer apply correctly.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Various other bug fixes, text fixes, and stability improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues with this patch, please report the issue in the troubleshooting forums, or send issue information to gamesupport@nisamerica.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you, and we hope that you will continue to enjoy playing R-Type Tactics I • II Cosmos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
