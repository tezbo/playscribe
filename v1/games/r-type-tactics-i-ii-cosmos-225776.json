  {
   "id": "r-type-tactics-i-ii-cosmos-225776@1.0.6",
   "gameId": "r-type-tactics-i-ii-cosmos-225776",
   "displayName": "Update 1.0.6",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-08-19T18:00:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello commanders,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released version 1.0.6, which fixes the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where in missions, if you do an input such as moving the control stick while the command window is open, the hex selection cursor moves even though it is in the background.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where, when using a Desynch Sonar-type weapon, a sound would play in response to detecting allied units.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the displayed damage amount during missions could be invalid.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where, if there is a unit that has damaged parts, saving and reloading could make the visuals of the damaged parts revert to the undamaged appearance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some units were displayed too small relative to the hex size.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted some unit 3D models.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted some combat visual effects and animations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Additional fixes and improvements to bugs and stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues with this patch, please report the issue in the troubleshooting forums, or send issue information to gamesupport@nisamerica.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you, and we hope that you will continue to enjoy playing R-Type Tactics I • II Cosmos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
