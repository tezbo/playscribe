  {
   "id": "r-type-tactics-i-ii-cosmos-225776@1.0.4",
   "gameId": "r-type-tactics-i-ii-cosmos-225776",
   "displayName": "Update 1.0.4",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-07-24T17:01:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello commanders,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released version 1.0.4, which fixes the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue on Steam Deck where movies would not play on certain configurations.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Adjusted some combat environments and combat effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted behavior of the \"new\" icon notice in the Unit Development Map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where the sound effect when a unit is destroyed could be cut off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that occurred when ramming with a multi-hex unit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed control-related issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted anti-crashing routines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Other fixes and improvements to bugs and stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes that were applied in version 1.0.3",
     "items": [
      {
       "text": "Fixed an issue on Steam Deck where the game would not progress when in offline mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where certain units could not be targeted with mouse controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Text fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you encounter any issues with this patch, please report the issue in the troubleshooting forums, or send issue information to gamesupport@nisamerica.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you, and we hope that you will continue to enjoy playing R-Type Tactics I • II Cosmos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Edit: An issue has been discovered that appears to occur on 1.0.4 but not 1.0.3:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "During certain attacking animations, if you disactivate the game window with Alt+Tab, the game can enter a state where control is not given back to the user and the game cannot progress.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The public version of the game has temporarily been reverted to 1.0.3 while we investigate this issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for your understanding, and we apologize for any inconveniences caused by this issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
