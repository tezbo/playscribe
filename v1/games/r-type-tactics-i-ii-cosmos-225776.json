  {
   "id": "r-type-tactics-i-ii-cosmos-225776@1.0.5",
   "gameId": "r-type-tactics-i-ii-cosmos-225776",
   "displayName": "Update 1.0.5",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-08-11T18:40:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello commanders,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released version 1.0.5, which fixes the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where in version 1.0.4, the game could enter a soft-locked state if the game window is unfocused during certain combat animations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where in version 1.0.4, spoils on the map during missions would become invisible if the game window became unfocused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where outlines were displayed incorrectly when View Distance was set to Low.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the \"New\" icon on the Unit Development menu option would not disappear correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the duplicate game cursors could be displayed during missions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue a red rectangle could be displayed when clicking outside of the game window during certain missions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed other issues relating to the mission information screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Additional fixes and adjustments to bugs and stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues with this patch, please report the issue in the troubleshooting forums, or send issue information to gamesupport@nisamerica.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you, and we hope that you will continue to enjoy playing R-Type Tactics I • II Cosmos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
