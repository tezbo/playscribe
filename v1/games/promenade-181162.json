   "announcedAt": "2025-01-20T14:32:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Judder effect is fixed: now the FPS matches the refresh rate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The bloom can now be deactivated. Players experiencing the blooming text being out of control can now set the brightness to 0% and play the game normally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We worked on the color calibration for the whole game. Promenade’s colors have never been so vivid!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Addition of a Chinese localization!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Addition of a Japanese localization!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
