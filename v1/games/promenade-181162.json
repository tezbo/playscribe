  {
   "id": "promenade-181162@1.0.2",
   "gameId": "promenade-181162",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-06T16:15:26.000Z",
   "notes": [
    {
     "title": "Gameplay Tweaks",
     "items": [
      {
       "text": "Now pressing jump mid air is the ONLY way of doing a double jump. Pressing \"down\" + \"throw\" doesn't work anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "When holding the UP direction with a flying bird in the hands, the Nemo now flies upward faster",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Clouds are more forgiving in the Tumult, Nemo must be in contact with the clouds for 0,5 sec",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Slinghops can now be prevented by inputing a direction opposed to Nemo's momentum",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adding a jump buffer: checking if Nemo will be landing on the ground in the next few frames, thus preventing a double jump that would use the object in his hands",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adding a rolling buffer: checking if Nemo will be landing on the ground in the next few frames, thus preventing throwing the poulp downwards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changing the visual aspect of the cogs that the player already collected, making them more distinct from uncollected cogs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Small spelling errors for the english localization (it seems like I can't spell the word \"developer\")",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The \"Madeline would be proud\" achievment now properly unlocks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixing the bug of the empty bubbles for the cauldron and the chicken guy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Properly healing the player when collecting a full cog if the \"skip catch cog animation\" option is enabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In the museum, sometims objects were destroyed by touching the pedestal before getting registered",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixing the crashes in space when changing area with the spaceship",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Properly resetting power up boss fight when the player miraculously manages to die at the same time as the boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The chicken's position is properly reset in the Memory Lane trial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixing some camera jank in Verdant Voyage's houses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players cannot get stuck inside the mole's colliders when staying on top of them anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Making the Masked Demon's Lair pieces are now invulnerable to explosions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Masked Demon's Lair entrance cannot be open with no piece connected to the entrance anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixing a small visual issue that misplaced the poulp to the left or right after collecting a powerup",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other very minor tweaks…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
