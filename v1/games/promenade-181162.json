       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other Fixes",
     "items": [
      {
       "text": "Level were sometimes not properly unloaded when going back to the Great Elevator from the pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The patch 1.0.2 introduced a bug that sometimes cancelled your double jump for seemingly no reason",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
