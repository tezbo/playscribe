  {
   "id": "intrepid-izzy-135822@1.0.19",
   "gameId": "intrepid-izzy-135822",
   "displayName": "Update 1.0.19",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-09-01T19:41:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello friends,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is not the first update to Intrepid Izzy, but it is the first one with an annoucement and a changelog!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "v1.0.19",
     "items": [
      {
       "text": "The version number is now displayed on the title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keyboard controls: Enter no longer pauses the game, only Esc does. Enter can now be used to confirm dialogues.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Removed \"Game Over\" screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where objectives could re-appear after previously being completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed location in East Pole where Izzy could get stuck while wearing the vampire suit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed save slot preview image for Temple of Nuts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added dotted lines between connected doors on the map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Leviathan now has some defense against the vampire special, so the fight isn't over too quickly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added crates to the uppercut tutorial in Blobby Blob Dungeon, to make sure it can't be inadvertently skipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bullets in \"Plerg!\" have a slightly larger hitbox now, which should make the game feel more intuitive/fair.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new NPC in the Chocolate Mine provides hints about garlic and the helmet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many other small changes in various levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Earlier updates",
     "items": [
      {
       "text": "F,F+A move is disabled by default, because for some players it happened by accident.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed crash bug when opening the map screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several places in levels where Izzy could get stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed sound bug.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
