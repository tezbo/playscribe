     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "this is a minor patch that we are releasing quickly to address a potential crash on saving that can happen in some circumstances (fortunately after the save was successfully written).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full Changelog",
     "items": [
      {
       "text": "Fix a potential (non-deterministically occurring) crash after saving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a minor graphical issue with one particular effect object",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix the \"Always show turn order\" option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix mouse wheel scrolling in shop menus with more than 8 party members",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Minor efficiency improvements when loading audio files",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor localization text fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the unlikely event that this update causes any issues for you, you can revert to the previous version using the \"Game Versions & Betas\" feature on Steam.",
