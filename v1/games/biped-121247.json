  {
   "id": "biped-121247@major-2024-09-18",
   "gameId": "biped-121247",
   "displayName": "Small COOP update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-18T15:44:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi adventurers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A small update for the Chinese players: we have fixed the online COOP part. There might still be an issue when you turn back to the Main Menu and try to start an Online COOP once again - but please, simply re-launch the game and you will be good.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We keep on tracking if any other issues occur and will update the game respectively.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for waiting for the fix and hope that you will be able to enjoy the updated version now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also, we have released a new Dev Diary and updated Biped 2 page. Time to check it out:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All the best.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
