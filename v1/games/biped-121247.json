  {
   "id": "biped-121247@1.9",
   "gameId": "biped-121247",
   "displayName": "Update 1.9",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-07T11:14:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear adventurers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some players have reported issues with the game's stability, and we have prepared a small patch that might fix these issues. If you have experienced issues with the game before (including the black screen at launch), please check if it is fixed for you now. If not, please send us your DxDiags to team@metapublishing.io, and we will have a deeper look at it. All your system configurations are different so we try to fit them all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All the best.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
