  {
   "id": "biped-121247@1.4",
   "gameId": "biped-121247",
   "displayName": "Patch 1.4",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2020-04-17T12:09:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we are happy to announce that biped now supports Remote Play Together and mobile controls. The change means now you can share and play biped with a friend without needing them to be in the same room as you. And now you can play biped from your mobile phone through the app Steam Link, eliminating the need to worry about controllers any more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "1. Now biped supports Remote Play Together",
     "items": [
      {
       "text": "Step 1: Launch biped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Step 2: Right-click on your friend on the list to send an invite",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Step 3: When an invite is accepted you can play the game without meeting up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "2. Now biped also supports mobile controls by Steam Link",
     "items": [
      {
       "text": "Step 1: Download and install the app Steam Link on your mobile phone",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Step 2: Make sure your mobile phone and computer are on the same WiFi",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Step 3: Launch the app and pair your mobile phone with your computer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Step 4: Launch the game from Steam and start playing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here is how the interface should look but you can remap it as you like",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can disable video and audio in Streaming Settings to reduce the lag",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Learn more about Remote Play Together from here: https://store.steampowered.com/remoteplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
