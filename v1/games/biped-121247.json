  {
   "id": "biped-121247@major-2025-02-28",
   "gameId": "biped-121247",
   "displayName": "Biped 2 DEMO Update is live now",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-28T11:02:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey adventurers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to announce that the Biped 2 DEMO update is live now on Steam. Try it alone or with one or three friends in Local or Online COOP.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Updates",
     "items": [
      {
       "text": "A brand-new UI, way more appealing and clear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You will find new but currently hidden changes that will be available in the final game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Camera and view angle improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Balancing on the levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A few minor bugs were fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved optimization and stability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the exit screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please share your thoughts via the survey link inside the game or use Steam and Discord. And invite your friends - the DEMO is free!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "See you there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
