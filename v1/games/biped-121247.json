   "id": "biped-121247@major-2022-05-17",
   "gameId": "biped-121247",
   "displayName": "New checkpoint update is live",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-05-17T13:58:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve launched a new update aimed to fix common issues with checkpoints.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixed",
     "items": [
      {
       "text": "- Some of you have marked issues with the checkpoint save (it didn’t work correctly) and that you were not able to load the game. These issues have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- The localization fixes for the online COOP rooms and for the Steam Workshop.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If the some of the issues still persist, please tell us in the comment section below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "See you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
