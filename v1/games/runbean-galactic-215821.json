  {
   "id": "runbean-galactic-215821@0.06",
   "gameId": "runbean-galactic-215821",
   "displayName": "Update 0.06",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-27T14:31:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to the translators from EastAsiaSoft, RunBean Galactic is now available in 8 more languages: French, German, Spanish, Italian, Brazilian Portuguese, Japanese, Traditional Chinese, and Korean!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition, the game received a small balance change: upon breaking a wall or running into a \"reverse direction\" signpost, the astronauts will now stay slowed down for a bit longer. Also, I fixed the artifacts in the game's sound effects that used to appear when the music was muted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I hope you'll enjoy this update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Yours Forever,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ivan (Khud0)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
