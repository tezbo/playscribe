  {
   "id": "death-note-killer-within-320363@major-2025-11-12",
   "gameId": "death-note-killer-within-320363",
   "displayName": "Update Notice - Security Patch for Unity-related Vulnerability",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-12T03:00:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are pleased to announce the details of the update released on November 12th, 2025.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Version Information",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.5.7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Update Contents",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A fix for a security vulnerability found in games built with Unity as reported by Unity Technologies on October 3rd, 2025 (Fri).: Please see the official announcement from Unity Technologies for further details.: We look forward to your continued support for \"DEATH NOTE Killer Within\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
