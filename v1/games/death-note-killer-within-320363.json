  {
   "id": "death-note-killer-within-320363@1.4.4",
   "gameId": "death-note-killer-within-320363",
   "displayName": "UPDATE 1.4.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-28T14:13:52.000Z",
   "notes": [
    {
     "title": "Kira's Spokesperson is the new role in DEATH NOTE Killer Within! Pass around membership cards to Kira's Kingdom in secret, and get investigators thrown out of the game. 🤫",
     "items": [
      {
       "text": "Make the world follow your lead in DEATH NOTE Killer Within today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Premium Avatar – Light Yagami (Shirt)",
     "items": [
      {
       "text": "[table noborder=1]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "A set containing Light Yagami in an open dress shirt with a vignette inspired by the god of the New World.",
     "items": [
      {
       "text": "Idle animation changes to a floating, divine pose when using the Light Yagami (Shirt) avatar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "You can also receive a variety of other items such as voiced cut-ins that play during key scenes like arrests, as well as nameplates for meetings.",
     "items": [
      {
       "text": "*Customization Tracks do not expire, and you can make progress with one Customization Track even after adding another.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*You can only obtain 1 item in each of the free and premium tiers of a Customization Track.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Contents",
     "items": [
      {
       "text": "Avatars: \"Naomi Misora\" and \"Rem\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pets: \"Kira Follower Set\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Accessories",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Voiced cut-ins",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nameplates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
