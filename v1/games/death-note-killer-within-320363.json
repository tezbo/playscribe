  {
   "id": "death-note-killer-within-320363@1.4.5",
   "gameId": "death-note-killer-within-320363",
   "displayName": "Patch 1.4.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-17T12:39:23.000Z",
   "notes": [
    {
     "title": "In the update implemented on 2025/6/16 15:00 PDT | 2025/6/17 0:00 CEST, we applied the following bug fixes and feature adjustments",
     "items": [
      {
       "text": "Fixed a bug where the transceiver’s effective range during the Investigation Phase was the same as that of regular voice chat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a voice chat issue on the spectator screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the default setting for the “Voice Chat” filter in room search to “No set.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
