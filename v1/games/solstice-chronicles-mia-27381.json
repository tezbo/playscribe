  {
   "id": "solstice-chronicles-mia-27381@post-2017-08-04",
   "gameId": "solstice-chronicles-mia-27381",
   "displayName": "Solstice Chronicles: MIA updated! More languages, less issues",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2017-08-04T23:03:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "With this update we introduce Chinese and Russian translations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Also included it this update are following tweaks and fixes",
     "items": [
      {
       "text": "Second player now has different laser color",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Salamander does no longer show non existing clip ammo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Infinite reload problems on low reload times fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players who completed the game can start over on level 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a \"revert all\" button that reverts all upgrade selections made in armory for a particular mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Special ammo names properly displayed when picking up the item",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hide gui shortcut moved to CTRL+H",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Autoaim will now regenerate slowly over time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "KER legs staying alive after monster has been killed issue fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "SMG character buffs get applied properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Special ammo stats stack properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Special ammo meshes displayed properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, if you encounter any problems or have any suggestions please report them on the forums and we will continue working on them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
