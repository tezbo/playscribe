  {
   "id": "solstice-chronicles-mia-27381@patch-2025-06-26",
   "gameId": "solstice-chronicles-mia-27381",
   "displayName": "A new patch and supporter pack for entire franchise!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-26T15:57:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this update we bring Red Solstice 2 skins into Solstice Chronicles: MIA.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It is packed into a Supporter DLC aimed at people who want to support this franchise directly and enable us to give more patches for Red Solstice (campaign coop?) / Red Solstice 2 (additional content and gameplay improvement) and Solstice Chronicles: MIA (gameplay improvements)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So if you like our franchise, and like to get some more skins for SC:MIA, support us by buying this DLC, it will go directly into developing the franchise further.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/26613726/938d394422add4bb212a0459b0568ba827c1281c.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/3243340/Solstice_Chronicles_MIA__Supporter_Pack/\"]Stay tuned for more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
