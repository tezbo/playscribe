  {
   "id": "solstice-chronicles-mia-27381@major-2017-07-29",
   "gameId": "solstice-chronicles-mia-27381",
   "displayName": "Solstice Chronicles MIA second update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2017-07-29T18:20:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With the new version we have implemented an option for coop to be played either with keyboard+mouse and a controller or with two controllers. Option is available through the gameplay options menu. Due to the way controllers are assigned, it is available only when accessing options from the main menu (can't be changed mid game).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We have also added translations for German and French. You can change the language from the gameplay options menu. At this point there might still be some errors in the translations. Please let us know if you find any.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have also been working on improving a number of ingame skill descriptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Minor gameplay fixes also include",
     "items": [
      {
       "text": "Ker will not regenerate while underground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ker legs will be treated as burrowing units so seismic resonators can properly damage them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Holer type creatures will no longer enter endless healing in survival: Enjoy the now even better game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
