  {
   "id": "solstice-chronicles-mia-27381@patch-2024-09-02",
   "gameId": "solstice-chronicles-mia-27381",
   "displayName": "A new rebalance patch and game news!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-09-02T15:02:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been some time since we've had a chance to work on the game, but we finally decided to release a rebalance patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A major part of this rebalance focuses on weapons. The idea was to make ammo consumption more uniform, giving the weapons more distinct characteristics and making their progression more meaningful.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update should already be live with this post.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another thing that we would like to share with you is that we have just announced our new game - Atre: Dominance Wars which is a 4x fantasy game where you strive to become a God.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Check out the trailer below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hrvoje",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
