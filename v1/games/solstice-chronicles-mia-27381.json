  {
   "id": "solstice-chronicles-mia-27381@major-2017-10-29",
   "gameId": "solstice-chronicles-mia-27381",
   "displayName": "BIG UPDATE - New maps and huge optimization!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2017-10-29T18:44:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everbody,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we've been silent for some time but we've been working constantly!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are presenting 2 more environments for you to play in survival.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Map - Tharsis Street",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Battle in one of the first singleplayers maps in survival mode, quite different map layout then on open desert.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Map - Hangar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Battle to gather supplies before evacuating with your dropship, with some twists.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Both maps share similar monster spawns, and some monsters will not appear like they do in desert maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also provided you with extra ammunition, by adding a chance for a monster to drop a clip when killed, thus rewarding people who like to be... thorough :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Optimization",
     "items": [
      {
       "text": "We've made a huge optimization over entire game, we are also working on optimizing the game even further within next update, when this is done we will update our MINIMAL system requirements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for being with us! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "NEW CONTENT",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "> New survival map - HANGAR!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> New survival map - STREET!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "OPTIMIZATION",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "optimized pathfind (total monsters on screen increased by 50%)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "opitimized skeletal mesh rendering (total monsters on screen increased by 50%)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "optimized ingame UI by 80%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "optimized skill tree selection UI by 70%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "optimized ENTIRE game across everything!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GAMEPLAY",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "improved eggs in nest, slightly more challenging now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added eggs through sewers, slightly more challenging now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "slightly improved some weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "merged first three levels of singleplayer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "killing monsters will drop clips sometimes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
