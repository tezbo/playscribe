  {
   "id": "solstice-chronicles-mia-27381@patch-2018-05-10",
   "gameId": "solstice-chronicles-mia-27381",
   "displayName": "Overhaul Patch is now live",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2018-05-10T17:02:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are proud to announce that the game is receiving a major patch that focuses on polishing up both gameplay and graphics. Check this video for a short demonstration.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full patch notes",
     "items": [
      {
       "text": "Major Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Connected single player and survival save games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaked and improved almost every level and boss fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved visuals in every level of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Terminator enabled from the start",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved in-game UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed all skill supplies - skills now use cooldowns so you can focus on using the skills instead of gathering supplies for them!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Misc. Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Recruit difficulty is fun easy mode now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed damage spikes in game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed some skills that are obsolete now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Holt and Ker fight made more fair",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Snatchers will pin you much less now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tons of bugfixes and small quality of life changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The patch is available now, so everyone can get to blast their favorite space baddies with the best space marine and drone around.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
