  {
   "id": "the-sinking-city-remastered-343363@major-2018-11-05",
   "gameId": "the-sinking-city-remastered-343363",
   "displayName": "The Sinking City - Animations Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-11-05T10:27:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey guys,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we want to show you the brand new animations that our team has been working on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We know that a lot of you have asked about the way our character walks and runs, and rest assured, those animations were only temporary.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Check out the update to see what has changed. We also threw in some behind the scenes shots, because they are so darn cool :D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For more news on The Sinking City, check out our Facebook page and Twitter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Frogwares team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
