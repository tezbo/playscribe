  {
   "id": "the-sinking-city-remastered-343363@post-2024-01-16",
   "gameId": "the-sinking-city-remastered-343363",
   "displayName": "The Sinking City - Latest Version Available Now",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-01-16T09:27:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to announce that the latest version of the Sinking City is out now on Steam, free for all existing owners. Please keep in mind that your old saves aren’t compatible with this version, but you can keep playing the old one until Feb 28, 2024.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "All the owners of the Necronomicon edition will get the DLC for free. It will be released within 24 hours. Due to certain limitations, we were forced to add the DLC directly to the Investigator Pack, rather than as separate items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For all the questions that may arise please refer to our updated F.A.Q.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
