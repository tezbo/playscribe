  {
   "id": "ravenous-devils-173033@hotfix-2022-05-01",
   "gameId": "ravenous-devils-173033",
   "displayName": "Hotfixes",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2022-05-01T17:16:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone, we hope you are having fun serving your customers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's the first fixes to some problem you reported. More to come in the next days.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the bug with Hildred where she can use the sink while holding the gin.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a the bug where 2 clients buy the same cloth, causing an error in the clothes counter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Now Percival can kill the customer while taking his measurements in the greenhouse tutorial even if you have 5 or more corpses in the kitchen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that wouldn't allow the recipe book to be opened after the end of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that was deleting trays during tutorials.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that would generate another tray, resulting in having 4 trays.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
