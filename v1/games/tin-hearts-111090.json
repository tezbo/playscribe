   "id": "tin-hearts-111090@major-2024-05-25",
   "gameId": "tin-hearts-111090",
   "displayName": "Tin Hearts Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-25T10:49:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey ho Puzzlers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have pushed a small update live. Here is what has changed!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved a blocking issue in Act 4 where the player was unable to enter the Dining Room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved a blocking issue on Level 23 in Act 2 where the player was not able to direct Mr. Soldier on top of the puppet theatre using the drums",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue in VR mode where smooth locomotion would become disabled after opening doors inside the house in Act 2 and Act 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue which could cause the mechanical spiders in Act 3 and Act 4 to be unkillable by the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various bug fixes and improvements to Level 44 in Act 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
