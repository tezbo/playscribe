  {
   "id": "tin-hearts-111090@major-2024-03-14",
   "gameId": "tin-hearts-111090",
   "displayName": "Tin Hearts free VR update is available now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-14T14:03:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Inventors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we are pleased to announce the long-awaited VR update for our narrative puzzle adventure, Tin Hearts - marking the completion of the game development journey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The emotional and heartfelt adventure, originally envisioned as a VR experience in the 'Tin Hearts: Prologue' which was released for early access in 2018, is now ready to release as a free VR update for the players who have supported the game's journey over the past 6 years.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Play Tin Hearts VR on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Share and celebrate this magical moment with us by posting your best screens and gameplay moments to social media, simply tag the game using #TinHeartsVR and tag us on X/Twitter by @WiredP!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you have a wonderful time experiencing the full journey of Tin Hearts in the most immersive way possible!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
