  {
   "id": "hidden-cats-in-tokyo-318961@major-2025-03-29",
   "gameId": "hidden-cats-in-tokyo-318961",
   "displayName": "Level Skipping Update:",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-29T14:18:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After careful analysis, In this latest update we are happy to announce we have implemented a change to the level progression of the game! The following isometric levels containing 100 human characters, the \"Cosplay Festival\" and \"Video Game Museum\", are now able to be skipped at any point!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So if you are feeling stuck, worry not! You are free to go straight to the next level, no questions asked! We won't judge! What matters is that you have fun however you want in the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you enjoy this update, happy finding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
