  {
   "id": "hidden-cats-in-tokyo-318961@post-2025-07-08",
   "gameId": "hidden-cats-in-tokyo-318961",
   "displayName": "UI and Hint system Fixes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-08T15:17:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! We'd like to update you in regard to some bugs we've been made aware of, we have fixed the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Hint message not detecting anything, forcing the player to leave and return to the game to make it work",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Clicking on a person not working",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Steam deck's resolution's fixes (Text alignement and credits slightly offset)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-In-game card having \"hide\" symbol despite not supporting background",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You may now return to experiencing the game as it was intended, happy finding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
