  {
   "id": "hidden-cats-in-tokyo-318961@major-2024-12-27",
   "gameId": "hidden-cats-in-tokyo-318961",
   "displayName": "Small Card Collection Fixes Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-27T23:31:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends, we hope you enjoyed the holidays! In this small update we have fixed the arrows in the card collection screen, they now appear slightly transparent when they are not meant to lead to any other cards, and we have also corrected the title of the Tower Scratcher card that was was missing a \"C\"(Oops!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We still have in mind more updates, so stay tunned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
