  {
   "id": "hidden-cats-in-tokyo-318961@post-2025-03-11",
   "gameId": "hidden-cats-in-tokyo-318961",
   "displayName": "Video Game Conference Level Bug Fixes",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-11T18:53:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! Quick update! We've fixed a few issues with the Video Game Conference Level, these being:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The character's panels not updating correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Level's achievement not showing when completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Hints not being given/shown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "But worry not! These issues are now fixed! And also, we've increased the hints of Cosplay Festival and Video Game Conference level to 10 hints! This will surely hep you all with finding Hidden Objects much quicker! We hope you enjoy this change alongside the fixes, let us know if everything runs smoothly on your end, happy finding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
