  {
   "id": "hidden-cats-in-tokyo-318961@post-2025-05-16",
   "gameId": "hidden-cats-in-tokyo-318961",
   "displayName": "Memory Leak Issue Fixed",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-05-16T14:04:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! We come with great news!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have recently fixed an issue regarding a Memory Leak happening in the Ancient Village level that would make the game crash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game should now be working as intended! Let us know if everything works on your end! Happy finding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
