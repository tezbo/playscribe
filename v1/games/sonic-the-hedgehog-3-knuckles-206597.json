  {
   "id": "sonic-the-hedgehog-3-knuckles-206597@post-2023-08-24",
   "gameId": "sonic-the-hedgehog-3-knuckles-206597",
   "displayName": "Sonic Origins Plus – Patch Notes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-08-24T15:00:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A patch for Sonic Origins Plus is now live! This updates numerous bug fixes and quality of life improvements. Please make sure to update your game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "• New Feature - Players can toggle off Anti-Aliasing to have a \"nearest neighbor\" pixel rendering in Sonic 1/2/3&K/CD and all Game Gear games in the Options Menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• New Feature - Players can toggle Game Gear sound to Mono in the Options Menu. This feature addresses the “double audio” Game Gear audio issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Game Gear games will now fill into the provided screen space properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Super Amy will have proper after-images while running.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Amy's movements will appear smoother in Sonic 2 Special Stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Metallic Madness Zone 2 item boxes location and contents are properly placed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• In Quartz Quadrant Zone 2, Amy will no longer disappear as the camera moves away in certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Players can now pause the game while in Doomsday Zone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• In Boss Rush mode against Egg Tilter, Knuckles will have proper rolling animations from springs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• In Flying Battery Zone, spin-dashing into the magnetic presses will no longer result in instant collision death.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• The correct description for \"Jump\" is now present in the Chinese localization of the Sonic 3&K digital manual.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• In Competition Mode, Knuckles' change direction movement has been adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Additional physics adjustments have been made in Sandopolis Zone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Menu text will no longer shrink after entering the Museum and returning to the Main Menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Amy will now be able to complete stage loops while using her Rush Attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• The game will no longer crash while playing as Sonic and Tails after collecting the 6th Chaos Emerald in Sonic 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• In Sonic CD, Extras that are unlocked will now remain unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• In Sonic CD, Amy will appear in the proper coordinates after time travelling in certain levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Platform-Specific Updates",
     "items": [
      {
       "text": "• Save Data corruption will no longer occur in rare instances on PC (Steam/Epic Game Store).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
