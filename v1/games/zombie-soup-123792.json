  {
   "id": "zombie-soup-123792@1.0.7",
   "gameId": "zombie-soup-123792",
   "displayName": "Patch 1.0.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-07T10:39:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Welcome, brave heroes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "During the two-month Early Access, we're sure you've already killed countless zombies with all manner of weapons. On behalf of the townspeople, we would like to thank you for your efforts!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this update, we've optimized and added the following features to make your zombie-shooting experience even more exhilarating. Get ready to enter the town while your guns are still hot!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Significantly improved loading speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New feature: You can now skip the main menu animation by pressing ESC (keyboard) or B (controller back button)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Each boss now has a unique entrance sound effect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved Dark Knight's model",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimized the placement layout of crates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved enemy perception and behavior",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rooftop will now properly save the cinematic progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Back alley fix on the fall down animation during cinematic sequence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other bug fixes: We will continue to polish and update the game. Stay tuned!: The development team: August 7, 2023",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
