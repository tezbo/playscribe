  {
   "id": "zombie-soup-123792@post-2022-10-13",
   "gameId": "zombie-soup-123792",
   "displayName": "Bug Fixes & Updated Demo",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-10-13T15:35:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey guys! The Zombie Soup team has been running around lately attending several conventions and we're very sorry for not fixing a particular bug issue earlier in one of the tutorial screens in the demo where some players may not be able to proceed further.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have also taken the opportunity to make adjustments to the boss fights based on feedback from players who played the demo in the abovementioned conventions with a new update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With that, the entire team expresses their sincerest apologies to those who were unable to enjoy the demo as much as we had hoped, but we wish for you to continue helping us improve the game further as we draw closer to launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
