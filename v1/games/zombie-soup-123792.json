 "releases": [
  {
   "id": "zombie-soup-123792@major-2023-08-17",
   "gameId": "zombie-soup-123792",
   "displayName": "Official Version First Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-08-17T05:16:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, zombie slayers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the days following the release of the official version, we have received an abundance of enthusiastic feedback from players. We want to express our gratitude for your support, and we are honored to see that you are enjoying our game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To enhance the exhilarating experience of blasting zombies, we have just launched the first update since the official version went live. Here are the details of this update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased Melee Weapon charge damage coefficient.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed Rifle Arsenal unobtainable after finishing the boss kill quests.: (For those who have already finishing the boss kill quests, please kill any of the listed boss for the item to be dropped)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Dark Knight's shadow has damage collision before dashing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed pausing the game will prevent certain cinematics from progressing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enhanced boss battles: Adjusted Gravekeeper skill cooldown.: Adjusted Hansel and Gretel fight arena to prevent boss glitching out of the boss arena.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Other bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The gates of the town will always be open to all of you. We encourage you to provide more feedback, as we will continue to work hard to make the game even better. Please stay tuned for more updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Best regards from dev team,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "August 17th",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
