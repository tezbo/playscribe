  {
   "id": "zombie-soup-123792@major-2023-06-12",
   "gameId": "zombie-soup-123792",
   "displayName": "Quick Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-12T07:05:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your support and feedback for \"Zombie Soup.\" Below are the details of the first patch update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some language issues where voice acting and dialogues did not match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some crashes caused by loading errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimized the hitbox of certain bosses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized the skill release order of some bosses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved background music",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted the names of some collectibles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Corrected the names of some weapons: Once again, thank you all. We will continue to work on updates and strive to do better!: Development Team: June 12, 2023",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
