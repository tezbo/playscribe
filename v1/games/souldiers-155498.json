      },
      {
       "text": "Revised a difficult jump section in Floating Module",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Deep Pyramid map fragment when possessing all Great Pyramid map fragments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed selecting items while in bubble (useful when using D-Pad for player movement): https://store.steampowered.com/app/1419160/Souldiers/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
