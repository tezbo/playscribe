   "id": "souldiers-155498@major-2025-10-10",
   "gameId": "souldiers-155498",
   "displayName": "Important Security Update Available ✅",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-10T14:46:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Your safety while playing our games is our top priority.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve been informed of a recent security vulnerability affecting Unity. Although no malicious activity has been detected in connection with this issue, we’re taking immediate action to keep our players protected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update is now live on Souldiers and includes the necessary security fixes. We strongly encourage all players to update the game as soon as possible to ensure the best and most secure gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can find additional details on Unity’s official website here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
