  {
   "id": "vampire-therapist-288502@major-2024-09-16",
   "gameId": "vampire-therapist-288502",
   "displayName": "Free Content Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-16T16:00:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, immortal therapists!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we launch the first in a series of free content updates that will give you the chance to ease the mental burdens of Andromachos, our 3000-year-old vampire.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "These short sessions (30-60 minutes each) are our thank you to players who have purchased and completed Vampire Therapist. We think you're awesome and want to give you something good!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The first session releasing today, \"The Blood of Troy,\" will let you explore how Andromachos became a vampire. It involves a gigantic horse.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned for more soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rest in peace,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Little Bat Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
