  {
   "id": "vampire-therapist-288502@hotfix-2024-08-04",
   "gameId": "vampire-therapist-288502",
   "displayName": "August 4 Hotfix - Listen to the music of the night",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-08-04T21:09:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It's Sunday night hotfix time for Vampire Therapist! Just a minor one today as I head to Leipzig for some reference gathering for an upcoming content update. Here are the changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The audio state now saves so that music is at the right volume when loading (new saves only)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Saving is disabled when picking distortions. Be brave, cowpokes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes a distortion resetting issue in Edmund's first session",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Music should properly reset for all scenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Extra chances to bite Reinhard's neck after Edmund's third session",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you in therapy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
