  {
   "id": "vampire-therapist-288502@major-2024-10-28",
   "gameId": "vampire-therapist-288502",
   "displayName": "\"Couples Therapy\" Is coming to Vampire Therapist + Free Content Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-28T17:13:23.000Z",
   "notes": [
    {
     "title": "Two new clients with lots of problems",
     "items": [
      {
       "text": "What if \"till death do us part\" meant forever? Find out in Vampire Therapist: Couple Therapy DLC, coming soon to Steam!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You'll get the chance to handle two clients at the same time in a story of revolutions, relationships, and leaving filthy glasses of blood overnight in the sink.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Free Content Update",
     "items": [
      {
       "text": "You don't have to wait for new content, because the second free content update in our series exploring the history of 3000-year-old vampire Andromachos is out today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In \"Spanish Nights\", discover what happens when an ancient vampire when he visits Spain in 1492. Hint: there's a lot of blood involved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Baby vampire's first discount",
     "items": [
      {
       "text": "For the first time, Vampire Therapist has been discounted! You can now experience the journey of self-compassion at a lower price, meaning it's a great gift for that person in your life who thinks they're too good for therapy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Award Nominations",
     "items": [
      {
       "text": "Vampire Therapist has been nominated for the 2024 Indie X Awards and the 2024 German Developer Awards! We couldn't get here without your support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's all! We can't wait to share more with you, dear children of the night.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
