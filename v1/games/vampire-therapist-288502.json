  {
   "id": "vampire-therapist-288502@patch-2024-11-04",
   "gameId": "vampire-therapist-288502",
   "displayName": "The Minigames Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-04T12:38:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, dear immortals!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're going on a much-needed vacation, but we've got a patch for you before we get our not-so-eternal rest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Minigames Overhaul",
     "items": [
      {
       "text": "We've added better tutorialization to our minigames, so now it should be easy to jump in and start biting some necks or having some deep thoughts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And if you're after a more relaxed experience with no minigames at all, you can just skip them and get right to the therapizing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Respectful Flirting",
     "items": [
      {
       "text": "We got some frequent feedback that our club goths were coming on a little strong. Vampire sexuality is a playful running joke in Vampire Therapist (consent is important!), but it was misread in this case, so we had our friendly bartender cut in a little early.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Odd and ends",
     "items": [
      {
       "text": "A couple more fixes just for your enjoyment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Club sound propagation is corrected in one location",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Character positioning improved during dance scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Last Day of Sale",
     "items": [
      {
       "text": "Happy biting, children of the night!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
