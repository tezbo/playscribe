  {
   "id": "vampire-therapist-288502@patch-2024-08-02",
   "gameId": "vampire-therapist-288502",
   "displayName": "Vampire Therapist August 2 Patch: \"It's Curtains for you!\"",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-08-02T10:03:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Howdy, healers of the unholy! We've got a big set of fixes for you today, so we'll call it a full on patch. Here are the changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New tutorial for the meditation minigame and updated prompts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Full curtain reimplementation that should make the experience even more theatrical than it already is",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes loud sounds while picking distortions (I know, sorry)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated content warning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More consistent blood reactions when picking distortions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simplified the Slow Learner achievement - it can now be triggered after finishing all second client sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adds notifications for saved checkpoints",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Cleanup of unnecessary settings buttons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Makes music controls more consistent",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes meditation controls on the Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixes random premature ending in Isabella's second session",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes VO takes in Isabella's 3rd session and Drayne's 4th session",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Retimes the intro slightly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes Sam and Meddy's ventriloquism act in her 4th session",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cleans a dirty neck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes an anachronism in the journal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Note that some coffin videos may not work properly for Steam Deck users, but we're looking into fixes for that.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Stay tuned for some more bloodwarming updates in a few weeks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
