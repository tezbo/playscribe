  {
   "id": "vampire-therapist-288502@hotfix-2024-08-26",
   "gameId": "vampire-therapist-288502",
   "displayName": "August 26 Hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-08-26T15:47:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey cowpokes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I'm back from Gamescom and back to work on Vampire Therapist. I'll have some exciting announcements in the next few weeks, but for now, a few bugfixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes the Slow Learner achievement (just start from Sam's second session and you can get it by the end of Meddy's second session)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes some music processing issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes an issue where Sam imitates Andy accidentally",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Prepares for future content updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See y'all in therapy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
