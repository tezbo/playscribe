  {
   "id": "sklime-a-difficult-climbing-adventure-322528@post-2024-11-25",
   "gameId": "sklime-a-difficult-climbing-adventure-322528",
   "displayName": "Ultrawide support, fixes",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-25T01:51:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "-Minigame time scores now display only to 3 decimal places",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Ultrawide resolutions should display correctly now, though you'll see out of bounds in some locations and cutscenes will look incorrect",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Fixed other UI issues for various aspect ratios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Npcs now use the same voice sounds in non-english languages as they did in english",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-New menu transition animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Stopped a bug that caused your arm to become obstructed while grabbing onto a climb region",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Changed the 20 game clear achievement to 10 clears (Lunacy)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Shooting star section slightly adjusted (one more star and slightly less grab space toward the top)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
