  {
   "id": "sklime-a-difficult-climbing-adventure-322528@1.22",
   "gameId": "sklime-a-difficult-climbing-adventure-322528",
   "displayName": "Update 1.22",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-26T01:08:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "You can now select custom trail colors in the cosmetics menu. The gold trail has been replaced with a multicolor trail, which lets you choose a secondary color for trails to fade to. Wall jump markers have been placed in the standard map, and Terrestrial Nexus has had a few visual changes. A number of smaller bugs have also been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
