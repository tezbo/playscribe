   "gameId": "sklime-a-difficult-climbing-adventure-322528",
   "displayName": "Trials & Emotes Update Part 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-17T20:35:27.000Z",
   "notes": [
    {
     "title": "New challenges can be found hidden around the map - Trials!",
     "items": [
      {
       "text": "Find the entrance to a trial and complete it to earn an equippable cosmetic item - in the new accessory slot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In this update, the first 4 trials were added. Another 4 are planned.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Note: The ice trial currently does not have a cosmetic item but still can be played",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "2 Emotes Added",
     "items": [
      {
       "text": "Show appreciation with the happy emote, or vent some frustration with the angry emote!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Known issues",
     "items": [
      {
       "text": "Avatar loading is still not working correctly. I am working on a fix for this",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Next",
     "items": [
      {
       "text": "Replays are currently being worked on. The second batch of trials and emotes will likely be a bit later down the line",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
