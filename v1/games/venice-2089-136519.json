  {
   "id": "venice-2089-136519@1.2",
   "gameId": "venice-2089-136519",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-26T16:39:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Heyo friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We managed to find the source of the black screen / infinite loading screen bug, and should now be fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unfortunately, we did not find a way to prevent saves to be irremediably corrupted. Players will have to start on a new save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For more information about our handling of bug reports, please read our latest devlog (that should be already up and running if all goes well)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
