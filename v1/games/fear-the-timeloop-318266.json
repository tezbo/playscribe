 "releases": [
  {
   "id": "fear-the-timeloop-318266@1.1.2",
   "gameId": "fear-the-timeloop-318266",
   "displayName": "Update 1.1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-05T15:49:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone, and thank you for your patience. In this update, we’ve added several improvements aimed at enhancing your gameplay experience and fixing a number of issues. Here’s what’s new:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a first-person view option;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new difficulty mode along with a related achievement;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Stalker boss now remains staggered longer (about 6–7 seconds), giving you a better chance to escape;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When switching weapons, you can now see how much ammo remains in your other weapon in the quick menu;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Stalker boss now has a harder time locating you on the map;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new line from Cooper when he first encounters the Stalker;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The “Hard” difficulty has been renamed to “Hardcore” to avoid confusion;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues with the Second Life ability achievement not unlocking properly;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several issues with certain in-game objectives;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Radio conversations can now be skipped faster;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The safe puzzle has been made easier to complete;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed several minor localization issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "That’s all for now. If you encounter any problems or bugs, feel free to report them wherever you prefer, and we’ll do our best to address them as quickly as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have a great day, and thank you for being part of the game’s community!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
