  {
   "id": "fear-the-timeloop-318266@1.0.5",
   "gameId": "fear-the-timeloop-318266",
   "displayName": "Update 1.0.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-02T21:02:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone! Today, as promised, I’m releasing an update focused on bosses, along with a few small fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the third level card would disappear prematurely;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved the balance of the first boss and fixed crashes occurring during the fight;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some of the issues related to the final fight;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced the explosion radius of traps and barrels in the catacombs;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed two abilities;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed long corridor streaming issue;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
   "digest": {
    "new": 1,
