  {
   "id": "fear-the-timeloop-318266@1.1.1",
   "gameId": "fear-the-timeloop-318266",
   "displayName": "Patch 1.1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-02-16T14:07:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! As promised, today we’re releasing Patch 1.1.1. It includes many important changes aimed at improving your overall gameplay experience. Here’s the full list of updates:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved enemy AI. After attacking, enemies now step back to prevent cornering the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enemies now attack from a slightly greater distance instead of pressing directly against the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where X-RAY scans would not appear after loading a save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced the amount of health granted when saving with archival tapes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue with the door selection station.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The first pouch upgrade is now located much closer than before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Stalker boss no longer gets stuck in textures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues related to the clowns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Weapons no longer disappear from the player’s back after loading a save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where certain enemies could attack the player through walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Ukrainian localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the ability to skip radio conversations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
