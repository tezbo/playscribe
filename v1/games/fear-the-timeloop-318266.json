  {
   "id": "fear-the-timeloop-318266@1.1.0",
   "gameId": "fear-the-timeloop-318266",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-02-12T06:55:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! I’m happy to share a small patch that improves overall gameplay feel, adds more clarity to certain mechanics, and enhances the player experience. Here’s what we’ve accomplished over the past few days:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated the descriptions of healing items to make their effects clearer and easier to understand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Door choice stations no longer lock your decision when saving with regular film reels (non-red tapes). You can now choose a door, save, reload your last save, and select the other door if you wish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed several collision issues with breakable doors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved problems with certain achievements not unlocking properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the final boss could fail to transition from Phase 1 to Phase 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected collision problems on the main hall staircase (second floor).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved collision throughout the hospital and removed objects that interfered with player movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced cases of the character clipping into walls and doors; camera collisions with walls have also been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Have a great day and all the best!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
