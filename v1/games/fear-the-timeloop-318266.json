   "displayName": "Patch 1.0.8",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-02-04T23:40:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "So, here is a list of small improvements we achieved in the new patch:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the stack size of some healing items;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed aiming issues when opening the inventory/map;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved aiming while running or switching weapons;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enemy bodies now remain on the map 1.5 times longer;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues with the police baton;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved the health UI on Easy difficulty;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed several minor translation issues in Russian, Hungarian, and French.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you very much for leaving reviews and feedback. Thanks to all of us, the game keeps getting better and better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
