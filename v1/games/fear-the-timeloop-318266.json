  {
   "id": "fear-the-timeloop-318266@1.0.3",
   "gameId": "fear-the-timeloop-318266",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-01T05:37:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I decided to release this update a bit earlier than planned, as in addition to all the scheduled changes, a couple of issues needed to be fixed urgently to ensure nothing could negatively affect your experience with the game. So, what did we manage to improve in this update?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved camera control. The camera now collides with walls less frequently, especially while running.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The camera no longer stays static while the character is moving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gamepad sensitivity is now adjustable in the same way as mouse sensitivity.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added a motion blur setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Footstep sounds have been restored.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Interacting with doors now feels better; the character passes through them less often.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a soft lock in the catacombs related to saving after inserting the lever.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with interacting with the shotgun locker.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "And that's all for today. Hope you all will have a great day!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
