  {
   "id": "fear-the-timeloop-318266@1.0.1",
   "gameId": "fear-the-timeloop-318266",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-01-31T16:33:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In this patch, we focused on delivering quick fixes for several critical issues and adding new features you’ve been asking for. Here’s what we’ve accomplished:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added FSR and DLSS settings;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added a new game mode that disables the time loop and plays like the normal mode;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue with key rebinding;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added Italian language;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you very much for your feedback! Sometimes I can’t reply right away, but that doesn’t mean I’m not seeing it. We’re now shifting our efforts toward fixing other issues and improving core mechanics, so you can expect even more improvements in the next patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
