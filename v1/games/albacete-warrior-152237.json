  {
   "id": "albacete-warrior-152237@0.3.1",
   "gameId": "albacete-warrior-152237",
   "displayName": "Update 0.3.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-06-14T08:46:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "GAMEPLAY",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added new icons for the Controller buttons (Xbox)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "• Added input indicator to use Xusos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Modified the ringtone of the Fokia",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BUG FIXING",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed translation error in the separation indicator between Benito and Dark Benito",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed the Spawn particle system when playing 2 players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed input prompt to use cure in controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed the bug that did not show the main menu when returning from a scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
