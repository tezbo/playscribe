  {
   "id": "albacete-warrior-152237@1.1.0",
   "gameId": "albacete-warrior-152237",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-12-22T15:37:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello there fellas,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we bring you a few fixes that we have been working on these days. Since the early access came out, we have been watching other people's videos and streams and we are working on correcting all the bugs that have come out as soon as possible. Here is a list of all the changes that this new version brings:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "GENERAL CHANGES",
     "items": [
      {
       "text": "eliminated a bug after some attacks that made Benito float and walk through walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "slightly adjusted the jump when it starts close to a wall on Benito's horizontal axis to make it easier to hold onto the wall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "MAIN MENU",
     "items": [
      {
       "text": "updated the credits of the main menu, before they were not exactly the same as those of the end of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "ALBACETE / DOJO",
     "items": [
      {
       "text": "adjusted collisions at tutorial level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Tutorial information pop-ups now only display buttons for the device Player 1 is using, instead of toggling between controller / keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "JUNGLE",
     "items": [
      {
       "text": "cartwheeling in the jungle temple should no longer cause Benito to go through walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "HIMALAYA",
     "items": [
      {
       "text": "corrected a typo in one of the dialogs near the end of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a bug in the destroyed Albacete cargo. If you left the menu or closed the game, it would load the next level to the corresponding one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "eliminated the possibility of brandishing Pepito in the fake credits scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed a bug where the music of the final boss was not heard after dying and restarting the level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "while fixing various situations that cause Benito to go through the ground, if this happens in Albacete's level against the final boss, the player will now respawn correctly above the ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All the best,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "the FAS3 team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
