  {
   "id": "albacete-warrior-152237@1.1.1",
   "gameId": "albacete-warrior-152237",
   "displayName": "Update 1.1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-12-24T00:13:48.000Z",
   "notes": [
    {
     "title": "A quick update to fix a few things",
     "items": [
      {
       "text": "Fixed the jump against the wall in depth in the waterfall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved Benito's interactions when grabbing onto the wall when exiting an aerial dash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The mechanic of braking the player to avoid falling off an edge when landing on it has been better implemented",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed (finally) the mechanic of rolling in the Temple of the Jungle: you can no longer go through the walls and there are no more dashes towards the ceiling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several abilities of the bosses disappear when they are defeated so that the player does not die from them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the checkpoint that loads when you fall in front of the first movable platform at the end of Egypt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Raijin no longer stays stuck in the air without attacking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Now Dark Benito ALWAYS deals damage, at least to the enemy he is targeting for his attack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
