  {
   "id": "bendy-and-the-ink-machine-28311@1.5.1.1",
   "gameId": "bendy-and-the-ink-machine-28311",
   "displayName": "Hotfix 1.5.1.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-10-24T14:06:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just pushed a quick hotfix to address 2 minor visual issues, as well as add in a new feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Chains holding the pallet in Chapter 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Chains holding the pallet in Chapter 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added SKIP ability for Chapter 5 opening sequence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "SKIP",
     "items": [
      {
       "text": "In order to skip, you just need to press \"Interact\" twice to skip a sequence. So that would be \"E\" for example. This will help you get into the action sooner if you don't want to watch these sequences.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bendy Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
