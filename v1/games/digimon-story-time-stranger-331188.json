  {
   "id": "digimon-story-time-stranger-331188@major-2025-12-11",
   "gameId": "digimon-story-time-stranger-331188",
   "displayName": "Important Notice: Update Released to Address DLC Launch Issue",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-11T09:22:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have identified an issue affecting some players on the STEAM version, where the game crashes after installing “Additional Digimon & Episode Pack 1: Alternate Dimension.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update to fix this issue has now been released.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have experienced crashes in your environment, please apply the update and try launching the game again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue investigating this matter and implementing further measures as needed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We apologize for any inconvenience this may have caused and appreciate your understanding and support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
