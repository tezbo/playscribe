  {
   "id": "digimon-story-time-stranger-331188@patch-2025-09-12",
   "gameId": "digimon-story-time-stranger-331188",
   "displayName": "[DEMO VERSION] Patch Release",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-09-12T10:23:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have confirmed an issue in the Steam version where, on certain PC environments, the screen whites out and the game cannot proceed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, Friday, September 12th at around 3:00 PM JST, we released a patch that resolves some of these issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "If the issue persists, please try the following settings",
     "items": [
      {
       "text": "Change your display refresh rate to 144Hz or lower in your Windows system settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Use a standard keyboard layout, not a custom one",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We will continue investigating other potential causes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
