  {
   "id": "digimon-story-time-stranger-331188@post-2025-10-01",
   "gameId": "digimon-story-time-stranger-331188",
   "displayName": "DIGIMON STORY TIME STRANGER – Launch Patch Notes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-01T16:42:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A game update for DIGIMON STORY TIME STRANGER will be released alongside the official launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update includes features such as save data transfer from the demo version, as well as various additions and adjustments to ensure a smoother and more enjoyable gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please make sure to apply this update before starting the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: Some of the update contents are also reflected in the demo version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update Version",
     "items": [
      {
       "text": "STEAM：20027848",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Estimated File Size",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Approximately 10GB (planned)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "System",
     "items": [
      {
       "text": "Added functionality to transfer save data from the demo version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted tutorial text and added images for certain sections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed default frame rate to 60 fps for the Steam version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed default voice language from Japanese to English when starting the game in German.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Field",
     "items": [
      {
       "text": "Added dash functionality.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added encounter animation when facing hostile Digimon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added various stat-boosting items to maps in the human world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted hostile Digimon placement balance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Battle",
     "items": [
      {
       "text": "Adjusted Digimon attacks to use more effective skills.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added new icons based on buff/debuff strength.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tweaked overall battle balance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted parameters and digivolution conditions for certain Digimon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Tuned parameters and behavior patterns for guest Digimon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted effects of certain skills and Cross Arts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Digivice",
     "items": [
      {
       "text": "Changed level number color for Digimon that have reached the level cap on setup screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added key help to jump directly to the Digiline screen when receiving a message from a partner Digimon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed the menu accessed via the left function key from “Items” to “Missions.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Various usability improvements and minor fixes to backgrounds, models, and other small issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
