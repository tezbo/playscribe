  {
   "id": "quriocity-221073@major-2022-11-24",
   "gameId": "quriocity-221073",
   "displayName": "Second minor update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-24T09:07:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After the release of the first minor update, we have kept collecting your feedback and we are ready to announce a new minor update. We expect to release it on December the 15th.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The update will feature the following improvements",
     "items": [
      {
       "text": "An improved UI for the World view showing the Communication tower location and the available services.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A new UI for the Principal rover with more information and more details about the rovers that it contains.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "An improved Game guide.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A new panel that will help you in choosing which buildings to upgrade.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A new main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Search rover and the Recharge rover will become manual.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The sectors will be highlighted while you are adding a unit to make it easier to understand where you can and where you cannot place the unit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated tutorials to reflect the new features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Some other minor improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "As always, please feel free to let us know if you find any issues or if you have suggestions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Oxeliz team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
