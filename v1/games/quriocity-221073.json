  {
   "id": "quriocity-221073@major-2022-10-27",
   "gameId": "quriocity-221073",
   "displayName": "First minor update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-27T13:16:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First of all, thank you a lot for your feedback. We really appreciated the time you dedicated to our game, and we would like to let you know about a minor update that we will release on November the 10th.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The update will feature the following improvements",
     "items": [
      {
       "text": "Edge scrolling to move the camera when the mouse is near the edge of the screen.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Faster and easier services management, as now you will be able to click straight on the Actions center entry or on the icon above the unit to send the service rovers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Add units also when the game is paused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rotate the clusters even if there are already units inside them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The units that do not depend on a specific resource can now be placed in all sectors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Health clinic is available in level 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased the max zoom out and decreased the max zoom in.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added option for tooltips delay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated tutorials to reflect the new features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Apart from that, we will continue working on the features for the Full Release and on other minor refinements, so stay tuned for more updates and let us know if you have any suggestions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Oxeliz team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
