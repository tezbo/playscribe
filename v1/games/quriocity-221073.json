  {
   "id": "quriocity-221073@major-2022-11-10",
   "gameId": "quriocity-221073",
   "displayName": "Update notes for 10th November",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-10T08:57:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Edge scrolling to move the camera when the mouse is near the edge of the screen.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Faster and easier services management, as now you will be able to click straight on the Actions center entry or on the icon above the unit to send the service rovers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add units also when the game is paused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rotate the clusters even if there are already units inside them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The units that do not depend on a specific resource can now be placed in all sectors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Health clinic is available in level 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the max zoom out and decreased the max zoom in.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added option for tool-tips delay and edge scrolling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new tutorials and updated previous tutorials to reflect the new features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Minor bugs fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
    "new": 2,
