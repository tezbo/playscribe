  {
   "id": "quriocity-221073@post-2023-08-17",
   "gameId": "quriocity-221073",
   "displayName": "Patchnotes for 17th August",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-08-17T11:56:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Reduced the number of days before a dead body disappears, hence it will spread less diseases if not treated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced the infections from sewage and garbage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced the maintenance required",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The auto service research are now available earlier, in most cases as soon as you add the related unit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The auto service research are now faster and cheaper (the values are more similar to the other research)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the size of the buttons in the Actions center",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added arrows to represent over- and underproduction in top UI and for Sewage and Garbage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the red blink effect in the left UI to make it more visible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced memory usage by up to 20%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Minor fixes for localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor bugs fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
