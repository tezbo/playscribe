  {
   "id": "quriocity-221073@post-2022-12-15",
   "gameId": "quriocity-221073",
   "displayName": "Patchnotes for 15th December",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-12-15T09:25:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "An improved UI for the World view showing the Communication tower location and the available services in the region.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new UI for the Principle rover with more information and more details about the rovers that it contains.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An improved Game guide with tool-tips for the units.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new Units status panel that will help you in choosing which buildings to upgrade.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new main menu UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Search rover and the Recharge rover are now manual.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The sectors will be highlighted while you are adding a unit to make it easier to understand where you can and where you cannot place the unit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated tutorials to reflect the new features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an Ok button on some tutorials so you don’t need to perform the suggested action immediately.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Chinese localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved readability for Chinese, Japanese and Russian.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Pausing the game doesn’t deselect the current unit anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the toggle in the Employment and Spaceport panel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Pest type label in the farms info panel blinks during an attack to underline the type of pest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added lights to service rovers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Various other minor improvements and bug-fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
