  {
   "id": "quriocity-221073@post-2024-08-19",
   "gameId": "quriocity-221073",
   "displayName": "Patchnotes for 19th August",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-08-19T06:08:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Gamers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're thrilled to announce that we've made some exciting improvements to enhance your Quriocity experience:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased Maximum UI Scale: Enjoy a more customizable and immersive interface.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Engine Update: Performance boosts for a smoother gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes: Minor issues resolved for a seamless adventure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We can't wait to see the amazing colonies you build with these improvements—don’t forget to share your progress!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Oxeliz Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
