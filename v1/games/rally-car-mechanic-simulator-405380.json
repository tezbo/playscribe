  {
   "id": "rally-car-mechanic-simulator-405380@hotfix-2025-01-27",
   "gameId": "rally-car-mechanic-simulator-405380",
   "displayName": "Small Hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-01-27T17:56:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Mechanics! 👋",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve prepared another round of fixes for you! Thanks to your reports, we’ve been able to address several issues. Here’s what’s included in the latest hotfix:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed a bug with the disassembly of Turbo Type A V2 (Boxer).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue when selling cars in the zoom camera view.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Addressed a problem where multiple cars could spawn on a single garage space.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with marking and selling parts directly from the inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue that allowed a car selected for a rally to spawn unintentionally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a problem causing the suspension replacement task to fail.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected a bug where the Ignition Coil Type A (Boxer) fault would trigger multiple times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the rally UI being incorrectly displayed in the tent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for your support and all the reports! As always, we’re looking forward to your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
