      {
       "text": "Fixed dismantled visualization for Cylinder Head Type B V2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added missing icon for Cylinder Head Type B V2 part set",
