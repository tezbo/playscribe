  {
   "id": "rally-car-mechanic-simulator-405380@hotfix-2025-01-28",
   "gameId": "rally-car-mechanic-simulator-405380",
   "displayName": "Small Hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-01-28T16:06:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Mechanics! 👋",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just rolled out a new update for Rally Mechanic Simulator, addressing several issues and continuing to refine the game. Here's what's been fixed:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed incorrect drive shaft positioning for the SaZe F1000.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with assigning blocked parts in the inventory selection window when many items are present.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an error occurring during the \"body slam\" scenario.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed parameter issues with the front brake disc Mk3 prefab.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect state of the inventory window after selling parts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Your feedback has been crucial in helping us identify and resolve these issues. Please keep sharing your thoughts and suggestions!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
