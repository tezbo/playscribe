    {
     "title": "Changes",
     "items": [
      {
       "text": "Bonjour Detectives,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new patch for Agatha Christie - Hercule Poirot: The London Case has been deployed. Here is what you can expect:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Art: new gala photos added, higher res and better key stealing action",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for the pictures in dialogue not continuing on a mouse click",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issues with the interaction icons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added new, unique thinking animation for Poirot during dialogue scenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Disabled fidget animation while conversations are active",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor bugfix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📬 Stay connected!",
       "ps5ProOnly": false,
       "pcOnly": false,
