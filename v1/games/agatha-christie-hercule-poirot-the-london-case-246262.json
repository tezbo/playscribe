  },
  {
   "id": "agatha-christie-hercule-poirot-the-london-case-246262@post-2023-11-09",
   "gameId": "agatha-christie-hercule-poirot-the-london-case-246262",
   "displayName": "Patch Notes: build ID - 12653720",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-11-09T14:32:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you to everyone who has played Agatha Christie – Hercule Poirot: The London Case and to those who have provided feedback. We have been putting our Little Grey Cells to work to address bugs and issues since launch and we’re pleased to announce a new patch, which is now available for download (build ID – 12653720).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This patch includes the following updates",
     "items": [
      {
       "text": "Increased walk speed for Poirot in the Museum’s Main Hall, Theatre Street, and the Church",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Resolved intermittent issue with missing ambient sounds and footsteps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Missing German VO for Evelyn in Chapter 3 has been added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "German Text and VO mismatch has been corrected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "German and French voice cast have been added to the end game credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Missing glass prop during “champagne incident” cutscene in Chapter 1 has been added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you find any bugs or experience technical issues related to the game, don't hesitate to mention it in Steam discussions, or email our support team at support@blazinggriffin.com.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don’t forget to also follow us on X for updates about the famous Detective Poirot’s early career, as well as more titles on the horizon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Blazing Griffin Games Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
