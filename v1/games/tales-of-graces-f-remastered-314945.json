       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Update Details",
     "items": [
      {
       "text": "・Sound Effect adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue of the number of hits for Artes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Other minor issues have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Sound test issue has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An Internet connection is required to apply the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
