  {
   "id": "no-skin-296046@1.0.2",
   "gameId": "no-skin-296046",
   "displayName": "Update 1.0.2",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-02-19T10:05:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "First of all, thank you all for the overwhelming reception of the game. I really don't know how to thank you enough. Huge thanks to everyone playing and leaving a review!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This small patch brings a few adjustments",
     "items": [
      {
       "text": "-now you can take screenshots with F12",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "-fixed a bug that didn't correctly apply the First Blood damage in a specific scenario",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "-fixed a bug that caused save data not to be deleted properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "-fixed minor issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "-added an option to romance the long-gilled fish (maybe this isn't true)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
