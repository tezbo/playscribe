   "announcedAt": "2025-11-20T09:51:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "NO-SKIN has been updated to version 1.2.0. The goal of this update is to fix some texts that caused confusion in understanding certain events (in particular the incorrect resemblance between Root and Roma), and to add a new option that allows you to speed up the gameplay (attack animations, waiting times, text speed, etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note for those playing with a fan translation patch: you can still play the older version of the game (1.1.0) through Steam's beta builds (right click the game in your library, select Properties, go to the Betas tab, and choose the 1.1.0 branch)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
