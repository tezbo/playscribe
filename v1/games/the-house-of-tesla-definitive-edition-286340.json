  {
   "id": "the-house-of-tesla-definitive-edition-286340@103",
   "gameId": "the-house-of-tesla-definitive-edition-286340",
   "displayName": "Update 103",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-14T13:06:39.000Z",
   "notes": [
    {
     "title": "General",
     "items": [
      {
       "text": "Added Chinese and Japanese language support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A Note from the Blue Brain Games Team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your patience and understanding whilst work continues on improving the game based on the previously communicated updates in our roadmap. We know that Chinese and Japanese players have been awaiting language support and we are pleased to be able to add it to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Further updates and communications will follow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep a look out for upcoming patch notes, and continue sharing your thoughts with us on the Steam Discussions and on Discord. Your feedback is important in helping to reshape the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- Blue Brain Games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
