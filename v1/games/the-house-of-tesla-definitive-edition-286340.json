   "announcedAt": "2025-11-12T18:53:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've been hard at work improving the game based on your feedback, and today we are introducing a major update to the game featuring a rework of the Tesla Factory - Upper Floors chapter:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What's New",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The hint system has received a complete rework to better guide players, we've fixed minor bugs and made various quality of life improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Chapter-specific improvements",
     "items": [
      {
       "text": "Personal Office of Nikola Tesla",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Now features improved visibility and refined gameplay adjustments that make interactions clearer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tesla Factory - Upper Floors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This chapter has undergone a complete rework. We've streamlined the puzzle flow, improved pacing, and enhanced the overall player experience. If you're currently playing through this chapter, you'll need to restart it to experience these changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Your progress on this chapter will reset to the start of this chapter, but the improved design makes it well worth replaying. Players will see an in-game notification explaining the restart requirement \"I need to restart the chapter due to a complete rework\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44849923/74fdd2cd88589863f5a9a781cf86a4797ebedb03.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "What's Next",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We're continuing to refine the game chapter-by-chapter based on your feedback. Stay tuned for further announcements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-- Blue Brain Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
