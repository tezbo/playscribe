  {
   "id": "the-house-of-tesla-definitive-edition-286340@102",
   "gameId": "the-house-of-tesla-definitive-edition-286340",
   "displayName": "Update 102",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-07T14:22:38.000Z",
   "notes": [
    {
     "title": "General",
     "items": [
      {
       "text": "Fixed an issue with the backup system that could occasionally crash. This bug manifested as the game becoming unresponsive immediately after performing an action.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed total time played display when exceeding 24 hours on the “Thank You” screen at the end of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the hint line was not properly destroyed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor bug fixes and tweaks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted collider sizes for improved handling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Chapter: Personal Office of Nikola Tesla",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated texts (English, Czech).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphics tweaks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A Note from the Blue Brain Games Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are still actively working on many of the improvements previously communicated in our roadmap (Updates 101 and 102). However, we wanted to get these fixes out to you as quickly as possible rather than delay them further.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rest assured that we are continuing to investigate reported issues (such as the ball bearing puzzle bug) and are committed to improving the game based on your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Further updates and communications will follow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please keep an eye out for upcoming patch notes, and continue sharing your thoughts with us on the Steam Discussions and on Discord. Your feedback is invaluable in helping us reshape The House of Tesla.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your patience and understanding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- Blue Brain Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
