 "releases": [
  {
   "id": "the-house-of-tesla-definitive-edition-286340@108",
   "gameId": "the-house-of-tesla-definitive-edition-286340",
   "displayName": "Update 108",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-17T18:09:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've been hard at work improving the game based on your feedback, and today we are introducing a major update (v108) to the game featuring a complete rework off the Wardenclyffe Laboratory chapter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What's New",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this update we have continued our chapter-by-chapter rework of the game. While chapters 1-3 have already undergone significant improvements, this release focuses on bringing the Wardenclyffe Laboratory up to the same standard. Please note that the final chapters will be reworked in the new year, so you may notice differences in visuals, gameflow and pacing between the updated early chapters and the remaining ones. We kindly ask you to take this into consideration when sharing your feedback or reviews.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Chapter-specific improvements",
     "items": [
      {
       "text": "Wardenclyffe Laboratory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This update features a complete rework of the chapter with significantly improved gameflow, entirely new atmospheric lighting, improved models and textures, reworked puzzles, refined hints with localization into all languages, enhanced audio; including improving old sounds and adding many new ones, minor bug fixes and overall quality of live improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Your progress on this chapter will reset to the start of this chapter, but the improved design makes it well worth replaying. Players will see an in-game notification explaining the restart requirement \"I need to restart the chapter due to a complete rework\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44849923/74fdd2cd88589863f5a9a781cf86a4797ebedb03.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Looking Ahead",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This will be our last planned major update for this year. We will return in 2026 with the final chapter reworks to bring the remaining parts of the game up to the same level of quality as the updated chapters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Until then, please continue to share your thoughts with us. Your feedback has been invaluable in helping us refine the experience, and we encourage you to keep posting your impressions and feedback on Steam Discussions and Discord. If you've enjoyed the game so far, we'd greatly appreciate it if you'd consider leaving a review - it really helps us to reach more players.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you, for your continued support since our September release. We wish you all the best for the holidays and look forward to sharing more with you in 2026.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-- Blue Brain Games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
