  {
   "id": "the-house-of-tesla-definitive-edition-286340@major-2025-09-27",
   "gameId": "the-house-of-tesla-definitive-edition-286340",
   "displayName": "Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-27T17:21:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1. Fixed navigational hints in the Egypt area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Fixed cross-platform cloud sync.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Display settings, music settings, and some control settings will now be device-specific (excluded from cloud sync).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Fixed resolution issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There will be a one-time resolution change to the native display resolution as a means of fixing resolution issues for people who had problems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If the game is started on a display in portrait mode, it will be set to windowed mode with a landscape resolution.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "5. Fixed missing executable error when starting the demo on Linux.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
