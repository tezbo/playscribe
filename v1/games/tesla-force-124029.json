  {
   "id": "tesla-force-124029@patch-2020-08-17",
   "gameId": "tesla-force-124029",
   "displayName": "First Patch Live",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-08-17T11:07:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The first patch of many is now live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here are the patch notes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now switch between TWO weapons!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now revive dead players with Energy Cells",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaked issues with powerups and perks being doubled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
