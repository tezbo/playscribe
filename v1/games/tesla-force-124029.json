  {
   "id": "tesla-force-124029@4",
   "gameId": "tesla-force-124029",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-11-19T14:08:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are happy to announce that we've left the Early Access with this update! Both Shelley and Lovecraft are now playable. We've also added three all-new cutscenes to flesh out the story. We've also expanded the inventions available at Wardenclyffe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'd like to thank everyone who participated in the Early Access and helped us shape the game to be much better. We couldn't have done it without your valuable input! ːsteamhappyː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As we just previously released the 0.9 patch, the 1.0 is much smaller in scope.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelist",
     "items": [
      {
       "text": "Lovecraft is now playable! You can unlock him by completing the quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Four (4) new upgrades added to Wardenclyffe!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added 4 all-new cutscenes to the game! And a menu for rewatching!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Duplicate perks are no longer possible to acquire from Wardenclyffe. It was OP!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
