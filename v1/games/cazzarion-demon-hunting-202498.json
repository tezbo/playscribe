       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Extended controller support: Pause and ESC are mapped to the controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Overlay integration: The game pauses when the Steam overlay is open",
