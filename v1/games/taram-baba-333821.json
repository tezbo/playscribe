  {
   "id": "taram-baba-333821@major-2025-06-27",
   "gameId": "taram-baba-333821",
   "displayName": "Big Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-27T07:45:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update introduces two optional secret bosses for players willing to dig a little deeper:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stormcloak",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Obsidian Sentinel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "They are powerful, well-hidden, and not part of the main path. You’ll have to explore thoroughly — and be ready for a challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve also applied many bug fixes and gameplay tweaks based on community feedback. These aren’t listed here in detail, but they should make the experience smoother overall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing. If you enjoy the update, consider leaving a review — it helps more than you’d think.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Good luck out there. You’ll need it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
