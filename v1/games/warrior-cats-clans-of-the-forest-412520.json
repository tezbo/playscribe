  {
   "id": "warrior-cats-clans-of-the-forest-412520@1.1",
   "gameId": "warrior-cats-clans-of-the-forest-412520",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-26T20:06:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you, Warriors, for all your feedback during the launch weekend! We’re happy to share that our first patch is now live on Steam. It includes mouse controls for the camera along with some bug fixes and quality of life changes. But we’re not done! We’re already at work on the next patch and we’ll share those details in the near future.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "When submitting feedback, please include your PC specs. This is tremendously helpful for our team to be able to address feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your patience and support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/46247576/2cb6d106a1dd0cd9d9a743420bda6b7b2bd0e6eb.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
