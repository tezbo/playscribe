  {
   "id": "warrior-cats-clans-of-the-forest-412520@major-2026-10-24",
   "gameId": "warrior-cats-clans-of-the-forest-412520",
   "displayName": "Mouse and Keyboard Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-24T04:52:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you, Warriors, for your feedback during launch weekend of Warrior Cats: Clans of the Forest. We've heard the feedback that you'd like better support for the mouse and keyboard. In the coming days we are going release an update that improves your keyboard and mouse experience. Please stay tuned for these updates, and thanks for playing!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
