  {
   "id": "warrior-cats-clans-of-the-forest-412520@1.2",
   "gameId": "warrior-cats-clans-of-the-forest-412520",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-11-02T18:05:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We love your continued feedback and support! With that, we’ve rolled out our next patch on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Patch 1.2 further improves mouse support, camera movement, improved key bindings, and addresses many other issues reported by users. Once again, your feedback has been extremely helpful. Thank you for your continued support!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A reminder: when submitting feedback, please include your PC specs if you’re playing on Steam or Epic. This is a huge help to our team in addressing any issues players are having.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-TMG Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/46247576/5345a59b3b3f41b52b61365ff63a829124864043.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
