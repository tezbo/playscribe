  {
   "id": "apsulov-end-of-gods-111130@1.1.6",
   "gameId": "apsulov-end-of-gods-111130",
   "displayName": "Patch 1.1.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2019-09-18T15:28:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Apsulov: End of Gods version 1.1.6 is now live and takes care of:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collision fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Loading save during root-transport no longer spawns you in strange places",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Giant leech will no respawn unconviniently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A few stability fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "// Angry Demon Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
