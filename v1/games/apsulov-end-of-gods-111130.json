  {
   "id": "apsulov-end-of-gods-111130@1.1.7",
   "gameId": "apsulov-end-of-gods-111130",
   "displayName": "Patch 1.1.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-01-09T08:26:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are back from the holidays and start the new year by releasing the latest patch 1.1.7 where we fixed:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some minor bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crashing issues involving ladders",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A bug where pressing escape on death screen locks the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned for future updates and patches and thank you to everyone who help us by reporting bugs. You help us make a more stable product for future players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Take care // Angry Demon Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
