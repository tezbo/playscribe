   "gameId": "apsulov-end-of-gods-111130",
   "displayName": "Patch 1.0.14",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2019-08-15T14:37:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We just released a patch (1.0.14) that fixes",
     "items": [
      {
       "text": "A section lock door that is randomly opened even though players can't go through them (Not supposed to be open).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Missing collision.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A crash during final boss battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some cosmetic issues.: Thank you for reporting bugs and issues and we aim to fix reported issues as soon as possible after they have been reported!: Take care // Angry Demon Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
