  {
   "id": "apsulov-end-of-gods-111130@1.0.11",
   "gameId": "apsulov-end-of-gods-111130",
   "displayName": "Patch 1.0.11",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2019-08-12T11:33:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're taking care of the bug reports as fast as possible and we're happy to announce that we've squashed the bugs with the following:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collision fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed places on 2 logs in Apsulov Research to be more accessible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Loki can no longer be \"downed\" in the Ether, which sometimes happened when you pulsed him",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the release trailer to the unlockables menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed crash when replaying from save point sometimes at the final Boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that made locks appear too early in Helheim temple",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lean keybinds are now the same as the “Change Page” buttons in the In Game Menu (Bifrost PDA)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Faster recharge time for the Energy Stations internal energy supply",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vsync can now be ON if you select a framerate limit higher than 60. Remember that V-Sync will limit the frame rate to your screens update frequence (To have higher framerate V-Sync needs to be OFF).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated french subtitling - Odin is no longer Santa Claus and Loki is no longer going to school. Localizer was either really funny or really bad... Not sure which...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed other minor issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "// Angry Demon Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
