  {
   "id": "apsulov-end-of-gods-111130@1.0.8",
   "gameId": "apsulov-end-of-gods-111130",
   "displayName": "Hotfix 1.0.8",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2019-08-09T16:51:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've just pushed a hotfix for Apsulov: End of Gods that has the following fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nerfed a few enemy encounters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Lowered charging time for large pulse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Collision issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clarification in RFID handling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clarifications in battery resource system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Arm no longer locks while using aim fire",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Material issues on lower graphics settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Korean language support has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unlockables can now be unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are sorry that some of you didn't recieve the unlockables you deserved. It should be fixed by now so if you continue your save and beat the boss again you should recieve the unlockable content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
