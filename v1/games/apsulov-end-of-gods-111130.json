  {
   "id": "apsulov-end-of-gods-111130@1.0.13",
   "gameId": "apsulov-end-of-gods-111130",
   "displayName": "Patch 1.0.13",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2019-08-13T15:39:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.0.13 is live and should bring a solution to the problem to players who got stuck behind an invisible wall in Helheim.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The patch also contains a few cosmetic fixes and collision fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sorry for the frequent patches post release. Patches should come more rarely from this point.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
