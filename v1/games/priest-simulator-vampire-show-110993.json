       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "add missing Vamela's voice overs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "correct \"Face Off\" counter,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "replace the exo book with a washing machine manual,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "modify HUD options and enable HUD minimization,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "make it possible to remove graffiti in a house with a slot machine,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fix audio bugs in cutscenes,",
       "ps5ProOnly": false,
       "pcOnly": false,
