  {
   "id": "dust-neon-215894@1",
   "gameId": "dust-neon-215894",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-14T21:28:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve been working away behind the scenes and we have our first major patch update for PC and Switch rolling out. We’ll keep addressing bugs and improving features, so stay tuned for more and keep sharing your feedback with us.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "BUG: Fix a reported blocker in Sabotage mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BUG: Fix brain booster effects not being added properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BUG: Fix shotgun grunts sometimes not being able to hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BUG: Boss health bar goes away if going into the pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BUG: Enemies can shoot from outside the screen sometimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BUG: Sticky sprint doesn’t work on keyboard/mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "BUG: Distortion effects are missing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BUG: Loot achievement doesn’t count non-picked-up/scrapped weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BUG: Fixed auto-aim when hip firing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BALANCE: Increased effect of rank on guns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BALANCE: Flip order of some gun shop upgrades.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BALANCE: Adjusted dropped ammo for rifle and shotguns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BALANCE: Tweak some brain booster effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BALANCE: Adjust some enemy stats (faster exploding critters, less delay in turret critters, faster reload for tanks)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BALANCE: Adjust xp curve to flatten (faster xp gain) after level 20 to reduce grind.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BALANCE: Adjust damage falloff for guns, less range for revolver and shotgun before damage is reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BALANCE: Increase the player weapon damage/enemy health curve that multiplies these based on rank.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BALANCE: Adjusted some prices in home base.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IMPROVEMENT: Rewrite mission board generation to be more varied. Regenerate all missions on every return and base it on the last two played missions to avoid too much repetition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IMPROVEMENT: Generate harder missions if the player has survived for a long time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IMPROVEMENT: Added more variations to Sabotage Mission house.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IMPROVEMENT: Made Kill Target enemies a bit more challenging.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IMPROVEMENT: Added warning visuals to traps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IMPROVEMENT: Redesigned Boss 5 a bit to be snappier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IMPROVEMENT: Add a few variations to Destroy Target barrels and make them explode faster to reduce the feel of grind on these missions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
