  {
   "id": "dust-neon-215894@3",
   "gameId": "dust-neon-215894",
   "displayName": "Patch 3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-11T06:17:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Howdy, Gunslingers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've got a small patch for you including some fixes that have been requested by the community and a couple small adjustments that we've put together since the game's launch on Xbox/PlayStation earlier this fall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "As always, please reach out to us in the Discussion Board here on Steam or in the Rogue Games Discord server if you run into any issues with the new patch.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Change List",
     "items": [
      {
       "text": "Fixed issues with gun stats not showing up correctly sometimes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with W.Elder not spawning correctly after beating him multiple times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted startup sequences to fix a potential issue that could cause loss of save data",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a couple achievements that rarely would not unlock correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Polish and smaller bug fixes for audio applied as well",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
