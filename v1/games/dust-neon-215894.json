  {
   "id": "dust-neon-215894@patch-2023-02-17",
   "gameId": "dust-neon-215894",
   "displayName": "Dust & Neon Game Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-02-17T00:09:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Launch day has been amazing so far and we’re so grateful to everyone playing our little piece of the Wild West. THANK YOU!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
