  {
   "id": "human-fall-flat-16992@hotfix-2021-12-21",
   "gameId": "human-fall-flat-16992",
   "displayName": "21/12/21 Human: Fall Flat Hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-12-21T16:39:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Happy Holiday’s Humans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are pleased to report we have fixed the recent issue found in the Laboratory level where players were unable to open the door in the Cannon room, you should now be able to open the door and proceed with the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We apologies for any inconvenience this may have caused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Human: Fall Flat Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
