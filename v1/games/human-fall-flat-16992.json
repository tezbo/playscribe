  {
   "id": "human-fall-flat-16992@major-2021-02-10",
   "gameId": "human-fall-flat-16992",
   "displayName": "Lunar Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-02-10T09:55:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "***Celebrate Lunar New Year in the lobby now!***",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lunar New Year celebrations are in full swing across China. Join the fun in a wonderful new feature packed lobby. Explore seven areas inspired by traditional Chinese tales. Unite the 12 zodiac symbols, shake the Fortune Tree to be richly rewarded and ride the Fortune Carp rollercoaster as it transforms into a dragon. Could the sky palace be your final destination? Jump in with up to seven other friends to see in the Chinese New Year together!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With a staggering combined audience of over 220M followers, Xiao Tuantuan, Daimei, Sanren, Zrdxr and LanZhanFei are some of the most popular content creators in China and with this update players will receive five in-game skins based on their likeness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition, Chinese composer Moyun has contributed her beloved music composition Dreaming of the Prosper Era to the Lunar Lobby, while musician Xu Mengyuan's track China-P features in the Lunar Lobby official launch trailer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
