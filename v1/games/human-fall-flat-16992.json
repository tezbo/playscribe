  {
   "id": "human-fall-flat-16992@1090333",
   "gameId": "human-fall-flat-16992",
   "displayName": "Hotfix 1090333",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-09-26T12:16:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Adjusted the final puzzle of Museum to feel better when attaching the artifact to the helicopter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted lighting in some darker areas that made the eye icons for Eye Spy achievement difficult to find",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Resolved an issue where the music was not playing as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue where the cannon balls could only be fired once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue where the vases may move unintentionally after being placed on the scale.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved multiple issues where checkpoint reloads could prevent the player from completing the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted collision in some areas to prevent the player from clipping into objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
