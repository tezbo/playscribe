 "releases": [
  {
   "id": "salt-and-sacrifice-152065@2.0.0.1",
   "gameId": "salt-and-sacrifice-152065",
   "displayName": "Patch 2.0.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-15T17:20:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have been busy reading all your feedback and working on the next update for Salt and Sacrifice. There's still a lot more we want to do but we decided it was time to start letting players get their hands on what we've been tweaking. There's a new \"Preview\" branch under Properties->Betas that will allow you to test the WIP patch 2.0.0.1. This update has now been released to retail!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Salt and Sacrifice 2.0.0.1 Balance Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Updated 12/07/2023)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weapon and armor balance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slower weapon scaling and target damage increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hyper armor added to heavy attacks for greathammers, greatblades, greatswords, and glaives, allowing them to withstand more poise damage before being interrupted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Whip scaling and target damage increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Poison and Fungal weapon damage increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tarcloth weapon buffs duration increased by 87.5%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wearing light armor and no armor adds a burst of stamina recovery per slot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buffed blocking of all weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Buffed blocking of vanguards even more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Greathammer sprint attack damage reduced but poise damage increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various weapon damage and poise balance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased fungal amulet effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Runic arts damage when using staves has been slightly increased.: Player balance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Endurance now adds additional poise per slot of heavy armor worn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Being hazeburnt no longer decreases hitpoints. Instead, being guiltless (non-hazeburnt) increases defense and item find chance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players can now change their aim direction when not firing/throwing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Flask drinking speed and healing speed has been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ladder climbing speed has been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Antidote cures all poison on use.: Monster balance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced juggle damage from monsters by 50% on subsequent hits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced poise damage of a variety of smaller monsters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Ashen Congregant damage has been reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Temple Highblade damage has been reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mages will only partially heal on player death or rest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced Kraeaxenar breath attack damage. Fixed damage type.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced Electromancer homing bolt turn speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Trials of the Brave monster tiers are now agnostic of NG+ level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased Salt + artifact awards from final boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed Candlebearer spawn outside of Worm That Does Not Die arena.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various monster and minion balance tweaks to outliers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nameless who end up in a boss arena should quickly leave now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hazeburnt enemies will spawn together less frequently and no longer guard ledges forever.: Quality of Life",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hearthen flasks, haze decoctions, and ranged ammo will always replenish to max when restocking but missing materials costs will be deducted from current player silver amount at a 10% markup. Materials are still maxed if the player lacks the silver for the materials.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stamina will continue to regenerate when sprinting outside of combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Skill tree hints highlight nodes for required class level and runic art abilities for the currently equipped weapons and armor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dying by falling will drop salt at the point the player jumped and not where they landed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Defeating the final boss no longer locks the player into ascending to NG+.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added inventory sorting.: Multiplayer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enemies no longer deal increased damage when cooperating with additional players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fast traveling will automatically bring along all ally players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dawnlight players will get a token when helping the host defeat roaming mages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PVP bonus damage from items and buffs has been adjusted based on the target's level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Flasks are now scaled independently of other equipment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Invaders and defenders will have a max of 2/3 * (Host's Hearthen Flasks+1).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that could cause the 20-minute invasion cooldown to be much shorter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that could cause network players to desync in the Heart of Altarstone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that could cause some players to be invisible to each other.: Misc Bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where killing the Undone Sacrifice with a critical riposte caused issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Left stick aiming will no longer override right stick aiming.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where players could not climb certain stairs when aiming, blocking, or attacking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed mouse aiming when the game resolution and game window size didn’t match.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug that could get the game into an improper aspect ratio causing the game to stretch or squish and some UI elements to become off-center.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed UI scale settings causing the skill tree to render outside the screen bounds.: Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Networked multiplayer is limited to players with the same patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will add to the list as new things are done and everything is subject to change.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
