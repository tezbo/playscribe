  {
   "id": "salt-and-sacrifice-152065@major-2023-11-07",
   "gameId": "salt-and-sacrifice-152065",
   "displayName": "Update: The Traitor's Tomb",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-07T09:02:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're pleased to announce our debut on Steam will be launching with the an all-new content update: The Traitor's Tomb. Details follow:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "New Content",
     "items": [
      {
       "text": "New zone - Descend into the mysterious Heart of Altarstone, an expansive new dungeon hiding the Marked Inquisition’s darkest secrets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New NPCs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New monsters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New bosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "PVE boss gauntlet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "PVP arena.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a variety of range, timing, and visual effects to all weapon buffs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A new beacon type has been added to zones that allow fast traveling within a zone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Networking",
     "items": [
      {
       "text": "Cross-play multiplayer between all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes / Improvements",
     "items": [
      {
       "text": "Skill tree window improvements - larger window and colors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Buy/Sell count wraps to easily go from 1 to max.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Preventing camera zooming on remote players during some sequences.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rings and amulet items properly show if they’ve been crafted before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Plunge attack no longer completely drains stamina with scythe weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed displaying some negative values in the UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mundane weapons will generate rage for offhand weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tokens from fated hunts are guaranteed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made a particularly hard jump in the swamp a bit easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dying from damage over time on a ladder is handled better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a hazeburnt commoner in Nowhere for off-line bestiary unlock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed infinite “Obliterated” screen in some coop instances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some weapon swapping causing characters to lock up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Additional fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
