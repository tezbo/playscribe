  {
   "id": "submarine-survivor-318350@1.0.8",
   "gameId": "submarine-survivor-318350",
   "displayName": "Update 1.0.8",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-26T17:59:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1.0.8? and what about updates since 1.0.3?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There have been small updates of the game to fix some bugs or to add some effects. I have not considered it necessary to make a post about each of them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "As a summary, this is what has changed from 1.0.3 to 1.0.8",
     "items": [
      {
       "text": "Added feedback from enemies when you hit them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug that caused bonus missions, on max difficulty, to not be assigned correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused the fire of the rocks of the stone boss to make a strange trajectory when destroyed (it's only a visual error, it didn't affect the player at all).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a problem that caused the player movement to be only in 8 directions (now the player has a better control over the submarine).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed other small bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
