  {
   "id": "submarine-survivor-318350@1.0.3",
   "gameId": "submarine-survivor-318350",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-15T11:47:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings captains!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have been working on more changes to keep improving the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The amount of enemies on screen has been limited.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Greatly reduced the requirements of enemies eliminated to unlock submarines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that occurred when the trader appeared: If you played with the controller, a menu option was selected instead of the dialog.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor bugs fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Applied changes from 1.0.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I wanted to apologize, as I saw that the previous update had not been applied correctly. I have been very busy and for some strange reason Steam did not publish the changes. Now I have made sure that this update has been published correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
