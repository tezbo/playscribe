  {
   "id": "submarine-survivor-318350@1.0.1",
   "gameId": "submarine-survivor-318350",
   "displayName": "Update 1.0.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-18T14:10:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you very much to everyone for the feedback. I will continue to tweak and improve the systems as I detect problems or player feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Progression",
     "items": [
      {
       "text": "The quality of resources that can be obtained from enemies has been adjusted: now the most valuable resources drop on higher difficulties.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Passives",
     "items": [
      {
       "text": "The “Gold Rush” passive has been redesigned, now it will be “More Blueprints in barrels”. This new passive will increase the amount of blueprints you get from random barrel events during raids.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: this passive greatly unbalanced the progression as it affected the passive system itself, I have opted for a new passive that does not directly impact the progression of the passives but will help improve the submarine upgrade system. Don't worry if you had invested your coins in the passive, as you can reset only that passive if you wish and re-invest the coins where you need them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Merchant",
     "items": [
      {
       "text": "The merchant will no longer offer the “Gold Rush” deal, it will now offer “More blueprints in barrels”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Submarines",
     "items": [
      {
       "text": "Changed the max level bonus of the “Balanced” submarine to 25% damage (previously it was 40% extra coins).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the maximum level bonus of the “Demolisher” submarine to 25% critical damage (before it was 25% damage).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep on exterminating sea creatures, captains!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
