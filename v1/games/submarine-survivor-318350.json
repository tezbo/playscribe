  {
   "id": "submarine-survivor-318350@1.0.2",
   "gameId": "submarine-survivor-318350",
   "displayName": "Update 1.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-02T11:56:32.000Z",
   "notes": [
    {
     "title": "Enemy Health Adjustments",
     "items": [
      {
       "text": "Jellyfish: Health reduced by 50%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Piranha: Health reduced by 50%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Pufferfish: Health reduced by 42%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Electric Eel: Health reduced by 33%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Angler Fish: Health reduced by 33%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Starfish: Health reduced by 38%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Seahorse: Health reduced by 40%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Sea Urchin: Health reduced by 43%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Bosses: Health reduced by 67%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Damage Type Changes",
     "items": [
      {
       "text": "Physical: Accumulated damage is now 18% (previously 15%).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Heat: Increased damage is now 30% (previously 25%).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Explosive: Stun duration is now 1s (previously 0.75s).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Poison: Time before damage is now 4s (previously 5s).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Electric: Slow duration is now 0.75s (previously 0.5s).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cold: No changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes to Collectible Item Duration",
     "items": [
      {
       "text": "Coins: Now have a duration of 60s (previously 40s).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Experience: Now have a duration of 60s (previously 50s).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Healing Vial: Now have a duration of 60s (previously 30s).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minerals (Resources): Now have a duration of 60s (previously 40s).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Merchant Items: Now have a duration of 60s (previously 40s).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Next Steps",
     "items": [
      {
       "text": "I’m actively working to better balance the game based on the valuable feedback I’ve received from the community. My goal is to make the experience more enjoyable and fair for all players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In parallel, I’m developing a roadmap for this year that will include exciting new content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I want to thank all players for their patience and continuous support. Your feedback and engagement are key to improving and evolving this project.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
