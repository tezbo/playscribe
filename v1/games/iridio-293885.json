  {
   "id": "iridio-293885@1.996",
   "gameId": "iridio-293885",
   "displayName": "Update 1.996",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-16T14:01:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey survivors! 🌍",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just rolled out a new Iridio update (v1.996) packed with improvements, optimizations, and fixes to make your experience smoother and more immersive than ever.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s what’s new in this build",
     "items": [
      {
       "text": "🛠️ Engine Update. Upgraded to Unity 6.0.58f2 LTS, fixing latest vulnerabilities and improving overall stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "⚙️ Performance Boost. Faster load times and better frame rates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🌄 Terrain Sync. Terrain loading is now significantly quicker and more seamless.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "💡 Visual Upgrades. Enhanced shaders and lighting for a richer atmosphere.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🤖 Smarter AI. Various AI behavior fixes for more natural interactions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🌲 Audio Enhancements. New ambient sounds for forests and oceans.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🐞 Minor Bug Fixes. Tidied up a few rough edges.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "As always, thank you for playing and sharing your feedback: it really helps us make Iridio better every update 💚🤍",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Stay tuned for more exciting news soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "KR Games team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
