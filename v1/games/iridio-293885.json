  {
   "id": "iridio-293885@1.997",
   "gameId": "iridio-293885",
   "displayName": "Update 1.997",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-12-18T12:29:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "To celebrate the holidays, we have prepared a new update: EA Build 1.997 🎁",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This build focuses on gameplay polish, AI improvements, and better performance across a wider range of hardware, with special attention to low-end machines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔧 What’s included in Build 1.997",
     "items": [
      {
       "text": "Improved player movement and jump mechanics for smoother and more responsive controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed terrain holes to improve world consistency and immersion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enhanced tree LOD transitions and collision accuracy across the terrain",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved NPC and tiger AI behavior",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added gamepad zoom and scroll support to the main menu map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved performance scalability, especially on lower-end systems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Various minor bug fixes and stability improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We wish you a wonderful holiday season, and we’ll see you in-game! 💚🤍",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "KR Games team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
