 "releases": [
  {
   "id": "iridio-293885@1.998",
   "gameId": "iridio-293885",
   "displayName": "Update 1.998",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-30T09:58:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Survivors! 👋",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just pushed update 1.998 for Iridio, bringing a mix of improvements, new features, and some wild surprises on the island 🏝️🐻",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s what’s included in this update",
     "items": [
      {
       "text": "🖥️ Fixed ultra-wide resolution issues – UI scaling and off-screen elements should now behave properly on ultra-wide monitors",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "🎮 Added V-Sync option in the settings (both full and half modes)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🌍 Localization added for all supported languages (check the store page for the full list)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🐻 Wild animals added to the island – including bears and other creatures roaming around",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🦈 Improved shark AI behavior (they should feel more natural and challenging now)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛠️ Minor bug fixes and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🚀 Early Access Exit Date",
     "items": [
      {
       "text": "We’re also happy to finally share that Iridio will officially leave Early Access on May 14th, 2026! 🎉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Early Access has been an incredible journey for us, and your feedback has helped shape and test the game in ways we couldn’t have done alone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Over the coming weeks we’ll keep polishing and preparing the game for its full release.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "💚🤍 Thank You",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A huge thank you to everyone who has supported Iridio so far: reporting bugs, sharing ideas, and surviving on the island with us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More updates coming soon… and watch out for those bears! 🐻",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "KR Games team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
