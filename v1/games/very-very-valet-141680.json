  {
   "id": "very-very-valet-141680@2.1.3",
   "gameId": "very-very-valet-141680",
   "displayName": "Patch 2.1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-07-31T00:26:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have updated Very Very Valet with some input improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player 1 can now use only the keyboard (no joystick). So if you have 1 fewer controller than players, one player can use the keyboard now! Previously this was not possible, because disabling a controller for Player 1 wasn't allowed.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Input prompts now detect the connected controllers, and show the correct prompts for the connected controller type. Special button glyphs exist for Xbox, Playstation, and Nintendo Switch controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "Please note that the game uses XInput for Xbox/Microsoft controllers, and XInput has a limitation of 4 controllers connected at once. To play with more than 4 players, we recommend using up to 4 Xbox controllers, and then other controller types (Dualshock, Joycons, etc) to fill out the other players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    }
   ],
