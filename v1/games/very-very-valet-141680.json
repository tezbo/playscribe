  {
   "id": "very-very-valet-141680@2.1.2",
   "gameId": "very-very-valet-141680",
   "displayName": "Update 2.1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-07T21:07:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed some achievements that were not unlocking properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare crash when the \"embiggen\" special was activated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed placement of bumpers on sporty car type to give them more clearance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The score UI will politely fade out when an active customer or car timer is underneath it now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the launchers on \"Observatory\" to be more reliable regardless of framerate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Revised \"Seismic Stories\" to make trampolines more reliable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Revised \"Sharing Spaces\" to have a staircase on the right-hand side",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Revised \"Downtown\" slightly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made some improvements to replay playback speed under various refresh rates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
