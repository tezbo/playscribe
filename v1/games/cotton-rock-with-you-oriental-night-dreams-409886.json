   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "・Fixed a bug where sushi would sometimes not appear even when the conditions were met.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed a bug where Izuna’s “Dimensional Slash” would sometimes not work against lasers at the top and bottom of the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed a bug where hitboxes appeared in unexpected locations when the Stage 3 boss transformed into its second form",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed a bug where the number of bells that appeared was sometimes lower than intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed a bug preventing the ending from being skipped after the true boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Changed mid-bosses in FA Cotton and FA Silk to drop white crystals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed a bug where charged spells would not be cast under certain conditions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
