  {
   "id": "citizen-sleeper-2-starward-vector-252853@major-2025-10-29",
   "gameId": "citizen-sleeper-2-starward-vector-252853",
   "displayName": "Citizen Sleeper 2: Starward Vector Localization Update Available Now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-29T17:00:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44238001/635f7816ce2e2632e24aa0ed3f4b948e2aa951d5.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wake up, Sleeper - Citizen Sleeper 2: Starward Vector is now available in French, Japanese and Simplified Chinese!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With a Metascore of 86 - keeping great company alongside Deltarune, Ghost of Yotei, Age of Mythology and even Mario Kart World! - Citizen Sleeper 2 is a dice-driven RPG which will satisfy both fans of the original game and new players alike.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44238001/724877e5bcdefef22fd2e8669ea83aeca12a7098.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Citizen Sleeper 2 is currently on sale for an all-time low discount of 33%, so there's never been a better time to journey to the Helion Belt. If you're new to the Citizen Sleeper universe, why not grab the Helion Collection and pick up both games for a special price?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/bundle/48671/Citizen_Sleeper_Helion_Collection/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So get a ship, find a crew and start working those contracts as you make your way across the stars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
