   "id": "toroidal-awaiting-the-spring-244699@post-2023-08-15",
   "gameId": "toroidal-awaiting-the-spring-244699",
   "displayName": "8/16アップデートのお知らせ",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-08-15T15:24:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "「春待ちトロイダル」をご愛顧頂き誠にありがとうございます。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "本アプリは8/16(水)の0:18頃、アップデートを実施致しました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "【アップデート内容】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・対話完了後に別のキャラクターが出てきてしまうバグの修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "引き続きバグや改善点の報告がありましたら、samesamekunのTwitterアカウントかメールにてご報告いただけますと幸いです。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "全てに対応できない可能性はありますが、前向きに対応を検討させて頂きたいと思います。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Twitter(今はX)：https://twitter.com/samesamekun",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mail：samesamesummation@gmail.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "今後ともさめさめサメーションおよび春待ちトロイダルをよろしくお願い致します。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
