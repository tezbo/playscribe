   "gameId": "doraemon-story-of-seasons-friends-of-the-great-kingdom-206815",
   "displayName": "Notice of Patch Update (10379677)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-09T08:04:49.000Z",
   "notes": [
    {
     "title": "Thank you for your support on DORAEMON STORY OF SEASONS: Friends of the Great Kingdom.",
     "items": [
      {
       "text": "A patch update has been released.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Release Date: 9th Mar 2023",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-----------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The following items have been distributed for free.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Noby Balloon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Doraemon Balloon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Summer Wear Set",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Home Furniture Set (Red Paper Lantern, Retro Silver Table, Wicker Chair)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed error where during 2-Player mode, the \"Land Fishing Rod\" is activated for Player 2 when used by Player 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-----------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that an internet connection is required to apply the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
