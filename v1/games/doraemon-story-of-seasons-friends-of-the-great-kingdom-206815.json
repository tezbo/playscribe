   "id": "doraemon-story-of-seasons-friends-of-the-great-kingdom-206815@major-2023-01-18",
   "gameId": "doraemon-story-of-seasons-friends-of-the-great-kingdom-206815",
   "displayName": "Notice of Patch Update (10055053)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-01-18T08:56:24.000Z",
   "notes": [
    {
     "title": "A patch update has been released.",
     "items": [
      {
       "text": "Patch Release Date: 18th Jan 2023",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-----------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed certain text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the \"Walk\" input key is unexpectedly reverted, after restarting the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted interaction range of certain objects, due to issues while attempting to talk to Non-player Characters near certain objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the increase in friendship level with Foira under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted probabilities in changes of weather.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Mid-Spring to Late-Spring: Higher probability of rain.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Early-Summer: Higher probability of rain.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Early-Autumn, Late-Autumn: Higher probability of cloud.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mid-Winter to Late-Winter: Higher probability of snow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pushing and rotation of animals are now faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted probability of certain crops appearing.: ▼Increased probability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Ginger",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Royal Fern",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mugwort: ▼Adjusted probability at Hissfizzle Pass",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mugwort (Will appear at Hissfizzle Pass as well)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dandelion (Reduced probability)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where the crown mark is not displayed on caught fish and insects under specific conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved usability and overall game stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-----------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that an internet connection is required to apply the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
