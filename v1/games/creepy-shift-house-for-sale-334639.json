  {
   "id": "creepy-shift-house-for-sale-334639@patch-2026-04-22",
   "gameId": "creepy-shift-house-for-sale-334639",
   "displayName": "Stability & UI Improvements Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-22T15:35:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ave Creeps! 😈",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re rolling out another update focused on improving overall stability and pushing the game closer to full Steam Deck Verified status. This patch brings several UI improvements, fixes for visual inconsistencies, and general tweaks to make your handheld experience smoother and more polished. Thanks a lot for all your feedback, it really helps us keep improving the game! 🙌",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "Improved text scaling across multiple UI elements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed incorrect and missing glyphs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "General stability improvements for a smoother handheld experience",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved occlusion accuracy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed objects disappearing when picking them up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Night Shift Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
