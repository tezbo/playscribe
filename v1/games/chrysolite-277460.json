  {
   "id": "chrysolite-277460@major-2025-03-05",
   "gameId": "chrysolite-277460",
   "displayName": "\"Chrysolite\" Update: New Languages and Technical Improvements",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-05T14:13:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "\"Chrysolite,\" developed by José Manuel Conesa Hernández and published by Firenut Games, continues to grow with its latest update. This new version introduces support for two major languages, Chinese and Japanese, allowing more players worldwide to dive into the dark and captivating story of the fallen kingdom.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition to localization, the update addresses several minor bugs reported by the community, ensuring a smoother and more polished gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Firenut Games reaffirms its commitment to the global \"Chrysolite\" community and promises to continue working on future improvements and additional content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
