   "id": "lakeview-cabin-collection-25622@major-2023-09-22",
   "gameId": "lakeview-cabin-collection-25622",
   "displayName": "Another Friday, Another Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-22T22:02:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Well hello there. I thought I'd drop a little update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The list of changes isn't that long, but there's some substantial stuff to be found!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Roope: v0.54",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "All Episodes",
     "items": [
      {
       "text": "The screenshake when a character gets hurt should now only happen if a character is inside the view",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the audio when a character gets damaged",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Episode 1",
     "items": [
      {
       "text": "Fixed the enemy boat being wonky",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Grandma seems to like video games now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made the dad do the dad-tuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Episode 2",
     "items": [
      {
       "text": "The secret killer might now be randomly patrolling a dark corridor…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The luggage trolleys can now be destroyed in more ways",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made the loot that releases a ghost more clear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the drinking animation with the bottle of whiskey",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tried a fix for the elevator sprite problem that I wasn’t able to replicate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Episode 3",
     "items": [
      {
       "text": "Made killing grandma more fun",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Episode 4",
