  {
   "id": "hello-kitty-island-adventure-254871@major-2025-02-06",
   "gameId": "hello-kitty-island-adventure-254871",
   "displayName": "Update Notes for February 6th",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-06T20:28:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Steam players! We have another update for you to download full of fixes and quest improvements, including;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Dye Station is no longer usable by multiplayer guests in order to situations where quests can break. Sorry for the inconvenience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Infinite scroll should no longer occur on menu screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The one-day wait between the Make Yourself at Home and Friends & Family quests has been removed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Critter Lists no longer require tools in order to find them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pressing cancel when discussing Friendship Beads with Keroppi will cancel your purchase",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
