  {
   "id": "hello-kitty-island-adventure-254871@major-2025-02-12",
   "gameId": "hello-kitty-island-adventure-254871",
   "displayName": "Update Notes for February 12th",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-12T22:37:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello friends! Our newest Steam patch is now available. Here are the bugs we fixed:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cancel button in dialogue works more consistently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UI in windowed mode is now more easily resizable",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Missing items from the Deluxe Event Bundle are being granted to players! If you have already unlocked this bundle, you will receive these items upon starting a session. If you have not unlocked the Deluxe Event Bundle, you will get all items at the same time once the quest requirements are reached.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fish Tales weekly quest - Players should be able to catch fish in Mount Hothead as intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy exploring!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
