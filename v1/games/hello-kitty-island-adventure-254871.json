  {
   "id": "hello-kitty-island-adventure-254871@post-2025-09-18",
   "gameId": "hello-kitty-island-adventure-254871",
   "displayName": "CU3 is here! Hooray, Let’s Cheer!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-18T13:59:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Sunken Treasure",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Who’s ready for a treasure hunt? My Melody’s missing furniture shipment washed into Rainbow Reef. Meanwhile, Kuromi’s been reading a new series of pirate novels and has her own sea-faring ambitions! Follow the quest and unlock their sweet and spooky character furniture.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Ultimate Fishing Upgrade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fishing is ready for an upgrade! Learn all about lures and participate in the Fishing Derby to earn out of season event rewards. Search Friendship Island for Fish Almanacs for fishing tips. Plus, Badtz-maru is on the trail of a mysterious… fish? Put on your detective coat and hat and join the investigation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45303325/66f77f5b11a2d5baa1b22ff632b2129b59f664fa.png\"]New Visitors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Welcome more of Retsuko’s friends! Tsunoda is looking for the perfect selfie, while Manaka Hidarin, and Migi are making a tour stop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45303325/8bdd824fdcf72ba0ccd0ac6512acb3701118304a.png\"]Visitor Companions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visitor companions are here! Ask a visitor to join you and explore the Island with Hello Kitty and Dear Daniel, Kuromi and Baku, or Cinnamoroll and Milk at your side.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Big Friends, Little Friends, Best Friends",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ready for even more quests? Celebrate your friendship with My Melody with new furniture, Retsuko with a rock show, and Big Challenges with hats. Learn to be a unicorn with Corune. Explore hobbies with the Island Spirit. Find the Lloromannic’s secret hideout, pick up new Echo Conches, and unlock miniature cooking stations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rodent Avatars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Finally, get hype for rodent avatars! Try out new looks as a chipmunk, hamster, mouse, and more.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
