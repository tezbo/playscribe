  {
   "id": "hello-kitty-island-adventure-254871@post-2026-01-23",
   "gameId": "hello-kitty-island-adventure-254871",
   "displayName": "CU5 Cozy Fits and Blanket Forts",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-01-23T18:10:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45303325/88288a91972aea43fb1daff1756d387e37c0b3b4.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Who’s this waking up from hibernation? ​​Meet Marumofubiyori (Moppu), a gentle polar bear who naps under a fluffy blanket and spends his waking hours playing video games in his cozy cave. He’s been hibernating through the island’s chilly season—until your arrival wakes him up! Explore Moppu’s mysterious lair, stock up on snacks from a new cooking station, discover new furniture sets, a brand-new minigame, and enjoy a jolly new companion ability: Throwing Snowballs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Meet Marumofubiyori (Moppu): the island’s sleepiest new friend",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A brand-new friend has been hi-bear-nating deep in Icy Peak all along! Wake him from his winter slumber and restore his warm, blanket-filled gamer hideaway.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Avatars: Bears",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Give yourself an un-bear-ably cute makeover as you frolic in the Snow Village.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Cooking Station",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Time to stock up on snacks! How else does one get through all these games?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Dial up the old-school nostalgia, and put those gamer skills to the test.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Settle in, bundle up, and get ready for your snuggliest winter adventure yet today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45303325/2c9422917af6d594a8795514457b25cf713b4c7b.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "© 2026 Sunblink.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]© 2026 SANRIO CO., LTD. Used Under License.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
