  {
   "id": "snooker-nation-championship-33123@post-2019-05-03",
   "gameId": "snooker-nation-championship-33123",
   "displayName": "PATCH NOTES - 30/4/19",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2019-05-03T15:02:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update patch notes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New mode: Snooker Plus now implemented",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Snooker Plus championship",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Online Mode: Leagues Online",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Revamp of the AI utilising original WSC physics - the AI now play snooker and will play tactically",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Online stability improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crowd sounds applaud and react during matches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Menu flow improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Snooker Plus now implemented",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Aiming aid now shows the trajectory of the cue ball",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Local Multiplayer updated to make joining a Human Vs Human match clearer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save match progress during the tour",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated cameras to be more like Pool Nation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made 'forced retake' UI clearer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Numerous bug fixes including but not limited to",
     "items": [
      {
       "text": "Optimisations and performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made powerbar clearer in overhead",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed exiting replays putting you into free cam",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated to the latest version of UE4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "NOTE: There are some reported issues for certain monitors / graphic card settings on PC which we are looking into - however if you would like to access the old build until these issues are fixed then it can be accessed here:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Steam branch: previousrelease",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
