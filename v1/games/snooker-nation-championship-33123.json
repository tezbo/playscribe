  {
   "id": "snooker-nation-championship-33123@post-2016-05-09",
   "gameId": "snooker-nation-championship-33123",
   "displayName": "Patch Notes #1 - 9th May 2016",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2016-05-09T10:23:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you beta testers for your help on testing the first patch for Snooker Nation, the next patch will be on the BETA branch today and this patch is now live :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes below",
     "items": [
      {
       "text": "Crowd sounds should now be correctly linked to the 'crowd' volume slider in settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for flashbacks not restoring whether you were on reds/colours for the shot you flash back to",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect frames being shown during championship",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with being sometimes sent back to versus screen when backing out of championship",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for music becoming insanely loud after a few games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tour difficulty now correctly taken into account when choosing your opponents",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lowered the default camera height to be closer to the cue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Set default cue distance to 'mid range' to be closer to real life head position",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue with being taken to the PoolNationVR store page",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for resolution setting defaulting to 640x480 when alt-tabbing out",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Achievements + Icons now added. More to follow soon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed lobbies in snooker hall showing '8ball'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed decal when chosen decal is 'none'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed W.I.P leagues option until complete",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated the 'TV Cam' position to more closely match TV coverage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced difficulty of AI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fix for timing related crash when joining online matches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Achievements + Icons now added. (More to follow)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
