   "displayName": "Patch Notes - 13/6/2019",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2019-06-13T13:28:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Good news a patch is due for release today, which includes the fix for the remapping issue ːsteamhappyː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Reverted Default power level to give better control of low power shots. addressing the table speed issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed crash issue when going to controls remapping screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Remapping of controls implemented.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "NEXT patch will include",
     "items": [
      {
       "text": "Fixed achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Anything else that is needed for the next patch please let us know",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "CherryPop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
