  {
   "id": "star-ocean-the-divine-force-178298@post-2022-11-25",
   "gameId": "star-ocean-the-divine-force-178298",
   "displayName": "Shader Cache issue resolved: multi-byte letters in OS username + NVIDIA GPUs",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-25T11:36:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The issue regarding the inability to create shader cache when using multi-byte letters for OS username while also using NVIDIA GPUs has been resolved with the latest graphics driver “Release 525 Driver for Windows, Version 526.98.”",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you have been affected by this issue, please try updating the graphics driver in order to resolve this issue.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please also make sure to re-compile the shader after the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The shader can be re-compiled by following steps",
     "items": [
      {
       "text": "1. Start the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Go to “System” menu from title screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Go to “Graphics” option, scroll down to “Pre-compiled Shaders” and set it to “ON”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Restart the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. The shader compilation will now start",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "*The ”Pre-compiled shader” option will turned OFF after compilation process completed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
