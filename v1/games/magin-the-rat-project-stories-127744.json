  {
   "id": "magin-the-rat-project-stories-127744@major-2020-06-26",
   "gameId": "magin-the-rat-project-stories-127744",
   "displayName": "Kickstarter devlog update on YouTube",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-06-26T14:22:04.000Z",
   "notes": [
    {
     "title": "Check our latest devlog about the Kickstarter campaign!",
     "items": [
      {
       "text": "We're a fully independent team of hard-working developers, trying to bring to life a vision 3 years in the making. We’re convinced that the best way to keep that spirit alive and deliver a quality product is to ask other gamers for help directly. So far we’ve been working without any funding, but recently we launched a Kickstarter campaign. Hopefully it will allow us to keep fulfilling our dream of making a great game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
