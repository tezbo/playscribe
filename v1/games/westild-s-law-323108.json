  {
   "id": "westild-s-law-323108@1.0.14",
   "gameId": "westild-s-law-323108",
   "displayName": "Update 1.0.14",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-11T12:54:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re excited to announce the release of version 1.0.14 of our game, bringing highly requested features to enhance your gaming experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's New",
     "items": [
      {
       "text": "Screen Shake Setting: You can now enable or disable screen shake in the settings menu, giving you more control over your gameplay comfort.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Custom Keybindings: Players can now remap keyboard keys to suit their personal preferences. Adjust the controls to fit your playstyle for the ultimate gaming experience!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "French Language Added: We're happy to introduce French as a new language option in the game. Enjoy playing in your preferred language!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you for your feedback and support! We’re committed to making the game even better, so stay tuned for more updates. Enjoy the new features! 🎮",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Don't forget to report any new issues or bugs. Thank you and see you in the Wild West! 🌵",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
