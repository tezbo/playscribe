       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's New",
     "items": [
      {
       "text": "📝 Important Note: To upload your first save file to the cloud, make sure to launch the game on the device where you already have progress. This ensures your data syncs properly to Steam Cloud.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you for your continued feedback and support! We’re committed to making your experience better with each update. If you encounter any issues, please don’t hesitate to let us know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Happy gaming, and enjoy the convenience of Steam Cloud Save! ☁️🎮",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
