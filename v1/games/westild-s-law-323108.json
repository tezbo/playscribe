  {
   "id": "westild-s-law-323108@1.0.15",
   "gameId": "westild-s-law-323108",
   "displayName": "Update 1.0.15",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-18T09:13:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re thrilled to announce the release of version 1.0.15 of our game, introducing a highly anticipated feature to enhance your gameplay flexibility!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's New",
     "items": [
      {
       "text": "Hero Upgrade Reset and Refund: You can now reset your hero’s upgrades and receive a full refund of the invested money! This feature is perfect for players who find themselves short on cash for new weapons or skills. Experiment with different strategies without worrying about wasted resources!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you for your continued feedback and support! We’re always working to improve your experience, so stay tuned for more updates. Have fun exploring the Wild West! 🌵",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "As always, if you encounter any issues or bugs, please let us know. Happy gaming! 🎮",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
