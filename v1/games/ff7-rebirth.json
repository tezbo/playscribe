  {
   "id": "ff7-rebirth@1.001",
   "gameId": "ff7-rebirth",
   "displayName": "Update 1.001",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-02-03T10:53:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Improved overall game stability, including several bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the graphics preset to be set to 'Low' when launching for the first time on Steam Deck, even when save data is linked from the cloud. (The next time the game is launched on Steam Deck, the saved settings will be applied.)",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ],
       "pcOnly": true,
       "category": "fixed"
      },
      {
       "text": "When playing on a PC that supports NVIDIA DLSS, the default setting for 'Anti-Aliasing Method' is now set to 'DLSS'.",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ],
       "pcOnly": true,
       "category": "other"
      },
      {
       "text": "The DirectStorage DLL (Dynamic Link Library) has been updated to the latest version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
