  {
   "id": "ff7-rebirth@1.005",
   "gameId": "ff7-rebirth",
   "displayName": "Update 1.005",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-06-03T00:22:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "・ “Streamlined Progression Feature”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ “New Game - Head Start”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "are now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Streamlined Progression feature includes several enhancement options to streamline combat and exploration—like unlimited HP and MP at all times, 9,999 damage dealt to enemies during battles and minigames, and the maximum number of each item available (with some exceptions)—which can be tailored to suit the player’s preferences. The feature helps you advance through the game smoothly, not only during your first playthrough but also when you replay it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"New Game - Head Start\" allows you to start the game with level 65 characters (max level: 70) equipped with several enhanced materia.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The PC version now also supports AMD FSR upscaling, enabling more stable and detailed image processing.",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ],
       "pcOnly": true,
       "category": "other"
      },
      {
       "text": "We hope you apply this latest update and utilize these features to enjoy FINAL FANTASY VII REBIRTH’s story and refreshed game experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*The Streamlined Progression feature can be toggled on or off for each option at any time from the in-game options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*This update also includes additional minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
