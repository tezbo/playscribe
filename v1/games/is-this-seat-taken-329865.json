  {
   "id": "is-this-seat-taken-329865@major-2025-09-29",
   "gameId": "is-this-seat-taken-329865",
   "displayName": "Quality of life update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-29T08:53:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're excited to bring you the latest update for “Is This Seat Taken?”! 🚌",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "💾 Save System",
     "items": [
      {
       "text": "Autosave in the middle of a level! Need to take a break? No problem! Now you can exit at any point during a level, and when you come back, you’ll start at the stop where you left off. No more losing progress or restarting from the beginning!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔒Menus & UI",
     "items": [
      {
       "text": "Confirmation Popup: a confirmation message will appear if you press the Confirm button while a character is in the wrong seat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restart Popup: an are-you-sure popup will appear when you press the Restart button in the Pause menu, asking you to confirm your action.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🐞Bug fixes",
     "items": [
      {
       "text": "Fixed a soft-lock caused by pressing the Confirm button twice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Confirm button can no longer be pressed from the Pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other smaller bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🗨️Localization",
     "items": [
      {
       "text": "Fix incorrect translations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you find a bug, you can report it using the following form:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Google form link",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All the best, ⭐",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ausiàs & Sergi",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Poti Poti Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
