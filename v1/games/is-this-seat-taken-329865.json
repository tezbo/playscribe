  {
   "id": "is-this-seat-taken-329865@post-2025-02-18",
   "gameId": "is-this-seat-taken-329865",
   "displayName": "Demo Bug Fixes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-02-18T16:22:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, everyone! ⭐",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've made a ton of improvements recently, all thanks to your amazing support. 🙌",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs & Fixes",
     "items": [
      {
       "text": "Fixed random crashes on laptops.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed black screen issue on older MacBooks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where a talking shape didn’t wake up a sleepy shape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected French typos. Thanks to @Zedora_exe",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Improved cursor assist for controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Visual update to the bookmark indicator.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you come across any more bugs or have any feedback, feel free to share it in this post. We really appreciate your help!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned for more updates, and see you soon! ✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
