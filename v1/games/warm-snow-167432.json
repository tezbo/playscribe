  {
   "id": "warm-snow-167432@post-2022-02-01",
   "gameId": "warm-snow-167432",
   "displayName": "[0201]Attributes loss and Blacksmith bug",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-02-01T05:33:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
