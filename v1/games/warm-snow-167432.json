  {
   "id": "warm-snow-167432@post-2021-12-13",
   "gameId": "warm-snow-167432",
   "displayName": "[1213]Bug fixes and game optimization",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-12-13T09:08:04.000Z",
   "notes": [
    {
     "title": "BUG repair",
     "items": [
      {
       "text": "1. Fixed the poster display resolution problem after clearing the ‘House of the Swine’ levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "2. Fixed the situation where the item falls outside the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Experience adjustment",
     "items": [
      {
       "text": "1. Repaired several maps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "2. The damage of ‘Twisted Pig-faced Hag’ has been reduced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "3. The damage of ‘White Wolf King’ has been increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "4. The damage of ‘Nameless Swordsman’ has been increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "5. Re-worked Linglong's voice-over",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "6. Added voice-over for ‘Lady Boss’",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "7. Strengthened the stats for elite monsters, added drops for magical weapons and cheats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "8. Adjusted the health point for infected pigs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
