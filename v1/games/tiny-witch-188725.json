  {
   "id": "tiny-witch-188725@1.1.3",
   "gameId": "tiny-witch-188725",
   "displayName": "Update 1.1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-08-07T23:17:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello magical beings! 🪄",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👾 Bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Reviewed achievements in Challenge Mode",
     "items": [
      {
       "text": "We’ve thoroughly revised the logic behind three achievements that were not triggering as expected:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All Decorated, Everything Dirty Here!, and Let’s Mash It Up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "During this process, we applied small adjustments and improvements to the validation conditions that might have been interfering with achievement tracking—especially under specific Challenge Mode restrictions. The system now correctly interprets flags like not using certain items or not buying pets. Progress tracking was improved and all tests were executed specifically in the Village map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Tutorial",
     "items": [
      {
       "text": "We fixed minor bugs and improved the message flow throughout the tutorial to make the onboarding clearer and smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Audio",
     "items": [
      {
       "text": "Fixed an issue where the music from the Village store would keep playing alongside the world map music after finishing day 10. Now, only the map music will play at that moment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "⸻",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any other issues, please let us know using this form:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tiny Witch even more magical! 💫",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With gratitude,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– Creative Hand Team 🧙‍♀️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
