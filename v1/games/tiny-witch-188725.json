  {
   "id": "tiny-witch-188725@1.0.2",
   "gameId": "tiny-witch-188725",
   "displayName": "Hotfix 1.0.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-10-05T17:18:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello magical beings! 🔮",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚒️ Improvement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The lighting torch radius is returning to 100% when you click to restart it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It has been added to reset the level, so it comes back at the beginning of the day.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It has been added so that it returns to the world map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Small improvement to the world map artwork.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An exclusive music track has been created for the world map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "25% increase in the little witch's speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've increased the time of the challenge mode phase and decreased the goal for day 7.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We increased the time of impatient customers by 20%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We increased the flight time a little and agile.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👾 Bugfix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The lighting torch radius is returning to 100% when you click to restart it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixing the oChest crash problem that some users were experiencing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixing the SteamDeck touch problem",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "That's it for now folks, keep following us for more news.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Best Regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Creative Hand team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
