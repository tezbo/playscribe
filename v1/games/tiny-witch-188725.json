  {
   "id": "tiny-witch-188725@1.1.2",
   "gameId": "tiny-witch-188725",
   "displayName": "Update 1.1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-12T14:48:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello magical beings,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👾 Bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed progression issues in Challenge Mode: Completing the fourth store in Challenge Mode now correctly unlocks the corresponding achievement. The game no longer shows the “You’ve unlocked Challenge Mode!” message erroneously.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved high score tracking errors: The game now correctly registers and saves high scores when finishing a store, both in Casual and Challenge modes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Save system improvements: Addressed a conflict where saves from Challenge Mode and Casual Mode could interfere with each other. Progress in each mode is now stored independently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed broken modal in Challenge Mode: The “Continue or Restart” modal now properly displays the translated text. There are no longer raw keys like challengeStore.continueOrRestart!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "ESC key no longer forces unwanted restarts: Pressing ESC in the “Continue or Restart” modal now closes the window instead of deleting your progress. Your runs are safe! 💾",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⸻",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re continuing to polish the game and address your reports, so keep sharing your magical findings with us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With gratitude,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– Creative Hand Team 🪄",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
