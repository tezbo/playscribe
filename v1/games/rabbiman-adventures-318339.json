 "releases": [
  {
   "id": "rabbiman-adventures-318339@major-2026-10-28",
   "gameId": "rabbiman-adventures-318339",
   "displayName": "Big update: tutorials, skip intro and achievements",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-28T14:00:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The first big update since June 2025. The first level now teaches the controls, the intro can be skipped, achievements save to Steam, and many fixes for levels, camera, graphics and sound.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Tutorial and controls",
     "items": [
      {
       "text": "New hints and tutorial videos on the first level: running, jumping, the hat, teleporting and using objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The intro can now be skipped entirely (with confirmation).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Menu buttons no longer lose focus with a gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Control hints now switch correctly between gamepad and mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Easier level selection in the Secret Room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay fixes",
     "items": [
      {
       "text": "Yasha now moves smoothly along ropes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed collisions while carrying objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Repeated slow effects no longer linger after they end.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed collecting sparks and other items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The interact button now works on lifts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cutscenes now start and end correctly when loading or changing levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Camera fixes, including Hanukkah level 4.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed gear rotation, the crown in the Secret Room and missing collisions on one of its levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Achievements and interface",
     "items": [
      {
       "text": "Earned achievements now save to Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The achievement book now updates correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed reward windows and their effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The default hat no longer has to be bought again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Graphics and sound",
     "items": [
      {
       "text": "Fixed shadows, text outlines and some visual effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed dissolve effects and rot zones.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Sound now pauses when the game window loses focus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reworked resource loading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Game speed no longer depends on frame rate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "עדכון גדול: הדרכה, דילוג על הפתיחה והישגים",
     "items": [
      {
       "text": "העדכון הגדול הראשון מאז יוני 2025. בשלב הראשון יש עכשיו הדרכה, אפשר לדלג על הפתיחה, ההישגים נשמרים ב-Steam ותוקנו באגים רבים בשלבים, במצלמה, בגרפיקה ובסאונד.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "הדרכה ושליטה",
     "items": [
      {
       "text": "בשלב הראשון נוספו רמזים וסרטוני הדרכה: ריצה, קפיצה, הכובע, טלפורטציה ושימוש בחפצים.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "אפשר לדלג על הפתיחה כולה (עם אישור).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "הסימון של כפתורי התפריט כבר לא נעלם במשחק עם בקר.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "רמזי השליטה מתחלפים נכון במעבר מבקר לעכבר.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "קל יותר לבחור שלבים בחדר הסוד.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "תיקונים במשחק",
     "items": [
      {
       "text": "יאשה נע בצורה חלקה לאורך הכבל.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "תוקנו התנגשויות עם הסביבה בזמן נשיאת חפצים.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "אפקטים חוזרים של האטה כבר לא נשארים אחרי שהם נגמרים.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "תוקן איסוף הניצוצות ופריטים אחרים.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "כפתור הפעולה זמין שוב במעליות.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "סצנות הביניים מתחילות ונגמרות נכון בטעינה ובמעבר בין שלבים.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "תוקנה המצלמה, כולל בשלב הרביעי של חנוכה.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "תוקנו סיבוב גלגלי השיניים, הכתר בחדר הסוד והתנגשויות חסרות באחד השלבים שלו.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "הישגים וממשק",
     "items": [
      {
       "text": "הישגים שהושגו נשמרים עכשיו ב-Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ספר ההישגים מתעדכן נכון.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "תוקנו חלונות הפרסים והאפקטים שלהם.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "את הכובע הרגיל כבר לא צריך לקנות שוב.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "גרפיקה וסאונד",
     "items": [
      {
       "text": "תוקנו צללים, קווי המתאר של הטקסט וחלק מהאפקטים החזותיים.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "תוקנו אפקטי ההתמוססות של עצמים ואזורי הריקבון.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "הסאונד נעצר כשחלון המשחק לא בפוקוס.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "טעינת המשאבים נבנתה מחדש.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "מהירות המשחק כבר לא תלויה בקצב הפריימים.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
