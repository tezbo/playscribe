  {
   "id": "dreaming-sarah-8702@1.3",
   "gameId": "dreaming-sarah-8702",
   "displayName": "Update 1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2016-11-07T20:29:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have pushed a new update for Dreaming Sarah. Here's a quick list of what has been fixed:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "OSX support fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Linux support fixes",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Linux fullscreen fix, should work just fine now",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
