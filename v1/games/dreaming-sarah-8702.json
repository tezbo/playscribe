  {
   "id": "dreaming-sarah-8702@1.5",
   "gameId": "dreaming-sarah-8702",
   "displayName": "Update 1.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2017-05-16T17:15:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Recently it has come to my attention that the older version of the game had something wrong with it where some antiviruses picked up a false detection (bitlocker mostly).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I'm truly sorry about this, I have now idea how that happened. I've updated the game with the newest version of NWjs and tested with bitlocker, so it seems to be fine now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I've also fixed a couple issues I found with the game. If you find anything else please let me know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
