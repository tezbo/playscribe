 "releases": [
  {
   "id": "dreaming-sarah-8702@1.9.1",
   "gameId": "dreaming-sarah-8702",
   "displayName": "Update 1.9.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-09-28T13:25:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update fixes some bugs you've reported on the last announcement. ːsarahː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's a list",
     "items": [
      {
       "text": "Fixed a issue where changing the volume for the music wouldn't affect it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the fish effect would cause multiple item screens to show up due to it's rotation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix an issue where the fish effect would unequip after equipping it for the first time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hat kid in the forest would sometimes say \"0\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with the club girl event",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tried to fix a memory leak that would cause framerate drops",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For this last one, I've also set 60fps to be the minimum framerate - this means that if the fps drops below 60, the game will slowdown instead of having the awful frameskipping, which could also cause bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please let me know what you think, and if you have any other issues!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
