  {
   "id": "3d-don-t-die-mr-robot-219510@major-2024-10-06",
   "gameId": "3d-don-t-die-mr-robot-219510",
   "displayName": "Leaderboards update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-06T17:35:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Who likes leaderboards? We do! Since gazing mesmerised at the Commando high score table in a pub in Malvern and listening to that music that just says \"enter your name please\" - leaderboards have been an integral part of how we see the form and function of videogames.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3DDMR lends itself to leaderboards so easily because of its endurance based numerical score nature. But not every leaderboard is score!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this update every game mode, every coin collected - chances are they have their own leaderboard.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
