  },
  {
   "id": "islets-180154@1.002",
   "gameId": "islets-180154",
   "displayName": "Patch 1.002",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-08-30T17:58:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've been hard at work on putting together a patch to address many issues we've seen folks encountering during this first week. You can read the full patch notes below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed a bug that occurs when pausing from a teleporter screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed a bug where enemies in a specific deathmatch could fall out of the room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed a rare bug that would corrupt save files, and repairs previously-corrupted save files. (Note: Files corrupted by exiting mid-save are not included in this)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed getting stuck in moving platforms. Also prevented a couple harmless glitches that occur when interrupting a moving platforms movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added missing icons on the map (Magnet on Eastwright Island, and Save shrine in Spirits Landing)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-In speedrun mode, double-tapping climb on a wall imitates button mashing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed screenshake still occuring during slam attack, even when turned off",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Allows screenshots with F12",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Prevents softlock when exiting during the island-connect cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
