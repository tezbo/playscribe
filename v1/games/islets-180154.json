 "releases": [
  {
   "id": "islets-180154@1.003",
   "gameId": "islets-180154",
   "displayName": "Patch 1.003",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-09-20T19:48:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The response continues to be really exceptional and we're truly delighted to see so many folks enjoying the game. We have another small update ready for you all with a variety of fixes and changes. You can see the full list below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Added in Cloud Saves! (In order to add an existing save to the cloud, you must load the save file, and save again. Be aware that now if you have 2 different save files on the same slot on different devices, this could overwrite them)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Fixed a softlock that occurs when dying while collecting an upgrade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Game backs up save files when successfully loading from the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Fixed a bug that occurred when you saved and loaded on the same frame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Fixed a bug where dying immediately after beating a timed death match softlocks you out of receiving the upgrade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "6. Water splashes now won't move through walls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "7. Fixed a missing wall in Tomb Ruins",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "8. Speedrun timer ends at a different point by request",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
