     "items": [
      {
       "text": "Build 1.0.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cam 2005 - Fixed a bug on the completion screen where the Minibus would also shake and fail the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Notes for Previous Build 1.0.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sylvie 1989 - Fixed a bug where objects could be moved inside the trunk, and then prevent it from opening.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sylvie 1989 - Objects cannot be targeted while the trunk is closed anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sylvie 2015 - Fixed the Level Description and Screenshot: Sorry, there is no trailer, only a family car!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sylvie 2015 - Fixed an issue where players could get stuck under the car floor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cam 2016 - Fixed the 3rd star challenge not getting verified.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you completed this challenge, the 3rd star should unlock if you launch the level again. Select the “Continue” or “Review” button, do not select “Retry”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Cloud Save - Fixed a save issue occurring to players launching One Move Away on 2 different machines",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If this issue occurred to you, you can retrieve your local save by following these steps!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
