  {
   "id": "one-move-away-325581@1.0.6",
   "gameId": "one-move-away-325581",
   "displayName": "Patch 1.0.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-11T09:52:53.000Z",
   "notes": [
    {
     "title": "Build 1.0.6",
     "items": [
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]A small update today with some important hotfixes, especially for the most difficult achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfixes and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ahmed 1999 - 'Optimizer' achievement requirements are clearer inside the level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restricted area between the back of the car and the front of the trailer is now active for all stars and a grid is visible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ahmed 1999 - The manhole collider close to the trailer has also been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sylvie 2015 - Bicycle colliders updated + seat brought down + pedals removed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ahmed 2016 - Fixed the TV colliders",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Button ‘Default Values’ in General option menu now set Bumpy Ride to Disabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The next major update will aim to address the difficulty management issues that many of you have reported. Thank you for your continued support and feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We remain committed to improving One Move Away.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Ramage Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
