  {
   "id": "rollercoaster-tycoon-classic-26589@post-2025-04-07",
   "gameId": "rollercoaster-tycoon-classic-26589",
   "displayName": "Patch Notes for 4/5/2025",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-04-07T14:41:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This version addresses highly requested fan feedback and improvements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New players should see the initial size of the UI display at a larger size, making it easier to see on higher resolution displays.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Control UI scaling with convenient hotkeys",
     "items": [
      {
       "text": "SHIFT + U: increase UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "CONTROL + U: Decrease UI: Please send any support requests to support@atari.com. Thanks for playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
