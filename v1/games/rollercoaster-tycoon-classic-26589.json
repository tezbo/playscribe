   "id": "rollercoaster-tycoon-classic-26589@post-2025-06-24",
   "gameId": "rollercoaster-tycoon-classic-26589",
   "displayName": "Patch Notes for June 24, 2025 (macOS)",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-24T16:53:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The following updates were made to the macOS version of the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue causing clicks not to register on some devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various issues related to launching the game on a device with multiple monitors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some issues with the game rendering full screen on some devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue causing users unable to use the Space Bar when naming things.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing hover tooltips.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
