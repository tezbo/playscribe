   "announcedAt": "2024-07-23T13:59:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fellow gamers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BEFORE I GO got an incredible boost during the Next Fest! Thanks you all for playing, for the wishlists, and the support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I can't be more happy for all the demo feedback I received. And as a solo developer, this is priceless to me.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, I released the 1.0.3 demo update. Alongside minor improvements, this update addresses some of the most recurrent feedback from players and brings an overall better experience to the first hour of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Major changes",
     "items": [
      {
       "text": "Temple Elevation Relic moved so it can't be missable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an Elevation Relic in the Soma Forest, earlier in the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fast travel between Elevation Relics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stasis ability radically buffed (now completely stops enemies and projectiles)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Basic navigation tutorial shortened",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new collectibles: Fireflies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New map feature : markers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Keyboard rebinding options",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
