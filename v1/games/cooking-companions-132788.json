  {
   "id": "cooking-companions-132788@major-2022-06-02",
   "gameId": "cooking-companions-132788",
   "displayName": "Big Free Update Trailer!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-02T03:00:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Happy to announce that Cooking Companions is receiving a FREE, MEATY update this summer!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With over an hour of additional content and bug fixes, we can't wait to have old and new fans experience this gigantic addition to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Key features",
     "items": [
      {
       "text": "-More nightmares: Nightmare Mode is getting more fleshed out, with additional scares and secrets to discover!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Returning characters, both expected and unexpected!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-More horror content!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-More answers to existing questions!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-More clues to chew on!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-New CG, BG, and sprite artwork!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Fixes to bugs, grammar, and spelling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Don't miss the release announcement!",
     "items": [
      {
       "text": "Subscribe to our YouTube channel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TikTok (contains spoilers!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "One last note: thanks for everyone that has played, streamed, or watched Cooking Companions. We never expected this reception and owe all of this to YOU. THANK YOU!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Deer Dream Studios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
