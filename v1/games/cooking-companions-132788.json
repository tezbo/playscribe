  {
   "id": "cooking-companions-132788@2.0",
   "gameId": "cooking-companions-132788",
   "displayName": "Update 2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-26T11:56:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are thrilled to announce that Cooking Companions has received a HUGE update! Patch notes below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Be sure to wishlist/check out the sequel, Dread Weight, releasing in THREE DAYS on Monday July 29th! Leave a review on release day if you want to help support development.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "-The entire script for Cooking Companions has been revised! Read more about it here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-New secrets have been added to the game: see if you can find them all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-A new animated ghost scene has been added!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Various bugs have been fixed!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Lots o' Assets!",
     "items": [
      {
       "text": "Making a TikTok or something Cooking Companions related? You now have access to most of the sprites and artwork! Just navigate to your Steam files to find the folder. Just use #CookingCompanions or #DreadWeight. We'll promote the best fan made content!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For updates: check out TikTok,the site or follow us on Twitter (and Threads!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Missing some endings? Check them all out on our YouTube channel. Like and subscribe to help out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have a great day everyone: enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Deer Dream Studios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
