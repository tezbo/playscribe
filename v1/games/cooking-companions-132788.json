   "id": "cooking-companions-132788@major-2025-04-30",
   "gameId": "cooking-companions-132788",
   "displayName": "HUGE Console Release Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-30T16:44:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Cooking Companions is OUT on Nintendo Switch/PS4/PS5/Xbox! With the help of Serenity Forge, all owners of Cooking Companions on Steam will be receiving this gigantic update for free as our way of saying \"thank you\" for the incredible years of support. The game has also been fully translated into Spanish, Chinese (both traditional and simplified), Japanese, Korean, and Brazilian Portuguese!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "[img src=\"https://images.squarespace-cdn.com/content/v1/632240155e019f468cb3004a/1659643e-3419-4faa-92f8-d569991d7c27/Cooking+Companions+PS5.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    },
    {
     "title": "What's New?",
     "items": [
      {
       "text": "-15 new, fully animated, cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Some improvements to the gameplay (and rewards!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Typos, glitches, grammatical errors are FIXED!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Fully translated into Spanish, Chinese (both traditional and simplified), Japanese, Korean, and Brazilian Portuguese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-A few secrets to discover!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Wishlist and Preorder!",
     "items": [
      {
       "text": "If you want to support the game coming to consoles: please grab the game using the links below. Nintendo Switch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PS4/PS5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Xbox",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Special physical edition for PS5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "[img src=\"https://images.squarespace-cdn.com/content/v1/632240155e019f468cb3004a/3a461b2e-fcdd-42a2-9b11-7d9e0071e850/Cooking+Companions+Console+Announcement.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This wouldn't have been possible without all of you: THANKS FOR PLAYING and ENJOY!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Deer Dream Studios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
