  {
   "id": "bottle-pilgrim-redux-254088@major-2020-06-19",
   "gameId": "bottle-pilgrim-redux-254088",
   "displayName": "Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-06-19T16:02:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been almost 3 years since the release of Bottle: Pilgrim... and today I have updated it, making it easier to find your way around the snow level!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With the additional hint of footprints in the snow and ice, you won't get so lost locating the branches in order to progress. So anyone who's been held back by that particular level can now complete the story and see how it resolves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tonguç",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
