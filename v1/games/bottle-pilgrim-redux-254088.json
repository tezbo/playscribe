  {
   "id": "bottle-pilgrim-redux-254088@major-2020-11-07",
   "gameId": "bottle-pilgrim-redux-254088",
   "displayName": "Redux Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-11-07T08:53:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have been working for a long time on Bottle: Pilgrim's enhancements. Today I have released a major update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game looks, sounds, and plays much better than the original version now. I won't write them down one by one here; if you want to know more about the changes, head over to the link below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is a free major update of one of your favorite games. Even its name has changed, now it is Bottle: Pilgrim Redux.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If there was something weak for you in the previous version, why don't you give it another try now? It's much better in many aspects with the new update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With love and respect,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tonguç",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
