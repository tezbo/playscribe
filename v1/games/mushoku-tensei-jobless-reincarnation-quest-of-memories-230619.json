   "announcedAt": "2024-07-24T04:19:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new patch for \"Mushoku Tensei: Jobless Reincarnation Quest of Memories\" (available from June 20, 2024) has been released as of July 25, 2024, 1:00 UTC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The updates included in this patch are as below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■What’s new",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the enhancement effect is not reflected after enhancing an equipped accessory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the screen turns dark and freezes after accepting the quest “Forest Cartography”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Changed the ESC key function for the Steam version so that pressing it does not close the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjustment to the required material quantity for the skill “Second Wind”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ “Serpent King Scale” will be available for purchase in Millishion after certain requirements are met.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Miscellaneous bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"Mushoku Tensei: Jobless Reincarnation Quest of Memories\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PlayStation 4（Ver.1.05）/ PlayStation 5（Ver.1.05）",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Nintendo Switch™（Ver.1.05）/ Steam（Ver.1.05）",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We apologize for any inconveniences caused, and we hope you continue to enjoy playing \"Mushoku Tensei: Jobless Reincarnation Quest of Memories\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
