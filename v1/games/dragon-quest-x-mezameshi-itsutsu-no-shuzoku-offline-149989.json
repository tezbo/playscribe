  {
   "id": "dragon-quest-x-mezameshi-itsutsu-no-shuzoku-offline-149989@post-2022-10-27",
   "gameId": "dragon-quest-x-mezameshi-itsutsu-no-shuzoku-offline-149989",
   "displayName": "パッチ配信についてのお知らせ",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-10-27T16:40:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "アップデート(更新データ)を配信いたしました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "〇パッチの配信時期",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2022年10月28日（金）",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■システム関連アップデート",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "以下の機能改善を行いました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "カメラの回転速度の向上。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "キラキラを取得することができる範囲の拡大。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■不具合の修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "以下の不具合が修正されています。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "そうびぶくろが101個以上あるセーブデータで「プレゼントを受け取る」にてプレゼントを受け取ろうとすると、「所持品数上限」に引っかかり全てのプレゼントを受け取ることができなくなる。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "「ザオ」を使用した際、蘇生が成功してもキャラクターが倒れたままの状態になる場合がある。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "「スロット」にて、「メタルスピン」が終了するタイミングで進行不可となる場合がある。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "旅人バザーにてモンスタードロップでも入手できるレシピ帳が販売されている状態で、ドロップしたレシピ帳を覚えてから旅人バザーのグレーアウトしているレシピ帳を選択すると「既に覚えている」メッセージ表示後に進行不可になる。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "一部のムービーで画質が粗く表示されている。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "その他、多数の不具合が修正されています。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
