  },
  {
   "id": "giant-machines-2017-24684@1.1.1",
   "gameId": "giant-machines-2017-24684",
   "displayName": "Patch 1.1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2016-10-29T18:18:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Sorry that you had to wait so long. Below you may find changes that come with this patch and should have been implemented in release version in the first place.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "1. Options menu has additional functionality",
     "items": [
      {
       "text": "1.a) Graphics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player is now able to change various settings which should help with suiting GM17 experience to individual hardware: 1.b) Controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ability to change keys assignment when keyboard and mouse is used",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Ability to change buttons assignment when gamepad is used",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Supported controllers: Xbox 360, Xbox One, PlayStation 4, Steam",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "Experimentally we support wheel controller Logitech G29 Driving Force and only in Driver Mode (Operator Mode is blank user needs to define buttons by himself); Unfortunately Driving Force Shifter is not supported",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There is very high probability that other gamepad and wheel controllers will work too",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "2. Bug fixes",
     "items": [
      {
       "text": "2.a) Texture quality was set to highest no matter what graphic quality was chosen. This caused crash on many systems after finishing intro and entering main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "2.b) Some other minor bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
