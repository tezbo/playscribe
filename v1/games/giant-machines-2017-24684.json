 "releases": [
  {
   "id": "giant-machines-2017-24684@1.1.2",
   "gameId": "giant-machines-2017-24684",
   "displayName": "Patch 1.1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2016-11-16T14:29:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Giant Machines 2017 experience is now available for two additional platforms: Linux and Mac OS X. We have also added some new, cool features.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "1. New platforms",
     "items": [
      {
       "text": "1.a) Linux",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Tested on SteamOS GNU/Linux 2.0 \"Brewmaster\"",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Tested on Ubuntu 16.04: 1.b) Mac OS X",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tested on 10.12.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Game requires dedicated graphic card - it was tested on iMac (Retina 5K, 27-inch, Late 2015) with AMD Radeon R9 M390 2048 MB",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If anyone will see performance issues we encourage to decrease Texture Quality in first place and then decrease Antialiasing multiplier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We do not support Magic Mouse, because one of our machine needs pressing left and right buttons together, which is hard to support with that kind of hardware",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "For Xbox 360 Controller support you need to download drivers which may be found here: https://github.com/360Controller/360Controller/releases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    },
    {
     "title": "2. Features",
     "items": [
      {
       "text": "2.a) Custom Radio – support for *.ogg files on Linux / Mac / Windows with additional *.mp3 support on Windows; To make it work you need to create “RadioSongs” folder where game main executable file is located and then put your audio files in “RadioSongs” folder",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "2.b) Better sound / volume control – now it is divided into four categories: Master, Effects, Dialogue, Radio which may be controller separately",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "3. Bug fixes",
     "items": [
      {
       "text": "3.a) Some other minor bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
