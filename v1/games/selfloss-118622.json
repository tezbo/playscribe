  {
   "id": "selfloss-118622@post-2024-09-23",
   "gameId": "selfloss-118622",
   "displayName": "Patch Notes 1 - Ocean Level + Chapter Select Improvements",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-09-23T10:03:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new patch is now live for Selfloss, which offers key improvements and bug fixes to improve your experience of the Slavic adventure!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES #1",
     "items": [
      {
       "text": "Ocean Level Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Ocean level has been made slightly easier with improved rock placement, ensuring smoother navigation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lich Boss Battle Enhancements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Lich boss fight in Chapter 3 has been rebalanced to offer a fairer challenge. Additionally, the miasma pimples are now placed more accessibly, making them easier to reach.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chapter Select Screen Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Detailed stats have been added to the Chapter Select screen, allowing you to see how many runic stones or scrolls were missed in each chapter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Critical Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several critical game-locking bugs have been fixed, with most issues addressed in previous undocumented patches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Miscellaneous Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various minor improvements and bug fixes have been implemented for a smoother gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to leave your feedback of the game in the Discussions Forums or via Reviews - we'd love to hear what you thought about the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For any Bug Reporting, please feel free to leave a detailed account of your bug in the Bug Reporting Sub-Forum here: https://steamcommunity.com/app/1086620/discussions/1/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you again for your support for Selfloss! Don't forget, both the full game and the original OST soundtrack are available now on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
