  {
   "id": "selfloss-118622@post-2024-10-19",
   "gameId": "selfloss-118622",
   "displayName": "Patch Notes 2 - Control improvements + character speed increased",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-19T15:18:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new patch is now live for Selfloss!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PATCH NOTES #2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1) Control Improvements: The staff is now slightly more responsive, and character rotation speed has been increased for a smoother experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2) Balance Tweaks: The protagonist's movement speed has been increased, with animation speeds adjusted accordingly. Attack animations are now faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3) Rebalanced Hazards: Some hazards, such as miasma shrooms, have been slightly rebalanced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4) Bug Fixes: Rare soft-locking issues in Chapters 1 and 4 have been resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5) Performance Enhancements: Minor improvements have been made to overall performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
