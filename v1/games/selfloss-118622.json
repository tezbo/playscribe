  {
   "id": "selfloss-118622@post-2025-05-12",
   "gameId": "selfloss-118622",
   "displayName": "Patch Notes 3 - Trading Cards, Movement Improvement & More!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-05-12T13:55:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 3 for Selfloss is now live, bringing some tweaks and additions to help smooth out your journey through Kazimir’s world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🃏 Steam Trading Cards Are Now Live!",
     "items": [
      {
       "text": "You can now earn Trading Cards, badges, emoticons, and profile backgrounds as you play. Show off your Selfloss style on your Steam profile!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🚶 Character Movement Improvements",
     "items": [
      {
       "text": "Kazimir now moves with improved responsiveness and increased movement speed. These changes aim to give players more precise control and make traversing the world feel smoother and more efficient.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🚤 Boat Handling Enhancements",
     "items": [
      {
       "text": "Sailing is a vital part of the experience, and we’ve made adjustments to improve boat movement and handling. Whether you’re crossing peaceful waters or navigating stormy shores, your boat should now feel more intuitive and responsive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🧱 Small Collision Fixes",
     "items": [
      {
       "text": "A few minor collision issues have been resolved to keep the world flowing seamlessly as you explore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, thank you for your feedback and support! These updates are part of our continued efforts to make Selfloss the most immersive and meaningful experience it can be.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "💙 Stay tuned - more updates to come!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "– The Selfloss Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
