   "announcedAt": "2024-10-16T18:58:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve got an exciting update for Wrath of Cobra packed with fixes and quality-of-life improvements. Check out what's been enhanced in your mission to bring down Cobra!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Control Rebinding: Your custom control settings will now save correctly, so you won’t need to reconfigure them after each session.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cutscene Skipping: Accidental skipping of cutscenes has been resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dash Grabs: Dashing into grabbable objects or enemies will no longer cancel your dash attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Health Pickup While Armed: You can now pick up health items without needing to drop your weapon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boss Movement Speed: Bosses will no longer slow down mid-fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sprite Sheet Optimization: We've optimized the sprite sheet to prevent any visual artifacting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quality of Life Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Higher Difficulty Tweaks: Harder difficulties are now harder.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Duke Boss Fight: Dark Duke has undergone some improvements to make his fight more engaging and less spammy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More Floppies: Especially from minibosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ferret AI Improvements: The Ferret enemies are a bit smarter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crimson Twins Boss Fight: The fight against the Crimson Twins has been refined for a more satisfying experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Timber AI Enhancements: better able to leave the battlefield.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep the feedback coming, and stay tuned for more updates as we continue to improve the game. YO JOE!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
