  {
   "id": "gas-guzzlers-extreme-8472@1.07",
   "gameId": "gas-guzzlers-extreme-8472",
   "displayName": "Update 1.07",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2015-12-21T14:12:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The new 1.07 Gas Guzzlers Extreme patch is available now !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As a reminder, please don't forget to update and restart all servers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The full list of bug fixes and features implemented in this patch is:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new Christmas map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Christmas stickers for all cars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug with the Katyusha model appearing bigger than usual",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the game crashed whilst in the zombie game mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with custom team car paint in multiplayer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The first wave can be specified in multiplayer zombie modes for the dedicated server launcher",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
