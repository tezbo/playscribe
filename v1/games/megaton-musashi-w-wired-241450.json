  {
   "id": "megaton-musashi-w-wired-241450@3.1.0",
   "gameId": "megaton-musashi-w-wired-241450",
   "displayName": "Update 3.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-25T11:54:17.000Z",
   "notes": [
    {
     "title": "【Update Release date decided!】",
     "items": [
      {
       "text": "The release date for the \"ver.3.1.0\" update has been decided at 1:00 AM 6/27 (UTC)!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please check the website for the storage space required for the update and update contents, and wait for the release!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Receive Grendizer in the latest update!",
     "items": [
      {
       "text": "The game's new ver.3.1.0 update allows you to obtain Grendizer's parts and Double Haken weapon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unleash Grendizer's Special Moves, Screw Crusher Punch and Space Thunder, or take down your foes in Spazer Mode!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Addition of Collaboration Rogues in Colosseum Battles",
     "items": [
      {
       "text": "You can get parts for \"Mazinger Z\" and \"Getter Robo\" for the Colosseum battle!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "【Update Thank-You Set 】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Rogue \"Grendizer\" (Rare, Gear Rank 10)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Rogue \"Mazinger Z\" (Common, Gear Rank 1)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "*Including Jet Scrander",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "*Colloseum only",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Rogue \"Getter Robot\" (Common, Gear Rank 1)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "*Colloseum only",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": ",and more",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "※In the Main Menu, go \"Mailbox\" and select \"Check Delivery\" to claim your items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
