  {
   "id": "sudden-strike-5-355088@major-2026-06-18",
   "gameId": "sudden-strike-5-355088",
   "displayName": "Sudden Strike 5 - Quality of Life Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-18T11:21:28.000Z",
   "notes": [
    {
     "title": "Sudden Strike 5 - Quality of Life Update",
     "items": [
      {
       "text": "Generals,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just released Update 1.2 for Sudden Strike 5 on all available platforms. This Update adds the ability to individually remove units from trenches, vehicles and buildings on mouse and keyboard, new tutorial hints in loading screens and new visibility settings, among other adjustments and fixes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The full changelog can be found below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45702302/c5666529a1d34ac55bba59ed58bcc777d1686c5a.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Additions",
     "items": [
      {
       "text": "\\[Mouse & Keyboard only] Added the ability to select infantry units and command them to leave trenches one by one.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "\\[Mouse & Keyboard only] Added the ability to select infantry units and command them to leave vehicles one by one.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "\\[Mouse & Keyboard only] Added the ability to select infantry units and command them to leave buildings one by one.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added new visibility settings allowing players to reduce or completely disable ground marker visibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Extended visibility settings with options to reduce HP bar visibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Extended visibility settings with options to reduce unit silhouette visibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Extended visibility settings with options to reduce unit outline visibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a toggle allowing players to enable or disable infantry scaling when zoomed out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added tutorial hints to loading screens to improve onboarding and gameplay guidance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a loading screen gamepad icon to indicate controller support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced memory usage during gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed several UI issues affecting loading screens and multiplayer menus when large text scaling is enabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where enemy and allied infantry units in a suffering state retained normal line of sight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where snow weather effects were not displayed correctly on PC.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where train units would occasionally teleport under specific circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where ghost units could appear when visibility settings were reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed several issues related to target acquisition and distance checks for bomber aircraft.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where the “You Shall Not Pass” achievement did not unlock correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where the “Steal Division” achievement did not unlock correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved loading screen layout and text presentation when using larger text scaling options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved gamepad navigation and controller support in update-related menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved overall stability on PlayStation 5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "ps5"
       ]
      }
     ]
    }
   ],
