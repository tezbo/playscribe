  {
   "id": "sudden-strike-5-355088@1.3.1",
   "gameId": "sudden-strike-5-355088",
   "displayName": "Hotfix 1.3.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-08-27T12:20:19.000Z",
   "notes": [
    {
     "title": "Sudden Strike 5 - Hotfix 1.3.1 - Changelog",
     "items": [
      {
       "text": "We have just released Hotfix 1.3.1 for Sudden Strike 5 on all available platforms. The Hotfix focuses on resolving several achievement and trophy issues related to the France: Road to Liberation DLC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed two issues with “Aux Armes, Français!”, it should now unlock as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that prevented DLC achievements from unlocking correctly on Xbox and WinStore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Fixed an issue where “French Legion of Honor” was incorrectly unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved the description for several achievements to refer to “vehicles” instead of “units” in order to better describe their actual unlock conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some issues that prevented the “Libération” achievement from unlocking correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
