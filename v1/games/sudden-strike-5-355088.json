  {
   "id": "sudden-strike-5-355088@major-2026-07-15",
   "gameId": "sudden-strike-5-355088",
   "displayName": "Sudden Strike 5 - Co-op Campaign Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-15T12:31:47.000Z",
   "notes": [
    {
     "title": "Sudden Strike 5 - Co-op Campaign Update",
     "items": [
      {
       "text": "Generals,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just released Update 1.3 for Sudden Strike 5 on all available platforms. This Update adds the New “Co-op Campaign” game mode, which lets you experience the full main game campaign together with a friend! The update also includes a new ping feature for co-op and multiplayer as well as other fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The full changelog can be found below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Game mode “Co-op Campaign”",
     "items": [
      {
       "text": "2 Player game mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Players can invite each other via their friendlist and play the three campaigns together. The coop campaign does not support playing across separate platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Progression will be based on the progression of the host.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Both the Host and Client earn rewards and unlock achievements. Only the Host's progress determines which missions and Doctrines are available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "UI & UX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Unit badge visibility is affected by Health Bar Settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Setting Interface settings to “Low” with controller is now easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Feature: Ping System",
     "items": [
      {
       "text": "A new Ping feature has been added to co-op and multiplayer, allowing you to quickly communicate and coordinate with your ally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Gameplay & Mechanics",
     "items": [
      {
       "text": "LCVP Landing crafts are no longer able to deplete fuel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Long Tom can no longer get stuck on Mission “Ruhr Pocket”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The doctrine card effect “For the Motherland!” now has a hotkey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\ Tactical Pause can now be used while selecting a target on consoles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
