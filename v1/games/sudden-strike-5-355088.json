  {
   "id": "sudden-strike-5-355088@1.1",
   "gameId": "sudden-strike-5-355088",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-20T12:26:33.000Z",
   "notes": [
    {
     "title": "Sudden Strike 5 – Update 1.1",
     "items": [
      {
       "text": "Generals,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just released Update 1.1 for Sudden Strike 5 on all available platforms. Update 1.1 focuses on improving overall game stability, multiplayer reliability, and console performance, while also addressing a wide range of gameplay, UI, and localization issues. In addition, several mission balancing adjustments and visual/audio improvements have been implemented to enhance overall player experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The full changelog can be found below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Performance & Stability",
     "items": [
      {
       "text": "General optimisations improving memory usage and stability on consoles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved stability by reducing video memory consumption of vegetation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where console quality settings were not properly set.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Gameplay & Mechanics",
     "items": [
      {
       "text": "Fixed and adjusted mission scoring for the ‘Siege of Budapest’ mission in the Soviet Campaign to allow players to achieve a 3-star rating.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed and adjusted mission scoring for the ‘Siege of Budapest’ mission in the Axis campaign to allow players to achieve a 3-star rating.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in ‘Breakthrough at Borisov’ where the third 173mm artillery cannon could get stuck when reinforcing three units via train simultaneously.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Multiplayer",
     "items": [
      {
       "text": "Improved multiplayer stability and synchronization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed multiplayer desynchronization issues in both Player vs Player and Player vs AI scenarios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed flag lock mechanics and related command handling issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the multiplayer session could freeze on ‘Rocky Ridge’.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Skirmish",
     "items": [
      {
       "text": "Fixed team switching issues in skirmish mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Tutorial & Onboarding",
     "items": [
      {
       "text": "Added new tutorial images to the tutorial menu to improve clarity and guidance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a gap on the onboarding screen (German version).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved gamepad navigation on onboarding screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "UI & UX",
     "items": [
      {
       "text": "Improved general UI consistency and stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a display issue with the recovery unit badge icon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where duplicate buttons would appear on purchase panels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Effects & Animation",
     "items": [
      {
       "text": "Fixed incorrect impact sound effects for Machine Gun Nests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added new visual effects for Anti Air Cannons when hitting objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added failsafe for character death states to prevent stuck animations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Achievements",
     "items": [
      {
       "text": "\\[PC only] Fixed the “Steal Division” achievement counter",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "\\[PC only] Fixed the “You shall not pass” achievement counter",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Localisation",
     "items": [
      {
       "text": "Fixed various localisation issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
