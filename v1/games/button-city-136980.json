  {
   "id": "button-city-136980@1.0.5",
   "gameId": "button-city-136980",
   "displayName": "Update 1.0.5",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-07-10T17:41:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Button City 1.0.5 is out now on Steam and with it we bring a number fixes and updates to controller input.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a softlock on day one after joining Fluff Squad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a softlock during day 4 after hanging out with Lavender.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a softlock during day 4 after getting the trenchcoat and trying to speak with Sorrel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made OpenGL the default on mac devices due to a rendering issue. This can be changed by running with -force-metal command in the command line arguments in Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the Xbox One and Xbox Series X|S controller layout for macOS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Fixed UI being outside screen safe zone",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated controller input so it's easier to select things like doors and other interactables.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Wishlist button to titlescreen for Button City: Soccer Days.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Built macOS version to support Apple Silicon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you enjoy Button City!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you haven't yet please wishlist Button City: Soccer Days",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
