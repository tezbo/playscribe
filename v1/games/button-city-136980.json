  {
   "id": "button-city-136980@1.0.2.1",
   "gameId": "button-city-136980",
   "displayName": "Patch 1.0.2.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-26T20:45:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixes an issue where players who received the motor in gameplay got it taken away. It will now correct your save file on start. This will fix the issue of not having the motor Fluff Buff in arcade games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
