  {
   "id": "button-city-136980@1.0.2",
   "gameId": "button-city-136980",
   "displayName": "Update 1.0.2",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-08-23T19:18:25.000Z",
   "notes": [
    {
     "title": "Button City version 1.0.2",
     "items": [
      {
       "text": "This patch addresses bugs and stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased Fennel’s speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Speech bubble now hides correctly when talking to Valarian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix to music venue causing a black screen soft lock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Camera no longer jitters when returning from rEVolution Racer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restructured Yes No Maybe quest to fix issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Yes No Maybe now correctly gives item, you can return to them if you didn’t receive the item.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed sequence break on day 1 when talking to Sorrel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Sorrel now does challenge when challenging her",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tuff Fluff challenges no longer cause black screen and soft lock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chive cinematic no longer resets on day 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The pay phone no longer causes a broken cinematic and sequence break on day 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Goba Academy now resets correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Motor is no longer removed during story progression so players can use the Fluff Buff in arcade games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prismabeats no longer stops audio in the main game when losing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix to Mint disappearing during Prismabeats quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "More robust checking on file saving and loading",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix to Gobabots AI taking over for player if they restart during a story sequence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Wrestling quest fix to characters not showing up when starting with Lavender in the scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made more robust checks for climatic Gobabot battle when Golden berries appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sage now correctly talks during the chase sequence on Day 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dog bots no are no longer talkable during chase sequence to avoid issue of player movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix to Mechamelon and other heavy Gobabots hurtboxes not registering.: If you have any issues please either post them on the Steam Community Page https://steamcommunity.com/app/1273750/discussions/0/ or at our Support page https://www.buttoncitygame.com/support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
