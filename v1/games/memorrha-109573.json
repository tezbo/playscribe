  {
   "id": "memorrha-109573@1.3",
   "gameId": "memorrha-109573",
   "displayName": "Update 1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-10-27T19:03:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Memorrhians,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we present Update V1.3 and will continue on improving the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Furthermore the regional pricing for some countries were adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patchnotes",
     "items": [
      {
       "text": "Added a save checkpoint after the puzzles in the last area of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug that would let the statue carts leave the rails",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the clipping plane of the camera to fix some visual glitches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a bug that would prevent a cart in the underground cave from starting in rare cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a terrain glitch that partly covered a cart controller interface",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some improvements regarding the activation and movement of the excavator",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Deleted some floating particles in the underground cave",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed colliders on cart entry points",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that would players allow to place more than one cart on a single cart track",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bugs regarding some achievements that would prevent them from being triggered",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes regarding the secret minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some improvements regarding the rail system and cart movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Known issues",
     "items": [
      {
       "text": "There are still some visual issues with the rail system that causes cart jumping in specific cases, we are working hard on fixing this problem and will continue updating!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
