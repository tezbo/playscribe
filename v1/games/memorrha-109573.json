  {
   "id": "memorrha-109573@1.6.4",
   "gameId": "memorrha-109573",
   "displayName": "Update 1.6.4",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-05-02T10:03:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have addressed a bug that was preventing the process engine from processing crystals in certain situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have fixed several minor loading issues with the rails that could cause bugs to occur. This was due to certain content being loaded too quickly on systems with strong CPUs and SSDs, resulting in problems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
