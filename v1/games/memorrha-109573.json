  {
   "id": "memorrha-109573@1.01",
   "gameId": "memorrha-109573",
   "displayName": "Update 1.01",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2019-09-29T17:59:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1.01 Hotfix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
