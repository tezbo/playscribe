   "notes": [
    {
     "title": "HOTFIX: Version: 1.0.2.2",
     "items": [
      {
       "text": "Fixed an issue where the 'Enter' key wasn't functioning properly during dialogue choices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased the deadzone for navigation sticks when flying the ship in space.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Hey everyone,",
     "items": [
      {
       "text": "We’ve got exciting news to share! Beyond Galaxyland has officially been Steam Deck Verified, and we’ve just rolled out a new patch to improve the gameplay experience. Whether you’re exploring on your Steam Deck at home, or enjoying the game elsewhere, these updates are designed to enhance your adventure.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Steam Deck Verified!",
     "items": [
      {
       "text": "We’re thrilled to announce that Beyond Galaxyland is now fully Steam Deck Verified! After resolving a minor UI issue, the game has officially earned this status, meaning you can now experience smooth and seamless gameplay on your Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Enjoy the Full Experience on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "With responsive controls and great performance, Beyond Galaxyland plays beautifully on Steam Deck, whether you're at home or on the go. We’re also proud to share that the game received a 5/5 star review from Steam Deck HQ for its Deck performance! Check out their full review here.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Share Your Steam Deck Adventure",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We’d love to see your Beyond Galaxyland moments! Share your screenshots or gameplay stories with us on social media or the Steam Discussion forums.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
