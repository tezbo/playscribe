  {
   "id": "cookie-clicker-3241@2.043",
   "gameId": "cookie-clicker-3241",
   "displayName": "Update 2.043",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-12-18T00:50:46.000Z",
   "notes": [
    {
     "title": "Full changelog in this update",
     "items": [
      {
       "text": "added Steam Workshop support (lets you install mods and upload your own)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "added Korean language support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added back \"short numbers\" option for non-english languages (uses english terms for the time being)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added tooltips on achievement notifications",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added Discord rich presence support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Christmas content update coming soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This should be the last \"technical\" update focused on Steam-specific features. Future updates will revolve around new content and new gameplay features.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We're excited to see what you folks come up with using the Workshop. Later on, we may refine the modding tools further as the community's needs become clearer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Orteil",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
