  {
   "id": "cookie-clicker-3241@patch-2025-02-04",
   "gameId": "cookie-clicker-3241",
   "displayName": "Language patch!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-04T22:59:53.000Z",
   "notes": [
    {
     "title": "Language update",
     "items": [
      {
       "text": "Patch 2.053 adds support for the Norwegian and Danish languages on PC and Mac.: This brings the game's language selection to 15 languages!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Idler Fest",
     "items": [
      {
       "text": "Steam is currently hosting Idler Fest, celebrating everything idle and incremental!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're often cited as one of the games that popularized the genre, first launching for web browsers in 2013. As such, we couldn't afford to miss out on celebrating with everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Cookie Clicker is 66% off on Steam until February 10th!",
     "items": [
      {
       "text": "That's a historical low! It's the perfect time to gift Cookie Clicker to a friend or foe who could stand to see their productivity plummet. Spread the good word! Send it to your northern friends and single-handedly lower Norway's GDP!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Don't forget to check out all the other games on offer for Idler Fest too! There's some really good ones in there and we couldn't be prouder that some of them mention us as an inspiration.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "What's next",
     "items": [
      {
       "text": "We're still making progress on the dungeons minigame, UI overhaul, and QoL changes. Stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
