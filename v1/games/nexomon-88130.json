  {
   "id": "nexomon-88130@major-2019-12-20",
   "gameId": "nexomon-88130",
   "displayName": "New update available now.",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-12-20T21:26:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This patch includes",
     "items": [
      {
       "text": "+ The default volume level for music and effects is now 50%. All save files prior to this update will be automatically set to 50%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ A tooltip will now appear on top-left of screen with the name, description, power and accuracy of the selected skill during battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ You can now sort your storage by Name, Level, Rarity and Element.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Fixed Steam Achievements in-game popup. Achievements were being unlocked only after closing the game, but now you should see the notification immediately.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "+ We may have fixed an issue causing the volleyball minigame to be exceedingly sped up on some devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Some NPCs reference NexoBoxes from the mobile version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
