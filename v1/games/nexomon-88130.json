  {
   "id": "nexomon-88130@post-2019-12-05",
   "gameId": "nexomon-88130",
   "displayName": "BETA Build available now (with improvements & fixes).",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2019-12-05T15:49:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This patch includes",
     "items": [
      {
       "text": "+ During battles, the game now remembers the last skill you selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Added a new setting to let the game continue running in the background. Enabled by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ The game now uses borderless fullscreen mode instead of exclusive fullscreen. This might also fix some startup crashes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "+ Some skills didn't flash the screen when they should have.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ The evolution scene played music at full volume regardless of your settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ The credits scene played music at full volume regardless of your settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If no new issues are brought up from this build, we will release it to the public tomorrow or during the weekend. We are still working on more improvements, thanks so much for sharing your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tip: To access beta build, go to \"Nexomon\">right-click>\"BETAS\"> and download.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
