   "id": "nexomon-88130@major-2019-12-02",
   "gameId": "nexomon-88130",
   "displayName": "Update with settings and other fixes available now.",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-12-02T01:46:02.000Z",
   "notes": [
    {
     "title": "Features",
     "items": [
      {
       "text": "Settings button in the Nexopad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sound and music options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Option to toggle text sound on/off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Option to toggle full screen/windowed mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Option to quit game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Slow downs caused by particles fixed (like the Ventra scene and snow areas).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Catch rate rebalanced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Normalized sound effects.: More coming soon!: Thanks for helping us make Nexomon a better experience :) !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
