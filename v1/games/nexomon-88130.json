  {
   "id": "nexomon-88130@post-2019-11-29",
   "gameId": "nexomon-88130",
   "displayName": "Cut scenes issue fixed!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2019-11-29T20:04:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi! The issue where some users got stuck when entering cut scenes has been solved with the most recent update (special thanks to the community for helping us solve it!). This issue caused other minor bugs but all related to the same problem affecting specific regions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are now gathering suggestions and plan to implement them in future updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Including",
     "items": [
      {
       "text": "-Sound, resolution and windowed options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Option to exit game (in-game).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Sound calibration.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Default Nexomon skill, where the last skills used will be selected by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Delay when skipping text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-We are also working on implementing translations asap.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
