  {
   "id": "strike-force-heroes-277203@hotfix-2024-06-26",
   "gameId": "strike-force-heroes-277203",
   "displayName": "Heroes costume/weapons hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-06-26T16:57:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey heroes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After some traumatic personal events, I've taken a step away from online development for a while, and thus was not aware of this bug until recently, nor able to fix it until now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This small update fixes a bug where specific Story/Cameo characters no longer have their unique loadouts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v1.27",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a longstanding bug where the story Heroes have randomized costumes and weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a longstanding bug where the story Heroes ignore the first weapon in gungame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Edit",
     "items": [
      {
       "text": "v1.28",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue caused by v1.27 where bots did not appear in custom games: (they were looking for their story loadouts, which didn't exist)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
