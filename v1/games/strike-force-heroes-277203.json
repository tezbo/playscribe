  {
   "id": "strike-force-heroes-277203@1.22",
   "gameId": "strike-force-heroes-277203",
   "displayName": "Update 1.22",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-16T17:08:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "While the game was meant to be played among friends, the party list makes it possible to play with strangers, however lately many players have been hacking their game to get items they shouldn't have,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This mini update addresses many of those issues by removing items that players should normally not be able to obtain.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The full rundown are below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v1.22",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removes skills being used from other classes they don't belong to",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removes boss/challenge weapons from players inventories",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changes unreleased DLC classes back to normal class",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removes unreleased DLC items from players inventories",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removes outfits that players do not own (DLC/Kickstarter/etc)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Plus a few other minor changes to reduce hacking.: And as always, I'll continue to monitor and make adjustments as the game needs!: <3 Sky9 Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
