     "title": "Changes",
     "items": [
      {
       "text": "Happy release day everyone!!!🏠",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here comes our first post release hotfix patch, fixing two critical bugs :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a softlock in the episode 1967 when playing on Simplified Chinese around two thirds in the episode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a softlock in the episode 1989 on the last throw",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enjoy!!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
