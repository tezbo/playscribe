  {
   "id": "the-berlin-apartment-290052@1.0.3",
   "gameId": "the-berlin-apartment-290052",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-11T07:44:42.000Z",
   "notes": [
    {
     "title": "Patch Changelog v1.0.3",
     "items": [
      {
       "text": "Hello and welcome to the first patch update for the Berlin Apartment!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As we are approaching the release on the 17th, we've updated the build with a bunch of polish :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hope you enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "We got rid of a bunch of soft locks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lots of small bugfixes like missing sounds or weird game states",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Color and material tweak in every episode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaks on 3rd person animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaks on timings and pacing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some tweaks in the control hints in the bottom right",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some tweaks on Voice Over lines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Sound leveling and mixing updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Radio interaction in 2020",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Splashscreen animation for Blue Backpack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
