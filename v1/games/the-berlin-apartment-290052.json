  {
   "id": "the-berlin-apartment-290052@2",
   "gameId": "the-berlin-apartment-290052",
   "displayName": "Patch 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-15T15:01:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have compiled our last update before we go into winter holiday.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This one includes a host of bugfixes and changes as well as some all new accessibility features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any trouble with the new features please let us know in the community, as this is our first time making a Mouse-Only control scheme!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Mouse Only Accessibility Mode (Whole game only playable with mouse)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Updated Accessibility settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Maze Events & Paintings* get saved between play sessions (*Paintings only get saved at the next part)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Outline inconsistencies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Performance optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reflections should work consistently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Animation Bugs were smoothed out",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "At the end of 1933 you won't get stuck anymore if you reload after opening either of the exit doors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various Bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
