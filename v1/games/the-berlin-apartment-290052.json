  {
   "id": "the-berlin-apartment-290052@0.4.4",
   "gameId": "the-berlin-apartment-290052",
   "displayName": "Patch 0.4.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-09-04T08:34:33.000Z",
   "notes": [
    {
     "title": "Demo Patch 0.4.4",
     "items": [
      {
       "text": "Thank you all for playing our Demo! We made a patch based on everyones feedback, to improve the demo experience:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Streamer Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you’re a streamer you have the option to enable Streamer Mode (at the beginning of the game), which will remove Swastikas from the game graphics to get around demonetization or region locking issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved Paperplane Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bugs with the paperplane have been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Controlling the plane with the mouse should now be smoother",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Removed F12 Restart",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pressing F12 now properly takes a steam screenshot instead of restarting the demo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This feature was meant for public conventions and isn’t necessary here",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added ambient sound to the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This way you can check your sound volume before you start",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also it's just nice :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
