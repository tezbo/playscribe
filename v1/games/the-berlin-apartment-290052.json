  {
   "id": "the-berlin-apartment-290052@1.0.6",
   "gameId": "the-berlin-apartment-290052",
   "displayName": "Hotfix 1.0.6",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-11-19T14:01:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today we have another hotfix to account for some issues that got reported to us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This hotfix fixes the following",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The drawer achievement \"Completionist\" now works",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that would result in missing dialogues and subtitles in 1933",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some lines in Japanese were corrected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also sneak peak, we are cooking up the first proper patch, including rumble and haptics support for gamepads and some new accessibility features!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
