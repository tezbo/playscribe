   "id": "the-berlin-apartment-290052@12.11.2025",
   "gameId": "the-berlin-apartment-290052",
   "displayName": "Hotfix 12.11.2025",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-11-12T14:32:16.000Z",
   "notes": [
    {
     "title": "Today's hotfix update fixes two critical bugs",
     "items": [
      {
       "text": "When reloading the last checkpoint during 2020, there was a possibility it would break the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Choices would have sometimes frozen the game when playing in Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some more bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Font Issue on 1967 was fixed for all languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Option List View is now fixed in width. There was an issue where for example in Japanese an Option Line was way too long and it wasn't displayed correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
