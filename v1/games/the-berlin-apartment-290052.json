   "displayName": "Hotfix 1.1.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-11-28T10:02:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today's hotfix concerns a bug that makes people stuck in episode 1967 when they exit the game in the \\Maze\\. Now that part checks in the beginning if you are correctly positioned and else teleports you to the appropriate place 💪",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
