  {
   "id": "the-berlin-apartment-290052@1.2.1",
   "gameId": "the-berlin-apartment-290052",
   "displayName": "Hotfix 1.2.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-04-14T14:53:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A hotfix is coming in to unstuck the people that got stuck when they finished an episode a second time (by \"remembering\" them).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This should both fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* people being stuck right now (boot up the game with the update and it should free you and take you back to 2020)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* and people not getting stuck anymore when remembering Episodes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
