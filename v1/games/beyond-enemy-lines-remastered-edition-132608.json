  {
   "id": "beyond-enemy-lines-remastered-edition-132608@2.8.0",
   "gameId": "beyond-enemy-lines-remastered-edition-132608",
   "displayName": "Update 2.8.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-26T08:18:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve deployed Update 2.8.0 with a focus on refining the core gameplay experience and integrating new features into the expanding Polygon Art ecosystem:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Significantly improved AI reaction time and frequency for a more responsive and intense combat experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weapon Handling Enhancements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Refined weapon handling for smoother aiming and firing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added weapon sway to improve realism and immersion during movement and aiming.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "PANet Integration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Beyond Enemy Lines – Remastered Edition is now connected to PANet!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Check your personal stats and progress online: https://polygon-art.com/stats/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our next title Beyond Enemy Lines – Vietnam is now live with a free demo on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Explore the jungle, test your tactics, and experience the future of the franchise.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't forget to add it to your wishlist to stay updated!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
