  {
   "id": "beyond-enemy-lines-remastered-edition-132608@major-2021-06-19",
   "gameId": "beyond-enemy-lines-remastered-edition-132608",
   "displayName": "Development Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-06-19T14:09:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Agents,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "the PC version of BEL Remastered Edition is slowly shaping up. Right now we are replacing the old weapon models with new, high quality models with better animations, sounds and gunplay as well as overhauling the overall game experience.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We don't have an exact release date but we are working hard to get it live on Steam as soon as possible!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
