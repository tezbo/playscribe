  {
   "id": "motogp-25-333787@patch-2025-05-21",
   "gameId": "motogp-25-333787",
   "displayName": "New patch live now!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-21T09:02:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New MotoGP™25 patch live now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved controllers’ vibration, trigger feedback and vibration timing across all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Revised the TCS (Traction Control System) and tyre efficiency parameters to fix the “phantom spin” issue. The handling and the feedback of the bike should now be improved overall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements to AI behavior on track and pit entries. Adjusted the aggressiveness of AI opponents.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mechanics now will install automatically the least worn tyre available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Team development has been recalibrated in Career mode. Inefficient development packages have been removed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the number of teams available for negotiations during the summer break in Career mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted rival rider skill tuning to better reflect the current season's performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Aligned the number of laps for the Le Mans Grand Prix with real-life values in all categories.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated the position of corner and braking indicators on the Balaton circuit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It is now possible to use the rewind feature during qualifying to attempt a final lap if the previous time is invalidated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
