       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶ MacOS, Linux update",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "▶ Bug fix: clicking Receive All now shows the number of achievements received properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶ Bug fix: game pad recognization issues on sliding and circle hit episodes now fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶ Partial video quality upgrade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶ Missing Spanish and Portuguese subtitle added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy the improved gameplay experience of Heroines Through My Lens, and don’t forget to spread the word to fellow users! 💕",
