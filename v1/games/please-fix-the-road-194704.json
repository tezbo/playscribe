  {
   "id": "please-fix-the-road-194704@1.1.0",
   "gameId": "please-fix-the-road-194704",
   "displayName": "Patch 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-14T08:22:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "10 new easy levels for beginner players that explain the game mechanics better. Trivial for puzzle enjoyers, but very needed for casual players. Now there are 160 levels in total.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simplified a few starting levels based on observations of how players play them on Twitch and YouTube. Don't worry, hard puzzles remain untouched.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the level order a lot, there are more easier levels first and the harder one got pushed to the later stage of the game. This doesn't change the overall difficulty of them game, just eases the player into it better. Levels from 1 to 60 should be more approachable now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed minor visual error in one of the level switch animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed decorations on a few levels that obstructed the view too much",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug, where the game wouldn't switch to skipped levels after finishing the last level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug, where the interface would hide too late in the level switch animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please consider leaving a review for the game on Steam, either negative or positive. This help with the game discoverability. Cheers!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
