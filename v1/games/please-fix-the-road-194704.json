  {
   "id": "please-fix-the-road-194704@1.1.7",
   "gameId": "please-fix-the-road-194704",
   "displayName": "Patch 1.1.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-19T18:07:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Implemented a possible workaround for a bug, where on a very rare occasion you wouldn't be able to use the current tool until you open and close the options menu when playing on a gamepad. This simple bug has been haunting me for a long time. Only saw it on Twitch streams a few times, and today I saw it again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue, where the readability grid would be rendered over the tool indicators.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
