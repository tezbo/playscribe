  {
   "id": "please-fix-the-road-194704@1.1.6",
   "gameId": "please-fix-the-road-194704",
   "displayName": "Patch 1.1.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-19T16:08:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Exit to desktop button moved to a separate panel, has a red highlight and requires a confirmation to exit the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new popup will appear, that teaches you how to reset the current tool the first time you use the Copy Tool. Some players, even at 30+ levels didn't know, that they can right-click or press the east gamepad button for this. This will also appear for existing players, because I can't confirm if you already know about this (I didn't track resets before update).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now open the options menu at the very beginning of the game (before intro credits) and in the tutorial at level 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed minor issue with keyboard/gamepad navigation in options.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
