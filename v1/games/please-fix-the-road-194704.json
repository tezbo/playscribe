  {
   "id": "please-fix-the-road-194704@1.1.5",
   "gameId": "please-fix-the-road-194704",
   "displayName": "Patch 1.1.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-17T13:00:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The more levels you complete, the more levels you can skip ahead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Starting tutorials now have a very clear progress indicator. Some people got confused and stuck for a few moments, because they didn't use WASD/Left gamepad stick for long enough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new popup tutorial will show the first time you use the Rotation Tool if you are using Mouse+Keyboard controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Removed some decoration on levels 11 and 20, that obstructed the view too much.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level 6 was moved to position 9 (nice).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
