  {
   "id": "please-fix-the-road-194704@1.0.6",
   "gameId": "please-fix-the-road-194704",
   "displayName": "Patch 1.0.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-13T06:05:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Changed level selector icon, should be clearer what it is.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level unlock popup (+1, +2 puzzles) will make the level selector button blink more, so players will notice it more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Default hotkey for hints is now F (H also works) instead of TAB, so the game will not give a hint when ALT+TAB'bing on Steam. Hint popup will appear once with the new keybind for existing players to inform you of the change.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Level selector tutorial popup will appear even if you don't use hints. New players will see it at level 4 and existing players will see it once on the start of a level, if they never seen the popup yet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reminder popups for using hints and for level skips are shorter, will appear after a longer time and will stop appearing after seeing them 3 times each.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lowered hint cooldown.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made one of the starting level easier. I will add more easy levels in the first content update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
