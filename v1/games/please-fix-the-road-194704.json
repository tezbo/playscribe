  {
   "id": "please-fix-the-road-194704@1.1.2",
   "gameId": "please-fix-the-road-194704",
   "displayName": "Patch 1.1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-16T09:20:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added a black grid to the tiles that improves map readability. By default it's subtle, but you can adjust its power in the options to make it really strong or disable it completely.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Resolution slider now filters out too big resolutions (bigger than your system resolution).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
