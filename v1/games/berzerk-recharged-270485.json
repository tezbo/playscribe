   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dashing diagonally through gates no longer causes a stutter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes for enemy visuals and collisions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a small delay between dying and showing \"Game Over\" screen in order to show death animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some rooms that would cause gameplay freezes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug which caused enemy bullets to pass through gates into a new room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Audio tweaks and balancing - Specifically robot voices should be heard even better now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added mission descriptions and mission progress counter in HUD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
