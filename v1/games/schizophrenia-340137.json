  {
   "id": "schizophrenia-340137@major-2025-07-30",
   "gameId": "schizophrenia-340137",
   "displayName": "VOICELINE UPDATE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-30T01:38:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After several weeks, the voiceline update is finally available!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The main character is played by GodDoubleDamnit. Happy birthday to him!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other minor changes",
     "items": [
      {
       "text": "Optimized the \"SPAM E\" menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the volume of some sounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I haven't been very consistent lately, and I apologize for that. I'm working on the biggest project of my entire career, and it's taking up a lot of my time, but you'll hear about it soon on my Discord!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TheCourget",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
