  {
   "id": "schizophrenia-340137@major-2025-12-26",
   "gameId": "schizophrenia-340137",
   "displayName": "Optimization Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-26T16:05:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The SCHIZOPHRENIA project is now running on Unreal Engine 5.6.1, and I've significantly optimized the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Between the old and new versions, we've seen a 75% increase in FPS (on average).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "MORE INFORMATIONS HERE",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Shadow optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimization of all indoor maps (apartments)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
