  {
   "id": "schizophrenia-340137@major-2025-06-09",
   "gameId": "schizophrenia-340137",
   "displayName": "VOICELINE UPDATE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-09T21:28:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In a few weeks, I am going to redo all the voicelines, and add missing ones.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The voices will now be in French, my voice actors are French, the quality will be better !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "I'm redoing dialogues for several reasons",
     "items": [
      {
       "text": "Quality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I've cut ties with the voice actor \"I\", I won't say more on the subject for the moment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The diversity of characters I could add (me, mom, dad, the doctor, etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI is a poor alternative",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update should be available in a few weeks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I will show the progress on my official Discord, that you can join below !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TheCourget",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
