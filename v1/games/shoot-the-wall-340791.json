  {
   "id": "shoot-the-wall-340791@major-2026-07-13",
   "gameId": "shoot-the-wall-340791",
   "displayName": "Shoot the Wall Rebalance Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-13T14:18:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks again for everyone playing Shoot the Wall, below are the changes for this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Be sure to leave feedback in the discussions and let us know if anything is not working correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Pistol",
     "items": [
      {
       "text": "Added additional damage upgrade for 5 additional damage cost 1000.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added additional magazine size upgrade for 53 additional bullets per mag costing 500.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Assault Rifle",
     "items": [
      {
       "text": "Base range increased to 25m.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added additional damage upgrade for 6 additional damage cost 500.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added 3 extra fire rate upgrades -0.00625/-0.00625/-0.0125 costing 20/50/250 making the overall fire rate go down to 0.0125 (still higher than SMG).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reworked mag size upgrades increasing by 10 per upgrade instead of 5, added 3 new upgrades 10/30/50 costing 200/500/1000 making the max magazine size 250.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added 2 extra max ammo upgrades 170/200 costing 500/1000 making the new max capacity 1000.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Shotgun",
     "items": [
      {
       "text": "Added 2 new damage upgrades 2/5 costing 500/2500 making the new max damage 25.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Range reworked from 0.25 per level to 2.5 (I think this is what I mean to do but forgot to check it) making the total effective range 25m making the shotgun more effective.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added 3 new mag size upgrades 2/2/2 costing 100/100/150 making the maximum mag size 30.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Sniper Rifle",
     "items": [
      {
       "text": "Base range increased to 30m",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reworked the damage upgrade scaling, it maxes out at 50 with the upgrades then has a final 25 damage upgrade costing 1000 bringing the total damage to 75.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added extra bullet penetration upgrade of 8 costing 2500.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added extra max ammo upgrade 10 costing 400.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Submachine Gun",
     "items": [
      {
       "text": "Added 2 mag size upgrades 35/100 costing 250/1000.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added extra max ammo upgrade 60 costing 450.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Options screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the options screen starting on video and not changing until you select video. (this bug showed up last patch, I forgot to turn off the video menu after testing)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various other small fixes which will hopefully reduce crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
