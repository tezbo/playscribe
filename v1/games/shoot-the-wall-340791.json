  {
   "id": "shoot-the-wall-340791@major-2026-07-02",
   "gameId": "shoot-the-wall-340791",
   "displayName": "Shoot the Wall Resolution Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-02T03:08:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Everyone, thank you all for playing Shoot the Wall!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have had a few requests to fix resolution issues on some lesser used aspect ratios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There are a few other minor changes but this should mean that the game is accessible on any resolution, please leave any feedback in reviews or in the discussion section on the steam community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shoot the Wall has also been released on consoles, so check it out on Xbox and PlayStation if you get the chance!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "Regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dexter & Travis",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
