  {
   "id": "shoot-the-wall-340791@1.1a",
   "gameId": "shoot-the-wall-340791",
   "displayName": "Patch 1.1a",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-25T21:03:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some added functionality and fixes to the leader board.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a reset button to the Generator page, this resets your data if you save, so if you press it by accident you can quit the game and reopen the game to restore your data.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Made pickup collision for money pickup not interact with player collider, should ensure money can still be collected and won't push you into the air.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the game was loading your story weapon levels in the generator mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Apologies to anyone affected by the bugs, keep us updated with any new bugs you come across and we will try to address them in the next update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Also, a very big thank you to everyone who has played the game and continue to do so, you're all great!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
