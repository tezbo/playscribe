     "items": [
      {
       "text": "Hello everyone! Hope you're doing well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re stopping by to let you know that we’re closely following all community feedback and fully committed to improving and fixing everything we can to ensure the best possible experience for everyone playing Saborus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some players have reported crashes during gameplay, and thankfully we found a workaround to reduce this issue. We’re still investigating further in case there are any additional causes we haven’t identified yet, but rest assured that we’re doing everything we can to make sure everyone can play smoothly!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you next time! 🐔✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
