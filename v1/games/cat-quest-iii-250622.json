  {
   "id": "cat-quest-iii-250622@1.1.6",
   "gameId": "cat-quest-iii-250622",
   "displayName": "Patch 1.1.6",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-08-21T10:21:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed issues where a small number of players experienced save file problems. Save files now migrated to a new location. Please contact us at contact@thegentlebros.com if you are experiencing issues during this migration!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes an issue where shooting from a gun could cause the wrong swing from a melee weapon to trigger.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes a few mistakes in the localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes an issue where the Necromouser's chest cannot be looted under specific circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes an issue where players could get stuck in the Eight Bit Dungeon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the drop condition for Weird Mushroom and Flame Crystal. They will now always drop from two specific bosses in the Infinity Tower.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues in Spicy Cave.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the Def stat was affecting healing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where cutscenes were too loud and not tied to the Music sliders in the Options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where some players were experiencing stuttering.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where icicle attacks were larger than expected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where bounty gold rewards are higher than intended in New Game+.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where some achievements were not retroactively unlocking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where boar footsteps could still be heard when sound was turned off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the level display in the inventory is not correct.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the Electric Cannonpaw attack could stunlock enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes minor issues in Co-op mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Balance tweaks to Golden Helm, Spicy Squid set and Takomeowki set.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an extra cutscene before the fight with Captain Takomeowki.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Confined mouse cursor to gameplay space in Fullscreen mode and Windowed mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
