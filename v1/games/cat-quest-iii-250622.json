  {
   "id": "cat-quest-iii-250622@major-2024-11-27",
   "gameId": "cat-quest-iii-250622",
   "displayName": "Cat Quest III | Mew Content Update Out MEOW!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-27T11:01:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ahoy, fur-midable adventurers! 🐾",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Purribean just got paws-itively better with a free update for Cat Quest III!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prepare to hoist the sails and embark on a treasure-filled journey packed with purr-rific new content:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "☠️ Five New Side Quests – Sniff out secrets, meet claw-some new characters, and paw-sibly cross paths with some familiar furry faces!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🏴‍☠️ Four New Dungeons – Test your whiskers with new puzzles, claw-ver gameplay mechanics, and thrilling surprises waiting to be unearthed!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🐾 Three New Boss Fights – Face off against fearsome foes in heart-pounding battles that’ll have you clawing for glory!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "💎 New Gear Galore – Gear up for adventure with shiny new loot that’ll have you pouncing into action with style.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's time to conquer the seas of the Purribean once more! 🐾⚓",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Content",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "5 new quests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4 new dungeons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "9 new equipment (Including a second Warrior's Braid for more co-op fun!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "QOL Additions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Leveling up past maximum level now replenishes health, mana and ammo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added \"Camera Shake\" option in Options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed rare issue where NPCs would move at abnormal speeds sometimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed French Localization where there are missing characters from certain words (Eg. Charaibes -> Charabes).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where some enemies' attacks can cause the player to not be able to transition from water>land and vice versa.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where there was a short static at the end of skipping animated videos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Credits not being reset back to initial starting point.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed confirmation message panels not hiding properly sometimes after confirmation (\"Yes\").",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted sound effects to fade out during transition between scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed issue where certain passives were not functioning properly with certain equipment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
