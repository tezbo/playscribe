  {
   "id": "romancelvania-141964@1.0.2",
   "gameId": "romancelvania-141964",
   "displayName": "Hotfix 1.0.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-03-11T01:49:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The feedback has been great! Thank you all so much for sharing your thoughts. We were so energized by it that we couldn't help but send another update right away. Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where if you return to Fenton after getting Strength in Fiction Quest but before completing it, you get an empty conversation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where if you visit Medusa before yesterday’s hotfix AND return to her the gallery wall will block you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added indicators to date and gift selection screens to more clearly indicate you can scroll to see more characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an out of world bug where you can jump out of Sol’s area of the castle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Prevented players from leaving Hokkaido before Grim shows up to take you back to Drac’s Castle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added two new Quests to clarify where to find Nefret – “Got the Power!” and “Electrified!” added to give a bit more guidance to the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tuned the lightning in Thundercrack Hollow to be more forgiving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added in signage to help guide to Fenton and Lightning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an unreported bug in the Profile selection when attempting to creating a new game and backing out of a profile. It required you to back out a second time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tuned Pumpkink to be a bit less punishing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Tuned physics on Rollkins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
