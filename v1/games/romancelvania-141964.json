  {
   "id": "romancelvania-141964@1.0.3",
   "gameId": "romancelvania-141964",
   "displayName": "Hotfix 1.0.3",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-03-12T23:35:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A few updates we weren't able to include in the previous updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where the Sol and VH House Drama could fail to return control if triggered in certain regions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Vess now triggers the correct conversations if you complete her Quests but converse with her in different orders. This allows for easier access to her Bottle quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added additional safeguards to ensure control is returned to the player after all House Dramas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
