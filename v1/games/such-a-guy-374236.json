  {
   "id": "such-a-guy-374236@major-2025-11-02",
   "gameId": "such-a-guy-374236",
   "displayName": "November 1 Update Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-02T08:25:47.000Z",
   "notes": [
    {
     "title": "Update Details",
     "items": [
      {
       "text": "Optimized Map Event Unlock System",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the affection level required to unlock girl events on the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "A “Not enough affection” message now appears when clicking a locked girl icon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now replay completed girl events by clicking their icons on the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted all Combo QTE Text Descriptions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added “Repeated Tap” hints to all combo QTEs for clearer operation types",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved Chapter 9 Node Traceback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Late-stage Chapter 9 levels can now be revisited for story review",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced Timed Choice Stages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted limited-time options for smoother access to hidden scenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Performance Optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Further improved stability under specific conditions to reduce stuttering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Coming Next",
     "items": [
      {
       "text": "Adjust video content with poor player feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimize routes to the “Jokester” and “Penny Pincher” endings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Continue improving video playback logic to reduce lag and crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
