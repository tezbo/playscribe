     ]
    },
    {
     "title": "Update Notes",
     "items": [
      {
       "text": "Removed online verification, the game can now be played fully offline without any network connection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed map part-time job events reported as uncomfortable by players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All “foot massage” icons on chapter maps have been removed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The “Wish Star” from these events can no longer be earned, but total in-game currency remains sufficient and will not affect full keepsake collection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed QTE actions from Mina’s first two meditation scenes; these scenes now play as seamless cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Achievement Added: 100% Flowchart Exploration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Players who had already achieved 100% exploration before this update can unlock it by selecting “Revisit” on any flowchart node.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed subtitle errors and text inconsistencies in several language versions.",
       "ps5ProOnly": false,
