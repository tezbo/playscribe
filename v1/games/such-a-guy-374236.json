  {
   "id": "such-a-guy-374236@major-2025-10-18",
   "gameId": "such-a-guy-374236",
   "displayName": "October 18 Update Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-18T03:58:44.000Z",
   "notes": [
    {
     "title": "Updates",
     "items": [
      {
       "text": "Fixed an issue in Chapter 9 – Fireworks where the game would default to the failed marketplace route. The system will now automatically recall the player’s last successful marketplace completion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a “Skip Animation” button for the Wish interface’s draw animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "White Screen Issue: Added a prompt to guide players to install the missing VP9 Video Extension.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "White Screen Issue: Fixed several known causes and will continue monitoring.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized video volume control, reducing cases of abnormal sound levels during gameplay. (If issues persist after the update, please let us know!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved chapter completion logic to reduce cases where the game fails to transition to the next chapter. If stuck, try replaying the last stage of the previous chapter and re-completing it—this usually resolves the issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed occasional freezing or unresponsiveness when scrolling with the mouse wheel on the chapter selection screen.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved temporary storage management — the game can now run smoothly even when the system drive (usually C:) has as little as 2GB of free space.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced log recording system to help the development team better diagnose and resolve issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Coming Next",
     "items": [
      {
       "text": "Further improving certain QTE (Quick Time Event) experiences.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adding a skip option for repeated challenge gameplay, allowing players exploring different story branches to jump straight to new content instead of replaying identical interactions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Advancing Steam Deck compatibility.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Developing the “Writer Kneeling Motherboard” (🙃)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Continuously collecting and refining player feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ongoing bug fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
