  {
   "id": "such-a-guy-374236@major-2025-10-21",
   "gameId": "such-a-guy-374236",
   "displayName": "October 21 Update Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-21T10:20:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45705479/6d37707b2f8965b2292003005c36ffa55c2660df.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Updates",
     "items": [
      {
       "text": "QTE Stage Optimization: overall difficulty has been reduced for smoother story progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The pace of QTE sequences has been slowed down, giving players more time to prepare.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The reaction time for individual QTE inputs has been extended, making them easier to succeed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The number of consecutive QTEs has been reduced to ease player pressure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed QTE segments that did not align with the story experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted each chapter’s mobile chat stages: after the first completion, these stages can now be skipped during replays.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Chapter maps will now display unlock percentage information, making progress clearer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reworked English, Japanese, and Korean localization subtitles to improve translation quality and readability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed several known game code bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where using “Claim All Achievements” could result in missing some rewards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(A compensation plan is being considered for affected players.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed video playback failures and continued to optimize playback code for better performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed stuttering that could occur in certain cases when repeatedly pressing the fast-forward button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed potential stuttering issues that might appear after extended play sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Coming Next",
     "items": [
      {
       "text": "Add a system that grants a Wishing Star reward for achieving 100% chapter completion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add indicators for untriggered hidden stories and random events to help completionist players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Revise the random event unlocking mechanism to reduce missed story content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Continue optimizing video playback code to address stuttering and crash issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Feedback Channels",
     "items": [
      {
       "text": "Feedback Form: https://docs.qq.com/form/page/DTFhKS2htTENrVFRF",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord: https://discord.gg/uxXgTuk9XF",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "QQ Groups: Group①: 682438722, Group②: 615769890",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Support Email: support@such-one.com",
       "ps5ProOnly": false,
