  {
   "id": "such-a-guy-374236@major-2025-10-25",
   "gameId": "such-a-guy-374236",
   "displayName": "October 24 Update Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-25T00:34:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45705479/c1e8eff5a03ef50374353f2e6b18383739f8a7a3.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update Details",
     "items": [
      {
       "text": "Added Chapter Reward Chests",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Now, when each chapter’s progress reaches 100%, you can click the chest icon on the right side of the progress bar to claim Wish Stars. Details below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chapters 1–8: 5 each; Chapter 9: 10; total of 50 Wish Stars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tree Diagram (Locked Stages) Visual Optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted some tree connection data — players can now see locked paths more clearly via the lock icons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed incorrect group name display in “The Joker Ending” phone chat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect trigger condition for the “Chosen One” achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the post-Market phone stage could freeze or appear blank under certain conditions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Audio Loss Bug — ongoing optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Future Plans",
     "items": [
      {
       "text": "Adjust video segments with poor visual feedback based on player reports",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add reminders for “untriggered hidden stories or random events” to help collectors find clues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Revise random event unlock mechanisms to prevent missing hidden stories",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimize the progression paths for “The Joker” and “The Miser” endings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Continue optimizing video playback code to fix stuttering and crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Feedback Channels",
     "items": [
