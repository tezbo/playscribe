  {
   "id": "such-a-guy-374236@major-2025-12-29",
   "gameId": "such-a-guy-374236",
   "displayName": "December 29 Update Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-29T04:47:26.000Z",
   "notes": [
    {
     "title": "[img src=\"{STEAM_CLAN_IMAGE}/45705479/10cd4914a57dd041ea5b02b55729922acb7a70f6.png\"]Update Notes",
     "items": [
      {
       "text": "Online verification has been removed. The game can now be played fully offline without an internet connection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed certain map work events that received negative player feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All “foot massage” icons have been removed from chapter maps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Wish Stars” previously obtained from these work events are no longer available. However, the total in-game currency remains sufficient and does not affect full collection of collectibles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed QTE sequences from Xu Manman’s first two meditation scenes. These scenes are now presented as uninterrupted animated cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Achievement Added: 100% Tree Exploration Completion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Players who had already achieved full exploration before this update can unlock this achievement by selecting “Rewind” on any node in the tree interface",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed subtitle errors and text inconsistencies in certain language versions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Feedback Channels",
     "items": [
      {
       "text": "Survey: https://docs.qq.com/form/page/DTFhKS2htTENrVFRF",
       "ps5ProOnly": false,
