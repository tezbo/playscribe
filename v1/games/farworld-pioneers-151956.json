      {
       "text": "Full notes available here: https://www.reddit.com/r/FarworldPioneers/comments/16nn9aw/xbox_update_92023/?utm_source=share&utm_medium=web2x&context=3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'll be able to announce a Playstation release date soon due to this.",
       "ps5ProOnly": false,
