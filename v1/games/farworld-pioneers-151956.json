  {
   "id": "farworld-pioneers-151956@post-2021-07-16",
   "gameId": "farworld-pioneers-151956",
   "displayName": "Outworlder Alpha1-Preview12g",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-07-16T01:11:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
