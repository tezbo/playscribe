  {
   "id": "farworld-pioneers-151956@2a",
   "gameId": "farworld-pioneers-151956",
   "displayName": "Patch 2a",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-10-05T16:03:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Welcome Colonists!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have substantial fixes and changes that have been greatly requested by our community today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Take advantage of these updates now! The Steam Next Fest ends in 2 days, and so does the Outworlder festival beta. Going forward we will looking at our paid release of the game, with a date to be decided soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Doubled the horizontal size of the world to 4000 world units",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Waypoints to other players now show the distance in a tooltip",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chair flipping is now allowed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased grenade damage but lowered damage over range",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Protected unbreakable blocks against dynamite mining",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved positioning of setpiece markers on minimap and ensured debug-teleporting to a surface setpiece spawns you somewhere on the surface",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated surface setpieces again. Temporarily removed Hut and Ruined Tower. Added Shelter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a more powerful debug button to toggle the UI camera and hide all UI/text (when the Esc and Tab menus are not open)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Fixed issue that caused the “Cold” notification to tick on and off repeatedly when one of your colonists is downed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed icons for certain items and ores looking “thick”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed long-standing bug that caused clicking with the selection cursor in multiplayer to use the last item in the hotbar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with certain armors that could cause damage stacking issues when equipped/unequipped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an exploit that allowed recharging the rocket boots in midair by re-equipping them quickly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue that caused chefs and other axe-wielding NPCs to just stand there when attacked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added automatic saving every 5 minutes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Reduced heavy CPU usage that could result from off-screen world regions loading and unloading rapidly by keeping them alive a bit longer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved performance by caching the result of frequent IO calls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved performance of the terrain lighting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue that caused NPCs to get stuck if they decided to go to sleep while standing on a platform block",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a long standing bug where Smelter and other facilities that can have materials potentially hauled to them could cause all colony crafting/hauling orders to halt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "PreAlpha2 Patch 2c",
     "items": [
      {
       "text": "Hotfix for saving issue introduced in last patch. Clear your save folders!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "F10 hotkey allows you to force saving the world",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Contest",
     "items": [
      {
       "text": "Did you make it this far? We have an ongoing contest over at our Discord server to build a birthday party! The winner will get a copy of Outworlder for themselves or a friend courtesy of one of our community volunteers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enter fast, the contest ends when the Steam Next Fest ends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Social Media",
     "items": [
      {
       "text": "Can’t get enough Outworlder? Itching for the next colony? Try one of our communities and social media platforms!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our Discord is our main community hub: look for people to play Outworlder with there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord: https://discord.gg/Asntr8e",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our other spaces are regularly updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Twitter: @playoutworlder",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Forums: https://forums.playoutworlder.com/index.php",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reddit: https://www.reddit.com/r/Outworlder/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Outworlder Site: https://playoutworlder.com/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Facebook: https://www.facebook.com/playoutworlder/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
