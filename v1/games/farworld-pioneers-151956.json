  {
   "id": "farworld-pioneers-151956@post-2022-04-20",
   "gameId": "farworld-pioneers-151956",
   "displayName": "Outworlder PreAlpha3-Preview5d",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-04-20T00:01:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Colonists,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Just adding in a second post real quick for PreAlpha3-Preview5d",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buddy is no longer impervious to cold, hunger and fatigue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Food nutrition values rebalanced; NPC fullness goes down by roughly 75% a day",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add some information to food and medical item tooltips",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional tweaks to button styles in several dialogs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that caused NPCs to empty food stores rapidly due to not receiving any nutrition from food",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused NPCs to get stuck standing in front of a container forever while searching for food",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused NPCs to get stuck standing in a position where an item used to be available for pickup",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused NPCs to walk all the way to an unavailable item or bed before canceling the current task",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could cause certain items to be consumed twice when used by NPCs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused NPCs to twitch until interrupted instead of going to bed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused NPCs to get stuck when affected by hypothermia if the closest warmup spot was inaccessible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused NPCs to remain in suspended animation until the game is reloaded after being revived by another NPC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
