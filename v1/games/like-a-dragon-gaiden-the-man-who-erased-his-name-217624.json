  {
   "id": "like-a-dragon-gaiden-the-man-who-erased-his-name-217624@1.12",
   "gameId": "like-a-dragon-gaiden-the-man-who-erased-his-name-217624",
   "displayName": "Patch 1.12",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-17T03:10:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello RGG Fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.12 is now live with the following fixes and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue with the game running at double speed in certain environments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted the bird’s eye camera view while playing pool.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Graphics settings in the main game now carry over to the Like a Dragon: Infinite Wealth Special Trial Version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue with the display while using Intel Arc.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• When anti-aliasing is set to “NVIDIA DLAA” in the graphics settings, sharpness can now be adjusted using the “NVIDIA DLSS Sharpness” slider.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Fixed various other issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your support and patience while our team addresses these known issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to share any bugs you encounter via the Official Bug Thread.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "RGG Community Team -",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
