  {
   "id": "spirit-hunter-death-mark-ii-133814@major-2024-02-20",
   "gameId": "spirit-hunter-death-mark-ii-133814",
   "displayName": "20/02/24 - Patch update notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-20T14:24:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Improved mouse controls around navigation – clicking the upper part of the screen now counts as an 'up' input, and will now enter the next area when a red interactive ‘up’ arrow is displayed, while clicking the lower portion of the screen now counts as a 'down' input, and will enter the next area when a red interactive ‘down’ arrow is displayed. Interacting with the 'white dot' interactive items when they're in line with your character will work anywhere in the central portion of the display.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved the movement of mouse and analog stick inputs during first person investigations. The movement here should now be much more fluid and not just 8-directional.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a lockup that could occur when using the mouse to control the game while close to both an interactive ‘white dot’ object and an interactive ‘red arrow’ entrance to a new area (e.g. the lockups found in the restrooms near the cleaning cupboard and some classrooms near a cleaning cupboard, etc.)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some text errors mentioned on the Steam discussions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resized the mouse pointer.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
