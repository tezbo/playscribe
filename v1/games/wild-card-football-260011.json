   "id": "wild-card-football-260011@post-2023-10-10",
   "gameId": "wild-card-football-260011",
   "displayName": "Launch Day Known Issues",
   "kind": "dayOne",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-10T14:47:32.000Z",
   "notes": [
    {
     "title": "GAMEPLAY",
     "items": [
      {
       "text": "The ball may teleport to the ball carrier after a grabbing tackle. This will be fixed in the next patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players may experience the ball teleporting from QB to RB on some plays while in Replay mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In rare instances, the current down may end suddenly after a fumble has occurred.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In rare cases, players may experience a session time-outtime out when inviting another player to a match.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "VISUALS",
     "items": [
      {
       "text": "The game logo is absent on some helmets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some Wild Cards for stat modification don’t properly show the plus sign that indicates they have a higher effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The effects on the pack open animation might appear green for the Deluxe Rare pack. This doesn’t affect the packs’ rarity nor its content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some textures might show a low level of detail depending on memory conditions. This will be fixed in the next patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players may see some clipping issues. Although rare, we are aware of them and are looking to address them in a future update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "UI/UX",
     "items": [
      {
       "text": "Some symbols and characters from different alphabets may not be supported when introducing team and city names.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "MISCELLANEOUS",
     "items": [
      {
       "text": "Pop-ups announcing the content unlocked through purchases might not show up if internet connection is lost. The content should still be successfully unlocked when connection is restored.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
