  {
   "id": "deadcraft-199178@1.01",
   "gameId": "deadcraft-199178",
   "displayName": "Patch 1.01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-17T21:36:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released a new update for DEADCRAFT that addresses the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a progress-blocking issue that could occur when reporting a successful mission while a different mission is displayed on-screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a progress-blocking issue that could occur during the mission \"Firestarter.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a progress-blocking issue that could occur if the mission \"Frankie Envy\" was accepted while the mission \"A New Power\" was in progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Storage Shed would become unavailable for crafting if the skill to unlock the Hoarder's Shed was learned before the Storage Shed was crafted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
