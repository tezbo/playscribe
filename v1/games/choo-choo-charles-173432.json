  {
   "id": "choo-choo-charles-173432@1.0.3",
   "gameId": "choo-choo-charles-173432",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-01-10T00:17:29.000Z",
   "notes": [
    {
     "title": "1.0.3 Patch Notes",
     "items": [
      {
       "text": "Maybe hopefully possibly fixed all the trees the players could get stuck to? Players who were previously stuck to a tree should be freed again I think? (seemed to work when I tested it, so fingers crossed)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made pop-in less noticeable near Santiago's Port.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made pop-in less noticeable for Gale’s house.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted to placement of the Red Paint Chest to prevent softlock when going up the lift and opening the chest at the same time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed players getting softlocked on the death screen when dying while the map is open.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Maybe hopefully actually prevented the upgrades menu from blocking the final cutscene?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
