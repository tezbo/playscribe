  {
   "id": "choo-choo-charles-173432@1.0.2",
   "gameId": "choo-choo-charles-173432",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-12-21T00:24:58.000Z",
   "notes": [
    {
     "title": "1.0.2 Patch Notes",
     "items": [
      {
       "text": "Fixed a bug where some doors would load closed, after already being opened",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where save files would stop being written",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added collision to a couple stacks of pog rocks near John Smith's bunker",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where dying indoors, in caves, and in mines while it’s raining caused rain particles not to appear after players respawned",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where players could interact with items while dead",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed softlock on a tree near the North Mine",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed softlock on tree near Sgt. Flint’s base",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the player camera isn’t animated at all during Charles jumpscare",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
