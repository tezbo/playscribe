  {
   "id": "hidden-cats-in-rio-de-janeiro-350069@post-2025-06-18",
   "gameId": "hidden-cats-in-rio-de-janeiro-350069",
   "displayName": "Small Fixes to Sound and Animations",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-18T18:42:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! We are happy to say that we've fixed the following issues in the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level completion animation Overlaping with cards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Meow sounds being linked to sound effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hint sound playing despite gaming being muted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buttons of pause menu highlighted in multiple selections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Small fixes to animations of characters/enviroments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You may now enjoy the game as intended! We are are greatful for your support and we are happy to hear you are all enjoying the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let us know if everything runs smoothly on your end! Happy finding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
