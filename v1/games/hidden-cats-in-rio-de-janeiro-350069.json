  {
   "id": "hidden-cats-in-rio-de-janeiro-350069@post-2025-09-30",
   "gameId": "hidden-cats-in-rio-de-janeiro-350069",
   "displayName": "Small Bug Fixes: Achievement and scenery",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-30T17:28:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! We've just released a small update that fixex some bugs we have come across, these being:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Found all cats achievements not working;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Main levels sidewalk was blurry when not colored;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Completed Main level but a single building wasn't colored.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also have plans to make achievements of completed levels play when the save file registers them as having already been completed in order to facilitate acquirement of achievements that don't require replaying the level due to some unexpected bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope this improves your overall experience of the game, happy finding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
