  {
   "id": "hidden-cats-in-rio-de-janeiro-350069@post-2025-07-15",
   "gameId": "hidden-cats-in-rio-de-janeiro-350069",
   "displayName": "Achievements, Music, and Art fixes.",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-15T18:09:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! We are happy to announce that we have fixed some issues that have been bugging players for a while now, those being:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Art of main level's sky/beach appearing with gaps between themselves;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Zoom being too limiting, we've increased its range;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Completing main level wouldn't trigger the fireworks or the congratulations animations;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-\"Found all cats\" achievement was playing too early;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-\"No hint\" achievement being given on the main level despite using hint;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Music not playing correctly when unlocking bonus level;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Music was playing even with sound settings Muted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With all of these fixed, you may now enjoy the game as it was intended, happy finding friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
