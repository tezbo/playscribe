 "releases": [
  {
   "id": "defender-of-the-crown-the-legend-returns-394671@1.0.10",
   "gameId": "defender-of-the-crown-the-legend-returns-394671",
   "displayName": "Patch 1.0.10",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-01T13:34:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update for Defender of the Crown: The Legend Returns is here! This patch brings a range of gameplay improvements, balancing changes, and fixes across the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s what’s new",
     "items": [
      {
       "text": "Classic mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Jousting rebalanced to favor players more. A lot of improvements will follow in the upcoming patches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Opponent lords' decisions were fixed so they no longer endlessly kidnap maidens and call for tournaments in mid-late game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Visual cue for catapult tension added in siege",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Siege aiming precision reworked to reduce the feeling of randomness",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Aiming in sieges with the mouse wheel should work now",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Marrying a saved Saxon fair maiden now adds a Saxon land to your territories (if there is a Saxon land you don't own, and it doesn't have a major castle on it)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Random events appear more evenly, and no longer appear twice in a row",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Kingdom mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Raid speed was decreased for every difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Parrying combo progress in raids is no longer being reset on losing a roll",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Timed events have one more month to be completed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A bug causing time event counters to skip several months after fleeing battle was fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The minimum deck size is now 8 cards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The cursor is now locked inside the game window in minigames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Stability and performance were improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you for playing Defender of the Crown: The Legend Returns, and as always, we appreciate your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "– The Black Tower Basement and Nordcurrent Labs teams",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
