 "releases": [
  {
   "id": "in-stars-and-time-194696@post-2026-11-22",
   "gameId": "in-stars-and-time-194696",
   "displayName": "Reverting to earlier build",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-11-22T02:41:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are aware of some issues with the latest build.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate people sending in bug reports and issues with the localization. We're asking In Stars and Time's publisher to review the localization with TransPerfect, and will follow up when we have more information. We can confirm our contract includes a clear full human localization, and a clause not to use AI at all on this project, but obviously there are other quality issues present. Thanks to everyone for their input and patience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you'd like to check out the french loc nonetheless, follow these steps:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Right click on ISAT, click on Properties",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42149522/77ca07da6d2599e578e923c4211bc551d865533d.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Go to \"Game Versions & Betas\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42149522/468304a39e90247801d4b17a9764a2cf08069e8c.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Enter the password \"frenchbranch\" and click \"check code\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42149522/a3d1e17e48a5027f62756a64bc31ef13b67b3e99.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-And opt in! Your saves should follow with the new build as well. To go back to the default branch, follow the same steps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Once again, thank you for your patience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
