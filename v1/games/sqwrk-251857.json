  {
   "id": "sqwrk-251857@post-2025-04-28",
   "gameId": "sqwrk-251857",
   "displayName": "fixed problem recording challenges on tower 5",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-04-28T08:02:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "On tower 5 it wasn't recording that the level was cleared after you got all the challenges to count towards unlocking the extra level. If you've already got the challenges in that level you will have to play it through again for it to count. you don't need to actually do the challenges again but you have to clear the level by coming in at least third place",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
