  {
   "id": "sqwrk-251857@post-2025-06-06",
   "gameId": "sqwrk-251857",
   "displayName": "Fix to desert 4 registering as cleared",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-06T10:21:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "for the game to register levels as cleared in order to unlock the extra level it's supposed to save this information when you finish the level after you've completed all of the challenges. This wasn't working for desert 4. If you've previously obtained all the challenges you will need to play the level through one more time for it to count towards unlocking the extra level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
