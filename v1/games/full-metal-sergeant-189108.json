  {
   "id": "full-metal-sergeant-189108@major-2023-05-22",
   "gameId": "full-metal-sergeant-189108",
   "displayName": "Update Platoons",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-22T06:40:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New update rolled out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Platoons revamp",
     "items": [
      {
       "text": "Bravo, Charlie and Delta platoons were not widely used and so they have been completely revised. Each now offers a unique bonus that adds a layer of strategy to the mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bravo: Can call a medevac at anytime to end the mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Charlie: Add a recruit as a reserve; they join a platoon if a comrade dies or flees.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Delta: A recruit can be promoted to Elite before going to mission (+Damage and always in cover).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Those platoons were moved to the second tier of the skill tree. The Head and Kitchen locations have been moved down to the first tier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(The purchase of previous platoons has been reset. Prestige will be refunded and the new platoons can be bought again)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New events at the gate",
     "items": [
      {
       "text": "Family Visit (season 2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sharpshooters (season 3)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Museum curator (season 4)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "(The Official Guide will be updated in the next few days).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Custom names",
     "items": [
      {
       "text": "It's now possible to define custom names for the recruits. In the Options menu you'll find two new buttons, one for exporting the template file and the other for importing it. The template is a simple text file with all the names listed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Refer to the Official Guide for the complete instructions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Rules",
     "items": [
      {
       "text": "Max names 73",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Max name length: 12 characters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Only supported languages characters are allowed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Please keep in mind this feature is in beta, so report any bug you'll find. ).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Added a second leaderboard to keep track of missions accomplished.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a text explaining that the ungraduated recruits won't be deployed to the mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a text telling if no MOD has been assigned to a recruit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Journalist event: Added Prestige if you choose not to give the interview.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug in which the game would crash in the Options menu if played offline.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
