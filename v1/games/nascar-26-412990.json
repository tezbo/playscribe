   "id": "nascar-26-412990@post-2026-11-13",
   "gameId": "nascar-26-412990",
   "displayName": "Patch Notes - November 13",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-11-13T20:07:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added Logitech TRUEFORCE wheel support. It is recommended to use G HUB or the wheel's built-in screen to adjust settings, except for wheels without screens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted Safety Violations to allow for faster bump drafting at super speedways",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed issue where chase drivers would not enter some races in The Chase",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
