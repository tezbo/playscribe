       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Schedule tab in Career no longer overlaps other tabs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Practice/Qualify/Race pre-race display text no longer overlaps when filled with a high number of entries.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made some text format and spelling corrections in various Career messages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for car hitching when driving off pit road.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
