  {
   "id": "nascar-26-412990@post-2026-10-23",
   "gameId": "nascar-26-412990",
   "displayName": "Patch Notes - October 23",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-23T18:04:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Updated driver ratings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Updated AI drivers with DLC paint schemes to use the correct paint schemes for specific events",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• The Peak Performance graph now correctly reflects braking power",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed issue where two ARCA employees shared the same portrait",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Slight rear body damage can now be repaired when it is the only damaged part of the car",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed issue where the \"# Laps to Go\" message was persisting after restarting a race",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
