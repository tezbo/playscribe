   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fix for crash that could occur when resuming multi-series races in Career.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for crash that could occur after receiving \"Breaking News\" in Career.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for online home screen sometimes showing zeros for number of lobbies and racers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with center spring not functioning properly on some wheels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Chase now displays the correct X/Y race count in Career.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Multiplayer loading spinner (when refreshing lobbies) is now a darker color so it is more easily seen.",
