  {
   "id": "the-jackbox-party-starter-207095@post-2022-07-21",
   "gameId": "the-jackbox-party-starter-207095",
   "displayName": "Introducing QR code login!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-07-21T21:57:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Gone are the days of having to manually type in your room code. We're happy to introduce QR code login, a brand new feature for our games to The Jackbox Party Starter!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've also patched in other bug fixes and performance issues, such as the minigame error in Trivia Murder Party 2 where you can cut a finger you've already cut in a previous punishment. Not a sentence that we ever expected to include in patch notes, but there you have it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, if you see an issue in one of our games, let us know by submitting a ticket at help.jackboxgames.com.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
