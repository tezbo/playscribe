  {
   "id": "faye-falling-189136@1.08",
   "gameId": "faye-falling-189136",
   "displayName": "Patch 1.08",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-08-02T04:59:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Resolution tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Lowered the max resolution to avoid lag on high resolution displays",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Picks a better default resolution (1 beneath the max)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Resetting the settings now sets to the default resolution value",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Small Fixes (from the 1.07 patch)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed a rare bug where the player's turn might not skip if the smile enemy flees before all enemies are defeated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed some typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Other small tweaks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
