 "releases": [
  {
   "id": "faye-falling-189136@1.4",
   "gameId": "faye-falling-189136",
   "displayName": "Update 1.4",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-08-25T21:37:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Faye Falling version 1.4 is out now! This update includes an important bug fix related to the PC version of Challenge Mode, as well as some new rings, a new ring shop, clearer tutorials/guidance near the start of the game and lots more! The game is also 40% off for the next two weeks!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "New Rings",
     "items": [
      {
       "text": "8 new rings have been added. These give battle strategies a lot more variety - especially against enemies with a 100 speed stat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rage Ring: When hit by an enemy with 100 speed, all your stats will buff.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Steady Ring: When hit by an enemy with 100 speed, you'll gain 3 mana.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sturdy Ring: When hit by an enemy with 100 speed, you'll take 1 less point of damage. (If you can reduce their damage to 0, it'll count as an evade, and you'll get to counter-attack them!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Grit Ring: If you fail evading an attack or hit by an enemy with 100 speed, you'll still counter-attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Spike Ring: Enemies will take another point of damage from ailments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Focus Ring: When you evade an attack, you'll buff your attack stat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Shield Ring: When you evade an attack, you'll buff your defense stat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Blood Ring: When you evade an attack, you'll buff your critical stat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Ring Placements",
     "items": [
      {
       "text": "Changed the library puzzle reward from a Limit Fruit to a Rage Ring.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added some of these new rings to merchants across the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Five's Ring Shop",
     "items": [
      {
       "text": "After buying the Power Gauntlet, Fives will now give you access to his ring shop. He'll sell all the new rings, as well as some other important ones.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You'll be able to steal from him like other shops if you're on the Parasite gameplay path.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved the original Mercy trader in Five's room to the cavern's final puzzle room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an NPC who mentions Fives near the 3rd target puzzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed the new 1.3 Steam version of Challenge Mode miscounting two puzzles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Shop, Spell and Skill windows overlapping the scroll sound when scrolling past the top or bottom selection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the moving targets spawning particles even when the game was paused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Early Tutorials and Guidance",
     "items": [
      {
       "text": "The game now guides the player a little bit more at the start of the game, without crossing the line into being too modern and hand-holdy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stronger Battle System Guidance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The battle tutorial now clearly says you must use the letter and arrow keys, or face buttons and the analog stick, to cast spells.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made the direction input icons full arrows.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When a combat spell is used outside of battle, the narration now says, \"You can only use healing spells outside of battle.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stronger Chapter 2 Guidance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The dash ability receive window now mentions it can be used to break objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a lost spirit in Normal mode by the white crystals. They wonder how to break through them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a hint sign near the white crystals (this might be too hand-holdy...let me know!).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The dash crystal narration now says \"break through\" instead of \"break.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The hint sign in the glowing sword puzzle now has a marker in the GUI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Missed dashes into the glowing swords that are still somewhat close now read as a hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a sign to the start of the Desert: Dunes area warning that stronger enemies are ahead, and that players should heal and save between them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Blessing key items now use condensed forms of the tutorial window descriptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "Players start with 3 more HP points in Normal mode to help them avoid early game overs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made the main save point in the Desert: Final Puzzles area a healing point.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added two new save points that will avoid potential moderate losses of progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The Ability Break spell now costs 12 mana instead of 10.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Cut two forced flame battles from Chapter 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced the HP of two enemies in Chapter 2 slightly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted some Challenge Mode evade patterns to make them more fair.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "GUI",
     "items": [
      {
       "text": "The way HP bars, etc., are drawn was changed to use sprites instead of geometric shapes. This keeps the way elements are drawn consistent across platforms and graphics cards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Visuals",
     "items": [
      {
       "text": "Made the border black in the sequences before and during the start of the abyss area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the jumpscare visual; it now foreshadows the ending.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Signs",
     "items": [
      {
       "text": "Added HUD markers to direction and town signs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added some direction signs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Steam Page",
     "items": [
      {
       "text": "Updated some assets to a higher resolution.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Puzzle Walkthrough Video",
     "items": [
      {
       "text": "I also made a complete guide to solving all 24 puzzles, which you can find here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I want to keep the Steam and console versions as close to parity as possible, so this might be the final update - although I'll of course fix any bugs that pop up. (Just let me know if you run into any issues on the community forums.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As far as my next project goes - I'll have some cool news soon...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
