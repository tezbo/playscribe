  {
   "id": "beholgar-ii-350035@post-2025-12-02",
   "gameId": "beholgar-ii-350035",
   "displayName": "About first day bugs!!!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-12-02T12:04:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First of all, thank you so much for supporting the game on its launch day. I’m aware that some bugs and unexpected issues have appeared. Since I’m a solo developer, a few things may have slipped through the cracks, but don’t worry—I’m working hard to fix them as quickly as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
