  {
   "id": "hidden-through-time-2-myths-magic-247907@1.0.95",
   "gameId": "hidden-through-time-2-myths-magic-247907",
   "displayName": "Patch 1.0.95",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-20T14:43:15.000Z",
   "notes": [
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue for Ultrawide monitors where certain UI elements in the Architect Editor were covered by other UI elements.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue for Ultrawide monitors where the loading screen animation did not properly fit on-screen.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue for Ultrawide monitors where the Main Menu UI elements were covering each other.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue for Ultrawide monitors where the Era Select and Level Screens were not displayed properly.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where tooltips for Online Map entries were rendered underneath the scrollbar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the “Edit” button in Architect Play Mode was not placed correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where filters for Online Maps were not being applied properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where flipping Characters or Animals in Architect would break their Walking animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some maps could not be saved due to an error.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Time Shift VFX would not be properly displayed on certain Aspect Ratios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with VFX objects causing them to use incorrect layering.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a UI issue in the Save and Load windows where labels would clip the scrollbar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where selecting objects in Architect would not play a sound.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where using the “Find in Scene” feature in Architect could break the ability to select objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where some Achievements unlock earlier than intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Containers and Structures will now close automatically when uploading a map after successfully completing it in Architect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Navigation and Zoom controls have been improved for Controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The hitboxes for animals and characters have been adjusted to better match their graphics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an interaction range slider in the gameplay options which allows you to click a bit further from an object and still interact with it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
