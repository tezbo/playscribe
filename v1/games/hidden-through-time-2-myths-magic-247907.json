  {
   "id": "hidden-through-time-2-myths-magic-247907@1.0.142",
   "gameId": "hidden-through-time-2-myths-magic-247907",
   "displayName": "Patch 1.0.142",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-21T13:02:16.000Z",
   "notes": [
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Certain UI elements that were missing localization have been updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an incorrect UI prompt when attempting to follow yourself after playing an Online Map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some online map hints being assigned to the wrong objectives.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Controller support has been greatly improved, adding shortcuts to certain actions and displaying prompts when controller input is detected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several optimization features have been added to improve performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Certain languages have had their localization improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the maximum number of placeable objects in Architect from 4000 to 2500 to ensure more stable and performant online maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced the maximum number of placeable Animated Characters in Architect from 500 to 100 to ensure more stable and performant online maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
