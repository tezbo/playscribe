  {
   "id": "the-bridge-curse-2-the-extrication-244573@major-2024-05-11",
   "gameId": "the-bridge-curse-2-the-extrication-244573",
   "displayName": "Problem solved: SteamDeck black screen/black screen after PC update/sound stuck",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-11T07:17:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The development team is in full swing testing and repairing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The current SteamDeck black screen/black screen after update/sound freeze solution",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We will provide steamdeck-vp9 codec version for players to choose from.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "This version is also suitable for PC players who have a black screen after the update.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Players can adjust the settings according to their own working environment and hardware equipment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Choose the right version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Operation method",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Collection Library",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Bridge Curse 2: The Extrication right click->Properties->Betas->Select Steamdeck - vp9 codec",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We apologize for any inconvenience caused to players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Bridge Curse Development Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
