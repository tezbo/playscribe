  {
   "id": "the-bridge-curse-2-the-extrication-244573@post-2024-10-24",
   "gameId": "the-bridge-curse-2-the-extrication-244573",
   "displayName": "Halloween Patch Notes",
   "kind": "dayOne",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-24T14:50:23.000Z",
   "notes": [
    {
     "title": "Hey everyone!",
     "items": [
      {
       "text": "Today is an exciting day as we officially launch the game on consoles, and we’re bringing this patch to the PC version to ensure it’s in line with the console release. This update focuses on improving the overall gameplay experience, fixing some minor bugs, and introducing a few quality-of-life tweaks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Highlights for Update Ver.1.7.2",
     "items": [
      {
       "text": "System",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated the video codec.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimisation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced the spatial perception of the voice and sound effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated the game's credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimised multiple UI button prompts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimised Localisation for several languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimised memory usage for textures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an error where the master tape became uninteractive after loading a saved game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an error where 'The Dark One' did not see A-Hai in specific situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where videos would play before being revealed properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed subtitles that were not properly closed during calls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We’re committed to making The Bridge Curse 2 the best experience possible, so keep your feedback coming! Let us know how you’re finding the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "— The Bridge Curse 2 Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
