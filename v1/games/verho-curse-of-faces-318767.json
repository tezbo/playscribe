      },
      {
       "text": "Starting Class Equipment got slightly changed: (mostly you will be getting more of items you would start with, Example Knight 1 hp potion is no 3 hp potions)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Small changes to start of rotten valley",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
