       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New statue in Caste Museum",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bpm Mgm ivl Bpm Nmiz: Main Changes-----------------------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Audio Mixing Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changing usable items with the mouse scroll wheel",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Changes to mid-game progression Now, to enter the lower city Barracks, you will first need to find the key in Foggy Borrows: New Settings-----------------------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "CRT Filter Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
