  {
   "id": "verho-curse-of-faces-318767@major-2025-06-23",
   "gameId": "verho-curse-of-faces-318767",
   "displayName": "BIG DEMO UPDATE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-23T21:02:28.000Z",
   "notes": [
    {
     "title": "Hello travelers to Yariv,",
     "items": [
      {
       "text": "As we work on the main game, we are implementing numerous improvements and moving closer to our final vision.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "However, we don't want to keep it from you, so we've decided to update the demo and give you a small glimpse of our work behind the scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The new demo contains",
     "items": [
      {
       "text": "New Content --------------------------------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reworked texture for almost every object in the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New and more polished tutorial (Black and White Forest)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New tree models in the forest area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improvements ------------------------------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improvements to Mask Altar UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Better scrolling in menus with the mouse scroll",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Better display of shield's passive defence in inventory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changes -------------------------------------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Broken Sword received a damage and reach buff",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Barrels' durability changed: 150HP --> 70HP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Burn and poison deal more damage to enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Glitches -------------------------------------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Brawler ring HP decrease bug fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Play the new demo for yourself and let us know what you think - either as a Steam review or in our active Discord: https://discord.com/invite/drJzkyDeBa",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "I wish you great adventures in Yariv!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45048979/2f3fbb78ba80f3c46c4a3d0049622a8236b216f9.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
