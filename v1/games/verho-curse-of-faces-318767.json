      },
      {
       "text": "Display of status effect improved for a few late-game bosses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Custom Elemental Icons for weapons that use more than one elemental damage type",
       "ps5ProOnly": false,
