       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disable Camera Shake when attacking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disable loop sounds of weapon buffs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FOV option increased to 110 (might be a bit buggy beyond 75): Improvements-----------------------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes to Sorelia's subtitles",
       "ps5ProOnly": false,
