  {
   "id": "constance-258950@1.0.2.77733",
   "gameId": "constance-258950",
   "displayName": "Patch 1.0.2.77733",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-26T21:17:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Our first post-launch patch just went live! We tried to address all of the most pressing issues you all reported so far.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed black screen when starting a new save file on some devices",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed videos not playing on some Steam Decks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Minimap not being rebindable on controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Unstable Bubble no longer travels with elevators",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent paint clone pogo cheese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lord Koba softlock fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed softlock in Journal when exiting during certain popups",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Violin Flashback improvements (feedback for ending notes early, button prompt fixes)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed spelling errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Disabled code stripping (relevant for modding support)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A bunch of additional fixes and tweaks here and there",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for helping make Constance the best game it can be! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
