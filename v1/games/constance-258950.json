  {
   "id": "constance-258950@2311161734",
   "gameId": "constance-258950",
   "displayName": "Patch 2311161734",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-11-17T11:12:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As we showcase Constance at Vienna Comic Con this weekend, we're releasing a small update for the demo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The main change is with the Slice mechanic – now, it activates instantly without needing to enter aim mode. Let us know what you think!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reworked the Slice ability to trigger instantly.: The slice destination is now indicated by a purple arrow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced slice cooldown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Wall hits now come with added knockback effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Allow jump cancel during melee attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced projectile knockback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved camera movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A bunch of changes under the hood (engine update, new audiosystem, etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
