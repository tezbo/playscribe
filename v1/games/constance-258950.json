  {
   "id": "constance-258950@2309051032",
   "gameId": "constance-258950",
   "displayName": "Patch 2309051032",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-09-05T09:38:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Introduced \"Speedrun Mode\", which can be activated via the Settings Menu. When active, the current time is always displayed in the top-right corner.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Accessing the Settings Menu no longer pauses the Speedrun timer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Speedrun timer now pauses during level loading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added D-Pad support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "improved clarity of the selected option on the Game Over screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The current build version is now displayed in the bottom-left corner of the start menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed \"Respawn\" Button from Settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After respawning, Constance will now gain a few invincibility frames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
