  {
   "id": "constance-258950@post-2024-09-26",
   "gameId": "constance-258950",
   "displayName": "Constance at Tokyo Game Show!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-09-26T17:02:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Exciting news! We're showcasing Constance at the Tokyo Game Show this week—come say Hi! 💜",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Along with this, we've just rolled out a patch adding Japanese and Simplified Chinese translations to the current demo! 🎉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch notes (0.2.3.69486)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Japanese & Simplified Chinese translations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where dives were sometimes not chained together correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
