  {
   "id": "constance-258950@1.1.1",
   "gameId": "constance-258950",
   "displayName": "Patch 1.1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-28T09:56:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we've just released Patch 1.1.1 on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "This update includes a wide range of performance improvements we implemented for Constance's upcoming console release on May 1st (Switch, PS5 & Xbox Series X).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "It also restructures how the game's files are bundled, which will decrease patch sizes in future updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here is the full list of changes (more technical this time, as this update does not include new gameplay features):",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes 1.1.1.17398",
     "items": [
      {
       "text": "Migrated asset management to Addressables. This should significantly reduce patch sizes going forward, as assets are now split into smaller packages. We no longer need to repackage the entire game (including all textures and SFX) when making small changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tons of improvements to memory allocation and overall performance across the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game no longer crashes on GPUs without compute shader support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that caused the game to freeze on some PCs when taking a Snapshot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Joker death VFX triggering when defeated outside of its vulnerability phase",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed PuppetHand StringAttack damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Additional minor bug fixes and translation improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing! <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
