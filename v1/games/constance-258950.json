  {
   "id": "constance-258950@0.2.1",
   "gameId": "constance-258950",
   "displayName": "Patch 0.2.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-09-10T12:04:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hiii,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we just released a new demo update on Steam! It’s mainly a collection of fixes and tweaks based on community feedback and issues we noticed during Gamescom.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Check it out! 🙂",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Low Health Effect (visuals & audio) now fades out over time, maintaining the initial impact but gradually fading into the background if you can't heal quickly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the Corruption/Low Health vignette displayed a large black blob in the center of the screen on some devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed stab direction input when using the D-Pad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed collision issues (player being crushed when dash at a wall, bonking the ground after a dive, hitting a horizontal secret wall with an upward stab).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the speedrun timer not restarting properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor level design adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various minor visual fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
