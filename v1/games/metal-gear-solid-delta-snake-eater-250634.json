   "id": "metal-gear-solid-delta-snake-eater-250634@1.2.3",
   "gameId": "metal-gear-solid-delta-snake-eater-250634",
   "displayName": "Update 1.2.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-20T08:20:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ver. 1.2.3 is now live as of November 20, 2025.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Ver. 1.2.3 Update Details",
     "items": [
      {
       "text": "Main Game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Minor bug fixes and adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FOX HUNT",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ Added ability to place enemy detection pings while aiming with a knife or gun.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44190330/17c0f74d07bfe8b2b09d9f8db8017058f05fb4e8.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ XP can now be earned in custom matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ Players will now be matched with others from different regions when matchmaking on their current server takes too long.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ Extended the duration of invincibility after respawning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ Fixed an issue where invincibility after respawn was canceled by rolling or using Naked Sense.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ Minor bug fixes and adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Future updates will be announced as soon as they are finalized.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
