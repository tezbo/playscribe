   "gameId": "metal-gear-solid-delta-snake-eater-250634",
   "displayName": "Update 1.1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-08T07:02:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ver. 1.1.3 is now live as of September 8, 2025(JST).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This update includes the following improvements and fixes",
     "items": [
      {
       "text": "Additional Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added Inverted Camera Look (Horizontal) option. (This setting can be found in the Options menu under Controls.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44190330/02b101161a384d81d5729ec3d302ffc331b31bc6.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players might not receive the reward for collecting all GA-KO.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated textures and models in certain scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved most issues that could cause the game to crash after investigating received reports.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor bug fixes and adjustments.",
