  {
   "id": "metal-gear-solid-delta-snake-eater-250634@1.1.4",
   "gameId": "metal-gear-solid-delta-snake-eater-250634",
   "displayName": "Update 1.1.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-25T06:25:43.000Z",
   "notes": [
    {
     "title": "This update includes the following improvements and fixes",
     "items": [
      {
       "text": "Fixed an issue where Snake’s voice lines would sometimes play in English regardless of the selected language settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some characters and animals would sometimes disappear during certain cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Snake’s Japanese and English voice lines would swap in certain cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players could become unable to climb onto rocks at certain moments during the battle with The Pain.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor bug fixes and adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Details on upcoming updates will be communicated once they are finalized.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
