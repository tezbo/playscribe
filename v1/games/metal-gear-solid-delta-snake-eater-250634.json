  {
   "id": "metal-gear-solid-delta-snake-eater-250634@1.2.1",
   "gameId": "metal-gear-solid-delta-snake-eater-250634",
   "displayName": "Update 1.2.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-30T01:54:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ver. 1.2.1 is now live as of October 30, 2025.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The main changes implemented in this patch are as follows.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "・ The online multiplayer mode FOX HUNT is now live. [img src=\"{STEAM_CLAN_IMAGE}/44190330/4061ecf2ac712ca2dade5f305469a48d4b1bb014.png\"]",
     "items": [
      {
       "text": "Please refer to Steam News for more details on FOX HUNT.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please click here for more details on FOX HUNT.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "・ Implemented support for 21:9 Aspect Ratio Displays.",
     "items": [
      {
       "text": "16:9 Display（Captured at 1920x1080）",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44190330/bfe3f125f387b711ba7e804f9853358770f5cafc.png\"]",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "21:9 Display（Captured at 3440x1440）",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44190330/73cb692824e785ec14e42f0aa1ee4e158b2e9d40.png\"]",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "*On certain screens —such as cutscenes and menu displays— the aspect ratio will be locked to 16:9 regardless of your system settings or display environment.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "*Some UI elements will remain positioned as they are in the 16:9 layout.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "・ Added the option to fix camera distance settings when playing in New Style.",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44190330/e96f860da1c612d5bec0ea5ebd968117acf87044.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "・ Introduced an in-game feature that allows players to view their system environment.",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44190330/2535f8067e19d2c783e42735de864a9e18315d89.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "3. Bug Fixes",
     "items": [
      {
       "text": "Improved overall performance stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue where background music would not play during certain cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a timing mismatch between user actions and background music ending.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected an issue that occasionally prevented specific actions by Raikov from triggering.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Implemented minor bug fixes and general adjustments.: We will provide further update information as soon as it becomes available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
