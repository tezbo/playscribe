  {
   "id": "metal-gear-solid-delta-snake-eater-250634@1.1.2",
   "gameId": "metal-gear-solid-delta-snake-eater-250634",
   "displayName": "Update 1.1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-08-28T09:23:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ver. 1.1.2 is now live as of August 28, 2025.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This update includes the following improvements and fixes",
     "items": [
      {
       "text": "Resolved an issue where performing consecutive survival knife attacks to secure food could cause the game to crash under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where removing the Crocodile Cap from the Survival Viewer while equipped could cause the game to crash under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Addressed crashes that could occur when collecting food near a hungry crocodile under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected an issue where transitioning from a roll into a crawl could cause the character model to float in mid-air.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where player movement could become restricted under certain conditions in areas where Intrusion View is used.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue where the game could crash under certain conditions while in Radio Window.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We’re grateful to have so many players enjoying the game and sharing valuable feedback and issue reports. Please rest assured that we are actively investigating and addressing all reported concerns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We’ll share further updates as soon as they become available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We’ll share details about upcoming updates as soon as they’re confirmed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
