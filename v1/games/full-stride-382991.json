  {
   "id": "full-stride-382991@01.023",
   "gameId": "full-stride-382991",
   "displayName": "Update 01.023",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-11-07T12:43:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "【Update Information】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update fixed several issues related to owned horse race entries, race records, in-race parameter calculations, and in-game dialogs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where owned horses could sometimes not be entered into races",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where race wins were not recorded correctly for some owned horses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where Sprint and Stamina calculations could be incorrect while drafting behind other horses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the save dialog could remain on screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the dialog shown when the Ranch was full and a horse could not be moved would remain on screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please update the game to the latest version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can check the current version number from the Options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
