  {
   "id": "full-stride-382991@1.00.1.010",
   "gameId": "full-stride-382991",
   "displayName": "Update 1.00.1.010",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-18T23:14:52.000Z",
   "notes": [
    {
     "title": "The main changes are as follows",
     "items": [
      {
       "text": "■ Multiplayer Stability Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added safeguards against an issue that could cause horses to continue spinning in circles when players joined around the start of a race",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue that prevented players from joining another room after a failed connection attempt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added error dialogs when joining a room fails or when a room is disbanded during a session",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Additional Fixes for the Sudden Deceleration Issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted collision detection to reduce the likelihood of horses becoming stuck or overlapping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a minimum-speed safeguard to reduce the impact if the issue still occurs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
