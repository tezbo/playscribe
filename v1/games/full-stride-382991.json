  {
   "id": "full-stride-382991@01.013",
   "gameId": "full-stride-382991",
   "displayName": "Update 01.013",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2026-07-24T02:23:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "【Update Information】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update includes a specification change related to support for edited horse data, along with the following improvements and fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Specification Change",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Horses whose data falls outside the game’s active loop period will now appear as active racehorses from the age of two",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Restored the weight display on the Negotiate screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added game version information to the Options screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where spectators were not displayed at Kyoto Racecourse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the BGM volume could become unusually low in certain environments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
