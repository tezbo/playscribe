  {
   "id": "full-stride-382991@01.017",
   "gameId": "full-stride-382991",
   "displayName": "Update 01.017",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-08-07T02:09:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "【Update Information】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update includes expanded in-game guides, a new multiplayer feature, and the following improvements and fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ New Features and Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Expanded the in-game guides",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added guides explaining each screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Revised the controls guide",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Revised the race guide: ・Discontinued the PDF manual previously included with the Steam version following the expansion of the in-game guides: ・Added a Private Code feature to multiplayer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players who set the same code in the Options screen will only be matched with each other: ・Added a display showing the highest class currently available through Negotiate based on the player’s Jockey Points: ■ Bug Fixes: ・Fixed calendar-related issues, including incorrect weekday displays during certain weeks: ・Fixed an issue where Race 1 could be held again after Race 12: ・Fixed an issue where some parameters were displayed incorrectly on the two-year-old horse entry screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
