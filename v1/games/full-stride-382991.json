  {
   "id": "full-stride-382991@1.00.1.009",
   "gameId": "full-stride-382991",
   "displayName": "Update 1.00.1.009",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-17T14:19:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1. Adjusted slowdown behavior when an NPC horse cuts in front",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The automatic slowdown that occurred when an NPC horse moved in front of the player has been removed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Instead, the player will now slow down slightly each time they make contact with a horse ahead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Fixed an issue that could prevent progress in post-race Replay Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where repeatedly switching between the Results screen and Replay Mode after a race could prevent players from returning to the Results screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "3. Changed the default Quality setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The default Quality setting in System Settings has been changed from “High” to “Medium.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Adjusted the “High” Quality setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PS5-specific optimizations have been applied to improve overall performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    }
   ],
