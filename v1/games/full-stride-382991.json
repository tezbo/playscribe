  {
   "id": "full-stride-382991@01.018",
   "gameId": "full-stride-382991",
   "displayName": "Update 01.018",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2026-08-08T03:08:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "■ Changes and Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Horses will now be promoted in class when finishing second in a graded race",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted the weight calculation system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added Steam Cloud support",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Changed the Niigata 2000m course to use the outer course",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The radar will now continue to function after crossing the finish line",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Improved the radar display to make the player’s horse easier to identify",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue with LR button selection controls in the Ranch scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where some races, including the Ibis Summer Dash, could not be selected through Negotiate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed collision detection around the starting position of the Kokura 1200m course",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the horse could no longer decelerate when Motivation reached zero",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
