  {
   "id": "full-stride-382991@01.021",
   "gameId": "full-stride-382991",
   "displayName": "Update 01.021",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-09-27T19:38:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "【Update Information】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update includes an Unreal Engine upgrade, improvements to replay cameras and NPC race scheduling, along with the following fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Adjustments and Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Updated Unreal Engine to version 5.8",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As part of the engine upgrade, frame rate stability has been improved, particularly during races: ・Changed the replay Spectator Camera to a more broadcast-style race camera: ・Adjusted NPC horse race selection logic and the interval between races: ■ Bug Fixes: ・Fixed an issue where horse numbers could become mismatched when selecting a camera during replays: ・Fixed an issue with the “10 G1 Wins” requirement for each running style, where only wins achieved with horses in the player’s stable were counted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "G1 wins achieved with horses ridden through Negotiate will now also count toward the requirement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
