  {
   "id": "mars-2120-154293@major-2023-02-07",
   "gameId": "mars-2120-154293",
   "displayName": "FIRST MAJOR UPDATE IS HERE!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-07T22:05:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After listening to community feedback, we brought several improvements to the game along with new content and new features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Check the update details",
     "items": [
      {
       "text": "Up to 90 minutes of new content. Start your journey through the MARS colony or pick up Charlotte’s adventure where you left off and find out what's new!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bosses: Three new threats will get in Charlotte's way. Discover each of them's weaknesses and use your skills wisely to defeat them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Skills: New skills will be available for the player. With a new power in hand, Charlotte will be able to explore new areas of the MARS Colony.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Accessibility: Accessibility options have been added to the game. Color blindness options, legend customization and map assistance. We are working to make MARS 2120 more accessible to more people.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Languages: now the game supports Spanish (text and audio).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Check out our social media and Steam page for more",
     "items": [
      {
       "text": "Twitter: https://twitter.com/qubytegames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord: https://www.discord.gg/qubyte",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Instagram: https://www.instagram.com/qubyteinteractive/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks everyone who supports MARS 2120. We hope you like the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And keep the feedback coming, this way we can keep improving the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
