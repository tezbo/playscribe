  {
   "id": "mars-2120-154293@major-2024-08-26",
   "gameId": "mars-2120-154293",
   "displayName": "MARS 2120 - First Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-26T17:02:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re thrilled to announce the release of the first Update for MARS 2120!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since our launch, the feedback from our players has been very positive. We are grateful for your support and excitement for future updates. With this first patch, we’ve focused on improving your overall gaming experience with some quality of life (QoL) changes and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Quality of Life (QoL) Updates",
     "items": [
      {
       "text": "Experience Warnings: We've added a warning if you lack sufficient experience to purchase an upgrade. Additionally, you’ll now receive a notification when trying to buy an upgrade with the “No Upgrades” option enabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unsaved Settings Warning: If you attempt to leave the settings menu without saving your changes, you'll now be prompted with a warning to prevent any accidental loss of customization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game Space Saved Notification: To keep you informed, a new notification has been added to indicate when your game space is successfully saved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Experience Notification for Yellow Orbs: Players will now receive a notification when collecting yellow orbs, giving clearer feedback on experience gains.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Final Cutscene Subtitles: Subtitles have been added to the final cutscene, ensuring everyone can fully enjoy the story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upgrade Availability Adjustments: We’ve made adjustments to clarify when upgrades are available or unavailable for purchase, reducing any potential confusion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Checkpoint Indicator Adjustment: The checkpoint indicators have been tweaked for better clarity and visibility during gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Audio Adjustments: We've made several audio tweaks across the game to enhance immersion and overall sound quality.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Text Localization Fixes: Various text localization issues have been resolved, ensuring a more consistent experience for players across different languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re committed to continuously improving MARS 2120 and are excited to bring you even more updates in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
