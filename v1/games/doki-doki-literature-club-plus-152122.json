  {
   "id": "doki-doki-literature-club-plus-152122@post-2022-06-23",
   "gameId": "doki-doki-literature-club-plus-152122",
   "displayName": "Patch Notes for 6/22/2022",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-06-23T00:14:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "These patch notes are for the Windows version of DDLC Plus. Updates for Mac and console versions are on their way and will be available soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various special effects in Act 2 and Act 3 were adjusted to be more accurate to the original game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where Natsuki's portrait would unintentionally flicker for a frame during her first CG in Act 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where in-game music loops and transitions were not handled correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a confirmation button for changing display settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the vertical alignment of text in dialogue boxes for some languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Support added to player name input for Steamdeck and Big Picture Mode",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
