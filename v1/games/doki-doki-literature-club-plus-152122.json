  {
   "id": "doki-doki-literature-club-plus-152122@major-2021-07-15",
   "gameId": "doki-doki-literature-club-plus-152122",
   "displayName": "Update Notes for 7/15/2021",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-07-15T22:01:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a bug with Steam cloud saves that could cause progress to be lost",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug where special poems may show up in English when language is Latin American Spanish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that could cause a softlock when saving into a save slot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed \"Stories of Friendship and Literature\" not displaying in the Jukebox when unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved procedure for special poem unlocks to randomize the chosen poems upon choosing New Game and prevent duplicates from being shown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug that that could cause content warnings setting to revert to an old setting when choosing New Game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added more supported resolutions for non-16:9 aspect ratios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some audio sync issues during the Act 2 fight between Natsuki and Yuri",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused save slot time codes to display as GMT after quitting and reloading the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the requirement for 100% completion that required choosing \"Yes\" for Yuri at the end of Act 2: Thank you to everyone who has submitted bug reports thus far! We are aware of additional issues not addressed in this patch, and our team is still investigating and fixing them. Please continue to submit tickets via our Bug Submission Form",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Additional notes",
     "items": [
      {
       "text": "Some users have reported issues with their mouse/controller setup that causes left or down inputs to constantly be registered. We are still looking into this issue. If submitting a ticket about this item, please include as much info as you can about what USB devices you have plugged in and what type of controller you're using.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We have seen a few reports of crashes or errors when starting the application. Some of these issues may be hardware or environment specific, but we are still investigating to look for potential fixes. Please provide a .zip folder with logs in your report whenever possible, as explained in the bug submission form. Additionally, if possible, please include the following information about your setup: operating system (ex: Windows 10), RAM (ex: 16.0 GB), and CPU/Processor",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
