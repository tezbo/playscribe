   "id": "doki-doki-literature-club-plus-152122@major-2021-08-02",
   "gameId": "doki-doki-literature-club-plus-152122",
   "displayName": "Update Notes for 8/2/2021",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-08-02T22:29:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a save-related bug that could prevent progression after the end of Act 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a game-freeze that could occur when exiting to main menu during an Act 2 choice",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a camera zoom bug when changing aspect ratio from 16:9 to 16:10",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a file-related bug that could prevent the player from progressing past Act 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a memory leak that could cause a potential crash in the Act 2 weekend scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with DDLC credits music cutting out too soon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Using F12 to take a screenshot no longer re-shows UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some UI problems on ultrawide resolutions",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some problems that could occur when naming the main character \"Monika\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
