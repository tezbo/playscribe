       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Light fixture near Elevator now turns off during Power Outage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added back up saves",
       "ps5ProOnly": false,
       "pcOnly": false,
