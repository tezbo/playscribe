      {
       "text": "Fixed bug that prevented the 2nd phone call from triggering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for deciphering puzzle bug on controller and PS5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
