      },
      {
       "text": "Removed Syracuse thought on game score sheet in the break room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug with toggle text for open newspaper in the break room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
