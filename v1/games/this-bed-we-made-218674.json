  {
   "id": "this-bed-we-made-218674@post-2023-11-03",
   "gameId": "this-bed-we-made-218674",
   "displayName": "Patch Notes for November 3rd, 2023",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-11-03T17:49:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added more supported resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed various localization issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various asset issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the ability for the 0 on the numpad to trigger the game's ending.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Blocked all input during the Consequences Warning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevented the \"Game completed\" achievement from triggering when talking about the chocolate shoe to Andrew.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ensured both Eugene achievements don't trigger simultaneously.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated the hint after opening the chest in 507 so Sophie always suggests calling the acolyte for help.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made letters in the typewriter case non-throwable until they've been read.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the uninteractable 509 safe bug that occurred after looking at the code.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted Sophie's dialogue about Bernard at the end of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed some journal entries.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the ability to exit the credits by pressing the pause button",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the physics of the telephone cord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
