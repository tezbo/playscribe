  {
   "id": "this-bed-we-made-218674@post-2023-12-20",
   "gameId": "this-bed-we-made-218674",
   "displayName": "Patch Notes for December 20, 2023",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-12-20T20:24:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed bug that caused the second phone call in room 505 to trigger too early",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that caused an acolyte \"\"ghost\"\" to appear when reloading a save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that caused Bernard to have his \"\"exasperated\"\" idle in inappropriate moments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that caused the vent puzzle to be blocked on the gamepad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that caused the Texas letter to reappear after throwing it away",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that caused the player to get stuck in the elevator in the lobby after loading a save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that caused lights to be off when loading a save from another part of the game during the power outage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed room 509 phone cord physics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed camera glitch at the end of the last phone call with Andrew",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the ability to put back the ice pick and the tip",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed fuse box behavior so it no longer automatically removes the ice pick from inventory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added \"Saving...\" UI when auto-saving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed various lighting bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
