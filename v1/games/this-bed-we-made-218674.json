  {
   "id": "this-bed-we-made-218674@post-2023-11-08",
   "gameId": "this-bed-we-made-218674",
   "displayName": "Patch Notes for November 7, 2023",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-11-08T01:46:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed various localization issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed collision and clipping issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed display mode issues in the Initial Settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed cursor offset issue that occurred with some screen resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the dog in the family picture in 507.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed condition problem that prevented the \"Live To Fix Another Day\" achievement from triggering.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ensured that clue selection is not possible on Candle Stash Plan until you’ve found the Candle Stash Note.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the interaction zone for the candle in the laundry room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed “Leslie Boswell” mistake from Sophie’s journal entry about the Adam or Eve pulp fiction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug with the saving and loading of the blood footsteps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing facts that led to Maurice talking about Paul first even though Beth was the acolyte.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
