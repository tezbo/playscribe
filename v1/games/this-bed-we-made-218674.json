      },
      {
       "text": "Various clipping fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed disappearing light in room 507",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted start position and camera distance for various objects in inspection mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted opacity of god rays in room 509",
       "ps5ProOnly": false,
