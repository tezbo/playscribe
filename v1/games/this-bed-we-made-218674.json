  {
   "id": "this-bed-we-made-218674@post-2024-02-27",
   "gameId": "this-bed-we-made-218674",
   "displayName": "Patch Notes for February 27, 2024",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-02-27T18:53:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The breakroom door no longer remains open in the basement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lipstick can still be opened after inspecting it and exiting immediately.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the vent puzzle issue that occurred when exiting the special inspection while adjusting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Local dialogue and eavesdropped subtitles now display correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The pendulum now moves in the basement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The tutorial no longer remains on screen after loading a save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's now possible to scroll through progression entries after switching between them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4K displays now automatically adjust screen percentage for enhanced performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Blood trails no longer persist after loading a game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The highlight on the typewriter case is removed upon opening.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sophie now only says \"You need a screwdriver\" if you interact with the screws.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The bench in the basement is no longer accessible for walking on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The laundry bag's interaction point is now correctly positioned.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The highlight for the deciphering puzzle has been made more visible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
