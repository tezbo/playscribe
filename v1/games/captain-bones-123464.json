  {
   "id": "captain-bones-123464@1.0.7",
   "gameId": "captain-bones-123464",
   "displayName": "Hotfix 1.0.7",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-08-02T13:45:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "When we finished the last mission, the game would crash if we were on a ship. This has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Landing on ships has been made more stable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When we called our crew back and bombed the enemy ship, our crew was also lost. This has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We could also injure our own crew on the enemy ship. This has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On our level 2 ship, the crew was destroyed while using our last ability permanently, but they were rescued.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While cursed, we were initially blinded. This has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Calculations on low display settings were displayed halfway on the screen. This has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game crashed when the captain in the last mission was captured. He has been repaired, and now he cannot be captured again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
