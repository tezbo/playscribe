  {
   "id": "captain-bones-123464@1.2.2",
   "gameId": "captain-bones-123464",
   "displayName": "Hotfix 1.2.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-08-25T12:49:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "When landing on an enemy ship, we couldn't always withdraw the crew at the desired time. Now, two actions are assigned to two different buttons. This allows both actions to be performed in any situation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A docking maneuver has been added when sending crew to land on an enemy ship. This ensures that ships moving away from the waves will remain close.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
