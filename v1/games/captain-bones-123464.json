  {
   "id": "captain-bones-123464@1.2.3",
   "gameId": "captain-bones-123464",
   "displayName": "Hotfix 1.2.3",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-09-07T12:54:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello sailors,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I've listened to your feedback, and in this small patch, achievements have been adjusted to more achievable levels. When you choose to continue the game from where you left off, the system will check all achievements and award the ones you've earned.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The changed achievements are listed below",
     "items": [
      {
       "text": "IntermediateBuilder --------- : 50 -> 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ExpertBuilder ---------------- : 100 -> 10",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IntermediateThief ------------ : 10 -> 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ExpertThief ------------------ : 100 -> 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IntermediateSharkHunter ---- : 10 -> 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ExpertSharkHunter ---------- : 100 -> 10",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IntermediateFishHunter ----- : 100 -> 50",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ExpertFishHunter ------------ : 1000 -> 100",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ExpertSurvivor -------------- : 100 -> 30",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ExpertMerchant ------------- : 10000 -> 5000",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FairPlay ---------------------- : Anyone -> Any Villiagers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
