  {
   "id": "captain-bones-123464@major-2025-10-03",
   "gameId": "captain-bones-123464",
   "displayName": "[Urgent Unity Security Update]",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-03T14:05:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ahoy, sailors! ⚓️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This morning, we received Unity’s advisory about a newly disclosed security vulnerability. We acted immediately and released a patched build of Captain Bones to address it. Steam should auto-update your game—no action needed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What’s in this update?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔐 Security: Fixes aligned with Unity’s latest guidance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎮 Gameplay & Saves: No gameplay/content changes. Your save files are safe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Why it matters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch protects game integrity and prevents potential exploits—keeping our ship watertight. 🏴‍☠️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "For the official technical notice from Unity, see",
     "items": [
      {
       "text": "If your game doesn’t update automatically, try restarting Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for keeping the winds at our back—see you on the high seas! ⛵️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
