  {
   "id": "captain-bones-123464@1.1.9",
   "gameId": "captain-bones-123464",
   "displayName": "Hotfix 1.1.9",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-08-09T09:24:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The total gold amount for merchant achievements now counts towards achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The shark in the sunken city now turns more sharply, eliminating the risk of wet bait.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The information for the key you need to hold down to surrender was missing from the screen. This has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The \"Expert Thief\" achievement has been removed due to the impossibility of stealing 100 times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fishing now allows you to catch 1 to 3 fish at a time, rather than just one. This allows for more efficient use of fishing time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
