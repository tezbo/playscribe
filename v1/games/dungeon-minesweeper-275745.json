  {
   "id": "dungeon-minesweeper-275745@post-2024-04-01",
   "gameId": "dungeon-minesweeper-275745",
   "displayName": "Dungeon Minesweeper Fix#1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-04-01T18:35:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Most of the bugs have been fixed!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DM LOG FIX#1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--Fixed Russian localisation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--Fixed background in menu for rare display resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--Fixed language changing if loading a save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--Fixed creation of different objects in 1 cell.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--Reducing the lifetime of particles during the destruction of the stone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--There is no longer an icon for the \"increase the viewing radius\" effect in the normal minesweeper mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--It is no longer possible to move while the menu is open.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--Fixed a bug that made it possible to dig blocks and attack enemies while you are in the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--Fixed shop text on small resolutions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--Shop is now available in any time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--Fixed bugs with downloading hardcore saves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--The achievement for the boss in hardcore mode has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--Fixed saving in hardcore mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--Now there will be no enemies in the starting location. You will survive!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
