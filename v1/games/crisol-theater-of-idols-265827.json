  {
   "id": "crisol-theater-of-idols-265827@1.0",
   "gameId": "crisol-theater-of-idols-265827",
   "displayName": "Hotfix 1.0",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-02-21T00:24:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all, thanks for your patience as we work towards addressing the feedback since launch. This initial hotfix aims to address some of the more urgent issues, and we're already hard at work on the next one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Loading Screen Added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A loading screen has been implemented to make players aware that the game is still running when level loading takes longer than expected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This resolves the issue where some players were seeing a black screen with the HUD visible in the top-left corner during loading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Demo Save Compatibility Fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve implemented a fix to prevent residual demo autosave files from being loaded when pressing Continue in the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Previously, this could result in a black screen because those demo autosaves were not compatible with the full release.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "With this fix",
     "items": [
      {
       "text": "Autosaves created before 2/10/26 will no longer be read.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "However, if you generated a new demo autosave after that date, you will still need to delete it manually or overwrite it by creating a new autosave while playing the base game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
