  {
   "id": "crisol-theater-of-idols-265827@1.3",
   "gameId": "crisol-theater-of-idols-265827",
   "displayName": "Patch 1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-25T17:01:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.3 has arrived for Crisol: Theater of Idols, bringing a host of improvements, optimizations, and fixes across all platforms on PC and consoles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch addresses community-reported issues, improves performance in key areas, adds support for additional monitor resolutions, and includes platform-specific enhancements across PC, Steam Deck, PlayStation 5 (v1.006.0) and Xbox Series (v1.0.6).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "Alongside today's update, we're excited to share our new Accolades Trailer, celebrating the incredible reception and support we've received since launch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Crisol is now OFFICIALLY Steam Deck Verified.",
     "items": [
      {
       "text": "No matter where you choose to play, this update makes your pilgrimage through Tormentosa smoother. See the full patch notes below.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Patch 1.3 Notes",
     "items": [
      {
       "text": "Fixed problems with graphic settings and saved user settings not being properly displayed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some achievements/trophies that wouldn't trigger or report properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added support for additional monitor resolutions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved some of the notable streaming hitches during gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a hitch that could occur after killing an enemy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with the mouse occasionally getting sticky",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bad jump area in Chapter 1 that could cause the player to get stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a misalignment of the weapon selector wheel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Setup default PC graphics settings for low spec GPUs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted UI for Steam Deck support",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved Steam Deck performance (now Steam Deck verified)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a performance issue on the PS5 Pro",
       "ps5ProOnly": true,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      }
     ]
    }
   ],
