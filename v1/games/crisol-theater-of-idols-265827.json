  {
   "id": "crisol-theater-of-idols-265827@hotfix-2026-03-01",
   "gameId": "crisol-theater-of-idols-265827",
   "displayName": "Hot Fix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-03-01T07:02:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve fixed the bug that caused save files dated March 1st not to be recognized in the load menu. You should now be able to see all your saves normally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "At Vermila Studios, we sincerely apologize for the inconvenience caused. We’ve been working on it since the moment we detected the issue to resolve it as quickly as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope this hasn’t negatively affected your experience and that you’ll continue to support us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
