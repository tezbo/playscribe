  {
   "id": "crisol-theater-of-idols-265827@1.2",
   "gameId": "crisol-theater-of-idols-265827",
   "displayName": "PATCH 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-19T17:03:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The blood still flows in Tormentosa.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We recognize it’s been some time since the previous update, and we appreciate the community’s continued patience and support while these changes were implemented.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.2 for Crisol on PC is now available, bringing a number of fixes and improvements throughout the experience.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "General",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Improvements to Weapon Selector in widescreen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Various collision and blocking improvements across all chapters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixes for the Achievement - Thanks for your Donation (not retroactive)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fix for collectable objects appearing incorrectly on the game map after loading a game save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Upscaling support updated for XeSS, FSR and DLSS",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Prologue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Improvements to the lighting in the truck crash cinematic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chapter 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Interacting with and climbing the trolley has been improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chapter 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed ladder remaining blocked after completing the dam puzzle and releasing the valve",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chapter 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Updated the movement speed of the boat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed Mediodia's head floating in cinematic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fix for crash while playing in high contrast mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Blood Memories 'FairMassacre2' and 'FairMassacre3' now appear correctly in the Journal once collected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Text Size increase for Subtitles, Skills, and Main Menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned. We’ll have more to share on console updates in the coming weeks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
