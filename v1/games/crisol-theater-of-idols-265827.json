  {
   "id": "crisol-theater-of-idols-265827@major-2025-09-24",
   "gameId": "crisol-theater-of-idols-265827",
   "displayName": "Demo Update Live!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-24T02:03:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks to your feedback we've made a number of significant updates to the demo, including adding Spanish VO, keybind customization, and more!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Spanish voices and text localization added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weapon damage rebalanced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keyboard key binding support implemented",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "New special death animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Resolution issues above Full HD fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DLSS temporarily disabled due to performance problems",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "New tutorials added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Various bugs fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
