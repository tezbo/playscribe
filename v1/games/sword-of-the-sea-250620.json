  {
   "id": "sword-of-the-sea-250620@post-2025-09-19",
   "gameId": "sword-of-the-sea-250620",
   "displayName": "Sword of the Sea Patch Notes 9/19/25",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-19T16:36:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey surfers! There’s a new patch out with some nice quality-of-life features and a bunch of bugfixes. Thanks again for playing Sword of the Sea!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Updates",
     "items": [
      {
       "text": "Added Invert Camera (Horizontal), Invert Camera (Vertical), and Camera Sensitivity photomode options that can be set separately from the the regular game camera",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a collectible tracker to the chapter select screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a collectible tracker to the pause screen in new game plus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "When using the Restart Chapter option in the last chapter or starting the level from the chapter select screen, the intro cutscene will be skipped, allowing for quicker restarts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved resolution settings- full range of resolutions are now accessible, with better handling of multiple monitor configurations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed issue where the count of collected items could be displayed incorrectly, leading to an associated trophy not triggering appropriately",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Score now has a maximum value to avoid overflowing and displaying as a negative number",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where some Japanese and Traditional Chinese characters displayed incorrectly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where music faded incorrectly at the beginning of levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where certain particles and sound effects could remain active incorrectly during some cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved camera rotation assist behaviour in some areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved visibility of photo mode effects menu elements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where a guide beam could reset incorrectly after returning to gameplay from main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where some sound effects would no longer play after returning to gameplay from main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved visibility of some interactive objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made tetra around certain halfpipes easier to collect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where sound effects for grinding could remain active",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where some snow effects could disappear abruptly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where UI for remapping analog sticks may not work as expected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor character animation pops",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed geometry pop-in in some cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor seams in geometry across the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved minor environmental collision shapes across the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved falling reset zones across the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Known Issues",
     "items": [
      {
       "text": "Some Intel Arc GPUs have been reported to crash on startup",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
