  {
   "id": "sword-of-the-sea-250620@post-2025-08-29",
   "gameId": "sword-of-the-sea-250620",
   "displayName": "Sword of the Sea Patch Notes 8/29/2025",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-08-29T18:10:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey surfers! We have another patch for you that takes care of a few more things we have managed to track down. Thanks again for your bug reports, and your support. Happy surfing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Updates",
     "items": [
      {
       "text": "Added prompts to activate photomode in certain scenarios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Allowed photo mode access during some scripted sequences",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added 120hz framerate option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased text reveal rate slightly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased photo mode camera movement range",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added UI animation when collecting secret shells",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a tetra reward when all boats are lit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made platforming to reach certain secrets less demanding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved snow particle fade distance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added loading indicator when Restart Chapter or Rewind 5 Minutes options are used",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed issue where higher resolutions could be inaccessible in the Options/Graphics screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Invert Camera (Vertical) setting not applying to photo mode camera",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rare audio issue when entering cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated credits with missing entries",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rare issues where the combo display could appear incorrectly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various places where the player could get out of bounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed several inaccessible chests that were buried underground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the player could get stuck in a reset loop when falling off certain edges",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several areas where the player could become stuck in an out of bounds area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the “New High Score” achievement could be awarded on the first playthrough",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the player could sometimes appear at the wrong start location when using the restart chapter option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed unused loading area in Lost Grotto",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the “Long Distance Jumper” achievement could sometimes be triggered during a cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the “Water Whisperer” achievement may not have triggered correctly, despite requirements appearing to have been met",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where advance icon could be missing on certain text boxes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Known Issues",
     "items": [
      {
       "text": "There are some issues we are still actively investigating for future patches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some Intel Arc GPUs have been reported to crash on startup",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Some reported cases of the “Water Whisperer” achievement not triggering may still be outstanding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
