  {
   "id": "sword-of-the-sea-250620@post-2025-08-22",
   "gameId": "sword-of-the-sea-250620",
   "displayName": "Sword of the Sea Patch Notes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-08-22T01:31:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey surfers! This patch addresses several bugs and issues discovered at launch that we wanted to take care of as soon as possible. Thank you for submitting bug reports, they have been very helpful. And thank you for playing Sword of the Sea!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update",
     "items": [
      {
       "text": "Added cloud save support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed issue where photo mode could be activated when dialog boxes were open, causing a progression blocking state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed out-of-bounds protection in certain areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed miscellaneous minor audio and music issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed cases where the player could get stuck in the halfpipe air animation state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where a red screen effect would continue during a cinematic moment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where progression could be blocked by making a certain jump in Shadow Tundra",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where a gate that would not open in Veiled Sea if the level was started from chapter select",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed game not pausing automatically when losing focus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Known Issues",
     "items": [
      {
       "text": "There are some issues we are still actively investigating for future patches.",
       "ps5ProOnly": false,
