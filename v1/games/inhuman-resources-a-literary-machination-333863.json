  {
   "id": "inhuman-resources-a-literary-machination-333863@1.3.0",
   "gameId": "inhuman-resources-a-literary-machination-333863",
   "displayName": "Update 1.3.0",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-04-29T17:59:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello! First of all, thank you for playing Inhuman Resources. We're glad of the feedback we've received, and have since worked on a bunch of fixes mostly requested by you on our discussion forums. Keep it coming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Updated game icon on all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Editing pass on the French localization at the epilogue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Squashed some typos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed an issue where talking to Emiliano in Encryptology could halt progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed an issue where players could get blocked during the epilogue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed an issue where reloading a previous chapter could impact your inventory and stats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* To help with the above issue, added a button in the options menu to restore your inventory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "and stats based on your progress in the event they were corrupted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed an issue where background color would not restore properly when loading a chapter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed an issue where resuming the game would sometimes play sound effects not relevant to the current scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
