  {
   "id": "inhuman-resources-a-literary-machination-333863@1.7.0",
   "gameId": "inhuman-resources-a-literary-machination-333863",
   "displayName": "Patch 1.7.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-05T17:09:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today is a small maintenance patch day for Inhuman Resources. Here's the very short changelog:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We now have a native build on Linux! If you run Linux, Steam should automatically switch you over to the native Linux version. If you prefer staying on the Windows version for any reason, you can do by going to the Compatibility tab of your game's properties and enabling any Proton compatibility mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We updated our Unity version. This is a necessary security update following the discovery of vulnerability CVE-2025-59489.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
