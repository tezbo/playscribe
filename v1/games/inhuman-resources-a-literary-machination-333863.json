  {
   "id": "inhuman-resources-a-literary-machination-333863@1.4.0",
   "gameId": "inhuman-resources-a-literary-machination-333863",
   "displayName": "Patch 1.4.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-18T15:29:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First of all, as always thank you for playing Inhuman Resources. This patch is based off community feedback and bug reports, as we want to ensure everyone can fully enjoy the story with no interruptions. Thank you for your patience and please keep the feedback coming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A paragraph accidentally written in French in the English version of \"The Nervous Breakdown\" has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Missing French translations have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue on Wednesday where the game could get stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in Evaporation where the game could get stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in Epilogue where one of the endings could cause the game to become stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where reloading a chapter or changing language while a special icon was displayed on the resume button could cause the game to get stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The game now saves automatically at fixed intervals, to help with lost progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "'Restore Inventory' button has been changed to 'Stuck?' for clarity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
