  {
   "id": "karmazoo-246564@post-2023-12-08",
   "gameId": "karmazoo-246564",
   "displayName": "Improvements & Patch notes 🔔",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-12-08T11:00:23.000Z",
   "notes": [
    {
     "title": "KarmaZoo Patch 1",
     "items": [
      {
       "text": "It's been a wild ride so far and we were busy reading your feedback, fixing bugs and improving the game as much as we can. This couldn't be possible without your help!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Below you'll see a list of patch notes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you continue to enjoy the game and earn more Karma together.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "version number: 1.05.015",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "These patch notes contain the major changes made since the game release on November 14, 2023, version 1.04.010",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Many bugs, exploits and some crashes fixed",
     "items": [
      {
       "text": "related to characters' abilities and missions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "related to the bonus cards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "related to the Sanctuary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "related to streaming options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "disconnections not handled properly every time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "stronger anti-cheat system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "level design (cameras, respawn positions, blockers, ...)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "texts display from other alphabets than the selected one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "tutorial robot behavior",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Better Balance",
     "items": [
      {
       "text": "some telescope missions' difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "some exploits that were generating too much Karma for the party",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Overall, the game is now more stable and has no more known major issues or exploits remaining.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "game lore and a lot of other players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "xoxo Pastagames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
