 "releases": [
  {
   "id": "karmazoo-246564@major-2024-02-09",
   "gameId": "karmazoo-246564",
   "displayName": "February Love Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-09T17:15:29.000Z",
   "notes": [
    {
     "title": "Get cosy",
     "items": [
      {
       "text": "Our February update comes with some beautiful changes to the Zoo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Karma hearts will be red and if you take a closer look around, you'll see all kinds of pretty decor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's the time of love and cooperation. New Blobs are especially welcome to try out the game and teams with newcomers will profit even more than before!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On top of that we added KarmaZoo community items to Steam as well so now you can collect cards, decor your profile with backgrounds and show your love with cute emotes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "🐌 Introducing the Snail Sherpa!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "💗 Beginner Blobs will now (and forever) give 5 instead of 2 Karma to others",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "💋 Karma Kiss gives 2 Karma instead of 1 during the event",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "⭐ +X% bonus on Karma when reaching the Karma Tree with a smaller number of people.: Perfect for a romantic Zoo date of 2 or 3 or more...: (X goes from 50% when there is only 2 players down to 0% when the game is full)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "SNAIL SHERPA",
     "items": [
      {
       "text": "Time Freeze Slows down time ⏱️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Karma Boost Boosts targeted characters by decreasing the Karma Kiss cooldown 💋",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Karma Zone Creates a zone in which each Karma Heart that goes through will be doubled 🤍🤍",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "COMMUNITY ITEMS",
     "items": [
      {
       "text": "We added emotes, backgrounds, cards and cool badges for you to collect!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "v.1.05.010 --> v.1.06.002",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GENERAL",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "St Valentine's & Lunar New Year Event",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Love is in the air! KarmaZoo's blossoms into the month of celebrating love. Enjoy the skin of love and lights while it lasts!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Karma Kisses are juicier so share with your teammates at will!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All 2 player games see their score boosted! Share good times with your partner.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unlock the exclusive Snail Sherpa with its love boosting ability and time controlling powers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "LOOP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Clover bonus cards only appear when a Clover is in the group",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Accessibility: Background Density now shows Peacock Sherpa Feedback correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Overall code stability to prevent multiple crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor bugfixes including Karma scoring and saving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Newcomers give more Karma Hearts (up to 5) when helped by other players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bonus Perks effects' feedback and balancing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you need more information, want to chat to others of our super wholesome and active community,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "xoxo Pastagames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
