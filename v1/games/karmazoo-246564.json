  {
   "id": "karmazoo-246564@1",
   "gameId": "karmazoo-246564",
   "displayName": "Patch 1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-12-22T11:29:37.000Z",
   "notes": [
    {
     "title": "KarmaZoo Patch 1 Hotfix 1",
     "items": [
      {
       "text": "We work hard to further improve the game and appreciate your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's the list of changes from last time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "version number: 1.05.019",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This hotfix patch brings a fix for 3 major issues",
     "items": [
      {
       "text": "Wolf, Turtle, Flower Pot and Elephant tombstones missions could not be completed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some players were getting disconnected from certain game sessions because they stayed on the \"Voting Perk\" screen for more than 30 seconds. The timeout has been increased to 50 seconds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "PS5 / Xbox only: Music was never resumed after triggering a Naughty Eye",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "game lore and a lot of other players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "xoxo Pastagames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
