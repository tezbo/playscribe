   "id": "pneumata-223183@major-2025-09-15",
   "gameId": "pneumata-223183",
   "displayName": "Pneumata - update news sep. 19",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-15T17:42:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey it's Antonio the dev guy who made this game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An update is still on it's way, so if you own the game, I'll try and send out a big notification or something to let you know. It's pretty significant, won't feel like you're playing the same game at all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you haven't bought the game, just wait until the update's out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More news on September 19, 2025. Only fitting as the 1 year anniversary of the launch comes through.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
