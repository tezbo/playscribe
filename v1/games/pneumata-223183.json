  {
   "id": "pneumata-223183@1",
   "gameId": "pneumata-223183",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-31T00:42:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today's update is the first of several content related updates on the way:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hand drawn maps for each level have been added in, that can be accessed anytime to help navigate through the game, as well as minor general improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More work is being done to bring additional bug fixes in a large update coming soon, however some of these reworks require some major tweaks to some of the core systems so I want to be careful to make sure that enough testing is done on these fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
