  {
   "id": "pneumata-223183@major-2024-10-03",
   "gameId": "pneumata-223183",
   "displayName": "Update Notes for October 3, 2024",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-03T15:44:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new minor update is bringing some fixes as well as subtitles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Subtitles added for spoken dialogues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with a wall clipping through the exterior and blocking the vents outside Clover Hill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with player getting stuck inside moving Fridges: More bug fixes are being worked on right now, and will go live once I'm able to get some more testing on them going. Expect a major update in the next week or so that will bring some accessibility options, bug fixes, and some design changes to help with exploring the world with a bit more ease.: Thanks!: -Antonio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
