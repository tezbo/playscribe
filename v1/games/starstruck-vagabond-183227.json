  {
   "id": "starstruck-vagabond-183227@1.0.3",
   "gameId": "starstruck-vagabond-183227",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-27T03:13:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "One last update for the first weekend - by popular demand, cloud saves have now been activated for Starstruck Vagabond.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "VERY IMPORTANT NOTE: The save file encryption system has been altered to accommodate this. Make sure you run the game at least once on a system you've already played it on before trying it out on a different system; this will ensure that your existing saves get converted to the new format.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Again, you'll know you're playing the latest version from the \"v.1.0.3\" in the corner of the title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full changelog for 1.0.3",
     "items": [
      {
       "text": "Implemented cloud saves",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed crash when visiting pub in postgame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed plants being interactable from outside ship",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can no longer drop items on the hulls of other ships (trying to dispose of waste barrels like that is just rude)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed rare hang in Melinda story scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed upgrade units not registering as found if you use them before taking them to your ship",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed hang + subsequent crash in final Kairos story scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
