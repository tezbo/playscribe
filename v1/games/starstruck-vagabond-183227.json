  {
   "id": "starstruck-vagabond-183227@post-2024-06-08",
   "gameId": "starstruck-vagabond-183227",
   "displayName": "Soundtrack now available!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-06-08T02:56:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In case you missed it, the stellar soundtrack for Starstruck Vagabond by Sam Houghton and Joe Collinson is now available to buy from Steam for 7.99 USD!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can also buy it bundled with the full game for a 10% discount: https://store.steampowered.com/bundle/42251/Starstruck_Vagabond_Deluxe/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And if that weren't enough, there's a new update today.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changelog for 1.0.7.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added low impact mode to settings (try this is you've had frame rate drop issues; still trying to get to the bottom of that)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed Eggsec jobs from no egg mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Seeds and rocks added to things you can't microwave",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added failsafe to stop NPC pathfinding from hanging the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You no longer receive jobs to deliver more crates than can fit on the source planet's loading zone",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
