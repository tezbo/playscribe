  {
   "id": "starstruck-vagabond-183227@1.0.6",
   "gameId": "starstruck-vagabond-183227",
   "displayName": "Update 1.0.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-31T02:54:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I think we might be veering upon the end of thinking of updates in terms of \"fixes\" and can soon start thinking in terms of \"quality of life improvements.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full changelog for 1.0.6",
     "items": [
      {
       "text": "1.0.6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cooking a recipe that is also a resource (like orange juice, potato salad etc) will now let you pick it up as an item if you choose the \"eat by yourself\" option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed dummies in captain quarters resetting after ship upgrade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Default random seeds now don't always start with 0 (weird oversight on my part there)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed possible crash in Second's story",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed story objectives potentially being too close to planets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crew members requesting to visit planets in locked quadrants",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an egg and a fruit sometimes spawning on the same tile on wild planets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
