  {
   "id": "starstruck-vagabond-183227@1.0.7.2",
   "gameId": "starstruck-vagabond-183227",
   "displayName": "Update 1.0.7.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-04T03:53:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today's update (1.0.7.2) has a small but significant gameplay change. Taking aboard feedback - and concern that some people have essentially softlocked themselves by forgetting where they left the crates for their current mission - the game's maps now display \"crates for pickup\" icons on any planets where crates are currently located, not merely on their planet of origin.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again to everyone giving feedback and bug reports, continuing to help me scrape the last few rough edges off the game, and thanks to everyone else for their patience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
