  {
   "id": "starstruck-vagabond-183227@1.1.1",
   "gameId": "starstruck-vagabond-183227",
   "displayName": "Update 1.1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-17T03:31:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Changes for v1.1.1",
     "items": [
      {
       "text": "You can now destroy almost all pickups with your welder, to reduce the possibility of blocking yourself. Exceptions are quest items like lost bags and waste barrels, as well as anything required for the critical path (such as the fuel and Miraclium during the tutorial)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Destroying a crate will abort your current delivery mission (with the usual credit deduction)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Destroying fuel (in either raw or refined forms) will cause an explosion that hurts you and damages your ship (just for fun)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can no longer sell waste barrels from an upgraded refinery (or anything else with a credit value of zero)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Hole's introduction bugging out Red Weed distress missions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Red's introduction causing a crash if you return to your ship midway through disposing of barrels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash caused when a romanced Red tries to talk to you in certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed formatting in console exhibits menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed upgrades not resetting in post-post-game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
