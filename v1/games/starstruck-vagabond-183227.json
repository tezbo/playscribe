  {
   "id": "starstruck-vagabond-183227@1.0.7",
   "gameId": "starstruck-vagabond-183227",
   "displayName": "Update 1.0.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-02T04:09:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Couple of big fixes and some much-demanded gameplay quality of life changes today. If anyone after this patch is still getting one of those annoying crashes that make your save file crash the game every time you load it, please let me know in the discussion thread below, along with any log the crash provides and roughly where you were in the story when it happened.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.0.7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You now press the BACK button to talk to crewmembers rather than USE, so they don't interrupt you while you're working",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Plants now don't block you, only slow you down",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wonders now appear on the PDA map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed game locking up if you get a load of crates dropped on you",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed distress signals stopping after you go to the sector edge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed PDA hints crashing the game in postgame mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various fixes all over the place straining out a few more cutscene hangs caused by blocked NPCs and crashes caused by saving at certain moments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
