  {
   "id": "starstruck-vagabond-183227@1.0.5",
   "gameId": "starstruck-vagabond-183227",
   "displayName": "Update 1.0.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-29T17:36:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I'd say that hopefully this will be the last one for a while but I don't want to jinx myself. See, the headache is that what major bugs and crashes remain are mostly only ones that occur in highly specific scenarios with highly specific random seeds. Still, I continue to knock them out one by one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full changelist for 1.0.5",
     "items": [
      {
       "text": "Fixed crew members requesting to go to the bar before you have 2 crew members",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed possible hang during ending cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed possible hang during Hole friendship scene 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed possible hang during Magu story",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed derelicts spawning with no derelict after story end",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed blackout time/color not resetting if you reload a save during Syl's story",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed possible crash bug relating to kinesis gloves",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed potential crash during Burlap story",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed hang caused by using the cargo platform while dialog/the congrats message is up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Took steps to shore up a couple of potential memory leaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added personality type to main character status page",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
