    {
     "title": "Changes",
     "items": [
      {
       "text": "Well that didn't take long. The crash on complete loss of stamina should now be fixed, as well as some issues with the rebind keys menu. Please make sure your game is updated! You'll know you're playing the right version 'cos the title screen will have \"v1.0.1\" in the bottom right.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thanks to everyone who wishlisted and bought the game on day one! Really bowled over by the enthusiasm so far.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
