  {
   "id": "jujutsu-kaisen-cursed-clash-255396@4",
   "gameId": "jujutsu-kaisen-cursed-clash-255396",
   "displayName": "Update 4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-21T03:00:14.000Z",
   "notes": [
    {
     "title": "Experience “Shibuya Incident” with additional scenarios and playable characters including Mei Mei and Choso, and Mechamaru!",
     "items": [
      {
       "text": "Players will experience the fateful Halloween night where Suguru Geto unleashes cursed spirits to force Satoru Gojo to confront him, trapping civilians and exorcists in the Shibuya neighbourhood.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition to the new DLC, the Free Update #4 features Ultimate Mechamaru as a playable character, adds new enemies in Online Co-op and Arcade modes, 4 new stages, and some additional items for every player!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
