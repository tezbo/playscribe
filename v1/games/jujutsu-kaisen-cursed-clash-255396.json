  {
   "id": "jujutsu-kaisen-cursed-clash-255396@1.0.2",
   "gameId": "jujutsu-kaisen-cursed-clash-255396",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-29T05:39:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released a (free) update containing the following items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update corresponds to the versions stated below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Improved Functions/Bug Fixes",
     "items": [
      {
       "text": "▼Improved Functions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved upon the performance issues that ocurred under specific conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue causing an error to appear while searching for players at the Online Lobby on the PlayStation® edition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixed the issue causing an error to appear during the matchmaking for the online battles on the PlayStation® edition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Adjusted the algorhytm on the PlayStation® edition to make it easier to find players within the same region during the matchmaking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      }
     ]
    },
    {
     "title": "▼Bug Fixes",
     "items": [
      {
       "text": "✔️ Fixed the bug that caused the game to crash under specific conditions on the Xbox edition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "✔️ Fixed the bug causing the game to freeze at the battle results screen under specific conditions during online matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✔️ Fixed the bug that caused the game to freeze under specific conditions during online matches when executing Joint Attacks and Awakened Moves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✔️ Fixed the bug that caused unexpected behaviors under specific conditions after choosing to Rematch in online battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✔️ Fixed the bug that caused the game to freeze under specific conditions when a character was blown away.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✔️ Fixed other minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "■Additional Contents",
     "items": [
      {
       "text": "Distributed the following 4 items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Title: \"Jujutsu High - New Student\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Nicknames: \"Jujutsu Kaisen\" & \"Cursed Clash\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Emblem: \"Jujutsu High\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Plate: \"Special Plate- Main Visual\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*An internet connection is required to install these updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*The latest update must be installed in order to access the game's online contents.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*The battle replay data is not compatible with the previous version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that it will not be possible to reproduce any replay data from the previous game version after this update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Steam",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Press the “Windows Key”＋”G” to access the “Game Bar” → Head to the “Capture” menu and click the “Record” button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*You can execute multiple commands from here. Depending on the OS version, you may also be able to choose this option directly from the “Settings” menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*This option allows you to capture a video of your current gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you continue to enjoy \"Jujutsu Kaisen Cursed Clash\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
