  {
   "id": "varlet-341552@major-2025-05-02",
   "gameId": "varlet-341552",
   "displayName": "\"VARLET\" game controls update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-02T11:31:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Regarding our developing project \"VARLET,\" we have received feedback about conforming the keyboard and mouse controls. Here, we would like to officially announce that the keyboard and mouse controls will be available.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "In order to enhance the gaming experience for various players, we are currently adjusting the programs before the release.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your support of \"VARLET.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "＝＝＝＝",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This isn't a story about finding someone else—it's about finding yourself.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"VARLET\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "These students struggle to find their own answer while coping with the difficulties of growing up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As you get to know them, you'll come to know more about yourself in this school life RPG.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
