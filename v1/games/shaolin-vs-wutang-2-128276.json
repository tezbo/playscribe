  {
   "id": "shaolin-vs-wutang-2-128276@1.0",
   "gameId": "shaolin-vs-wutang-2-128276",
   "displayName": "Patch 1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-03-17T15:32:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone, Thank you all for your support. This launch has been a little more rockier than expected due to the battle load crash issue that some users are experiencing on their computers. Please understand that I am working around the clock to try to fix this issue as soon as possible, but here are some additional tweaks and bug fixes to the game that are released in this patch. Thank you all for your support and patience, Stay tuned for more updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jumping punch and kicks no longer knock down the opponent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dash position switch invincibility frames have been extended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Muay Thai back throw for Wing Chun now plays the proper animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the Incorrect translation for the Chinese text on the Shaolin vs Wutang logo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
