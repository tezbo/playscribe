  {
   "id": "rick-henderson-113529@post-2021-02-17",
   "gameId": "rick-henderson-113529",
   "displayName": "Small bug fixes",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-02-17T14:14:25.000Z",
   "notes": [
    {
     "title": "Adjustments",
     "items": [
      {
       "text": "Kamikaze perk is now \"No shield, + 100% score\", was \"No shield, +20% score\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Shield upgrade perks no longer appear if you have Kamikaze perk active.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Ben changes weapons quicker by default. Quick Draw perk no longer appears when playing as Ben.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Thoraxx changes weapons slower by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed a bug where Hawk Eye would stay stuck during the boss sequence if you started targeting just before boss sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enemy bullet speed progression over loops is now slower (it was exponential by logics mistake).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Performance improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some translation issues (coming soon).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
