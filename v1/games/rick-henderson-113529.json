  {
   "id": "rick-henderson-113529@post-2021-02-15",
   "gameId": "rick-henderson-113529",
   "displayName": "Round of bug fixes, performance improvements and adjustments",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-02-15T22:24:56.000Z",
   "notes": [
    {
     "title": "Bug fixes and performance improvements",
     "items": [
      {
       "text": "Fixed Enforcer movement method (sometimes they moved rotated instead fixed).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Blaster movement method (sometimes they move rotated instead fixed).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Avenger following a proper horizontal value (so he now shoots straight at you).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed last weapon used still appearing visually on ship upon level restart.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Ripper homing system not properly deactivating so they end up entering the screen in full speed, not happening anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Hologram properly functioning when pausing game (it got disabled when unpausing).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed being able to use Hologram, Microwarp and Artillery Strike during the boss appearing sequence which caused issues, they can't be activated during the sequence anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Bloom to NOT affect menu items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Infiltrator (one of small enemies with laser sight that is being launched by Terran Boss) now properly targets Hologram.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Short Fuse and BullHammer mines sometimes not despawning properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a fail safe for ranks sometimes not being despawned when picked up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Sundyne Boss MK1 not following Hologram.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a lot of stuff for overall stability and performance during longer runs and restarts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some cosmetic fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Adjustments and additions",
     "items": [
