  {
   "id": "rick-henderson-113529@post-2021-02-16",
   "gameId": "rick-henderson-113529",
   "displayName": "Drones are coming!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-02-16T21:01:40.000Z",
   "notes": [
    {
     "title": "Added Bullet, Energy and Weapon drones",
     "items": [
      {
       "text": "They are not weapons, but are collectible through perks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "They follow you around while shooting at enemies but DO NOT soak up bullets or draw enemy fire/homing enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can have only one of each. Having all three is quite powerful.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Waves",
     "items": [
      {
       "text": "Added some new waves with more shielded enemies. There's more than 300 waves now and i aim for more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed some bosses' tags not despawning properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed final boss tags for homing weapons not appearing in proper place",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Rift Miners Boss MK3 not despawning when boss dies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
