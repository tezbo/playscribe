  {
   "id": "metaphor-refantazio@1.09",
   "gameId": "metaphor-refantazio",
   "displayName": "Patch 1.09",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-01T00:01:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Metaphor: ReFantazio players, patch 1.09 is now available. Please see the notes below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New ON/OFF toggle setting for motion blur animation when dashing.: *Dash effects setting can be changed from SETTINGS > System Setting > Dash Effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where a quest in the Catacombs cannot be completed under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where progression is blocked when enemies with status ailments conduct certain actions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Expedited the animation when displaying the popularity ranking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue in which certain mouse controls were not functioning properly.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue in which button shortcuts did not appear properly when using a controller under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved support for AZERTY keyboards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed other minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The patch will be applied automatically when the game is launched.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing Metaphor: ReFantazio!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
