  {
   "id": "metaphor-refantazio@1.0.11",
   "gameId": "metaphor-refantazio",
   "displayName": "Patch 1.0.11",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-01-15T00:03:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Metaphor: ReFantazio players, patch 1.0.11 is now available. Please see the change notes below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now able to change party formation and configuration in Main Menu > EQUIPMENT",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now able to cycle through item categories in Main Menu > ITEM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted character and cursor movement controlled by controller sticks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Other minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing Metaphor: ReFantazio!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
