       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun and enjoy the journey!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "¡Diviértanse y disfruten el viaje!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
