  {
   "id": "metaphor-refantazio@1.03",
   "gameId": "metaphor-refantazio",
   "displayName": "Patch 1.03",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-18T20:42:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Metaphor: ReFantazio players, please see notes for patch 1.03 releasing today (Friday, 10/18):",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Anti-aliasing feature implemented. Anti-aliasing can be adjusted in SETTINGS > Graphic Settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustments made to the Camera Shake Off feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustments made to audio volume balance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: Today's patch increases the game's Master Volume. Please turn down your computer's volume before starting up and readjust the in-game Master Volume setting. We apologize for the inconvenience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where New Game+ start save data wasn't generating correctly under certain conditions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The patch will be applied automatically when the game is launched.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
