   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hola Metaphor fans, LATAM Spanish subtitles are now available for Metaphor: ReFantazio! We’re delighted to bring this support for our Latin American audience and hope even more players can now experience this adventure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun and enjoy the journey!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "¡Diviértanse y disfruten el viaje!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
