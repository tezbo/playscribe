  {
   "id": "metaphor-refantazio@1.02",
   "gameId": "metaphor-refantazio",
   "displayName": "Patch 1.02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-05T00:21:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released a patch to improve the graphics performance of the Steam version of “Metaphor: ReFantazio - Prologue Demo”. The patch will be automatically applied when the game is launched.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Performance fixes: Adjustments made to relieve GPU stress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "GPU: Game will now choose highest spec (dedicated) GPU",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "*Performance fixes will continue to be made in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We thank you for your continued support of Metaphor: ReFantazio!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
