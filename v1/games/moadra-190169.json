  {
   "id": "moadra-190169@1.0.1",
   "gameId": "moadra-190169",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-21T12:22:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Lieutenants!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The demo has been out for a week, and many of you have already provided great feedback and suggestions. Thank you!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.0.1 has been released with the following updates;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted difficulty to the Blight Beast boss fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed Armored Barrier near the boss fight to gain access to the nearby save point.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced Stinger Flie's attack speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced Blightwing's attack speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved target lock selection logic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Polished target lock visuals and soundscape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased player immunity time after taking damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced Bioplasm cost for Purify Lifeblood and Protopulse skills.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added a tooltip upon discovering the Protopulse skill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Minor level design and visual clarity improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional note; if you continue playing with save files from version 1.0.0, the map screen may show incorrect icons in the levels that have been modified in this new version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now, hop into your carrier and thrust back to exploring Protea VI!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
