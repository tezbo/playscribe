  {
   "id": "moadra-190169@1.1.0",
   "gameId": "moadra-190169",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-28T20:37:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks to everybody's feedback, we have made many improvements to the game, and decided to include them in the demo version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.1.0 has been released with the following updates;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gamepad aiming / target locking",
     "items": [
      {
       "text": "Added button (gamepad left trigger) to allow free aiming without moving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added crosshair to help with free aiming.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Target lock works only on enemies and moving targets, greatly reducing the picking of unnecessary targets, especially during combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Target lock picks the closest target to the crosshair, making it easier to understand which target the system will choose.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Scanning",
     "items": [
      {
       "text": "Scanning objects is much faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Object highlight colors in scan mode are clearer, making it easier to see whether the object has already been scanned.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed scanning from various objects that didn't contribute much to the story and lore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Player movement physics / other feature improvements",
     "items": [
      {
       "text": "The player accelerates to maximum speed slightly faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Jump vertical speed slows down quicker after releasing the jump button, making it easier to do jumps with different heights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Crouching now works by holding down the left analog or D-pad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Maintaining ledge grab does not require holding the move input anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Healing skill (renamed to Heal Lifeblood) does not use Bioplasm anymore, and can be recharged in Evolve Chambers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the blaster charging bug, which sometimes prevented charging even if the fire button was pressed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed one frame of input lag from controls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "UI improvements",
     "items": [
      {
       "text": "Updated some tooltips (for example, free aiming).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The gamepad back button (right face button) works more consistently in various menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added missing map icons (for example, elevator doors and area damage sources).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Taking damage and low health effects are more subtle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Level design / art improvements",
     "items": [
      {
       "text": "Fixed collision geometry on various levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted enemy placement on Neera Archives levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Slightly increased the overall brightness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Slightly toned down the vignette effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "These changes have modified the game's data in many ways, which unfortunately means the save files from the previous version do not work anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We would greatly appreciate feedback on how these changes affect the experience. Please let us know in the Steam discussions!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
