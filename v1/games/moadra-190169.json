  {
   "id": "moadra-190169@major-2026-10-21",
   "gameId": "moadra-190169",
   "displayName": "- Steam Deck Verified / Demo Update! -",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-21T12:20:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Lieutenants, a quick update for you before tomorrow's release!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We've got good news for Steam Deck owners",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/41402063/56cefc6bc283ec84ff98f83572e2b87eff4be563.png\"]",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Also, the demo is updated with all the latest improvements, such as:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Localizations",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Rebind controls",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Scan logbook",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Save progress that carries over to the full game",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "+ many more",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Achievements in the demo are saved locally and unlock on your Steam account once the full game is purchased and launched.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Moadra releases on Thursday, October 22 at 12:00 AM PDT!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "See you on Protea VI tomorrow, Lieutenants!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Gloomsoft Dev Team",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
