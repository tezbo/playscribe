  {
   "id": "humanity-122565@major-2025-12-09",
   "gameId": "humanity-122565",
   "displayName": "[News] Update on HUMANITY User-Generated Content",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-09T00:00:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/43695402/238ce274e9d950d831a0a399a8688a975e175a21.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The User Stages mode in HUMANITY will end service at the end of March 2026. After this time, users on any platform will no longer be able to successfully upload stages they've created or play stages created by other users. You will still be able to access any stages you've created and saved locally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Over the past two and a half years, we at Enhance have been absolutely astonished by the quality and breadth of puzzles that the HUMANITY community has created using the in-game Stage Creator, resulting in over 30,000 stages shared.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We thank everyone for their contributions to this community library.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Enhance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
