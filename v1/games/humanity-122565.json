  {
   "id": "humanity-122565@1.04",
   "gameId": "humanity-122565",
   "displayName": "PATCH 1.04",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-05-31T00:07:55.000Z",
   "notes": [
    {
     "title": "HUMANITY PATCH 1.04 (2023-05-30)",
     "items": [
      {
       "text": "Hopefully fixed a rare bug in STORY MODE where the AIR FLOW stage could crash the game. If you still experience this bug, please let us know via Zendesk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a problem where it was possible for people to slip through walls when jumping into them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in STAGE CREATOR where the yellow select cursor could disappear in the palette menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in STAGE CREATOR where blocks with a climbable wall connected to a switch would not move properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in STAGE CREATOR that caused the game to freeze when moving the starting position of the dog and placing a block where they were standing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in STORY MODE that could cause Goldy to disappear when retrying a stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in STAGE CREATOR that caused continuous error messages when objects overlapped when using mouse controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Other minor adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "KNOWN ISSUES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusting Steam Input controller settings from the default may lead to issues in the game. “Enable Steam Input” is the default.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "How to enable Steam Input controller settings on desktop",
     "items": [
      {
       "text": "In your library, right click HUMANITY > Properties > Controller > Enable Steam Input (from the dropdown)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "In big picture mode, go to HUMANITY > Properties > Controller > Enable Steam Input (from the dropdown)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
