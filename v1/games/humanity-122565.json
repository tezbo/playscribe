  {
   "id": "humanity-122565@1.10",
   "gameId": "humanity-122565",
   "displayName": "PATCH 1.10",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-07-09T00:11:50.000Z",
   "notes": [
    {
     "title": "BUG FIXES AND IMPROVEMENTS",
     "items": [
      {
       "text": "In STAGE CREATOR, fixed an issue where placing and copying a certain combination of items could cause a soft lock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "XBOX: Fixed an issue where the WONDERDOG achievement would sometimes not unlock after completing the requirements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "XBOX: Fixed an issue where the DOGGED PUZZLE SOLVER achievement would sometimes not include completions of HARD or EXPERT stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "XBOX: In USER STAGES, fixed an issue where player names were not displaying correctly in the Recently Completed and Recently Favorited section of Stage Details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    }
   ],
