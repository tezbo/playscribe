  {
   "id": "humanity-122565@1.05",
   "gameId": "humanity-122565",
   "displayName": "PATCH 1.05",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-06-08T00:05:43.000Z",
   "notes": [
    {
     "title": "HUMANITY PATCH 1.05 (2023-06-07)",
     "items": [
      {
       "text": "ADDED FEATURES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In USER STAGES, you can now see more information about players and search for stages they created by clicking on their avatar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In USER STAGES, players who RECENTLY COMPLETED and RECENTLY FAVORITED a stage now appear in the stage details screen. Highlight and select any avatar to learn more about that player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In USER STAGES, COMPLETED count now appears under CLEAR RATE in the stage details screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In USER STAGES, added CLEAR RATE and TOP RATED sort under SEARCH.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BUG FIXES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug in STAGE CREATOR where using a PUDDLE would cause the people to walk through blocks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in STAGE CREATOR under the PEOPLE SWITCH setting \"NO. OF PEOPLE REQUIRED TO TRIGGER\" where it displayed incorrect values.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "PS5: Fixed a bug on the console where Activity progress was not properly updating when overwriting save data using the cloud save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "PS5: Fixed a bug that allowed players to skip the YELLOW CORE when using the Goldy activity card if all previous Goldy were obtained.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixed a bug in USER STAGES where category names were not displaying properly in German when reporting a stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
