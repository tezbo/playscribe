  {
   "id": "humanity-122565@1.10.001",
   "gameId": "humanity-122565",
   "displayName": "PATCH 1.10.001",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-04T00:23:47.000Z",
   "notes": [
    {
     "title": "BUG FIXES AND IMPROVEMENTS",
     "items": [
      {
       "text": "\\[Important: Unity Security Vulnerability Update]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We released a critical patch today, October 3, 5 pm PT, to address a security vulnerability in Unity-created applications, as announced by Unity Technologies. This update is now available for the Steam version of HUMANITY.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We ask that all players of HUMANITY on Steam apply the latest update as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "An update for the Meta Quest and Xbox versions is scheduled for release soon. The PS5 and PS4 versions are not affected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      }
     ]
    }
   ],
