   "gameId": "humanity-122565",
   "displayName": "PATCH 1.11",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-03-31T00:03:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/43695402/b9fa7808a2305fd1ce096ee4ebc066ffd487b2ba.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "USER STAGES SERVICE ENDING",
     "items": [
      {
       "text": "\\ The “PLAY STAGES” option has been removed from the Title Screen following the service’s conclusion on March 31, 2026.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All backend support for community stage sharing has been discontinued. Related functionality within the Stage Creator (such as the option to upload a stage) has been removed to reflect the service’s closure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
