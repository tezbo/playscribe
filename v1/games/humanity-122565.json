  {
   "id": "humanity-122565@1.08",
   "gameId": "humanity-122565",
   "displayName": "PATCH 1.08",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-08-02T00:10:55.000Z",
   "notes": [
    {
     "title": "BUG FIXES AND IMPROVEMENTS",
     "items": [
      {
       "text": "In OPTIONS, fixed a bug where the customized mouse wheel keybinding would not display correctly and could not be changed.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "In STAGE CREATOR, fixed a bug that prevented the player from moving the cursor position when entering stage name text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In USER STAGES, fixed various collision issues that would occur when Boulders were placed on top of a Conveyor Belt.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In USER STAGES, fixed an issue where Pushable Blocks would ignore collision rules when grouped and occasionally become stuck in walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In STORY MODE, fixed a bug where the \"Wonderdog\" trophy/achievement could not be obtained after successfully completing all seven challenges. Please submit a support ticket if you still experience this bug.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In USER STAGES, fixed a bug where not all of a Missile Unit’s red points of impact would be visible to the player before it fired.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In USER STAGES, fixed a bug where play stats were not recorded after the player reached Level 99.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In USER STAGES, fixed a bug that would cause Motorized Drones placed via the STAGE CREATOR’s COPY command to make random movements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In USER STAGES, fixed a bug that prevented gates from being destroyed when placed in front of Block Lasers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In STAGE CREATOR, fixed an issue that prevented players from using Undo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In STAGE CREATOR, fixed an issue that caused the Filter to reset after switching between mouse/keyboard and controller input.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "In STAGE CREATOR, fixed a bug that prevented Data Size from updating after adding or deleting the route to a Motorized Block.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In STAGE CREATOR, fixed a bug where the number of Pushable Blocks/Pushable Laser Blocks per stage would be counted incorrectly and prevent a user from placing more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In STAGE CREATOR, fixed a bug preventing the Laser Unit from being positioned diagonally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Miscellaneous adjustments and fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
