  {
   "id": "humanity-122565@1.09",
   "gameId": "humanity-122565",
   "displayName": "PATCH 1.09",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-05-31T00:19:55.000Z",
   "notes": [
    {
     "title": "BUG FIXES AND IMPROVEMENTS",
     "items": [
      {
       "text": "[PS4/PS5] In STORY MODE, fixed an issue where earning a trophy could simultaneously cause a different, incomplete trophy to activate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "In STORY MODE, fixed an issue where the “WHO’S A GOOD BOY?” achievement could not be properly acquired in rare cases. (Users who experienced this issue should earn the achievement immediately upon booting up the patched game.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Pushable Blocks could clip through one another when colliding head-on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where equipping certain human skins / forms negatively impacted their strength when pushing a Pushable Block against Others.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In VR mode, fixed an issue where background music would not play properly while fast-forwarding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In STAGE CREATOR, fixed an issue where deleting a block after connecting a switch would cause a soft lock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In STAGE CREATOR, fixed a problem where the UNDO function sometimes wouldn't work correctly..",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In STAGE CREATOR, fixed a rare issue where closing a tutorial video might break game functionality.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the End-User License Agreement (EULA).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Miscellaneous adjustments and fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
