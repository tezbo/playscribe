  {
   "id": "succubus-with-guns-169098@1.0.3",
   "gameId": "succubus-with-guns-169098",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-10-17T21:41:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're happy to announce to you the first update of the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The player's death mechanic was redone",
     "items": [
      {
       "text": "Now you don't have to start from the beginning after game over. You'll have a chance to be reborn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As starting everything from scratch can be disappointing, We’ve decided to make death mechanic a gameplay element with a chance to be reborn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After death your characters will leave their body to the parallel universe, where they’ll have to manage to collect life energy. Each piece of energy brings 10% hitpoints. Within time your characters will be reborn with the hitpoints earned.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the parallel universe the amount of life energy is limited, so don’t pick up every piece of it at once, otherwise your characters will die without the opportunity of being reborn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "At easy difficulty level your characters will always be reborn even if you haven’t collected any life energy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Some more updates",
     "items": [
      {
       "text": "Melee damage increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Melee damage effects and sounds added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sword damage increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Movement keys were added to the settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
