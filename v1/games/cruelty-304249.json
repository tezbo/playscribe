  {
   "id": "cruelty-304249@1.0.1",
   "gameId": "cruelty-304249",
   "displayName": "Update 1.0.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-17T17:58:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have made an update to correct the following issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug in which buttons can be operated during movie scenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the brightness of the entire game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "In addition, a note has been added to the store page regarding \"Warning about Photosensitivity Attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This product contains flashing light expressions in some scenes, which may cause photosensitive epileptic seizures. If you have a history of seizures or epilepsy, please refrain from playing this product.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
