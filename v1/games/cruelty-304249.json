  {
   "id": "cruelty-304249@1.1.1",
   "gameId": "cruelty-304249",
   "displayName": "Update 1.1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-08T13:51:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear User",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have made an update to improve gamepad operability in response to your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The fixes are as follows.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the camera would move left and right by adding play to the left stick button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix to increase the sensitivity of the camera on the gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
