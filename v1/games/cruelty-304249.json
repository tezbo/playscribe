       "category": "other"
      },
      {
       "text": "English, Japanese, Korean, Chinese (Simplified), Chinese (Traditional), Spanish (Spain), Spanish (Latin America), French, Italian, German, Russian, Portuguese (Brazil).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If there are errors in the translation, please report them in the thread.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
