  {
   "id": "cruelty-304249@1.1.0",
   "gameId": "cruelty-304249",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-27T08:39:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear User",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have made the following corrections as requested.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Flashing light on/off function.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Invert Mouse Y-axis function of the mouse has been added.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The following changes can now be made from the settings screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The light flashing on/off function allows you to set whether or not specific lights appearing in the game, including the title screen, will flash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* I apologize for the inconvenience, but the data structure of the save data will change,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "and I ask that users who have started this product at least once before version 1.1.0 delete their save data.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In Windows, the save data is stored in the following locations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Delete all files in the SaveGames folder.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "C:\\Users\\username\\AppData\\Local\\Cruelty\\Saved\\SaveGames.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
