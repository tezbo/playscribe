 "releases": [
  {
   "id": "motorcycle-mechanic-simulator-2021-142478@major-2026-11-27",
   "gameId": "motorcycle-mechanic-simulator-2021-142478",
   "displayName": "What’s on Your Motorcycle lift? Update comming soon.",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-11-27T16:15:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for telling us what you’ve run into in the workshop. Your reports help us track down those issues and we are working on major update to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/35097038/db469061592f6995295102c8c42c6056fa90f7bc.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also love seeing what you’ve been building, from your first motorcycle rebuild to the custom bikes you keep coming back to. Thanks to everyone who’s shared a screenshot, posted feedback, or spent time wrenching in the garage with us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Creating Motorcycle Mechanic Simulator 2021 allowed us to explore the world of automotive simulation from a very specific perspective. But there's much more to the automotive world, and we've been exploring some of those possibilities in our latest project.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're moving from two wheels to four with our upcoming game, Car Rental Simulator!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On December 17th, we're releasing a free prologue that will let you experience the early stages of running your own car rental business. Take care of your vehicles, serve customers, and gradually develop your company.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's a little look at what we've been working on",
     "items": [
      {
       "text": "If you enjoy the combination of hands-on vehicle maintenance and business management, you might find something interesting in our new project.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/4014180/Car_Rental_Simulator_Prologue_Early_Days/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for being part of the Motorcycle Mechanic Simulator community and for supporting our games over the years.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy wrenching!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
