 "releases": [
  {
   "id": "warhammer-survivors-376145@2.1.6",
   "gameId": "warhammer-survivors-376145",
   "displayName": "Hotfix 2.1.6",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-11-11T15:21:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hail Survivors,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been incredible to unleash Warhammer Survivors to the world, and we've really appreciated all the comments, reviews, suggestions and feedback you've shared with us in these first 24 hours of launch. Your feedback is important to us as we improve and enhance Warhammer Survivors, so please keep sharing it with us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The team are hard at work on our free content update that will be coming before the end of the year; however, today we've deployed hotfix v2.1.6 to address a couple of issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🎮 Platforms",
     "items": [
      {
       "text": "Steam",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: the changes in this hotfix will be applied to GOG, PlayStation 5, Xbox Series X|S, Nintendo Switch 1 & 2 and mobile platforms from next week.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "Patch Notes (Hotfix v2.1.6)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You will now be able to skip the chest sequence by pressing any button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaked Plague Marine boss variants and Meganobz so that they are not quite as impervious, making them easier to kill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the kill count requirements (D6 Dice and Nuln Oil) to unlock the Reikland Fleshshade and Agrax Earthshade Paint Pots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where dropped chests would appear in locations where the player could not reach them on the Gallowdark and Imperial Bastion stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Legend of Catachan, upon being rescued, would attack with a Chainsword instead of his signature Frag Grenade weapon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "⁠Fixed an issue where the player would be affected by poison clouds created by Mork's Mighty Mushroom long after the poison clouds disappeared.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where gameplay hints would sometimes fail to appear after being defeated by an Extremis Boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Warhammer Survivors Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
