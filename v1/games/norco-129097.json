  {
   "id": "norco-129097@1.0.4",
   "gameId": "norco-129097",
   "displayName": "Update 1.0.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-04-01T16:21:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just released version 1.0.4 EN including some critical bug fixes. Please find them below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disabled all gamepad support except for joystick/cursor interaction, confirm (A), cancel (B), and hint (Y).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will be adding full gamepad support in a later patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug causing the player to get stuck outside of Eagle Imports after speaking to Superduck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed \"Immediate\" speed text mode that could cause a couple of transitions during Act Two to fail.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that was causing the hotspot for the messenger to remain interactable after disappearing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed items/overworld/cellphone from UI inside ark.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Replaced \"hold and drag\" text with icon on the Apocryphon phone app.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added ability to exit credit screen with double click.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Have a great weekend!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
