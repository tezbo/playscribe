 "releases": [
  {
   "id": "norco-129097@1.4.5",
   "gameId": "norco-129097",
   "displayName": "Update 1.4.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-31T09:11:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello! We spent the past few weeks making NORCO Steam Deck verified. It's been compatible for a while, but in order to receive full verification, we made some slight UI modifications to support a 16x10 screen resolution. For now, this resolution is only supported on Steam Deck, but we'll make it available across all platforms in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, we deeply appreciate the feedback and bug reports that we receive. Because of this community's help, the game has been able to grow and mature since its release. With a team as small as ours, the kind of support you've all shown is invaluable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The best way to report issues and ensure that they get addressed in future patches is to use the bug reporting form available through Raw Fury's online portal: https://rawfury.atlassian.net/servicedesk/customer/portal/1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Below are some additional updates and improvements included in the 1.4.5 patch, many of them in response to your reports.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.4.5 Changelog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix \"screen flip\" bug that occurs if a player simultaneously presses the dive and zoom buttons in the lake.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix bug that causes the phone to disappear during choice selections when using the head drive app.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix bug preventing controller input after engaging with the pigman hotspot in the lake.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Make input diagram fade from the screen when any button is pressed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix attribution of \"Templars in Acadiana\" by Wilbur Stiles, which was mistakenly listed as \"Templars in Louisiana\" in the credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Edit script for brevity and clarity, and to address typos in Acts II & III.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjust the boat collision sensitivity during the puppet show and lake sequences.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Support 16x10 screen resolution for Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Reset/readjust UI on screen ratio change (this triggers when docking a Steam Deck).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "With abundant gratitude,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Yuts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
