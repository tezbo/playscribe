  {
   "id": "norco-129097@1.1.7",
   "gameId": "norco-129097",
   "displayName": "Update 1.1.7",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-06-16T21:04:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have just published Demo v.1.1.7.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.1.7 includes a hotfix for players in regions where commas are used as decimal separator (100,00 rather than 100.00).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you started the game playing 1.1.6, your savegame should carry over. but please feel free to let us know via Twitter (Geography of Robots / Raw Fury) or by directly posting a comment here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thank you for playing, we hope you enjoy this early look at the game and please feel free to send us your feedback via this form.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
