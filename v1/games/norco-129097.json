  {
   "id": "norco-129097@1.3.6",
   "gameId": "norco-129097",
   "displayName": "Patch 1.3.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-09-02T15:27:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1.3.6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "CHANGES",
     "items": [
      {
       "text": "Fix various auto combat bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Edit Act 1 dialogue for brevity & clarity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Color adjust several scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also includes 1.3.5 updates for non-steam-pc builds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "KNOWN ISSUES",
     "items": [
      {
       "text": "Minor edits to the Act 1 dialogue needs to be re-localized. We'll have these changes reflected in all languages in a new patch next week.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We found a bug that was introduced in 1.3.5 or earlier: the mouse scroll wheel isn't working in the bedroom computer scene. Holding and dragging to scroll still works. We'll address this asap.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
