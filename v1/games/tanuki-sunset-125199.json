   "announcedAt": "2020-12-08T05:44:49.000Z",
   "notes": [
    {
     "title": "v1.0.1",
     "items": [
      {
       "text": "Hey there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you very much for playing Tanuki Sunset. We hope all of you are having a rad time drifting down legendary trails ~",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Launch weekend was very exciting for us. We short-listed critical bugs that were impacting the experience of our players. These are the major changes that were addressed in this version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Tutorial level sometimes not loading properly after resetting Save Data.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed unintended behaviour when using controller and keyboard input at the same time.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed 'Near Miss' tricks triggering from the Phone pick-up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed score on Arcade Trials not properly saving after holding a previous record.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed BGM not moving on to the next song.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed radio BGM overlapping with some cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added confirmation panel prompt before leaving a level in progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added missing 'Stickers' information panel from Map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added option to hide speedometer and map HUD to Bob's radio.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted song list to prevent much repetition of specific songs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted car horn variety and volume.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Thank you for your patience and understanding! Keep enjoying Tanuki Sunset!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We can’t wait to hear your stories and feedback - find us on our Twitter: @rewindgamesca or through our email: hello@rewindgames.ca",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jose M",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rewind Games",
       "ps5ProOnly": false,
