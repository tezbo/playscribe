  {
   "id": "f-i-s-t-forged-in-shadow-torch-115851@1.004.006",
   "gameId": "f-i-s-t-forged-in-shadow-torch-115851",
   "displayName": "Patch 1.004.006",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-10-18T03:33:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "● Fixed a bug that a specific door in Underwater Base does not open in ultra-wide resolution (21:9 or above).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "● Fixed a bug that the map in the Mine can not reach 100% completion in some languages (French, German, Spanish, Portuguese, Russian).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed the display error when switching weapons with the keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "● Optimized the UI of switching weapons. The weapon UI will display once the input for changing is received now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Optimized the cutscenes of the fights with Cicero. They can be skipped when retrying the fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Optimized the chasing sequence in Ancient Complex. It gets easier under Easy difficulty now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Other minor bug fixes and optimizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
