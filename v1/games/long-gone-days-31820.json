  {
   "id": "long-gone-days-31820@patch-2023-12-12",
   "gameId": "long-gone-days-31820",
   "displayName": "Long Gone Days Welcomes New Patch with Simplified Chinese Support!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-12-12T21:40:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey there, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're absolutely thrilled to share that the latest patch for Long Gone Days is now live, and the game is officially available in Simplified Chinese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Simplified Chinese Language Support",
     "items": [
      {
       "text": "With the addition of Simplified Chinese, we're opening the doors for even more players to embark on the emotional journey of our protagonist, Rourke. With today’s addition, you can now play Long Gone Days in English, French, Traditional Chinese, Simplified Chinese, German, Spanish (Latin America), Russian, or Portuguese (Brazil)!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remember, if you come across any new issues, feel free to use our Discord server or the Bug Report Form here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
