  {
   "id": "long-gone-days-31820@post-2016-08-09",
   "gameId": "long-gone-days-31820",
   "displayName": "Demo Updated + 40 hours left!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2016-08-09T15:29:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This is an important notice to let you guys know the demo has been updated. There was a bug that made the demo end during this scene:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's actually only half of the demo. The demo should get automatically updated on Steam (it's an 8kb fix), so it works fine now and previous saves are compatible with the new version. We're sorry for the inconvenience.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "That aside, there are only 40 hours left before our Indiegogo Campaign ends and we are at 85% at the moment: http://www.igg.me/at/longgonedays",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Finally, we want to thank everyone for your constant support! We can do this!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
