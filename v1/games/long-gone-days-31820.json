      {
       "text": "BUG: Added missing name to one NPC from the last dungeon of Chapter 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BUG: Fixed \"Lost Keys\" sidequest conditions so it doesn't say 66% after being completed without watching the first cutscene",
       "ps5ProOnly": false,
