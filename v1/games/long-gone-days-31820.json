   "displayName": "Important Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-01-08T13:09:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have posted a very important update regarding our upcoming release. You can check the announcement on our devlog.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't hesitate to reach to us via email, social media, or even leaving a comment here if you have any questions.",
