  {
   "id": "long-gone-days-31820@0.1.3",
   "gameId": "long-gone-days-31820",
   "displayName": "Update 0.1.3",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2018-03-30T20:45:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've updated the game with fixes to most of the bugs and issues that have been reported from the Bug Report Thread.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Some of the fixes included with this update are",
     "items": [
      {
       "text": "Fixed typos and grammatical errors in English and Russian texts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Capped the FPS to 60.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Add visual and sound effects to healing items used in battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the item \"Sweet Cookies\", which wasn't working as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix collision on one of the Forest Maps that allowed the player to reach unintented locations.: We're still working on adding an option to remap the game controls, and also adding controller support.: We want to thank everyone who's played the game so far and has taken the time to report all of these issues!: Cheers,: LGD Team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
