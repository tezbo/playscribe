       "category": "other"
      },
      {
       "text": "TWEAK: Fixed collissions on Business Center, behind one of the roofs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TWEAK: Added missing German flags to some dialogues that are meant to be said in German",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TYPE: Fixed some items/skills descriptions for consistency (AGI instead of Agi, DEF instead of Def, etc)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TYPE: Fixed minor typos on German dialogues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
