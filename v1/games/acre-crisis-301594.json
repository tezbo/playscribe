  {
   "id": "acre-crisis-301594@1.4.2",
   "gameId": "acre-crisis-301594",
   "displayName": "Patch 1.4.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-03T20:34:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "-This patch completely fixes the security vulnerability present in many games made with Unity (CVE-2025-59489). At this moment, this vulnerability has not been exploited nor has it caused any problem; however, I highly recommend updating Acre Crisis to this version before launching the game again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you to all people playing Acre Crisis remember that you can report bugs in: https://discord.com/invite/AygFDaujxC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
