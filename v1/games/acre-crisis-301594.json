  {
   "id": "acre-crisis-301594@1.4.0",
   "gameId": "acre-crisis-301594",
   "displayName": "Update 1.4.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-08T20:52:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "-A while ago i coded an auto aim/aim assist system for the mobile and/or console ports of Acre Crisis, however, i am a little busy lately, so to not waste this characteristic i decided to insert it in the Main PC Version of the Game, this characteristic is disabled by default and you can enable it on the options of the game, i highly recommend enable this characteristic if you play with Gamepad, it improves a lot the experience. Aim Assist is only available for single player campaigns (Arcade and Story mode).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed a bug that caused the night and day cycle to bug when saving the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you to all people playing Acre Crisis remember that you can report bugs in: https://discord.com/invite/AygFDaujxC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
