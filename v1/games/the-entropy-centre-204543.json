 "releases": [
  {
   "id": "the-entropy-centre-204543@major-2023-03-23",
   "gameId": "the-entropy-centre-204543",
   "displayName": "Free Level Editor Update is here!🎉",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-23T22:17:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Puzzle Operatives,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are thrilled to announce that a new, exciting update for The Entropy Centre is here-- The Level Editor! 🎉🎉 We have been hard at work developing the level editor that will allow PC players to create their own unique levels and share them with the community.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "With the Level Editor Update, you will be able to unleash your creativity and design the most challenging, innovative levels you can think of. The editor is user-friendly and intuitive, with a wide range of tools and assets at your disposal.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Be the mastermind behind the most dastardly difficult time manipulation puzzles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Be the 4D artist who creates a beautiful showpiece of light, colour and time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Be the that one person who made a level shaped like a sandwich…for some reason.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Level Editor Update is available for free to all PC players.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "⏳LEVEL DESIGN COMPETITION⏳",
     "items": [
      {
       "text": "That’s right! We are also on the search of the world’s most creative puzzle operative, with prizes on offer such as a lifetime supply of Playstack games, a next-gen console of your choice, or even a master workshop on game building with the game’s developer and publisher.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We can't wait to see what amazing creations you will come up with. Hop on to our Discord to know more about competition!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
