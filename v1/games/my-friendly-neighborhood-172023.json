  {
   "id": "my-friendly-neighborhood-172023@major-2026-01-08",
   "gameId": "my-friendly-neighborhood-172023",
   "displayName": "My Friendly Neighborhood Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-08T19:44:05.000Z",
   "notes": [
    {
     "title": "Thanks everyone,",
     "items": [
      {
       "text": "for the support as we launched My Friendly Neighborhood on consoles and updated the Steam version. The devs have been hard at work on bringing another update to squash any bugs and issues that cropped up during this time, along with a few changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Gameplay and Visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved lighting and AI navigation in the Pirate stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an additional enemy placement and some additional props.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved lighting and added props to the rooftop/antenna scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved lighting in the Garden Hedge Maze and added an additional enemy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved lighting in the Basement sculptor's room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the lights in the Offices Lounge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed lighting error in the Hotel Finale room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed lighting error in the Penthouse Secret Passage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed lighting error in the offices off the Executive Hallway.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some meshes with missing textures in the cityscape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a missing texture visible in the Back Courtyard.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI",
     "items": [
      {
       "text": "Updated UI and map assets for display at 4k",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slight alterations to the map for better readability and visual consistency.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a text overlapping error on the Offices map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes to text scaling and placement across the UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the gamepad cursor inside the tool chest to match the one inside Gordon's toolbox.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Conclusion note now displays text when viewed in Gordon's notes file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Control prompts now accurately reset after backing out of examine mode in the inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added \"Pause\" banner at the top of the pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Other small tweaks to text, including fixing typos and small formatting gaffs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Sound",
     "items": [
      {
       "text": "Volume of safe room music increased slightly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Volume of cardboard doors opening slightly louder.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Collecting a cheat tape in Speedrun Mode will no longer make that cheat impossible to get.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The dead zone on mouselook has been removed, so aiming on high DPI displays is possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the ability to rebind \"Menu Back\" to LMB.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Gordon no longer says \"I'm outta blocks\" every time you place a letter block with the gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A mouse holding a basketball in the Offices Museum no longer immediately falls through the floor into the abyss. (Sorry, lil' guy.)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Going into the Basement Entrance from an unintended direction (like in Free Cam Mode) no longer results in a white screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
