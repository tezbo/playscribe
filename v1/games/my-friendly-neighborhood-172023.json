  {
   "id": "my-friendly-neighborhood-172023@major-2023-10-20",
   "gameId": "my-friendly-neighborhood-172023",
   "displayName": "The Neighborhorde Mode Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-20T15:38:47.000Z",
   "notes": [
    {
     "title": "NEIGHBORHORDE MODE",
     "items": [
      {
       "text": "Hello from your friends at MFN! It's time to have some more fun with all of the friends you've made at the Studio in this brand new way to play. We are happy to introduce Neighborhorde Mode!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "FOUR PLAYABLE CHARACTERS",
     "items": [
      {
       "text": "There's some new faces at the MFN Studio! It's time to meet them and face the frantic horde of aggressively friendly faces. Get ready to gear up and pick one of the four new playable characters featured in the new mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "FOUR COMBAT ARENAS",
     "items": [
      {
       "text": "Choose from 4 different arenas based on the sets of MFN to face off against the hordes of frantic friends! Survive and fight against the clock and frenzying puppets to get the best possible score you can while trying to avoid what the Neighborhorde considers to be \"friendly\". Jump in on the frenzy of friendliness now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "NEW ACHIEVEMENTS",
     "items": [
      {
       "text": "Along with the brand new Neighborhorde Mode we've also added new achievements to go along with it! In addition there are also various bug fixes and some minor changes to the main campaign all included in this update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "That's it for now, if you're looking for more info or some Friendly Neighbors to talk and hangout with then head over to our publisher Discord or Twitter!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Social Links",
     "items": [
      {
       "text": "John \"Ducky\" Szymanski's Twitter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DreadXP Tiktok",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DreadXP Twitter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
