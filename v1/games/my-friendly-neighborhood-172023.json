  {
   "id": "my-friendly-neighborhood-172023@major-2023-07-22",
   "gameId": "my-friendly-neighborhood-172023",
   "displayName": "The Friendly Difficulty Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-07-22T14:27:49.000Z",
   "notes": [
    {
     "title": "Major",
     "items": [
      {
       "text": "A new difficulty has been added to the game! The Friendly difficulty eases back on some the challenging aspects of My Friendly Neighborhood, making it more approachable for our fans. On this difficulty, saving no longer requires tokens, puppets take less shots to down, and checkpoints are more frequent. You can select this new difficulty from the menu when you start a new game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Miscellaneous",
     "items": [
      {
       "text": "Save locations have been noted on the map with a new icon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made it impossible to map escape over \"Action\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Speedrun timer now only starts ticking after difficulty is selected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted some unfair enemy spawns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made the timings on the Greenhouse puzzle more generous",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various fixes and changes based on feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed achievement errors for Static and Streamlined",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various OOB softlocks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the rebinding screen would lock up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Green Triangle key could be discarded before it was completed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where you can softlock by falling of a certain set of stairs sideways",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where checkpoints would not trigger in the main Sound Stage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where toggling Bullet Model Change on and off could cause weapons to not fire",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where black bars would take up the side of the screen for 32:9 monitors",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issues relating to achievements unlocking from certain endings/cheats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an error where firing the shotgun .3 seconds before going through a door could softlock you",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an error where the Aviary door would not always spawn its teleport location",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Unlocks menu would sometimes appear as unlocked before it was actually unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(This also includes fixes from recent hot-fixes to the game.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "And as always, please post any issues you come across or feedback you may have in the My Friendly Neighborhood Bugs and Feedback Thread or on the relevant channels on the DREADXP Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
