  {
   "id": "kinduo-152689@1.0.5",
   "gameId": "kinduo-152689",
   "displayName": "Update 1.0.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-08-01T18:52:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Corrections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the phase 20 bug where the clouds weren't moving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the Rock when pushing the boxes touching the Electric, pushed it, making it cross objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Rock getting stuck when using the stomp attack on a box in some situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug when hitting the head in the elevator, when it goes down, now the character no longer grabs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "After the player chooses the stage on the selection screen, it is no longer possible to move the selector.: Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the strength of the Rock jump from 460 to 480, facilitating jumps over boxes and short stomp.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved stomp accuracy, enabling faster skip cancellation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the design of the pipes that connect to the left electrical block of phases 13,14 and 20.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed design of the sides of phase 20 and 23, thus avoiding accidental falls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the design of the left side of phase 30, thus avoiding accidental falls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game intro can always be seen when selecting the first phase of the game through the selection screen, but it can be skipped faster if the player wants.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
