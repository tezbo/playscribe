  {
   "id": "kinduo-152689@1.1.3",
   "gameId": "kinduo-152689",
   "displayName": "Update 1.1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-08-13T05:41:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As time goes by fast, it has been 1 year since we launched Kinduo on steam, our game is also available on consoles, we are very happy with our beloved game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We made some small changes, to improve the experience with the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added in the co-op screen, the 2 characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added steam username in the menu screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added controlling all menu screens with the gamepad analog.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a sprite indicating the game mode when choosing solo or coop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In the phase 24 box drop correction colliders",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the logo screen, you can now skip logos by pressing Start on the gamepad or Enter/Esc on the keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "When you choose to exit the game and come back, it will now return to the cursor position on exit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
