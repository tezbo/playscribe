  {
   "id": "kinduo-152689@1.0.7",
   "gameId": "kinduo-152689",
   "displayName": "Update 1.0.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-08-04T13:03:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Corrections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed stage 21 tutorial board in solo mode, board displayed Z+X commands, changed to Up Arrow + Z, which is correct.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Elevator now has the same ascent and descent speed all the time, we noticed that on some computers, the elevator was slower than it should have been, we reformulated the code so that it behaves the same for everyone, leaving the proper speed.: Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game menus and pause screen, can be moved with WASD.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In stage 28, added snowman and a tree.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
