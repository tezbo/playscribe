  {
   "id": "kinduo-152689@1.1.1",
   "gameId": "kinduo-152689",
   "displayName": "Update 1.1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-03T20:28:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Additions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now when changing characters, a trail is shown.: Corrections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Color correction in the elevator art.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed cloud bug in phase 10, which didn't move.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where the Stone when pushing the box, kept changing animations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug when the rock pushes the box and when it fell against the electric, it accidentally killed it.: Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Modified the system that moves the clouds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Redone the thank you screen of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved the electrical box collider 64 pixels to the left in phase 19, thus preventing the electrical box from accidentally going up with the elevator.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced movement time of the elevators of phases, 6, 9, 12 and 13.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
