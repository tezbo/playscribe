  {
   "id": "kinduo-152689@1.0.2",
   "gameId": "kinduo-152689",
   "displayName": "Update 1.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-07-30T20:23:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update 1.0.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Animation by sound designer Liniker on the credits screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Translated the achievements into Spanish, Italian and Brazilian Portuguese.: Corrections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When Rock was pushing a box and it was touching the wall or another box, he tried to run the pushing animation, now he doesn't start this animation in this condition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed swap bug after one of the characters enters the door.: Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Now after the character enters the door, control automatically passes to the remaining character on the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shortened transition time between phases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased 5db in the dash sound.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The skip-a-intro text only appears when the last frame enters the scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
