  {
   "id": "kinduo-152689@1.1.0",
   "gameId": "kinduo-152689",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-08-16T13:49:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We thank everyone for the feedback we are getting, making it possible to improve the game even more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We made some changes to the game, optimized the elevator, electrical box, doors, and minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added thank you screen after finishing secret stage.: corrections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug where electric phased out by itself.: Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased the Rock's movement speed by 8%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reprogrammed the secret stage camera so that it has a smoother movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved elevator movement, now it has a fixed time and can be modified more easily.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The electrical box is deactivated more quickly when the elevator reaches the end of the movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The door now only opens 1 time, it is not closed, remaining open for the second character to enter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
