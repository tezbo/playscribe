     "items": [
      {
       "text": "Additions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game version appears on the menu screen, disappearing after 2 seconds.: Corrections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the design on the left side of phase 21, allowing the Electric to melt the snowman, then returning to the electrical box.: Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the design of the pipes of phases 7, 11, 12, 13, 14, 20,",
       "ps5ProOnly": false,
