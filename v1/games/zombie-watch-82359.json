  {
   "id": "zombie-watch-82359@0.2",
   "gameId": "zombie-watch-82359",
   "displayName": "Update 0.2",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2019-08-02T12:17:17.000Z",
   "notes": [
    {
     "title": "Hello!",
     "items": [
      {
       "text": "Good news - you can now explore the desert in Zombie Watch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update brings a very exciting addition to the world of Zombie Watch, the sand biome with new plants. There are new special places in the desert, like the big oasis town, a few smaller towns, abandoned trailer places, rock formations on some parts of the beach and a shop in that area. With a whole new biome, there are a few new items to add to your inventory when exploring this place, for example, a cactus which also gives you a little bit of food. New towns are full of jumping puzzles, where you can explore the rooftops of the buildings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another thing is, we added searchable cupboards, boxes, and closets to the buildings of Zombie Watch. This is a whole new way to explore the houses when searching for loot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Also",
     "items": [
      {
       "text": "Fixed some bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some inventory items not showing correct values",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Moved some world resources",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved stability and performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Lowered the damage of Bat weapon: Thank you very much for your support!: ZW dev team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Twitter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Facebook",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Instagram: Thanks,: ZW Dev Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
