  {
   "id": "zombie-watch-82359@0.3.3",
   "gameId": "zombie-watch-82359",
   "displayName": "Update 0.3.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-11-26T16:58:04.000Z",
   "notes": [
    {
     "title": "Hello",
     "items": [
      {
       "text": "This update brings a lot more content for you to explore and loot!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We added numerous new special places, houses, cottages, industrial areas, residential houses, gas stations, and a big town, which is actually the biggest in Zombie Watch yet. This town has its own police station, a store, a gas station, two shelters, a lot of industrial buildings and garages, residential areas, a basketball court, a park, a church and more with many searchable cupboards, boxes, closets, and cars. In this town and other special places, there is a lot of loot, which include food and drink items, junk items, medicine, and many more. The new town is located near the Harvesters where you can fast travel to, the other new special places are scattered around the Zombie Watch map, with most of them on your way to the desert, tundra and winter area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We added another cool feature, an indicator for all the pickup items for better visibility. You will not miss and walk away from an item anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another new feature in Zombie Watch is that we moved some of the notification to a new floating bubble, so it feels like the character is talking to you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also, the tree leaves now disappear when you get close so you can chop the trees better than ever!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ZW dev team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Twitter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Facebook",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Instagram: Thanks,: ZW Dev Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
