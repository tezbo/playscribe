  {
   "id": "labyrinth-of-the-demon-king-188867@1.21",
   "gameId": "labyrinth-of-the-demon-king-188867",
   "displayName": "Update 1.21",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-05T21:10:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're pleased to say that the 1.2 patch for Labyrinth of the Demon King is now live on the main branch! This comes following a period of extensive testing, and the prior public access for the update available on a preview branch. For clarity, the preview branch and the main branch are now on the same version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Before we get into the changelog for this version, we'd like to quickly say welcome to all new players of Labyrinth coming in from the Steam Summer Sale, and we appreciate all of the continued support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog for version 1.21 (same as prior preview builds)",
     "items": [
      {
       "text": "Fixed aspect ratio reverting to 4:3 during in-game cutscenes while a wide aspect was selected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed background showing behind item placement menu in 16:9 or 16:10 aspects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Tea making ceremony aspect ratio reverting to 4:3 when 16:9 or 16:10 was selected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed irregularity with Nuppeppo boss fight larva behaviour",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added extra localisation strings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed textures sticking out in some locations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added stash box to tea house",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added compass item to merchant’s store inventory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted all maps to be North orientated to match compass",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted code for bleed and other status effects to be framerate independent",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added safe zone to HUD widget",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted stairs in Nuppeppo boss room and adjusted nav mesh settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed scroll bar on several widgets to better fit other HUD items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug where headshot ranged damage modifier was used for melee weapon headshots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed kicks being parryable on some weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added option to toggle HUD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added option to toggle crosshair",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added option to toggle widescreen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added option to equip torch instead of lantern if using a 1 handed weapon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added option to lower intensity of film grain",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added ability to remove equipped armour",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added missing teleport cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed how stamina regeneration works",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made larva bigger and increased it's hitbox size",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Nuribotoke having trouble climbing stairs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where NPC leaving mid conversation would leave the player stuck in dialog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing in air animations for war axe",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the Jailer would T-Pose during his teaser",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lowered resolution of controller icons to fit the aesthetic better",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed missing translation for single slide of kings court puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed conditions for interacting with priest after Tsuchigumo death, hopefully fixing issue where people can't interact with him",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added changes to receive damage code, hopefully fixing issue where bosses can lose too much health from a single hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you for the continued support for Labyrinth of the Demon King, and stay tuned for more cool updates...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
