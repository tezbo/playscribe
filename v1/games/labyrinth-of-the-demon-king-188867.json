  {
   "id": "labyrinth-of-the-demon-king-188867@major-2025-09-23",
   "gameId": "labyrinth-of-the-demon-king-188867",
   "displayName": "Labyrinth of The Demon King NG+ Update Launches October 27th",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-23T18:00:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're extremely happy to announce that the cycle of life and death continues...and with it comes a much anticipated free content update. This October 27th at 10am ET, delve back into the ominous labyrinth. This free update does not change the labyrinth you've come to know and love, but rather adds an expansive set of new end-game content for once you've finished the game initially.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New weapons, enemies, puzzles, mechanics, interactions, and much more await you. Rise once more, ashigaru. Rise!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Check out the official announcement here, featuring a first look at NG+:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For those who have purchased the game elsewhere on consoles, this patch will be coming alongside the prior patches previously available on PC & GOG.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
