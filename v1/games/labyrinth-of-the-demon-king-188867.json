  {
   "id": "labyrinth-of-the-demon-king-188867@1.01",
   "gameId": "labyrinth-of-the-demon-king-188867",
   "displayName": "Patch 1.01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-20T17:36:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all, as discussed within our initial post-launch update post, a new post-launch patch is now live for Labyrinth of the Demon King.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Just to reiterate, the changes in this patch are",
     "items": [
      {
       "text": "Added framerate cap options (and warning popup that some behaviour may be unpredictable at very high frame rates)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Disabled torch being unequipped when entering an exterior cell",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Using the quick equip torch button will now equip the lantern if the player has purchased it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed error where placeholder language names were used instead of official translated terms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed spelling error in Kings Court Puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where status effects would display “{Amout}” instead of the number for stack amounts for certain languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We hope this improves the experience within the Labyrinth of the Demon King. We're working on other reported issues and are still collecting some initial points of feedback, so stay tuned for more. Thank you for all the support so far!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
