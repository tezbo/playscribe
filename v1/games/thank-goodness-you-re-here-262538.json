  {
   "id": "thank-goodness-you-re-here-262538@1",
   "gameId": "thank-goodness-you-re-here-262538",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-08-13T16:13:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello gamers, our first little update is live now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixed",
     "items": [
      {
       "text": "Achievements not firing after credits roll",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Salesman appears at the wrong staff door when immediately re-entering Meggs after \"In for a Penny\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Menu/UI Sound Effects not altered by the volume setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Screen resolution displayed as Height x Width",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Misc. animation and collision issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Known Issues",
     "items": [
      {
       "text": "In some rare cases the game's audio plugin has trouble detecting DAC devices, potentially due issues with the plugin detecting ASIO drivers. If you experience this issue, please try disabling/enabling your other devices or switching the DAC out of ASIO mode if possible. We've not been able to reproduce this in house, so If the problem persists please send us a message with the device details to help@thankgoodness.game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game was drawn and designed for a fixed 16:9 ratio, so ultrawide monitors or other resolutions outside this ratio will experience pillar/letterboxing",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Goodnight gamers x",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
