  {
   "id": "ender-magnolia-bloom-in-the-mist-287846@1.1.0",
   "gameId": "ender-magnolia-bloom-in-the-mist-287846",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-03-11T09:09:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch notes: 1.1.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New features",
     "items": [
      {
       "text": "◆Test your skills by challenging the new \"Boss rush\" mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Unlocked by defeating all the bosses in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Accessed by the \"Memories\" menu, \"Boss rush\" tab from any rest point.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Clear times and best attempts are saved as records.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Receive \"Fragments\" by clearing the challenge. The number of fragment received depends on the selected difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "◆Boss rematch feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Accessed by the \"Memories\" menu, \"Bosses\" tab from any rest point.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Receive \"Fragments\" by clearing the challenge. The number of fragment received depends on the selected difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "◆Carry over your progress and explore a harsher world with \"New Game +\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Unlocked by clearing the game and seeing a specific ending.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Start the game from the beginning while keeping your parameters, skills and items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "All enemies will be of higher difficulty, starting the game on a chapter higher than the previous maximum, and bosses will have more aggressive patterns.: ※Items related to quests will not carry over.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Items that were obtained previously will be replaced by either \"Material\" or \"Junk\" in New Game +.: Items that were not previously obtained can still be obtained in New Game +.: Items that were replaced in New Game + will be placed again when carrying data over a second time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New \"Relic\" upgrade level (++): \"Relics\" that were upgraded to the \"+\" level can be upgraded again to the \"++\" level at the relic refinery.: ※Upgrading a relic to \"++\" will further increase its effect or lower its slot cost.: ※\"Relics\" that could not be upgraded before are still not upgradable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "◆Other additions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Add a set logic to Skill, Equipment and Relics to easily switch between equipments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Add new gallery items and costumes obtainable by spending \"Fragments\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Adjustments",
     "items": [
      {
       "text": "Adjust some events to make scenario specific triggers a bit easier to understand",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Translation fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Small visual and gameplay fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
