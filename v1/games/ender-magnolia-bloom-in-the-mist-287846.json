  {
   "id": "ender-magnolia-bloom-in-the-mist-287846@1.0.4",
   "gameId": "ender-magnolia-bloom-in-the-mist-287846",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-07T06:26:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We just released the version 1.0.4, which contains a few gameplay adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch notes: 1.0.4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Adjustments",
     "items": [
      {
       "text": "Enemies parameter adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Support robot summoned by \"Luiseach, the Iron Witch\": lower stamina and: resistance to status effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Add automatic recognition of Joy-Con controller through Steam",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjust visuals between the \"Central Stratum - Steel District\" and \"Declan's Estate\" areas: to make the area change easier to see",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjust some SE that were too loud",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjust some routes in the \"Sorcerer's Academy\" area to make it easier to reach students",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Elemental damage (status effect value) is now nullified if the corresponding status effect is already set",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Automatically re-summon \"Muninn\" and \"Huginn\" after an event",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Hide the \"Compare\" window when selecting a Carapace in the Craftory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Brush up of animations on some enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Brush up some UI elements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Brush up some background visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fix input bug that would not allow to summon two pressure skills when buttons were pressed at the same frame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "When using the \"Instant death\" challenge, blighted damage area will not instantly kill anymore due to being necessary for game progression",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix the map completion display in \"Crystalline Realm\" when skipping a specific encounter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix the effect of the \"Headless Gold Statue+\" relic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix some translations errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various minor visual and gameplay related fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
