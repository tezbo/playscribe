   "notes": [
    {
     "title": "Major Fixes / Additions",
     "items": [
      {
       "text": "Crossplay added between all of the following platforms in public and private games: All different PC storefronts, Nintendo Switch, Xbox One and Series.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Virtual keyboard enabled for consoles for password input, allowing private games to support Crossplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Invite feature added (does not support Crossplay!).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Invites enabled for all consoles, within their own console families.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[PC only] In Friend Only games, Steam and Epic overlay supports inviting and joining into ongoing games, as well as inviting into lobby.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[PC only] Gog can invite friends into Friend Only lobbies through the invite button only.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[PC only] AMD: Fixed flickering shadows for older than RDNA2 cards",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "General fixes",
     "items": [
      {
       "text": "Fixed hosted lobbies sometimes not appearing in the \"Browse Games\" -list when there were many ongoing games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Plugged a memory leak.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare case where a joining player brought in an extra local player with them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed local players spawning off screen in some cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[Xbox only] Fixed an issue that would sometimes cause joining to fail on Xbox.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "[PS5 only] Fixed vibration not working on DualSense controller(s).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "[PS5 only] Fixed Experienced Heroes Achievement not triggering correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "[PC only] FPS limiter is now a slider instead of a text field in Steam Big Picture mode and Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[PC only] Steamdeck: Fixed and updated on-battery frame rate limit from 30 -> 60 fps.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Save system",
     "items": [
      {
       "text": "Fixed a case of getting stuck joining a game when player's save slots were full.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Quick Join creating new saves, if player already had a save of that game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "General Gameplay",
     "items": [
      {
       "text": "Last used character is now remembered in Classic games if players use a character not default for their player number.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed being unable to descend a ledge into ledgegrab if standing slightly over the edge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved ledgegrabbing on sloped terrain.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Disallowed client having story progress locked skills unlocked, that the host doesn't yet have, if they played the same save further on their own and then join back.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed \"Last player remaining\" -effect persisting after disconnecting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
