  {
   "id": "mortanis-prisoners-244846@major-2025-06-19",
   "gameId": "mortanis-prisoners-244846",
   "displayName": "Big update and a free prologue!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-19T16:00:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A major update ahead of the game's full release, which is coming in the next few weeks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update is already available, and you can also help support the free prologue:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/2469550/Mortanis_Prisoners_Prologue/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "all you need to do is download and launch it. This will help boost traffic on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The update brings a lot of new content, including an entirely new location.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bosses, a new enemy type, a map, ghosts, new puzzles, and even more action!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
