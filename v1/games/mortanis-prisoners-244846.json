 "releases": [
  {
   "id": "mortanis-prisoners-244846@patch-2025-06-26",
   "gameId": "mortanis-prisoners-244846",
   "displayName": "New Patch – Achievements and Updates",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-26T13:33:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the new update, we’ve added achievements, improved the puzzle text, and introduced a skip option for the rotating statues puzzle. We’ve also made many minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game is essentially complete, and those who have been waiting for the release can start playing now. We’ve decided to postpone the official release due to a low number of wishlist additions. For now, we’ll focus on actively promoting the game, potentially looking for a publisher, and preparing the game for a console release.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "During this time, we’ll be watching playthroughs on video platforms, continuing to test the game, and polishing any bugs that may arise.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
