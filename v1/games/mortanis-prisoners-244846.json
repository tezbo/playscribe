  {
   "id": "mortanis-prisoners-244846@major-2024-12-03",
   "gameId": "mortanis-prisoners-244846",
   "displayName": "Big Update! New content!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-03T02:05:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Good day!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update doubles the size of the game, adding new zones, weapons, puzzles, cutscenes, and enemies. It also fixes numerous bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The next update will also be large and will be the final one. It will include a significant amount of new content to diversify the gameplay and give it a fresh feel. I plan to release the next update no later than spring.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, the game’s name will be changed to Ashes of Suffering or something similar. Don’t miss the release when the name changes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
