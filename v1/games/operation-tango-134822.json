  {
   "id": "operation-tango-134822@post-2021-06-02",
   "gameId": "operation-tango-134822",
   "displayName": "Various fixes",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-06-02T19:57:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "-Fixed Incorrect Drone frequency in level 6 in cross-platform play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed Incorrect NPC frequency in level 6 in cross-platform play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
