  {
   "id": "operation-tango-134822@2",
   "gameId": "operation-tango-134822",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-10-15T13:00:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added hundreths of a second to the challenge timer displays for better speedrun accuracy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the case where you could stay stuck in a lockpick during the transition between the hotel and Dragon Island in Mission 6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced the possibility of network crashes during the lockpick gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed the black screen that stays displayed when restarting a challenge from the death screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced possibility that some achievements don't trigger",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed bug where symbols were not resetting properly at the end of challenge 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the arrows of the Gauge Control app in challenge 2 could not be selected when using a gamepad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the Challenge mode icon did not appear on the mission selection screen after being unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added FPS Limiter in Settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made the Discord link in the Challenge screen clickable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug where the Hacker could not send an appointment in Mission 2 when that player’s computer had some Windows regional settings like Thai",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
