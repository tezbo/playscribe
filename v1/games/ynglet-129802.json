     "title": "Changes",
     "items": [
      {
       "text": "Hey Ynglet,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you were watching the Akupara Games 8th anniversary live stream, you would have seen that the relaxing Ynglet will be receiving new DLC content. Here is the trailer if you missed it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The free content update will include new special levels to traverse through and and new atmospheric music to relax to. Mark your calendars for October 17th.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Riv otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
