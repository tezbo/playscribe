  {
   "id": "ynglet-129802@major-2022-08-10",
   "gameId": "ynglet-129802",
   "displayName": "Ynglet Content Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-08-10T17:04:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have big news: we’ve just launched a big content update for Ynglet!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ynglet has just launched on Xbox, and with the launch brings new content to the game, that’s available now on PC and Mac!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "With new levels, new mechanics and a secret minigame, we hope you’ll love checking out the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "A new Bonus World, which contains 19 new levels!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Including new and unique mechanics and lots of generated music and a new achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A secret unlockable mini game, which you get for completing the Story World in Negative Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Audio volume option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New loading screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Faster loading times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
