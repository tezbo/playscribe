  {
   "id": "beyond-words-375690@major-2026-06-26",
   "gameId": "beyond-words-375690",
   "displayName": "Beyond Words June Update - Now Live",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-26T17:00:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Wordsmiths,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A brand new update for Beyond Words is available now, bringing a fresh wave of improvements, balancing changes, bug fixes and new challenges based on your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Whether you’re chasing your first Platinum Trophy or pushing for the highest possible score, this update aims to make every run smoother, fairer and even more rewarding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s what’s new",
     "items": [
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Balance Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We’ve continued refining the overall game balance to ensure every run feels challenging, strategic and rewarding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Highlights include",
     "items": [
      {
       "text": "Improved unlock conditions for several difficult-to-obtain Mystery Packs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjustments to bosses and perks that previously appeared too infrequently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Rebalanced a number of challenging levels including",
     "items": [
      {
       "text": "Thermopylae",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Points Accelerator",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Powerless",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chokey",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Purple Pros & Cons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Worthless",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several difficult bosses have been adjusted so they no longer appear too early in a run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added additional time to all three timed levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Minor balancing changes have been made to a variety of cards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Coin Sticker payouts have been increased from 1 coin to 2 coins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Features & Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added over 1,000 new words to the dictionary.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Platinum+, a brand new challenge tier for players looking to go beyond Platinum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated the Tiles & Features page with scoring examples for +MULT and xMULT tiles to help players better understand advanced strategies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added additional visual polish throughout the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed a large number of bugs and addressed several exploits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "General stability and gameplay improvements across the entire experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you once again for all of your feedback and support. Every comment, suggestion and report helps us continue improving Beyond Words.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Keep sharing your thoughts, keep experimenting and most importantly…Keep spelling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "PQube & Mindfuel Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "XOXO",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
