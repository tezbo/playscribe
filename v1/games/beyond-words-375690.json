  {
   "id": "beyond-words-375690@1",
   "gameId": "beyond-words-375690",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-16T14:42:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're getting this first update out as soon as possible, while already working on more improvements for the next update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update contains over 70 improvements (mainly to game balance) based on player feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balancing Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Big changes to what a lot of the bosses do and when they might appear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted some of the round goal scores to reduce the big steps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Timed levels now give half score instead of no score if you run out of time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the payouts of a lot of cards, mostly upwards: Other Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Several UI changes to make it clearer when you have earned or will earn trophies. Newly-earned trophies made clearer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Levels that give you cards at the start now show a dialog before the game starts, to let you easily see what they all are",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added some more words to the dictionary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made it harder to accidentally close the shop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the wording of several cards for clarity or grammar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made minor improvements to the art for a few of the cards: Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed errors in the \"how to unlock text\" for MATERIALS Tile Pack and COLOURS Bumper Tile Pack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor problems with the behaviour of Supernova, Trader Joe and a few others",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect displayed x multipliers on Natural Breeder and Beetlebug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed very rare issue that allowed playing CATS in the tutorial and then getting stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several more minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
