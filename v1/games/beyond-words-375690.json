  {
   "id": "beyond-words-375690@2",
   "gameId": "beyond-words-375690",
   "displayName": "Patch 2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-23T16:04:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Wordsmiths,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just rolled out a new update to Beyond Words, bringing a mix of quality of life improvements, balance tweaks and bug fixes to help make your runs smoother and more rewarding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "New Active Perks tab added to the Game Info page, making it easier to track what’s shaping your run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A brand new Perk has been added… discover it in-game 👀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a one-off tutorial when you first reach Bronze or Silver to help guide your progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved clarity on several Power Card descriptions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Platinum Trophy icons have been updated to better stand out from Silver",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General tweaks and polish across the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Balance Changes",
     "items": [
      {
       "text": "Adjusted the flow and difficulty of early levels for a smoother start",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fine-tuned several card modifiers and tile stickers for better balance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue that could prevent the Free Parking Perk from unlocking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected the Sapling popup to display the right values",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed button prompts when no controller is connected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed UI issues in the shop and during scoring",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Addressed a range of smaller bugs to improve overall stability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Keep it coming and we’ll see you on the board.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
