  {
   "id": "darwin-s-paradox-331202@patch-2026-05-06",
   "gameId": "darwin-s-paradox-331202",
   "displayName": "Community Patch is now available for Steam and Steam Deck!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-06T16:36:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello octopi around the world!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve been blown away by your support and kind messages for Darwin’s Paradox. We’ve also been listening closely to your feedback - and today we’re happy to roll out our Community Patch, focused on delivering a smoother, fairer, and more readable experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the main improvements",
     "items": [
      {
       "text": "· Better visibility for certain lethal hazards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Adjusted enemy behaviors and patrol patterns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Reworked camera angles to help you anticipate what’s ahead",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Improved lighting in several areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Improved handling of the robot suit in “Suiting Up!” chapters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Fixed sections that could lead to soft-lock situations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Fine-tuned checkpoint placement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Shorter respawn times to improve pacing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Refined puzzles with clearer hints",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Reduced frequency of Help System prompts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Performance optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Bugs fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New: Cinematic Effects settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can now customize the game’s visual style directly in the Graphics menu:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Motion Blur",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Sharpen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Grain",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Vignetting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Chromatic Aberration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks again for your support, we hope you enjoy this enhanced version of Darwin’s Paradox",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "ZDT Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
