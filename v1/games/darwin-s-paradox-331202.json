       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Added a shader pre-compilation system to improve overall gameplay smoothness",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Fixed an issue where the resolution could reset under certain conditions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We look forward to seeing you when the full game launches on April 2nd, 2026!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
