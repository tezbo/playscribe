     "title": "What's new in the Demo",
     "items": [
      {
       "text": "Full Steam Deck support!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "including a dedicated “Steam Deck Mode” available • in the Settings menu",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Fixed a temporary freeze occurring when using camouflage for the first time",
