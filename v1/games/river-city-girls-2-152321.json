  {
   "id": "river-city-girls-2-152321@post-2022-12-16",
   "gameId": "river-city-girls-2-152321",
   "displayName": "FRAMERATE FIX INCOMING!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-12-16T01:05:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve seen reports of framerate issues from players of River City Girls 2. After investigating, we’ve discovered that although the game is outputting at 60fps on PC, Xbox, and PlayStation, issues in the code are preventing certain elements from rendering at the full framerate. We believe we have a fix, although this will take some time to test and finalize. In the meantime, we’d like to make a beta version of this build available as an option to all PC owners of the game. This fix only affects Local Play for now. To participate, please follow these instructions:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "From your Steam library, right click on the River City Girls 2 game title",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Click PROPERTIES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select BETAS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Type in the following code: openbetabranch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Click the CHECK CODE button",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Click the OPT IN button that appears",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Close the PROPERTIES window",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game should now update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you to all our fans for your patience and for providing feedback on the game. We hope you all enjoy our latest adventure in River City!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
