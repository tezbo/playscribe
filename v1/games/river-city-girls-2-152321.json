  {
   "id": "river-city-girls-2-152321@major-2023-06-02",
   "gameId": "river-city-girls-2-152321",
   "displayName": "River City Girls 2 Performance Update Now Available",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-02T03:22:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The River City Girls 2 performance patch is now live! Thank you, everyone, for your patience. This update includes over 100 changes and adjustments of various types, and while most of them were things like \"an apostrophe was missing here\" or \"enemies can clip through an object in this room,\" here is a non-exhaustive list of some of the key changes that players should be aware of.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Frame Rate/Performance",
     "items": [
      {
       "text": "The animation rate and camera movement have been updated for smoother gameplay, effectively displaying at 60 FPS on PC. Performance has been further improved in problematic areas such as Ocean Heights Beach Plaza and the School Auditorium.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "New Game+",
     "items": [
      {
       "text": "New Game+ can be replayed again after defeating the final boss in New Game+ mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Provie can now perform air specials and air grabs from aerial light combos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Riki's Guard Break now always dizzies enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Human Weapon can no longer be used to remove enemies from screenlock battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Player stats now show a full bar when maximized.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could cause the game to freeze if you defeat an enemy while equipped with both Gamer Guide and Bomb Bottom.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Coach's Hat now increases the damage dealt by all recruits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues causing players and enemies to occasionally go out of bounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated some Honkr mission tracking for better accuracy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue causing players to sometimes miss Honks and Quest rewards while transitioning through doors in multiplayer mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The confirm button when hiring Henchmen is now consistent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "An exploit that allowed players to avoid dying and return with full health has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game credits have been updated for content and scrolling speed has been updated for better readability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated text in some of the Japanese motion-comic cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various issued caused by disconnecting controllers at certain times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various graphical issues causing shadows or other elements to not display properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various typos have been fixed across all languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various other minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
