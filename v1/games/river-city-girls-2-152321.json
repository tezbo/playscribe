  {
   "id": "river-city-girls-2-152321@major-2024-12-04",
   "gameId": "river-city-girls-2-152321",
   "displayName": "River City Girls 2 Double Dragon DLC & Free Update Out Now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-04T15:14:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The premium River City Girls 2 Double Dragon DLC, adding renowned fighters Billy & Jimmy Lee as playable characters, is available now on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Lee brothers jump into battle as distinct warriors, ready to throw down with bone-shattering moves like the Cyclone Kick and Rising Knee! The bros are fully integrated into River City Girls 2's story mode, complete with full voiceovers by returning voice actors Dan Avidan (Billy) and Arin Hanson (Jimmy) of the Game Grumps, plus this DLC includes an epic new rap song (performed by Hanson and Avidan with music by series composer Megan McDuffee) and new dojo master Boro!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, a new free update is available to all users, adding a Double Dragon themed motion comic, a Double Dragon inspired training dojo, character color palettes, same-character online gameplay, the \"Devil's Candy\" shop (a crossover with the popular manga of the same name), and the \"Season's Beatings\" shop (which sells a powerful, exclusive new accessory every two months and features the voice of Jaiden Animations as shopkeeper Miho)!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
