   "id": "river-city-girls-2-152321@patch-2023-07-10",
   "gameId": "river-city-girls-2-152321",
   "displayName": "River City Girls 2 Balance Patch Now Available",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-10T23:58:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new balance patch is now available for River City Girls 2 on Steam as well as all other platforms in North America and Europe! Based on player feedback, this update primarily adjusts hitstop, allowing for more user-friendly combos and juggles. Thanks for continuing to enjoy River City Girls 2!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
