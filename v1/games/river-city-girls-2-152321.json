  {
   "id": "river-city-girls-2-152321@major-2023-06-13",
   "gameId": "river-city-girls-2-152321",
   "displayName": "River City Girls 2 - Balance Update Public Beta",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-13T00:24:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new River City Girls 2 update is now available on the existing open beta branch! Based on user feedback, this balance update revises hitstop to make it more like it was prior to the previous update for easier juggling and combos. To access the beta branch:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "From your Steam library, right click on the River City Girls 2 game title, then:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Click PROPERTIES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select BETAS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Type in the following code: openbetabranch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Click the CHECK CODE button",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Click the OPT IN button that appears",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Close the PROPERTIES window",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game should now update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that while beta branch players can play online co-op with non-beta-branch players, more desync and rollback is likely to occur due to the changes to physics and hitstop. Thanks for your feedback and for continuing to enjoy the adventures in River City!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
