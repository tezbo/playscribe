  {
   "id": "tents-and-trees-240056@1.2",
   "gameId": "tents-and-trees-240056",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-11T16:32:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "While Tents and Trees is already \"Steamdeck Verified\", this update adds better support for the Steamdeck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "It especially adds a feature you requested: Touchscreen support!",
     "items": [
      {
       "text": "Touch screen works in the menus and in game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tap once on the grid to place a tent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tap twice to place grass.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If you tap on a the number in a row/column that has all its tents, it automatically fills the remaining cells with grass.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
