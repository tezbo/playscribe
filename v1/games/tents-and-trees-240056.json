  {
   "id": "tents-and-trees-240056@major-2024-12-08",
   "gameId": "tents-and-trees-240056",
   "displayName": "Layout update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-08T20:20:37.000Z",
   "notes": [
    {
     "title": "Features",
     "items": [
      {
       "text": "Customize the layout of your grid to match your preferences with this new update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Grid Placement Options",
     "items": [
      {
       "text": "Move the grid to either the left or right side of the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Numbers Placement Options",
     "items": [
      {
       "text": "Choose whether to display the numbers on the left or right side of the grid.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed a bug where the pause menu could not be closed if the steam overlay is opened in another game",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix a bug where you could place invalid tent-tree links",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrectly unlocking daily hard pack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
