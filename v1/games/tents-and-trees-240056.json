  {
   "id": "tents-and-trees-240056@1.1",
   "gameId": "tents-and-trees-240056",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-06T18:24:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here is the first big update since the release last month.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Themes",
     "items": [
      {
       "text": "The Tents and Trees (night) theme is now available immediately, no unlocking required.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When reaching 200 levels, you unlock two Minimalist themes: day and night.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Added Advanced Controls options in the settings",
     "items": [
      {
       "text": "Added an option to show icons when placing tents next to each other (can be disabled, ON by default). Changed the hint displayed when the grid was wrong because of tents next to each other.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option to update numbers around the grid to show the remaining tents while playing (can be disabled, OFF by default)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option to automatically fill grass at the end of level. Previously enabled by default, you can now disable it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
