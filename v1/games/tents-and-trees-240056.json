  {
   "id": "tents-and-trees-240056@major-2024-10-14",
   "gameId": "tents-and-trees-240056",
   "displayName": "Large Grids Update Now Available!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-14T06:09:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's a major update to Tents and Trees, I hope you'll like it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "480 New Levels",
     "items": [
      {
       "text": "24 packs ranging from 13x13 to 20x20 grids",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Theme",
     "items": [
      {
       "text": "Relax with this coastal-inspired theme",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "11 New Achievements",
     "items": [
      {
       "text": "All related to the new large grids.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Other changes",
     "items": [
      {
       "text": "Added tabbed UI in the level selection screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Star indicator when completing a pack without hints used.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaks to unlock conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
