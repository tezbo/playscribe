  {
   "id": "tents-and-trees-240056@post-2024-04-16",
   "gameId": "tents-and-trees-240056",
   "displayName": "Last improvements before release",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-04-16T15:53:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here is a last patch before the release next week, coming from feedback of recent beta tests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added keyboard support for undo and redo. You can undo a move with \"Ctrl+Z\" and redo with either \"Ctrl+Shift+Z\" or \"Ctrl+Y\"",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added support of \"fullscreen window\" (also known as \"borderless fullscreen\"). This mode is better than standard fullscreen if you are using multiple monitors, or multi-tasking a lot. Available from the settings menu.",
