  {
   "id": "tents-and-trees-240056@major-2025-01-09",
   "gameId": "tents-and-trees-240056",
   "displayName": "January 2025 Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-09T17:45:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update brings a few quality-of-life features and improvements based on your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Compact Layout",
     "items": [
      {
       "text": "You can now switch to a compact layout. Perfect if you don't want to be distracted by the animated UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The option is available in the settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Enhanced Touch Controls",
     "items": [
      {
       "text": "On Steam Deck and touch screen computers, you can now place tents with a single tap.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Better Hint Contrast",
     "items": [
      {
       "text": "The contrast of certain hints has been improved to make them more readable, especially on larger grids.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Found a bug? Have thoughts on the changes? Share them in the forums!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy camping!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
