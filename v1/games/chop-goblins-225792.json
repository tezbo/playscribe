  {
   "id": "chop-goblins-225792@1.3",
   "gameId": "chop-goblins-225792",
   "displayName": "Update 1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-24T14:31:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update 1.3 is now on the testing branch, for anyone who wants to help test it! This update will add bonus remixed levels, a mirror mode (\"Nilbog mode\") and several bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To access the testing branch, right click on the game in your Steam library, click \"properties,\" then \"betas\" and select the \"testing\" branch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For a full list of changes, consult \"changelog.txt\" in the Chop Goblins install folder.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
