  {
   "id": "chop-goblins-225792@major-2023-05-05",
   "gameId": "chop-goblins-225792",
   "displayName": "Free Content Update: Remix Levels and more!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-05T22:46:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 1.3 brings free new content to Chop Goblins, in the form of 5 bonus remix levels and Nilbog Mode, along with bigfixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "BONUS REMIX LEVELS",
     "items": [
      {
       "text": "Play through more challenging remixed and re-ordered versions of the five levels, featuring adjustments to times of day, enemy spawns, weapon progression, and more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "NILBOG MODE",
     "items": [
      {
       "text": "Nilbog Mode lets you play through mirrored versions of levels both new and old.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "CABINET OF CURIOSITIES",
     "items": [
      {
       "text": "Update 1.3 is free to all players, but if you want to \"pay\" for it you can purchase the Cabinet of Curiosities DLC for 99 cents, which features a collection of Chop Goblins wallpapers, avatars, memes (by the ever-great Kino Fabino), and more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "FULL CHANGELOG",
     "items": [
      {
       "text": "Added remixed levels!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Nilbog Mode (mirror mode)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "UI interaction prompt will now scale properly to lower resolutions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keyboard can be used to navigate main menu (requires bindings to be reset to defaults once to start working)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issue where damaging hazards wouldn't harm the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
