  {
   "id": "angeline-era-252768@42.1",
   "gameId": "angeline-era-252768",
   "displayName": "Update 42.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-12-09T03:01:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch notes (v. 42.1)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Han-Tani's Challenge properly loads. Before, starting a new game would actually meant you were playing on Melos's Trick. (Sorry!) If you thought you were doing a Han-Tani run you'll actually have to start over if you were going for the achievement!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Separated screenshake/flash into two options. If you had it turned off, the game should have both settings turned off, so you may want to check the setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Added the ability to disable double jumping for challenge runs, via the debug menu. If you're curious to try this, check the forums for info.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Updated the credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Japanese/Brazilian Portuguese Localization Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Minor visual tweak in a level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fix a Han-Tani challenge related bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
