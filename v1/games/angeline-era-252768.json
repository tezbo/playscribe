  {
   "id": "angeline-era-252768@44.3",
   "gameId": "angeline-era-252768",
   "displayName": "Patch 44.3",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-12-27T01:19:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all! First, we'd love for you to leave a review for Angeline Era if you haven't yet! It's okay if it's brief or short.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lastly here are the latest patch notes (minor spoilers). Thank you all for playing Angeline Era!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "44.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spanish version now available!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v 44.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix \"Floor\" Display in M---- level Japanese and other languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In late-game area O---------, slight visual adjustments made for hinting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Turkish version now available!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Internal work for future spanish/chinese/etc language support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v 44.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fix rare softlock when loading/saving under rare conditions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Boss rush: Combo stops increasing at 1% of base score (previously it was 20%)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Boss rush: I---- A---- base score 14000 -> 16000",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Boss rush: Attacks on I---- A---- now correctly affect combo meter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Boss rush: Using Un------ B----'s compost plots now costs no compost",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Boar boss: Normalize player attack at low levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Sor------ boss: Stop ghost from multi-hitting the boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Prevent getting stuck in slowmo when a gate is deactivated due to player OOB at the same instant the gate opens and causes slowmo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Adjust MountainLab room to prevent OOB deactivation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v 44.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Star Bars now actually appear in your inventory after purchase lol",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dismounting from bat does not cost compost now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "add additional bat mount points in Clarst Pavements overworld to prevent softlock when loading into level from title screen on empty islands",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent problems when walking in/out of boss room against U------- B---- and I---- A----.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Softlock fix in Dig with a View",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix OOBs in (Codename OVR_Dublin and StoneClimb)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Allow buying 0 cost items when you have negative money",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stop wand spheres from causing knockback to phase 2 of Lamb Boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix typo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Preparatory coding for upcoming localizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v 43.9",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix softlock related to boss rush that could save your file in a title screen loop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Make camera suck less in part of PT fight, adjust collision of a thingy in that fight and behavior of a thingy to make MHT runs less busted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor visual fix with shadows somewhere",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "collision fix (Codename O****A****)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "remove incorrect search teleport (O----B---)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera Zone fix in O****W****",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
