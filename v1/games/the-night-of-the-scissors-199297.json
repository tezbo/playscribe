  {
   "id": "the-night-of-the-scissors-199297@major-2022-10-25",
   "gameId": "the-night-of-the-scissors-199297",
   "displayName": "Halloween update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-25T00:37:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Get ready for some treat hunting!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Play The Night of the Scissors from October 25th to October 31st to find all the treats and get a special seasonal achievement. Keep in mind that if you miss the event, you will have to wait until next year Halloween season to get the achievement!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Good luck returning to the Snipper's hideout!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New",
     "items": [
      {
       "text": "Added Halloween event during the spooky week.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added seasonal killer Halloween custome.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added seasonal collectable Halloween treats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added seasonal Halloween achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Added missing Spanish translation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
