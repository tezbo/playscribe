  {
   "id": "sword-of-the-necromancer-resurrection-290642@post-2025-02-09",
   "gameId": "sword-of-the-necromancer-resurrection-290642",
   "displayName": "Minor bug fixes + Multiplayer tutorial",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-02-09T19:12:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added a tutorial for Flask of Homunculus (go to \"Intersection\" and get the chest if you don't have it, if you picked the chest, the tutorial will appear automatically when you enter \"Intersection\")",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed several attributes that weren't working properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a new functionality to Sensor attribute: if you kill a monster and approach it to resurrect it, you will see which kind of abilities does it have before getting it. This way, you can see if the monster has abilities (and which kind of abilities) or passive attributes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Stability fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
