  {
   "id": "codex-lost-235597@1.4.8",
   "gameId": "codex-lost-235597",
   "displayName": "Patch 1.4.8",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-18T17:27:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1.4.8 Patch notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Changed the mechanics of dropped arcana, now arcana will spawn where the player was recently rather than where they died. This means when falling into a death pit that the arcana will spawn near the ledge instead of in the pit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the walking/jogging animation of the player to be smoother and more similar to the old walk animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed some materials on the player so that a dither is applied when the camera is up close",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed player movement speeds slightly when walking and frozen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed behaviours and interactions on floating skulls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed some attack animation speeds on some undead enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the damage of Alestra’s light waves",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixed Midlight staff incorrect text display",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed detection bugs with various bosses such as Helberoth and the cursed beast",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed geometry in the Cren which could cause the player to become stuck in a tunnel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where dropped arcana would not spawn in the chapel of St Merim",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in the cradle of doom where the player could fall through the metal stairs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various typos in the spell crafting menu which would display the wrong materials needed to craft spells",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bugs in the spell crafting menu that might cause a player’s materials to drop into negative values",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where some charms would not appear properly in the inventory and equipment when obtained.: Patch notes from 1.4.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Significantly increased base movement speed (now jogs rather than walks)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced movement speed when frozen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased felt impact of incoming light attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced stagger potential and damage of blade spheres, floating chair summoners and limb crabs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased mana earned from parries",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased passive mana regen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed the collision from the underside of the penal village lift",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a laser graphic to green guiding stones",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Settings",
     "items": [
      {
       "text": "Added option to disable camera shakes in settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced motion blur significantly (by about 90%)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixed a bug where the 'cursed flaming beast' would lose aggro on the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the health bar of 'cursed flaming beast' would become: invisible after accessing the menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where in the Haragusket fight - parrying all his swords and then attacking might cause him to take no more damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug whereby casting different 0 manacost spells back to back: could cause the character animation to freeze or get stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug whereby getting hit by a medium weight attack several times: quickly in a row could cause the character animation to freeze or get stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed penal village where the player could get stuck in geometry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed craglands where player could get stuck in geometry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where continued parrying could reduce accumulated ailments: to infinite negative amounts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various small bug fixes such as typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
