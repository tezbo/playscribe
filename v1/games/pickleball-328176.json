  {
   "id": "pickleball-328176@major-2026-11-08",
   "gameId": "pickleball-328176",
   "displayName": "Pickleball Multisport update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-11-08T04:44:47.000Z",
   "notes": [
    {
     "title": "New look for the court screens",
     "items": [
      {
       "text": "Redesigned scoreboard: dark rounded panel, a highlighted row for the serving player with a ball badge, rounded score boxes with the current game highlighted, and a short pop when a score changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The fault table, workout tracker, instructions, shot readout and pop-up dialogs share the new style.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The scoreboard and side panels are smaller and lined up along the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sharper text in dialogs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The scoreboard no longer fades when you stand near the net.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Menus (desktop)",
     "items": [
      {
       "text": "Menus are now curved in desktop mode too, and the mouse works on the curved menus.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Menus, dialogs and the controls help (F1 / H) always draw in front of the scoreboard.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "On Out and double-bounce balls, players turn to watch the ball, and the desktop camera follows it, before everyone walks back.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The bot moves up to midcourt after returning your serve, instead of waiting at the baseline.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The sun lights your opponent instead of leaving them backlit, and re-aims when you change sides.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Local multiplayer",
     "items": [
      {
       "text": "The serve clock now runs in local multiplayer, with Player 2’s countdown shown on their side of the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The keyboard no longer hits shots for Player 2 when Player 2 uses a controller.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The court is lit from the side, so both players see it evenly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed errors from curved UI elements of zero size, which could flood the log.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
   "digest": {
    "new": 5,
    "fixed": 1,
    "balance": 0,
    "other": 6,
    "ps5": 0,
    "topNew": [
     "The fault table, workout tracker, instructions, shot readout and pop-up dialogs share the new style.",
     "The scoreboard and side panels are smaller and lined up along the screen.",
     "Sharper text in dialogs."
    ]
   },
