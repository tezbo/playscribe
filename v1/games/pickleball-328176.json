  {
   "id": "pickleball-328176@post-2026-10-21",
   "gameId": "pickleball-328176",
   "displayName": "Multi platform matchmaking for online matches",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-21T13:39:15.000Z",
   "notes": [
    {
     "title": "New",
     "items": [
      {
       "text": "Find Match now works on Steam. Turn it on and it looks for an open court in the mode you picked: Pickleball, Padel or Badminton.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If a court is open, you're asked whether you want to join it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If no court is open, Find Match hosts one for you. Players on Quest, PICO, PS5 and mobile can find and join it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "When someone joins your court, you're asked whether to start the match. Say no and your court stays open for the next player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "While you wait, Find Match keeps checking for other open courts every 20 seconds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "After a match, Find Match starts looking again automatically.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Improved",
     "items": [
      {
       "text": "The Find Match switch is now in the quick menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Find Match button now shows Join Queue or Leave Queue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The unused queue wait-time text has been removed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixed",
     "items": [
      {
       "text": "A yes/no dialog bug where pressing OK could also repeat the answer to an earlier question.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Known Limitations",
     "items": [
      {
       "text": "Doubles isn't available in Find Match yet. Use Courts for doubles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You need to be signed in to Steam to use Find Match.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
