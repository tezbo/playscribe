  {
   "id": "fling-to-the-finish-116840@patch-2022-10-26",
   "gameId": "fling-to-the-finish-116840",
   "displayName": "Halloween 2022 Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-26T17:52:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Flingers, quick patch here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We fixed a bug where the Witches' Brooms weren't showing up in the spookified levels. They're another catchup mechanic which allow teams who are falling behind to grab a ride and catch up to the first place team more quickly. They're also super fun and physics-based so we wanted to make sure they made it into this Spooky Season.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Team SplitSide",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
