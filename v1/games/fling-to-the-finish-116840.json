 "releases": [
  {
   "id": "fling-to-the-finish-116840@1.0",
   "gameId": "fling-to-the-finish-116840",
   "displayName": "Hotfix 1.0",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-02-02T16:51:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Oof! There were more bugs that snuck into the 1.0 launch than we’d like to admit! These bugs snuck past our testing because they’re all related to optimizations we needed to make for Fling’s console launch (which is coming soon).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "They’re fixed now! Thank you all for being patient and making us aware of these bugs on the Steam forums and on our Discord server.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed the major bug where no more than 3 players could join an online lobby.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where sometimes objects like trees and worms would be invisible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where the Bomb Run timer would freeze.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where the large elevator in Winding Woods would not spawn after pulling the lever.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where the falling pinball bumpers in Pinball Panic were missing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where unlocks were not properly showing in the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where usernames wouldn’t show in the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where player levels weren’t synced up correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where a few of the new characters were displaying incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
