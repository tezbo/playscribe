  {
   "id": "fling-to-the-finish-116840@hotfix-2022-07-28",
   "gameId": "fling-to-the-finish-116840",
   "displayName": "Fling-a-thon Hotfix Patch",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2022-07-28T07:02:45.000Z",
   "notes": [
    {
     "title": "Balancing Changes",
     "items": [
      {
       "text": "Reduced the overall XP gained from playing matchmaking tournaments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased the overall XP gained from playing private or offline tournaments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed: pedestal screen shows rogue/extra player banners with the name “Gettin_Jiggy_35” and overlaps all other menus if the pedestal screen is opened after completing a tournament where one or more players disconnected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: non-hosts are unable to exit out of the customization screen if the host leaves the unlockables menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed one instance of the infinite black screen on launch issue which happened because some devices failed to play the intro video and kept retrying to play it indefinitely",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
