  {
   "id": "parcel-corps-252860@major-2024-10-10",
   "gameId": "parcel-corps-252860",
   "displayName": "Performance update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-10T14:05:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi folks, thanks for your patience, it's fair to say that our Steam launch didn't exactly go off without a hitch! But, I'm happy to say this new patch addresses many of the issues folks encountered on launch day. We intend to support Parcel Corps for a long time to come so keep checking back, more improvements and extra content are in the works. Keep an eye on the discussion forum and thank you again for your patience. I hope you enjoy our game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Will Barr, Parcel Corps Game Director",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Notes - v98.9",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "“Contacts” character selection app not swapping player character",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Location icons not selectable in Delivery Rush",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Missions not removing custom drop-offs when completed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Items awarded by businesses unlock in Bike Shop app correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Grind rails disappearing in Parklands level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Control not returned to player after “Resistance” mission briefing cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "PlayStation type controller sprites added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Various cutscene animations updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In-game progression now more robust",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Additional graphics options:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Full Screen - a toggle cycle between Fullscreen and Windowed modes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "MSAA - can set anti-aliasing to values 2x, 4x, 8x, OFF",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Texture Quality - can set the texture levels in-game to values Low, Medium, High",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Motion Blur - a toggle to cycle ON or OFF: (This is in addition to the Resolution and VSync settings already present.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
