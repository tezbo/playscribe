  {
   "id": "parcel-corps-252860@patch-2024-11-25",
   "gameId": "parcel-corps-252860",
   "displayName": "Performance Patch Out Now",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-25T14:02:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Bicycle Courier!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We know a thing about false starts, but we’re committed to delivering the best satirical bicycle game in the world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today’s new patch focuses on bike tuning to remove more pesky bugs and adding more performance settings for your cycling pleasure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "It’s smoother! It’s faster! It’s funnier*! Features include",
     "items": [
      {
       "text": "Further performance settings including the ability to use FSR 3.0 or DLSS upscaling",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Achievement bug fixes, all achievements are now obtainable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Multiple progress blocking bugs resolved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved keyboard remapping UI",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Further environment optimisations and pop-in reduction",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Update now, patch up that flat, and get delivering those parcels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "(*Note: humour content does not change, all new jokes exist with our new trailer.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Parcel Corps is out now! Want to get updates on your Parcel Corps order? Follow us on Twitter, Instagram, and Tiktok. Also Join our Discord to get all the latest news and sneak peeks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
