  {
   "id": "parcel-corps-252860@2",
   "gameId": "parcel-corps-252860",
   "displayName": "Hotfix 2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-10-18T14:01:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Bicycle Courier!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we are releasing a small, but largely impactful hotfix to fix some of the kinks in the chains and buff out the handlebars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved issues with the Boss Fight, where the helicopter would not behave as expected, rendering the level unbeatable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the player character disappeared when leaving the Corporate Zone and entering the Old Town.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you all so much for the support and your continued feedback. Look out for our next patch soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Parcel Corps is out now! Want to get updates on your Parcel Corps order? Follow us on Twitter, Instagram, and Tiktok. Also Join our Discord to get all the latest news and sneak peeks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
