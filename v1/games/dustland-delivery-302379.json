  {
   "id": "dustland-delivery-302379@1.20.967",
   "gameId": "dustland-delivery-302379",
   "displayName": "Update 1.20.967",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-03T03:02:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Dustlanders!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "See below for notes on the latest update",
     "items": [
      {
       "text": "◈ Update Version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v.1.20.967",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◈ Details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Added mouseover tooltips to the character interface.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Optimized the interface for purchasing Creds and removed the limit on how many Creds you can purchase at a time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Modified artwork for a number of events.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With the launch of the new Sheol DLC, we'd also like to announce the winners of the last Mysteries of Sheol entry!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "#2 csatrad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "#8 hartley4879",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "#10 SilverVixen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you're name's on the list, check your Steam messages! You should've already received your OST activation code.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
