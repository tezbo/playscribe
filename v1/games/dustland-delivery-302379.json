   "id": "dustland-delivery-302379@1.21.88",
   "gameId": "dustland-delivery-302379",
   "displayName": "Update 1.21.88",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-28T09:08:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Dustlanders!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See below for details on the latest update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44994478/fe10c2699985a51dd8e4779700dabeeaa59d5078.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "◈ Update Version",
     "items": [
      {
       "text": "v1.21.88",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "◈ Update Details",
     "items": [
      {
       "text": "New Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added controller support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixes and Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved Fuel drinking feature for Robot characters. You can now choose how much Fuel they consume.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved interactions with NPCs in the Bar. Interacting with friendly characters now has a chance to grant crafting blueprints or recipes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issues with the fishing feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect reference prices for certain items when trading junk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with the effects of certain truck parts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a hotkey issue that would allow characters to gain multiple traits when upgrading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with setting up a stall which would cause the sales summary to be inaccurate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect data on the map that caused fishing yields in certain regions to be inconsistent with expectations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We encourage Dustlanders to try the new version with a controller or on Steam Deck, and we look forward to your feedback—whether bug reports or suggestions. Thanks once again for your support!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
