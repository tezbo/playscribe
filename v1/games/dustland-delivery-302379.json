  {
   "id": "dustland-delivery-302379@1.21.126",
   "gameId": "dustland-delivery-302379",
   "displayName": "Update 1.21.126",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-24T10:01:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Dustlanders!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "See below for details on the latest update",
     "items": [
      {
       "text": "◈ Update Version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v1.21.126",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◈ Update Details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Added the new Modules system for Robot characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44994478/fed7d30d268df38a30a44debfb4de8fe443a8305.jpg\"]Install Modules in Robot characters by pressing the \"Modify\" button on their character panel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44994478/01d40ddfdb6c3c364f589d4f37e9457ccbae0512.jpg\"]Players can obtain Pre-Fall Electronics to gain mod points, which are then spent to install or upgrade different Modules.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44994478/01b7d40f986e8623f395ddd8d7643e1b8bab6e75.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Modules grant various benefits, such as increased driving speed or more resources gathered when searching, but they also cause Robot characters to gain fatigue faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44994478/9841f9fc694f932dd85dc3312ae55d24ec0a21a2.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes and Improvements",
     "items": [
      {
       "text": "Fixed an issue where chatting with NPCs in Bars could cause crashes under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where success chances for trading junk with NPCs in bars were displayed incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where screen resolution could be set to unsupported options under certain circumstances, leading to display issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
