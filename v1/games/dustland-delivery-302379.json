  {
   "id": "dustland-delivery-302379@1.20.887",
   "gameId": "dustland-delivery-302379",
   "displayName": "Update 1.20.887",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-14T09:01:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks for your patience. After a short break, the Dustland Delivery team is back to work!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "See below for improvements and fixes in the latest update",
     "items": [
      {
       "text": "Expanded Apartments System: Apartments added to city descriptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved Character Recruitment: Characters recruited via events can be transferred to Apartments in player-owned cities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "UI Fixes: Fixed mouse scroll wheel UI issues.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "City Backdrops: Fixed an issue where cities would erroneously display \"tunnel\" backdrops.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Faction Relations: Fixed how planning roads affects faction relations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Combat UI: Fixed UI display issues for combat in player-owned cities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Text Fixes: Fixed text errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you to all our Dustlanders for your continued support. Safe travels!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dustland Delivery Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
