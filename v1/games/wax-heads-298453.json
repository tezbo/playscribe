  {
   "id": "wax-heads-298453@1.0.5",
   "gameId": "wax-heads-298453",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-10T08:57:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, Wax Heads!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've just released a new update featuring community-requested fixes, improvements, and some good news for achievement hunters!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's New",
     "items": [
      {
       "text": "Spanish localisation improvements – We've fixed a number of translation issues reported by players. Thanks to everyone who took the time to send feedback; it really helps us improve the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "MacOS build now available for testing – If you're playing on Mac and would like to help us test an upcoming Mac version, we'd love to hear from you on our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Book of Days achievement updated – The achievement now unlocks after reading 30,000 words instead of 50,000, making it achievable within a single English-language playthrough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes & Improvements",
     "items": [
      {
       "text": "Fixed visual issues affecting navigation arrows when using Compatibility Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed credits scenes where some artwork could overlap text when using alternative fonts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where item previews would not appear in The Wild Kindness Shop when using touch controls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue preventing players from opening zines from display stands using touch controls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a duplicate confirmation prompt that could appear when recommending Steven the Jarhead record during Customer Is Always Right mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed dialogue in Track 15 that was incorrectly displayed as narrator text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected a typo in Kiss Me Like You Mean It #6.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, thank you for playing and for continuing to send us your feedback and bug reports!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
