   "announcedAt": "2025-09-25T07:56:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "On 24 September 2025 at 06:00 (UTC), we applied balance adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Skills1 Show Them, Zarbon!",
     "items": [
      {
       "text": "・Cooldown time reduced: 30→20 seconds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Cooldown reduction based on Zarbon's remaining HP upon retreat increased: 60–40→80–40%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Time to reach maximum range reduced: 5→3 seconds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Effect of “Strike Defense Down” applied to enemies reduced: 100→50",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Skills 3: Imperial Decree",
     "items": [
      {
       "text": "・Increased boost speed when Dodoria is enhanced: 200% → 250%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased attack interval reduction when Zarbon is enhanced: 40% → 60%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Skills 1: Light Grenade",
     "items": [
      {
       "text": "・Cooldown time reduced: 20→15 seconds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Damage dealt increased: 2520/2800/3360→3000/3280/3560",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Super Attack:Special Beam Cannon",
     "items": [
      {
       "text": "・Maximum Charge Time Reduction: 4→3 seconds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Rush Attack",
     "items": [
      {
       "text": "・Damage Increase: 33→41",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "・Fixed an issue where the effect of “Frieza (First Form)”‘s Passive 'Fearsome Emperor’ could be interrupted by ally healing or contact with areas generated by himself or allies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Fixed an issue where skills targeting enemies or allies would activate without a valid target right before switching to GEKISHIN Burst.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Fixed an issue where Zen-Oh would disappear if a triple KO occurred right before he returned to his starting point.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Fixed an issue where Dragon Ball didn't display correctly when obtained.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We appreciate your continued support of “DRAGON BALL GEKISHIN SQUADRA”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
