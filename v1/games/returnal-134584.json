  {
   "id": "returnal-134584@patch-2023-03-09",
   "gameId": "returnal-134584",
   "displayName": "Returnal - March 9th Patch is Now Available",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-09T13:31:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greeting from Atropos!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have a new update today that aims to reduce stuttering and fix a number of crashes, alongside some other general fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Break the cycle on PC and find the full March 9th patch notes below!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Neil",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Multiple optimisation improvements to reduce stuttering on CPUs with fewer than 8 cores.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated PSO system to reduce stuttering when Ray Tracing is enabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed crash that can occur when finding or using translocators.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash that can occur during various combat or high particle effect situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enabled Intel's XeSS screen scaling technology on non-Intel hardware.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed blocker that can occur when killing the Typhonops and using a Reconstructor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed 3840x1600 resolutions not displaying correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Steam overlay run time being out of sync with in-game cycle time.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Optimised installation process to reduce file size.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're continuing to read through your feedback and are working on further performance improvements for a future patch, along with a fix for Translocators sometimes not registering and a number of fixes to the Co-Op experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
