  {
   "id": "returnal-134584@patch-2023-04-19",
   "gameId": "returnal-134584",
   "displayName": "Returnal - April 19th Patch is Now Available",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-04-19T14:13:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greeting from Atropos!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have a new update today that adds AMD's FSR 2, an option to manually rebuild your PSO cache data, and a number of other bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Break the cycle on PC and find the April 19th patch notes below!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Neil",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Upgraded to AMD FSR 2",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added option to manually rebuild PSO cache to Settings > Graphics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed specific hitches that can occur during boss fights",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed out of world issue when loading into the start room of Crimson Wastes after suspending",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with sandstorm appearing where it shouldn't in Crimson Wastes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with sandstorm vignette sometimes appearing on Crimson Wastes after suspending",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
