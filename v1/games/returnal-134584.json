  {
   "id": "returnal-134584@patch-2023-02-17",
   "gameId": "returnal-134584",
   "displayName": "Returnal - February 17th Patch is Now Available",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-02-17T18:35:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Welcome to Atropos!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are honoured to have so many new players experiencing our dark, deep and beautiful action thriller, Returnal!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bringing Returnal to PC and capturing that PlayStation 5 experience took a lot of work and focus from the team at Climax Studios, with support from Housemarque and XDEV. We have been blown away and are so thankful for the amazing reviews, feedback and reports you have shared with us so far.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "We have continued to work on Returnal since launch, monitoring your feedback and will continue to work on patch updates to support the game ahead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Break the cycle on PC and find our February 17th patch notes below!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Neil",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Fix for rare issue with music stopping during Biome entry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for certain Ultrawide monitor setups not being detected in Full Screen",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for incorrectly detecting the Windows resolution on first boot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for grass draw distance on Epic Particle settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for PSN Sign in time outs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fix for Benchmark results rounding error",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you’re experiencing a black screen instead of the opening cinematic, please ensure your Windows is up to date, including the VP9 Video Extension that comes bundled with Windows 10 and later.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We’re already hard at work on the next patch which will include performance improvements and a fix to correctly display at 3840x1600 resolution.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
