  {
   "id": "chasm-the-rift-12014@5",
   "gameId": "chasm-the-rift-12014",
   "displayName": "Patch 5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-06-02T14:27:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Stability improvements. Fixes for a few crash scenarios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game now uses a video card connected to a monitor instead of always defaulting to discrete graphics (useful with some laptops).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for the secret counter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Extra levels no longer affect achievements related to a complete game playthrough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a reset button in the settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the game's version in the lower right corner of the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Running is now bindable to the Lt button on controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor fix that prevents skipping a part of the second add-on level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor motion blur fix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor localization fixes for the German language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor UI layout modification.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The modding PDF guide now better explains how to use the --addon command.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
