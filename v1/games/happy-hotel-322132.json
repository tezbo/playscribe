   "gameId": "happy-hotel-322132",
   "displayName": "Update Notes for Dec 14",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-13T22:43:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone! I’ve been watching some awesome streams and videos of *Happy Hotel* and noticed a lot of players missed a certain secret ending. To help out without giving too much away:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Expanded audio cues for better discovery.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaked lighting to subtly highlight key areas.: Thanks for all the support and feedback—it’s been amazing watching you explore the hotel! 💀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
