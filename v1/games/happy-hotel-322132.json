  {
   "id": "happy-hotel-322132@major-2025-01-18",
   "gameId": "happy-hotel-322132",
   "displayName": "Jan 18 Update Notes: Optimizations, Controls, and Spiders (Oh My!)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-18T12:14:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We understand spiders might be a challenge for some players, and if that’s kept you from diving into Happy Hotel, we’ve got you covered!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "1. Arachnophobia Mode",
     "items": [
      {
       "text": "A new Arachnophobia Mode has been added to the Options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When enabled, spiders will be replaced with... well, NOT spiders! Now you can enjoy the game without the creepy crawlies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "2. Major Optimizations",
     "items": [
      {
       "text": "Improved performance to ensure the game runs more smoothly, even on lower-spec systems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Adjusted gamepad controls for a more intuitive experience",
     "items": [
      {
       "text": "Sprint is now on the left trigger.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Interact is now on the top face button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
