  {
   "id": "happy-hotel-322132@major-2024-12-15",
   "gameId": "happy-hotel-322132",
   "displayName": "Update Notes for Dec 15",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-15T03:22:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "After watching several streams and gathering player feedback, I've made some usability adjustments to improve the clarity and enjoyment of specific levels:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the trigger timing on the \"Chairs\" floor to provide a little more breathing room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Enhanced lighting on the multi-door floor to improve navigation and understanding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added audio cues to the Marco Polo floor for better player feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tweaked the \"Ball\" on the ball floor to feel less threatening.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved lighting on the water level to subtly guide forward progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
