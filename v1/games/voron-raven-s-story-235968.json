  {
   "id": "voron-raven-s-story-235968@major-2026-09-23",
   "gameId": "voron-raven-s-story-235968",
   "displayName": "Major Localization Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-23T15:24:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve completed a major localization update for VORON: Raven’s Story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All of the game’s supported languages have now gone through a new localization pass with the help of language specialists.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some languages were already translated by people before this update, while others still contained machine-translated text in parts of the game. With this update, we’ve worked to bring everything to a much more consistent level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For languages that previously relied on automatic translation, the text has been retranslated and reviewed by language specialists. Existing human translations have also received additional review and polishing where needed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The update covers",
     "items": [
      {
       "text": "English",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Russian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "French",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "German",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spanish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simplified Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brazilian Portuguese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Polish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "European Portuguese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Traditional Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Korean",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This should eliminate many of the awkward phrases, incorrect wording, and strange context issues that could appear in the previous automatically translated text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localization is a large part of the game, so if you still notice something that sounds unnatural or incorrect, please let us know. We’ll continue improving the translations based on your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
