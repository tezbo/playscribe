  {
   "id": "voron-raven-s-story-235968@1.2",
   "gameId": "voron-raven-s-story-235968",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-18T00:51:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The portals in the towers now glow yellow, just like the stone tablets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On the Sister Island, the weights have been moved closer to the door.: Balance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the timings in several puzzles.: Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where the first feather wouldn’t appear if you started a new game immediately after completing the previous one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Settings now save correctly when exiting the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed the ability to save in the Elder Mode (before the final battle).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved collisions in several areas for smoother movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
