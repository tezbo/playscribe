  {
   "id": "voron-raven-s-story-235968@1.1",
   "gameId": "voron-raven-s-story-235968",
   "displayName": "Patch 1.1",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-14T12:03:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added more sticks on the first island to improve early exploration flow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "An experienced developer explained to me that I don't actually need an EULA when using Unity Analytics — a Privacy Policy is enough. So the EULA was removed, and the Privacy Policy is available on the Steam page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the shapes and paths of wind routes between islands to make navigation smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Various balance updates",
     "items": [
      {
       "text": "Tweaked timings in several puzzles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the number of souls required to open certain portals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fishing has been made slightly easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a rare issue on certain hardware where players could not progress after the first cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Resolved missing music on some secret stone tablets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved collision in multiple areas for smoother movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed journal scroll bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
