  {
   "id": "voron-raven-s-story-235968@1.3",
   "gameId": "voron-raven-s-story-235968",
   "displayName": "Patch 1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-23T03:12:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Souls now react at a shorter distance. This prevents the player from seeing a soul’s response from the father’s island while standing on the mother’s or sister’s island.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The race on the sister’s island has been made easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Controller hints did not always display correctly when playing with a gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Music on the island would stop playing after winning the wind race.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed disappearing models on the father’s island.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the ability to pick up feathers while in the elder form.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
