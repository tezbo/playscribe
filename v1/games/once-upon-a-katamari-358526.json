    {
     "title": "\\[Free Content Update]",
     "items": [
      {
       "text": "・ Present items: “DJ Cap,” “DJ Sunglasses,” “DJ Hoodie”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・ Added a new Katamari in the Change Katamari menu.",
