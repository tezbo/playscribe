  {
   "id": "sword-of-the-necromancer-125885@major-2022-12-06",
   "gameId": "sword-of-the-necromancer-125885",
   "displayName": "Steam Deck Support Update + Sword of the Necromancer: Revenant announcement",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-06T16:53:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As the title says, we have updated the game to support Steam Deck. We were officially supported for a while, but we made some little changes so it works better, and also some other minor bug fixes, and as we didn't announce it properly before, we do now!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "For the occassion, we put the game on a whooping 70% off, so you can play on the go with your Deck for a very affordable price!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Sequel announcement",
     "items": [
      {
       "text": "Also, we would like to show you the game we are working on: Sword of the Necromancer: Revenant, a 3D sequel to Sword of the Necromancer. We have listened to all the feedback we received for the original game, and built the new one from the ground up considering it, while mantaining the essence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Help us by wishlisting Sword of the Necromancer: Revenant!",
     "items": [
      {
       "text": "Sword of the Necromancer: Revenant - Steam page",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can see more details about the game in its Steam page, and the trailer here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you like it! Thank you for your support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
