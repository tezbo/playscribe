  {
   "id": "sword-of-the-necromancer-125885@1.1f",
   "gameId": "sword-of-the-necromancer-125885",
   "displayName": "UPDATE 1.1f",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-02-03T15:49:43.000Z",
   "notes": [
    {
     "title": "Update notes",
     "items": [
      {
       "text": "Added a Bag that can store up to 4 items and is accessible at anytime. Items stored in the bag are not in use and thus do not grant any passive or active effect. Monsters stored in the bag are not healed nor recover their health with time as the monsters you have equipped. The bag will be available after the tutorial level and is enabled by default for all players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new options in Game Settings. You can now choose to recall monsters from anywhere, start the game on the floor you last played, and enable/disable the bag. Use the Game Settings to customize your experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Game Settings screen will appear a single time upon boot up after having cleared the tutorial, so no one misses them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed several minor bugs and crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
