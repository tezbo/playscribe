  {
   "id": "botany-manor-225426@patch-2024-04-09",
   "gameId": "botany-manor-225426",
   "displayName": "Small Launch Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-04-09T21:27:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "* Prevent players from exiting the tower while it's going up, causing them to soft lock the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Make sure the game doesn't autosave on resuming in main menu, overriding their save data.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
