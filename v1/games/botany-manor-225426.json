      }
     ]
    },
    {
     "title": "This patch includes a small amount of fixes",
     "items": [
      {
       "text": "* If you're holding an item when saving, you'll still be holding the item when you later load the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Added a fix for disappearing items, and any previously disappeared items will be in the spot they were placed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Have a great Tuesday!",
       "ps5ProOnly": false,
       "pcOnly": false,
