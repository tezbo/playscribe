  {
   "id": "the-mooseman-27358@major-2017-03-23",
   "gameId": "the-mooseman-27358",
   "displayName": "An update! German Localization!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2017-03-23T14:58:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "* Added the support of German language with full support of myths, collectibles and even logo!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed typos in English translation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed grammar issues in English translation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "---",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Добавлена поддержка немецкого языка с полным переводом мифов, артефактов и даже логотипа!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Исправлены опечатки в английском переводе",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Исправлены ошибки в английском переводе",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
