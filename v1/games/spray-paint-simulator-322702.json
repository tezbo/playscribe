  {
   "id": "spray-paint-simulator-322702@post-2025-06-07",
   "gameId": "spray-paint-simulator-322702",
   "displayName": "Gallery completion with lower spray tools and nozzles",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-07T18:59:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It should now be possible to complete the gallery with any of the available guns and nozzles, including the base Yopaint 2000 with the medium nozzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The initial intention was for people to use higher guns and nozzles, but ideally things should be possible with all equipment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some later levels may still currently require better equipment in order to feasibly complete them. We are in the process of adding additional messaging to highlight this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
