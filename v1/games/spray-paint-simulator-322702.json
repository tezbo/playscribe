  {
   "id": "spray-paint-simulator-322702@post-2025-06-03",
   "gameId": "spray-paint-simulator-322702",
   "displayName": "Hide Masking co-op sync",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-03T11:22:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Re-enabled 'hide masking' for free spray co-op. The host can now do it and it sill sync with the client.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fix for changing difficulty automatically completing a job on reload. If difficulty was lowered and on a subsequent run of the game a job completed instantly, it could get stuck in the spray stage without moving on. It will now check to see if the spraying has completed after it has reloaded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
