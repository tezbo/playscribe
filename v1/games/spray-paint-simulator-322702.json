   "id": "spray-paint-simulator-322702@post-2025-06-20",
   "gameId": "spray-paint-simulator-322702",
   "displayName": "Improved task highlighter and cherry picker",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-20T15:23:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Task highlight for unpainted areas has been extended to consider neighbouring pixels making areas of low paint density show up better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The cherry picker has a number of automatic stability improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A few beams on the bridge have slightly lower paint requirements to better account for the use of the medium nozzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save on termination now explicitly ensures it is never asynchronous",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
