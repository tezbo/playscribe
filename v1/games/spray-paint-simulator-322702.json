  {
   "id": "spray-paint-simulator-322702@post-2025-06-06",
   "gameId": "spray-paint-simulator-322702",
   "displayName": "Bigger scaffolding, better cherry picker",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-06T17:08:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Latest fixes & improvements;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Big scaffolding is one level higher, making the cherry picker optional",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved cherry picker physics, better driving stability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved Nozzles, less likely to get stuck on the last few %",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "When focussed, spray tool range increases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Small steps now work on scaffolding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Paint tin capacity increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Paint usage rate reduced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevented spray tool instantly spraying when it appears",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
