  {
   "id": "spray-paint-simulator-322702@post-2025-06-08",
   "gameId": "spray-paint-simulator-322702",
   "displayName": "Improvements to the Cherry Picker and Yopaint 3000",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-08T16:47:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Cherry picker overhead camera",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cherry picker tutorial message",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Yopaint 3000 increased range",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Yopiant 3000 tutorial message",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new overhead camera helps manoeuvring the cherry picker into position. Increased range of the Yopaint 3000 helps spray areas without extensions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "These changes are aimed at improving the bridge level but should also help with the robot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some additional tutorial messages have been added to help players select the right equipment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
