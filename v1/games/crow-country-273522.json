  {
   "id": "crow-country-273522@major-2023-11-02",
   "gameId": "crow-country-273522",
   "displayName": "Demo update notes + thanks for all the feedback so far!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-02T23:06:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First of all, thank you all so much for the amazing response to our announcement and the demo! It's gone even better than we'd hoped, and we've had so many lovely comments and thoughtful pieces of feedback. This last week has been very encouraging for our tiny team!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've updated the demo build with some bug fixes and a few small changes to make things better, the details are all below. There are a few other known issues we'll address soon too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adam & Tom",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Limited frame rate to 60fps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed enemies and items respawning after loading a saved game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with Mara switching between walk and run animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed gap in the wall in Fairytale Town",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed game switching between windowed and fullscreen without user input",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bear traps now hurt enemies when they're triggered by the handgun",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made pocket light and laser sight slightly more noticeable on the ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made fairy pond curtain slightly more noticeable, and mentioned it in the staff memo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
