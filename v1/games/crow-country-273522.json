  {
   "id": "crow-country-273522@post-2024-05-14",
   "gameId": "crow-country-273522",
   "displayName": "Patch notes 14th May",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-05-14T09:56:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! Adam and I have tackled a bunch of reported issues, mostly small but some that were preventing progress for a small set of players. Changes detailed below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed grenade spawn issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed final boss animation glitch after rapid damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed final boss sequence player getting trapped in fence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed mini-boss alternative defeat not counting for the achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some environment colliders to prevent trapping the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some UK English spellings into US English, so as not to break the V I B E",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed German gift shop puzzle translation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
