  {
   "id": "rally-arcade-classics-319408@major-2025-09-08",
   "gameId": "rally-arcade-classics-319408",
   "displayName": "UPDATE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-08T19:35:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Manual Gear will be available, and leaderboards will reflect if the player got the best time on manual/automatic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A speedometer will be added to the UI, replacing the old bar. Manual drivers will have a bigger UI graphic to check speed and revs to decide, and automatic will have an easier to check element while driving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Addition to a friends list in-game, so you can have up to 25 drivers you want to keep an eye on 👀 .",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Leaderboards will be revamped. Besides reflecting the type of gear the driver used, you will be able to filter through different settings: Your global position, top 10 and friends.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
