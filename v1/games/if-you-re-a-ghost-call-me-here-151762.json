  {
   "id": "if-you-re-a-ghost-call-me-here-151762@major-2022-05-20",
   "gameId": "if-you-re-a-ghost-call-me-here-151762",
   "displayName": "Update in the works!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-05-20T13:39:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The director is fully back in business. We are currently producing an update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update will include a large number of illustrations, so we are working on a lot of illustrations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I'm not sure if we will be able to finish it in time for May...it may be June, but the illustrations will be greatly increased!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Indiegara has asked us to do a bundle sale before the big update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also had a sale on steam. Thanks to all of you who bought our stuff!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
