   "id": "if-you-re-a-ghost-call-me-here-151762@post-2023-04-22",
   "gameId": "if-you-re-a-ghost-call-me-here-151762",
   "displayName": "Optional features have been implemented!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-04-22T14:16:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Many requests have been received.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Switching from full screen to window",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BGM and volume SE adjustment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "are now available from the options screen!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Language selection has been moved to the options screen. We hope that the new features have made your playing experience more comfortable!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And please send us your suggestions for improvements to this screen. We are aiming to make this game a game that more people can play for a long time!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
