  {
   "id": "if-you-re-a-ghost-call-me-here-151762@post-2023-02-12",
   "gameId": "if-you-re-a-ghost-call-me-here-151762",
   "displayName": "Faster chapter-by-chapter loading!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-02-12T01:02:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Many requests came from English-speaking players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have improved the chapter transitions and character display!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In particular, loading between chapters is now much faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any feedback on how we can improve the game, please feel free to contact us anytime. We will try to make it a better game experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
