  {
   "id": "if-you-re-a-ghost-call-me-here-151762@major-2022-07-27",
   "gameId": "if-you-re-a-ghost-call-me-here-151762",
   "displayName": "Notice of Update Delay",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-07-27T11:54:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "All updates were scheduled to be finished at the end of August, but",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1f y0u're a gh0st ca11 me here! Due to the health problems of the core team members, we are postponing the end of the updates to the end of October.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Due to the above, the Nintendo switch version is also expected to be delayed to November.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our team members are under threat of coronavirus. Please take care of yourselves, everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
