       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update scenario is currently progressing well. The Switch version will be released by the end of this year! The content of the STEAM version is the same.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
