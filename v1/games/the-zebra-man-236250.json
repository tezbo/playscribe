  {
   "id": "the-zebra-man-236250@post-2025-02-07",
   "gameId": "the-zebra-man-236250",
   "displayName": "The Zebra-Man! is now better than ever!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-02-07T09:59:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hope you are having a fantastic week! Because it's about to get better. We've brought you an update for The Zebra-Man game! It is version 2.5.3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this new version we fixed minor issues, such as the lighting of the 3D levels, removed the constant pop-up every time you eliminated an enemy and solved the problem of undefined NPC pushing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Below you have the Patch Note of version 2.5.3",
     "items": [
      {
       "text": "Constant Stat Update (NPCs killed) now only shows when Achievement is Unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added linear damp to npcs so they are not pushed indefinitely.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Remade the lighting batch of 3D levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
