  {
   "id": "in-nightmare-115862@post-2022-12-07",
   "gameId": "in-nightmare-115862",
   "displayName": "Version updates: Brightness settings are now more reasonable!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-12-07T06:58:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1. The brightness setting has been adjusted, now the brightness can be adjusted higher.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. At present when players firstly enter the game, the game language could be automatically adjusted according to the system language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Some art performance effects have been optimized.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Some sound effects have been optimized.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "6. Fixed the bug that the game would automatically minimize when switching windows in window mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "7. Fixed the bug where items in some scenes could not properly block the vision of monsters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "8. Fixed the bug that once the event is triggered in some scenes, the monster does not correctly chase the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
