  {
   "id": "blueberry-130534@major-2026-10-01",
   "gameId": "blueberry-130534",
   "displayName": "Big Update: Three New Languages!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-01T10:42:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Being able to play something in your native language makes such a difference for feeling the emotional impact of dialogs and narration. This is why we want to localize Blueberry into as many languages as we can and are so proud to launch the new version for you today - now including a total of five languages, including English, German, Spanish, Russian and Catalan.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Especially Catalan felt very special to us since it is only spoken by around 4 million people as a native language and is classified as potentially Vulnerable by the UNESCO Atlas of the World's Languages in Danger.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you enjoy the new version and that we can reach new players to break their hearts and make them cry 💔😭🫶",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
