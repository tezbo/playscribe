  {
   "id": "blueberry-130534@1.3",
   "gameId": "blueberry-130534",
   "displayName": "Update 1.3",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-07-26T15:00:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed bugs where in some areas it was possible to put memory links in the wrong puzzle panel. This could cause you to get stuck, because you'd end up in a level without a puzzle piece/memory link.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor bug fixes where doors were re-triggered and some moving platforms spawned at the wrong time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
