  {
   "id": "verdun-8036@post-2022-05-09",
   "gameId": "verdun-8036",
   "displayName": "Fix for save data issues",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-05-09T08:35:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would like to let you know that we have a patch addressing the most recent issues with loss of save game data. In case you've lost some of your data since the update in March where we made changes to the save system, please update and let us know if your data is restored.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please inform us in our Discord #techsupport channel if this update has fixed the issue, and of course, if you run into any problems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
