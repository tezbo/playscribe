   "gameId": "magic-twins-132244",
   "displayName": "Hotfix 1.2.0.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-06-11T10:45:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A strange bug in the Credits that affected loading data has been destroyed!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player 2 won't get repeated visual aids when using the same controller as Player 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A small typo in English in the Options Menu has been corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We casted several chromagic spells.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
