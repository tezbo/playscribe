  {
   "id": "lovechoice-109733@major-2019-09-25",
   "gameId": "lovechoice-109733",
   "displayName": "[Update] Fully support Spanish",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-09-25T08:09:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The game now fully supported Spanish for now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to Franco Daián Guzmán (a.k.a. Franco64) for the Spanish translation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "____________________________________________________________",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And I am sorry but have to announce that the Italian translator won't be able to translate the rest of the game for personal reasons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I can find someone in my country to help me with this translation but they won't be native speakers, so the quality might not be good enough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you are a native Italian speaker who is willing to help us with translation as a volunteer. (I don't have a budget for hiding translator...I'm sorry :( )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please send an e-mail to AkabaStudio@foxmail.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
