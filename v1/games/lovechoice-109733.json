  {
   "id": "lovechoice-109733@post-2025-10-04",
   "gameId": "lovechoice-109733",
   "displayName": "Bug fixes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-04T20:48:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have received a notification from Unity, the game engine used in this game. There is a security vulnerability in the engine that may affect players' personal information and system security. All games using Unity are required to update their Unity version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So, I have updated it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since this update is relatively urgent, I have only conducted simple tests on the updated game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues while playing the new version, please leave a message to inform me.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Relevant Announcement from Steam",
     "items": [
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/news/group/4145017/view/524229329545071274\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
