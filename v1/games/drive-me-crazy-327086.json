  {
   "id": "drive-me-crazy-327086@1.1",
   "gameId": "drive-me-crazy-327086",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-16T03:57:16.000Z",
   "notes": [
    {
     "title": "Dear Players,",
     "items": [
      {
       "text": "We have addressed the various bugs that emerged after the game's launch with the following updates. You can visit STEAM to automatically install the new version!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the updates included in V1.1",
     "items": [
      {
       "text": "1、Fixed the issue where subtitles were not displaying correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2、Resolved the issue of some players' save files being lost.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3、Repaired the failure of the online connectivity feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4、Fixed the occasional black screen and crash issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5、Addressed the issue where achievements were not being recorded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "6、Corrected the error in the affection points increase for Jingrui Cao's storyline.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "7、Repaired the issue where videos in the Mikami_Kana Photo Gallery could not be unlocked; they can now be unlocked again after completing the final storyline.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "8、Fixed the display anomaly for the female protagonist's age.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any issues, please provide feedback on the STEAM community and our DISCORD:Drive me crazy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
