      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44025396/ea89942b862b2a1a95e5741c9437eb5beb2410e0.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
