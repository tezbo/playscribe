  {
   "id": "cassette-boy-248898@1.1.0",
   "gameId": "cassette-boy-248898",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-19T14:47:51.000Z",
   "notes": [
    {
     "title": "This patch contains the following changes",
     "items": [
      {
       "text": "* Added map item at Tessa's Shop (20G). Once purchased, you can open the map anytime.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Added minimap. You can toggle it on/off in the settings. NPC locations are shown, with important NPCs highlighted in white.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Added brightness setting for the game screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Added Ancient Coin count and completed shrine count to the inventory, viewable after clearing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed an issue where videos would not play on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "* Added story and progression messages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⠀I'll continue to make improvements to ensure a smoother and more comfortable gameplay experience. Thank you for your continued support, and we hope you continue to enjoy CASSETTE BOY.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44025396/bc87353b5182a8aede38a8ce2c0773d6ac31c845.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44025396/417016b9baadc9ef33edf9a46923ffe1b92ed60b.png\"]",
       "ps5ProOnly": false,
