  {
   "id": "cassette-boy-248898@1.2.0",
   "gameId": "cassette-boy-248898",
   "displayName": "Update 1.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-23T06:14:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The following additions and fixes have been made in this update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Memo feature added — You can now use memos to keep track of important things. No more forgetting what you were doing when you pick the game back up!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the Schrödinger System was not functioning correctly during the rat boss fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where progression could become blocked in post-game play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various map adjustments and minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue working to improve your experience. Thanks for playing CASSETTE BOY!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44025396/75af33c604d211b3e2f4e1d35f4d5459a73ef882.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
