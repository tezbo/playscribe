  {
   "id": "horse-club-ride-west-412345@1.0.1",
   "gameId": "horse-club-ride-west-412345",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-15T10:02:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[p align=\"start\"]Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]Over the past week, we’ve watched numerous playthroughs and gathered valuable feedback from your reports in the discussions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]This update includes several bug fixes and a few improvements for you:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue where two horses could appear at the same time during customization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Dan Quijoe would not appear in his treasure hunt side quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "D-pad controls are now also hidden when “Show Controls” is disabled in the options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue during horse brushing where the camera could spin around the horse without any keys being pressed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue during horse brushing where the mouse cursor could get stuck inside the horse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added missing voice lines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed typos in the localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the horse to start sprinting when opening the Steam overlay.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Changes and Improvements",
     "items": [
      {
       "text": "The confirm button on the initial customization screen now requires players to hold it down to prevent accidental confirmation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the M key as a shortcut to open the map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Photos can now be taken in screenshot mode while moving on foot or on horseback. Time is paused when taking a photo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The travel popup for returning to Lakeside now displays the message “You can come back anytime.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[p align=\"start\"]Thank you for playing! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
