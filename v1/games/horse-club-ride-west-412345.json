  {
   "id": "horse-club-ride-west-412345@1.0.2",
   "gameId": "horse-club-ride-west-412345",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-23T15:48:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we’ve watched more playthroughs and also gathered more input from Steam and the other platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This second update includes several more bug fixes",
     "items": [
      {
       "text": "Fixed an issue where some race tracks in the Desert were not unlocked anymore after completing the story (fix works for existing save games as well).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that made player controls unresponsive when trying to open the pause menu while mounting / dismounting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several colliders at the farmhouse, the stable, the hen hut and the shed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the bow stretching animation triggered twice during archery.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that Npc horses sometimes twitched when riding into them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where you could still select a horse while leaving the stable that could make a popup get stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the player's direction was displayed incorrectly on the pause menu map when going uphill or downhill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the mouse cursor was not shown in the guitar minigame selection.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Increased the rocks render distance so they appear more smoothly instead of suddenly popping into view.: Thank you for continued positive and critical feedback, bug reports and playing our game! 🙂",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
