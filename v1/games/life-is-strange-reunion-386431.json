   "announcedAt": "2026-04-15T16:00:59.000Z",
   "notes": [
    {
     "title": "General",
     "items": [
      {
       "text": "-Fixed keyboard layout detection on launch of the game. Defaults for keybindings will now better suit non-qwerty layouts.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Fixed various graphical issues during rewind sequences. -Fixed various vibration issues in several scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed ambient noise in several locations. -Some NPCs finally got their drinks from Amanda in the Snapping Turtle (she's busy, alright?!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed some minor bugs with a hidden rewindable sequence. -Improved stability overall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Updated audio code to be more robust. -Fixed a crash when replaying a scene several times in the same session.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed an occasional crash with some NVIDIA GPUs (series 30 and 40). -Fixed many small bugs.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "PC",
     "items": [
      {
       "text": "-Added a warning when we detect some Windows security settings prevent game saves to be written properly",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Fixed an issue where using Alt+Tab in a specific scenario may cause the title to freeze.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Improved Steam Deck default settings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Fixed shadow flickering for local hair shadows with lower quality settings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Made it clearer in the settings that the game does support upscaling (Unreal Engine’s TSR).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
