  {
   "id": "thief-simulator-2-157445@1.2",
   "gameId": "thief-simulator-2-157445",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-23T14:15:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here it is, 1.2 ːsteamhappyː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New heist: Futuristic museum, filled with expensive sculptures and paintings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New blackbay list related to the new heist",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed 'leg mode' bug when exiting the car",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Limited missing item alert to heavy items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fall damage tweaks; agility skills increase the height before getting hurt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed drone keybinds",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issue with selling multiple heavy items of the same type",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added ThiefRating app on the phone. Every thief will now have his ranking (1-5 stars)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Possibly fixed cat going through the ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New extra skillset and extra skill points, which can be earned by gathering XP and selling items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Special shoes were made more expensive, BUT your footsteps can't be heard at all even when running",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5 new HellNeighbour missions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
