  {
   "id": "thief-simulator-2-157445@1.22",
   "gameId": "thief-simulator-2-157445",
   "displayName": "Update 1.22",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-12T14:36:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "just so you know I have not died (yet). I've been just really busy with my spiritual successor to TS2, working on the co-op mode and stuff - hence the delay. Sorry for that.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I'm back to doing incremental updates until we reach 1.3 - so starting with 1.22, here's the changelog:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Blackbay list with 4 amulets - they can be found in houses in Hillville",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed duplication glitch in the shed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing stone fence collision",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
