 "releases": [
  {
   "id": "tales-of-xillia-remastered-361791@1.0.3",
   "gameId": "tales-of-xillia-remastered-361791",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-05T05:55:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "To address the following issues, we have begun distributing an update file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "▼Update Contents",
     "items": [
      {
       "text": "• Fixed an issue where the diagonal inputs were too sensitive when inputting “quick-step” in battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue where adjusting the volume in “Menu -> System -> Options-> Sound” didn’t change the volume output.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted BGM volume for some songs in the “Battle BGM Pack.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue where a character’s hair would disappear when changing to normal attire from a specific equipment set.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue where using the “mine” action in the Felgana Mines prevents players from progressing further when a certain button is mapped to the “talk” action.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue where the total play time counter would stop increasing after a certain value.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue where “Holy Bottle” and “Dark Bottle” effects would not end after their timer ran out when the frame rate cap was set to 120.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed several graphical issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed several typographical errors in the subtitles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed various other issues that would prevent game progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Update Version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ver.1.0.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※An internet connection is required to download this update file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your continued support for Tales of Xilia Remastered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
