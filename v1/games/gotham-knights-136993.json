  {
   "id": "gotham-knights-136993@post-2023-02-15",
   "gameId": "gotham-knights-136993",
   "displayName": "PC Patch Notes 2/14/2023",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-02-15T22:45:31.000Z",
   "notes": [
    {
     "title": "Stability",
     "items": [
      {
       "text": "Several fixes for crashes in the Open World",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for the crash related to using Fast Travel Points",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for the crash that could happen when returning to the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for the crash that could happen when using the Text-to-Speech functionality in some options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rendering performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Smoothed out delta time fluctuations with and without V-SYNC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Streaming time improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimized actor spawn time and performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various GPU and CPU hitches reduction",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Graphics",
     "items": [
      {
       "text": "Fix to HDR being improperly set on the not-primary monitor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaked scalability settings for graphics settings auto-detection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for some materials being improperly displayed when the anti-aliasing is disabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The GPU driver check has been added.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Several minor fixes to the NVIDIA Ansel mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for the post-processing options being improperly reset after exiting from the Photo Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several fixes for the shadows being improperly displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for some graphical artifacts that could be visible during the Clayface boss battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI/Input",
     "items": [
      {
       "text": "Fix for missing SFX in various menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several fixes for the input in the Social Wheel menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for the camera movement in the ‘Map’ submenu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for vanishing header prompts when crafting items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for overlapping buttons in tutorials.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The ‘Add as Friend’ input has been changed in the Social menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The ‘Refresh list’ binding has been changed in the Social menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The ‘Revert’ button in the Colorway section of the Styles tab should now have mouse functionality.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A separate binding for the Group Social menu tab has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for the issue when tutorial popup that did not required input was blocking KBM input in Crime Map",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Several minor fixes related to the Text-to-Speech behavior in menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
