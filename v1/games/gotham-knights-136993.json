      {
       "text": "Various UI issue fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues caused by graphical settings not being applied properly.",
       "ps5ProOnly": false,
