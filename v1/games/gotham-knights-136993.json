  {
   "id": "gotham-knights-136993@post-2022-11-29",
   "gameId": "gotham-knights-136993",
   "displayName": "Patch Notes - 11/29/22",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-29T17:47:10.000Z",
   "notes": [
    {
     "title": "Heroic Assault",
     "items": [
      {
       "text": "Journey deep into Gotham's underworld (literally) and discover the mystery awaiting at the bottom!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Four player co-op",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "30 floors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New gear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New colourways",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Launched from player’s location in North Gotham or through the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Main menu access is available after initially using the North Gotham entrance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Showdowns",
     "items": [
      {
       "text": "The villains are back for round 2! Square off against supercharged versions of the game’s main DC Super-Villains, including Mr. Freeze, Harley Quinn, Clayface and Talia al Ghul.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Solo or 2 player COOP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More difficult versions of the boss fights",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New gear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New batcycle transmog and colourways",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Launched from the villain's trophies in Belfry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "HP requirements for Stealth takedowns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Boss elemental gears requirements and resistances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Late game content",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "AI Spawning closer to the player’s level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Enemy health has been lowered on hard difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Weapon and gear stats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Accessibility",
     "items": [
      {
       "text": "Sprint Activation option has been implemented",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crouch Activation option has been implemented",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Abilities",
     "items": [
      {
       "text": "Fix for missing Ability points not granted to the player sometimes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Robin’s Vantage Mine blast radius reduced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Robin's Hanging Vantage Takedown will slightly alert enemies instead of revealing the player’s location",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Robin’s Warping Shot ability doesn’t stop armored attacks anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for AI reaction to Batgirl’s Hacking Overload on non-grounded turrets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Robin’s Slideways Takedown ability disabled on Court of Owl’s Talons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Robin’s Bo Swing now applies guard break",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes for Piercing ability icons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed cooldown HUD visual feedback for instant abilities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Throwing enemies will do increased damage. Additionally, it will cause the enemy to be stunned",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Coop attack damage has been increased and will award 1 bar of momentum",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
