       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Further optimization to improve the stability of the framerate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Raytracing has been optimized",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Frame pacing has been improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
