  {
   "id": "gotham-knights-136993@post-2023-04-27",
   "gameId": "gotham-knights-136993",
   "displayName": "PC Patch Notes - 4/27/2023",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-04-27T17:38:07.000Z",
   "notes": [
    {
     "title": "New Content/Features",
     "items": [
      {
       "text": "• The Kelvin Incident is now available! This is a new 15 floor raid available in new game plus or after unlocking the raid area and defeating all the side villain missions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Mythic gear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• This is a new tier of stronger gear which only drops in the raid.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• New material will drop from raid as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• A new suit transmog can be unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• 4 new batcycle transmogs can be unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• New stronger enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Control remapping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Gameplay Controls can be remapped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Supports mouse, keyboard, and gamepad",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Buttons that need to be held down can be changed to a toggle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Text-to-Speech",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• The game supports your device's built-in screen reader for all text and certain menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Improved screen reader support in areas where it existed previously",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Text-to-Speech is available in English only",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "• Implementing support for the Steam Deck keyboard and dynamic cloud saves",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Fixes to draw distance and shadow casting when using higher FOV values",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Texture streaming fix for objects in the Heroic Assault levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• The XeSS has been upgraded to version 1.1",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Red Hood Mystical Leap should now behave properly while playing at higher FPS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixes for some rare refresh rate problems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fix for kicking user in STEAM-EPIC crossplay matches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Stability & Optimization",
     "items": [
      {
       "text": "• Crash fix for a rare scenario when the PS5 controller is set as a default audio device",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "• Fix for crash while using keyboard input for camera roll in Photo Mode",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Several smaller optimizations for the performance of both GPU & CPU",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI",
     "items": [
      {
       "text": "• Fix to the Text Chat behavior when using PageUp/PageDown keys",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Several fixes to the Text To Speech feature in PC-specific menus",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Fix to Activity notifications conflicts with other on-screen actions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fix to Photo Mode being improperly displayed while starting a cinematic in co-op",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Analog sticks icons for Nintendo Switch and Direct Input controllers have been updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
