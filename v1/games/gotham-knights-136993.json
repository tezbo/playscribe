  {
   "id": "gotham-knights-136993@post-2022-11-07",
   "gameId": "gotham-knights-136993",
   "displayName": "PC Patch Notes | 11/07/2022",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-07T18:08:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This patch contains more fixes for stability and issues that have been found since launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "When dropping down from a ledge/beam, you will no longer jump forward",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The exe name has been changed to \"GothamKnights.exe\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FSR 2 has been updated to the newest version (2.1.2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Nvidia Freestyle can now be properly used",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The backup save system has been redesigned",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save distinction functionality has been added, claimed DLCs are now stored in the save data",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for “flying cars” in co-op",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "GPU optimization for Low and Medium quality presets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several UI and Input fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Photo mode navigation issues fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Stability",
     "items": [
      {
       "text": "The game no longer crashes when joining a friend on Steam",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The game no longer crashes when the player dismantles the currently equipped gear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Additional crash fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Server side update to help address co-op connection stability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
