   "id": "resident-evil-7-biohazard-19562@major-2026-05-11",
   "gameId": "resident-evil-7-biohazard-19562",
   "displayName": "Notice of Update Distribution",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-11T02:59:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Notice of Update Distribution",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The following updates have been made to Resident Evil 7 biohazard:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Verified compatibility with Windows 11",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where, when the Steam language was set to Latin American Spanish, the game would launch with initial in-game language set to English.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where only the display language would not return to its default setting when selecting “Default” in the settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that occurred on the options screen when HDR was enabled in the graphics options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could prevent game progression in certain areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where a cutscene would not initiate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
