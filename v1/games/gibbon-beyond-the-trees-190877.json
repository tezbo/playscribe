  },
  {
   "id": "gibbon-beyond-the-trees-190877@1.5.4",
   "gameId": "gibbon-beyond-the-trees-190877",
   "displayName": "Update 1.5.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-08-21T15:03:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have been working on new features and fixes since we launched our ecological Adventure Gibbon: Beyond the Trees a few weeks ago.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some new content has been added and performance- and general issues have been fixed. See the full details below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update log",
     "items": [
      {
       "text": "– Made the crane needed for the Canabalt achievement appear more often and easier to reach",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– Lot’s of performance improvements during gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– Improved performance drops from world generation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– Added new logging levels to Liberation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– Added new backgrounds to Story mode to tell more about the destruction of our gibbons’ habitat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– Improved clouds and lighting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– Fixed background glitches in Liberation mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– Use mouse gestures to backflip or drop-down",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We hope you like these updates! There is also a new mode we will soon introduce. You can try it already in BETA. Just have a look at the other news beat we will be sharing today.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep swinging 🐒",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Broken Rules",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
