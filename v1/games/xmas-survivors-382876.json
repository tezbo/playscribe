   "id": "xmas-survivors-382876@major-2026-01-14",
   "gameId": "xmas-survivors-382876",
   "displayName": "Leaderboards Update is live!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-14T12:47:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[p align=\"start\"]Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]Thank you for supporting and playing our game. We are very happy that you’re enjoying it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]In this patch, we fixed some minor bugs and adjusted some prices in the shop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]Thanks to you, we discovered a major bug on PS5. It was related to activities, so it only affected this platform. The patch fixing this issue should go live later this week.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "[p align=\"start\"]The biggest addition in this patch is the Leaderboards feature. We’re still testing it, so it will be available on Steam first. Once we’re sure it’s working as intended, we will add it to all platforms where the game is available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]We appreciate your feedback, as it helps us keep improving the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
