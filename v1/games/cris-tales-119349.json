 "releases": [
  {
   "id": "cris-tales-119349@patch-2021-12-16",
   "gameId": "cris-tales-119349",
   "displayName": "A New Patch is Now Available - Including a New Character!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-12-16T17:56:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today we unleash a flurry of free content for Cris Tales, including a brand-new character, dungeon, cutscene and much more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Beyond these additions, this free update adds new story content such as a new ending and all-new cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Character – Adri – Seventh playable character who will join your party.",
     "items": [
      {
       "text": "Adri is a robot mechanic who the player first encounters in St. Clarity. She plays a significant part in the late game story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In combat, Adri acts as a summoner, building simple machines such as mines and turrets that can be enhanced through Crisbell’s time powers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Dungeon",
     "items": [
      {
       "text": "Alongside Adri comes a new mechanical themed dungeon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Brand new enemy encounters and unique puzzle solving mechanics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Return of the new and improved Coliseum",
     "items": [
      {
       "text": "Battle waves of increasingly challenging enemies for new loot, chests, currency, and rewards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Accessed by speaking to the traveling merchant.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New enemies and a completely original boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "General updates",
     "items": [
      {
       "text": "Completion of the new content introduces a completely new cutscene and a new ending for the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New content is accessible in the late game, and players who have already completed the game can just load their most recent save to experience the new content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new playable character.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new side quest and dungeon, with new enemies and a new boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new Colosseum. Speak to the Wandering Merchant to test your mettle!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an infinite white loading screen that could rarely occur at the end of battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a gameplay blocker that could rarely occur when a character's syncro is interrupted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a gameplay blocker that could rarely occur during the Volcano Sisters boss fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a gameplay blocker that could rarely happen during certain other boss fights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the Empress' Gaol ability which could impact party composition after the battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with minor graphical flickering in some backgrounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various text and graphical fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
