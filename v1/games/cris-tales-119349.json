  {
   "id": "cris-tales-119349@patch-2021-08-30",
   "gameId": "cris-tales-119349",
   "displayName": "A New Patch is Now Available; Numerous Bug Fixes and Graphical Settings",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-30T15:56:28.000Z",
   "notes": [
    {
     "title": "Fixes Include",
     "items": [
      {
       "text": "Fixed numerous text bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added first set of graphical setting options including aspect ratio and vSync options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed display issues in ultra-widescreen mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed numerous user reported soft-locks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an achievement not being unlockable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed enemies occasionally not appearing during a battle in the salt mines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the \"burn\" icon becoming distorted when using Impact Strikes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted pricing for Tents",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted pricing for the Distortion Ring",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crisbell now learns Heal at level 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Empress will now use perfect heal for only two turns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
