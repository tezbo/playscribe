  {
   "id": "shapeneon-chaos-157119@1.01",
   "gameId": "shapeneon-chaos-157119",
   "displayName": "Update 1.01",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-02-17T02:51:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.01 - Minor update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After feedback from some players, we made the following updates:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Modified crosshair image for better viewing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added option to disable the background and have a better viewing (bye bye matrix effect :( )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Halved the effects of lights. If you already have the game installed it is recommended to go to the options menu and adjust the lights in a way that is pleasing to your eyes.: Thanks to everyone who bought our game. Continue send your feedback to further improve ShapeNeon Chaos!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
