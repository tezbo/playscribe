  {
   "id": "creepy-shift-uncle-joe-s-motel-357060@5.0",
   "gameId": "creepy-shift-uncle-joe-s-motel-357060",
   "displayName": "Update 5.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-13T13:20:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Creeps! 🚨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you so much for your activity and for reporting all the issues you’ve run into while playing. We really appreciate it. We’ve put a lot of work into improving overall performance, polishing the experience, and making sure the game more clearly communicates that it contains sensitive content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re also happy to say that the game is now playable on Steam Deck! It’s not officially certified just yet, but that should be just a matter of days. 🛎️",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Full Changelog",
     "items": [
      {
       "text": "Added a content warning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved overall performance with a strong focus on Steam Deck optimization",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Reduced frequent stuttering and periodic frame drops",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed multiple crashes related to phone camera usage, scene transitions, and memory usage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the timing window for rhythm/drum interactions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed problematic input combinations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Prevented unintended backtracking in key moments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed player orientation issues after certain events and teleports",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed oversized, clipped, or improperly scaled UI elements (loading text, subtitles, skip prompts, phone chat messages)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some menu navigation issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple video playback issues caused by missing or incorrect codecs in cutscenes and TV screens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed lighting and post-processing issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved outline visual quality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed various interaction issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved level stability and reduced glitches across multiple rooms and vision sequences",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some localization issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Once again we’re incredibly grateful for your support and involvement. Thanks to you, the game has taken the shape we’ve been aiming for since the very beginning. We also want to thank everyone who reached out to us about Sue’s story it truly means a lot to know it resonated with you. 🐈‍⬛",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Creepy Hugs!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Night Shift Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
