  {
   "id": "creepy-shift-uncle-joe-s-motel-357060@6.0",
   "gameId": "creepy-shift-uncle-joe-s-motel-357060",
   "displayName": "Patch 6.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-30T18:44:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ave Creeps! 😈",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re back with another small update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We pay attention to every piece of feedback, even the smallest details. This time, many of you, especially streamers, reported issues with music and audio during gameplay, including copyright-related notifications and interruptions caused by certain background tracks being flagged during streams. We also fixed phone message navigation and made a few extra improvements to keep the game running smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for all your reports. We’re here, listening, and ready with more patches to improve the quality and comfort of the game 🔥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "Fixed phone message navigation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Replaced problematic music and sounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional optimization improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Night Shift Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
