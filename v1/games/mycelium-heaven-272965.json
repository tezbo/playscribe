  {
   "id": "mycelium-heaven-272965@1.3.5",
   "gameId": "mycelium-heaven-272965",
   "displayName": "Update 1.3.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-14T09:37:56.000Z",
   "notes": [
    {
     "title": "Hello!🤠",
     "items": [
      {
       "text": "The demo has been updated! I have been taking feedback from you guys and it has been very useful. I will be adjusting what the game already has before moving on with more levels. For now, this are the current changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed rewind bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The bug caused tiles with a body to rewind into a zombie when it had steped on them. The rewind system has been improved to avoid that type of bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sound control",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added buttons to control music and sfx",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Transitions and level selector",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added seasonal transitions to access all level selectors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If you want to leave any feedback or suggestion please feel free to do so! You can do it at @3DGoblinDev on Twitter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to all of you guys who submitted feedback or reported bugs I really appreceate it! 🤗",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you around!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
