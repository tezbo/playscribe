  {
   "id": "mycelium-heaven-272965@1.5.0",
   "gameId": "mycelium-heaven-272965",
   "displayName": "Update 1.5.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-01T11:04:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Howdy! 🤠",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I know I said I wasn't going to update the demo anymore, but I added some juicy things and I couldn't resist. And with the Next Fest coming it was the perfect oportunity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is what's new",
     "items": [
      {
       "text": "Cool squishy animations for the tiles and zombies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "An exit button!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Camera movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Some levels were reorganised and tweaked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bug fixing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sounds not playing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Zombies not rewinding properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Random stuff I created while adding new things for the spring mechanics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "I hope this things make the experience better and that you like it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "As always, if you want to follow the development closer you can come by my Twitter or TikTok and even say hi 🙆.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "See you next time!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
