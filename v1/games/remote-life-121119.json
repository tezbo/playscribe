   "notes": [
    {
     "title": "Remote Life updates",
     "items": [
      {
       "text": "-Achivements (now you will unlock automaticly every lower difficulty level achivement)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Achivements of Mission 6, 7 and 17 should be fixed now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Ship 3 locking problem should be fixed now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-the blocked cursor in the main menu should be fixed now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Mission 7 space crawler is not transparent anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-game launch should be faster now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-(minor stuff should be fixed now)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "_________________________________________",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "REMOTE LIFE 2 will surly have also platform elements as you already know. Any Idea could be useful :)",
