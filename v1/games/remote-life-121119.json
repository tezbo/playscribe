     "items": [
      {
       "text": "_________________________________________",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "HEDRONS is ready for wishlist. A scifi precision platformer game with 100+ levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"\"\"\"\"\"\"\"\"\"IMPORTANT \"\"\"\"\"\"\"\"\"\"\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PLEASE support the developer adding a positive comment in the store page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Only this can ensure a certain success of Remote Life, that will help in the future developement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "...I need more support guys... come on...You are John Leone... WE COUNT ON YOU !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
