  {
   "id": "hidden-cats-in-london-211681@major-2024-12-18",
   "gameId": "hidden-cats-in-london-211681",
   "displayName": "Bug Fixing Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-18T18:52:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! We are happy to say we've fixed the following issues on the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unable to click on remaining people - https://steamcommunity.com/app/2099080/discussions/0/6741411926483306212/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game Won't complete - https://steamcommunity.com/app/2099080/discussions/0/7119694909421824841/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game crashing after showing the Nukearts Logo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are aware there are some other bugs present, we still have a few more fixes planned, we shall have them uploaded soon so you may enjoy the experience as it was intended, stay tunned!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
