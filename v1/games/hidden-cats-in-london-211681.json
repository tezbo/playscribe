  {
   "id": "hidden-cats-in-london-211681@post-2024-01-16",
   "gameId": "hidden-cats-in-london-211681",
   "displayName": "Recent Updates",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-01-16T16:51:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello friends, we have been working on all games from Hidden Cats Series to fix reported issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here are the last updates for London.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FIXED - Cat counter with wrong numbers in Advanced Mode;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Hint not working in Advanced Mode;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Unable to click on people in Advanced Mode;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Achievements problems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Camera keyboard (WASD) controls;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "FIXED - Meow SFX options not working properly;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Bug that causes a level to be inaccessible sometimes;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Bonus levels sometimes show cats' position when starting the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "NOTE",
     "items": [
      {
       "text": "Due to the technical nature of the game, sometimes updates can be quite big compared to the game size already installed, even when the update itself is a small thing. But, make note that this won't increase too much of your install files as it is already.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
