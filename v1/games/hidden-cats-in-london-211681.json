  {
   "id": "hidden-cats-in-london-211681@major-2026-09-11",
   "gameId": "hidden-cats-in-london-211681",
   "displayName": "General Bug Fixing Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-11T17:24:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to say that we've fixed the following issues in this latest update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Steam Cloud not working;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Congratulations Screen not triggering when completing advanced mode of the main level;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Cat on train not coloring at first click;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Sound Settings not muting despite being set for it;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Cat on Windowsill no longer spawning in a weird position;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope these fixes improve your overall experience of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let us now if everything works as intended for y'all now, happy Finding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
