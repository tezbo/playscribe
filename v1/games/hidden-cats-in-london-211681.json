  {
   "id": "hidden-cats-in-london-211681@major-2025-07-18",
   "gameId": "hidden-cats-in-london-211681",
   "displayName": "Game Fixes of mechanics and achievements Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-18T13:38:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! We are happy to say that we have fixed some issues that have been bugging players for a while now, these include:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Missing achievements of total amount of found cats;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Invisible cats on the main level;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Main level building segment not colored even with completed game;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Being unable to click on remaining people on the main level;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Game occupying 2 GB of space;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Not receiving No Hint on Normal mode achievement when completing main level without hint.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You may now return to enjoying the game as it was intended, happy finding!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
