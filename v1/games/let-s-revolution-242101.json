  {
   "id": "let-s-revolution-242101@1.2.23",
   "gameId": "let-s-revolution-242101",
   "displayName": "Patch 1.2.23",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-22T14:20:19.000Z",
   "notes": [
    {
     "title": "Performance Updates",
     "items": [
      {
       "text": "Improved level generation so that higher NG+ levels will generate with a less choppy framerate, particularly on lower-powered machines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed bug in which when Mitzi reveals a cluster of non-road tiles with the same number, you could inadvertently reveal the King or another enemy if they were hidden in the cluster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mitzi no longer always has 20 gold when you load a game (this was from Rich triggering incorrectly)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "\"Uses per level\" traits (ie Sneak, Magic Flute, Sixth Sense, etc) now save and load their uses remaining correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fully fixed bug in which the game flow would break if the King created too many bombs during the final boss fight (could only happen on high NG+ levels).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI/UX Changes",
     "items": [
      {
       "text": "D-Pad works to move the scroll bar on Achievements screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "English: Fixed copy issues with class descriptions (Hunter no longer refers to \"mana\" and all instances of \"enemies\" and \"energy\" are lowercase)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simplified and Traditional Chinese: Updated label of \"Permanent Hidden Enemy Markers\" in the Settings/Display menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay Updates",
     "items": [
      {
       "text": "Snoop is no longer a free action to avoid exploit potential with Hunter's Momentum",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
