  {
   "id": "let-s-revolution-242101@1.3.11",
   "gameId": "let-s-revolution-242101",
   "displayName": "Patch 1.3.11",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-16T20:44:30.000Z",
   "notes": [
    {
     "title": "New Languages",
     "items": [
      {
       "text": "Added support for Korean and Japanese to languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed postprocessing effects that were accidentally removed. This restores the red vignette effect when player health is low and also bloom effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug in which run timer could be seen on map generation screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed mouse hitboxes for Library cards for traits with only two upgrade levels being in the wrong position",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed bug in which Library energy costs could be wrong for School of Power or School of Knowledge abilities if you returned to the menu from an active run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple minor issues while playing using a controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug in which Follow Up could continue its effect between runs in rare cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
