  {
   "id": "let-s-revolution-242101@1.2.20",
   "gameId": "let-s-revolution-242101",
   "displayName": "Patch 1.2.20",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-21T13:39:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "First patch for the game, featuring minor fixes. No changes to gameplay/mechanics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed count left of Throwing Knives not saving or resetting between runs correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug with pressing back on controller while selecting resolution in the dropdown in Display settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed misspelling of MItzi's name for a few languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI/UX Changes",
     "items": [
      {
       "text": "Larger font for resolution list in the dropdown in Display settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved language selection on controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
