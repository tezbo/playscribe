  {
   "id": "let-s-revolution-242101@1.2.17",
   "gameId": "let-s-revolution-242101",
   "displayName": "Patch 1.2.17",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-11T19:05:33.000Z",
   "notes": [
    {
     "title": "Patch Notes v1.2.17",
     "items": [
      {
       "text": "This is hopefully (*fingers crossed*) our last patch before our launch on 7/19.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "UI and Controller Updates",
     "items": [
      {
       "text": "New designs for all controller input icons in the UI. Larger icons with higher contrast for more visibility. New design for \"hold button\" radial UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Switch Pro Controller input is now correct: A is used for confirm and B is used for back",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay Changes",
     "items": [
      {
       "text": "Nerfed Desperate Hour to giving 3|4|5 energy reduction instead of 3|5|7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Shrouded and Investments now always round up to nearest whole number to determine how much gold they give",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed bug in which moving sound settings sliders all the way left would not mute channels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug in which you could enter and exit pages of the ASM quickly on controller and break the tween animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug in which sometimes a passive in the class selection screen would display values from the incorrect level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug in which class name in player UI could be wrong after continuing from a save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed not being able to access unlocked skill tooltips when playing on controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed animation issues with menu transitions between main menu and class selection on controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug in which gem unlock track could not get reset to 0 and saved, allowing free unlocks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues in which the Let's! Revolution! demo save data could effect the main app's data during Steam Cloud synching.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed controller bug in which you could switch to selecting abilities while a turn was resolving, resulting in an invalid selection state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues in which Hunter's Breather may not trigger during boss battle, despite all enemies being hidden.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue in which a piece of the parallaxing background art in Phlox was rendering in the wrong order.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
