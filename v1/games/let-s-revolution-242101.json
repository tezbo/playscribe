  {
   "id": "let-s-revolution-242101@1.2.21",
   "gameId": "let-s-revolution-242101",
   "displayName": "Patch 1.2.21",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-27T18:15:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This patch features fixes for a few typos and achievements. We also fixed some issues where traits could be combined into exploits we felt broke the spirit of the game. Stop by our Discord to let us know what you think of the updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Painless achievement only unlocks on Normal difficulty or higher (matches description)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Make Haste achievement only unlocks on Normal difficulty or higher (matches description)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "English: Pacifist achievement description is more accurate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "English: Fixed typo in the description of Safe Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Gameplay Updates",
     "items": [
      {
       "text": "Flow State now has a 7 turn cooldown instead of 6 for at all upgrade levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Teleport at level 3 is no longer a Free Action, but instead costs 0 energy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Desperate Hour is removed from the Cymbidium trait pool, ie Shadow and Hunter can no longer get it. This is to prevent an exploit where you could easily get infinite free Backstabs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
