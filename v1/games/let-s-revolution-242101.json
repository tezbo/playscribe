  {
   "id": "let-s-revolution-242101@1.2.22",
   "gameId": "let-s-revolution-242101",
   "displayName": "Patch 1.2.22",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-08T16:14:25.000Z",
   "notes": [
    {
     "title": "Engine Update",
     "items": [
      {
       "text": "Upgraded Unity engine to a later release. This may help with some crash and performance issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Charge count saves and loads correctly. Previously was resetting to 0 each time you saved and loaded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug in which Parry would not work properly with stunned enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed soft lock on the final level if you had allowed the King to place enough mines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI/UX Changes",
     "items": [
      {
       "text": "Increased the size of fonts in many areas of the game to improve the experience on Steam Deck and playing on television.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Updated description of Pacifist achievement to be more accurate for all languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay Updates",
     "items": [
      {
       "text": "Settings>Display>Permanent Hidden Enemy Markers allows you to play without the skull icons expiring when you hide enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Settings>Display>Visible Run Timer allows you to play with a run timer in the bottom right corner. This is the same timer used by the Make Haste achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nerfed Flow State from 7 to 10 cooldown and from 4|5|6 slip time to 3|4|5 slip time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
