  {
   "id": "ratshaker-321428@post-2024-11-22",
   "gameId": "ratshaker-321428",
   "displayName": "RATSHAKER™ 22_11_24_04 - Major Optimisation & Fixes",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-22T15:17:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey RATSHAKERs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Lighting Adjustments",
     "items": [
      {
       "text": "Set light draw distances to prevent visual popping.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Disabled unnecessary ticking and collisions on non-interactive light meshes for improved performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed Steam Audio as it was unused and consuming CPU resources.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Rendering Optimizations:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted post-process shaders to render before the tonemapper for a significant performance boost.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed anti-aliasing method from TSR to TAA and reduced internal render percentage to 50%, maintaining visual fidelity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Disabled unused visual features such as depth of field, volumetric clouds, and reflections to improve performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Locked graphical settings to medium for consistent quality across devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Gameplay Enhancements",
     "items": [
      {
       "text": "Implemented missing gamepad inputs for rat interactions. Steam Deck and gamepads are now supported for gameplay, though UI prompts for controllers are pending future updates.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Fixes & Tweaks",
     "items": [
      {
       "text": "Fixed floating door in the field house.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected instructional text clipping by scaling text dynamically (font size may vary).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved memory leak in cursed objects; idle vibration temporarily disabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Replaced a broken sink on Floor 3 with a working one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing audio attenuation for flies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed sink and bath textures for proper fill appearance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed overlapping toilet placement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an odd wall alignment in the bathroom.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Omitted a checkpoint for the Floor 3 door to streamline progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI & Accessibility",
     "items": [
      {
       "text": "Adjusted popup instructions to support longer translations without clipping.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Confirmed translation files are up-to-date and functional.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Known Issues",
     "items": [
      {
       "text": "Gamepad UI prompts are not yet available but are actively being worked on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Idle vibrations for cursed objects will return in a future patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep shaking that RAT! 🐀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
