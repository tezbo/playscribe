  {
   "id": "ratshaker-321428@hotfix-2025-02-15",
   "gameId": "ratshaker-321428",
   "displayName": "RATSHAKER™ 15_02_25_01 - Achievements Hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-02-15T18:14:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey RATSHAKERs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "WE ARE SORRY.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We accidentally denied you the sweet, sweet dopamine hit of unlocking achievements. We have now corrected this injustice. However, those who should have been unlocked since the last patch, remain lost in the void, irretrievable even to us. The RAT has wept. The RAT has repented. The RAT cannot turn back time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you were robbed of your well-earned accolades, we regret to inform you that they are now merely whispers in the void. You must achieve them again. Consider it a second chance. A trial by RAT.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have also shed our skin. We have cast aside our development build and embraced the raw, unrelenting efficiency of the shipping build.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This means",
     "items": [
      {
       "text": "Smaller file sizes. Less clutter. Less waste. A more optimized RATshaking experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The command console is dead. No more peeking behind the curtain. No more forbidden texts.: You are no longer in the lab, you are now in the maze.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please restart steam to ensure you get this update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep shaking that RAT! 🐀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sunscorched Studios: No real rats were harmed in the development of RATSHAKER™.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
