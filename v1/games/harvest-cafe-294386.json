   "id": "harvest-cafe-294386@0.4.9.7",
   "gameId": "harvest-cafe-294386",
   "displayName": "Update 0.4.9.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-23T07:04:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Harvest Cafe farmers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to annoıunce our new character creation module.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Now we can customize our character as we wish and turn it into a new character.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Four new voice selection features have been added to our characterAdded sound to plant watering.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added widget that shows what happens when we hover over items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We now have the ability to destroy the structures we create if we want.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We now have a new feature that allows us to receive notifications when it is time to sleep without fainting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fix",
     "items": [
      {
       "text": "Customer animations improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game and character volume levels have been adjusted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Food selection widget at the restaurant has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Seed selection widget at the farming field has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
