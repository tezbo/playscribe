  {
   "id": "harvest-cafe-294386@patch-2024-05-27",
   "gameId": "harvest-cafe-294386",
   "displayName": "It's Time For The First Patch!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-27T17:16:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Farmers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have some new features and improvements. Here are some of them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "New food models have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "GamePad support has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New languages have been added (French, Italian, Spanish, Simplified Chinese, Portuguese, Bulgarian, Danish, Dutch, Finnish, Traditional Chinese, Japanese, Korean, Polish, Hungarian, Norwegian, Romanian, Russian, Ukrainian, Vietnamese, Greek, Czech, Swedish).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New sound effects have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44949607/ff388fd280a61416272485db4910fe108985150f.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "The process of adding agricultural land has been simplified.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Food service to customers has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The spawn algorithm has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The customer behavior system has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Farm structures have been made easier to use.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The trade balance has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In-game visual improvements have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjustments have been made to player controls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The issue with the growth cycle of plants has been improved. Plants no longer spoil if not harvested at full maturity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "User interface improvements have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Restaurant improvements have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44949607/c88abcb442d9064e9206e0f15769d75c56cc6fdc.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug fix",
     "items": [
      {
       "text": "The character's energy problems have been solved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Animation bugs have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The saving bug has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bugs in the existing shopping list in shops have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We hope you will enjoy the game and thank you so much for your patience and support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/35769272/9119f9723f0fc27715ad69be3a3dbd2c57eb6f99.png\"]",
