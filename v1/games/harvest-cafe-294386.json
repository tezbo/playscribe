  {
   "id": "harvest-cafe-294386@0.9.8",
   "gameId": "harvest-cafe-294386",
   "displayName": "Update 0.9.8",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-13T22:41:51.000Z",
   "notes": [
    {
     "title": "The game world changed totally. It's now 10x bigger.",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44949607/61d8a079dc0d2e8ad2e05f7eaefb177788357de4.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Added water tower and sprinkler.",
     "items": [
      {
       "text": "To use the sprinkler you need to build the water tower so you can water your plants very quickly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44949607/abdf17c063ea631fbf38bacbbc0816f3d243a207.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Added various seafood with the fishing boat.",
     "items": [
      {
       "text": "You can repair the fishing boat and get the ingredients you need for meals!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44949607/962c29f759cdfc0c792ea4249b54da5bcce8a16d.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Coffee machine and coffees added.",
     "items": [
      {
       "text": "Drinking coffee is a great way to recharge your depleting energy! It is not recommended to waste it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44949607/ec01d63b147d7053f0dfb893a7df3ff3f7883540.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Hire your stuff",
     "items": [
      {
       "text": "The Cook and waiters have been added. So you can make and serve your meals faster. Train them to be better![img src=\"{STEAM_CLAN_IMAGE}/44949607/dddeb4c35bbf1723b5f5fb19f03a3a6611d25663.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Farming is more live now!",
     "items": [
      {
       "text": "Cows, chickens, pigs and sheep are ready to come to your farm!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44949607/8b90c6f73bdcfd0d3cc6e4d5a3528e9cb6f5c4f8.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Faster Harvesting!",
     "items": [
      {
       "text": "Added new basket for faster harvesting. No more wasting time for harvest!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44949607/528a5790d772ec04003ba62fa949811ab7b61027.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Restaurant decoration section opened.",
     "items": [
      {
       "text": "Added carpenter allows you to build your new furniture.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44949607/35463eed4f1dd5a28c8e8996e7dec920c48a73cb.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The handbook is now available for quick information!",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44949607/7d1ec0f172adefc8ea9a2da9fe09c344cd66aa5d.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Minor Improvements",
     "items": [
      {
       "text": "UI screens have been updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated in-game icons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fast travel has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated item crafting times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed horse movement problems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Widget bugs fixed.",
       "ps5ProOnly": false,
