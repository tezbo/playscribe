   "id": "harvest-cafe-294386@0.4.9",
   "gameId": "harvest-cafe-294386",
   "displayName": "Update 0.4.9",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-11T20:34:20.000Z",
   "notes": [
    {
     "title": "New Sound Effects",
     "items": [
      {
       "text": "Added sound to play when the player picks up something from the ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added coin sound to play when the player picks up the coin from the table",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A coin sound has been added to the game when the player buys or sells a new product from the market.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "It was added to the game that when the player opens the panels in the market, a random one of 4 different “Hello Farmer” voices is played depending on the gender of the NPC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a special sound to play when the player opens the restaurant.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a wooden box opening sound to play when the Storage Box is opened.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added wind-blowing sound to the paper when opening the map panel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a sound to play when the refrigerator is turned on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a sizzling sound to play while cooking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The feature of playing tool sounds while crafting in the Workbench has been added to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added sound playback when opening the inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "All sounds were connected to the SFX channel and the ability to be dimmed from the menu was introduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added sound playback when flowers are watered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added sound play feature when water is filled from the well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added sound playback feature while harvesting plants.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the ability to play sound when we put and remove items from crafting structures, storage, and refrigerator.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the feature of playing sound when we take the plate from the counter and give the plate to the customer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the sound of cicadas in the evening and the sound of the forest during the day.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A feature has been added to the game where the clock plays a ticking sound when the time is advanced, that is if someone faints while sleeping at night and the restaurant opens early.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the feature of playing crowded ambient sound when we are inside the restaurant and there are customers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "*About This Image : Customer Rigging Fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fix",
     "items": [
      {
       "text": "Customers restaurant routes have been improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Gathering resources made easier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "*About This Image : Player Idle and Running animations are improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "General Improvements",
     "items": [
      {
       "text": "Object details are now displayed separately on all inventory screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Player notification added to structures that have finished production",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the animations and skeletal structures of the customers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Customers now act according to the food they eat. They play separate food animations like Soup or Sushi.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Player Idle and Running animations are improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
