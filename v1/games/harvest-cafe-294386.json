  {
   "id": "harvest-cafe-294386@1.0.34",
   "gameId": "harvest-cafe-294386",
   "displayName": "Update 1.0.34",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-04-04T12:25:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello cozy farmers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some players mentioned that the 500kg backpack capacity in Harvest Cafe was not enough during gameplay. We heard your feedback and made an improvement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With Version 1.0.34, the backpack carrying capacity has been increased, and you can now carry up to 1000kg.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope this change makes inventory management more comfortable and lets you enjoy the game with fewer interruptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44949607/7031ab6efd4370132ca47389efaf686c23c186e9.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "World of Poly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
