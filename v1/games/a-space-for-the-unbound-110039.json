  {
   "id": "a-space-for-the-unbound-110039@post-2021-02-05",
   "gameId": "a-space-for-the-unbound-110039",
   "displayName": "Bug Fixes on the Demo",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-02-05T19:29:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you to everyone who have played the demo or prologue chapter of A Space for the Unbound. If you enjoy the demo, don't forget to follow and wishlist the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We received reports regarding the screen freeze. Players got stuck on the river scene when the \"CRACK!\" appears. We have fixed the issue. If this still persists of if you encounter any other issue in the demo, do let us know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can tag us on Twitter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Or report to Toge Productions' Discord server",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Terima kasih!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
