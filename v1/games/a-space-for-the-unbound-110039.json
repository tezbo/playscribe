  {
   "id": "a-space-for-the-unbound-110039@hotfix-2023-03-30",
   "gameId": "a-space-for-the-unbound-110039",
   "displayName": "Controller Hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-03-30T09:52:45.000Z",
   "notes": [
    {
     "title": "Hello, Space Divers!",
     "items": [
      {
       "text": "We have discovered problem regarding controller issue and have updated the game with hotfix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To make sure the update doesn't break the game, we kindly request to players that have encountered the problem to opt-in to the secondary branch of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "To do so, please do the following",
     "items": [
      {
       "text": "Right-click on the game title on steam, and select \"Properties...\"",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Click on Betas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select \"secondary - Secondary branch\" as the beta you would like to opt into.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game will then update with the patch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Try to replay the battle session.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for the feedback and reports, please let us know whether the issue still persists or not with this latest patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay safe and healthy, friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mojiken and Toge Productions team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
