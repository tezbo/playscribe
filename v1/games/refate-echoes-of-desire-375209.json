   "announcedAt": "2025-10-22T12:41:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you all for your support of our game. We have addressed the bugs reported by players as soon as possible. The specific fixes are as follows:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Fixed abnormal unlocking issues for two achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Improved the display method for affinity levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Corrected misalignment issues in the storyline and certain in-game UI elements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Added hints and option displays for certain plot segments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
