  {
   "id": "girl-genius-adventures-in-castle-heterodyne-143372@1.0.5",
   "gameId": "girl-genius-adventures-in-castle-heterodyne-143372",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-10T13:02:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch Notes - v1.0.5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug & Issue Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Crypt Clank Boss attacks now sync up correctly on every difficulty settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed minor spelling issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where you could land on broken rails in Art Storage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with \"End of Act\" UI not queueing correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where Agatha could jump down on some Air Vents and get stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed old Debug Warning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added missing colliders to certain walls in Great Cog.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Missing Collider in Lucrezias Study.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Pressing the \"Pause\" button on controller will now correctly close the \"Load Game\" window",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
