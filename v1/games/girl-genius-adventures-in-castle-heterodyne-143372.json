  {
   "id": "girl-genius-adventures-in-castle-heterodyne-143372@1.0.4",
   "gameId": "girl-genius-adventures-in-castle-heterodyne-143372",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-15T07:35:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Accessibility / QOLI (Quality of Life Improvements)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jumping down from ledges has been adjusted to make it a little better for everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug & Issue Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The \"A Perfect Moment in Time\" achievement can now be unlocked correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tarvek is feeling a little better, and won't write dialogue over other lines of dialogue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A cutscene issue within Phosphorous Gate has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Certain pistons will stay behind walls as they're supposed to.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hiding inside staircases are no longer possible (clanks reported that it felt unfair)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed certain text typos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A certain treasure canister will no longer hold Dingbot back.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Arena Console has been adjusted to use a linear time format for best clear time evaluation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Should Agatha use the death ray within an Arena-Challenge, it will now be recharged accordingly after exiting the challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "RollerClanks have gotten a better understanding of collision with stairs in the vault levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collision within the arena has been adjusted to keep any dropped item from clipping through.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some issues regarding Zola's animations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
