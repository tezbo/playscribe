  {
   "id": "girl-genius-adventures-in-castle-heterodyne-143372@major-2025-10-28",
   "gameId": "girl-genius-adventures-in-castle-heterodyne-143372",
   "displayName": "Minor update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-28T11:36:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have changed how the sidebar in the main menu behaves. Here's how it used to work:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The sidebar would be maximized / open from the beginning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It would never open or close on its own.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It would save, with a \"now saving\" indicator, whether or not it had been maximized by the player, and stay that way.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There would be no indication that new items had been added, if minimized by the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's the new behaviour",
     "items": [
      {
       "text": "The sidebar will be closed when you open the game, with one exception.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "It will be maximized / open when you return to the main menu after playing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "It will be maximized / open the second time you start the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "After launching the game, if the sidebar is closed (this in not the exact second game launch), and there are new items to see, there will be an indication on the up arrow (maximize / open button).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We no longer save the minimize / maximize state of the sidebar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
