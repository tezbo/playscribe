   "id": "girl-genius-adventures-in-castle-heterodyne-143372@1.0.8",
   "gameId": "girl-genius-adventures-in-castle-heterodyne-143372",
   "displayName": "Patch 1.0.8",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-08-26T10:49:32.000Z",
   "notes": [
    {
     "title": "Patch Notes: Version 1.0.8",
     "items": [
      {
       "text": "This patch addresses some issues regarding saving of data, that could lead to a softlocked gamestate if the player hard exits the game inbetween certain stages of gamestate and saving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The arena console will no longer save twice after the first engagement, to avoid broken save states.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated logic on certain gameobjects in many scenes, so that they don't save too early and create a temporary broken save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The banner with links now show up-to-date content from Rain.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
