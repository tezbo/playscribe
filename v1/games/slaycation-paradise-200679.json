  {
   "id": "slaycation-paradise-200679@hotfix-2022-10-02",
   "gameId": "slaycation-paradise-200679",
   "displayName": "Hot Fix 3 + Demo Update",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2022-10-02T04:24:31.000Z",
   "notes": [
    {
     "title": "Hot Fix 3 - Minor updates and fixes",
     "items": [
      {
       "text": "A grab-bag of fixes and general user experience improvements... plus the Demo has been updated to take all the recent updates (including this one!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "FIXES/IMPROVEMENTS",
     "items": [
      {
       "text": "Poison bile fx more visible, and clearer where the damage radius is.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved visibility on Chunder Puppet enemy type.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an area the player could get stuck in Terra Feralis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved dodge roll audio not playing once upgraded with Void Step.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an on-board Intel graphics bug that made some fx not appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "BALANCE",
     "items": [
      {
       "text": "Minor nerf to the level 2 regeneration perk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added a few 'streak breakers' to ensure players are guaranteed to be exposed to a few more high tier weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Re-worked the Disco Mime trophy behavior so it's not as confusing for some players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
