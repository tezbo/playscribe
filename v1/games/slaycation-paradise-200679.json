  {
   "id": "slaycation-paradise-200679@major-2022-10-12",
   "gameId": "slaycation-paradise-200679",
   "displayName": "Slaycation Paradise 30% off and content update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-12T14:17:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Attention all Slaycationers, this is your captain speaking 👨‍✈️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Speaking of which, here's a sneak-peak of what's coming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As outlined in our roadmap, here Our new mode will take you through various new locations, surviving wave after wave of undead, blow-up dolls, aliens and sometimes all three at once!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You'll get various new perks, increasingly powerful weapons and limited build options, forcing you to adapt and improvise!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
