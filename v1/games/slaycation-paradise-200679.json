  {
   "id": "slaycation-paradise-200679@major-2022-09-21",
   "gameId": "slaycation-paradise-200679",
   "displayName": "Quality of Life Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-21T12:05:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Slaycationers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As outlined in our road map (which you can read here), we are updating Slaycation Paradise with it's first Quality of Life update, based on community feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition to a number of performance improvements, balance tweaks, and bug fixes, we're adding full keyboard and controller key-binding support!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Next up... Stay tuned for our first major content update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For updates on development join the Merge Games Discord and follow the Merge Games Twitter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
