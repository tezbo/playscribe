  {
   "id": "who-s-at-the-door-347265@post-2025-07-30",
   "gameId": "who-s-at-the-door-347265",
   "displayName": "Quick Patch Notes & Feedback Request",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-30T02:22:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just released a quick patch addressing the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛠 Fixed a Fatal Error that occurred on startup for some users",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛠 Applied a temporary fix for an anomaly issue when entering Endless Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "However, since these issues may behave differently depending on system environment,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we’d really appreciate it if you could let us know whether the problem still occurs after the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "💬 If you’re still experiencing the same issue, please let us know right away",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Steam comments, reviews, or Discord — any channel is fine!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re really sorry for the inconvenience and thank you for your patience and support 🙇",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
