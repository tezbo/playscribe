   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1. Fixed an issue where taking medicine would cause a significant spike in graphical load.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Added temporary translations for Italian and Polish.",
       "ps5ProOnly": false,
