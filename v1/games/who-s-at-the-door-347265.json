   "id": "who-s-at-the-door-347265@post-2025-09-17",
   "gameId": "who-s-at-the-door-347265",
   "displayName": "Latin American Spanish Dub Added!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-17T05:16:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch Notes – Version 1.0.8",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update introduces Latin American Spanish voice-over to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional Fixes & Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Fixed a bug where the Bori-related prompt would remain on screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Resolved an issue where the achievement 'First False Step' was not unlocking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Replaced an awkward or low-quality image with an improved version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ll continue delivering bug fixes and stability updates to improve your experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your feedback is always welcome — thank you for playing! 🙏",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
