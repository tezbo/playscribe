  {
   "id": "who-s-at-the-door-347265@1.0.9",
   "gameId": "who-s-at-the-door-347265",
   "displayName": "Patch 1.0.9",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-24T06:57:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1. Added Russian Voice-Over",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Russian dubbing is now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Fixed [It Wasn’t Real (x10)] Achievement Bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The achievement now unlocks correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Fixed Bori Cutscene Progression Issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where an extra door inside a door prevented progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "4. Increased Discovery Chance of Hidden Anomaly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The appearance rate of the rarest hidden anomaly has been significantly increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Under the same conditions, more players should now be able to encounter it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Fixed Repeated Anomalies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved an issue where identical anomalies appeared too frequently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "6. Improved Starting Room UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a visible Run button next to the Crouch button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "7. Adjusted Russian UI Text Length",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed overly long text that caused layout issues in the Russian UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "8. Removed Unintended Character Exposure in Hallway",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hidden characters that weren’t meant to appear are now properly concealed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re sorry for the long wait.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues, please leave feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "SKONEC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
