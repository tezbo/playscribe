  {
   "id": "the-ramsey-214256@1.0.5",
   "gameId": "the-ramsey-214256",
   "displayName": "Update 1.0.5",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-01-08T11:23:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In version 1.05 of The Ramsey, we've fixed a few bugs and added new features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hidden Endings Bonus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save slots with a record of viewing a Hidden Ending are marked with a flower icon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have a save with a hidden ending, all entries in the Journal will be unlocked.: Settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Voice: If you turn the volume down to the minimum, a beep sound will be played to accompany your dialog.: (The volume of the beeps follows the volume of the SE).: Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where map movement would not work correctly in certain sections of Insect Island.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the ending could become unavailable after clearing the final boss in certain situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Journal data would not load properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
