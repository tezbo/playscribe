  {
   "id": "preserve-261574@major-2024-09-25",
   "gameId": "preserve-261574",
   "displayName": "New update is coming! Preserve gets enriched with a Compendium!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-25T11:54:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Preservers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The New Update is here—find all the additional information on cards, including their scoring, placement rules, gameplay effects, and even some interesting trivia in the newly featured COMPENDIUM.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other minor changes included in this update",
     "items": [
      {
       "text": "The removal card action can now be canceled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The minimum river length has been adjusted from 3 to 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In Classic Mode, additional information boxes for each map size unlock, providing more clarity on progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphics Options: Updated FSR (FidelityFX Super Resolution) to the latest version for enhanced visual performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other Improvements",
     "items": [
      {
       "text": "Performance optimizations for smoother gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Numerous bug fixes for a more stable experience.: Don’t forget to keep your feedback coming! More updates are on the way!: Enjoy the world of PRESERVE!: Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
