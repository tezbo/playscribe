  {
   "id": "preserve-261574@post-2024-03-21",
   "gameId": "preserve-261574",
   "displayName": "Preserve Demo is now available on MacOS & Linux!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-03-21T15:47:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear preservers! 🌱",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you very much for playing our demo! We are working extensively on implementing your valuable feedbacks. Many of you also wanted to enjoy Preserve on different systems and we answered your call! Following is the list of new features and fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "MacOS build",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Linux build",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Various HUD and UI improvements and fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localisation fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Map chunk rotation improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Control and Camera settings improved (option to invert different camera parameters, adjust sensitivity)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various 3D assets improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added cancellation of map expansion placement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added popups for watermill card",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We hope you are enjoying the demo! 😊 Please don't forget to fill out the feedback form after the session or chat with us our Discord channel, so we can work on the necessary improvements for the Steam Next Fest in June. And of course, please Wishlist Preserve! 😊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Preserve dev team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
