  {
   "id": "preserve-261574@0.6.69",
   "gameId": "preserve-261574",
   "displayName": "Patch 0.6.69",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-11T10:19:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Preservers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've just rolled out a new smaller patch for Preserve. Here’s what’s changed:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Language Support Update: For this update, we've temporarily reduced supported languages to English, French, Italian, German, Spanish, Japanese, Korean, Chinese, Ukrainian, Slovak, and Czech. We’re committed to bringing back more languages in the future once we can ensure they’re fully up to date with our latest content and changes. Thanks for your understanding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mac Build Fix: Resolved an issue preventing the game from running smoothly on macOS.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achievements Update: Achievements now unlock retroactively for players who have met the requirements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
