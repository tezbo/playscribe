   "id": "preserve-261574@post-2024-12-09",
   "gameId": "preserve-261574",
   "displayName": "MacOS Launch Issue Resolved!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-12-09T10:24:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Preservers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re happy to report that the issue with launching Preserve on MacOS has been fully resolved! The game is now working as expected, and everything should be back to normal.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your patience while we worked on this fix. We truly appreciate your understanding and continued support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any further issues, please don’t hesitate to reach out to us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Preserve Dev Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
