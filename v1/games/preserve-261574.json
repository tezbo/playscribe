  {
   "id": "preserve-261574@post-2024-03-07",
   "gameId": "preserve-261574",
   "displayName": "Thank you for trying out our Demo! 💚 We are working on your feedbacks.",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-03-07T08:13:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear preservers! 🌱",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you very much for your support and for playing our demo! Based on your extensive playing, we are receiving a lot of valuable feedbacks and reports about various smaller bugs. It's very helpful and we are thankful for that! That's why yesterday we made the first update of the demo in which we solved few problems:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Support for ultrawide screens",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Support for simultaneous controller + mouse cursor control",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Controller auto-detection fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several other smaller bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you are enjoying the demo! 😊 Please don't forget to fill out the feedback form after the session or chat with us our Discord channel, so we can work on the necessary improvements for the Steam Next Fest in June. And of course, please Wishlist Preserve! 😊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
