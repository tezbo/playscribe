  {
   "id": "preserve-261574@0.8.19",
   "gameId": "preserve-261574",
   "displayName": "Patch 0.8.19",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-03-06T14:30:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Preservers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've just rolled out a new smaller patch for Preserve. Here’s what’s changed:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where erasing all progress would also remove creative maps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Addressed stuttering issues on certain models",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that allowed placing a card while removing another from the deck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved a controller expansion window issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed puzzle button navigation when using a controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed HUD getting stuck in creative mode after saving/loading",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted marine seagrass to display the proper elevation icon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Decreased the size of some fonts (Japanese, Korean, Ukrainian)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
