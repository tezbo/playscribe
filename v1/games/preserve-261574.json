   "displayName": "Important Update for MacOS Users!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-07T14:39:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Preservers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re aware of an issue with the recent update of Preserve on MacOS, where the game is currently not launching as expected. Our team is actively working on a fix and we’re doing everything we can to get this resolved as quickly as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your patience and understanding. We’ll keep you updated on our progress!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Preserve Dev Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
