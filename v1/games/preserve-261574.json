  {
   "id": "preserve-261574@post-2024-06-10",
   "gameId": "preserve-261574",
   "displayName": "Preserve Next Fest Demo Patch Notes 06/10/2024",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-06-10T13:50:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Preservers! 🌱",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are excited to bring you an updated demo for Steam Next Fest that adds to the original content. Here's what's new:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An unlocked new biome - Savanna (Small map)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5 new puzzles in the puzzle mode for the Continental biome",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5 new puzzles in the puzzle mode for the Savanna biome",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Creative mode with Savanna assets and increased tile limit to 60",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition to the new features, we also bring a huge number of improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an Undo button, allowing you to revert your last action.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Option to rebind controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Tooltips on cards and buttons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Various UI/UX improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved tutorial based on your feedbacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new Loading tips",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved cursor highlighting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved animal movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Multiple minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for trying out our demo! Your feedback is crucial in helping us improve the game. Please share your thoughts on our Discord or Steam page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
