   "announcedAt": "2022-11-14T17:52:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "v1.21 patch notes (Nov 14, 2022)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Miranda's Genki trait (was supposed to multiply damage vs poisoned enemies by x1.5, but instead was reducing damage vs poisoned enemies by half).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "When selecting traits, the bonus for ailments was displayed under healing and vice versa.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the 100% unite power achievement not triggering if you reached 100% via the +20% bonus from hyper.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with some intermissions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed music issues with retrying battles in certain instances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an instance where you could get stuck in a wall in the first dungeon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an instance in the first dungeon where certain vine obstacles were being removed by fighting the wrong mini-boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the party chat in the 2nd dungeon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
