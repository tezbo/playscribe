  {
   "id": "hellboy-web-of-wyrd-228522@1.0.4",
   "gameId": "hellboy-web-of-wyrd-228522",
   "displayName": "Update 1.0.4",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-26T16:28:16.000Z",
   "notes": [
    {
     "title": "1.0.4 Patch Notes",
     "items": [
      {
       "text": "Update default key bindings for mouse and keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Making sure new keybindings save properly between game sessions.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Changing lock-on camera sensitivity for mouse and keyboard players to decrease accidental target switching, now proportional to mouse sensitivity.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Decreasing input buffer from 0.5 seconds to 0.3seconds to reduce lag.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enabling Steam Cloud Sync for save files.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixing enemy spawn issue with walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adding an enable/disable toggle for Hellboy's stylized walk cycle animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other bugs relating to lock on and animation clean ups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes to Knife charm's teleportation distance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes for menu navigation with \"Game Options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Certain enemy special attacks now break lock on as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players can hold 2 big keys",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional safety checks in procedural generation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balance changes to increase the overall difficulty curve",
     "items": [
      {
       "text": "Heavy attack & Breakable Damage Increased for Act 2 and 3 enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Cooldown decreased for Intermediate, Advance & Expert Big Bads to make them more active while in combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Behaviour Tree Update - Cooldown starts at the end of the attack state.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Cheap attack have been made quicker.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Bat Swarm and Toxic Attack does more Damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Cheap Attacks have been rolled into Big Bad attack combos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "New Combo Attack variants have been added to some Big Bads.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Health, Toughness and Stun adjusted for some Big Bads (Spike Boar, Fox, Swarming Bat, Albino Bat, Flying Bat and Crawler)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
