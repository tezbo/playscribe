   "announcedAt": "2024-04-26T01:04:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update fixes corrupted save files in cases where a saved game contained an equipment item registered as a consumable. If this was your case, the equipment item would have been changed to a potion. To retrieve the missed equipment, simply revisit the stage where it was located, and it will be automatically unlocked. This process also checks for achievements, ensuring that you won't miss out on any.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
