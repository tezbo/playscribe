  {
   "id": "another-crusade-135681@1.2",
   "gameId": "another-crusade-135681",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-25T21:36:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "-Fixed the issue of opening a chest when having a full inventory and entering battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-EASY MODE now available - You can select the difficulty when starting a new game, or change it later in the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Item restoration after a game over - You will now retain the last items you had before entering a fight, allowing you to use them without concern for losing them in battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added a landing point indicator for the Swamp platforming puzzle - This will display where Rai will land after a jump, specifically on the platforms in the Swamp level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Varenna's sequence input background - When casting any of Varenna's magic that requires a specific input sequence, a small background will appear behind the buttons, making them easier to see.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed an issue with PS joysticks not registering the correct axis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
