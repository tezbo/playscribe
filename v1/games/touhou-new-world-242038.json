  {
   "id": "touhou-new-world-242038@post-2023-09-12",
   "gameId": "touhou-new-world-242038",
   "displayName": "Patch notes 09/12/2023",
   "kind": "dayOne",
   "kindBasis": "inferred",
   "announcedAt": "2023-09-12T18:03:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Updated the following features of \"Bullet Hell\" mode:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Heal Gauge will not refill automatically and will refill when your attacks connect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy HP increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "EXP received increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mode can now be enabled/disabled at any time during gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved dash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Dash is no longer interrupted upon getting hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added updated \"Character Silhouette\" option: *This option was temporarily disabled in the last hotfix update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where some text in the launcher became garbled on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Build ID: 12120581",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
