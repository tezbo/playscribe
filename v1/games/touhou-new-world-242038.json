  {
   "id": "touhou-new-world-242038@post-2023-08-03",
   "gameId": "touhou-new-world-242038",
   "displayName": "Patch notes 08/03/23",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-08-03T18:03:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Mystery Capsule: Added Mystery Capsule dispenser in the General Store.: *Purchasing a Mystery Capsule with in-game currency will give you one random item.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added \"Character Silhouette\" to graphics options: This option will show an outline of all characters (including enemies) when they are behind an object obstructing view.: *This is an experimental feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Turbo Mode: We replaced Bullet Hell Plus with Turbo Mode in the launcher.: Turbo Mode increases the game speed by 25% and can be turned on/off separately from the Bullet Hell option.: If both Bullet Hell and Turbo Mode are enabled, the experience will be equivalent to Bullet Hell Plus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Build ID: 11844555",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
