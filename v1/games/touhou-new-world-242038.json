   "id": "touhou-new-world-242038@post-2024-07-10",
   "gameId": "touhou-new-world-242038",
   "displayName": "Patch notes 07/10/2024",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-07-10T15:25:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Adds \"Gensokyo Dreaming\" story content (available as DLC)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Difficulty settings now available when starting the story and from the pause menu. (This replaces the difficulty settings on the main title menu)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved distribution of item drops",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed visual bugs in certain stages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added controller support to the launcher",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Other bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BuildID: 14822855",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
