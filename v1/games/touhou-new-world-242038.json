   "gameId": "touhou-new-world-242038",
   "displayName": "Patch notes 07/14/23",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-07-14T14:27:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Updated default launch behavior to boot the configuration app. Players can disable this default behavior by unchecking the \"Display Launcher on Startup\" box in the launcher.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update does not affect default launch behavior on Steam Deck, which will continue to boot the game by default.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Build ID: 11704090",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
