  {
   "id": "touhou-new-world-242038@post-2023-07-21",
   "gameId": "touhou-new-world-242038",
   "displayName": "Patch notes 07/21/23",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-07-21T18:05:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added new higher difficulty options (Bullet Hell) accessible from the launcher.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bullet Hell: Greatly increases the number, speed, and damage of enemy projectiles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bullet Hell Plus: In addition to the above changes, increases the game speed by 25%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved dash: Increased rate at which dash can be used.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced recovery after knockdown: Reduced time to recovery after taking a knockdown hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Build ID: 11747134",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
