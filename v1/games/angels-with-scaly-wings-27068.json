  {
   "id": "angels-with-scaly-wings-27068@1.05",
   "gameId": "angels-with-scaly-wings-27068",
   "displayName": "Patch 1.05",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2017-04-22T15:31:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.05 is now live and should download automatically!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This should be the last patch for a while as we've now brought the game up to a standard that we're pretty happy with. Should any new issues arise, these will of course be patched, but we've reached a point where we think we've fixed all outstanding issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What did we do this time?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "numerous minor text improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fix for achievement sync implemented: Our tests with this patch lead us to believe that we have finally found a working fix for the achievement sync problem. Of course, with a greater number of players we can't foresee if this will work for everyone, but this time we are confident that it should.: Of course, should you still have any issues with this (or any part in the game), please let us know!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
