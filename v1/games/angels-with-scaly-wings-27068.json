   "announcedAt": "2017-02-01T19:12:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.01 is live now and should download automatically.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's what we did",
     "items": [
      {
       "text": "Fixed an error that prevented some people from starting the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a typo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added Steam achievements.: To synchronize your in-game achievements with Steam, just start a new playthrough and all the achievements you have unlocked so far should also activate on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
