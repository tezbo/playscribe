  {
   "id": "angels-with-scaly-wings-27068@1.14",
   "gameId": "angels-with-scaly-wings-27068",
   "displayName": "Patch 1.14",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-02-28T11:59:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.14 is now live and should be downloaded automatically if you are using Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This fixes an issue where achievements would not unlock on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Starting the game with this version should automatically unlock all achievements on Steam that you have unlocked in the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "There is a possibility that starting the game will display an error message due to files from the old version not being deleted automatically.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "If this happens to you, you can follow these steps",
     "items": [
      {
       "text": "1. Navigate to the game's install directory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Uninstall the game on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "3. Delete any remaining files inside the game's install directory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Re-install the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
