  {
   "id": "angels-with-scaly-wings-27068@1.06",
   "gameId": "angels-with-scaly-wings-27068",
   "displayName": "Patch 1.06",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2017-08-17T19:12:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It's been a while since the last patch, so we figured we'd release an update to fix a number of small issues that have accumulated over the last few months.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's what we did",
     "items": [
      {
       "text": "Sebastian will now respond appropriately for extraordinary results when playing Bastion Breach.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an error that caused the player to never be able to talk about Remy's pictures when looking at them during his second scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Numerous minor text fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
