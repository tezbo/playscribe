  {
   "id": "angels-with-scaly-wings-27068@1.09",
   "gameId": "angels-with-scaly-wings-27068",
   "displayName": "Patch 1.09",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-01-31T17:33:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Angels with Scaly Wings turns 4 today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.09 is now live and should be downloaded automatically if you use Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The biggest change in this version is the addition of Japanese! A language selector will now appear every time when starting the game. The language can't be changed during the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Besides that, we have also made a number of small improvements, which may be the last adjustment we make to the game functionality itself:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some ui elements were changed to be clearer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bryce's ghost won't show up in Lorem's first scene anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lorem's Orb is now easier to find.: However, we have noticed some of the larger underlying changes for additional language support may make certain save files from older versions unusable or behave strangely. This does not apply to the save of the game's overall progress, but just those of an individual playthrough.: In such cases, starting a new playthrough should work without further issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
