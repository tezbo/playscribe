   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Our patch to prepare the game for wider release on launch day is live now and should download automatically.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's what we did",
     "items": [
      {
       "text": "Fixed a some text errors like typos, wrong speakers and errors related to variables in texts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some incorrect conditionals regarding characters that could lead to odd behavior.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected soundtrack track listing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed support for Steam achievements. Expect all in-game achievements to be added to Steam as well at some point within the next few days.: In rare cases, individual existing save files may be affected by these changes in a way that causes odd behavior. Using an earlier save file or rewinding may be necessary to continue. In any case, starting a new playthrough should work without issue.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
