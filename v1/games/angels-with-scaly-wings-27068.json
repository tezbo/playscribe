  {
   "id": "angels-with-scaly-wings-27068@1.1",
   "gameId": "angels-with-scaly-wings-27068",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-02T13:07:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.1 is now live and should be downloaded automatically if you are using Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This version fixes a small issue with Adine's sprite not appearing in Chapter 3 when going to the portal while she is disappointed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Apparently this issue was so rarely reported because players would rather not continue the game while not being on good terms with her!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The patch also adds a text translation for Brazilian Portuguese due to the efforts of Zeez (@zeez145, TiagoS#5071), which we greatly appreciate (Thank you Zeez!). I hope this will enable more players to experience the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
