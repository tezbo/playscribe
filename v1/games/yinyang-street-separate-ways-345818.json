  {
   "id": "yinyang-street-separate-ways-345818@major-2025-06-03",
   "gameId": "yinyang-street-separate-ways-345818",
   "displayName": "Small update on June 3rd",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-03T10:46:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1. Added the function of saving the game as another file, allowing you to overwrite an existing save or create a new one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Added a position correction feature. You can use it by clicking on the backpack when it's open to return to a normal position from an abnormal one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Fixed issues with the rewind interface.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Optimized some UI display problems in the controller mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Optimized some process-related issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "6. Fixed the problem where the game would freeze with a certain probability after death.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "7. Added gameplay tips for the Ghost Road.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "8. Fixed some known localization display issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
