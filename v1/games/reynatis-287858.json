  {
   "id": "reynatis-287858@post-2024-12-01",
   "gameId": "reynatis-287858",
   "displayName": "Steam Deck Verified and new Chapter 03 if: Squad Leader Dogo released!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-12-01T18:00:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re excited to announce that REYNATIS has been officially Verified for Steam Deck!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "REYNATIS is a full-blown action-packed magical RPG in which two people with different perspectives fight for their ideals in a realistic recreation of modern-day Shibuya, Tokyo. The latest update introduces a new episode featuring Dogo, continuing the thrilling story in unexpected ways!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This update also includes the following fixes",
     "items": [
      {
       "text": "Added an option to choose framerate settings of 30, 60, or 120 FPS (default set to 60).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue where certain keys could not be rebound in the keyboard settings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Chapter 03 if: Squad Leader Dogo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "During the usual evening assembly, Dogo is called out by Dogami and promoted to lead the new Dogo Squad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "However, everything takes a dramatic turn when Dogo unexpectedly encounters a person who had caused problems at the security company where he used to work...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* The screenshot is from the Japanese version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "+ Wishlist today and stay tuned for upcoming news, including content updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* The content update schedule may be subject to change without notice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
