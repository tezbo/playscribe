  {
   "id": "reynatis-287858@major-2025-04-01",
   "gameId": "reynatis-287858",
   "displayName": "Last Content Update + Now Supporting Korean and Traditional Chinese",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-01T17:02:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "REYNATIS is a full-blown action-packed magical RPG in which two people with different perspectives fight for their ideals in a realistic recreation of modern-day Shibuya, Tokyo. The last free update is released now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And the game now supports Korean and Traditional Chinese for the interface and subtitles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chapter in Dream: Into the Dream",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A dream once seen as \"if = dream\" begins to distort into a nightmare.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Only Marin holds the power to save those tormented by it—with a single word spoken in the dream. But when the dream transforms into a real battle against his greatest enemy, Marin is not alone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Will you dare to step into the dream and rewrite destiny?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* The screenshot is from the Japanese version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
