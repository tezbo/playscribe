  {
   "id": "reynatis-287858@03.1",
   "gameId": "reynatis-287858",
   "displayName": "Update 03.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-01T18:00:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "REYNATIS is a full-blown action-packed magical RPG in which two people with different perspectives fight for their ideals in a realistic recreation of modern-day Shibuya, Tokyo. The eighth free update introduces a new anecdote!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chapter 03.1 if Sister's Back",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Two souls, bound by an unremembered past.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After welcoming Dogo and completing their patrol, Sari and her group prepare to watch the Wizart. But their plans are suddenly interrupted by a message from Ririka Nishijima.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Destiny leads Sari to Marin, a young wizard whose significance lies dormant in the depths of forgotten memories...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* The screenshot is from the Japanese version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Wishlist today and stay tuned for upcoming news, including content updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* The content update schedule may be subject to change without notice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
