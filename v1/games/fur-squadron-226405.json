    },
    {
     "title": "🐦 Robin Mode: Erith Robin Joins the Fight",
     "items": [
      {
       "text": "Straight from FUR Squadron Phoenix, Erith Robin brings a bold new challenge. Start each mission with minimal shields and a full payload of guided bombs. Precision and timing are everything. Plus, discover alternate endings hidden in the credits!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🚀 New Ships & Controls",
     "items": [
      {
       "text": "All playable ships now feature the sleek new designs from FUR Squadron Phoenix. Controls have been reworked with improved physics, and you can now tilt your ship using gamepad analog triggers for more dynamic maneuvering.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🌈 HDR Support",
     "items": [
      {
       "text": "We now support HDR displays! Get ready for brighter highlights, deeper shadows, and colors that really pop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🎵 Remastered Soundtrack",
     "items": [
      {
       "text": "Every track has been remastered for better clarity and punch on home speakers. Love the music? You can now buy the full soundtrack on Steam and support the team!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
