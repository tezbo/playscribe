  {
   "id": "teslagrad-2-214506@2.0.229",
   "gameId": "teslagrad-2-214506",
   "displayName": "Update 2.0.229",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-19T11:22:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Updated the Rain sidebar to show platform icons for game links, and added some ui navigation sounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the height of some save points just before Fafnir. It was very easy to jump right over them, and have to backtrack very far if you died.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed rain \"hitting the ground\" mid-air near the start of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
