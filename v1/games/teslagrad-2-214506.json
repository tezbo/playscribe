  {
   "id": "teslagrad-2-214506@major-2023-09-08",
   "gameId": "teslagrad-2-214506",
   "displayName": "September 8th Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-08T12:13:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Teslamancers! We've just released a patch to fix some issues in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Major",
     "items": [
      {
       "text": "Fixed a soft lock issue around the Viking airship that would make players fall off the map. The soft lock won't happen in the future, and affected saves can now backtrack to the area and continue the game. Sorry to everyone affected!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Minor",
     "items": [
      {
       "text": "Fixed multiple issues arising from dying to the Big Snake.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Level loading times have been improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Solidified a soft piece of dirt that occasionally caused players to sink through the level by the pier in the Hub",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The main menu sidebar has been updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
