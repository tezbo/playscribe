     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've gotten quite a few messages about language support for Hoa, so we wanted to give you a quick update that we have included 10 more languages set for launch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Along with English, French, Italian, German, and Spanish..players can now enjoy Hoa in Vietnamese, Chinese, Traditional Chinese, Japanese, Korean, Brazilian Portuguese, Russian, Turkish, Hindi, Thai, and Polish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hoa releases August 24, 2021",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
