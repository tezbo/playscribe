  {
   "id": "the-awakener-forgotten-oath-263734@major-2023-11-08",
   "gameId": "the-awakener-forgotten-oath-263734",
   "displayName": "The Awakener: Forgotten Oath Update Plan",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-08T11:16:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Awakeners,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've received a wealth of feedback and suggestions since the game's launch. Thanks to all of you, we're committed to continually improving the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Updates include",
     "items": [
      {
       "text": "1. Added full-screen resolution support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Introduced Controller Invert function",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Adjusted game difficulty",
