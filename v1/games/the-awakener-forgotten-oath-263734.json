  {
   "id": "the-awakener-forgotten-oath-263734@3.1",
   "gameId": "the-awakener-forgotten-oath-263734",
   "displayName": "Update 3.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-04T07:51:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 3.1 is now live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update focuses on fixing issues introduced in the previous patch. We sincerely apologize for the inconvenience caused to all Awakeners battling within the Void Realm.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have also reduced the cost of one character skin—thank you for your continued support, and welcome back to the war against fate!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Skin Shop Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Reduced the cost of Caelynn’s skin “Tideborne Blue”",
     "items": [
      {
       "text": "50 Divine Shards → 20 Divine Shards — now easier to obtain!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crash & Performance Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the likelihood of crashes triggered by using elemental combat arts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced crash occurrences during the stage 31 Boss battle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where Ice-element combat arts would cause ice spikes to spawn in the wrong position",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where killing an enemy at very low HP and healing would incorrectly trigger a death count",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Health Flask System Fixes & Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the maximum number of health flasks could be incorrectly capped at 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(now correctly interacts with relic stacking and character reset mechanics)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where health flasks would heal far more than intended (overflow healing)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Display & Record Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where Tyrdagan’s combat records were missing from the battle log",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Skill System Optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improved skill draw logic",
     "items": [
      {
       "text": "Players will no longer receive skills of the same element and same level, increasing build variety",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Settings Menu Fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where modifying key bindings, then adjusting graphic settings, would cause key bindings to revert",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "(settings now save and apply correctly)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
