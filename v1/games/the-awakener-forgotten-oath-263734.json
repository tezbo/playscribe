  {
   "id": "the-awakener-forgotten-oath-263734@2.4",
   "gameId": "the-awakener-forgotten-oath-263734",
   "displayName": "Patch 2.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-23T06:12:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Awakeners,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The upcoming Version 2.4 update focuses on improving performance and reducing stuttering, especially during early gameplay interactions. Our goal is to provide a smoother and more immersive combat experience for all players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update Highlights",
     "items": [
      {
       "text": "1.New Precompilation Phase in Main Menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The game now precompiles essential resources such as skill animations and effects during the main menu phase, reducing load time during actual combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "2.Reduced Stutter on First Hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Addressed issues where the first time a character’s skill hits an enemy would cause a noticeable stutter. Combat feedback is now more responsive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "3.Optimized First-Time Visual Effect Loads",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved how visual effects are loaded the first time they appear, such as potion use or spell casting, reducing the delay and enhancing immersion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "4.Improved Initial Level Loading Performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced stuttering and load times when entering a map or level for the first time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you for your continued support and feedback. Feel free to share your thoughts with us on the community channels!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
