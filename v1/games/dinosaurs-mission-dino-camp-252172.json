  {
   "id": "dinosaurs-mission-dino-camp-252172@1.20",
   "gameId": "dinosaurs-mission-dino-camp-252172",
   "displayName": "Patch 1.20",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-08-27T06:33:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[table noborder=1]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hey everyone, great news! We've just rolled out an update (1.20) for Dinosaurs: Mission Dino Camp that fixes the revive and save/load feature issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We know how frustrating it was when players got stuck in a fall-off-the-cliff-and-die loop after reviving or loading a game. This update takes care of that problem, so you can enjoy a smoother adventure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy gaming and thanks for your feedback and support! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
