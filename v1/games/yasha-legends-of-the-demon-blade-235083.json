  {
   "id": "yasha-legends-of-the-demon-blade-235083@1.0.1",
   "gameId": "yasha-legends-of-the-demon-blade-235083",
   "displayName": "Update 1.0.1",
   "kind": "dayOne",
   "kindBasis": "inferred",
   "announcedAt": "2025-05-15T04:51:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are aware of a bug in version 1.0.1 where the game may freeze if the player obtains more than 14 Amulets. This issue occurs randomly and has been reported through several player livestreams and gameplay footage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The devs are currently working hard to identify the root cause and implement a fix as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We truly appreciate your patience and continued support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
