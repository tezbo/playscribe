  {
   "id": "yasha-legends-of-the-demon-blade-235083@1.0.7",
   "gameId": "yasha-legends-of-the-demon-blade-235083",
   "displayName": "Update 1.0.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-06T05:54:31.000Z",
   "notes": [
    {
     "title": "Update",
     "items": [
      {
       "text": "Improved the feel of Taketora's consecutive charged arrows, making it easier to chain charged shots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Soul Orb Upgrade: Taketora's weapon Nioh's Soul Orb \"Always in the Fight\" now also increases melee critical rate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Soul Orb Upgrade: Taketora's weapon Dancing Swells' Soul Orb “Vortex of the Sea” now increases melee attack speed for all weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the random generation logic for Soul Orb.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the clarity and descriptions of Soul Orb effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed an issue where salvaging Soul Orb could occasionally result in errors under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
