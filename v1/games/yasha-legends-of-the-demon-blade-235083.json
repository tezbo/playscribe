  {
   "id": "yasha-legends-of-the-demon-blade-235083@1.0.6",
   "gameId": "yasha-legends-of-the-demon-blade-235083",
   "displayName": "Update 1.0.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-29T04:30:01.000Z",
   "notes": [
    {
     "title": "Update",
     "items": [
      {
       "text": "Increased the amount of Soul Power obtained to help players build talents faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased the attack frequency of the red ninja instructor in the tutorial to prevent players from falling asleep while waiting for him to warm up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Players now start with 3 Soul Orb refresh chances, allowing faster access to desired combinations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue where the player could sometimes move outside the map boundaries during the boss fight with Mikoshi Nyudo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where enemy position icons would sometimes remain on screen during story dialogue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where stepping into water on certain maps would mistakenly trigger leaf splash effects instead of water splashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
