  {
   "id": "yasha-legends-of-the-demon-blade-235083@1.0.4",
   "gameId": "yasha-legends-of-the-demon-blade-235083",
   "displayName": "Update 1.0.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-21T09:52:57.000Z",
   "notes": [
    {
     "title": "Update",
     "items": [
      {
       "text": "Added constant display for Inferno Scroll difficulty level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added feature to dismantle Soul Orbs for money.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new enemy aura types: \"Ice\" and \"Water\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved Shigure’s \"Grand Mystic Artes\" by shortening dash cancel delay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced Sara’s weapon \"Spring Dango\" to spawn more dango and make them easier to interact with.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the charge speed effect of the legendary ramen \"Clear Mirror, Still Water\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Buffed some amulets with previously low stats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted Shigure’s weapon \"Undying Cuckoo\" to fix an issue where energy might not be properly gained.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted Takeko’s weapon \"Sunset\" so the meteor effect no longer lingers too long, blocking enemy actions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the explosion effect for 5 stacks of \"Burn\" to reduce screen-blocking duration.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Corrected some text errors in the Inferno Scroll descriptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted damage values of certain weapons with abnormal output.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue where certain attacks from the boss Mikoshi Nyudo could lock player controls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some attacks from Mikoshi Nyudo could prevent the player’s death animation from playing properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the boss Nine-Tailed Fox might not drop rewards upon defeat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Shigure's \"Grand Mystic Artes\" might fail to deal damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed overlapping background music in Story Viewing Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
