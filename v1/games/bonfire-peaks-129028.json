  {
   "id": "bonfire-peaks-129028@1.2.23.05",
   "gameId": "bonfire-peaks-129028",
   "displayName": "Update 1.2.23.05",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-05-17T17:22:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Prevent unintended solution to level Drop Box",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix a startup state that triggered a new game even if save data existed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix determinism issue when arrows collide with crates in mid-air",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a few edge cases where crates joined by arrows would behave unexpectedly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for an edge case where the player could both climb onto and lift a multi-crate structure in 1 move",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
