  {
   "id": "bonfire-peaks-129028@1.0.27",
   "gameId": "bonfire-peaks-129028",
   "displayName": "Patch 1.0.27",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-03-18T17:21:28.000Z",
   "notes": [
    {
     "title": "In the meantime, here's some patch notes for some issues I fixed in v1.0.27, live now",
     "items": [
      {
       "text": "Controller mapping is now displayed properly, but still not remappable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made snowy ground tiles easier to read",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced polycount on some models to improve performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where arrows can be pushed/pulled sideways into/out of arrow traps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where walking on a supported 2x1 that's above a crate that's above spikes incorrectly impales the crate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a few bugs where crates weren't being carried when they should",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mouse click in pause menu no longer deselects the active button",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed overworld lighting not updating after undoing an overworld reset",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Walking on a 2x1 supported by both a crate and a crumbling block no longer crumbles the block",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Undo state wasnt being tracked if you pivot without holding something, now it is",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where collisions werent being checked if you quickly changed directions mid-move",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where you could clip arrow-joined crates through solid objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a few bugs where you could separate two crates joined by an arrow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a handful of edge cases where you could get stuck at a 45° angle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a \"pulling a crate out of an arrow trap while it was trying to fire\" bug found in Bodyguard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a softlock that was possible in level Bodyguard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
