   "id": "bonfire-peaks-129028@1.0.24",
   "gameId": "bonfire-peaks-129028",
   "displayName": "Update 1.0.24",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-11-07T22:19:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed: a dozen edge cases where crates joined by an arrow would separate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: new save games were occasionally loading previous game states",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: arrows joined to flying crates now snap when they should",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: a water current bug (reproducible in \"Reverse Osmosis\")",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made a deterministic rule for 2x1s that are being pushed in 2 different directions by water currents",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "the rule is: if a 2x1 is on multiple currents, and one is pointing at the other, make that one take precedence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
