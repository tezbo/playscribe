  {
   "id": "bonfire-peaks-129028@1.0.23",
   "gameId": "bonfire-peaks-129028",
   "displayName": "Update 1.0.23",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-10-26T15:04:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Mechanics spoilers ahead!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor lighting improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where you could push a 2x1 through a wall and intersect some crates (found in Crate Expectations)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where joined crates sitting on spikes would separate for no apparent reason",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where an arrow inside a charred 2x1 would inexplicably swap positions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where a flying crate would move one extra tile even if the crate below it (supporting it) was unable to move",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash that was possible in Trench Run, among other places",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash that was possible in To Infinity, among other places",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where you could die, reset, then undo, and circumvent the death state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a softlock possibility in the end sequence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various other stability fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
