  {
   "id": "bonfire-peaks-129028@1.3.25.9",
   "gameId": "bonfire-peaks-129028",
   "displayName": "Update 1.3.25.9",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-09-02T18:09:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Design: prevented unintended solution for Visions from the Abyss (DLC3) reported here https://steamcommunity.com/app/1147890/discussions/0/604162514919452106/?tscn=1753359079",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Performance: general optimizations for smoother sailing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Accessibility: added framerate settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: some crates ended up in walls in DLC2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: this bug in level Dig Deep (DLC3) https://steamcommunity.com/app/1147890/discussions/2/604163526655937326/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: DLC2 ending bugginess described here https://steamcommunity.com/app/1147890/discussions/2/604158477795860160/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: pushing crates upward diagonally when it shouldnt be possible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: minor changes to controller vibration (e.g. vibe when rotating is less strong)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Visual: minor art tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
