  {
   "id": "xiii-117509@post-2021-06-08",
   "gameId": "xiii-117509",
   "displayName": "XIII – Patch Note – 08/06/21",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-06-08T16:27:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we are pleased to share with you some new improvements we were working on for XIII:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player can now hold every type of weapon he finds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved weapon wheel and weapon management",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added FOV setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Stability and framerate improvement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various bugfix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are still committed to improve the game experience and we will have more news to share later this year.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
