  {
   "id": "xiii-117509@major-2022-06-29",
   "gameId": "xiii-117509",
   "displayName": "XIII Remake – A major update coming September 13",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-29T15:02:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "To achieve the quality standards and offer an optimal gaming experience, Microids decided to entrust the development of XIII Remake to the French studio Tower Five (Lornsword: Winter Chronicle). Hard at work for more than a year on a major update. This update will be released on September 13th.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On that date, owners of the game will receive a free update and enjoy the game as intended. The development studio reworked the entire game from the Art Direction to the AI and added numerous technical improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
