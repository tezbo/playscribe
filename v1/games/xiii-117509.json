  {
   "id": "xiii-117509@1",
   "gameId": "xiii-117509",
   "displayName": "UPDATE 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-11-21T17:04:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The teams at Microids and PlayMagic invite you to download a new patch for the game XIII.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch fixes some of the issues you may have encountered since the beginning of your adventure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The teams are working relentlessly to provide you with regular patches to improve your playing experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "You'll find below a summary of this patch's fixes",
     "items": [
      {
       "text": "Weapon improvements (balancing, animations, tweaks, notably on ADS on machine guns, some audio)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Better Gameplay experience : AI bugs where enemy would not react, in-game objective markers, UI glitches, new narrative sequences, more user-friendly pickups, achievements tweaks, various bugs related to checkpoints and potential blockers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Art debugging and improvements (various collision and occlusion bugs, optimization, animation glitches, a lot of polish in levels – adding VFX, light, etc..)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Notable fixes on users feedbacks : mouse sensitivity, weapons animations and sounds (partially)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
