  {
   "id": "xiii-117509@major-2022-09-13",
   "gameId": "xiii-117509",
   "displayName": "XIII Remake - New update available",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-13T08:01:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After several months of waiting, Microids and Tower Five studio present you the long awaited update of XIII Remake",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You will find significant improvements and fixes along with the much anticipated online multiplayer mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update is free and available today to meet your expectations whether technical corrections, AI or artistic direction the whole game has been reworked by the studio to provide you with the most fluent gaming experience possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
