  {
   "id": "xiii-117509@post-2020-12-21",
   "gameId": "xiii-117509",
   "displayName": "XIII - Patch Note - 21/12/2020",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2020-12-21T10:40:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re to pleased to share with you a new update concerning XIII. Ever since the launch of the game, Microids and Playmagic have been listening to the community’s feedback and our teams have been continuously working to provide you with a better experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "You’ll find below a summary of this patch’s fixes",
     "items": [
      {
       "text": "• Weapon improvements (balancing, animations, sound effects, Grenade timer, Keybinding on PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Animation improvements (further fixed on Ragdoll system, polish in several cutscenes and in-game sequences)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Gameplay improvements (checkpoints added after flashbacks, Ammunitions and Medkits management, tweaks on some bosses, further audio additions and fixes)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Art debugging and improvements (various collision and occlusion bugs, lighting)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The full patch notes are available on Microids’ official website: https://www.microids.com/xiii-patch-notes/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
