  {
   "id": "garden-life-a-cozy-simulator-204554@1.1",
   "gameId": "garden-life-a-cozy-simulator-204554",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-12T11:03:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello fellow green thumbs!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for all the feedback on the Steam forums and our Discord server. We're gathering your input and ideas!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we're happy to release our first patch for the game. It focuses primarily on issues you reported that block gameplay. Crashes, blocked flower statues, and also some additions we could add to the gameplay like a bigger bag. Read about the details below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More bag space",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix to dragon floral statue so it does not block the throne statue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes to chinese Localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Video for steam deck now working",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Updated Size UI in the flower stand",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stopped the summer tool sound in the distance when it's raining",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Replaced clock ticking sound in shed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moisturise me achievement fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achievements now trigger after the end of the day",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achievements now trigger that were gained / are gained in the market place",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can expect more fixes coming in the coming weeks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Warm whishes,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Garden Life team 🌼",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
