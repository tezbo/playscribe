  {
   "id": "garden-life-a-cozy-simulator-204554@1.3",
   "gameId": "garden-life-a-cozy-simulator-204554",
   "displayName": "Update 1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-20T15:08:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're having a run at the moment! We've just set a new patch live with the following enhancements and fixes! You will notice things we got a lot of feedback on and we could pack into our short timeline. I hope you'll like it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Missing icon for 'keeping stock' tutorial mission fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark and pale pink amaryllis seeds are now consistent",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Seasonal secateurs now cut with continuous behaviour and fixed SFX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Time of in game day extended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Time is paused whilst in a menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crafting now uses items from inventory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Warm whishes,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Garden Life team 🌼",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
