   "gameId": "garden-life-a-cozy-simulator-204554",
   "displayName": "New patch coming today!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-11T13:29:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Gardeners,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been a while! We hope you're all well and that 2025 is off to a great start for you :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new patch is available today with some various fixous and updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's the full patch",
     "items": [
      {
       "text": "Fertilisers now stack up to 10 per slot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ivy and Fatsia leaves are now profitable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fix for the snips when using the snips on rose bushes you now only get the rose flowers and no clippings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Background updated for loading screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jasmine Bqs take less flowers to craft (from 20 to 15)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Warm whishes,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Garden Life team 🌼",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Join-us",
     "items": [
      {
       "text": "Garden Life FacebookGarden Life TwitterGarden Life InstagramGarden Life DiscordNacon TikTok",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
