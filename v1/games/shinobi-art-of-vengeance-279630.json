   "id": "shinobi-art-of-vengeance-279630@major-2026-07-13",
   "gameId": "shinobi-art-of-vengeance-279630",
   "displayName": "SHINOBI: Art of Vengeance ESRB Rating Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-13T23:53:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In Patch 1.2 for SHINOBI: Art of Vengeance, we introduced a link to the in-game store which directs players to purchase the SEGA Villains Stage DLC. Under ESRB guidelines, this link is considered an Interactive Element of In-Game Purchases. Please note that the ESRB rating of SHINOBI: Art of Vengeance has been updated to reflect this change and can be found on our storefront page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If there are any future updates, we will make sure to provide updated information.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
