  {
   "id": "shinobi-art-of-vengeance-279630@1.2",
   "gameId": "shinobi-art-of-vengeance-279630",
   "displayName": "Patch 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-01T21:59:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Raise your katana’s, a new patch for SHINOBI: Art of Vengeance is coming soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On April 2nd, at 9pm Pacific Time, we will be releasing a patch for all players alongside the DLC release that will include some new content, as well as some quality of life improvements. Please find the details below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "“Hardcore” Mode",
     "items": [
      {
       "text": "Enjoy an ultra high-difficulty mode featuring various adjustments to gameplay. In addition to changes to damage taken, health regeneration, and enemy placement, new attack patterns have been added for certain bosses. This mode can only be selected when starting a New Game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Combat System Adjustment Features",
     "items": [
      {
       "text": "You can now adjust attack animation duration, flash effects when hit, the intensity of camera shake during combat, and the display of character outlines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Added Tutorial View Feature",
     "items": [
      {
       "text": "You can now review tutorials that have been displayed in the game so far.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Map Improvement",
     "items": [
      {
       "text": "We have expanded the viewable area when opening the map within a stage to improve visibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed a bug where Musashi’s position was displayed incorrectly on the map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
