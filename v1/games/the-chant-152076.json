  {
   "id": "the-chant-152076@1.4",
   "gameId": "the-chant-152076",
   "displayName": "Patch 1.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-12-15T22:55:01.000Z",
   "notes": [
    {
     "title": "Patch 1.4 is out now!",
     "items": [
      {
       "text": "We can’t believe it has been over a month since launch and we first want to take a moment to thank all our players. Your feedback is much appreciated and has served as a basis for the priorities addressed in today’s update and the hotfixes which preceded it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New PC Features",
     "items": [
      {
       "text": "Added Key Remapping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added FOV Slider",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added more display FPS limiter options (72, 75, 90, 120, 165)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Tutorial Tuning",
     "items": [
      {
       "text": "Added and updated some tutorials based on player feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed the “Mind Attack Counter” tutorial not showing up as intended under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed the “Panic Mode” tutorial not showing up as intended under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed the “Gloom Sanctuary” tutorial not showing up as intended under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed the “Salt Can Interrupt Attacks” & “Desperate Dodge” tutorials activating incorrectly under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Renamed and fixed a number of issues with the Gloom Vortex tutorials (formerly known as the Fast Travel Hub), not triggering as intended under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed the “Gloom Vortex” tutorial showing incorrect interaction prompts under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Angie Tuning",
     "items": [
      {
       "text": "Angie encounter has been tuned based on player feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Angie de-spawns for a longer duration when temporarily defeated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Angie’s regular movement speed and hearing radius is reduced to encourage exploration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Chapter 6 Boss Tuning and Polish",
     "items": [
      {
       "text": "Extensive changes have been made to this encounter to address player frustration and feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "We’re aware there are still some balancing issues with this boss and we plan to release another hot fix patch as soon as possible to address these",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Chapter 5 Boss Bug Fixes",
     "items": [
      {
       "text": "Bug fixes & visual updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Fire and Essential Oil tuning",
     "items": [
      {
       "text": "Fire Oil - Self Damage radius is more forgiving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fire Oil - Fixed damage direction from triggering the wrong hit reaction on the player when self-damaging",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes & Misc",
     "items": [
      {
       "text": "Fixed Jess being hit into inaccessible gloom by enemies and not consistently bouncing off the barrier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a potential blocker in Chapter 5’s irrigation puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed players being able to input keystrokes/button presses while loading",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed enemies getting stuck on Jess when going up a ladder, while in panic mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a checkpoint not saving progress as intended in the prologue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue causing players to bypass the Mandacore encounter under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed spikes meant to block a door",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Crystalline Spikes being invisible on certain PC configurations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed default setting to be full screen instead of windowed mode",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed default setting to be set to Custom scaling quality instead of Performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please continue to report any issues you may encounter while playing The Chant here in the Steam forums or our other channels across the social space.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Twitter: @TheChantGame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Instagram: https://instagram.com/thechantgame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Facebook: https://facebook.com/TheChantGame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Website: https://thechant.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
