  {
   "id": "the-chant-152076@post-2023-09-13",
   "gameId": "the-chant-152076",
   "displayName": "The Chant Patch Notes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-09-13T15:00:45.000Z",
   "notes": [
    {
     "title": "Our Dear Community,",
     "items": [
      {
       "text": "We want to apologize once again for any technical issues you might have experienced with the Steam version of the DLC. The matter should now be resolved and you should be able to install it now. Thank you for your understanding and patience and enjoy the new content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This week, we are not only releasing a new DLC for our players but also introducing a significant number of major improvements to the base game, enhancing the overall experience with more depth and diversity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Revised Mind Body Spirit Experience System",
     "items": [
      {
       "text": "Enemies are now classified as either Mind, Body, or Spirit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mind, Body, or Spirit experience is gained from defeating each enemy type",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weapons and Abilities do extra damage if they match the same class of enemy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemies now have color-coded health meters based on experience type",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tuned overall mind body and spirit experience to make endings more equally distributed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Improved AI",
     "items": [
      {
       "text": "Enemies are more observant and responsive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemies can chase the player further",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Combat Improvements",
     "items": [
      {
       "text": "More smooth and responsive auto targeting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More accurate collision for player and enemy attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Visuals",
     "items": [
      {
       "text": "Gloom colors are more vibrant and clear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "* Steam Only",
     "items": [
      {
       "text": "Improvements to mitigate hitching on all quality presets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Sincerely,",
     "items": [
      {
       "text": "Brasstoken",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
