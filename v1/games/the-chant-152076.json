  {
   "id": "the-chant-152076@1.3.1",
   "gameId": "the-chant-152076",
   "displayName": "Patch 1.3.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-11-18T09:53:38.000Z",
   "notes": [
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "PSO Cache/Shader Pre-Caching added. This preloads matching quality preset compiled GPU shaders to improve performance and reduce any hitching when first playing through the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed windmill related progression issue if done in a particular sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed mercury related progression issue if done in a very specific order/death sequence in Chapter 4.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue in the Inventory Research Tab, if the player is browsing through different items and leaves: to either Upgrades or Inventory and returns back to Research, the layout is not reset and the columns will not be matching correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue In the Options - Graphics menu, using \"Apply\" or \"Reset Settings\" will force players to the top of the menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue In the Options - Display menu, the \"Reset Settings\" is greyed out when Display Resolution is changed but not saved yet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue in the Options - Controls menu, the \"Reset Settings\" is greyed out when Vibration Setting is changed but not saved yet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
