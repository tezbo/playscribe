  {
   "id": "the-chant-152076@1.3.2",
   "gameId": "the-chant-152076",
   "displayName": "Patch 1.3.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-11-18T09:54:00.000Z",
   "notes": [
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "Fixed issue in chapter 2 cannery fight that causes characters to get stuck after being smashed into a table.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue during the reflector puzzle on the island in Chapter 4 where certain gloom areas became accessible without connecting the reflectors, which caused progression blockers if a checkpoint further along was triggered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
