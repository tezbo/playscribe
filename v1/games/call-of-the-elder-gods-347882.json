    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Fixed multiple visual issues that occur when the Global Quality Preset is set to Low (PC & Steam Deck)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the Window Size option failing to persist when navigating in and out of the options menu while the Display Mode is set to Windowed (PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed black polyp animation that fails to be triggered after interacting with the Orb at the Elevator Tower (PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed controls where the player wasn’t able to navigate using the keyboard through the menus (PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed collision issue where traverse ring asset clips through the wall near the Coordinates machine (PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed textures appearing blurry and flickering at multiple locations (PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the traverse rays appearing distorted when viewed from a distance (PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Evangeline's lip animation failing to move with her dialogue (PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some graphical issues with the black ooze texture popping in/out on moving back and forth (PC, Steam Deck)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the application failing to switch to a secondary monitor when the 'Display Mode' is set to 'Full Screen' (PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the title displaying unsupported resolutions when switching monitors (PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
