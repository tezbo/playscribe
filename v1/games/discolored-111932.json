  {
   "id": "discolored-111932@post-2020-02-16",
   "gameId": "discolored-111932",
   "displayName": "Minor bug fix for high end monitors",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2020-02-16T00:15:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Discolored has been updated with a fix for those playing with a high-end monitor and were experiencing stuttering issues while looking up and down. This should be vastly improved if not completely fixed. For best results please make sure Vsync is enabled. You may have to restart Steam to get the update. If anyone runs into any issues with this update please let me know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jason",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
