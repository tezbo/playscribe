  {
   "id": "discolored-111932@post-2021-03-07",
   "gameId": "discolored-111932",
   "displayName": "Improvements for speedrunners",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-03-07T18:57:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "When the Speedrun Skips option is checked in the Settings menu the game will skip auto-saving when picking up items in the game. This is to avoid any lag that might occur during an auto-save when picking up items. The game will still auto-save at the beginning of a level with this option checked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Saving the game manually still works as it previously did.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
