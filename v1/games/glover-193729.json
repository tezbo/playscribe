  {
   "id": "glover-193729@1.1",
   "gameId": "glover-193729",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-05-17T16:04:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Guys,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is the first patch of many, we have worked on some bugs, but not all of them are fixed yet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So far some of the audios have been tweaked to work (Glover Scream, and cross stitch laugh for example).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Exit to windows button has been added, also the controller input bug has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In terms of game areas, the conveyor backwards and the hole in carnival have been fixed,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
