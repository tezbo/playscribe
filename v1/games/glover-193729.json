  {
   "id": "glover-193729@1.2",
   "gameId": "glover-193729",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-07-08T15:01:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Guys, here is another patch, this deals with a couple of sound effects that play wrong, It also fixes the the missing boulders on the Dino levels. It also fixes the bomb graphic on the last boss fight. Garibs hit box has been increased by 10%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are still working on more reported bugs. After that we will work on improving the textures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
