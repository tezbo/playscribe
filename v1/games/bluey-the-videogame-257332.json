   "id": "bluey-the-videogame-257332@major-2025-09-26",
   "gameId": "bluey-the-videogame-257332",
   "displayName": "Another update. For real life!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-26T08:41:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This means playing with Grandad, Aunt Trixie and Nana. Help them on quests from the Heeler House to the Beach to earn and unlock costumes, toys and more. Have a more enjoyable experience for little hands, with easier actions to build structures, pick up objects and play games. Keep track of your new trophies and create more memories in your sticker book.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Grandad, Aunt Trixie and Nana. Get ready to help them in new quests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Leap into a livelier world from the Heeler House to the Beach.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Help your favourite characters in new fetch and craft quests to earn and unlock costumes, toys, and more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A more enjoyable experience for little hands, with easier actions to build structures, pick up objects and play games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Keep track of your new trophies and see what it’s like to freeze Grandad. Create more memories in your sticker book.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
