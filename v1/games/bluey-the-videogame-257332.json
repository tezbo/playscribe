  {
   "id": "bluey-the-videogame-257332@major-2025-05-16",
   "gameId": "bluey-the-videogame-257332",
   "displayName": "Bluey: The Videogame | Free Update Avaliable",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-16T14:24:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, Bluey fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve got a new free update for you! Thanks to the valuable feedback from our players, we’ve improved user experience with tons of fixes and optimisations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New additions",
     "items": [
      {
       "text": "Enjoy classic games with new rules. Keepy Uppy, Magic Xylophone, Chattermax Chase, and Ground is Lava now have 5 stars to collect!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Each game is set in its own unique fun new location",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Use the new Games Book to quickly travel to each new game location",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New rules! New objects! New interactions!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Explore Bluey’s world with new items to unlock and keep your eyes open for more updates coming soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
