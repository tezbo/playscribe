  {
   "id": "life-is-strange-double-exposure-305158@post-2024-12-05",
   "gameId": "life-is-strange-double-exposure-305158",
   "displayName": "Life is Strange: Double Exposure Patch Notes - December 5th 2024",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-12-05T15:07:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This patch only applies to PS5, Xbox Series S|X and PC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "(PC Only) Made various minor improvements for Steam Deck users.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "(PC Only) Resolved an issue where the game would load for an infinite time.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "'Bay or Bae' achievement has been updated to help ensure it unlocks if they meet the requirements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved an issue in Chapter 5 when Lucas is giving the Jefferson monologue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue where NPC eyes are visually bugged.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you are still facing issues, please message our support team here: https://sqex.link/16c1b4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
