  {
   "id": "she-s-leaving-342811@major-2025-09-17",
   "gameId": "she-s-leaving-342811",
   "displayName": "Big Update: New Demo & Trailer Coming Sept 29",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-17T11:27:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since launching our demo, we’ve been hard at work addressing your feedback and adding new features to She’s Leaving. Your support and input have been invaluable in helping us refine our debut title.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve temporarily taken the demo offline as we prepare to roll out an enhanced version on Monday, September 29th arriving alongside a brand new trailer and some very exciting news we can’t wait for you to see.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you to everyone who played the original demo and shared your thoughts. It’s made a huge difference in shaping the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "She’s Leaving is still on track for a Fall 2025 release, with more details revealed soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned, and we’ll see you Monday!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
