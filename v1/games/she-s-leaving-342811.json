  {
   "id": "she-s-leaving-342811@major-2025-12-11",
   "gameId": "she-s-leaving-342811",
   "displayName": "She’s Leaving – First Major Update (Christmas Edition)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-11T17:15:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "She’s Leaving – First Major Update (Christmas Edition)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re excited to release the first major update for She’s Leaving. With the holiday season here, this update also includes optional Christmas-themed content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s what’s included",
     "items": [
      {
       "text": "Danger Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A high-stakes mode featuring permanent death and no saving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Detective Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Explore the story of She’s Leaving without any stalker presence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Christmas Decorations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now toggle Christmas decorations for House Haywood.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To enable them, go to: Menu → Other → Christmas Decorations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(This can also be toggled while in-game.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please check out our trailer below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several player-reported issues have been addressed and included in this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stalker AI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re testing new methods to make the Stalker more engaging. If you encounter any issues, please let us know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Soundtrack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Over the next few days, we’ll be uploading the full game soundtrack to YouTube for anyone interested.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That’s everything for this Christmas update. Thank you again to everyone who has supported the game since launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
