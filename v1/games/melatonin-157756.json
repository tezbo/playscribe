   "id": "melatonin-157756@post-2024-08-29",
   "gameId": "melatonin-157756",
   "displayName": "Level editor bug fixes and adjustments",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-08-29T02:23:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added: you can use up/w and down/s in the level editor to move the cursor faster",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: when you re-edit your level, you will be returned to the previous cursor position",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: when increasing the bar length and start buffer, hold shift to increase/decrease by 10",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug that left your cursor in the middle of nowhere when adjusting bar length",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
