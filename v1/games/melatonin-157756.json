  {
   "id": "melatonin-157756@post-2026-09-28",
   "gameId": "melatonin-157756",
   "displayName": "Steam Workshop Improvements",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-09-28T20:09:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! I took a short break from working on my new game (TBA) to make some improvements to Melatonin’s Steam Workshop support. If you run into any issues or have questions, please post about it in the official Discord server https://discord.gg/3s4mRqyyQz.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mac compatibility",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Custom music and Steam Workshop support now works on Mac! Sorry for the long wait.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Update your levels",
     "items": [
      {
       "text": "You can now update your levels by entering your workshop level ID or URL.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Upload your own thumbnails",
     "items": [
      {
       "text": "You can now easily upload a thumbnail image within the game when uploading your level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Level completion tracking",
     "items": [
      {
       "text": "You can now track which custom levels you have played (unfortunately this is not retroactive so they will all appear as unplayed starting now).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "More easily comment/rate levels",
     "items": [
      {
       "text": "You can now open up the workshop page for the custom level you just played when you finish the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
