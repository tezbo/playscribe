  {
   "id": "star-wars-jedi-survivor@8",
   "gameId": "star-wars-jedi-survivor",
   "displayName": "Patch 8",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-01-11T15:01:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 8 for Star Wars Jedi: Survivor arrives today for PC.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Patch 8 Details",
     "items": [
      {
       "text": "This patch introduces two new features and several improvements to Slow Motion in order to make Star Wars Jedi: Survivor accessible to even more players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new high contrast mode allows players to desaturate the environment and use colors specifically for narrative and gameplay elements, making them stand out more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new audio ping functionality allows players to both passively and actively ping the environment, giving the ability to echolocate objects and interactable elements nearby.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update includes additional slow motion presets. With this new implementation players can toggle between both their own custom value and three new presets.: The presets are set at 30%, 50% and 75% and available through the shortcut menu. This will allow users to switch between multiple different slow motion values, and not just the custom value and the default game speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can find more information on all of Star Wars Jedi: Survivor’s accessibility features here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch also incorporates some fixes for performance and stability across all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate the continued support you’ve given Star Wars Jedi: Survivor while we’ve been hard at work improving your experience. As always, let us know if you run into any additional issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
