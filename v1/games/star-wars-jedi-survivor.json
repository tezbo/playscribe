  {
   "id": "star-wars-jedi-survivor@9",
   "gameId": "star-wars-jedi-survivor",
   "displayName": "Patch 9",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-09-12T14:00:15.000Z",
   "notes": [
    {
     "title": "Patch 9 Details",
     "items": [
      {
       "text": "This patch focuses primarily on performance and quality of life improvements for the PC version of the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Performance Improvements",
     "items": [
      {
       "text": "Framerate improvements for various hardware configurations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixes for several sources of framerate hitching for smoother gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ray Tracing has been optimized for CPU usage and should now scale better for high-end GPUs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixes for performance related to using a mouse as gameplay input.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Quality of Life",
     "items": [
      {
       "text": "The “Optimizing Game Files” screen has been optimized and can now see speed increases from multiple CPU cores.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mouse and keyboard functionality has been improved across a variety of menu screens, including the first time user screens, title menu, game menu, and workbench.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed collision issue where players could fall through elevators at low framerates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for a conversation-related crash when walking away from NPC characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for various, intermittent crashes. motion values, and not just the custom value and the default game speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "Denuvo DRM has been removed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can find more information on all of Star Wars Jedi: Survivor’s accessibility features here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch also incorporates some fixes for performance and stability across all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate the continued support you’ve given Star Wars Jedi: Survivor while we’ve been hard at work improving your experience. As always, let us know if you run into any additional issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
