  {
   "id": "star-wars-jedi-survivor@4",
   "gameId": "star-wars-jedi-survivor",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-05-10T13:59:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The latest patch (Patch 4) for Star Wars Jedi: Survivor has arrived.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the fixes you can expect with this patch",
     "items": [
      {
       "text": "Updated occlusion behavior for raytracing, reducing idle time stalls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated streaming budgets that will help alleviate traversal hitching.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Performance improvements for some VFX.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated data handling when toggling raytracing, improving non-raytraced performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various save state errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a streaming issue that causes some streaming scenarios to end on a black screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where one of the vents did not properly activate in Stone Spires.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Audio fix for a narrative moment where music was behaving incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed lightsaber marks not displaying correctly in some scenarios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a scenario where the player could enter a progression blocked state in the Lucrehulk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an elevator to prevent the player from falling through it and entering a progression blocked state.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Rayvis would become unbeatable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a severe animation issue that would break a late game narrative sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a collision bug where players can get stuck inside a Meditation Chamber.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a note explaining that some of BD-1’s abilities are not available while in combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved text scrolling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor text translation fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various crash fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "More work continues",
     "items": [
      {
       "text": "Additionally, here are a few known issues we’re currently investigating and working on for future patches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improving performance on newer i7 and i9 CPUs that have efficiency cores.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General performance improvements to improve both CPU and GPU utilization while reducing idle time, both with and without raytracing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improving some hitching which can be attributed to streaming raytracing data, assets, and a gap in our prebuilt shaders.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Be on the lookout for future patches, please let us know if you run into any further issues and thank you again for your continued support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
