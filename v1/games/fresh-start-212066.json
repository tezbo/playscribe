  {
   "id": "fresh-start-212066@patch-2025-01-28",
   "gameId": "fresh-start-212066",
   "displayName": "New small patch with few improvements and bug fixes",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-01-28T12:07:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, Cleaners!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve been working lately on polishing up your cleaning experience, and we’re excited to share the latest improvements in this patch! Your feedback has been very valuable, and we’ve addressed several key issues to ensure a smoother and more enjoyable journey across all maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Localization Fixes",
     "items": [
      {
       "text": "Fixed mismatched fonts in some localizations for a consistent and polished in-game text experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Completion Enhancements",
     "items": [
      {
       "text": "Improved the ability to achieve 100% completion on all maps—no more sneaky spots!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "UI Adjustments",
     "items": [
      {
       "text": "Fixed buttons being obscured during cutscenes, ensuring full accessibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Map Improvements",
     "items": [
      {
       "text": "Fixed the bridge on the Forest map for better navigation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted animal positions on the Forest map for a more natural and engaging environment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Corrected the placement of misplaced trash piles across maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Audio Upgrades",
     "items": [
      {
       "text": "Enhanced cat sound effects to make your furry companions more lifelike.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Building Enhancements",
     "items": [
      {
       "text": "Improved the appearance of tents during structure building for a more satisfying visual experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Material Fixes",
     "items": [
      {
       "text": "Fixed material issues in the Asian-themed scene for a more cohesive look.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Scanner Update",
     "items": [
      {
       "text": "Fixed scanner functionality on the African map to help you clean up with precision.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Plant Preservation",
     "items": [
      {
       "text": "Addressed disappearing plants to keep your green spaces thriving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Loading Bar Visibility",
     "items": [
      {
       "text": "Improved the visibility of loading bars for better progress tracking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you for your continued support and feedback—it’s what helps us make Fresh Start Cleaning Simulator even better!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy cleaning!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Fresh Start Team 🌱",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
