  {
   "id": "the-trolley-solution-345954@1.0.8",
   "gameId": "the-trolley-solution-345954",
   "displayName": "Hotfix 1.0.8",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-09-25T17:54:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve been paying close attention to all of your feedback. Over the past two weeks, I’ve uploaded lots of fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some of the bigger changes (multiple save slots, “no gore” mode, etc.) will take more time, but in the meantime, here are some of the fixes included in this new update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Grammar corrections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Character names flipped issue fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More time to achieve goals in some stages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lower win requirements in certain stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sped up some stages that dragged a bit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved stage descriptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Overall balance changes to make the game more fair.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues with the game’s connection to Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "—Dan y Peterson.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
