  {
   "id": "the-trolley-solution-345954@1.1.0",
   "gameId": "the-trolley-solution-345954",
   "displayName": "UPDATE 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-27T16:32:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Awesome news!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Trolley Solution now has Steam Trading Cards!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Note: This is not the same as the in-game TCG — an update for that will come later!....Eventually)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "But wait...There is more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "A few new features have been added",
     "items": [
      {
       "text": "Multiple Save Slots – That You can manage in the Options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "(The End Screen now shows decisions from your current playthrough instead of the first one made)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Borderless Window Mode",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "“Cartoon Violence” Toggle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Super Awesome Bell Action ™ 🔔",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "— Dan & Peterson",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
