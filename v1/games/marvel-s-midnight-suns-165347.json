  {
   "id": "marvel-s-midnight-suns-165347@major-2023-01-31",
   "gameId": "marvel-s-midnight-suns-165347",
   "displayName": "Follow-Up Update for Marvel's Midnight Suns",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-01-31T00:56:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new update for Marvel's Midnight Suns is now available on Windows PC. Please make sure to restart your game to ensure that you've downloaded the latest version and continue to submit any bug reports and feedback to support.2k.com.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you all for your patience while we worked to resolve some issues related to the Deadpool DLC, The Good, The Bad, and the Undead. Details include:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes issue where Deadpool did not appear after unlock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes Deadpool achievement unlock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusts Deadpool location in the Abbey during DLC quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Deadpool Legendary suite palettes are now available",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed subtitles overlapping on card text during Tactical view",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some animation fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
