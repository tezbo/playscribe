  {
   "id": "marvel-s-midnight-suns-165347@major-2023-01-27",
   "gameId": "marvel-s-midnight-suns-165347",
   "displayName": "January 2023 Update for Marvel's Midnight Suns",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-01-27T20:18:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new update for Marvel's Midnight Suns is now available on Windows PC. Please make sure to restart your game to ensure that you've downloaded the latest version and continue to submit any bug reports and feedback to support.2k.com.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Details include",
     "items": [
      {
       "text": "General",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General stability fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Steam Deck",
     "items": [
      {
       "text": "Steam Deck Virtual Keyboard fixes",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Steam/Deck/Link save fixes, including cloud syncing",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Steam Deck stability fixes",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "DLSS 3 Support for compatible GeForce RTX PCs",
     "items": [
      {
       "text": "Also available in Marvel's Midnight Suns today is NVIDIA DLSS 3. When playing on a GeForce RTX PC, you can enhance Marvel's Midnight Suns with NVIDIA DLSS Super Resolution and DLSS Frame Generation to significantly accelerate performance, giving yourself plenty of headroom to enable the realistic, immersive, ray-traced ambient occlusion effects and ray-traced reflections for the best-looking, best-performing gameplay experience possible.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
