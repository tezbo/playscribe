  {
   "id": "marvel-s-midnight-suns-165347@major-2023-05-11",
   "gameId": "marvel-s-midnight-suns-165347",
   "displayName": "Marvel's Midnight Suns May 2023 Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-11T17:04:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Please make sure to restart your game to ensure that you’ve downloaded the latest version and continue to submit any bug reports to support.2k.com.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "GENERAL",
     "items": [
      {
       "text": "Stability, performance, & load time improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Texture improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Global fix for missing & cut off voice overs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustments to level lighting to make shadows clearer so the characters don't appear to float",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "UI",
     "items": [
      {
       "text": "Added feature to individually select language for audio & subtitles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased font size for subtitles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "HEROES",
     "items": [
      {
       "text": "Doctor Strange: Agamotto’s Gaze will now properly apply the bonus card play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Morbius: Savage Swipe will now only trigger the Speed Kills achievement/trophy when the conditions for gaining Quick are satisfied",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Storm: Multiple fixes to Live Wire heroic ability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "QUALITY OF LIFE",
     "items": [
      {
       "text": "Added Game Difficulty dropdown to T.H.R.E.A.T. Room screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enemies recovering from being stunned now correctly indicate which hero they’re planning to attack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Color of saved HDR photos now correct when viewing them in gallery",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed reported issue where reentering Superlink would center the Gallery or Messages but focus the Timeline",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed reported issues caused by favoriting and deleting photos on both the standalone and Superlink gallery screens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Purchased hero suits can now be equipped when offline",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Charlie follow tutorial will now show the first time you tell Charlie to follow you",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Big Guns achievement/trophy will no longer count duped abilities as being different",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "GLOBAL COOLDOWN",
     "items": [
      {
       "text": "Added condition to prevent more than one enemy unit from forecasting Sacrifice ability per turn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed cooldown check to look at all units instead of just at self, to prevent Sacrifice ability being used in back-to-back turns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "STEAM DECK",
     "items": [
      {
       "text": "Texture and resolution improvements",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Setting deck-specific defaults in the video tab",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Stability fix for playing with everything turned up to Epic",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
