  {
   "id": "marvel-s-midnight-suns-165347@major-2023-06-08",
   "gameId": "marvel-s-midnight-suns-165347",
   "displayName": "Marvel's Midnight Suns June 2023 Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-08T16:00:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Please make sure to restart your game to ensure that you’ve downloaded the latest version and continue to submit any bug reports to support.2k.com.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GENERAL",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stability & performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mission cards can now be added to the hand even when there are the maximum number of cards present in the hand",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for Mission Rewards not showing on Victory Screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hero Deck screen now properly checks for new collar and suit passives",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Charlie's stats will now scale properly with the Hunter's Champion Level stat bonuses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Charlie navigation improvements for the Abbey",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"Upgrade ability\" objective during \"No Place Like Home\" mission now completes when any ability is upgraded",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for achievements / trophies not being rewarded as intended: HEROES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Venom Combos will now consume Ravenous: NEW GAME+",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed reported issue of Nest Mother and Summoning Circle missions not appearing during Act 1 of NG+ campaigns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Toggles have been added to customize the New Game+ experience and choose progression to carry over!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hero Abilities: Includes hero cards and abilities, including Hunter Collars and Passives",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Friendship Levels: Includes hero and team friendship levels and rewards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resources: Includes Credits, Essence, Blueprints, Intel, Gloss, and Arcane Knowledge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cosmetics: Includes unlocked cosmetics, with purchased cosmetics immediately available: STEAM DECK",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Steam Deck performance & stability improvements",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
