  {
   "id": "marvel-s-midnight-suns-165347@major-2022-12-10",
   "gameId": "marvel-s-midnight-suns-165347",
   "displayName": "An Update from the Dev Team - First Patch Now Available",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-10T00:57:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new update for Marvel's Midnight Suns is available on Windows PC. Please make sure to restart your game to ensure that you've downloaded the latest version and continue to submit any bug reports and feedback to support.2k.com. Details include:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "● Includes various bug fixes and adjustments to improve stability and performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Addresses the Hero Ops progression bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixes game crashes when attempting a manual save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixes Magik standing on the chair while speaking to her in Wanda’s Room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Combat",
     "items": [
      {
       "text": "● Capture Agent general missions will now grant 3 stars if they are completed in 3 turns (up from 2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed tracking for multi-detonate kills against Intel Challenges",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Non-damaging knockback attacks no longer trigger Lilin Guardian's Rage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Magik's \"Reinforcements\" ability will now Draw the proper card amount on Play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Heroes will now have \"Vulnerable\" for correct number of turns when a \"Moderate\" Injury is applied",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Nest Mother should now Summon Altars at the start of each mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Improved hitches during specific combat actions, like Vaulting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Photo Mode fixes",
     "items": [
      {
       "text": "● Ensure clothing settles when changing poses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "● Ghost Rider's flame head effects render correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "● Effects remain if Depth of Field is changed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
