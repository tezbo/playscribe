  {
   "id": "marvel-s-midnight-suns-165347@major-2022-12-02",
   "gameId": "marvel-s-midnight-suns-165347",
   "displayName": "An Update from the Dev Team",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-02T22:12:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The team is aware of and working toward a solution on some general performance and framerate issues that users may be experiencing. We are also investigating reports of issues with Cloud Saves. Finally, a note that we are not optimized for the Steam Deck at the moment.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you all for your patience while we work on these issues and hope to get you all an update as soon as we can.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
