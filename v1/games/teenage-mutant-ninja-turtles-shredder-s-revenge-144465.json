  {
   "id": "teenage-mutant-ninja-turtles-shredder-s-revenge-144465@hotfix-2023-01-24",
   "gameId": "teenage-mutant-ninja-turtles-shredder-s-revenge-144465",
   "displayName": "TMNT SHREDDER'S REVENGE - HOTFIX",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-01-24T15:05:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello heroes in a half-shell!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remember that small patch last week? Turns out it wasn't quite as perfect as we thought, so we had to fix it today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added missing characters in some languages' names",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the \"-\" that was being displayed incorrectly in the Japanese version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Yes, today's patch is extra small, but every bit helps to beat up the Foot Clan :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎵 Treat your ears right with TMNT Shredder's Revenge soundtrack composed by the one and only Tee Lopes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "💚Catch us on social media",
     "items": [
      {
       "text": "@TributeGames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "@Dotemu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
