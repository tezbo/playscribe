  {
   "id": "teenage-mutant-ninja-turtles-shredder-s-revenge-144465@patch-2023-10-24",
   "gameId": "teenage-mutant-ninja-turtles-shredder-s-revenge-144465",
   "displayName": "TMNT SHREDDER'S REVENGE - NEW PATCH AVAILABLE NOW",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-24T15:01:55.000Z",
   "notes": [
    {
     "title": "Features",
     "items": [
      {
       "text": "Added Chinese VO selection for Simplified Chinese and Traditional Chinese languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated game credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Players can now validate the \"Complete cast\" achievement even if they didn't buy the DLC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed client-side dive kicks not affecting Servibots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tentative fix for Paradox Shredder sometimes soft-locking when defeated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with player revival at the end of the Survival Super Shredder boss fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crashes in the Leaderboards menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tentative fixes & improvements in BinaryContentManager to catch rare errors users seem to have when launching the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an oversight with Karai's sliding kick hitboxes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Slightly increased range for the Super Dive Kick.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the two foot soldiers animated spawners using the wrong palette at the start of the elevator part of stage 7.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed taunts being interrupted by the \"Level Complete\" animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various SFX bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Disabled pausing during survival game over.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed double jump use while in Boss Mutation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tentative fixes on some random crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "___________________________________________________________________",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🎵 Treat your ears right with the TMNT: Shredder's Revenge official soundtrack:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🎶 And keep the party going with the TMNT: Shredder's Revenge - Dimension Shellshock official soundtrack:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🍕 Catch us on Twitter",
     "items": [
      {
       "text": "📷And on Instagram",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
