  {
   "id": "teenage-mutant-ninja-turtles-shredder-s-revenge-144465@patch-2022-11-07",
   "gameId": "teenage-mutant-ninja-turtles-shredder-s-revenge-144465",
   "displayName": "TMNT SR - NEW PATCH IS LIVE!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-11-07T14:28:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Cowabunga!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to community feedback, this new patch addresses various gameplay improvements as well as bug fixes to improve players' experience (solo and online).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Party Codes (ONLINE)",
     "items": [
      {
       "text": "You can now share Party Codes (five letters only) for easier matchmaking with friends who can now jump in via Join Party Code. Those are displayed at the bottom of the host's party panel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Online",
     "items": [
      {
       "text": "The difficulty is now displayed for each lobby when looking for online games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remapped the kick button to prevent misclick in the host's party panel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed displaying Xbox glyphs when playing with a PS5 controller and the Steam Input feature disabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Fixed long respawn delay after falling in holes in single-player mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Online",
     "items": [
      {
       "text": "Fixed rare issues with enemies becoming invincible when a player quits the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed client-side Chrome Dome sometime invincible when it shouldn't be",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Krang's torso not receiving any damage from clients, only the host",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed clients sometimes not unlocking a cameo that the host found",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed infinite online sign-in when Epic Launcher isn't installed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed keyboard custom key binding only taking into account the first local player",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
