  {
   "id": "teenage-mutant-ninja-turtles-shredder-s-revenge-144465@patch-2022-08-03",
   "gameId": "teenage-mutant-ninja-turtles-shredder-s-revenge-144465",
   "displayName": "TMNT SHREDDER'S REVENGE - GAME STABILITY PATCH IS NOW LIVE!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-08-03T14:07:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings pizza folks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we would like to thank you all for your feedback and love since TMNT Shredder's Revenge launch! Thanks to you and your detailed feedback, our dev team has been able to work on some game stability improvements and fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here is the detailed changelog, featuring the various fixes, improvements, and new features implemented to improve the game stability:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔧 BUG FIXES",
     "items": [
      {
       "text": "GAMEPLAY",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed enemies sometimes frozen after a Fling Slam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Rat King sometimes frozen after being defeated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Krang’s torso sometimes leaving the screen. You can sing it: “Krang-no-loooon-ger leeeeea-ving theeeeee-screen!”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Dirtbag sometimes stuck in its Blinding Flash attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some player attacks granting immunity to falling down holes, performed over a hold, resulted in a near-instantaneous KO for the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Dive Kick attack sometimes getting the player stuck when landing on edges.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "ONLINE",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed clients sometimes stuck in a cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed many connection issues at the beginning of stages that could result in desyncs and missing players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a few crashes caused by packet loss or lag, resulting in incomplete attack, player or camera data. Bodacious!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed clients ignoring enemy grab cancellation (when a player grabs for too long or an enemy is too healthy to grab).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed clients interrupting a Grab with a Super Attack, leaving enemies stuck in their Grab reaction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed client-side Chrome Dome sometimes not getting up when it should.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Groundchuck often not facing the right direction on clients (or sometimes not animating at all) when charging.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some replication issues in the Shredder fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Super Shredder and Rat King sometimes freezing on clients when the host leaves the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed client-side rat spawning in the Rat King fight often not occurring when it should.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed client-side Buzzer having a hard time doing U-turns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed client-side Motorcycle Foot Soldiers sometimes frozen on screen before attacking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed client-side Splinter's Super Flying Attack not increasing your Hit Counter and Score. He is a radical rat!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed online lag during boss fights sometimes breaking the boss’ behavior resulting in the fight getting impossible to finish (boss disappearing, for example).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed online game search no longer working after a failed search.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed connection issues occurring after the end game cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed host able to block the game by opening the Party Up menu while in a stage end cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "INPUT",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed saving customized controls only partially.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed using a keyboard with a layout other than QWERTY when customizing controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "MENUS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed saving the VSync value in the Options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a way to get the Pause menu stuck on the screen during gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "ACHIEVEMENTS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed resetting the progression of stat-based achievements like \"Complete Cast!\" when starting a New Game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Achievement unlock is now saved immediately. Achievement progression is now saved when leaving a stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "AUDIO",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed audio volume issues on stereo setups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "CREDITS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added some awesome people that worked on the game. Tubular!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Edwin’s name. Cowabunga, dude!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "PC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash when no audio hardware is found.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed sound playback when the game window is not in focus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "STEAM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed handling some access issues to the MyDocuments folder on Windows and falling back to AppData (Roaming) folder if necessary.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "✨ IMPROVEMENTS",
     "items": [
      {
       "text": "GAMEPLAY",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved performance by preloading all possible enemies to be used in a stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Dizzy players are no longer invincible. Bummer, dude!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In Story mode, doing Continue no longer loads up How To Play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "ONLINE",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved detecting all connected players as Ready, which would prevent entering a stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved transitions between the different parts of stage 6 (Crystal Palace Mall).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved bosses snapping to (sometimes bad) positions after client-side hits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Remote players now visually do their Double Jump and additional Somersault attacks. Wicked!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "MENUS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added platform icons when listing online games and friends.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "STEAM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved connecting to other Parties. Excellent!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🐢 NEW FEATURES",
     "items": [
      {
       "text": "ONLINE",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a message popup if kicked from a party. Sorry!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added netcode check popup on version mismatch. Friends don't let friends play un-patched.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "STEAM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added support for input glyphs specific to the Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Now showing the Steam Input binding menu when customizing controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
