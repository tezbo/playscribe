  {
   "id": "mighty-morphin-power-rangers-rita-s-rewind-305016@1.0.8",
   "gameId": "mighty-morphin-power-rangers-rita-s-rewind-305016",
   "displayName": "Update 1.0.8",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-17T00:47:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've heard suggestions from lots of players over the last few days, and we're happy to say we're rolling out refinements to Rita's Rewind to adjust various parts of the game based on that feedback. These changes are available on Steam now, but all players on other platforms will receive this update soon.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Note: Due to changes to the online system, online matches between older and newer versions of the game are incompatible. Both parties must have the update in order to play together successfully so please update right away.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brawler Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All Rangers now move faster (walk and dash speeds)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ranger grab and grab attack speed increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rangers can perform the Dodge move without any cooldown, but are only invulnerable for the initial frames of the animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In Easy mode, the Dodge move is always invulnerable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ranger can chain Rising Strike from many more states",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rangers can Dodge while holding an enemy to let go",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ranger Special is boosted slightly by successful Dodge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vertical attack collision for Time Disruptors is wider, making them easier to hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Time Disrupters are easier to destroy in Easy mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Food pick-ups are more spread out when spawning from containers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In Hard mode, enemies now have the same health as Normal but do twice the damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Speed Run clock is no longer affected by Time Disruptors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players can swap to any other NPC Ranger in the Juice Bar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localized juice bar dialog for the arcade machines is now correct",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Zord & Megazord Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All machine gun fire (bunkers, turrets and flying ships) now does less damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gravity is reduced when jumping to make pits easier to clear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Falling in a pit won't take away a life",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some pits now have additional ledges for landing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When multiple players are fighting a boss and some players reach a Game Over state, the difficulty (health and Zord damage dealt) scales accordingly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Harvester encounters have been balanced; laser speeds and laser damage are reduced at lower difficulties",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Megazord boss health has been reduced and damage dealt to bosses has been balanced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Health power-ups now spawn during Zord boss battles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Eye Guy's eye bombs do much less damage, and on lower difficulties, his bombs appear less frequently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "At higher difficulty levels, health coin benefits scale downward",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Online",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If both online players have unlocked Green Ranger, they have the option of starting their game from any level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "‍",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The indicator for skipping the intro video has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stability and performance improvements overall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
