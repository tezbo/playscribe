  {
   "id": "goodbye-volcano-high-134589@1.06",
   "gameId": "goodbye-volcano-high-134589",
   "displayName": "Patch 1.06",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-02-27T21:27:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The devs have been hard at work in the Goodbye Volcano High patch update mines, and we’re so excited to share it with you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All Platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed “A Different Kind of Album” achievement/trophy—old players who were previously bugged may need to get missing photos again to complete this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the ability to maintain photo progress across playthroughs—go to Settings and toggle on “All-Time Photo Collection” to activate this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced affinity requirements for seeing Trish’s final scene and unlocking her final photos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced affinity requirements for unlocking Reed’s final photo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated final lyrics writing minigame to work as it was originally meant to—player only chooses two lines to change, with the original two lines carrying over from previous lyrics writing minigame.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Battle of the Bands minigames overlapping if autoplay is toggled off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cleaned up compression artifacts on certain character’s faces (Ms. Roberts, Naser, Trish) when playing at resolutions under 4K.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added user icons to social media posts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed various camera placement and zoom issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various issues with VO getting cut off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various issues with Affinity icon not appearing when it should or appearing at the wrong time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rare issues with settings not applying correctly, reverting back to default, and having mismatched button states.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed “static” choice bubbles occasionally staying onscreen after being selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the episode 6 montage music not respecting master/music audio settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed subtitle colour setting not respecting LnL text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed VO toggle not affecting LnL character VO.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank y’all so much for your bug reports—we really appreciate your help! <3 If you have reports, send them our way at support [@] ko-op com 🌟",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PS: GVH is verified on Steam Deck for all your on-the-go queer dino needs! Happy gaming, y’all!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
