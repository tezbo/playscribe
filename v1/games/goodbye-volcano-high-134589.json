  {
   "id": "goodbye-volcano-high-134589@1.04",
   "gameId": "goodbye-volcano-high-134589",
   "displayName": "Patch 1.04",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-12T14:02:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, y'all!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The team's been hard at work squashing bugs, and we're happy to share that patch 1.04 is here! Thank you so much to everyone who shared their bug reports; we appreciate your work!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're also excited to announce that we'll be able to retroactively award trophies on PlayStation 5 beginning in our next patch! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "All Platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that would cause music minigame cameras to zoom in and out by extreme factors in system regions that don't use . as a decimal point",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused character animations to glitch when pausing the game, changing settings, or encountering a tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated UI in Photo and Flashback tutorials so that the text shows the correct button based on the player’s controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localized UI prompts during credits sequence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed backgrounds loading in blurred in episode 7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the settings menu loses its overlay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Reed and Trish t-posing in episode 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that allowed persistent audio to continue playing upon exiting to main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that prevented certain variables from saving correctly when reloading the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PlayStation 5 Only",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixed an error handling issue that could prevent trophies from unlocking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please feel free to send us any bug reports at support@ko-op.com! Thanks so much for playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
