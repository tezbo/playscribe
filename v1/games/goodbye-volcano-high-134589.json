  {
   "id": "goodbye-volcano-high-134589@1.036",
   "gameId": "goodbye-volcano-high-134589",
   "displayName": "Patch 1.036",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-07T16:20:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi, everyone!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.036 is here! This patch applies only to Steam, but will be available on all platforms in 1.04.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Only",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that would cause music minigame cameras to zoom in and out by extreme factors in system regions that don't use . as a decimal point (to be released on consoles in 1.04)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We’re aware of some PlayStation trophies not unlocking, and we hope to release a hotfix ASAP. We’ve also logged issues with animation glitches when pausing or changing settings, and we’re working to address them in our upcoming patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "In the meantime, please feel free to send us any bug reports at support@ko-op.com!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
