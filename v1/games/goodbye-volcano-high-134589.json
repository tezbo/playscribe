  {
   "id": "goodbye-volcano-high-134589@patch-2023-10-04",
   "gameId": "goodbye-volcano-high-134589",
   "displayName": "Patch Roundup",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-04T16:06:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "These past few weeks have been HUGE for improvements and bug squashing, so here’s a few updates that you might have missed!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many animation fixes and polish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that caused extreme zooming in and out during music minigames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved issues with some PlayStation trophies not unlocking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Updated the on-screen text and glyphs for Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug with text chat scrolling not returning to bottom when switching between text groups",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can read the full patch notes for our previous patches here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.03",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.036",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.04",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.05",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.055",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to send us bug reports at support ko-op.com! We really appreciate your hard work tracking bugs, and thank you all SO much for playing our game! <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
