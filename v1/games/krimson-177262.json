   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have two news today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "fixes",
     "items": [
      {
       "text": "Fixed the achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made some adjustments to collision boxes in level 424 and 212",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The \"Finish Circle X without dying\" Achievements have been reworked so now you can play each level of each circle separately and when you've done them all without dying, you'll get the achievement. You can see which levels you've finished without dying in the \"Player Info\" in the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Let me know if there are any issues with this update in the discord server",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Now to the other news",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "OST now available on BandCamp!",
     "items": [
      {
       "text": "As some of you mentioned, not everyone is comfortable with steam in regards to OST, so I published it on a more traditional music platform. Get it here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
