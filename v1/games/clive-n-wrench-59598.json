 "releases": [
  {
   "id": "clive-n-wrench-59598@1.1",
   "gameId": "clive-n-wrench-59598",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-14T15:13:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A big thanks to all of you that have played Clive 'N' Wrench thus far! It's been a blast seeing so many of you discovering the game for the first time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes include",
     "items": [
      {
       "text": "Fixed a bug that could cause Clive to get stuck in a ledge grab.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Re-enabled the erroneously disabled lighting in 'Cajun Mob Bog'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the speed of the camera's analog stick movement (with hope to add sliders in the future).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed some collision in 2D sections of 'Bluebeard's Gauntlet', that players could bump their heads on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed prop pop-in that could occur in The Chimp The Bag & The Bunny.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed flickering lights when too many were on screen at once in some areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added penguins holding \"duck\" signs to Droo the Ripper's boss fight to remind players of the move, and establish they can duck his scissor throws.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the ability to return to the main menu from the hub.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed misaligned images in the credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enabled v-sync, as uncapped frames were causing issues on higher end hardware (with hope to add a toggle in the future).: We will be continuing to address feedback with ongoing patches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
