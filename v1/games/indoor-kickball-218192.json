  {
   "id": "indoor-kickball-218192@1.1.2",
   "gameId": "indoor-kickball-218192",
   "displayName": "Update 1.1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-20T16:06:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 1.1.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Two BRAND NEW Bonus Levels! (Construction Site and Corner Store)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Increased ball gravity to make it less floaty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Increased after touch for the pitcher after they pitch the ball",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Decreased Season Mode games from 5 innings to 4 innings per game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added a button at the level select to indicate how to access bonus levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Minor bug fixes and performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Secret spots are a little bigger and a little more visible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Changed icon for character skin variation during character customization screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
