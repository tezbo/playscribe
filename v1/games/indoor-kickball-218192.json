   "announcedAt": "2023-06-07T14:21:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 0.7.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-added VFX to bases when baserunner is on the base to make it easier to tell if you are on or off the base",
