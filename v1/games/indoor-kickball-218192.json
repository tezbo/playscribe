       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-fixed issue with setting music to 0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-fixed issue with ball not counting as a catch if hit too hard and fast right to the pitcher",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-fixed issue with ball getting stuck in garden near 3rd base of backyard level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-fixed issue with bad pitch event occurring and the ball getting kicked at the same time",
