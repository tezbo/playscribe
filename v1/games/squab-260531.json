  {
   "id": "squab-260531@3",
   "gameId": "squab-260531",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-16T18:14:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 1.0.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It was discovered that at times using the dash and with the frame rate at 60fps, the character was able to climb on some platforms where he shouldn't, which completely eliminated the challenge of some levels, as it is not a feature that requires skill, I decided to make some changes to the mechanics and also added some thorns in some levels that it was possible to skip the whole challenge, in addition to slight changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Modified normal levels 8, 12, 15, 18, 34, 38, 44, 45, 52, 58",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Modified challenge levels 3,4.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the dash animation, when the character touches a wall or block, the animation takes a little longer to finish, giving better feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
