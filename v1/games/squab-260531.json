  {
   "id": "squab-260531@4",
   "gameId": "squab-260531",
   "displayName": "Update 4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-18T02:15:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 1.0.4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the bug where the hat was not released when you finished challenge mode before finishing adventure mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where the trampoline would fall on the character, locking it, now the trampoline crushes the character.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the spring collider to the size of the sprite, improving the mechanics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed the bug whereby after entering challenge mode, returning to the menu and entering level 2 onwards, the option to return to the stage selection screen did not appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced the fire collider when it's small.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reworked the song name sign, now an icon is shown and the text is positioned more to the left of the screen.: If you find any bugs in the game, let us know and we'll fix them as soon as possible.: Translated with DeepL.com (free version)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
