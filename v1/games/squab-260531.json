  {
   "id": "squab-260531@7",
   "gameId": "squab-260531",
   "displayName": "Update 7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-14T11:50:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 1.1.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Steam Cloud save support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added intro and ending cutscene.: Jumping thorn trap",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed the artwork, added animations always looking in the player's direction when on the ground.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the detection of the player's jump, correcting a small bug that occurred when the player jumped quickly and when the player fell.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added sound when the jumping thorn touches the inverter box.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the physics of the ball, now all collisions make it bounce, this way the player has more control and prediction of the ball's trajectory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed the ball freezing bug if you use dash and touch the ball.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added 3 variations of the song to the final screen of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Squab's father to the final screen.: Translated with DeepL.com (free version)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
