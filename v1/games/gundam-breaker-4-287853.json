  {
   "id": "gundam-breaker-4-287853@major-2024-10-09",
   "gameId": "gundam-breaker-4-287853",
   "displayName": "【Details of new game update】",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-09T02:27:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update data to add new Mobile Suits, improve stability of gameplay, and fix some issues are now deployed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please apply the latest patch and enjoy GB4!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "●Major Updates",
     "items": [
      {
       "text": "The following Mobile Suits have been added to the in-game store:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Mighty Strike Freedom Gundam",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Gundam Calibarn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Gundam Calibarn [Permet Score Five]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "●Issues that are fixed",
     "items": [
      {
       "text": "・The notification for unlocking the functions of diorama mode and custom pose displayed every time a mission was cleared",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・The booster effect does not disappear in the multi-lobby",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Certain backpacks do not display properly when using master skills.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Some backpacks are not changeable when equipped the “Melee” weapon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・When viewing other players' Gunpla, the rotation operation of it spins at too high a speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Installation-type skills such as “Mine” and “Dummy Shell” do not generate damage against giant bosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Upper body does not rotate when performing the spinning and shooting motion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・When changing the size of leg parts, the attack criteria changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Burst action “Full Burst” keeps activating even after the skill ends.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "●Adjustment of Game Balance",
     "items": [
      {
       "text": "・The attack frequency rate of funnel skills has been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "・Adjusted the speed of firing of some machine gun category weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "・Reduced the damage of continuous thrust attacks with maces and other weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "・Increased the damage of the “Legilis Cannon” skill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Application of this update is required for online play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "We will continue to make improvements to “Gundam Breaker 4”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
