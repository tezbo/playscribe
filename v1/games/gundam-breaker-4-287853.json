  {
   "id": "gundam-breaker-4-287853@major-2024-12-19",
   "gameId": "gundam-breaker-4-287853",
   "displayName": "Notice of New Game Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-19T02:00:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The latest patch for Gundam Breaker 4 is ready to deploy! This update aims to improve gameplay and fix some outstanding bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Major Updates fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusting the Long-Range Weapon and Long-Range Skill",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased attack power and ammo for most Long-Range Weapon and Long-Range Skill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "・Adjustments to the “Greatsword” weapon category",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ground Break with Greatsword is now possible, and the parts have increased drop rate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Equip Pair Function on Builders' Parts has been improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When eqipping Builder's Parts in pairs, it is now possible to equip them even if there is no empty slot for both parts (but one of the slots must be empty).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Add a function to send diorama works to the Diorama Monitor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a function to switch diorama works displayed on the monitor in the lobby.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Added a function to paste labels on the Results Screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A label pasting function has been added to parts and weapons acquired on the Results Screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Installing update is required for all online play. More updates are still to come for Gundam Breaker 4!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
