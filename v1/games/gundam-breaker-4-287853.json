  {
   "id": "gundam-breaker-4-287853@major-2024-11-28",
   "gameId": "gundam-breaker-4-287853",
   "displayName": "Notice of New Game Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-28T02:01:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The latest patch for Gundam Breaker 4 is ready to deploy! This update aims to improve gameplay and fix some outstanding bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Issue fixed with the Diorama Pack 4 – Beach Set & Effect where 7 out of the 20 effects were unavailable, allowing you to now obtain the 7 types of effect sets (such as Ballistic Ammo/Muzzle Flash).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have already purchased the DLC 4, apply the update and then launch the game. You will be able to see the dialog announcing the purchase of Diorama DLC 4 again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Major Updates fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fix claw combo attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fix weapon skill “Bazooka ” when equipped to the left arm.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fix weapon skill “Katana”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fix GN Particles to appear correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fix distorted visual of the Mobile Suit when using certain skills or weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Correct sorting of Ability Cartridges.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Correct firing ray of OP skill “5-Barrel Finger Vulcan” shifting upwards under specific conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fix a bug that prevented offline players from receiving event rewards after coming back online. (To receive event rewards, you must be online before the deadline.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Installing update is required for all online play. More updates to come for Gundam Breaker 4.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
