  {
   "id": "gundam-breaker-4-287853@major-2024-09-20",
   "gameId": "gundam-breaker-4-287853",
   "displayName": "Notice of Update Data Distribution",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-20T02:00:49.000Z",
   "notes": [
    {
     "title": "【Date of Update Data Ver. 1.04 Distribution】",
     "items": [
      {
       "text": "September 20, 2024 (Friday)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released an update patch to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The details of the update are as follows",
     "items": [
      {
       "text": "【Issues】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue that caused a crash when activating Master Skills with certain head and body integrated parts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue that prevented some modes to be unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update (Ver. 1.04) must be applied to use online play mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
