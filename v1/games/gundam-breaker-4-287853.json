  {
   "id": "gundam-breaker-4-287853@major-2025-01-30",
   "gameId": "gundam-breaker-4-287853",
   "displayName": "Notice of New Game Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-30T02:16:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The latest patch for Gundam Breaker 4 is ready to deploy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update focuses on enhancing gameplay and addressing various bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Major Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "【Add Builders' Parts and Diorama Object】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added more Builders' Parts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added more Diorama Object (MA)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "【Game Stability Adjustments】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjustment on Big Boss battle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Reduce the frequency of jump attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added a down effect upon damage accumulation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added increased damage when attacking a downed boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "【System Added】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a function to automatically sell parts on the Results Screen to improve parts management",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a function to equip parts of the same units together on the Assemble Screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Installing update is required for all online play. More updates are still to come for Gundam Breaker 4!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
