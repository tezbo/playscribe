 "releases": [
  {
   "id": "rhythm-sprout-186297@post-2023-02-22",
   "gameId": "rhythm-sprout-186297",
   "displayName": "Patch Notes - Feb 22nd",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-02-22T13:59:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update focuses mostly on a small rebalancing of the Target Scores. The change is relatively minor, but should help a lot of you achieve the Target Scores with less frustration. You will still need to learn each level properly and be precise in your gameplay, but the new targets will allow for slightly more mistakes overall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let us know what you think of the change!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NOTE: If you've already achieved the updated Target Score for a level on a previous run, you will need to play through it again to get the Star.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Specifics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The second Target Score is adjusted by a set percentage for all levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The third Target Score is adjusted for all levels depending on the level's length (shorter levels get a very smaller change, and longer levels get a bigger change)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed typos and text going outside of textboxes in German, Norwegian and Russian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
