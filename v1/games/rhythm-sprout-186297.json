   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "ADDED FEATURES & FIXES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added 4k resolution in Video Settings (this setting can also look better on 1440p screens)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix for Platinum Record achievement (if you've done all the other achievements, this should trigger for you when pressing Continue and entering the Main Menu)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Mrs Chili on Turbo (wouldn't change phases correctly)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the size of the HP bar started off as the wrong size on phase 3 of Candy Mama and Mrs Chili",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed position of Continue/Retry buttons at end of Candy Lane",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Textbox size adjustment, FRENCH: THE PARADISE - *Que dirais-tu d'une petite visite ?*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Textbox size adjustment, FRENCH: THE PARADISE - *Et ça fait un bien fou !*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Textbox size adjustment, FRENCH: THE PARADISE - *Le sport, c'est excellent pour la santé !*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Textbox size adjustment, FRENCH: THE TRAGIC BACKSTORY - *Et me considérait comme son roi !*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Typo, NORWEGIAN: Skin Description for one of the skins",
       "ps5ProOnly": false,
