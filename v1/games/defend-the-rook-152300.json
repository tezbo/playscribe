  {
   "id": "defend-the-rook-152300@major-2021-12-14",
   "gameId": "defend-the-rook-152300",
   "displayName": "Experienced Mode update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-12-14T18:27:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many of you asked us to add more challenge to Defend the Rook, so we've been working on the Experienced Mode - available now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When you next start a run you will be asked to turn on this mode. It will change all the battles difficulty and adjust the shops and drop rates of abilities to provide more challenge for experienced players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can turn this mode on or off at your choosing in the Ascension menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you will enjoy this new feature and can't wait for your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
