 "releases": [
  {
   "id": "defend-the-rook-152300@1.20",
   "gameId": "defend-the-rook-152300",
   "displayName": "Update 1.20",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-29T08:47:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update 1.20 brings a substantial round of fixes to Defend the Rook, covering combat interactions, enemy abilities, save/load reliability, achievements, translations and the interface. We’ve also upgraded the game to Unity 6.3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "These improvements apply to both the full game and the demo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Combat and ability interactions",
     "items": [
      {
       "text": "Enemy special attacks and volleys now trigger the appropriate attack reactions, including counters and follow-up attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stunned enemies no longer perform delayed attacks that should have been prevented by the stun.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Area attacks now hit each enemy once, including enemies occupying multiple tiles. Precise Shot also counts each victim once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Redirected damage now preserves the original attacker’s credit and whether the attack ignores Armor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Attacks correctly recheck their aimed tiles when Take the Hit moves a unit. Later shots no longer follow that unit outside the original attack area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Units killed by counters or other reactions can no longer continue moving, attacking or summoning afterward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Damage-triggered augments now activate once per positive hit, rather than activating from attack events that caused no damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quick Reflexes is no longer consumed by zero-damage hits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Followup’s extra attack remains consistent after previews, other heroes’ kills and loading a saved battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Energise and Point Blank now work together regardless of which upgrade was acquired first.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Utility movement now receives its advertised two-tile movement budget.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Utility summons now appear near their summoner.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Forced friendly attacks correctly trigger Utility counters and follow-up reactions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Defense Augment now restores its advertised 10 Health at the end of the turn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Defense Augment’s lethal-hit protection now works against armor-piercing damage and no longer applies negative healing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected Witch extra-hit targeting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Shadow clones of Possessed Souls no longer incorrectly revive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Traps, towers and battle progression",
     "items": [
      {
       "text": "Trap effects now remain attached to the unit that triggered them, even when movement or another reaction changes the trap tile’s occupant.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cling Trap now activates its on-trigger upgrades before being consumed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shadowmaze now creates its replacement trap where the enemy died, including kills caused by Proximity Mines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed enemies remaining greyed out after mine interactions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Sniper Tower now attacks from its stated minimum range: 5–8 tiles, rather than 6–8.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Emerald and Splitter Towers now fire after start-of-turn buffs, consistent with other towers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Waves can no longer be marked as cleared while enemies are still spawning, preventing skipped waves and bosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Coral barricades no longer prevent the final boss wave from arriving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed enemies remaining on the board after a boss’s flee effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Wave-clear rewards are now awarded correctly and only once per wave, including split waves and early waves on higher Ascensions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed missing or duplicated upgrade choices around split waves, including the Desert battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enemy spawns now check their entire footprint against occupied and blocked tiles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Multiple enemies summoned together now reserve valid spaces, preventing overlapping spawns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Freed heroes are placed on a valid nearby tile rather than overlapping another unit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Enemy and boss fixes",
     "items": [
      {
       "text": "Both Ballistas now use the Destroyer behaviour stated in their descriptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dire Wolf’s aura now affects the intended wolves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Elven Mage now grants temporary Armor rather than Power.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Anemone Leech now destroys itself after lethal attacks too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Suction Cupper now restricts its pulls to heroes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Necromancer’s Elusive behaviour now matches its keyword.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hysteria can now force Sacred Gem to attack allies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Geometric cannon movement now considers future firing lines, matching its Hunter behaviour.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bombardment Cannon’s damage now matches its displayed attack line.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Vampiric Sorcerer’s warning now includes the centre of its impact area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Perching enemies now display their full attack threat from the destination.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enemies immune to Stun no longer incorrectly appear to be effectively stunned.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Coralled Cager no longer swallows a hero that its attack has already killed, preventing heroes returning alive at 0 Health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected the Hydra’s limits for each head type.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed duplicate demon spawning on Ascension 8.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ascension Gem Spectre now performs its recurring summons correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ascension Cleric now summons worshippers at the stated turn boundary.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Immortal Commander now revives with half of its modified maximum Health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Commander’s Arrow Shower now activates when it reaches exactly 175 Health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ascension Commander’s pulls now place units adjacent to the attacked target.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ascension Valter now receives the correct bonuses when statues die, including Arkosh’s Range bonus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected Valter’s description to show five normal statues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ascension Fungal Rook now selects random, non-repeating attack patterns consistently with its description and warning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Jezebel’s attack areas now exclude herself and her allies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Jezebel’s proximity checks and slam areas now follow her current position after displacement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Final-boss volleys now respect their original aimed tiles when reactions move a defender.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enemy thieves now return only the gold they actually stole, separately from their normal defeat reward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Preserved the wealthy tutorial Orc’s identity and reward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Saving, loading and previews",
     "items": [
      {
       "text": "Fixed Continue duplicating loot-history events, which could grow saves dramatically and eventually cause End Turn failures. Existing duplicate entries are removed when loading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Combat random choices now remain consistent through previews and Continue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boss intentions, AI state and thief flee behaviour now restore correctly and remain reversible during previews.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected restoration of enemy-owned traps, Ascension modifiers, blocked-tile effects and pending loot choices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Replacement attacks now retain their source and behaviour after loading, including attack availability, Range and kill credit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed incorrect Power bonuses after Continue, including the Sap Strength interaction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Kill-based bonuses and achievement checks now handle earlier spell-caused deaths correctly after Continue, without errors interrupting later valid kill credit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved restoration of damage attribution, revival charges, augment effects and trap consumption.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved save writing, backups and recovery when a save file is locked or cannot be replaced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reset Game now clears recovery files too, preventing deleted progress from being restored accidentally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save & Quit now warns when leaving will discard the current turn’s actions or restart a battle that has not yet been saved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Achievements",
     "items": [
      {
       "text": "Not Even Close now correctly counts heroes already lost in earlier battles. Shadow clones no longer count as the original hero being alive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an error in A Peaceful Place when an attacker dies during its own attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The speedrun achievement now measures 20 minutes of active run time. Time spent paused, in menus or with the game closed no longer counts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected kill-credit handling used by kill-based achievements after loading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Interface, graphics and settings",
     "items": [
      {
       "text": "Restored the blurred background behind menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed pink/magenta dissolve effects on hero upgrades, shop items, spell icons and the meta-upgrade book.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hero portraits now keep their positions when clones or summons appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a VSync setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved resolution matching and application of the selected refresh rate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the mouse cursor being hidden incorrectly when virtual joystick devices are detected.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "End Turn reminders now ignore units that cannot move or attack and should not require attention.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an updated spike-trap icon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the optional -run-in-background launch option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ensured developer controls are disabled in release builds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed missing-script issues and several errors that could interrupt combat or loading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Text and localization",
     "items": [
      {
       "text": "Made translation corrections across all supported languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected outdated values, inaccurate mechanics, missing placeholders and empty entries.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Clarified descriptions for Truly Gifted, Proximity Mines, Temporary, Extra Juice, Vengeance Cast, Hero Essence, Banshee souls and Advantage Fighter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clarified that Stone Form’s Armor lasts through the enemy turn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected Start Up’s description to state +1 Damage Radius.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed unresolved placeholders in the Leave and Radius glossary entries.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected Destroyer and Chain Lightning wording.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Shortened overflowing Russian interface labels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added fallback fonts for missing characters in localized UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved localized text lookup and caching.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We’ve also expanded our automated checks for attack previews, save/load consistency, spawning and battle state to help catch future regressions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing Defend the Rook and for reporting the issues that helped shape this update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
