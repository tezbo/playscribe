  {
   "id": "defend-the-rook-152300@1.17",
   "gameId": "defend-the-rook-152300",
   "displayName": "Update 1.17",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-12-08T04:55:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed Achievement: Not even close",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Achievement: Spellslinger",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crossbow training overrides Earthquake strike",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ranger-Danger attacks gem cannon, it survives, thus Ranger gets additional attack. Wizzy finishes said cannon (for the defeat buff), and now Ranger is still lit but unable to attack since cannon is gone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The precise shot talent doesn't seem to trigger",
