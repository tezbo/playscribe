   "gameId": "judgment-281562",
   "displayName": "Minimum Requirements Update (Windows 10 Users)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-01-25T18:09:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Judgment fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve recently updated the minimum requirements for this title with additional information for Windows 10 users.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The following versions of Windows 10 are now required in order to play:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Judgment - Windows 10 1703 (OS Build 15063) or Later",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
