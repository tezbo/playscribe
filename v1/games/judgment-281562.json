  {
   "id": "judgment-281562@post-2022-12-20",
   "gameId": "judgment-281562",
   "displayName": "New Graphics Options and Bug Fixes!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-12-20T03:25:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello RGG fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've got updates and several fixes with this patch, please see our patch notes below. Please continue to post any issues you encounter here. Thank you for playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DLSS support is now fully supported for Judgment!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• NVIDIA DLSS , NVIDIA DLSS Sharpness are now available under Graphic Settings > Detailed Settings",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• NVIDIA DLAA been added under Graphic Settings > Detailed Settings",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The following settings have been changed for first boot on SteamDeck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• FSR is now off and FSR2.1 is now active",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• FPS is now 60",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other fixes",
     "items": [
      {
       "text": "When playing darts outside of a 16:9 aspect ratio, the miniscreen in the bottom left changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
