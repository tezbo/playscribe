  {
   "id": "judgment-281562@1.01",
   "gameId": "judgment-281562",
   "displayName": "Patch 1.01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-09-22T03:00:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Judgment players! We are rolling out patch 1.01 today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for reporting your issues. This update addresses various fixes and adds a graphic setting. Here is a comprehensive list of fixes made:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a crash issue when booting the game while E-Core on Intel 12th generation Core series is set to OFF.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the saving function for \"Geometry quality\" within the graphic setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved performance stability during high frame rates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "AMD FSR 2.1 adoption and improvement of drawing quality.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue during the Friend event with Ryan Acosta that prevented the drone from ascending when playing at high frame rates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that prevented blackjack and poker from progressing at high frame rates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please continue to post issues you encounter here for us to investigate and have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
