   "displayName": "Patch Notes for 12/2",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-12-10T23:50:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "PATCH HIGHLIGHTS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Surprises? Secret stuff? Who knows…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "CHANGES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added haptic feedback to the dart gun and fazerblaster in the HUB",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added collision to all HUB Gallery models",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "BUG FIXES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a First Aid: Lefty issue where hitting Helpy’s leg with the hammer multiple times during the Reflex Check condition cures him of all illnesses…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a First Aid: Scrap Baby issue where grabbing the back-left vaccine bottle kidnaps the player’s hand to an unknown position",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a First Aid: Scrap Baby issue where various items in the bag could permanently de-spawn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a global issue where pausing just before a jump scare causes the player to become stuck on the pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a Sister Location: Puppet Master issue where Minireenas did not produce SFX when picked up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
