  {
   "id": "die-again-133340@1.1",
   "gameId": "die-again-133340",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-24T14:31:01.000Z",
   "notes": [
    {
     "title": "Great news! 🙌",
     "items": [
      {
       "text": "The first regular update has arrived to the game, here are the patch notes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixing",
     "items": [
      {
       "text": "Fixed an annoying bug that allowed overlapping of infinite pause menus when in Interludes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that broke the character in the Level Selection, depending on the order when equipping certain skins. Now they are displayed correctly regardless of the order.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that didn't start animations when entering levels with certain skins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "Level 9_4 has more enemies and less Snipers, to make it more interesting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Quality Improvements",
     "items": [
      {
       "text": "Updated pre-text when entering levels to show less text and better display of information",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated Japanese font to support all characters of this language",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Text informing of the extra levels is displayed upon completion of the main story. This only happens once",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Smoothed the explosion of the Level 9 Interlude and added vibration with controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The equipped skin is focused when entering the Change Avatar with a controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Remember to update the game to get all the improvements. This update will arrive at a later date for all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Join the community",
     "items": [
