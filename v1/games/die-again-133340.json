  {
   "id": "die-again-133340@patch-2024-04-12",
   "gameId": "die-again-133340",
   "displayName": "Small patch: Fixed a couple bugs from some specifics possession",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-04-12T13:23:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "First small patch,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have fixed a couple of bugs that broke the game if a particular type of enemy died in the player's range and the player was in the body of an specific enemy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The previous result was that the game over screen did not appear, not allowing to restart the level and \"freezing\" the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now the game over screen appears correctly and the player can respawn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Although it is not necessary, we recommend upgrading to this latest version to avoid this annoying error",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This bug fix will arrive on all console version of the game on a later date",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
