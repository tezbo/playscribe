   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-02-24T09:30:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue where movable tables would disappear if loading an existing save file in the lastest patch. Players playing on new saves in the new patch were not affected. Affected players can keep playing on their saves after this hotfix and the tables should have returned to their proper places",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
