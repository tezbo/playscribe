      {
       "text": "Fixed a rare issue where you could be detected in Chapter 3 when hiding under the table.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where you could be detected when hiding behind a box in Chapter 9",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
