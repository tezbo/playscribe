  {
   "id": "out-of-sight-312565@hotfix-2025-05-24",
   "gameId": "out-of-sight-312565",
   "displayName": "Hotfix May 24th",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-05-24T16:32:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue caused by the previous hotfix where Lost & Found collectibles would not grant achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Any collectibles affected by this bug will now automatically grant their respective achievement when opening the Lost & Found page on a save where they have been collected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue caused by the previous hotfix where the \"Lucille's Blanket\" collectible did not show up in the Lost & Found list after being collected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
