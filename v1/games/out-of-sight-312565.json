  {
   "id": "out-of-sight-312565@major-2025-06-19",
   "gameId": "out-of-sight-312565",
   "displayName": "Out of Sight update: Guiding indicator option and demo fix!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-19T09:06:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have been making some updates for Out of Sight!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We heard your wishes and have added an option to turn off the guiding indicators (in the form of yellow tape and other visual indicators that point the way forward) along with some other fixes. This makes it possible for all you players to explore the game unguided if you wish!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have also updated our demo with some visual fixes to make it even more enjoyable to try! Last but not least, we fixed the missing translations in the settings menu and the auto-save popup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Celebrate Out of Sight´s one-month anniversary with us by joining Sophie and Teddy on their adventure!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
