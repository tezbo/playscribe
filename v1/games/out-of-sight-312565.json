  {
   "id": "out-of-sight-312565@1.0.44",
   "gameId": "out-of-sight-312565",
   "displayName": "Patch 1.0.44",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-16T09:00:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Slower systems that cannot stream in new areas of the game fast enough will now pause to finish loading the area before allowing you to enter. This fixes an issue where key elements like locked doors or switches could be missing until they finished loading. Or you falling through missing floor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a rare issue where Clayton could get stuck in the Chapter 3 workshop room due to the door closing before he was able to exit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in Chapter 7 pipe-ceiling-room where you could get stuck if you moved up the pipes without Teddy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Teddy was very difficult to pick back up in some locations (notably on movable boxes).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the \"YoYo\" collectible where you could pick up both the collectible and Teddy at the same time, making you stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made inverted horizontal/vertical look work on mouse as well (previously only worked on controller)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Other minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
