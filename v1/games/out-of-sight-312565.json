  {
   "id": "out-of-sight-312565@1.1.103",
   "gameId": "out-of-sight-312565",
   "displayName": "Patch 1.1.103",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-11-09T09:24:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Improved level loading system to fix rare issues where characters would fail to appear or triggers would fail to happen (resulting in e.g. unintentionally closed doors).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue in the DLC where reloading a specific checkpoint in Act 2 would block progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some lighting issues in Chapter 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where master volume setting would reset if you died.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
