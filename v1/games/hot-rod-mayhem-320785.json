  {
   "id": "hot-rod-mayhem-320785@major-2026-10-09",
   "gameId": "hot-rod-mayhem-320785",
   "displayName": "Online Multiplayer Update — Race with up to 8 players!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-09T15:11:50.000Z",
   "notes": [
    {
     "title": "The mayhem goes online!",
     "items": [
      {
       "text": "Your next rival no longer has to be sitting beside you. The Online Multiplayer Update brings Hot Rod Mayhem’s wild racing to private online rooms for up to 8 players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "More friends. More mayhem.",
     "items": [
      {
       "text": "Up to 8 players online — gather your group and race from your own devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Private rooms with a room code — create a room and share the code with your friends.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Races, trials, and championships — take on the tracks and challenges together as a group.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "How to get on the grid",
     "items": [
      {
       "text": "Update Hot Rod Mayhem in your Steam library and launch the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Open the Online menu and create a room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Share the room code with your friends so they can join.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Once everyone is ready, choose your next race, trial, or championship and let the mayhem begin!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Online play supports one player per device and requires an internet connection. Every player needs their own copy of Hot Rod Mayhem. Local split-screen for up to 4 players remains available as a separate mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for racing with us and helping Hot Rod Mayhem grow. Grab your friends, pick your hot rods, and we’ll see you on the starting grid!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "— The Casual Brothers team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
