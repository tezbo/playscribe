  {
   "id": "hot-rod-mayhem-320785@major-2026-11-10",
   "gameId": "hot-rod-mayhem-320785",
   "displayName": "Hot Rod Mayhem Update and New Permanent Price",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-11-10T10:32:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The latest Hot Rod Mayhem update is live on Steam! Gather your crew, share a room code and get back on the grid.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "What’s new in this update",
     "items": [
      {
       "text": "Online hosts control the pace. The host can retry a trial or advance past results and championship standings when the group is ready. Trial retries restart the challenge together and preserve championship progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Clearer racing action. Driver name tags are easier to read up close and fade at a distance. Duck and alien trials now show the correct projectiles to other players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Track and camera fixes. We fixed the starting setup for mirrored races on Eastern Express and improved the finish camera so it stays above the track.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New permanent price",
     "items": [
      {
       "text": "We’ve permanently lowered the base price of Hot Rod Mayhem on Steam. Check the store page for the new price in your region.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thanks for racing with us. See you on the starting grid!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "— Casual Brothers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
