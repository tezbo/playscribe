   "id": "hot-rod-mayhem-320785@major-2025-09-30",
   "gameId": "hot-rod-mayhem-320785",
   "displayName": "Trials Mode Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-30T16:26:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Get ready, racers! Our Trials Mode just got tougher with a polished difficulty level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update cranks up the challenge, pushing your reflexes and racing skills to the max. Expect faster action, wilder obstacles, and non-stop chaos as you battle to claim victory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Think you’ve mastered Hot Rod Mayhem? Time to prove it. Strap in, hit the throttle, and take on the ultimate test of speed and skill!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you on the track 🏎️💨 Run into bugs or have feedback? Head to our Discord and let us know!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
