  {
   "id": "tenebris-pictura-257055@major-2023-10-13",
   "gameId": "tenebris-pictura-257055",
   "displayName": "Update notes for Oct 13",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-13T11:27:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This is a slightly agressive patch improving a few areas according to your feedback. We hope you enjoy all the changes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased player speed (both running and pushing objects) around 20%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased reaction speed to controls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Now you can brake during jump.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now when you die in any combat the room restarts with all the objects as you left them. When choosing \"restart checkpoint\", the room is fully restarted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now the magical barriers block enemy bullets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buffed player blows: they have more range and they always interrupt the attacks of the basic enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Remapped several rooms at the start of the game, River Island, Misty Forest, Dock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tuned several areas reducing large spaces and removing invisible walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added painterly visual effects to the pause menu and fade-outs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed crash when you have certain combination of paintings in the inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Multiple minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
