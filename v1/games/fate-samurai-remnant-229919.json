  {
   "id": "fate-samurai-remnant-229919@1.3.0",
   "gameId": "fate-samurai-remnant-229919",
   "displayName": "Update 1.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-20T01:40:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added compatibility with the Additional Episode 3 \"Record's Fragment: Bailong and the Crimson Demon\" featured in the Season Pass.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new Mounting effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Showdown: Red Cliff Calamity\" to Battle Recollections unlocked after clearing Chapter 3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Showdown: Shades of Violence\" to Battle Recollections unlocked after clearing Chapter 5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Showdown: Ghoulish Parade\" to Battle Recollections unlocked during second playthrough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Showdown: Oil and Water\" unlocked after clearing \"'Reminiscence: Supreme King\" to Battle Recollections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue with chapter titles not displaying correctly under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the game to stop responding when a certain condition was met.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other bug fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
