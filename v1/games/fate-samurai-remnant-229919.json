  {
   "id": "fate-samurai-remnant-229919@1.2.0",
   "gameId": "fate-samurai-remnant-229919",
   "displayName": "Update 1.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-18T01:27:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added compatibility with the Additional Episode 2 \"Record's Fragment: Yagyu Sword Chronicles\" featured in the Season Pass.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can now show unread items only in the Logbook.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now display related entries in the Logbook.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now view the completion rate for each category in the Logbook.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new Mounting effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can now discard Mountings while out exploring.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now check whether you have completed a Digression by referring to the corresponding icon on the Edo Map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added \"Showdown: Fencing Fracas\" and \"Showdown: Ogre and Warrior\" to Battle Recollections unlocked after clearing Chapter 5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can now acquire skills by automatically consuming Skill Jewels when you do not have enough skill points.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that caused the game to stop responding when a certain condition was met.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other bug fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
