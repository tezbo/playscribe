  {
   "id": "gecko-gods-151312@major-2025-03-07",
   "gameId": "gecko-gods-151312",
   "displayName": "The Gecko Gods - Development Update 🦎",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-07T14:27:11.000Z",
   "notes": [
    {
     "title": "Hello Geckos!",
     "items": [
      {
       "text": "I want to thank you all for your patience and support throughout development. We know things have been quiet on our end, rest assured, we’ve been working hard behind the scenes to craft a game we’re truly proud of, and we hope you will love, even if it has taken longer than we originally planned",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have secured some additional funding and brought on two experienced developers to help us get the game over the finish line",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I would like to thank everyone who has shown so much love and support for our project. We have some exciting announcements coming in the next few months, so stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We look forward to bringing you The Gecko Gods later this year",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
