  {
   "id": "gecko-gods-151312@major-2026-06-25",
   "gameId": "gecko-gods-151312",
   "displayName": "Forgotten Cove Free Update Now Live!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-25T17:00:16.000Z",
   "notes": [
    {
     "title": "Gather round, Geckos! 🦎",
     "items": [
      {
       "text": "Return to the Archipelago to explore the Forgotten Cove Update, featuring new Islands, Insects, Relics, puzzles and more…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/38955380/9d185e193e5b061580657ec19516dfab5fcd59c6.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Forgotten Cove is an exciting and completely free update to Gecko Gods, and it’s available now. So update to the latest version of the game and set off on new adventures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Forgotten Cove Island",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Two new Tiny Islands, Aquaduct and Waterfall Cavern",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Relics and Insects to discover",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "4 rare gecko skins, including Spirit, Ice, Ghost and Heart",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Read the full patch notes here]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gecko Gods is also now available on Nintendo Switch 2! If you already own the game on Switch, you’ll be able to upgrade to the enhanced “deluxe” edition of Gecko Gods free of charge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/38955380/bfd9793a21e4c0165e68455bb2af26c49eda1d78.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To celebrate this update, the game, soundtrack and Deluxe Edition are discounted till July 9th as part of the Steam Summer Sale.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/38955380/edebb7f4110df0e7f66c0787baf1238849ca7f96.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are also giving you the chance to win Nintendo Switch 2 keys on Discord, X, and TikTok, so be sure to join our communities there.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Till next time,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Gecko Gods team 💚: [dynamiclink href=\"https://store.steampowered.com/app/1290760/Gecko_Gods/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
