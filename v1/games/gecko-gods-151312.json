  {
   "id": "gecko-gods-151312@major-2026-06-18",
   "gameId": "gecko-gods-151312",
   "displayName": "Forgotten Cove [UPDATE]",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-18T17:30:23.000Z",
   "notes": [
    {
     "title": "Gather round, Geckos!🦎",
     "items": [
      {
       "text": "Introducing Forgotten Cove, a free update to Gecko Gods bringing brand-new content, including islands, relics, skins, puzzles and lore coming to PC, Nintendo Switch and PS5 this June 25th.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/38955380/d4f9aded77f8d71ce86918056635a0153218d762.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are also excited to announce that on the same day, June 25th, Gecko Gods will be available to purchase on Nintendo Switch 2! Already own the game on Switch? Then you’ll be able to upgrade to the enhanced “deluxe” edition of Gecko Gods for free! There’s no better time to step onto our shores, on-the-go and we’re so proud to be able to provide this to the thousands of Nintendo Switch geckos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/38955380/728606368c7f8c175454750b3f9b70941fbc77d9.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Gecko Gods team 💚: [dynamiclink href=\"https://store.steampowered.com/app/1290760/Gecko_Gods/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
