  {
   "id": "gecko-gods-151312@patch-2025-06-11",
   "gameId": "gecko-gods-151312",
   "displayName": "Gecko Gods - Demo Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-11T14:58:48.000Z",
   "notes": [
    {
     "title": "Hey Geckos! 🦎",
     "items": [
      {
       "text": "We’ve been absolutely blown away by the love and support you’ve shown during Steam’s June Next Fest. It’s been an incredible experience seeing so many of you explore our world for the very first time - thank you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve been carefully listening to your feedback, and we’ve just pushed a hotfix patch to smooth out some rough edges and improve your experience. Here’s what’s new:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes & Improvements",
     "items": [
      {
       "text": "Added toggle sprint option in the Accessibility settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added unlock mouse cursor option in Accessibility (MHOOK compatibility)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed gap in water in the platforming section",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Objectives now clear correctly when starting a new game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Addressed audio stuttering issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed audio volume bugs when pausing/unpausing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected typos in the settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Patched several out-of-bounds exploits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with camera zooming in too much in the Cathedral",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased auto-pickup range",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We’re continuing to watch for, and action, your feedback and really appreciate everyone who’s taken the time to report bugs, suggest features, or just say kind things. It means the world to us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
