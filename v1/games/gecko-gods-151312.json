  {
   "id": "gecko-gods-151312@patch-2025-09-11",
   "gameId": "gecko-gods-151312",
   "displayName": "Help Us Win A Patch Award!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-09-11T18:00:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Gather round, Geckos! 🦎",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're honoured to announce that we've been nominated for a Patch Award!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vote by September 25th here so we can win the \"Anticipated Gem\" category.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/38955380/eedd750d43dc1a9d4ca67b8fc1187e6e313a92c0.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A huge thank you to Patch Magazine, and a congratulations to all other nominees! Let's make 2025 more gecko-filled and thank you for helping us get there.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't forget, our WWF-UK donation drive is still live! Please if you can, donate here too so that we can help geckos and wildlife everywhere, before this drive ends on October 2nd.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, till next time!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Gecko Gods team. 💚",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
