  {
   "id": "gecko-gods-151312@1.2905",
   "gameId": "gecko-gods-151312",
   "displayName": "UPDATE 1.2905",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-25T16:59:29.000Z",
   "notes": [
    {
     "title": "Features",
     "items": [
      {
       "text": "Forgotten Cove Island",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Two new tiny islands, Aquaduct and Waterfall Cavern",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Four new relics to discover",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Four new insects to eat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "4 rare gecko skins including Spirit, Ice, Ghost and Heart",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Boat speed slightly increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved puzzle ball controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the issue where lever rotations could get reset when reloading a save, leaving some players stuck on Volcano Island.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various softlock fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a tooltip to the settings menu suggesting disabling the automatic camera if the player experiences motion sickness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If the player dies more than 4 times in the ending (volcano) sequence, the lava will no longer rise.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slightly increased camera distance from the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved puzzle sphere interaction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General performance improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
