  {
   "id": "mystery-box-the-journey-257360@post-2023-07-27",
   "gameId": "mystery-box-the-journey-257360",
   "displayName": "Mystery Box is getting Achievements!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-07-27T07:08:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there, thanks for your support on Mystery Box: The Journey, I'm happy you're having fun with the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since many of you asked for Achievements, I'm preparing lots of them to spice up your gaming experience, and challenge your friends to achieve the same goals you've completed 🔥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NOTE: Achievements are already visible on the Store Page, anyway they'll be ready to be unlocked on the next game update (which is gonna happen these days).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
