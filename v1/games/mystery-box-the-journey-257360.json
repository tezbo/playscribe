   "id": "mystery-box-the-journey-257360@post-2023-07-29",
   "gameId": "mystery-box-the-journey-257360",
   "displayName": "Fixed Achievements reset",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-07-29T06:43:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there, I just fixed that little issue that was resetting all your Steam achievements in case you reset the game in the Settings menu",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Now you can still reset all levels, but your earned achievements will stay where they are ;)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
