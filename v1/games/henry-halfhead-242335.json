  {
   "id": "henry-halfhead-242335@0.1.15",
   "gameId": "henry-halfhead-242335",
   "displayName": "Patch 0.1.15",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-16T20:39:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks to everyone who played the demo so far! It has been wonderful to read your feedback in the reviews, the forums and on Discord 😊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is a small update for the demo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Most notably, this patch should fix the demo getting flagged by some antivirus programs by removing the reported files (which are of a plugin which we no longer use).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As a small treat we've added some stylish sunglasses to the level. They're a bit big for baby Henry but they look super cool! ✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/43807042/e98734594cf022e7690bc9cea0f6551612acd1a4.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of changes",
     "items": [
      {
       "text": "Removed unused plugin which triggered some antivirus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added fancy sunglasses to the level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a hand full of new narrator comments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Excluded settings from being synced over Steam Cloud Save (usually undesirable)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed camera control with mouse on Linux",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed level loading screen flickers on Linux",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed debug input icons displaying when no controller is connected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the door to the demo-ending would not appear when loading gamesave",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various other tweaks and bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
