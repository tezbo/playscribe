   "announcedAt": "2025-10-13T12:49:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Built game with new version of the Unity game engine which includes a security patch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When electronic devices produce an electric shock, they now emit some heat. Useful for a certain achievement :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added input prompt to catalogue screen so you know how to rotate objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed blackboard chalks levitating when drawing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed fence in baby-area sometimes pushing the puzzle below the floor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix missing \"Math\" task in school if answering Quinn before folding paper plane",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where Henry sometimes clipped deep into walls when leaving an object (work holes)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed inconsistent lighting in catalogue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed full flour packages getting stuck on flattened dough",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
