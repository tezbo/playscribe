  {
   "id": "techno-banter-250795@1",
   "gameId": "techno-banter-250795",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-08T01:04:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dropping the promised patch, just in time for the weekend!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you were waiting a little while for us to implement a few fixes before buying, but still wanted to take advantage of the -20% Launch Discount, this is the perfect moment!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As previously mentioned, and without further ado, here are the patchnotes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Invert Y axis setting, for all fighter jet enthusiasts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Alternative controls for minigames (Arrow keys for Movement, Right Shift for Dash!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Nill should appear in correct clothes (or without them) in all places in the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Restored animations on Nill Status Wheel (for some reason, our beary kind friend doesn't react at all!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Visual and functional rework of Skills Menu, to adjust it to how the conversation Skill Wheel works",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Visual improvements here and there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "As always, please feel free to reach out to us either directly on our Discord or the Steam Discussions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If you like Techno Banter, we'd really appreciate you leaving a review!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
