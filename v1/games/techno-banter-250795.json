  {
   "id": "techno-banter-250795@hotfix-2025-02-03",
   "gameId": "techno-banter-250795",
   "displayName": "The Hotfix is here!",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-02-03T17:13:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Seeing you all explore Rainbow Drive and become absolute rulers of the Green Door queue has warmed our hearts beyond words, and we couldn't be more thankful for all your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That being said, we wanted to address (and fix) the issues you have been reporting throughout the Launch Weekend, so here it is!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The first patch for Techno Banter!",
     "items": [
      {
       "text": "This hotfix aims to address all the issues connected to progressing through the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed inability to select certain dialogue options using the controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed soft-lock caused by using skills without the required hype level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed inability to progress through the Red Flags explanation during the dialogue with Gunthy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you run into any more pesky bugs, feel free to reach out to us either through our Discord server, our Community Hub or directly to our team at support@crunchingkoalas.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
