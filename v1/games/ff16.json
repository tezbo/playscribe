  {
   "id": "ff16@1.02",
   "gameId": "ff16",
   "displayName": "Update 1.02",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-10T09:37:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version Update 1.02 is now available for download. This update implements various changes to system settings while addressing several known gameplay issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Change Log",
     "items": [
      {
       "text": "A cursor lock option has been added to Settings in the Main Menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Timing for the shutter click sound effect when taking screenshots has been adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Help text for Photo Mode has been tweaked to improve clarity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shadow Quality settings have been adjusted to include cloud quality at all three levels—low, medium, and high—instead of only at high. This should improve performance when low or medium is selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphical Fidelity settings have been adjusted to improve overall game performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The following have also been addressed",
     "items": [
      {
       "text": "Issues with mouse scrolling when using aspect ratio settings other than 16:9.",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ],
       "pcOnly": true,
       "category": "other"
      },
      {
       "text": "Issues with locking on during the Eikonic Feat Blind Justice when using aspect ratio settings other than 16:9.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Issues with in-game access point interaction when using borderless window mode in conjunction with aspect ratio settings other than 16:9.",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ],
       "pcOnly": true,
       "category": "other"
      },
      {
       "text": "Issues with the last device used not remaining active when playing with multiple controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphics not displaying properly on certain screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Issues with UI continuity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unexpected crashes with select hardware setups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
