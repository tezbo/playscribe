  {
   "id": "ff16@1.01",
   "gameId": "ff16",
   "displayName": "Update 1.01",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-22T10:05:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "An update has been released for the FINAL FANTASY XVI PC demo, introducing a number of improvements and adjustments to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements have been made to DLSS, FSR, and XeSS quality.",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ],
       "pcOnly": true,
       "category": "other"
      },
      {
       "text": "This should help to alleviate various graphcial issues such as blurring (DLSS/XeSS) and pixelation (FSR).",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ],
       "pcOnly": true,
       "category": "other"
      }
     ]
    },
    {
     "title": "The following issues have also been addressed",
     "items": [
      {
       "text": "Dynamic Resolution being locked on the lowest setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemies not appearing properly in certain battle content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphics not displaying properly on certain stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphical tearing in certain instances when using borderless screen mode.",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ],
       "pcOnly": true,
       "category": "other"
      },
      {
       "text": "SFX not playing properly under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UI not displaying properly under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Screen resolution changing under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rare instances of GPU crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are currently aware of instances of stuttering on certain PC environments, and are investigating the issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
