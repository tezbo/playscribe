  {
   "id": "dnf-duel-142063@1.08",
   "gameId": "dnf-duel-142063",
   "displayName": "Patch 1.08",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-25T09:09:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, Adventurers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Following bugs have been fixed from the update on October 25.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keyboard Control on Steam",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "●Unable to control with the controller when re-logging into the game after disconnecting the controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Unable to control with keyboard when unplugging the connected controller.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "●Improvement in Menu Control with keyboard",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "■Keys assigned to 'move' from the keyboard can now move the cursor from the game menu.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Player Match Room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●The guide for the keys being removed from the bottom side of the screen in certain situations in the room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Unable to change the size of the chat while seating on the Arcade Machine.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●The ranking of the host appears lower than usual when renewing the Room Settings in the room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●The dialogue notification regarding insufficient remaining slot for Saved Replays does not automatically close in the match result screen after the countdown ends.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Training Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●An inaccurate damage value appearing on the bar when the opponent has White Damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Survival Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●The amount of remaining White Damage right before K.O is added as a survival bonus in the result screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Awakening scene appears with a bug in certain situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "6. Ranking Board",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●User ID with certain letters appears as \" ? ? ? \"on the Ranking Board on the Steam version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We sincerely apologize for the inconvenience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
