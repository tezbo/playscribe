  {
   "id": "dnf-duel-142063@1.41",
   "gameId": "dnf-duel-142063",
   "displayName": "Patch 1.41",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-02T07:41:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, Adventurers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are pleased to inform you that the following issues have been fixed in the latest update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Spectre's voice is not played when [Language Settings] - [Voice Language] - [Individual Settings] was applied before applying the patch Ver.1.40.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. The character Spectre is changed when Ranked Match starts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. The default game Voice Language is set to Japanese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Spectre's MP recovery speed is slowed down in certain situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We sincerely apologize for any inconvenience caused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your continued support, and we look forward to your ongoing adventures in DNF Duel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
