  {
   "id": "deserted-149203@1.2.8",
   "gameId": "deserted-149203",
   "displayName": "Update 1.2.8",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-26T16:12:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are proud to release the Character Customization update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With new Character Customization features you can now select different hair, skin and suit colors when you begin a new game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When you spawn in a co-op player you will now also be able to select your choice of either male or female character models.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve continued to refine Deserted by fixing additional critical bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Adjusted some playable areas for columns so they will no longer be blocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed bugs relating to experience points on speeder and on foot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Continue to adjust the play-ability and visibility of levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Refined the AI behaviours on some enemies in COOP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Additional difficulty balance when playing Co-Op",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For the next update we have also started work on more performance improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
