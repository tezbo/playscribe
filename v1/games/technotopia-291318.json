  {
   "id": "technotopia-291318@1.0.6",
   "gameId": "technotopia-291318",
   "displayName": "Update 1.0.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-29T09:44:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re excited to announce the new update for Technotopia! This patch brings several key fixes and optimizations aimed at enhancing your gameplay experience. Please ensure you have the latest version (1.0.6) installed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of changes",
     "items": [
      {
       "text": "Fixed an issue with system text display.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Implemented several optimizations for enhanced performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Addressed various minor adjustments aimed at improving gameplay quality.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In addition, we’re excited to announce that community items are now available on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Be sure to update Technotopia to the latest version and enjoy an improved experience. Thank you for your ongoing support and feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
