  {
   "id": "technotopia-291318@1.0.4",
   "gameId": "technotopia-291318",
   "displayName": "Update 1.0.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-24T14:26:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re excited to bring you the first update for Technotopia, focused on enhancing gameplay and fixing some key issues. Please ensure you have the latest version (1.0.4) installed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of changes",
     "items": [
      {
       "text": "Implemented several minor code tweaks aimed at improving gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some issues related to save profiles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved a graphical artifact in the final cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the font on the “Create” button for an empty profile.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the Excavator building icon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Known issues",
     "items": [
      {
       "text": "We’ve noticed that some players are experiencing crashes, which seem to be related to insufficient RAM. We're actively working on a solution. In the meantime, here are the recommended system requirements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "OS: Windows 10 64-bit",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Processor: Intel(R) Core (TM) i5-4440 CPU / AMD Ryzen 5 1600",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Memory: 8 GB RAM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphics: NVIDIA GeForce GTX 960 / AMD Radeon RX 760",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Storage: 3 GB available space",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you’ve encountered this issue, please send the following data to our support team via bug report form:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save files and logs located at C:\\Users\\...\\AppData\\LocalLow\\Yustas Games Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dxdiag: Press Start in Windows, type \"dxdiag\" in the search box, and select it from the results. Choose “Save all information” in the tool.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also recommend closing other applications, like browsers, to free up memory and avoid crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
