  {
   "id": "technotopia-291318@major-2024-10-04",
   "gameId": "technotopia-291318",
   "displayName": "Update on Technotopia Release Date",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-04T15:08:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have an update on Technotopia launch date on Steam: the game is now set to release on October 23rd!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Postponing the launch was not an easy decision for us but we have important reasons to do so. Firstly, our team needs a little bit more time to fix the last bugs – we don’t want to release a product that doesn’t meet our quality standards or has issues that could ruin your experience. Secondly, we want to make sure there are no localization errors, as the game is text-heavy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Apologies for the delay. We promise that the extra time will be well spent, and the final version will be worth the wait!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
