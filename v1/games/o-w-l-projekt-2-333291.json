   "id": "o-w-l-projekt-2-333291@patch-2025-10-03",
   "gameId": "o-w-l-projekt-2-333291",
   "displayName": "Security Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-03T16:42:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we released a small security patch on Steam. (the version number remains the same as before)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The engine provider identified a security vulnerability affecting Windows, and this update includes the fix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "According to them, no exploitation has been detected and no players were ever at risk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For O.W.L Projekt 2, there was never any danger since this is a single-player experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Both the engine developers and Microsoft have already updated Windows Defender, so without this patch, you might encounter issues with being able to launch the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch contains no other gameplay changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For more technical details about the vulnerability, see: https://unity.com/security/sept-2025-01#details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
