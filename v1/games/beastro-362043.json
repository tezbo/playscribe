  {
   "id": "beastro-362043@post-2026-02-23",
   "gameId": "beastro-362043",
   "displayName": "Beastro Demo is LIVE and updated!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-02-23T15:55:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, talented Chefs!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are back with a new demo! We've updated a lot since the last time you got your paws on it, so here's what we've done...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Tutorials for Mise en Place and combat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Power bar to the boiling minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "UI Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
