  {
   "id": "beastro-362043@major-2026-05-06",
   "gameId": "beastro-362043",
   "displayName": "Release Date Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-06T15:09:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "To our budding Chefs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Beastro needs a little more time in the oven than we originally planned. A few items have come up that we want to address before serving you our best work. This is taking some time as we are a small team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our new release date is June 11th, so it still isn't long to go - but that extra couple of weeks will help us make these meaningful changes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We can’t wait for you to jump in and start cooking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~Timberline Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
