  {
   "id": "murders-on-the-yangtze-river-201417@major-2024-03-22",
   "gameId": "murders-on-the-yangtze-river-201417",
   "displayName": "Update for better English translation",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-22T13:28:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're excited to announce a new update today, thanks to the invaluable feedback we've received from many of you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Over the past week, we've been dedicated to enhancing the English version of the game in the following ways:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Correcting and refining English names for all characters: We understand the importance of accurate and immersive character names, so we've taken the time to ensure that every character's name is appropriately translated and reflects their identity within the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Addressing translation issues: Polish sentences and wordings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changing language default settings: If your operating system language is not Chinese (simplified or traditional), the game's default language will be English.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Furthermore, we've included a brief conversation at the end of Chapter 5. This conversation provides clearer insight into the circumstances surrounding Shen Po-an's demise, offering players a more comprehensive understanding of the storyline.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope these updates enhance your gaming experience, and we're grateful for your continued support and feedback as we strive to make our game even better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
