   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone, in our latest update, we have disabled the game reset button in the settings to prevent accidental use that could lead to the loss of saved progress. If you wish to experience the game again after completing it or attempt to achieve all accomplishments, you can use the Chapter Select feature from the main menu to replay previous chapters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
