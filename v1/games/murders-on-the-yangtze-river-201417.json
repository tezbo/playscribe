    {
     "title": "Achievement Unlocking Issue",
     "items": [
      {
       "text": "Resolved the problem where achievements could not be unlocked in the full version after trying the demo version first. After updating, when you open the full version of the game, the achievements unlocked in the demo will be unlocked all at once in the full version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor bugs;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
