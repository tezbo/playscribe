  {
   "id": "murders-on-the-yangtze-river-201417@15.0.1",
   "gameId": "murders-on-the-yangtze-river-201417",
   "displayName": "Update 15.0.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-23T17:23:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello detectives!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some players who use Mac encounter a game crash when launching games on Steam after update the latest Mac system (macOS Sequoia 15.0.1)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We have identified this as a system compatibility issue and are urgently working on a fix. Please be patient. For those who are eager to experience the game, we recommend not upgrading to the new Mac system or waiting until this issue is resolved before continuing to play. We apologize for the poor gaming experience this has caused you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
