   "gameId": "seed-of-life-117261",
   "displayName": "UPDATE 1.0.11",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-03T20:20:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Leonardo Interactive and Madlight Studios announce that the update v. 1.0.11 of Seed of Life is now available for download. This is the complete changelog:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Overall game",
     "items": [
      {
       "text": "Fixed some achievements that would not trigger when they should",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some situations where Cora wouldn’t take damage when falling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved the crouch camera behavior",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved some situations when the camera would have a jittery movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The volumetric light setting is no longer present",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved some situations where Cora’s jump would have weird behaviors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the lava river platforms behavior in the third area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where Cora would pick the petals, having a wrong positioning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the jump sound",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved some cutscenes that would behave weird sometimes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks as always for the support. See you soon for more news.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
