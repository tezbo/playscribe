  {
   "id": "seed-of-life-117261@1.0.13",
   "gameId": "seed-of-life-117261",
   "displayName": "UPDATE 1.0.13",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-27T20:52:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Leonardo Interactive and Madlight Studio announce that the update v. 1.0.13 of Seed of Life is now available for download. This is the complete changelog:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Overall game",
     "items": [
      {
       "text": "Added inertia to jumps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some physics issues where the player could climb walls when the sprint capsule was activated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated cameras to fix some blending issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Walk mode entry in Settings. Cora will walk instead of run by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added tutorial explaining how to recharge the talisman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added tutorial explaining that the Lumium plants create a regeneration shield when full of Lumium.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Lumium plants entry inside the Glossary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Area 2",
     "items": [
      {
       "text": "Removed one obsolete cutscene, now that plants have a tutorial explaining they can heal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Area 3",
     "items": [
      {
       "text": "Removed some invisible collisions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the climbing part leading to the falling stones challenge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks as always for the support! See you soon for more news!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
