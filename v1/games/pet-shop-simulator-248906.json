   "kindBasis": "studio",
   "announcedAt": "2024-06-22T15:49:04.000Z",
   "notes": [
    {
     "title": "Hello Players! 🥳",
     "items": [
      {
       "text": "It's been the first 24 hours since the release of our game 🔥.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your activity, many suggestions and feedback - it is thanks to them that we are able to improve and upgrade our game ✌️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "The set margin does not reset after saving and loading the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The shelf on which the product was set (visible on the price label) saves correctly, but without the physically stacked products.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Correctly refreshes the price of products in the shopping cart after loading the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vehicles should no longer cause congestion on the street.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Product prices on shelves refresh after margin changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Modified notification regarding employees wanting to go on break. It should no longer suggest that the player himself has to send them on a break just inform them that they will go themselves in a short time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug in which a player could not move a piece of furniture that had already been purchased if the player had less money than its value.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The security guard will no longer try to catch a thief caught earlier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The app with finances will not cut when starting it when there are a large number of items in the logs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Customers won't open all the cubicles at once when they go to the bathroom",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Customers go to the restroom a little more often",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pet Shop Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
