  {
   "id": "pet-shop-simulator-248906@1.0.7",
   "gameId": "pet-shop-simulator-248906",
   "displayName": "Update 1.0.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-30T17:13:11.000Z",
   "notes": [
    {
     "title": "Hey, Animal Lovers! 🐾",
     "items": [
      {
       "text": "We've just rolled out a new update for Pet Shop Simulator! This time, we've focused on fixing some minor bugs and adding a few gameplay improvements to make your experience even better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "Fixed earning the achievement for sending an employee to training for the first time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed coupons in the self-service checkout that did not discount products",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the display of the wrong icon indicating what shelf a product will fit on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some products showing up on shelves in one color despite being ordered in different colors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a hanging sign whose content can be changed with a scanner.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added display of the quantity of a given product on the shelves and in the warehouse, as well as their total, when you point the mouse at the product in the tablet.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "As always, your support and feedback mean the world to us, so let us know how the game feels after this update. Thanks for being part of our community!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you soon,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pet Shop Simulator Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
