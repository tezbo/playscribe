  {
   "id": "pet-shop-simulator-248906@1.0.4",
   "gameId": "pet-shop-simulator-248906",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-07-22T09:38:44.000Z",
   "notes": [
    {
     "title": "Hey Pet Shop Masters! 🐶🐱🐹",
     "items": [
      {
       "text": "We’ve got some awesome news for you! The new update for Pet Shop Simulator is now available and it includes a few fixes and improvements! 🎉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔧 WHAT’S NEW?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved achievements : half a million, million, purchase of the entire parking lot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Blocked the ability to remove fish tanks and terrariums with pets, causing them to show up in the warehouse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Blocked the ability to send fish with a scanner to the warehouse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re super grateful for your engagement and support. Thanks to your comments and reports, we were able to quickly catch and fix these bugs. You are the best testers ever! 🙌❤️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re not stopping here and are already working on more updates to make your gaming experience even better. Stay tuned and have fun running your virtual pet shop!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for being with us and for your incredible energy. See you in the Pet Shop! 🐾🌟",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you soon,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Pet Shop Simulator Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
