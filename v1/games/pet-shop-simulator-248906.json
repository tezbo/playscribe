  {
   "id": "pet-shop-simulator-248906@1.0.3",
   "gameId": "pet-shop-simulator-248906",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-26T14:26:59.000Z",
   "notes": [
    {
     "title": "Dear Players! 🥳",
     "items": [
      {
       "text": "Over the past few days, you've been letting us know that you would like dogs and cats to appear in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changes take time, but we wanted to show you right now that we are working to implement your requests and suggestions into the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "As a result, dogs are coming to the game starting today!",
     "items": [
      {
       "text": "In its current form , the dogs will come to the store under the care of their owners , and you will be able to interact with them 🔥❤️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get ready for the next updates , because in them will appear our answers to your requests ✌️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "Passersby received dogs, you can interact with them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new item - dog treat where the customer can approach with the dog.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some markings in the tablet on which shelves products should go to",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed blocking of the employee with the customer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The signature of the turtle terrarium has been corrected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Please remember 🙏 currently it is not possible to own a pet on property or sell dogs ☝️",
     "items": [
      {
       "text": "See you soon,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pet Shop Simulator Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
