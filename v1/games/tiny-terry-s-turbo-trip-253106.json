  {
   "id": "tiny-terry-s-turbo-trip-253106@1.36.1206",
   "gameId": "tiny-terry-s-turbo-trip-253106",
   "displayName": "Patch 1.36.1206",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-06T14:28:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "Insect Probability: increases the chance to spawn insect types you haven't caught before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed the game not being able to shut down when trying to exit from a soccer match or bumper car battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the \"cursed\" tree where cars would keep driving in circles south of Sky Plaza.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the cars spawning behind the rocks around Poedelstark & Mokernakt.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that occurred if you jumped into a car from inside an elevator as the elevator was closing.: Cheers!: Lars (snekflat)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
