  {
   "id": "tiny-terry-s-turbo-trip-253106@1.783.1129",
   "gameId": "tiny-terry-s-turbo-trip-253106",
   "displayName": "Patch 1.783.1129",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-22T16:50:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello. This hotfix solves the graphical glitches affecting ground textures on Windows.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "When you launch the game for the first time, you'll now see 2 launch options. One for Windows and one for Steam Deck. Pick the one that matches your system and the game will automatically use the recommended rendering API.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Windows: Launches the game with DirectX12 with DirectX11 as a fallback if needed. DirectX resolves the ground texture glitches that Windows players were experiencing.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Steam Deck: Launches the game using Vulkan. Vulkan continues to provide the best performance and is recommended when using the highest graphics settings on Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44214266/4ab6ae51b8d516304bfef1ef4d7a1fd276a8e678.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lars (snekflat)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* EDIT: Patch 1.783.1129 fixes the achievements that accidentally got disabled in 1.779.1758",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
