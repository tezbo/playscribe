  {
   "id": "tiny-terry-s-turbo-trip-253106@1.30.1806",
   "gameId": "tiny-terry-s-turbo-trip-253106",
   "displayName": "Patch 1.30.1806",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-31T15:55:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone. I have been smiling all day reading your reviews <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the patch notes for the latest version",
     "items": [
      {
       "text": "Added a setting to the Gameplay Settings that allows you to scale the UI. Currently this affects the size of the mini map and the legend on your full screen map, as there was high demand for these specific elements for Steam-deck users. I may add more elements in the future!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "“Achievement: Get 450 Turbo Junk” should now also unlock regardless of whether you’ve upgraded the Turbo Junk into Turbo Ups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected the credits from saying “Super Rage Originals” to “Super Rare Originals” xD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that occurred if your car fell into the water while you were in a menu or dialogue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where you had to press a random button on your keyboard to continue the dialogue if you managed to press space & mouse click on the exact same frame when rushing through dialogues.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where the government quest doesn’t show up in the progress window once you completed it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where you could interact with plastic chairs that were placed inside of a wall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a typo in one of the dialogues, of one of the gummy pup resting grounds statues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a confusing collider in the beach area nearby the Beach Club.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Can no longer eat beach fries from your car (which introduced a broken animation).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lars (snekflat)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
