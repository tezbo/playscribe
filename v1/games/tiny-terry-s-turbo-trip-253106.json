  {
   "id": "tiny-terry-s-turbo-trip-253106@1.34.1831",
   "gameId": "tiny-terry-s-turbo-trip-253106",
   "displayName": "Patch 1.34.1831",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-04T19:00:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the patch notes for the latest version",
     "items": [
      {
       "text": "Enhancements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Turbo Junk Finder Hat now also beeps nearby entrances to buildings that still have uncollected Turbo Junk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Turbo Junk Finder Hat now also beeps nearby Ricky if he still has Turbo Junk in his pocket.: Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the Gameplay Settings don't show the applied settings after re-launching the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the shovel sometimes not working as expected on slopes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the mini map not opening if you tried opening it immediately after closing it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some lighting issues in The Generator.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with some hat descriptions not displaying when acquiring the item.: Achievement revalidation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If somehow the Mushroom Chime achievement didn't trigger for you, it should now be revalidated when you load your save file or enter a map.: Cheers!: Lars (snekflat)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
