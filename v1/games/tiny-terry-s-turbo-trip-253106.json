   "id": "tiny-terry-s-turbo-trip-253106@1.36.0055",
   "gameId": "tiny-terry-s-turbo-trip-253106",
   "displayName": "Patch 1.36.0055",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-05T22:22:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's another quick update",
     "items": [
      {
       "text": "Accessibility",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay Settings: Added a toggle to disable \"Tilted Camera Angles\". This is toggled on by default. If you turn it off, the game will have alternated camera angles in most of the interiors, which should be helpful if you find the tilted camera discomforting (or nauseating).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a few missing characters in the Chinese font.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some issues related to Post Processing.: Cheers!: Lars (snekflat)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
