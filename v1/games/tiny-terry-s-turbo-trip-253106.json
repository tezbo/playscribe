  {
   "id": "tiny-terry-s-turbo-trip-253106@1.50.1018",
   "gameId": "tiny-terry-s-turbo-trip-253106",
   "displayName": "Patch 1.50.1018",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-21T22:16:16.000Z",
   "notes": [
    {
     "title": "Discord Competition Winners",
     "items": [
      {
       "text": "There was a competition in the snekflat enthusiasts Discord to create a new hat & a new insect and everyone voted for their favourites. The winning entries have been added to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Seagull Hat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wool came up with the seagull hat. This ended up becoming a new feature. I always felt bad for players when nothing would happen after they managed to hit a bird with a bug net (which is pretty tricky to do). So now you can catch birds with the bug net and wear them as hats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"Sliamk\" Insect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This purple snail-like insect was designed by wupporulz(forever)ok. There are 10 different insects in the game now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Full credits list is now also available from the Title Screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lars (snekflat)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
