   "announcedAt": "2024-10-10T07:22:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added Option for Auto-aiming when Using Mouse",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "An option to toggle auto-aiming for when using a mouse has been added to the Options menu, under “Keyboard / Mouse.” This allows separate auto-aiming settings for when using a controller and for when using a mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Certain Epic Online Services Features are now Selection-Based",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If Epic Online Services is installed, you can now select if you want to use Epic Online Services Friends and Invites when starting the application.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: If using these features, you will need to create an Epic Games account and link it to your Steam",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "account in order to play online. You can still play online if you choose not to use these features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
