       "category": "fixed"
      },
      {
       "text": "Minor rebalance of paranormal events.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Y-axis inversion option.",
       "ps5ProOnly": false,
       "pcOnly": false,
