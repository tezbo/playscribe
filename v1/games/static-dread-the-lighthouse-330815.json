  {
   "id": "static-dread-the-lighthouse-330815@1.0.3",
   "gameId": "static-dread-the-lighthouse-330815",
   "displayName": "Hotfix 1.0.3",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-08-11T16:17:37.000Z",
   "notes": [
    {
     "title": "This update includes",
     "items": [
      {
       "text": "Fixed a problem where some paintings could not be interactable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the default language could be set incorrectly if the system language could not be detected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a softlock for Procedural Ships where some ships had no available dialogue options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Japanese characters. We are fully reworking the Japanese localization, as the current machine-translated version is unusable. If you’d like to help us with localization, please join our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Courier could leave the lighthouse without saying anything.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed inconsistencies between choices made and their consequences in some dialogues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
