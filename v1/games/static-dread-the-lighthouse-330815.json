   "gameId": "static-dread-the-lighthouse-330815",
   "displayName": "Hotfix 1.1.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-09-29T18:26:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A small localization update for the patch we released last week",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Discord community finished proofreading Simplified Chinese, and it has been added to the game",
       "ps5ProOnly": false,
