  {
   "id": "static-dread-the-lighthouse-330815@1.0.5",
   "gameId": "static-dread-the-lighthouse-330815",
   "displayName": "Hotfix 1.0.5",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-08-15T16:24:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Happy Friday, Keepers! We’ve prepared a small update to improve your weekend adventures at the lighthouse.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This update includes",
     "items": [
      {
       "text": "Fixed an issue where interactions could disappear after dealing with the Beholder.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved water visuals during fishing to help reduce motion sickness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed the mechanic where dark entities could destroy items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some story consistency issues in dialogues with the Hunter and the Courier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor user experience improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your continued support and feedback - and have a great weekend at the lighthouse!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
