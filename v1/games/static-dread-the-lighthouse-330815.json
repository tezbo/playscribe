  {
   "id": "static-dread-the-lighthouse-330815@1.0.6",
   "gameId": "static-dread-the-lighthouse-330815",
   "displayName": "Hotfix 1.0.6",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-08-19T14:31:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, happy Gamescom to everyone! In the meantime, we’re continuing to update the game to address the most critical issues you’ve reported through Steam reviews, Discord, and discussions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Completely reworked the machine translation for German to improve its quality.: The community is now proofreading it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the interaction system: now, even if you stand very close to an object, interaction should still be available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in the Secret Ending where Sanity could still be consumed during cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Story Progress elements that couldn’t be obtained on Days 12 and 13, related to the story branches of the Keeper, the Deputy, and Captain Drake.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed inconsistencies in dialogues with the Boy on Days 9 and 14, as well as in other text elements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor improvements to the rules for handling strange ships between Days 6–15.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy Gamescom!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
