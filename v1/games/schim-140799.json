  {
   "id": "schim-140799@patch-2025-11-19",
   "gameId": "schim-140799",
   "displayName": "SCHiM Beta - Fast Forwarding, 360 Camera Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-19T14:52:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, shadow hoppers! It's been a little while, but we are excited to announce a new upcoming patch for SCHiM! Before we set this patch live, we want to test this patch through private beta with anyone interested.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🖱️360 Camera controlled by mouse",
     "items": [
      {
       "text": "You can enable 360 Camera in the Control Settings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "⏩Fast Forwarding cutscenes",
     "items": [
      {
       "text": "Fast forward cutscenes by holding down shift, or Y on the controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Beta Bugs",
     "items": [
      {
       "text": "We are excited to test this patch with you in beta, because it is a beta there can be some bugs we haven't found. Please let us know if you find something strange by sharing it in the Discord or here in the Steam community!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Localization",
     "items": [
      {
       "text": "Because these are brand new features, they don't have localization yet. They might appear as \"Invalid\" in languages other than English. If you have suggestions, please let us know, and we will implement them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/39594768/4228ced0579f9e6f62085b1d993688c3a1706890.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "If you own SCHiM on Steam, you can try the patch right now",
     "items": [
      {
       "text": "Steam Library > SCHiM > Properties > Betas > Private Betas: Use the code FreeTheCamera",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
