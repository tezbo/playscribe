   "id": "schim-140799@patch-2025-12-17",
   "gameId": "schim-140799",
   "displayName": "Patch! Fast Forwarding, 360° Camera and Steam Deck Startup Movie",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-12-17T14:47:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone, the winter season is upon us. Besides a winter sale we also got a new patch for you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🖱️360° Camera controlled by mouse",
     "items": [
      {
       "text": "You can enable 360° Camera in the Control Settings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "⏩Fast Forwarding cutscenes",
     "items": [
      {
       "text": "Fast forward cutscenes by holding down shift, or Y on the controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🎥SCHiM Steam Deck Startup Movie",
     "items": [
      {
       "text": "Use your Steam points to get the awesome stop motion Startup Movie for your Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/39594768/25e15851df3b39c6dce60e0717611c4744365b4f.png\"]",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Localization",
     "items": [
      {
       "text": "Because these are brand new features, not everything has localization yet. They might appear as in English for now. If you have a suggestion for your language you can message us here or on the Discord and we can implement it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/39594768/4228ced0579f9e6f62085b1d993688c3a1706890.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
