     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone! :D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A Hole New World version 1.1 has just been released!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This version includes some bugfixes and improvements in controller support, as well as complete translations for Russian and Polish. Big thanks to Dmitry Aleksov from EmuGamer for his Russian translation and to Grzegorz 'Skay' Fedkiewicz for his Polish translation! :D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog for version 1.1",
     "items": [
      {
       "text": "Added cyrillic pixel font",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Russian language localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Polish special characters to latin pixel font",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Polish language localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated controller plugin version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix: Potion Master no longer can receive a \"double damage combo\" (it normally ocurred against Baduk)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Cursor is now automatically hidden when over the game window",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Missing Backers (the ones who answered after the release of the game) Added into credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Right now you can play A Hole New World in English, Spanish, French, German, Italian, Polish and Russian! ^^",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Is it still not in your language? If you would like to translate it, feel free to write us! ;)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
