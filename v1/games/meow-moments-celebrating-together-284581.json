  {
   "id": "meow-moments-celebrating-together-284581@post-2025-07-19",
   "gameId": "meow-moments-celebrating-together-284581",
   "displayName": "Bug Fix: Welcome to Campus Scene",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-19T02:18:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve just released a patch to fix an issue affecting the Meow Moments: Welcome to Campus scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When we added the new Music Festival scene, we unintentionally replaced Welcome to Campus with a faulty version. Players who entered the scene during this period may have encountered a purple background, missing balloons, and some missing characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The original version of Welcome to Campus has now been restored and should work correctly again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚠️ Important: Only players who started the Welcome to Campus scene between July 16 and July 18 will need to restart the scene, which will reset progress for that scene. We’re very sorry for the inconvenience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you so much for playing Meow Moments: Celebrating Together and for your continued support. Your feedback means a lot to us! 💛🐾",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
