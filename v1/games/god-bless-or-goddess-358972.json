  {
   "id": "god-bless-or-goddess-358972@major-2025-06-29",
   "gameId": "god-bless-or-goddess-358972",
   "displayName": "20250629 Update Announcement",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-29T02:58:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1. Fixed the issue where the male lead's voice remained on the map interface even when the male lead's voice was turned off;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Fixed the issue where there was a probability of not being able to exit after the crowdfunding gratitude list was played;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Fixed known spelling errors;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Fixed the issue of abnormal completion status display during the second exploration of the table;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Optimized the display status of the map;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "6. Optimized the display status of some UI;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "7. The overall difficulty has been slightly reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Thank you for your feedback, players. If you still have any other questions or suggestions, please feel free to let us know through various channels. Thank you again for your support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
