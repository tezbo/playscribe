   "id": "god-bless-or-goddess-358972@post-2026-03-05",
   "gameId": "god-bless-or-goddess-358972",
   "displayName": "Game Temporary Maintenance Completed Announcement",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-03-05T04:19:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Greetings!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The login issue caused by international network fluctuations has been urgently investigated and fixed by our development team. The problem has been fully resolved, and the game is now available for normal login.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue to monitor the network and server status in real time to ensure your gaming experience! Thank you again for your understanding, patience and support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
