   "announcedAt": "2024-12-09T11:05:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "*If you saved after half-attempting some puzzles, they would start in this state upon loading, which could be confusing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Fixed colliders in the central room of arches of the Alien Temple.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*You cold grab an item in the Biolaboratory before solving the corresponding puzzle. This has been solved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Time-based puzzles now go even slower with each attempt.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
