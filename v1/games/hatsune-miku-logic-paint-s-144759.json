       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the issue where certain Traditional Chinese characters cannot be displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue where the game does not start without internet communication.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
