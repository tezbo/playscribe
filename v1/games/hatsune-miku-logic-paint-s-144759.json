  {
   "id": "hatsune-miku-logic-paint-s-144759@patch-2022-11-24",
   "gameId": "hatsune-miku-logic-paint-s-144759",
   "displayName": "The first patch is here, with more to come soon.",
   "kind": "patch",
   "kindBasis": "studio",
