  {
   "id": "hatsune-miku-logic-paint-s-144759@1.1.3",
   "gameId": "hatsune-miku-logic-paint-s-144759",
   "displayName": "Update 1.1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-10T02:28:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Hatsune Miku fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would like to thank everyone who reported the issue of the achievement, and we are sorry to keep all the fans waiting for so long. We are happy to let you know that with the release of \"Version 1.1.3,\" the issue has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The details are as follows.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the issue where the achievement \"Hatsune Miku Logic Paint Ambassador\" cannot be unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you already qualified in unlocking this achievement, you should be able to unlock if after performing the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
