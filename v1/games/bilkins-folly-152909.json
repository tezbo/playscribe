  {
   "id": "bilkins-folly-152909@major-2023-12-11",
   "gameId": "bilkins-folly-152909",
   "displayName": "a decently-sized update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-11T23:20:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "dialogue addition: (ending spoiler) - La Moina will now acknowledge if you've spoken to Winston",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug where it was possible to bring up map tools while out of journal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added Numberly Rocks quest icons to local map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Cecil - changed \"it's\" to \"its\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fix - icon text would appear on screen after local map had been dismissed if hovering over icon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed - 'Paused' text would not clear from screen in certain situations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed a line in the journal - 'save from their fate' to 'leave to their fate'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Blum's diary - fixed a typo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crabb Island - fixed missing water tile",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Big Catch trophy now appears in Percy's cabin",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed bug where carrying Drayton into water that quickly gets deep could warp Percy to different locations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where carrying Drayton into water after a leap of faith would create two Draytons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with ordering Drayton to pull the Crabb Mountain chain twice causing game to softlock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added an extra fast travel point on Leeky Harbor in the stumpy spot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "lowered the time it takes for the telescope zoom to return to the normal game zoom level - allows for faster opening of journal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Can no longer unlock fast travel points early using the telescope",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Can no longer unlock the Crabb Island cemetary fast travel point early by going around the cliffs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a rare bug with the Leeky Harbor chest break-ins that could trigger the wrong treasure",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If the Leeky Harbor chest bug was activated, game will check and unlock the thief achievement retroactively",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Act 3 - can no longer ask fishmaster about pearls after completing quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "typo fix: \"shipyards\" to \"shipyard's\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "typo fix: \"it's\" to \"its\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "typo fix: \"your\" to \"you're\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "typo fix: \"mentioned\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Act 3 - removed certain livestock from a certain farm",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "experimental - can now cycle objects with mouse wheel scrolling",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a moment where during a specific line of dialogue with Philmore, Percy's lips wouldn't move",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "ultrawide monitors - titlescreen fadeout now covers entire screen",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed ruler not rounding to the nearest degree in certain cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where Drayton's icon could occasionally disappear from the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed an old cheat code for QA testers that would set lockpicks to novice",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Drayton can now be dropped with the interact button",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remy's Lott, no longer possible to stand in swamp water and open the ship chest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remy's Lott, swamp ship now fades out correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remy's Lott, swamp chest depth sorting fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achievement - pirate perfectionist would not unlock if fishing tasks were completed in a very specific order. Will unlock automatically for players who experienced this",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gail's achievement unlocks no matter dialogue choices",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
