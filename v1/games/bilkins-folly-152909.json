  {
   "id": "bilkins-folly-152909@major-2023-10-19",
   "gameId": "bilkins-folly-152909",
   "displayName": "A medium-sized update :)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-19T00:04:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Jake Grubb will now give a hint on his diaries in normal mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minecart puzzle - adjusted timer to be more forgiving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remy's Lott - slight adjustment to distillery map icon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "keysmith achievement would not always unlock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remy's Lott - final Flo's Hunt token, made sensor for this more forgiving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a rare bug where the player would get stuck looking out to sea on the ship",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "increasing Drayton's sniffing ability could remove sniffing sensor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed softlock in skull dungeon if entering the same wheel code twice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed unneeded graphic in tutorial menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Blum's puzzle could be inadvertedly solved by spamming the 'esc' key",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Switch icons - should reflect reversed a/b now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made Cecil's step puzzle more forgiving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug where player could run outside of the bounds of a cutscene before it triggered after getting map off Cynthia",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If player skipped that cutscene, it will now trigger on reloading Crabb Island if story has not progressed further",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where after beating Big Catch tournament, bait was still being deducted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a warning on new game that it will delete progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
