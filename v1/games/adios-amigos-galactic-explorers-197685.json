       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crew-display sometimes showing incorrect images for docked space-shuttles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where you couldn't join with additional players after playing a round",
       "ps5ProOnly": false,
       "pcOnly": false,
