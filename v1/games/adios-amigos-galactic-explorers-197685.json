    {
     "title": "Release notes",
     "items": [
      {
       "text": "In-game menu with help and quit options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved support for non 16:9 monitors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Some users have experienced controller issues caused by worn (loose) thumb-sticks. this should no longer be a problem.",
