  {
   "id": "girls-of-the-tower-279532@major-2024-11-06",
   "gameId": "girls-of-the-tower-279532",
   "displayName": "Game Update - November 5, 2024",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-06T03:50:57.000Z",
   "notes": [
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue where magic cards could not be selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the magic attribute for the Decotine's Magic Class was incorrect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Character Adjustments",
     "items": [
      {
       "text": "Soul of the North Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Passive skill now triggers after only 4 normal attacks at all star levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Attack speed increases by 1% for each unit that dies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Bhuj Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Passive skill damage doubles after using the active skill (scaling as 2-4-8-16, etc.).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Guardian Archangel Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Passive skill no longer converts attack power and skill strength. Instead, when the Guardian Archangel is on the field, all allies receive damage reduction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Using the active skill enables the next skill to deal additional damage. This effect can stack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Light Elf Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Each Light Elf will increase the maximum health of all characters. Multiple Light Elves will have cumulative effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Nekomata Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Passive skill applies a “Sinister Mark” to the target. The number of targets scales with star level (4/6/8).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Active skill damage increases based on the number of Sinister Marks on the targets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Takemikazuchi Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Soul Bond bonus is set to 1 at all star levels. The Thunder Arrow now fires an additional shot for every 20 Soul Bond layers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bond Adjustments",
     "items": [
      {
       "text": "Holy Prayer Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "After a follower dies, instead of gaining an invincibility effect, they now receive overall damage reduction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
