  {
   "id": "girls-of-the-tower-279532@1.0.1.5",
   "gameId": "girls-of-the-tower-279532",
   "displayName": "Update 1.0.1.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-28T09:33:20.000Z",
   "notes": [
    {
     "title": "系统修复：",
     "items": [
      {
       "text": "修复了混沌弓手的技能释放问题",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "优化了打开图鉴界面的卡顿问题",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "修复部分剧情跳过导致的卡死问题",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
