  {
   "id": "electro-ride-the-neon-racing-137810@major-2021-04-27",
   "gameId": "electro-ride-the-neon-racing-137810",
   "displayName": "Electro Ride BIG #22 update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-04-27T17:01:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Sorry for late update I've been very busy with my dayjob release and starting new project.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this update I use a lot of players feedback and I hope you'll like it:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "updated physics engine",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "updated graphics engine - more frames per second and better optimization,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "smaller game size!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "a new model of car braking,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new handbrake model (more user-friendly),",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "track and curve flow repaired,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "steering reaction fixed,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "balance and cornering response and acceleration have been fixed,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "flying cars after a collision have been fixed,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Next update should be ready next month. I'd like to add some competetive improvements and online elements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "And please a leave a review if you've enjoyed the game, it helps me so much!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "See you on the roads!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Sylwester Osik",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Photo: @ExusOne from Community Hub",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
