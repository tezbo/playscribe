  {
   "id": "electro-ride-the-neon-racing-137810@major-2021-10-27",
   "gameId": "electro-ride-the-neon-racing-137810",
   "displayName": "The game is back from death!!! Halloween Update with new event!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-10-27T22:41:12.000Z",
   "notes": [
    {
     "title": "Hello, Racers!",
     "items": [
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For few months I slowly fixed many bugs and phisics leaks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Inside my little Halloween event you can find",
     "items": [
      {
       "text": "Halloween themed track on the hills of Prague with ghost mode, Some Skoda and own Steam Leaderboard to compete with rest of the players!: All of this you can find under special button in main menu.: I hope you'll like it. Please leave a review to help other players to find this game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Don't keep it to yourself!",
     "items": [
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you on the road,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Electro Ride Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
