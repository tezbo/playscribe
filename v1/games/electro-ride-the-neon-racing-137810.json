  {
   "id": "electro-ride-the-neon-racing-137810@major-2021-01-27",
   "gameId": "electro-ride-the-neon-racing-137810",
   "displayName": "Electro Ride BIG #20 update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-01-27T10:28:45.000Z",
   "notes": [
    {
     "title": "Hello, Racers!",
     "items": [
      {
       "text": "Photo-mode screenshot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "In this \"Big Update\" I prepare",
     "items": [
      {
       "text": "New \"Podium to Win\" career mode - now you can unlock new tracks when you are on the podium (win on 1, 2, or 3 race position)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Leaderboards focused on cars - now you can easly see you are the best driver in this car.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "driftmode balance - you can use handbrake to initialize slide,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed steering input bugs - now steering will be much smoother,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "car handling fixes - faster and better steering cars,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "smoother screenshake - now is lighter and shouldn't drop fps,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "lot of Hud fixes,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Varna and Warsaw tracks fixes - now you have walls on few dangerous corners,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial on new fastest Varna autodrome, not used in story mode,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI cars have better paths and speed balance,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added special Photo-Mode - now you can pause the game and catch the best moments of your races on photo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More Optimisation!: The full game is still growing and I'm keeping it updated, now it's the 20th update.: I hope you'll like it. Please leave a review to help other players to find this game.: To be a part of the Electro Ride Community please join our Discord: https://discord.gg/5ftEyBN4bv: See you on the road,: Electro Ride Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
