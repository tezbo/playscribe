  {
   "id": "the-bearer-the-last-flame-265469@01.000.014",
   "gameId": "the-bearer-the-last-flame-265469",
   "displayName": "Patch 01.000.014",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-05T15:01:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Smooth camera management",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera field of view changed from 32 to 47 to feel comfortable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New settings for Graphics and Display",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New setting for voices volume",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New setting to turn on/off the own player light",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New setting to turn of background music except for bosses combats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved physique management to avoid conflict penetration in geometry when enemy dies and enters into ragdoll mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug in player UI to refresh correctly the amount of stored items in quick slots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Linked to the overall volume of SFX are some sounds that were left out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The shader preheating system has been implemented at game startup and upon exiting the settings if changes are made to the graphics settings section, in order to prevent stuttering during gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The particle system has been improved so that it is not penalized in battles with many enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that allowed a wizard to cast orb or missile spells against the player and, on the missile's journey towards the player, be interrupted by another enemy in the way, ultimately transferring the damage to the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
