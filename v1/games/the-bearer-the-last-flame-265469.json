  {
   "id": "the-bearer-the-last-flame-265469@01.000.018",
   "gameId": "the-bearer-the-last-flame-265469",
   "displayName": "Patch 01.000.018",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-12T05:58:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue that in rare circumstances could cause the loss of some inventory items. The grace of the flame of Hyperborea will reward you for this unpleasant deed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you think you're still missing undiscovered weapons to complete trophies, revisit the chests in the Merlyn's Castle and Guts of the Volcano areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that in rare circumstances could cause the boss to move and not be present in the combat arena",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some visual fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ladder fixed in Swamp of the lost souls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
