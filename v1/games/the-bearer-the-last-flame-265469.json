  {
   "id": "the-bearer-the-last-flame-265469@01.000.021",
   "gameId": "the-bearer-the-last-flame-265469",
   "displayName": "Patch 01.000.021",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-16T17:59:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed some ladders that prevented normal use when descending or reaching the top.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved the save system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Restored the inventory of the merchant Kyrillus, which had been mistakenly removed and prevented players from completing some trophies based on weapon sets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized save times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some areas of water or poison that should have caused instant drowning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some areas where the player could fall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some areas where falling should have caused the player to die, but this could not happen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved gamepad button response times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added gamepad vibration for enemy impacts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
