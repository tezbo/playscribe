  {
   "id": "the-bearer-the-last-flame-265469@01.000.026",
   "gameId": "the-bearer-the-last-flame-265469",
   "displayName": "Patch 01.000.026",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-24T13:27:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added New Game+.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Load your save file and the New Game+ option will appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New enemies in ghost mode in New Game+.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rebalanced the damage system. The game isn't easier, but it prevents instant kills from excessive damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a bug that prevented the spider minions that spawn on several bosses from moving around the map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
