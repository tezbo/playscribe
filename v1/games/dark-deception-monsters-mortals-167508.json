  {
   "id": "dark-deception-monsters-mortals-167508@1.4.2",
   "gameId": "dark-deception-monsters-mortals-167508",
   "displayName": "Update 1.4.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-03-24T15:42:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here's a list of changes we've made for this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "Added a new UI element that shows the currently applied buffs/debuffs (this is shown for the owning player as well as on top of the health bar of other players)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Brought back the ability for Support Mortals to heal other mortals with their Heavy Attack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Silent Hill DLC",
     "items": [
      {
       "text": "Reduced Shard Target 1000 > 850",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed two Air Screamers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Heather's Ultimate affecting healing items and abilities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Monstrum DLC",
     "items": [
      {
       "text": "Fixed Prisoner's Ultimate not slowing down affected characters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Alarm Sound sometimes persisting after Trap Time ended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "AI characters can now enter the Control Room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Stranger Sewers",
     "items": [
      {
       "text": "Increased Doom Ducky's damage and collision hitbox",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
