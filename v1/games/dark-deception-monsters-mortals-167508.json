  {
   "id": "dark-deception-monsters-mortals-167508@1.1.5",
   "gameId": "dark-deception-monsters-mortals-167508",
   "displayName": "Update 1.1.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-11-05T17:34:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have updated the game with some nice quality of life features and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Make sure to restart Steam if you do not receive the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "We have added an information feed widget that should keep all players up to date with important information throughout the match. (kills, respawns, ragequitters etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Monsters in Maze Escape will now always see mortals through walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mortals in Maze Escape will now always see other mortals through walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ghosts will now see everyone through walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shortly after spawning, the player will be invulnerable to all damage for a few seconds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kills made by the Clown Gremlin Clones will now count towards the player who spawned them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Clown Gremlin Clones are now able to be killed in 5 hits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chef Monkeys will not block the player anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Total length of Maze Escape has been shortened 8 > 7 minutes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Mortal Team in Maze Escape will lose up to 25 shards every time they die (from 15)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And other small bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
