  {
   "id": "dark-deception-monsters-mortals-167508@major-2020-11-10",
   "gameId": "dark-deception-monsters-mortals-167508",
   "displayName": "Elementary Evil Update is coming in November!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-11-10T02:57:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It's time to head back to school in Monsters & Mortals! A new form of evil is now lurking in the school hallways and Agatha is up to her usual tricks as well. Watch out for traps! The Elementary Evil map update will arrive before the end of November, so look for the update soon! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
