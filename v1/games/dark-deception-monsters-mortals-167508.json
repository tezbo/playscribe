  {
   "id": "dark-deception-monsters-mortals-167508@post-2026-10-17",
   "gameId": "dark-deception-monsters-mortals-167508",
   "displayName": "Two new game modes!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-17T06:49:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 3.1.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Two new game modes added to game (King of Monsters & Shard Smash) for World, Friend and Solo Play:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "King of Monsters",
     "items": [
      {
       "text": "Players must locate the crown placed in each map to become the King!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As the king you can collect shards and you gain buffs but these don’t last forever.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other players must locate the king and destroy them to become the king.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players with the most shards are the winners!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Shard Smash",
     "items": [
      {
       "text": "Mortals must work together to destroy shard piles placed within the map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Monsters must try and stop Mortals from destroying the shard piles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When all shard piles are destroyed it become a last person standing, if you die there is no coming back to help your team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If Mortals overthrow Monsters they win, if Monsters protect shard piles or win the last person standing they win.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Misc",
     "items": [
      {
       "text": "General bug fixes for gameplay and bots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
