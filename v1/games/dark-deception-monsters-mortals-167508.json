  {
   "id": "dark-deception-monsters-mortals-167508@1.9.8",
   "gameId": "dark-deception-monsters-mortals-167508",
   "displayName": "Patch 1.9.8",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-06T16:33:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've patched the game to ver. 1.9.8. Here are the latest additions and fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an updated pause menu back into the game. Quitting is allowed during gameplay in Friend Play, but not World Play. This is to reduce player rage quitting during public matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Stale session fix for World Play. The fix gives a better chance to join matches, because it joins best ping sessions first. This greatly reduces getting kicked back to the main menu for \"network errors\" or \"unknown reason\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed broken boss pathing in all base game & DLC maps. This includes characters with an ultimate ability that uses pathing (example - Silent Hill's Robbie the Rabbit).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Blood moon sky has been added to the Coma 2: Vicious Sisters DLC. Whenever Boss Time triggers, the sky will change to a blood moon as the Butcher begins his hunt.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buffed the Butcher in The Coma 2: Vicious Sisters DLC. He is now more aggressive and does more damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
   "digest": {
