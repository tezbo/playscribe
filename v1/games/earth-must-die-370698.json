 "releases": [
  {
   "id": "earth-must-die-370698@major-2026-02-03",
   "gameId": "earth-must-die-370698",
   "displayName": "First update since launch!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-03T16:46:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been listening closely to your feedback & thoughts since we launched Earth Must Die, and we're very happy to be dropping our very first update, with some bug fixes & quality of life changes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's what you can expect",
     "items": [
      {
       "text": "Fixed an issue where opening the main menu while dialogue choices were being displayed could cause them to be off-centre",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the ability to control VValak's interaction UI with the right stick on controllers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased the size of the Simplified Chinese font atlas to fix missing glyphs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue that could cause the cursor on the Map to stop showing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some hyperlinks in the Milkipedia entry for Physus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaked some timings in the puzzle where the Mayor drops his grotty novella",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45797123/0080c722f1a3cca6fe6358ab1dd1817b57669158.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for sending over your feedback & reports, we wouldn't be able to lock down these changes as fast otherwise! Please keep sending over anything you might find, or just general feedback too!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'll see you soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
