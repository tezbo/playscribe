  {
   "id": "adorable-adventures-353276@6",
   "gameId": "adorable-adventures-353276",
   "displayName": "Update 6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-12T14:01:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have another update, focused on improving performance, especially for the medium and high quality settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On top of that, Boris could use nice way to express himself. So he can now Oink on command. Use L3 or B on your keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "There are some hints in the distant environment of what is going to happen in the full game as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Short video to demonstrate the feature (and maybe reveal a hidden smellable): [dynamiclink href=\"https://youtube.com/shorts/wlOVr6LxxE8?feature=share\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue to improve, thanks to your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wild Sheep Studio team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
