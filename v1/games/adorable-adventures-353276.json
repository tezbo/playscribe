  {
   "id": "adorable-adventures-353276@4",
   "gameId": "adorable-adventures-353276",
   "displayName": "Update 4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-20T15:34:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We made some further improvements to the demo. In this version (which is now numbered in the menu also), you will find the following improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unstuck option in pause menu (When you get stuck somewhere, you can reset your position and continue the game)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolution is now clear, and has better options: full screen is indicated with screen percentage and windowed has selectable resolution",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some localization bugs fixed, fixed minor issues with sidequests not showing the correct content/state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Detect when the game is running on SteamDeck and select the correct graphics settings automatically",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
