  {
   "id": "adorable-adventures-353276@5",
   "gameId": "adorable-adventures-353276",
   "displayName": "Update 5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-06T11:09:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have updated the demo today. The new version has some fixes and some new things:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keyboard and mouse support (you can change the sensitivity for the mouse/camera in the options)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Autosave system (can still save manually)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Performance improvements for all quality settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localization fixes and repeated phrases for quests",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for steamdeck to automatically set the correct quality",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "And there is new feature for Boris: he can now oink on command. Press L3 or B to make him go Oink.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your support and feedback! Keep it coming.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wild Sheep Studio team: [img src=\"{STEAM_CLAN_IMAGE}/45687250/3956c2ab1fa0b20a54ea791f297420c753ba3a19.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
