  {
   "id": "adorable-adventures-353276@1",
   "gameId": "adorable-adventures-353276",
   "displayName": "Hotfix 1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-10-13T17:48:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello All,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your feedback so far! With your feedback we are able to improve the game. ːsteamhappyː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have made a first update to address some of the issues you have raised:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vulkan driver required message should now be gone, and you have the option to select DirectX (Windows) or Vulkan (Steamdeck)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Camera system has been improved to avoid it going through the ground while running/sliding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera default sensitivity has been lowered to create a more fluid experience by default (but this can be adjusted in options!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More responsive in-game UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Polished and improved the level layout",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you so far. We still have some more changes to do, among which the most important ones:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "stop boris from going into geometry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "robust savegame system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "These will be coming asap",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the meantime, we continue to monitor and improve the game, so expect frequent updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
