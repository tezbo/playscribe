  {
   "id": "vision-soft-reset-113732@1.1.0",
   "gameId": "vision-soft-reset-113732",
   "displayName": "Update 1.1.0",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-05-05T12:42:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "+ Upgraded Unity version to 2019.4.17f1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Changed architecture to x86_64",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Fixed numbering issue with Seudar Creature Cards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Updated logos in the splash animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Migrated save files from \"Mark Radocy Games\" directory to \"Seafloor Games LLC\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Possibly fixed Oracle appearing upside-down when retrying a boss fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Disabled distortion effects for the water and boiling water pools.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Achieving a speed boost in an underground level is now easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Changed how the heat distortion effect works.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Shaking effect will no longer persist when the game is paused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Sherivice's cry is quieter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Sherivice gives a hint to the wind puzzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Fixed bug related to encountering the final boss during the meltdown vision.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Added a hint for a room that requires use of the claw attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Made the underwater ghost chase a little easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
