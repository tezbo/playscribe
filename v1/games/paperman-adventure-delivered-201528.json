       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the screen showing a colourful explosion when pressing alt-tab at the wrong time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple wind tunnels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
