      {
       "text": "Fixed item throwing directions by characters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Paperman's rotation bug, when using lock-on during boss fights",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed camera in the second fight against the big dragon not following the player, when the first player is not Paperman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed meteor attack in the second fight against the greedy dragon colliding with the ceiling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved Tutorials",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
