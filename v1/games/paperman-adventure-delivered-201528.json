      {
       "text": "Improved consistency with picking up packages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved enemy pathfinding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved many cameras",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved stick-sensitivity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
