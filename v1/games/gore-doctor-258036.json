  {
   "id": "gore-doctor-258036@1.10",
   "gameId": "gore-doctor-258036",
   "displayName": "Update 1.10",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-03-25T12:18:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello all Gore Doctor fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to inform that a new version of Gore Doctor is available for Windows (with Linux to follow within an hour or two).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Here are the main changes",
     "items": [
      {
       "text": "Solved issue when in certain scenarios some items from the inventory would disappear;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a few hints in \"Awakening\" and \"Sanctum of Madness\" locations;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue in \"Sanctum of Madness\" when after providing electricity to the door, the hint still informed that one needs to provide electricity;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added extra textures to enemies clothing;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Using Alt-Tab now pauses the game, so the game does not force moving to the next scene after loading;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed number of bullets in the pistol on \"Awakening\" location so it matches all other scenes;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some other small fixes here and there.: Today you can also expect an extra update (1.11) that will take care of some minor issues.: Thank you for your support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
