  {
   "id": "super-crazy-rhythm-castle-258252@major-2024-08-16",
   "gameId": "super-crazy-rhythm-castle-258252",
   "displayName": "SUPER CRAZY RHYTHM CASTLE – UPDATE ANNOUNCEMENT",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-16T12:04:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you to everyone who’s been playing! We’ve heard your feedback about some levels being too tough, and we’ve made a few adjustments to address the worst offenders.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the highlights",
     "items": [
      {
       "text": "Act 1B: Nectar (Nectar Recipe Level)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This was far too difficult, requiring near perfection to complete.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changes: Vine minims will no longer spawn at all, and all recipes require fewer ingredients, particularly when playing with more than one player. This should make it more reasonable to complete this level and move to the next part of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Act 1: Flavour (Meat Recipe Level)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This was one of the hardest levels to get 3 stars, despite being fairly early in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changes: Recipes in the latter half of the level now require fewer ingredients, making 2 or 3 stars easier to achieve.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Central Mainframe Level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This level was particularly punishing for teams, with rhythm mistakes causing lots of security alerts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changes: Rhythm mistakes will now contribute much less to causing alerts in higher player counts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Thief Prince Level (Prision Tower)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The spicy combo challenges stood out as tricky to complete, especially in multiplayer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changes: Maintain spicy combo challenges now have lower score requirement, particularly for higher player counts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "We have also made some minor changes",
     "items": [
      {
       "text": "School Trip Level: Fixed a bug where vines would stop player exploding the toilet statue even after being cleared.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cold Storage Level: Added arrow highlights to the Thief Prince the first time you need to lead him to a lock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Music Lab: Removed camera bobbing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Castle Lobby: Fixed a bug where sometimes earning the Bean Trumpet did not save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that sometimes caused the game to start with no players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that prevented joining an online game when accepting an invite without the game open",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
