  {
   "id": "hauntsville-293335@major-2025-06-26",
   "gameId": "hauntsville-293335",
   "displayName": "Railroad Expansion Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-26T16:56:47.000Z",
   "notes": [
    {
     "title": "The Railroad Expansion Update is here!",
     "items": [
      {
       "text": "Build a railroad across the Landscape or between you bases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With a coal powered cart you are able to transport lots of items from point A to point B.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The cart has it's own inventory that can be filled up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Four types of Rails (Left Turn, Right Turn, Uphill, Downhill) allow a dynamic track placement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This Update also contains bug fixes!",
     "items": [
      {
       "text": "Rainbarrel water levels are saved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Growth levels of planted crops are saved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Multiplayer sound fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mulitplayer UI fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Replaced the \"Sharkheads\" with more suitable Character",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
