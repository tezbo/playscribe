  {
   "id": "hauntsville-293335@1",
   "gameId": "hauntsville-293335",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-03-11T20:37:22.000Z",
   "notes": [
    {
     "title": "I made a quick update fixing some of the problems that have been reported so far",
     "items": [
      {
       "text": "Short loading screen (4 seconds) for fast travel to prevent players from falling through the ground.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Longer dismount time of 60 seconds for placed building parts. (Press X to remove placed part)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Furnace doesn't overlap chest and can process Gold Nuggets to Gold Bars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Audio levels of tools has been adjusted to be more balanced.: I will continue to make updates and try to fix reported bugs as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Things I will address in the next Update are",
     "items": [
      {
       "text": "Performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Any other problems with overlaps of interactable items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other bugs that are reported.: Thanks for your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
