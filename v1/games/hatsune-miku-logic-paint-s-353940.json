  {
   "id": "hatsune-miku-logic-paint-s-353940@major-2026-01-13",
   "gameId": "hatsune-miku-logic-paint-s-353940",
   "displayName": "Free Update - Assist off and special puzzles",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-13T02:15:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We truly appreciate your feedback. This free update, inspired by community feedback, brings tougher challenges and greater control to your gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Assist Feature Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new setting, “Assist Function: Fully Off,” has been added for players who want a more challenging experience. When enabled, the following features will be disabled:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Automatic color changes for filled numbers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Automatic X placement for completed rows",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Autocorrecting of fill-in error",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hint feature usage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. New Special Puzzle Added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New puzzles have been added to the “Special Puzzle”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Solve them all to unlock and display a new special illustration in your room!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45693931/b66c71d9a49ada32eb9d26f92a7d61b9899bf6d3.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy the winter update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Whether you’re decorating your room, trying on new outfits, or tackling tougher puzzles, we hope this update brings even more fun and creativity to your time with Hatsune Miku Logic Paint S+.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thank you for playing — and please keep sharing your feedback with us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
