  {
   "id": "hatsune-miku-logic-paint-s-353940@1.0.1",
   "gameId": "hatsune-miku-logic-paint-s-353940",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-09-18T04:00:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In this update we have added improvements for the users on Steam Deck to be able to exit the game easier! We also fixed the Steam achievements bug as well!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "· You can now press the “View” button on the Steam Deck at the Title Screen to bring up the option to exit the game",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "· You can now press the B-button at the Home Screen to go back to the Title Screen on the Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "· Fixed a bug where the final achievement in Steam would not unlock under certain conditions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We thank the users for their valuable feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hope you continue to enjoy the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
