  {
   "id": "hatsune-miku-logic-paint-s-353940@major-2026-01-08",
   "gameId": "hatsune-miku-logic-paint-s-353940",
   "displayName": "Hatsune Miku Logic Paint S+ — Winter Update Arrives January 12!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-08T00:50:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A brand-new winter update is coming to Hatsune Miku Logic Paint S+ on January 12, featuring the “SNOW MIKU Sky Town” Premium DLC alongside a free update inspired by community feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Premium DLC: “SNOW MIKU Sky Town”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The “SNOW MIKU Sky Town” Premium DLC (priced at USD 4.99) adds a touch of winter magic with exclusive content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Premium DLC Content Includes",
     "items": [
      {
       "text": "■ Special “SNOW MIKU” Outfit for Miku",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Equip a special Snow Miku costume that instantly transforms Miku’s appearance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "(Available immediately after purchasing the DLC)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "■ New Outfit for All Characters: “SNOW MIKU Sky Town” Store Clerk Apron",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A charming winter-themed outfit that every character can wear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "(Available immediately after purchasing the DLC)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "■ “SNOW MIKU Sky Town” Themed Room Items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Decorate your room with 24 DLC-exclusive themed items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "(These items will appear as puzzle drops after purchasing the DLC)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "■ DLC-Exclusive Special Puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Solve a brand-new special puzzle inspired by Snow Miku Sky Town.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Complete all special puzzles to unlock and display a beautiful illustration in your room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Free Update: New Challenges Inspired by Community Feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Alongside the Premium DLC, a free update will also arrive on January 12, introducing new puzzles and a long-requested gameplay option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Free Update Includes",
     "items": [
      {
       "text": "■ New “Assist Function: Fully Off” Setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For players seeking a greater challenge, a new option allows you to completely disable assist features. When enabled, the following will be turned off:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Automatic color changes for filled numbers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Automatic X placement for completed rows",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Autocorrecting of fill-in errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hint feature usage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Additional Special Puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New puzzles will be added to the Special Puzzle category.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Solve them all to unlock a new special illustration for your room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The winter update is just around the corner, bringing cozy seasonal vibes, new challenges, and more ways to enjoy puzzles — decorate your room, dress up characters, and push your skills further!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
