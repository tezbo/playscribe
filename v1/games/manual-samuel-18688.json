 "releases": [
  {
   "id": "manual-samuel-18688@major-2025-04-28",
   "gameId": "manual-samuel-18688",
   "displayName": "💀 The Biggest Manual Samuel Update Yet – Out Now! 💀",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-28T16:45:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, manual breathers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The wait is over, our biggest update ever for Manual Samuel is here! We’ve overhauled the game with tons of quality-of-life improvements, bug fixes, and brand-new features to make Samuel’s awkward adventure even smoother (and weirder).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve also given Manual Samuel a technical facelift with a massive engine upgrade, better visuals, improved animations, and a brand-new audio system. The game now runs in borderless fullscreen, supports ultra-wide resolutions, and features better controller support. Oh, and did we mention? Some grandmas are now gangsters, coffee stains are actually a thing, and the dog? Better than ever.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Gameplay & Quality-of-Life Improvements",
     "items": [
      {
       "text": "Overhauled the game to fix numerous bugs and enhance the overall experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made on-screen hints less intrusive, with some removed due to gameplay tweaks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved tutorial sequences, especially for breathing and driving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Refined the Satan fight and made hell’s demons slightly easier to deal with.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Completely replaced the old achievement and leaderboard system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added 8 brand-new achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the UI for high-resolution screens and added ultra-wide support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "New controller layout screen in the pause menu, plus better default keyboard controls, AZERTY support, and meme layouts.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Snappier and more intuitive main menu navigation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Renamed \"Time Attack\" to \"Trials\", with two new game modes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Speedrun Mode – Race through the game as fast as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Challenge Mode – Complete special challenges during your run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Leaderboards now display the top 10 players in each category.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Technical & Visual Upgrades",
     "items": [
      {
       "text": "Updated the engine from Unity 5.6 to Unity 2022.3.57, improving performance and extending the game’s lifespan.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Switched to FMOD for improved audio and added new sound effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced animations, upgraded text rendering, and improved character visuals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rebuilt the particle system and introduced a new camera system with smoother transitions and better shakes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upscaled low-resolution assets to look sharper on modern screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Replaced deprecated localization and sprite rendering systems with native Unity solutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New (and totally necessary) Features",
     "items": [
      {
       "text": "Borderless fullscreen mode for a smoother experience.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "64-bit support for Windows and Intel64 + Silicon support for Mac.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Gangster grandmas (because why not?).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Better dog—he’s just objectively improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Revolutionary hair-dyeing mechanics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Game-changing coffee stain physics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Independent coffee cups, no longer bound to Samuel’s hands.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced controller vibration feedback for more immersive suffering.: This update is available now, so get ready to stumble, breathe, and blink your way through Manual Samuel like never before!: Stay manual,: Perfectly Paranormal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
