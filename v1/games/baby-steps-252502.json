  {
   "id": "baby-steps-252502@patch-2025-06-12",
   "gameId": "baby-steps-252502",
   "displayName": "Demo patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-12T14:08:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44225257/3c661f804e27d27e6aa18a55668c9828d21bf5ee.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hi, we've posted an update for the demo! Here are the patch notes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-improve impact sound sync",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-tamed birds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-level design tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-added discord link",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-attempted to fix no colliders on switch save slot bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-tiny camera tweaks to make it zoom in a little less aggressively",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-fixed japanese text problems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-default quality to low if your computer has less than 8 gigs of vram to try to avoid crashing on launch",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thanks so much for playing the demo! We have a discord now for bug reports, feedback and discussion: https://discord.gg/BabySteps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "photo credit: Dama in the discord",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
