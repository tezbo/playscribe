  {
   "id": "baby-steps-252502@7",
   "gameId": "baby-steps-252502",
   "displayName": "Patch 7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-25T19:23:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This is a small patch that fixes some issues and softlocks reported by players. We have a larger patch in the works coming soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a couple of terrain holes in the Z-loop point past the mountain at the end of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Put the first two rooms of the fortress on a different loading tile so that they load in earlier and can’t fail to be loaded when you arrive on slower hard drives.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Put an invisible collider under the bed in the fortress to stop lantern getting stuck when it rolls under there, sorry to the reddit user who suffered this fate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed gap under frozen stream in snowy area, south edge, nearby the crashed train",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where clear times over 24 hours would display as the wrong time in the credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where quitting after seeing a campfire scene could, in rare cases, cause you to get into a softlocked state in the snowy area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the time you spent in the credits was added to your clear time for determining the ‘most punctual person’ achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made slippery sand just a tiny bit easier to walk up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some other minor compatibility and visual tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
