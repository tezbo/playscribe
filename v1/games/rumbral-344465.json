 "releases": [
  {
   "id": "rumbral-344465@1.0.1",
   "gameId": "rumbral-344465",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-30T09:03:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi! Rumbral team here,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are very grateful for all the feedback we have received from you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are working hard to improve Rumbral, and that is way we've released a quick patch that addresses some issues frequently mentioned in reviews and streams:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Character feeling and controls",
     "items": [
      {
       "text": "Character controls have been improved to make them more responsive; turning and jumping are now more precise and faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Limited aerial rotation of the character to reduce the floaty feeling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A visual effect has also been added to the character's turning slide animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Factory Level",
     "items": [
      {
       "text": "We have noticed that many players get stucked on the deer chase section, so we have reduced slightly deer chasing speed and reduced some obstacle collisions in the way.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also deer searching time has been increased to give players a larger escape window.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The dragging horns deer is now a bit easier to dodge, but could should still be challenging.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added missing VFX to the deer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added missing SFX to the end of the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "General & minor fixes",
     "items": [
      {
       "text": "Fixed some collisions that allow players to skip some puzzles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed visual elements that could confuse players in some puzzles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed collectable images resolution in collectables menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45591792/1e68e7e6288eb35223707de63e4908144fe6de11.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you all for the support!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rumbral is still waiting for you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
