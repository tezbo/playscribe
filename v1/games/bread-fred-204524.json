  {
   "id": "bread-fred-204524@post-2024-06-03",
   "gameId": "bread-fred-204524",
   "displayName": "More bug fixing!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-06-03T14:19:10.000Z",
   "notes": [
    {
     "title": "New update fixing some bugs! Here is the full list",
     "items": [
      {
       "text": "You couldn't select a character after opening the assist menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You couldn't play after letting the game opened for a long time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Random \"wrong code\" error while typing the code",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Getting all singleplayer skins didn't unlock the achievement (you should obtain it if you re-enter the game)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The multiplayer pop-up now works with mouse",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You could still hear the main menu song in single player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You couldn't close the Fanart painting in online: Please let us know if more bug appear, we'll keep working on the game and solving everything we can",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
