   "id": "bread-fred-204524@post-2026-01-09",
   "gameId": "bread-fred-204524",
   "displayName": "Error Message and Capture Logs",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-01-09T18:30:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have pushed a small update for Bread and Fred.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update will show error messages and capture logs - users will be able to share those with us so we are able to identify and resolve issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To share these reports please contact our customer service team or create a ticket in the Atari Club Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
