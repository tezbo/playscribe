  {
   "id": "bread-fred-204524@patch-2024-05-27",
   "gameId": "bread-fred-204524",
   "displayName": "Bug Fixing Patch!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-27T18:45:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Last week we updated the game, adding Time trials and new achievements! (Not without breaking some things in the process though...)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "But it should all be fixed now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stuck in listening while trying to change a control!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The initial logos were missing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you unlocked the achievements before the update, now they should pop up in Steam",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated also Mac version so you can now play with Mac people: Hopefully, this solves all big issues, if you find anything else, please let us know!: Thank you for your patience and sorry for the inconvenience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
