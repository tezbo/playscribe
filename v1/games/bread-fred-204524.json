  {
   "id": "bread-fred-204524@post-2025-09-10",
   "gameId": "bread-fred-204524",
   "displayName": "Achievements fixed!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-10T10:05:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi, you all, it's been a while!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're here with a brand-new patch that addresses some issues with achievements and other bugs. Sorry it took us this much, but we've been busy working on ports and an online patch that should solve the connection issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the fixes",
     "items": [
      {
       "text": "FIXED: Beary well and Bear minimum achievements were unable to obtain",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED: You'll need to beat the game again to unlock the nuclear skins. Now, if you've already beaten the game, you should have the skins unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED: More small issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We'll keep working on fixing the connection issues, and if you find any new bugs or issues, please let us know!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
