  {
   "id": "bread-fred-204524@major-2025-03-07",
   "gameId": "bread-fred-204524",
   "displayName": "The Laboratory Update DOUBLES the content of Bread & Fred!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-07T18:02:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bread & Fred just got BIGGER with The Laboratory Update, bringing tons of new challenges and surprises!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new parallel map with +600 more meters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New map mechanics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New NPcs and lore to discover",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New secret zones & puzzles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A big secret at the end",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And that's not all... Bread & Fred is coming to PlayStation 5 & Xbox Series X|S this spring!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "The update is FREE for all players! To unlock the new Laboratory event, you’ll need to complete the base game first, so grab your friend or partner and start climbing again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
