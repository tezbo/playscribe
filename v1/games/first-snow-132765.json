  {
   "id": "first-snow-132765@1.01",
   "gameId": "first-snow-132765",
   "displayName": "Patch 1.01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-10-21T23:47:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! we're pushing out an update for First Snow now that should cover a good amount of issues reported in the past few months. Keep in mind your saves will likely break once you download the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.0.1 Patch notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-----------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected several typos and grammatical issues (thanks everyone who reported them!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added guest art piece from AcoTan that was missing in the initial release",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Corrected credits and social media links in the guest art gallery",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Touched up the modelling CG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Touched up blurred sprites that became too spooky on several occasions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the text bar disappearing on several occasions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed duplicate entries appearing in the text log",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crashes caused by the pre-splash logo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made the hidden achievement alternatively unlockable by creating a file called `secret-unlock.txt` in the `game` folder",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added detection and warning for broken save games due to game updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
