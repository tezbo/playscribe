 "releases": [
  {
   "id": "first-snow-132765@1.1",
   "gameId": "first-snow-132765",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-01-21T21:11:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! We're pushing out a big update for First Snow with partial voice acting! Check out our blog post for the full details on where to get our new merch! Keep in mind that, as before, updating will most likely break your save files.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "1.1 Patch notes",
     "items": [
      {
       "text": "Partial voice acting has been added. CGs and other notable events are fully voiced, while moments that use sprites use repeatable voice lines!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The volume slider for voice acting is now unlocked by default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, a voice emphasis toggle has been added to the menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Speech bubbles will now display when a voice line is played. \"...\" is shown when a fully voiced line plays, while \"!\" is shown when a repeatable line is used",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various small typos and other errors fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
