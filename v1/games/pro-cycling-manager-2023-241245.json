  {
   "id": "pro-cycling-manager-2023-241245@4",
   "gameId": "pro-cycling-manager-2023-241245",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-21T08:03:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Cyclist friends and bike fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update is available for PCM today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES 4",
     "items": [
      {
       "text": "Freshness/recovery system improvements during stage races: freshness decreases more slowly now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Freshness/recovery system improvements during stage races: green energy gauge get less reduction for a given freshness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remove a duplicate effect of fatigue during stage races in one-off mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Race Gameplay/Physio: remove an effect that caused riders to have gradual decrease in watts during their second half of their green bar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clean news on “month turn” if you have more than 5000 news to avoid a possible but rare block of the game with some mods.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix a 3d-race crash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Modders request feature: if you have a U23 team with no real main team (link = team 119/free agents), the country set for transfer policy will be the U23 team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix a bug in the AI U23 draft: Sponsor's regions were not taken in account.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "AI U23 draft: Small tuning to give a bit more importance for sponsor's regions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "WHAT'S COMING NEXT",
     "items": [
      {
       "text": "Improve AI on short and easy hilly classics: early breakaways win too often",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Team Time Trials: improvements and fix problems with teams often splitting in different groups after several kilometers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Available now on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
