   "id": "pro-cycling-manager-2023-241245@6",
   "gameId": "pro-cycling-manager-2023-241245",
   "displayName": "Update 6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-20T16:09:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Cyclist friends and bike fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A short update is available for PCM!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "Race (Team-Time-Trial): Fix a possible classification difference between provisional race rankings and latest results page. It is now the 4th rider on the team who determines the team’s time for TTT rankings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pro Cyclist: Fixed the bug which did not reset the Pro Cyclist points at the start of the new year. In order to maintain balance, the points awarded according to Pro Cyclist’s level have been revised slightly downwards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
