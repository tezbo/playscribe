   "displayName": "First update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-13T13:13:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We just pushed the first fixes for Pro Cycling Manager 2023",
     "items": [
      {
       "text": "* Fix a possible crash during race's loading",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Fix Crash in the calendar page when you added or removed a race and your U23 team was registered",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Fix the bug of the train of sprint with your sprinter who gets drop when the pilot launch his sprint",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Improve Top GC leaders choice of goals (more chances to target Tour de France)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Improve Young riders progressions (<23 years old)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Fix the bug of the DB'size",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Fix: Selecting \"Climber\" as second axis does not give the proper bonus in the training specialisations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Add missing locs for 🇵🇹 🇪🇸 🇩🇰 🇳🇴 🇳🇱 🇩🇪 🇮🇹 (was 🇬🇧 before)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
