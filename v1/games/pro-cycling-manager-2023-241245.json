  {
   "id": "pro-cycling-manager-2023-241245@5",
   "gameId": "pro-cycling-manager-2023-241245",
   "displayName": "Patch 5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-10T13:59:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Cyclist friends and bike fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update is available for PCM in Open Beta!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you're interested to try this update before it goes live on the public servers, here is how to join the Open Beta:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Open Steam > Library",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Right-click on Pro Cycling Manager 2023 > Properties",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select Beta and select \"open-beta\" in the beta participation dropdown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "Pro Cyclist: Fix \"SuperLeader\" skill's bug which did not offer the bonus for the teammate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI/Race: Fix the bug where early breakaway won nearly everytime on small continental races with slighty hill relief.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Race (Individual Time-Trial): Fix energy “exploit” during Mountain Time-Trials (same fix as on patch 3 but for ITT's).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Race (Team-Time-Trial): Improve AI: fix riders which were often dropped and most teams exploded because of too big differences between bad and good time trialists.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Career: Improve rider's decline: now decline happens a bit earlier than before and few riders may have a very early or very late decline.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Career: Improve balancing for the young riders who stops their career early: no more juniors 2) Riders with low potential will tend to end their career but in a less systematic way and more dependent on their age (a low potential at 20 years old will be less likely to retire than a 25 years old rider for example).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Career: Fix victory's counter in the rankings'page which was not reset at the start of the new year.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Career: Fix victory's total in rider's page (Career tab), the number was sometimes not coherent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DB: Optimize career's sizes/palmares.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
