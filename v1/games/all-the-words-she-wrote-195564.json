   "announcedAt": "2024-09-19T19:19:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I'm writing a quick post to let you know that I've uploaded a new build of All the Words She Wrote which fixes a handful of typos that were pointed out by people on the Steam community page and in my Discord server. Thank you very much to everybody who reported any typos; the game should be more polished now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, if you find more typos (or any bugs) in this build, please feel free to let me know, and I'll try to upload a new build in a reasonable timeframe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you once more for your support! It's very much appreciated!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ebi x",
       "ps5ProOnly": false,
       "pcOnly": false,
