  {
   "id": "run-from-mummies-263873@1.00.04",
   "gameId": "run-from-mummies-263873",
   "displayName": "Patch 1.00.04",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-12T16:42:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Quick patch with a few fixes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various small pathing cleanups so scarabs don't get stuck as often. Silly little critters!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pathing fix where sometimes the mummies would just stop running and stand in place. Though this was probably appreciated in some tense situations...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a couple murals that were hard to get with Brick's camera",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made a secret in one room SLIGHTLY more obvious :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some chopper statues had missing rubble... but no more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Region 3 base camp camera area fixed so it doesn't show so much black space.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Turns out if you beat a region, went to the fun house, then progressed to the new region... it would spawn you outside the fun house in the new area instead of in the proper region starting spawn point. Fixed!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you crashed into the photographers in Itiner-rally, they'd just give up taking pictures! Now they're more resilient.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor subtitle and VO alignment fixes in late cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor optimizations to help steam deck performance when low battery",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Bosses slightly harder... people were beating them first try too often!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tour Buddy bandages boost now yields 2 health per bandage instead of an extra bandage pickup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
