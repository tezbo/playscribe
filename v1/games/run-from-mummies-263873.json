  {
   "id": "run-from-mummies-263873@major-2024-10-04",
   "gameId": "run-from-mummies-263873",
   "displayName": "Demo Update Out Now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-04T17:36:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've updated the demo for Run From Mummies!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As we approach the 1.0 launch of the full game, here are some changes you can find in the demo:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👕 Added our first new Tourist Outfit - try and find it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎮 Fixed some issues with unplugging & reconnecting controllers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📸 Reduced flash mode for folks who don't like all the bright lights!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📈A few optimizations and a quality low/medium/high selector.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remember that we'll be taking the demo offline on Run From Mummies launch day, so give it a shot while it's still free to try!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy tourist!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
