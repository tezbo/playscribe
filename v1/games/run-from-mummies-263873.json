  {
   "id": "run-from-mummies-263873@1.00.07",
   "gameId": "run-from-mummies-263873",
   "displayName": "Patch 1.00.07",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-06T22:52:36.000Z",
   "notes": [
    {
     "title": "Quick patch primarily addressing later portions of the game",
     "items": [
      {
       "text": "Mummies and enemies now all slightly faster to compensate for the arm up nerf.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue causing the first boss to not attack as often as intended, especially when being photographed quickly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the perfect tour achievement was being rewarded incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various minor collision issues in some levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cleanup in levels in regions 5 and beyond to allow better backtracking to collect missed ankhs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Damage area for enemies on the spike pressure plates is slightly larger.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
