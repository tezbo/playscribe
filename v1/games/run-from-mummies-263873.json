  {
   "id": "run-from-mummies-263873@0.5.0",
   "gameId": "run-from-mummies-263873",
   "displayName": "Update 0.5.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-09T16:58:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Tourists!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get your camera ready, the Run From Mummies Demo has gotten a pyramid-sized update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What’s New",
     "items": [
      {
       "text": "10 new rooms added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "2 new tourists to unlock Jasvir and Ricardo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "First boss fight: Thutmose",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Fun House room: Mummy Blasters",
