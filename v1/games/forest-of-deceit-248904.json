 "releases": [
  {
   "id": "forest-of-deceit-248904@major-2026-09-28",
   "gameId": "forest-of-deceit-248904",
   "displayName": "Localisation Update Out NOW!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-28T15:30:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44023760/4a42ee2782038bb212149cf2174d1c152e622663.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When we released the game earlier this year, one of the most frequently asked questions was: “When are you going to localise the game to other languages?”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Forest of Deceit is a social game based on conversation and trying to guess if someone is an Innocent or a Traitor based on their behaviors; so any mistake when reading a button, or a delay in interacting, can be misinterpreted by other players in a frustrating way. On top of that, accessibility is very important to us -- Forest of Deceit is meant to be played by all kinds of people, from all ages and backgrounds. So having the game available in as many languages as possible to remove any friction was essential to us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That’s why we are very happy to announce today that we are releasing localisation support for German, French, Spanish, Brazilian Portuguese, Simplified Chinese, and Italian. We hope this helps more and more people to play Forest of Deceit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Oh, and another thing - just like how no AI of any kind was used at all in the making of the base game, we wanted to let you know that we also haven’t used it for this localisation patch. Our heartfelt thanks to our talented translators for their hard work!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PATCH NOTES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "● Added localisation support for the following languages",
     "items": [
      {
       "text": "German",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "French",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Spanish",
       "ps5ProOnly": false,
