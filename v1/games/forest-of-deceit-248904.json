       "category": "new"
      },
      {
       "text": "Brazilian Portuguese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Simplified Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Italian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "● Other various minor bug fixes.",
       "ps5ProOnly": false,
