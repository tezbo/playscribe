  {
   "id": "echoblade-166752@1.5.0",
   "gameId": "echoblade-166752",
   "displayName": "Update 1.5.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-13T16:11:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 1.5.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-----------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Key Holders that are attached to a wall will no longer glow after the key has been picked up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional sound effects have been added when blocking an attack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Perk menu has been adjusted to cause less confusion. Transparency of some icons have been adjusted. New sound effect are also present.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue with perks not applying after unlocking them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with ESC key not working as intended within certain menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted experience curve to level up character",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed issue with duplicate skill points being awarded",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with player not being able to pick up keys from dead guards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with arrows not applying damage immediately after contact",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
