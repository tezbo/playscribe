  {
   "id": "echoblade-166752@1.4.0",
   "gameId": "echoblade-166752",
   "displayName": "Update 1.4.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-08T20:57:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 1.4.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-----------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "EchoKnight now carries 8 arrows by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More arrows can be found in various levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A lot of alcoves have been removed from various levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some larger rooms have been decreased in size to avoid the player from getting lost.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More environment objects (benches, altars, chandeliers, pillars, torches, rock piles, buckets, medieval torture devices, chains, breakable barrels, breakable walls) have been added to all levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A smoother echo effect has been applied for the torches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The echo effect from jumping has been reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slightly tweaked double tap input for controllers to require more precision",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various voice lines have been adjusted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Healing will activate quicker when not moving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fast travel map has been updated to show if a Main Gate Key has been picked up from each level or not. If the selected level is highlighted with gold, there is still a key to pick up!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
