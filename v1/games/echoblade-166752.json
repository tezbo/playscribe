  {
   "id": "echoblade-166752@1.1.0",
   "gameId": "echoblade-166752",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-23T13:44:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Been adding lots of new stuff to the game after getting some feedback from other players and just some other things I wanted to add but didn't get time to before releasing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy the new update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.1.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-----------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed trapdoor leading to infinite abyss in West Dungeon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Basic enemy damage animations have been altered. Enemies now step backwards and have less \"stunned\" time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Giant spike ball will only do damage if it is rolling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The \"Trickster\"'s voice lines have been fixed after killing or not killing him",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed subtitles clearing too early",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fading on default HUD health and stamina bars are now an exponential function instead of a linear function",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug where Claborn was able to get out of his cell",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Perk menu now disables items you have already unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed navigation issue in Perk menu for keyboard and controllers",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "New voice actor for NPC that talks about poison",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New voice actor for NPC that talks about lava and stairs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Slightly increased enemy opacity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"Keys\" in settings has been renamed to \"Key Bindings\"",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Page Up and Page Down have been added to list of bindable keys",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spike trap will produce an echo effect before launching spikes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Echoes have a slighter harder edge to their texture",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rocks produce less and smaller echoes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A few rooms in Level 1 have been made smaller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The first gate in Level 2 has been moved up to prevent players from getting lost",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Toggle Sprint option has been added in Settings -> Controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added HUD message that displays when the player is entering the next area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Running and walking echo distance has been slight decreased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Click noise echo fades a lot quicker",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new exit appears in Level 5 to gain access to 5 new levels!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new NPC by the main gate!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Piles of Bones have been added throughout the levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
