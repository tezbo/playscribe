  {
   "id": "echoblade-166752@1.2.0",
   "gameId": "echoblade-166752",
   "displayName": "Patch 1.2.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-31T13:48:19.000Z",
   "notes": [
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Localized in 7 additional languages! Spanish, French, German, Portuguese, Chinese, Korean, and Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed glitches occurring with the Main Menu and Fast Travel menu using a controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed glitches with the Load Game Menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Barrels are now breakable and more of them have been added to various levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy sightlines have been reduced to encourage more stealth opportunities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemies holding a key have a larger collision box to prevent the key from not being able to be picked up after their demise",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player's \"Quick Noise\" distance has been improved but will fade quicker. There are additional sound effects as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"The Lost Chamber\" level has been slightly modified to prevent confusing backtracking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Modified Fast Travel map to show where Main Gate Keys are located",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fast Travel Menu will now show current location highlighted in red",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hitting enemies now produces some slight screen shake",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted some tutorial prompts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Skill tree menu has been cleaned up a little bit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Health Regen will only activate if the character stops moving for a few seconds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Echo effects from torches have been modified",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Walking echo distance has been slightly decreased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a slight delay to enemies attacks after they make a grunting noise",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased amount of rats and the noises they make........so please stop asking for more rats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
