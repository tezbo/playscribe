  {
   "id": "amanda-the-adventurer-2-272840@1.0.3",
   "gameId": "amanda-the-adventurer-2-272840",
   "displayName": "Update 1.0.3",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-22T23:59:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey A-fan-das!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have some great news!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have heard about your issues with using integrated graphic cards to try and run Amanda the Adventurer 2!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While it wasn’t supported initially, the team has been hard at work trying to fix this so more people could enjoy the game, and we have good news!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just released a new patch, and with that you should be able to use those bad boys to run Amanda the Adventurer 2 now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GO ENJOY!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have had to temporarily disable the demo to fix this issue in the demo as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
