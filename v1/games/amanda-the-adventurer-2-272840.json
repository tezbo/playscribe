  {
   "id": "amanda-the-adventurer-2-272840@2.1.6",
   "gameId": "amanda-the-adventurer-2-272840",
   "displayName": "Update 2.1.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-20T20:04:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've been hard at work bug hunting, and are back with an update with a handful of fixes! Here is the full list of updates:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the next tape not being accessible after completing “Let’s Practice Patience!”,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the binding of certain keys that would result in locking the player out of exiting the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated the end-game credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]If you come across any other issues, come tell us in the bug reporting channel on our Discord server or in the Steam discussion forums so we can help you out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
