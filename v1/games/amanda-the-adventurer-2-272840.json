  {
   "id": "amanda-the-adventurer-2-272840@2.1.2",
   "gameId": "amanda-the-adventurer-2-272840",
   "displayName": "Update 2.1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-16T16:57:52.000Z",
   "notes": [
    {
     "title": "Hey Everyone!",
     "items": [
      {
       "text": "With the console releases of Amanda 2 happening today, we are happy to say our porting partner was able to backport some quality-of-life changes to Amanda the Adventurer 2!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here is the full list of updates being brought to the game today:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added full gamepad support, including a virtual keyboard for responding to Amanda’s prompts",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Optimized lighting and shadowing in the library, resulting in a 4x-6x speed boost depending on your device",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized packaged data, resulting in a smaller download size and 1.3 GB less device storage space used",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized memory usage and loading times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In-game tutorial notecards now reflect customized button assignments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the option to detect and set the in-game language based on your device’s current language (the default for new installs)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added kana forms of Japanese text prompt responses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a rare case where videos would hang and not progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, thank you all for the tremendous support! If you come across any issues, come tell us in the bug reporting channel on our Discord server or in the Steam discussion forums so we can help you out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
