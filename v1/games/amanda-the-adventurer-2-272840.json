  {
   "id": "amanda-the-adventurer-2-272840@2.1.3",
   "gameId": "amanda-the-adventurer-2-272840",
   "displayName": "Update 2.1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-03T19:45:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've been hard at work bug hunting, and are back with an update with a variety of fixes and quality of life changes for the PC version of Amanda The Adventurer 2! Here is the full list of updates:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Increased the visibility of characters when using a virtual keyboard",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Keyboard keys on the input customization screen and in-game tutorials now sync to the selected language",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed bug where end credits would not play after beating the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where thrown objects became unreachable when thrown at the wood block puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]If you come across any other issues, come tell us in the bug reporting channel on our Discord server or in the Steam discussion forums so we can help you out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
