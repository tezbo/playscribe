  {
   "id": "amanda-the-adventurer-2-272840@major-2025-10-15",
   "gameId": "amanda-the-adventurer-2-272840",
   "displayName": "Amanda the Adventurer 2 Unity Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-15T16:15:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone, in case this update brought you here, the game has just been updated to include the fix for the Unity security vulnerability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update means the game is fully up to date and secure. You can read more about the Unity issue here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://steamcommunity.com/groups/steamworks/announcements/detail/524229329545071275\"]",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thanks for keeping your game updated, and as always, we appreciate your support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
