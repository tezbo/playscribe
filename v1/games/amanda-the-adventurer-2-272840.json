  {
   "id": "amanda-the-adventurer-2-272840@major-2024-10-30",
   "gameId": "amanda-the-adventurer-2-272840",
   "displayName": "Amanda the Adventurer 2 Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-30T15:08:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your patience as the team tackles those pesky issues that have been cropping up!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, if you encounter any new or ongoing bugs/issues, please don’t hesitate to visit the BUG REPORTING thread on Steam, email us at support@dreadxp.com, or let us know on our community Discord for an easier back and forth.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "In the meantime, here are the patch notes while the team continues working on the next update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed \"Meatman\" answer soft lock.",
       "ps5ProOnly": false,
