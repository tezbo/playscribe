  {
   "id": "yakuza-like-a-dragon-36550@1.03.1",
   "gameId": "yakuza-like-a-dragon-36550",
   "displayName": "Update 1.03.1",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2020-12-02T22:41:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Yakuza players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for diligently reporting issues that you encounter, this is very helpful to us as we continue to work on issues identified by the Yakuza community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released a Hotfix to 1.03 Today! Hotfix 1.03.1 addresses an issue that players are encountering which prevents the game from booting if all achievements are collected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Maybe you're that far into the game, maybe not, but this issue is resolved for when you do get there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
