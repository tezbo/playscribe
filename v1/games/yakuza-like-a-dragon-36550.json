  {
   "id": "yakuza-like-a-dragon-36550@1.07",
   "gameId": "yakuza-like-a-dragon-36550",
   "displayName": "Update 1.07",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-01-11T22:16:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello again, Yakuza fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.07, the most recent update to Yakuza: Like a Dragon is now live! Another free gift is included in the form of an Upstart Assistance Pack, as well as addressing issues reported regarding gameplay. Please take a look below for a full list of changes and bug fixes and as always, thank you for your continued patience and support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "-Adds an Upstart Assistance Pack as a gift.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "-Fixed an issue where the antialiasing option would not be saved in the OFF state.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-SEGA AGES games should now be fully functional for all players. We apologize for the delay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We'll continue to monitor your feedback for us to investigate!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
