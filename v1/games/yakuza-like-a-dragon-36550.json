  {
   "id": "yakuza-like-a-dragon-36550@1.03",
   "gameId": "yakuza-like-a-dragon-36550",
   "displayName": "Patch 1.03",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-11-30T23:54:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello again, Yakuza players! We are back with updates and fixes to help improve your place experience. Patch 1.03 brings some new changes and fixes to address reported issues from the community. Thank you for your help and continued engagement with us! We're also aware of other issues and will continue to investigate them. Thank you for your patience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Graphics Settings will now show the name of the GPU currently in use.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolution will now be no higher than 1920x1080/60Hz on first boot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the Upstart Assistance Pack 2 as a gift.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue where the game would not boot if certain characters were included in the installation folder path.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the WEAK icon would not appear when selecting an enemy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that would cause the game to crash on boot in rare cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
