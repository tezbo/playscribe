  {
   "id": "yakuza-like-a-dragon-36550@1.05",
   "gameId": "yakuza-like-a-dragon-36550",
   "displayName": "Update 1.05",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2020-12-14T22:34:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello again, Yakuza fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just released patch 1.05 Today, our most recent update to Yakuza: Like a Dragon. This update includes another gift in the form of an Upstart Assistance Pack, as well as addressing issues reported regarding gameplay. Please see below for a full list of changes and bug fixes and thank you for your continued patience and support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "-Adds an Upstart Assistance Pack as a gift.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "-Fixed an issue that prevented progression in the Final and True Final Millennium Towers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fixed an issue where Pachislot would not start if the file path contained certain characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Other minor bugs and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We'll continue to monitor your feedback for us to investigate!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
