  {
   "id": "yakuza-like-a-dragon-36550@patch-2021-02-26",
   "gameId": "yakuza-like-a-dragon-36550",
   "displayName": "Yakuza: Like a Dragon - Language Support Patch 2/26/21",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-02-26T19:16:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've added additional text/subtitle support for the following languages in Yakuza: Like a Dragon:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Russian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brazilian Portuguese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Traditional Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simplified Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Korean",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, please let us know your thoughts about this patch by responding to this thread. For everything else, please let us know over on the Steam Forums.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
