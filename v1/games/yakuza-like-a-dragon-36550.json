  {
   "id": "yakuza-like-a-dragon-36550@1.08",
   "gameId": "yakuza-like-a-dragon-36550",
   "displayName": "Update 1.08",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-01-19T11:17:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Yakuza fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.08, the latest update to Yakuza: Like a Dragon is live! We've included another free gift in the form of an Upstart Assistance Pack, as well as addressing issues reported regarding gameplay. Please see below for a full list of changes and bug fixes. Thank you to all the fans for your support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "-Adds an Upstart Assistance Pack as a gift.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "-Fixed an issue where the master volume setting was not reflected in SEGA AGES titles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We'll continue to monitor your feedback for us to investigate!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
