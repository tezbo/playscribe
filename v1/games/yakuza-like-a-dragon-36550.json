  {
   "id": "yakuza-like-a-dragon-36550@1.04",
   "gameId": "yakuza-like-a-dragon-36550",
   "displayName": "Update 1.04",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2020-12-08T00:49:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello again, Yakuza players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released 1.04 Today, our most recent update to the game. This update brings in some new content and gifts, as well as addressing issues reported with gameplay. Read on for a full list of changes and bug fixes. Thanks for playing and continuing to report issues to us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're aware of a bug some players are experiencing in the True Final Millennium Tower and are currently investigating a fix. Thank you for your patience as we look into this issue!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "-Adds the English karaoke songs to the \"Yakuza: Like a Dragon Karaoke Set\" DLC as playable CDs in the Survive Bar jukebox.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Adds an Upstart Assistance Pack as a gift.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "-Fixed a crash that occurred during Shogi.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fixed an issue where English voice dialog would cut off if the frame rate was not stable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Other minor bugs and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
