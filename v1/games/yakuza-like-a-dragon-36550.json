  {
   "id": "yakuza-like-a-dragon-36550@1.06",
   "gameId": "yakuza-like-a-dragon-36550",
   "displayName": "Update 1.06",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-12-22T00:18:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Yakuza players! We are back again with a small update and a gift.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update 1.06 addresses an issue where the master volume would change to 100 in SEGA AGES games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are also including an Upstart Assistance Pack as a gift!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you are still experiencing a crash, we ask that you try deleting your graphics.ini file and rebooting, this should resolve this issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your Yakuza: Like a Dragon graphics.ini file is located here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "C:\\Users\\USERNAME\\AppData\\Roaming\\Sega\\YakuzaLikeADragon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
