  {
   "id": "yakuza-like-a-dragon-36550@1.02",
   "gameId": "yakuza-like-a-dragon-36550",
   "displayName": "Patch 1.02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-11-17T22:59:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Yakuza players! We are rolling out patch 1.02 Today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for continuing to post issues you encounter as you play through! Patch 1.02 adds the Upstart Assistance Pack as a gift for you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, this patch provides stability fixes to the main game, as well as fixes to Pachislot and Arcade games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other issues addressed include",
     "items": [
      {
       "text": "• A fix for an issue that may cause the game to crash when deleting an image from the photo album.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixes to graphic settings not saving correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixes for issues with controller mapping on wireless controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
