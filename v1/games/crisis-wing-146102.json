  {
   "id": "crisis-wing-146102@1.1.0",
   "gameId": "crisis-wing-146102",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-03-23T07:55:11.000Z",
   "notes": [
    {
     "title": "New Game Mode",
     "items": [
      {
       "text": "• Added Boss Rush Mode to the game. The mode will have a brand new stage to play as well as unique boss at the end.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "• Fixed the mercy power-up spawning if player died without an active sub-weapon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed odd behaviour in Video Options menu if resolution, filter mode or windowed option was selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Adjustments",
     "items": [
      {
       "text": "• Added dimmers to overlay UI views.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Additions",
     "items": [
      {
       "text": "• Added three (3) new music tracks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Added an option to choose the player ship color in the single-player game modes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Technical Upgrade",
     "items": [
      {
       "text": "• Added an option to choose either pixel-perfect aspect or to fully stretch the game view to a display.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Quality-of-life Changes",
     "items": [
      {
       "text": "• Mapped 'Back' button to controllers. The 'Back' works similarly as the Escape key - it will pop up the in-game menu or goes back one step in the main menu views. Please visit controller action mapping view to map the back button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added an option to replay completable game modes (Time Attack, Practice, Boss Rush) without needing to visit the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added an option to choose the starting point (beginning, halfway or boss) in the practice mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
