  {
   "id": "crisis-wing-146102@1.4",
   "gameId": "crisis-wing-146102",
   "displayName": "Update 1.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-21T19:11:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update version 1.4.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A small but nice update for you all as a Christmas present!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tired of the solid black or grey color borders? This update brings new border styles: Sixteen (16) gradients and three (3) bezel images to enrichen the visuals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also the game will not automatically resume when brought back from background - it opens the pause menu instead!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
