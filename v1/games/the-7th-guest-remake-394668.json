 "releases": [
  {
   "id": "the-7th-guest-remake-394668@1.2.14090",
   "gameId": "the-7th-guest-remake-394668",
   "displayName": "Patch 1.2.14090",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-23T13:57:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear esteemed guests,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.2.14090 is now available. The team has been hard at work to address issues and make improvements. For a detailed list of changes, please see the patch notes below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes 1.2.14090",
     "items": [
      {
       "text": "Fixed a rare crash that could occur when grabbing bottles near large wheels of cheese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare crash when changing rooms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a potential soft lock when pausing the game just before the credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues that could cause players to become stuck on stairs or candles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players can no longer stand up while passing underneath the planks in the Boathouse.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved lantern collision in certain situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where luggage could become stuck under the bedside table in Temple's room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved the initial orientation when inspecting certain items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where players might not resume the game correctly in the Ritual Room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could cause the safe door to explode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players could become stuck in the small doorway on the Attic landing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a potential soft lock related to gargoyle eye placement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased the resolution of the music sheet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a potential soft lock involving the Music Room gramophone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where a coin could appear upside down in the hat and remain visible after being collected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Progress is now saved after completing the final game, even if players quit before returning to the Ritual Room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed view clipping into the Attic fuse box.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed pages clipping into the camera in the Library.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Prevented view clipping into certain door frames and pillars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We would also like to remind guests that you can reach out to our support in-case you run into any issues or would like to share additional information.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you have a wonderful rest of your stay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your humble host,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Henry Stauf",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
