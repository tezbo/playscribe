  {
   "id": "the-7th-guest-remake-394668@1.2.14067",
   "gameId": "the-7th-guest-remake-394668",
   "displayName": "Patch 1.2.14067",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-16T14:21:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear esteemed guests,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While the team is still hard at work to address issues we already wanted to share patch 1.2.14067 to address an issue players have been having with the ritual chamber puzzle. Details below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes version 1.2.14067",
     "items": [
      {
       "text": "Fix players softlocked after placing nose and reloading their game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Further simplified opening the downstairs toilet lid.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a disappearing toilet door.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where two gems could be placed into a single eye socket.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players can no longer enter the gate without properly opening it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues caused by unintended collisions between the lantern and doors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in the Fireplace puzzle that could cause a second safe dial to appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved seat selection when placing dolls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Dolls in the Nursery will no longer respawn inside another seated doll.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the positioning of several UI elements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More objects are now interactive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a rare persistent crash when loading profiles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various minor visual issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]We would also like to remind guests that you can reach out to our support in-case you run into any issues or would like to share additional information.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]We hope you have a wonderful rest of your stay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your humble host,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Henry Stauf",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
