  {
   "id": "the-7th-guest-remake-394668@1.2.14053.0",
   "gameId": "the-7th-guest-remake-394668",
   "displayName": "Patch 1.2.14053.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-12T13:29:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear esteemed Guests,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The development team has been hard at work to take some of your feedback into account and make improvements to ensure a pleasurable stay at the house. Please find a full list of changes below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes version 1.2.14053.0",
     "items": [
      {
       "text": "Opening the toilet seat is now even easier. [img src=\"https://a.slack-edge.com/production-standard-emoji-assets/16.0/google-medium/1f6bd.png\" style=\"height: 1.2em; width: 1.2em; vertical-align: text-bottom\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added crouch animations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue that could prevent players from finding a doll in the Nursery.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved gem puzzles to better support players with color vision deficiencies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue that could cause interaction prompts to appear as white squares.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare issue that could prevent the gate from opening.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed performance issues and visual artifacts when viewing mirrors from behind.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players can now leave the puzzle and use the Spirit Board while in the Void.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various fixes and improvements for the Void puzzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It is no longer possible to plug the spider hole in the bathroom if the toothpaste jar is already blocking it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where players could be incorrectly detected as using a keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed overlapping audio when pausing the game during dialogue playback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a potential softlock when interacting with cupboards in the Dining Room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved texture resolution on Stauf's diary pages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased shader precompilation coverage to reduce pop-in and stutter.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved interaction prompt positioning on objects and doors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where some items could not be interacted with until they had been bumped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added interactions to additional objects, including several audio lines previously only available in The 7th Guest VR.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed objects that could clip into the camera.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players can now crouch while standing on sigils.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues when interacting with bottles in the Kitchen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various minor bug fixes and stability improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would also like to remind guests that you can reach out to our support in-case you run into any issues or would like to share additional information. https://to.plaion.com/7thGuestRemakeSupport",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you have a wonderful rest of your stay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I remain your humble host,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Henry stauf",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
