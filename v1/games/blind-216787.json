   "id": "blind-216787@major-2022-12-12",
   "gameId": "blind-216787",
   "displayName": "We are back with another update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-12T12:19:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Good evening, dear players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the last update, we have tried our best to check and solve the problems that everyone reported one by one, but the manpower is limited, so there are some omissions, so we recently sorted out the feedback from players and repaired it. It is now online on steam, and you can update your experience.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If there is still something missing, you can still let us know in the community or in the announcement!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ":",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~ CG Appreciation adds the function of hiding the UI, and there is a shortcut key prompt when hovering;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~Modify the display order of the chapter interface to follow the chapter order;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ":",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~ Solve the problem that when reading a file before the option, the option of the previous file will appear in the read file;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "[In-Game]",
     "items": [
      {
       "text": "~ Solve the bug that the dialogue will disappear;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~ Solve the bug that the history is sometimes blank;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~Solve the problem that the Wechat dialogue fails when pressing Ctrl to skip when the character voice is playing;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~ Solve the bug that some looping sound effects cannot be stopped when pressing and skipping;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
