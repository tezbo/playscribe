  {
   "id": "hexapoda-244427@1.2.0",
   "gameId": "hexapoda-244427",
   "displayName": "Patch 1.2.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-13T21:47:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're happy to announce that patch 1.2.0 is now live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-> This patch adds a new game mode: Boss Rush !!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Boss Rush mode is designed for the most seasoned players' expectations, featuring a difficulty level based on the manic mode. This mode comes with its own leaderboard!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What else does this patch bring to the game?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5 more achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upgraded Bouncing Shots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New CRT effect with the option \"TV Bezel\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "The Centipede boss now correctly drops a few bonuses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Decreased the amount of lives dropped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enemies no longer turn white when damaged; they are now black-colored for an improved visual comfort.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved general pace on all maps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "General performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced memory usage, faster launch.: We hope you enjoy it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
