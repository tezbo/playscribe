   "announcedAt": "2023-05-20T12:31:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "////////////////////////////////////",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "///// PATCH V1.1.1 /////////",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "////////////////////////////////////",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "---> Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced HitBox, the black contour of the cockpit isn't included in the hitbox anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Bouncing shot rate speed and power increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "when the player respawn, the cockpit (hitbox) flicks, and is colored a little moment.: ---> Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When the Bestiary is completed, trigger the corresponding achievement correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In a multiplayers game, players can't go outside the camera view box anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "minor texts fixes in the dialogs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
