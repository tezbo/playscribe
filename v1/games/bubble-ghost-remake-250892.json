  {
   "id": "bubble-ghost-remake-250892@1.1.0",
   "gameId": "bubble-ghost-remake-250892",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-11T11:23:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for continuing to play Bubble Ghost Remake. This new update includes several gameplay improvements and bug fixes to further polish the experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now change the difficulty at any time: Switch between modes without restarting your run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some difficulty spikes have been balanced: Adjustments made to specific levels for smoother progression.: Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The mouse pointer now hides when playing with keyboard and mouse: A small but helpful tweak to keep the screen clean while playing.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "AZERTY keyboards are now properly supported: Full compatibility with AZERTY key layouts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor bugs fixed: Thanks again for all your feedback. We’re continuing to improve the game!: – The Nakama Game Studio Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
