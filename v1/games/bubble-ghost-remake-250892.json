  {
   "id": "bubble-ghost-remake-250892@1.0.4",
   "gameId": "bubble-ghost-remake-250892",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-04T19:50:09.000Z",
   "notes": [
    {
     "title": "Thank you for playing Bubble Ghost Remake!",
     "items": [
      {
       "text": "We've been listening to your feedback, and this patch focuses on improving accessibility, adding new audio content, and polishing key areas to make the experience smoother and more enjoyable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🆕 Highlights",
     "items": [
      {
       "text": "• Checkpoints added in Normal difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can now resume progress from mid-level checkpoints, reducing frustration without removing the challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• \"Accessible\" mode is now called \"Easy\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A clearer name for a mode designed for players who want a more relaxed experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Hard mode is now unlocked from the beginning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "No need to beat the game first — players looking for the toughest challenge can dive right in from the start.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Level balancing for better accessibility",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We’ve tweaked certain levels to reduce difficulty spikes that were causing unnecessary roadblocks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• New music tracks added to levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We've expanded the soundtrack to better accompany your ghostly adventure. More variety, more immersion!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Heinrich now whistles over 150 well-known tunes when bored",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Stop moving for a bit and listen closely… our ghost has quite the repertoire!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🐞 Fixes",
     "items": [
      {
       "text": "– Fixed a bug that caused a cinematic to end prematurely.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "– Fixed an issue that prevented collectibles from being picked up after completing a Madness level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
