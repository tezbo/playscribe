  {
   "id": "shattered-tale-of-the-forgotten-king-25555@major-2020-06-25",
   "gameId": "shattered-tale-of-the-forgotten-king-25555",
   "displayName": "BIG UPDATE! The first Demiurge and the Summer sales! ♥",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-06-25T16:01:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Wanderers, we have big news!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch notes contains the very first Demiurge of Hypnos, to go with these Summer sales!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We cannot wait for you to try it, and we hope you'll enjoy that harsh fight! There's also an entirely new area for you to roam... Please let us know what you think ♥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "BUGFIXES",
     "items": [
      {
       "text": "Lots of crashes have been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "When sprinting then falling, stamina stops decreasing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Debug of the spawn and death of the Dark Wander",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Debug of the Homonculuses' colliders",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "ADDITIONS",
     "items": [
      {
       "text": "NEW AREA, NEW BOSS!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New moving grass for the Ancient Lands",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Spell system! With 3 spells for the moment: invisibility, shield and a weapon buff",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We added a little freeze frame when the Wanderer touches a foe. Let us know what you think about it !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A little light under the Wanderer for better, easier jumps during platforming phases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New music in the Ancient Lands, new theme for Ackbar!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "CHANGES",
     "items": [
      {
       "text": "With no lock on, Ether bolts are now cast toward the middle of your screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now sprint while the camera is locked on a enemy (the locked sprint is slower than the regular one)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
