  {
   "id": "shattered-tale-of-the-forgotten-king-25555@3",
   "gameId": "shattered-tale-of-the-forgotten-king-25555",
   "displayName": "Hotfix 3",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2020-06-26T10:17:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We just fixed the Limbo wells!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "No more respawning problems and neverending mists.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You should probably restart your game, to make sure everything is ok now ♥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
