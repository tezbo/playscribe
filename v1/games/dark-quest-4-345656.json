   "gameId": "dark-quest-4-345656",
   "displayName": "Bug Fixes and Shop Prices",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-16T11:21:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Runes are now more expensive as they are a more late game shop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some items in the blacksmith shop are now more expensive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some hero cards are now more expensive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Firebeast no longer takes damage from firewall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with pathfinding that could lock the game when a hero is invisible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The youtube link in the creator help screen now works properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some typos in english",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some minor adjustments to early levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Search Tiles and Secret Door: You now need to directly move on them in order to activate them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a lock issue with accidentally moving to a search tile",
       "ps5ProOnly": false,
       "pcOnly": false,
