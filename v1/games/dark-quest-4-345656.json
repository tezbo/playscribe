 "releases": [
  {
   "id": "dark-quest-4-345656@major-2026-11-12",
   "gameId": "dark-quest-4-345656",
   "displayName": "Dark Quest 4 — Major Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-11-12T20:39:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update addresses a large number of reported issues, including several that could cause the game to freeze during combat. We've also introduced faster movement, reworked hero fatigue, improved saving, and made several quality-of-life changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Major Localization Overhaul",
     "items": [
      {
       "text": "We've completed a major revision of the game's localizations, addressing many issues with the previous translations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Extensively revised and reworded existing translations across the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected inaccurate, confusing, awkward, and poorly translated text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved wording, clarity, and consistency to make the game easier to understand in every supported language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated translations to cover all new features and gameplay changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the handling of missing translations, which now fall back to English instead of generating errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This is much more than a routine translation update. A substantial amount of existing text has been revisited and rewritten to deliver a significantly better experience for players using languages other than English.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features & Improvements",
     "items": [
      {
       "text": "Movement Speed: Added a new setting (Normal / Fast / Very Fast) that speeds up hero and monster movement, both in and out of combat. Multiplayer remains locked to Normal speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Hero Fatigue: The Elder now offers two fatigue settings",
     "items": [
      {
       "text": "Rested (new default): Heroes receive the rest bonus without accumulating fatigue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Harsh: Restores the original fatigue rules.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Death's Reprieve: The Gravedigger's card has been renamed and reworked. It now removes only the death penalty, with its price reduced from 45 to 35 coins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quest Abandonment: Abandoning a quest now allows you to keep all coins collected. Fallen heroes will still return injured.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Workshop Quests: Coins collected are now retained after defeat, matching campaign quests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Elder's Guidance: After a defeat or abandoned quest, the Elder will remind you that difficulty settings are available. This reminder appears up to three times, or until you visit his settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Winter Camp: The seasonal camp will now appear from December 1 to January 7.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Major Stability Fixes",
     "items": [
      {
       "text": "Resolved several issues that could cause combat or the game to freeze:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed enemy attacks freezing the game when a hero's Defence exceeded 10, such as a Knight combining equipment with a Defence potion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed enemy archers and monsters becoming stuck when they couldn't find a valid movement position, including situations where the party blocked a doorway.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Split Shot allowing the next turn to begin before its arrows had finished travelling, and freezing combat when no arrows hit a target.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Grand Mirror freezing when copying a monster recruited by the Prince or when no free space was available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed searching an already-open tomb freezing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed special chests without an assigned item causing a freeze.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed jammed doors occasionally preventing the turn from progressing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Tornado freezing combat if its caster died while the spell was still moving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "New turn recovery system: If the game becomes stuck during a turn, it now automatically attempts to recover after 3 seconds and records the cause in the log.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Gameplay Fixes",
     "items": [
      {
       "text": "Save vs Traps: Fixed the stat having no effect. Heroes can now avoid traps according to their Save vs Traps value.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Sanity: Fixed sanity checks incorrectly using Courage instead of Sanity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Gravedigger: Fixed his extra-movement perk being applied to every hero without unlocking it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Gravedigger Cards: Cards purchased after party selection now correctly apply to the current quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Elder: Fixed the Hero Attack Bonus setting also increasing monster damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Damage Runes: Fixed Body Damage and Magic Damage runes providing no bonus and potentially stacking after Rebirth.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Break Armor: Fixed the ability permanently increasing hero Defence after combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Potion Effects: Fixed several potions leaving permanent bonuses, transferring effects to another hero, or leaving status icons behind when used multiple times in the same battle. Affected potions include Armor, Resistance, Stoneskin, Movement, Damage, Spell Power, and Max Incoming Damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tombs & Chests: Fixed tombs and special chests being searchable multiple times, potentially granting duplicate loot, extra mummies, or duplicate keys.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Arrow Traps: Fixed remote arrow traps triggered by bookcases activating a second time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Weakened Curse: Fixed the curse failing to reduce damage from weaker attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Overwhelm: Fixed size-3 monsters, including the Bone Dragon, being immune to Overwhelm despite the tooltip stating otherwise.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Monster Spawners: Fixed large monsters spawning additional enemies with incorrect spacing or inside themselves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Secret Doors: Fixed heroes occasionally being teleported twice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Boss Dialogue: Fixed the half-health dialogue triggering at the wrong threshold or even after the boss had died.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Backpack Rune: Fixed removing the rune occasionally leaving a hero with an extra potion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Workshop Quests: Fixed the tutorial appearing at the start of Workshop quests and incorrect ending cutscenes playing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Multiplayer: Fixed abandoning a quest potentially crashing the game or injuring another player's heroes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Multiplayer: Fixed Wizard voice lines potentially causing dice rolls to become desynchronized between players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Saving & Coin Fixes",
     "items": [
      {
       "text": "Safer Saving: Improved the save system to protect profiles from corruption caused by crashes or power interruptions during saving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Profile Recovery: On PC, corrupted profile slots can now be restarted, while a backup of the damaged file is preserved.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Quest Abandonment: The game now saves immediately after abandoning a quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Coin Pouch: Fixed several issues causing incorrect coin totals, including exceeding the pouch limit, coins continuing to arrive after purchases, and incorrect amounts after Abandon, Restart, or Workshop defeats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Visual & Interface Fixes",
     "items": [
      {
       "text": "Fixed injury and Well Rested icons in camp not updating correctly while any hero remained locked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed destroyed barrels repeatedly generating errors in the log.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Tornado visually jumping a tile on subsequent casts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the locked Gravedigger incorrectly animating the Wagon Merchant's icon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Escape key not closing the Gravedigger screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the mechanical door spikes using an incorrect animation curve.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Firewall generating errors when combat ended before its appearance animation completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Economy Balancing",
     "items": [
      {
       "text": "Late-game prices have been increased to make coins more meaningful and improve progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
