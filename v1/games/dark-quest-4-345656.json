  {
   "id": "dark-quest-4-345656@major-2025-12-17",
   "gameId": "dark-quest-4-345656",
   "displayName": "Winter Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-17T08:53:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings fans!! The winter update is here adding snow to the hero camp!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full list of changes",
     "items": [
      {
       "text": "Added winter tileset for herocamp, it will be active until 7th January.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug with summons on traps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug on world map unlocking the wrong quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added gravedigger npc at hero camp.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new upgrade on gravedigger: Remove fatigue and death penalty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new upgrade on gravedigger: Extra movement out of combat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new upgrade on gravedigger: Extra health for all heroes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Helmet of Protection: +2 health on summoned units",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added War Axe: +1 attack on summoned units",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Broadsword!!!: +2 max damage on physical damage attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added War Horn: Cannot be overwhelmed/surrounded by enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new trigger in the creator: Speak, you can use it to make characters say something.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Backpack Rune now allows you to equip an extra hero card from the trainer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Death Rune: Upon killing an enemy heal by +1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Exiting a secret door should always find some space to place a hero.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "SkeletonWarBannerYellow (Skeleton Commander) Starting Health: 6-7 -> 7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "SkeletonChickenArmor (Armored Chicken) Magic resist: 20% -> 10%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "SkeletonChickenExplosion (Explosive Chicken) Armor: 10% -> 0%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Butcher2 (Malgurath) Magic Resist: 0% -> 10%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ChestMonster (Chest Monster) Movement Speed: 4 -> 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ChestMonster (Chest Monster) Health: 4-6 -> 3-5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ChestMonster (Chest Monster) now has 10% magic and physical resist",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Barbarian: Throwing axe: Damage: 1 -> 1-2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lancer: Sister: Starting Health: 7-8 -> 7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved spawn portal with more parameters: Thanks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
