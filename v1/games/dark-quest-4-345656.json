  {
   "id": "dark-quest-4-345656@post-2026-01-14",
   "gameId": "dark-quest-4-345656",
   "displayName": "Winter tileset extension and bug fixes!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-01-14T17:45:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a bug with the archer that would crash the game in particular in the Legion Bone quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with superior healing potion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with wizard's hat not adding damage to firewall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "When you abandon or defeated you get to keep all your coins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where 2 commanders that have the follow me card would ping pong you to infinity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a freezing crash when the commander would attack a 2x2 monster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Defense and Magic Resistance now use seeded magic numbers to over excessive randomness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Winter tileset extended until end of January.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some missing Japanese translation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
