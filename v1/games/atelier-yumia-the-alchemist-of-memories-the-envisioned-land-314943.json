  {
   "id": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943@1",
   "gameId": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-17T02:59:10.000Z",
   "notes": [
    {
     "title": "■Photo Mode Special Update",
     "items": [
      {
       "text": "New photo frames and motions have been added in \"Photo Mode,\" where you can freely position characters, change the time of day, filters, frames, and character expressions, and enjoy taking pictures. Take your best shot in the upgraded \"Photo Mode\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "■\"Atelier Resleriana\" Hand-Picked BGM Pack",
     "items": [
      {
       "text": "Adds BGM tracks from \"Atelier Resleriana\" that can be used to change the in-game BGM.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enjoy a set of 10 tracks from \"Atelier Resleriana\" Hand-Picked BGM.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*The BGM pack is accessible after unlocking base building and placing certain furniture.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Special Items Set",
     "items": [
      {
       "text": "\"Wishlist Campaign Goal\" reached present!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Receive one \"Scarlet Scarf\" accessory, and building materials.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Scarlet Scarf increases maximum HP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Obtain 200 pieces each of the following building materials: \"Wood,\" \"Stone,\" \"Iron,\" \"Powder,\" \"Saltpeter,\" and \"Fiber.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Building materials can be checked after Building is unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*You cannot receive more than the storage limit of exploration pouches or material boxes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*The recipe for the \"Scarlet Scarf\" can be obtained by progressing through the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
