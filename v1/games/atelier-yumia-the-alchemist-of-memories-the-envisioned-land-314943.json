   "id": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943@1.0.1.0",
   "gameId": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943",
   "displayName": "Update 1.0.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-17T02:57:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Added Photo Mode Special Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added Atelier Resleriana Hand-Picked BGM Pack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added Special Items Set",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Optimized synthesis by allowing the speed of animations to be changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: The speed of animations during synthesis can now be changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted the freedom of movement for the camera during Photo Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: The camera can go closer to the characters now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted camera angle behavior while the player is out in the field.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that prevented some Shrine of Prayer relay points from being activated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that prevented the Pioneering Quest \"Tracking\" from properly activating.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: If you experienced this bug before applying this update, the Pioneering Quests \"Suspecting Licht\" and onwards will now activate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug where Synthesis Skills such as \"ATK Multiplier\" would apply their effects to previously added ingredients during Item Rebuilding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug where certain areas of the map were able to be accessed before they were opened up through quests and other events.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug where the target monster's footprints would not appear during base Assault Quests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Minor adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
