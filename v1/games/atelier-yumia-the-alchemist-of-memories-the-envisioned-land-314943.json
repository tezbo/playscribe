  {
   "id": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943@1.0.4.2",
   "gameId": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943",
   "displayName": "Update 1.0.4.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-08-22T09:22:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Made changes related to additional content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added an additional feature \"Hunting Book\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added an additional feature \"Lamb Roast α and Lamb Roast β\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug where some recipes and items that are supposed to be made available through the Recipe and Blueprint Expansion Pack \"The Art of Aladiss\" were mistakenly made available regardless of whether the DLC had been applied.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that prevented the monocle for Viktor's \"Perfect Butler\" costume from being displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that caused the game to become unresponsive if the player unlocked Friend Action I and Combat EXP I consecutively on the skill tree without having viewed the tutorial \"Quests: Tracking Quests.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that made it impossible to progress the Pioneering Quest \"The Mystery of the Alber\" under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that sometimes caused the game to become unresponsive after the photo mode tutorial was displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that would reset the Change Confirm Button settings in the Steam® version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Minor adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
