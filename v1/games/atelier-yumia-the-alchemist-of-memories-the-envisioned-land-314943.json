  {
   "id": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943@1.0.5.1",
   "gameId": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943",
   "displayName": "Update 1.0.5.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-26T06:03:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Made changes related to additional content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added camera controls under Key Assignment for the Steam® version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug where the target monsters for the quest \"Rare Beast Chase\" could be found and defeated before the corresponding event had triggered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that caused the game to close when Rutger consumed HP during a Friend Action.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that sometimes caused the quest \"Post-Raid Cleanup\" to not progress in building areas near the Arbor Botanical Garden or 8th Imperial Laboratory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that caused equipped items from the Recipe and Blueprint Expansion Pack \"The Art of Aladiss\" to not properly carry over after completing the game and beginning New Game+.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that caused the game to stop responding to controls after defeating an enemy with a Friend Action that used an item from the Recipe and Blueprint Expansion Pack \"The Art of Aladiss.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Minor adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
