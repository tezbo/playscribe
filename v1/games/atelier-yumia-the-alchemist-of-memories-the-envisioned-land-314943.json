   "id": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943@1.0.0.2",
   "gameId": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943",
   "displayName": "Update 1.0.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-28T10:24:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Adjustments to the VRAM usage of the Steam® version of the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Note: We will continue to make adjustments in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Updates to button remapping under the controls tab in the options menu for the Steam® version of the game to allow only exploration controls to be remapped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: If button remapping has caused you to be unable to use some functions before applying this update, please reset your button remapping using the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixes to a bug which caused some controllers to behave incorrectly after making changes in the controls tab of the options menu in the Steam® version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: If you are experiencing this bug before applying this update, please reset your button remapping using the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
