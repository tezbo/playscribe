   "id": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943@1.0.0.3",
   "gameId": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943",
   "displayName": "Update 1.0.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-04T01:17:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Added the ability to skip and fast forward the animations at the beginning of synthesis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added the ability to turn the result screen at the end of battle on/off under the battle tab in the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: This setting is set to \"Off\" by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added the ability to set sprinting to \"Auto,\" \"Manual,\" or \"Switch\" under the controls tab in the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Auto: Begin sprinting automatically while moving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Manual: Manually toggle between running and sprinting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Switch: After toggling sprinting once, will sprint by default.: • Adjusted the shaking during the prologue stage after beginning a new game.: • Minor adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
