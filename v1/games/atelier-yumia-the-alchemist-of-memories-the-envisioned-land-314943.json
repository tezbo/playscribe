  {
   "id": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943@2",
   "gameId": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-23T08:30:22.000Z",
   "notes": [
    {
     "title": "■Building Expansion Update",
     "items": [
      {
       "text": "New building materials have been added, including new Feature Modules such as the “Energy Sphere”, which allows players to restore their energy and the “Projector” that allows players to create shadows of previously defeated monsters. Additionally, a new architectural style and matching furniture based on Ryza’s hometown, Kurken Island, from “Atelier Ryza” have also been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Have more freedom to create!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Higher Difficulty Level Patch",
     "items": [
      {
       "text": "The hardest difficulty level, “Legendary”, has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Enemy stats have been increased and supporting allies’ HP will slowly decrease when in combat within the manabound area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Enjoy an even more challenging adventure!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Note: Some of the information were corrected on May 26th.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
