  {
   "id": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943@3",
   "gameId": "atelier-yumia-the-alchemist-of-memories-the-envisioned-land-314943",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-08-22T09:23:28.000Z",
   "notes": [
    {
     "title": "Additional Feature “Lamb Roast α and Lamb Roast β”",
     "items": [
      {
       "text": "Lamb Roast α and Lamb Roast β are two battle mini-games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Lamb Roast α measures damage over a short period of time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Lamb Roast β allows you to change the opponent into any monster you wish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You'll earn various rewards based on your performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Additional Feature “Hunting Book”",
     "items": [
      {
       "text": "Search for monster traces based on the information in the Hunting Book.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "By scanning traces, you can battle a number of different enemies. The enemies grow stronger as you progress, culminating in fights against mighty foes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We encourage you to take up the challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "*In order to play “Lamb Roast α and Lamb Roast β” and “Hunting Book”, you must advance to a specific point in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
