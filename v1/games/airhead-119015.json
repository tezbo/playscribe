  {
   "id": "airhead-119015@major-2024-02-22",
   "gameId": "airhead-119015",
   "displayName": "Update Notes for Feb 22",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-22T10:50:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "All Ears and All Eyes achievements no longer trigger too early",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed an issue where the Head would sometimes fall through the ground in a specific spot in the Mine",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed an issue where climbing back into the village area would make the player land on a wrong layer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Due to a confusion with the previous patch's version, this version also now *actually* includes the following fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed an issue where an Airhunter was not able to return to the village area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed an issue where a certain elevator in the canyon would be blocked for no reason",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed an issue where Body would sometimes fall out of a monorail tram during the ride",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed an issue where map waypoints would get stuck when dying right after getting an upgrade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
