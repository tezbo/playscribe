      },
      {
       "text": "Changes to Race stages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Make slow-mo only happen on game over",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix pressing back from achievements page opens exit prompt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix hitting login shows prompt cant select on the account page using controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix controller disconnect and connect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
