       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "New stages and Classic stage updates and Full Game exclusive stages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix skip prompt on PC",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
