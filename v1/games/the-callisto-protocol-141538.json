  {
   "id": "the-callisto-protocol-141538@major-2023-06-29",
   "gameId": "the-callisto-protocol-141538",
   "displayName": "6/29 Patch Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-29T21:41:10.000Z",
   "notes": [
    {
     "title": "[v5.02]",
     "items": [
      {
       "text": "Added in auto-play functionality for audio logs based on player feedback. In order to maintain The Callisto Protocol's narrative structure and avoid over-lapping audio, some of the in-game audio log locations were moved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Full list below",
     "items": [
      {
       "text": "OUTBREAK",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved one log pickup to the end of the hallway before the medical room, after the beta path door",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved one log pickup inside the cafeteria section",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AFTERMATH",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved one corpse harvest/pickup to the corner of the red room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "HABITAT",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved one log pickup back to its original location in the upper corner of a room onto a box with a valve wheel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "LOST",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved one corpse harvest/pickup to the far corner of the garage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BELOW",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved one log pickup to the left of the moving platform exit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "COLONY",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved one corpse harvest/pickup to the top of a ladder before the shimmy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved one log pickup closer to a REFORGE station",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TOWER",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved one log pickup to be inside a prison cell",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved one log pickup to be inside a Biophage infested hallway",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved one log pickup onto a table by a cherry tree",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
