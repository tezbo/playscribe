  {
   "id": "the-callisto-protocol-141538@major-2023-02-07",
   "gameId": "the-callisto-protocol-141538",
   "displayName": "2/7 - Steam Deck Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-07T19:06:54.000Z",
   "notes": [
    {
     "title": "[v.3.02] February 7, 2023",
     "items": [
      {
       "text": "Hardcore Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A challenging take on The Callisto Protocol’s survival-horror experience, intended to push you to your limits, Hardcore mode is not for the faint of heart. Here’s what you can expect;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ammo, health and credits are harder to come by and not every Biophage will drop loot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased enemy damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Decreased Stun Baton damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased enemy mutation speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Contraband value is reduced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hardcore Mode New Game+ (requires completion of standard Hardcore Mode playthrough)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Achievements / Trophies to hunt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Global",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players that were not correctly granted the \"The Protocol is About Life\" achievement upon completing the game will be automatically granted the achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localization fixes for leveling and VO/subtitle mismatches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized enemy combat AI when player is surrounded by multiple enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PC Specific",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Ray tracing performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
