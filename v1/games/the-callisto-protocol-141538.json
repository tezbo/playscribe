  {
   "id": "the-callisto-protocol-141538@major-2023-01-20",
   "gameId": "the-callisto-protocol-141538",
   "displayName": "1/19 Patch Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-01-20T04:30:42.000Z",
   "notes": [
    {
     "title": "[v. 3.01] January 17, 2023",
     "items": [
      {
       "text": "NEW GAME+",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Users who previously completed the game will have access to NewGame+ after the patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Application restart may be required.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Requires an active save file from game completion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GLOBAL",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where some users were not correctly granted the \"The Protocol is About Life\" achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added New Game Plus. Complete the game to unlock New Game Plus and carry your progression over to a new save. All weapons, upgrades, and Callisto Credits can be collected at the first Reforge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General performance optimizations across all platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players no longer take damage when vaulting over obstacles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed multiple issues where certain camera angles or progression paths could cause environments to stream out and allow Jacob to fall through the ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Consistency pass on cabinets, lockers, and shelves to display correctly in High Contrast mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Voice leveling and subtitle mismatch adjustments across localized languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed low frequency crash in the Tunnels level during the Two Head fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Skip Death Cinematics button has been mapped to the Interact/Pickup input",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a long hitch when enabling Ray-Traced Shadows in the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Prevented mouse cursor from displaying during some area transitions",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
