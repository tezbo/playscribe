  {
   "id": "wrc-generations-201963@major-2022-11-18",
   "gameId": "wrc-generations-201963",
   "displayName": "Leagues Season 1 Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-18T14:21:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We wanted to inform you that we are extending the Leagues Pre-Season by 1 week. This extra time, with a 1-week unavailability (Nov 28 - Dec 4) will allow us to work on potential optimisation and for Xbox players to be on equal ground with other platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Season 1 is therefore now planned to start on Dec 5!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you on the roads.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
