  {
   "id": "wrc-generations-201963@1.4.25.1",
   "gameId": "wrc-generations-201963",
   "displayName": "Patch 1.4.25.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-12-20T09:05:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello drivers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are pleased to announce a new update (v 1.4.25.1) for the Steam version of WRC Generations is now available to download on your Steam client.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Fixed an issue with the hybrid launch control gauge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with TCS, where some power was lost at low speed if it was activated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a display issue on brake disks under specific conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Clubs",
     "items": [
      {
       "text": "Fixed a display issue in Clubs leaderboards where it only showed the 10 best scores.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Controller",
     "items": [
      {
       "text": "Fixed an issue with PS5 Dualsense Controller linked to \"Rescale / Accelerate\" setting. It should now be set to \"ON\" by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      }
     ]
    },
    {
     "title": "Nvidia DLSS",
     "items": [
      {
       "text": "Nvidia DLAA is now available for compatible graphical cards, along with DLSS.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Leagues",
     "items": [
      {
       "text": "Changed the lowest League name from \"Beginner\" to \"Amateur\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue when playing more than a single promotion/relegation animation in one instance of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Livery Editor",
     "items": [
      {
       "text": "Fixed an issue when exceeding 255 stickers in editor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
