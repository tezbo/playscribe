  {
   "id": "wrc-generations-201963@1.3.24.2",
   "gameId": "wrc-generations-201963",
   "displayName": "Patch 1.3.24.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-12-02T09:19:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello drivers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are pleased to announce a new update (v 1.3.24.2) for the Steam version of WRC Generations is now available to download on your Steam client.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Below today’s list of fixes, you will also find a non-exhaustive list of the fixes we are currently working on resolving through the next updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Leagues",
     "items": [
      {
       "text": "Fixed an issue where the timing was set to 00'00\" when the player was DNF.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In Amateur Leagues, players that didn't participate are not displayed anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Point attribution system as been changed for daily and weekly challenges.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Allowed users to display the rankings for previous weeks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized tooltips.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the display of some groups being wrong.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "For Weekly Challenges, Car Setup and Tyre Choice are now taken into account for the whole rally instead of the first special only.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added tooltips in Car Setup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Clubs",
     "items": [
      {
       "text": "Added saving the car deformation depending on collisions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed saving the car deformation after a DNF.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The car deformation save is now online.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue occuring when using a custom livery in a realistic rally. The fix implies that it is no longer possible to use custom liveries in this mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "For rallies, Car Setup and Tyre Choice are now taken into account for the whole rally instead of the first special only.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added tooltips in Car Setup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Cars & Physics",
     "items": [
      {
       "text": "Fixed a throttle issue where it was only effective when pressed at near maximum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where it was possible to accelerate even with the clutch engaged when using a peripheral.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the car was going backwards after pressing the throttle briefly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several issues linked to the Car Setup and restrictions depending on the type of car.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some car setup modifications being incompatible with semi-auto, virtually changing to manual.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an animation problem when using a steering wheel peripheral.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimized using rain tyres on wet roads, they should now give more of an advantage compared to dry tyres.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the display of a Licensing Rallye sticker on custom liveries of the Yaris WRC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Environments",
     "items": [
      {
       "text": "Fixed the presence of an invisible obstacle in Turkey SSS Marmaris.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several collision & respawn problems on multiple stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI",
     "items": [
      {
       "text": "Fixed an issue when navigating in the camera choice interface.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimised the display of DLC liveries and stickers, by adding DLC icon on content tiles in: Livery Catalog, vitrine-showroom, stickers editing list, stickers catalog.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Audio",
     "items": [
      {
       "text": "Fixed an issue when choosing the female co-pilot voice in Career and other modes, now the global setting in the Game Settings menu will be used instead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a sound issue on Audi Quattro and Skode Fabia.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor interface and environment sound fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Fixed an FFB issue when disconnecting and reconnecting the Fanatec GT DD Pro.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added information linked to RT and LT buttons for Logitech Pro wheel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some Nvidia DLSS option interdependencies.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed crash when changing Thrustmaster API setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
