  {
   "id": "wrc-generations-201963@1.3.24.0",
   "gameId": "wrc-generations-201963",
   "displayName": "Patch 1.3.24.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-11-16T09:10:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello drivers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're happy to share that the first post-launch update of WRC Generations is now available to download on your Steam client. This update (1.3.24.0) is resolving some issues reported by the community but also integrate Nvidia DLSS3.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can read more about the power of Nvidia DLSS3 in their official blog right there and the other fixes through the Patch Notes below.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
