 "releases": [
  {
   "id": "broken-lines-107175@post-2022-05-03",
   "gameId": "broken-lines-107175",
   "displayName": "The Dead and the Drunk pushed to live for OSX and Linux",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-05-03T07:03:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Last fall we decided to make the content update \"Dead and the Drunk\" available to OSX and Linux users despite the content not having gone through QA testing for those specific platforms. This was done by putting the content on an open beta branch called \"Experimental\".",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We're now happy to announce that no significant issues has been raised so we've decided to make this version the default for both OSX and Linux.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "This will bring a bunch of fixes, Chinese localization (thanks to \"Vargoth.Zhao\" for bringing this to out attention) and the content update with the \"Dead and the Drunk\" campaign.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope that players who missed our 'experimental' branch update will now get to enjoy the updated content, and as always if you experience issues feel free to contact us either here on Steam or on our Discord server.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Broken Lines team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
