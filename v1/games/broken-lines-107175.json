  {
   "id": "broken-lines-107175@major-2021-10-28",
   "gameId": "broken-lines-107175",
   "displayName": "⚙️ Free update for Mac and Linux!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-10-28T17:41:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Great news, soldiers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“The Dead and the Drunk” free side story content update is now available for Mac and Linux users!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "“A challenge awaits the surviving squad members. The mysterious fog released by the masked enemies is causing the dead to rise again...”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you want to pit your tactical skills against zombies, grab your helmet and the rest of the gear and throw yourself into the hellfire of battle!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ːsteamthumbsupː Please note that this version will be available to users in the special experimental branch, so if you encounter any bugs please feel free to report them in this thread",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "How to find a special branch: Right-click on the Broken Lines > Go to Betas > Choose Experimental",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
