  {
   "id": "nascar-arcade-rush-254849@1.0.0.2",
   "gameId": "nascar-arcade-rush-254849",
   "displayName": "Hotfix 1.0.0.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-09-18T14:55:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Racers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your enthusiasm for NASCAR Arcade Rush! We apologies for the issue where player experience washed out graphics with HDR. Our pit crew has been hard at work, and we're rolling out a hotfix to address the issue that was affecting your race experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "HDR Clarity: We've fine-tuned the visuals to ensure that HDR is no longer an issue. No more washed-out graphics – you'll now enjoy vibrant and true-to-life colors on the track.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
