  {
   "id": "changeable-guardian-estique-283375@major-2026-07-31",
   "gameId": "changeable-guardian-estique-283375",
   "displayName": "2026/07/31 Demo Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-31T06:46:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The demo has been updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the volume of some sound effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the button layout for menu navigation when using a controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed the Confirm button to A and the Cancel button to B.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where subtitles would display incorrectly if turned on during gameplay. Additionally, fixed an issue where subtitles would cut off when using the rewind feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the initial startup language to automatically sync with your Steam language settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added a special specification for full-screen mode: if the display aspect ratio is set to 4:3, the game screen will now stretch to fill the entire screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Implemented a fix to properly verify game ownership via the Steam client upon startup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
