  {
   "id": "fight-life-vanguard-318193@major-2025-11-27",
   "gameId": "fight-life-vanguard-318193",
   "displayName": "Fight Life: Vanguard exclusive Demo Update for Turn-Based Carnival 2025!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-27T21:10:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are excited to announce a significant update to the Fight Life: Vanguard Demo, our tactical turn-based game, which makes it more accessible than ever!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What's New",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Expanded Language Support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The demo now supports 13 languages, allowing players around the world to experience the story of the forgotten god and the brave mercenaries who fight to reclaim harmony.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Available languages include: English, German, French, Japanese, Korean, Simplified Chinese, Traditional Chinese, Ukrainian, Spanish, Italian, Portuguese, Polish, and Turkish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The strategic depth and narrative journey remain equally compelling regardless of your chosen localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Mechanics, Bug Fixes and Balance Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We've listened to your feedback and implemented numerous fixes to enhance your gameplay experience. The demo is now smoother and more stable. We've also improved the balance of game mechanics, making battles fairer and more strategically engaging.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fresh New Look",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've also updated the game's banner to better reflect the epic scope of your journey, from leading a group of inexperienced recruits to forging them into legendary heroes through tactical turn-based combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
