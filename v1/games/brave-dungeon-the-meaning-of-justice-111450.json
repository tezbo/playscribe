  {
   "id": "brave-dungeon-the-meaning-of-justice-111450@1.03.00",
   "gameId": "brave-dungeon-the-meaning-of-justice-111450",
   "displayName": "Update 1.03.00",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-04-24T10:31:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ver 1.03.00",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version number has been changed to match the Switch version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(This version will be updated as ver 1.0.3)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed so that recovery is not staged when campers are at full life.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some red and blue blocks on the Nightmare map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The addition of Miracle Power has been changed so that it spans across scenarios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(For example, if you have 4 extra Miracle Powers when clearing a scenario and the additional effect is \"Miracle Power +3\", 3 will carry over to the next scenario and 1 will carry over to the last chapter)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a problem in the battle line at the top of the battle, where the character icons that bounce.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a case where Rudy is a member of the group but the torch cannot be acquired.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
