  {
   "id": "the-legend-of-heroes-trails-of-cold-steel-iii-26564@1.06",
   "gameId": "the-legend-of-heroes-trails-of-cold-steel-iii-26564",
   "displayName": "Patch 1.06",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-02-11T14:01:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been a while, but we are providing a new update to Trails of Cold Steel III today. This is primarily in response to some relatively recent changes in behaviour on a subset of systems with AMD GPUs, but we also sneaked in a few more fixes:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix potential text-rendering-related performance issues which could occur on AMD GPU hardware on some systems.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improve collision detection to prevent getting out-of-bounds in some rare scenarios and at specific framerates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improve responsiveness of Alt-F4 for quitting the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note on Reverting to Previous Versions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While we of course aim for each new version to only solve issues and provide improvements over all previous ones, it is always possible for something to break on some particular configuration.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Therefore, we keep all versions available as Beta branches in Steam. Should an update lead to issues on your system, you can revert to a previous branch by selecting \"Properties\" -> \"Betas\" in the Steam library and choosing a version from the drop down menu. If you can confirm that the new version caused a problem, please report it as a regression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Durante",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
