   "id": "the-legend-of-heroes-trails-of-cold-steel-iii-26564@1.05",
   "gameId": "the-legend-of-heroes-trails-of-cold-steel-iii-26564",
   "displayName": "Patch 1.05",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-03-24T15:49:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I hope you are enjoying Trails of Cold Steel III!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just released a minor update which fixes a startup crash issue on uncommon system configurations:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a crash on startup when launching the game on a system with no audio devices while having video playback enabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Note on Reverting to Previous Versions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While we of course aim for each new version to only solve issues and provide improvements over all previous ones, it is always possible for something to break on some particular configuration.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Therefore, we keep all versions available as Beta branches in Steam. Should an update lead to issues on your system, you can revert to a previous branch by selecting \"Properties\" -> \"Betas\" in the Steam library and choosing a version from the drop down menu. If you can confirm that the new version caused a problem, please report it as a regression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Durante",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
