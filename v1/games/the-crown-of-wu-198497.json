  {
   "id": "the-crown-of-wu-198497@major-2023-04-05",
   "gameId": "the-crown-of-wu-198497",
   "displayName": "The Crown of Wu Major Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-05T21:16:35.000Z",
   "notes": [
    {
     "title": "The Crown of Wu Major Update",
     "items": [
      {
       "text": "Attention fans of the monkey king! The adventure inspired by the Chinese legend of Wukong has a new update with all these new features:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Major Bug Fix",
     "items": [
      {
       "text": "Fixed an issue where you couldn't complete level 5 in a second run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that made it impossible to activate the Pagoda if you die after opening the first chest and before opening the big gates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Solved the problem where the trophies were not activated in Steam. Now the lost trophies will be updated automatically when starting the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that prevented Wukong's animations from loading when healing during a teleport.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Wukong's animations were stuck after QTE when you enter them with an attack animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Wukong could get stuck in the moving pedestals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some enemies were not suffering from the lightning power effect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Minor Bug Fix",
     "items": [
      {
       "text": "The music in the last video is no longer coupled with the credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Zhu's fire tornado no longer affects Wukong once Zhu is defeated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Level 6 mages no longer teleport out of the combat area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added mana recharge crystals in zones where they were required",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple incorrect collisions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed areas where it was possible to exit the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the triggers of several help messages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The game puts us in the role of Wu in an adventure and a world inspired by Journey to the West, the traditional Chinese tale starring the Monkey King, where we will have to go from anti-hero to hero trying to regain the crown and take down Zhu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Remember that The Crown of Wu is already available on PS4, PS5 and Steam!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Translated with www.DeepL.com/Translator (free version)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
