  {
   "id": "skatebird-111813@1.0.6",
   "gameId": "skatebird-111813",
   "displayName": "Update 1.0.6",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-10-14T17:11:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "If you played 1.0.5, you might have noticed music that was previously unlocked, was re-locked. You lost progress on tape collectibles. This patch addresses that, and your progress should go back to the way it was.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(if you were playing on 1.0.5 and collected new tapes, that progress will now be shuffled, sorry! that's why I wanted to get this up ASAP, to minimize how many folks would hit that- you should be able to recollect the tapes as per normal)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
