      },
      {
       "text": "Fixed the feets color on the zebra finch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed white marker boxes at corners of rooftop edge ramps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made minimap indicators larger, added tutorial explaining minimap",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera can now keep up with you even when you launch off a fan",
       "ps5ProOnly": false,
