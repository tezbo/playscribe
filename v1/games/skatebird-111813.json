  {
   "id": "skatebird-111813@1.0.3",
   "gameId": "skatebird-111813",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-28T00:13:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here's the full patch details, but the gist is: Fixed the camera (and some other stuff).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.0.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Significantly improved the gameplay camera, and made it much more stable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added additional camera angles in create-a-birb",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made it so that if you sequence break to a later level, level select window respects your hustle and lets you go there again even if you didn't beat the prior level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted \"manual\" tutorial to be clearer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added reset bounds for if you manage to fall out of level 4 or 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed the stub/non-functional \"Save GIF\" button binding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
