  {
   "id": "we-were-here-expeditions-the-friendship-266676@1.0.2",
   "gameId": "we-were-here-expeditions-the-friendship-266676",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-17T14:30:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Explorers! Ensuring the best and smoothest gameplay experience is very important to us. We hear you! Today we released a small patch that contains several fixes for issues that got reported by the community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch 1.0.2. contains the following changes",
     "items": [
      {
       "text": "Fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Stuttering videos on PS4 / Xbox One and some PC's configurations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Posters are not fully legible on some settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player can get stuck between pillars in the teamwork challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed redundant 'play without save' option from the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Things we're currently looking into for the next patch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sometimes when completing the game with a perfect score a score of 0 / 0 / 0 is displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Missing subtitles at some points in the boat ride.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The end screen story is sometimes only based on just the first challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Text is being cut-off in the EULA screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lighting in the teamwork challenge does not turn back on after a retry.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Random crash after x amount of time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you still run into any issues, please check out our support page:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
