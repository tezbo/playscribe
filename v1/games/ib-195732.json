  {
   "id": "ib-195732@1.01",
   "gameId": "ib-195732",
   "displayName": "Update 1.01",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-04-15T08:45:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "皆様",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "『Ib』をお楽しみいただき、ありがとうございます。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "本日、ver 1.01にアップデートいたしました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "うごく絵本をキャンセルする際に発生するエラーの対応",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "テキスト表示のバグ修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "オートセーブ場所の調整対応",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "一部パズル等における抜け出し不能になる部分の調整",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "真・ゲルテナ展BGM試聴におけるズーム機能の無効化",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "壁の中にグラフィックが表示される不具合の修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "引き続き『Ib』をお楽しみください。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
