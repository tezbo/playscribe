  {
   "id": "cypress-inheritance-the-beginning-16937@6",
   "gameId": "cypress-inheritance-the-beginning-16937",
   "displayName": "UPDATE 6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-28T23:48:31.000Z",
   "notes": [
    {
     "title": "New Update",
     "items": [
      {
       "text": "6-28-24",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Along with having the game now being done in UE5 with the updates listed in the \"About Section\" we have also updated the following:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Improved AI and Combat Interactions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Improved Lorna Animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Map Added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-ATV Improvements and Additions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Cloaking Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Added Transit Tunnels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Optimization Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Additionally, we are in the process of adding our new Lorna character.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can view the \"Model Concept\" shown below of what will be the new Lorna to be added in next month.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
