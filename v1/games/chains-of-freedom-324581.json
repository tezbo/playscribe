 "releases": [
  {
   "id": "chains-of-freedom-324581@1.0.3",
   "gameId": "chains-of-freedom-324581",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-17T10:13:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, dear players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you so much for your patience and all the valuable feedback you’ve shared in your reviews and forum posts! The wait is over – here’s the list of improvements in the latest build we’ve been working on:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a much-requested Turn Limit toggle to Settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed how ammunition is presented to the player: \"ammo in clip / total clip capacity (inventory stock)\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added exit prompts in areas that you cannot return to.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Raised loot discovery radius.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Slightly increased ammo drops in most levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slightly increased material drops in multiple mid-game levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed or reduced enemy waves in many combat encounters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added more Crystal slots in Places of Power after losing a character to compensate for lost quick slots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Peacekeeper’s Overwatch ability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted or removed specific tough enemies in some encounters to ease difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added or adjusted loot during/after combat, especially extra ammo or consumables.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved quality-of-life mechanics, such as auto-removal of unused quest items and clearer indicators.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Performance and stability improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Check it out and let us know what you think!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
