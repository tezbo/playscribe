  {
   "id": "doctor-who-the-edge-of-reality-139572@2",
   "gameId": "doctor-who-the-edge-of-reality-139572",
   "displayName": "Patch 2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-10-18T16:12:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As we continue to make fixes and improvements to The Edge of Reality we will keep you up to date with fixes as and when they are published.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where save data could become corrupted, preventing players from loading their saves. This fix will not correct already corrupted data, so any effected players will need to delete their save data and start a new game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where progress could be lost when quitting out from the TARDIS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the camera would not be correctly aligned on the opening credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Additional optimization work on Lucia Minor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
