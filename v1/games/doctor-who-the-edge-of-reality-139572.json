   "gameId": "doctor-who-the-edge-of-reality-139572",
   "displayName": "Patch 1.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-10-29T18:13:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here we are with another update to Doctor Who: The Edge of Reality.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various occlusion fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with the Gallifreyan gloves",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the horizon on the Escherverse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved performance on the forest of Lucia Minor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where players could get stuck in a particular area of the forest on Lucia Minor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a graphical issue with the Cybermen in the second Scrapyard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with a particular piece of scenery on the Cyber ship",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with Daleks in the stealth and shooter sections of Metebelis IV",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved the lighting around the Cyber Reaper reveal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where the game could softlock when caught by the Cyber Reaper",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
