  {
   "id": "doctor-who-the-edge-of-reality-139572@4",
   "gameId": "doctor-who-the-edge-of-reality-139572",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-10-22T16:40:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Following on quickly on the heels of the last patch...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the player arm could be seen through when putting away the Sonic Screwdriver",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players would be returned to the start of the third Chaosverse when closing the game after completing the Escherverse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various collision fixes to prevent the player from getting out of bounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the game would softlock if caught by an Angel after quitting to the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the reticule would be seen during the boot flow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced the number of objects that can be picked up in the Scrapyard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed a prompt to use the Sonic Screwdriver on the door of the second Launderette",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
