  {
   "id": "doctor-who-the-edge-of-reality-139572@major-2021-11-16",
   "gameId": "doctor-who-the-edge-of-reality-139572",
   "displayName": "Update - November 16th 2021",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-11-16T15:59:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Below is a list of the latest fixes and items to be addressed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where players may become temporarily unable to use the Sonic Screwdriver",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimization on Victorian London",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Locked player movement during time glitches on Victorian London",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved the starting position of the player on Lucia Minor and Victorian London",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera sensitivity settings now effect object inspection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the binding of arrow keys to interact with the inventory rather than move the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that could occur when attempting to quit to the main menu when loading into another level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Prevented player movement after being killed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the camera would return to the player perspective for a moment after being caught by any Cybermen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The alternative Sonic Screwdrivers will now display the correct colours when used",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a resolution dialogue box on boot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where the back of the TARDIS was not displaying correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimization on Lucia Minor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where players could be caught by Cybermen during a cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added player footstep sounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where the volume would reset after a time glitch or returning to the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the player could back out of certain interactive objects whilst maintaining the interaction",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Emer would continue to prompt the player to pick up the torch in Lucia Minor after picking up the torch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased the delay between hint repetitions for the hint in the office",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where players could walk backwards into Angels with no consequences",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
