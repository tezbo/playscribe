  {
   "id": "doctor-who-the-edge-of-reality-139572@1.6",
   "gameId": "doctor-who-the-edge-of-reality-139572",
   "displayName": "Patch 1.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-10-21T16:24:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've updated The Edge of Reality with another round of general fixes and user feedback issues addressed, here's the list ...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where a softlock could occur on the main menu when spamming inputs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed bloodied bones from the Catacombs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the player may be pushed by certain objects during the confrontation with The First",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the player could retain control of the character on the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a death plane into the Escherverse to prevent players from being softlocked by falling out of bounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimization on the Forest of Lucia Minor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed various collision issues across some levels that would allow the player to go out of bounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor improvements to the animation on the Doctor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a controls layout menu to the main menu and pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue that would cause the Dalek aim to be off center when moving backwards in the shooter section of Metebelis IV",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the player could continue moving after using the Sonic Screwdriver in the final confrontation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lowered the height of the crouch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Prevented the player from crouching whilst playing as a Dalek",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that was causing Emer to repeat a line at the end of the shooter section of Metebelis IV",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where music would stop playing if the player is killed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Potential fix for an issue that caused hitches to occur during Chaosverse levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the subtitles would disappear too quickly on certain levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
