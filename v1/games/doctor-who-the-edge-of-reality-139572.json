  {
   "id": "doctor-who-the-edge-of-reality-139572@patch-2021-11-08",
   "gameId": "doctor-who-the-edge-of-reality-139572",
   "displayName": "Patch - November 8th 2021",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-11-08T10:07:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "And we're back with more tweaks and fixes ...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed translation errors in Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the buzzer in Launderette to flash whilst waiting to be answered",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where players could become stuck after gravity is initially disabled on Lucia Minor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the crane key, and red and black cables would be returned to the inventory after dying to the Dalek in Scrapyard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in the Launderette where the door could be opened by pressing the Sonic Screwdriver button rather than holding it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the player would be returned to the wrong checkpoint in the shooter section of Metebelis IV",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an animation issue on a door on Lucia Minor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in the confrontation with The First where subtitles could become stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players could become stuck behind a console on the bridge of Lucia Minor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
