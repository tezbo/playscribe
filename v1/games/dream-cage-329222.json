   "announcedAt": "2025-02-08T16:15:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I think this update fixes the most important issues that stand out the most and break immersion. These things are:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where you could use the camera, batteries, pills or move while dead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added information on how to scan anomalies when picking up the camera for the first time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where the entity would stand still when spawning in the bathroom.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You spot something else that should be fixed or improved? Stop by discord and let me know!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
