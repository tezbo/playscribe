  {
   "id": "inescapable-no-rules-no-rescue-244764@post-2023-10-26",
   "gameId": "inescapable-no-rules-no-rescue-244764",
   "displayName": "Patch Notes for Oct 26",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-26T07:37:12.000Z",
   "notes": [
    {
     "title": "Inescapable's latest update fixes the following issues",
     "items": [
      {
       "text": "Isak's friendship achievement is now reachable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can no longer bring people back from the dead by fishing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mia's friendship event will no longer spawn right after Eva's trivia",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Exploded buildings no longer exist in later events",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Loading a previous save no longer carries your decisions over in certain situations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
