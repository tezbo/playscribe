  {
   "id": "inescapable-no-rules-no-rescue-244764@hotfix-2023-10-20",
   "gameId": "inescapable-no-rules-no-rescue-244764",
   "displayName": "Hotfix - Oct 20",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-10-20T12:27:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you all for your early support of Inescapable and for your patience. Late last night we began receiving reports of an issue that would cause users to get stuck (or return to) an earlier trivia-style game later in the game, breaking the game flow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have now resolved this issue for all platforms. This fix is currently deploying on Steam and will soon deploy on consoles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For some players, this may require that you load a previous save game (if you have saved during the \"broken\" part). Start-of-day saves are a good candidate for this, and the affected days should be Day 26 and Day 57.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Once again, we'd like to thank you for your patience and for playing Inescapable!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Inescapable Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
