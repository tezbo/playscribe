  {
   "id": "blast-brigade-vs-the-evil-legion-of-dr-cread-146722@post-2022-04-29",
   "gameId": "blast-brigade-vs-the-evil-legion-of-dr-cread-146722",
   "displayName": "Blast Brigade | Patch Notes (April 29, 2022)",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-04-29T10:42:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new update is available for Blast Brigade vs. the Evil Legion of Dr. Cread. The latest version of the game contains the following changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug with a door which could be closed after death in Temple of the Sacred Trial location.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused an invisible cutscene after defeating the DOMINANT OVERSEER boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with getting the final achievement when playing with multiple save slots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the player could be pinned down by the generator in the Screaming Cliffs puzzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused incorrect gold fly spawn during the final boss fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect flower enemy behaviour.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused the first gun to disappear for early access players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor visual, audio, and localization fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoying Blast Brigade? Join a worldwide network of BLAST agents over on the official Blast Brigade Discord server!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
