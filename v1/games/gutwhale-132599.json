 "releases": [
  {
   "id": "gutwhale-132599@major-2020-04-20",
   "gameId": "gutwhale-132599",
   "displayName": "Two Weeks After Release - Quick Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-04-20T19:01:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Heyo :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It has been exactly 2 weeks since Gutwhale released!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Again, thank you all for your support, nice comments and helpful feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Releasing a game is pretty stressful. After one exhausting month of development, I was not prepared for that. While my mental health and overall life is pretty good, I just felt frozen in place.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Not taking a few days off after release was a big mistake, and I have spend the last 2 weeks fiddling with small parts of the game, never making any real progress on the updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This post is just a quick apology for not being there fully to support the game, as well as to say that now, finally, I am able to work on updating Gutwhale.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "josh",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
