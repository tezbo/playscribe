  {
   "id": "persona-3-reload@1.06",
   "gameId": "persona-3-reload",
   "displayName": "Patch 1.06",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-09-10T04:27:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The latest patch has been released for Persona 3 Reload, which was released on 2/2/2024, and Persona 3 Reload: Expansion Pass, downloadable content that was released on 3/12/2024. Please see below for details:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Persona 3 Reload",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The “Change Battle BGM” function has been expanded to allow different BGMs to be set for “Change Normal Battle BGM” and “Change Boss Battle BGM”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "By registering any BGMs to “Favorite BGM” and then selecting “Favorite”, the registered music will be played randomly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The default song is now also subject to random playback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Persona 3 Reload: Expansion Pass",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added “Episode Aigis”, which depicts the story after the main story is completed. Persona 3 Reload: Expansion Pass is required to play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "※The update patch will be applied automatically when the game is launched.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
