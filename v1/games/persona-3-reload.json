  {
   "id": "persona-3-reload@major-2025-10-22",
   "gameId": "persona-3-reload",
   "displayName": "Coming Soon: Update Patch With 8 Songs from Persona 3 Vocalist, Yumi Kawamura!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-22T00:03:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings from the Persona PR team!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are pleased to announce that an update patch containing eight songs performed by Yumi Kawamura - the original vocalist of Persona 3 - will be distributed by Thursday, October 23rd.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update allows players to experience Yumi Kawamura’s vocal tracks from Persona 3 and Persona 3 FES as background music during dungeon exploration and battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also received a comment from the singer, Yumi Kawamura!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44538637/5d66a0337a2821509e376f1b4bf9bc5e7158ad8c.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Tracks",
     "items": [
      {
       "text": "Burn My Dread -Last Battle-",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Mass Destruction",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Deep Mentality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "When The Moon's Reaching Out Stars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Want to Be Close",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Memories of You",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Mass Destruction -P3fes Version-",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Brand New Days",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "*Please note these songs can only be applied in dungeons and during battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44538637/f63b48cd7b53f56b568d0a1e9a69aba32750040a.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The new songs can be set with the “Change Battle BGM,” “Change Boss Battle BGM,” and “Change Dungeon BGM” setting, accessible from the Config menu under System settings. We invite you to enjoy it alongside the soundtrack of Persona 3 Reload.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
