  },
  {
   "id": "greedfall-27092@patch-2019-09-24",
   "gameId": "greedfall-27092",
   "displayName": "GreedFall - A new patch is coming soon!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2019-09-24T16:57:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Green bloods, my friends,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would like to thank our amazing community for helping us out identifying the various issues still present in the game. We are now working hard on a new patch aiming to fix those issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can expect several major bugs to be solved thanks to this new patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Coming to you soon…",
     "items": [
      {
       "text": "Quests being debugged",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera bobbing rectified: players will have more control over the camera",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Invert X-Axis option added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The mage skill \"Ranged Shadow Impact\" has been modified",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several aggro areas have been improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Trophies debugged",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localisation issues fixed for French, Chinese, Polish, Russian, Portuguese and English - Thanks to everyone who reported these!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will reveal more soon when the patch is released! Stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you are all enjoying your time on Teer Fradee.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
