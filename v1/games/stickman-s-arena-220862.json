  {
   "id": "stickman-s-arena-220862@post-2022-11-17",
   "gameId": "stickman-s-arena-220862",
   "displayName": "Bug Fixes and Balancing Changes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-17T23:17:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "-Enemy That Shoots now has more health",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Bug where you would combine a weapon and it would \"break\" the game has been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Legendary items are cheaper and now easier to find as the waves progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-reroll is now cheaper and the cost multiplier per wave is a little less",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "a lot more enemies now spawn per wave to make the game more fun",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "enemies do less damage because there are more enemies on screen now: -life steal has been nerfed: -more quality of life changes: Let me know how the balancing is so I can keep improving player experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
