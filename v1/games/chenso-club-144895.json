  {
   "id": "chenso-club-144895@dayone-2022-09-01",
   "gameId": "chenso-club-144895",
   "displayName": "Day one patch",
   "kind": "dayOne",
   "kindBasis": "studio",
   "announcedAt": "2022-09-01T12:51:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I hope you are enjoying the game so far <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are some hotfixes for day 1",
     "items": [
      {
       "text": "Fixed small bugs regarding Blue's Attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chase animations on enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added music to Chenso HQ.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed asian language offset in gui",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Big Brain Brian visual indicator disappears properly when failing its mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed resolution button always defaulting to 1920x1080",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Shop now has grace period on powerups to avoid accidental purchase upon entering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed control scheme for PS4 controller in main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added Discord Join Server button in main menu: Feel free to give us suggestions what you would like to see in the game for future updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
