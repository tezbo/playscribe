   "id": "chenso-club-144895@post-2022-10-03",
   "gameId": "chenso-club-144895",
   "displayName": "Unlock Mouse (For accessibility)",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-10-03T11:42:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've received some feedback where some accessability tools were not available because of us locking the mouse, so we have an accessability option to unlock the mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Feel free to report any issues regarding this feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
