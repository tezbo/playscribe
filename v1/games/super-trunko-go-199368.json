   "id": "super-trunko-go-199368@major-2023-02-21",
   "gameId": "super-trunko-go-199368",
   "displayName": "Important Update for Super Trunko Go followers",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-21T10:27:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I would like to relay some issues that I have currently been experiencing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have hit quite a number of obstacles with trying to get the controller to connect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "without problems. I have therefore made the difficult decision to release the",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "game on Steam for keyboard/ mouse and Steam Deck play only.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "I apologise to anyone who was looking forward to a controller experience,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "which leads me to remind that we have a publisher working on the console",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "versions (Switch, Xbox, Playstation) and are expected to be released later",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "in the year. Stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
