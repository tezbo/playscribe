  {
   "id": "heaven-seeker-the-savior-of-this-cruel-world-304554@1.0.5",
   "gameId": "heaven-seeker-the-savior-of-this-cruel-world-304554",
   "displayName": "Update 1.0.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-17T04:44:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is the HEAVEN SEEKER development team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released Version 1.0.5 today to address several issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Please see the details of the update below",
     "items": [
      {
       "text": "・Adjusted the behavior of Auto-Aim (restored to the previous behavior).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where some operation navigation was not displayed correctly during keyboard/mouse operation.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Fixed a problem where key configurations would be overwritten when switching between multiple controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Resolved the following issues related to the \"Form Change Skills\" unlocked via DLC:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "During Form Change, the face icon in the upper-left corner of the screen did not update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "During Form Change, the animation when defeated was incorrect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When removing Form Change Skills, held items were not displayed correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
