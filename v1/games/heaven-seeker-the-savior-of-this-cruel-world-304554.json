   "announcedAt": "2025-06-20T05:00:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, this is the HEAVEN SEEKER development team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we have released Ver. 1.2.0. The update contents are as follows.",
