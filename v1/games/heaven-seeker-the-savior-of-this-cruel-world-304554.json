  {
   "id": "heaven-seeker-the-savior-of-this-cruel-world-304554@1.1.0",
   "gameId": "heaven-seeker-the-savior-of-this-cruel-world-304554",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-28T03:02:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello! This is the HEAVEN SEEKER development team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we’ve released Ver. 1.1.0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please see below for the details of the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "**New Mode: Online Challenge Mode** Compete with Seekers from around the world in this score and time-based mode!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This mode is only available when playing on the \"EXPERT\" difficulty. If you clear a dungeon while entered in this mode, the following information will be recorded on the leaderboard:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clear Score / Clear Time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Character Used",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Username",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Date & Time of Registration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Challenge it again and again, and test your skills against players worldwide!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: Online Challenge Mode is available in the Steam version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Feature: Time Display",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "To accompany the Online Challenge Mode, we’ve added a new “Time Display” feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now see the elapsed time during exploration.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This can be toggled ON/OFF from the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "However, during Online Challenge Mode, the timer will be forcibly turned ON.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
