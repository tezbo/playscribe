  },
  {
   "id": "heaven-seeker-the-savior-of-this-cruel-world-304554@1.0.1",
   "gameId": "heaven-seeker-the-savior-of-this-cruel-world-304554",
   "displayName": "Update 1.0.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-27T08:27:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello. This is the HEAVEN SEEKER development team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released an update that includes the following fixes and adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "＜Fixes＞",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where certain achievements could not be obtained correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Some achievements requiring no bombs or no damage under specific conditions could not be obtained.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Achievements requiring the acquisition of all items and other elements could not be unlocked properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※For achievements requiring the acquisition of all items, if you have already met the conditions, the check for obtaining them will be executed at the following times:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When you start an exploration / When you acquire any item in the dungeon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected the behavior of the Grimoire \"Thunder.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The re-shooting position of shots due to the effect of the side book \"Chain Spell\" was incorrect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the Grimoire calibration effect of the side book \"Spell Lightening\" was not displayed correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed the following issues related to the delay field generated by some enemies:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The effect moved along with the enemy's movement, causing a discrepancy with the actual effective range.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected an issue where images of some side books in the compendium were reversed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "・Fixed the following issues in Sky Castle History",
     "items": [
      {
       "text": "-When displaying result details, \"High Score\" and \"New Record\" appeared regardless of the actual record.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-The sorting results for ascending and descending order in \"Recent Records\" were reversed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-In the \"Clear Time\" category of the history, results that did not meet the conditions were displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "・Fixed the following issues in the options menu",
     "items": [
      {
       "text": "-After setting the control method from presets, reopening the options menu reset it to default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-The \"Reset to Default\" function in the free key configuration settings did not work correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "＜Adjustments＞",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Adjusted the terrain of the entrance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Adjusted the terrain of some dungeons to address areas where attacks might not reach.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Adjusted the default master volume to 50%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Made some adjustments to the display of credits and end rolls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We are currently reviewing and addressing other reported issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
