  {
   "id": "star-trek-legends-145883@2024.03.04",
   "gameId": "star-trek-legends-145883",
   "displayName": "Patch 2024.03.04",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-04T18:06:21.000Z",
   "notes": [
    {
     "title": "Survival Fixes",
     "items": [
      {
       "text": "The “Morale Up” power-up is no longer granting an “Attack Up” buff and now correctly boosts morale in Survival mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Survival rewards correctly display rewards earned by a player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Summoning Fixes",
     "items": [
      {
       "text": "Summoned tokens show the quantity of each pull instead of combining multiples that are earned.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Summoned new units now default open with skill info open.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI/UX Functionality",
     "items": [
      {
       "text": "Several story nodes were losing back button functionality within the story node menu. This has been corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The breadcrumb on the Daily Rewards is now displaying correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tech Defense icons have been updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The text on the reinforcement screen “select one crew” was behind the reinforcement text on the Steam deck. This caused interaction issues and has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The color of the UI highlight glows now match the color of the nodes themselves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A bug that prevented the on screen keyboard from functioning correctly after sending a message has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Support",
     "items": [
      {
       "text": "The correct support email is now displayed in the support pop-up: startreklegends@tiltingpoint.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
