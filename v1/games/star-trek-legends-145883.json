  {
   "id": "star-trek-legends-145883@0.9.2",
   "gameId": "star-trek-legends-145883",
   "displayName": "Update 0.9.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-03T18:15:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As mentioned in previous communication, we have the fixes for aforementioned issues with a couple extra fixes. The following issues have been addressed in this build:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Daily Goals Not Resetting - Players should now see new daily rewards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Claim Button Malfunction - Claim button should be working as expcted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shuttle Recall Display Issue - We updated the UI to better reflect the claimable rewards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Survival 101+ Crashes - Exceeding Survival levels 100 should no longer cause game crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Missing Episodes - Episodes should appear as expected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Alliance Crash - Leaving an alliance will no longer cause the game to crash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "LLAP,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The Star Trek Legends Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
