     "title": "Changes",
     "items": [
      {
       "text": "We have corrected a server issue where the number of PvP matches and Alliance Raids was limited per day. Players should now be able to participate in both as much as they want.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If players are still experiencing issues with access to either of these features, please continue to reach out with your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "LLAP,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Star Trek Legends Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
