       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Live long and prosper,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Star Trek Legends Team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
