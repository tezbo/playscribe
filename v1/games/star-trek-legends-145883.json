  {
   "id": "star-trek-legends-145883@0.9.6",
   "gameId": "star-trek-legends-145883",
   "displayName": "Update 0.9.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-14T14:59:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Alliance Balance Changes",
     "items": [
      {
       "text": "Increased alliance progression rewards from 5 to 10.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased alliance currency reward per progression chest, from 250 to intervals of 250, starting at 500.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Final chest of alliance progression reward gives a much larger amount than previous chests, to incentivize maxing it out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increase alliance battles exp from 250 to 1250.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced alliance power up node requirement from 25 to 15.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Created a proper ratio between alliance currency - latinum. Now, 100 alliance crystals = 2000 latinum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Tweaked all alliance store prices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added better biogels to the alliance store, based on player level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added summon shards to an alliance store slot, shared with the existing power cell slot. Which of the two appears there is going to be random.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced points required to unlock alliance chests from an interval of 25 to an interval of 15.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Alliance UI Fixes",
     "items": [
      {
       "text": "Alliance currency now displays on all screens while in the alliance menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Alliance info is now not obscured while in the alliance menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "UI functionality changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hovering over info buttons with your mouse will now require a click for that info pop-up to open thus eliminating unwanted information overload for players.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The player ID “copy” button has been made functional.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Further improvements to the Mission menu selection screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolution and Quality settings will now save between sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Display issue for Seven of Nine",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Live Long and Prosper,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Star Trek Legends Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
