   "announcedAt": "2023-03-19T07:39:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some small but significant adjustments that should improve playability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the hitbox on the running animation so that it should be easier to jump off ledges without falling (not coyote time though)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Middle (white) worm on the boss of stage 2 no longer shoots acid at random! It's now in a predictable pattern. Also changed the acid color to stand out better against the background.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Small fix on the background of stage 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
