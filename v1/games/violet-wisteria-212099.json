  {
   "id": "violet-wisteria-212099@1.01",
   "gameId": "violet-wisteria-212099",
   "displayName": "Update 1.01",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-22T05:14:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I made some very small adjustments before Steam sends out the list of demos to the press for the upcoming Steam Next Fest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Renamed difficulty modes to \"hypereasy\" and \"ultrahard\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The easier difficulty setting is now the default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added analog stick support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added sfx when Minotaur takes damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where player can clip into the water fountain",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
