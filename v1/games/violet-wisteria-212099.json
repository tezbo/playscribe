  {
   "id": "violet-wisteria-212099@1.02",
   "gameId": "violet-wisteria-212099",
   "displayName": "Update 1.02",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-27T16:52:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update fixes a few small bugs that weren't game breaking for the most part but noticeable once you found them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Infinite magic bug fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "No longer crashes when entering special mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed button input issue with magic select",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minotaur no longer drops out sometimes during hitflash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other small gameplay tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
