  {
   "id": "violet-wisteria-212099@major-2023-02-24",
   "gameId": "violet-wisteria-212099",
   "displayName": "Update 2/24/2023",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-24T05:27:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a few bugs and also added some functionality. The main changes are as follows.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players can now choose what stage to start from when playing on Practice mode, up to the last stage you've reached",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All worms on the boss of stage 2 now have hit boxes, not only the active one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boss 3 now has no hit box after dying",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Can no longer soft lock in stage 4-3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed moving floors overlapping with player in stage 6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A couple bosses are easier, primarily stage 7: Possibly a couple other things I forgot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
