  {
   "id": "the-darkside-detective-35283@major-2023-05-02",
   "gameId": "the-darkside-detective-35283",
   "displayName": "April Steam Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-02T15:14:03.000Z",
   "notes": [
    {
     "title": "Fixed the following bugs",
     "items": [
      {
       "text": "Black screen on Baits Motel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "No Transition In Between Screens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "if you give emily the milk out of order, the candy shop is closed and you cannot add floss to fountain, breaking case",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dialogue not refreshing correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Achievements not triggering reliably",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "load music carries into cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tape hotspot on table in cave in Loch Mess remains after picking up tape",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Unity splash screen at the start",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Case summary for Tomb Alone is cut short",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resizing issues going in and out of Windowed Mode",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Issue clicking through Item dialogue while your Cursor is still on the Item",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various visual and SFX glitches being caused by Save/Load",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can interact with the Case 1 Minigame when Paused",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can't click on McQueen for their usual dialogue when in the Shooting Range Screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can interact with the Minigame when clicking through dialogue in the Case 4 Water Pipe Minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can interact with the final Minigame (Tinfoil Hat) of Case 5 while Paused",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
