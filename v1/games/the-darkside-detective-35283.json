  {
   "id": "the-darkside-detective-35283@post-2023-12-05",
   "gameId": "the-darkside-detective-35283",
   "displayName": "Darkside Detective - PlayStation 5 Patch Notes (2023/11/30)",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-12-05T00:31:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey detectives,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released a patch for Darkside Detective that fixed issues with older save files not being compatible with current DSD1 Builds, fixed issues where saving during a case causes the player to load into an infinite loop, and more. You can read the full patch notes below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Fixed issue with older save files not being compatible with current DSD1 Builds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the very slow cursor speed in Cases 6 and 7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some hotspot errors in Chinese localisation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Unity splash screen showing at the start",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where saving during a case causes the player to load into an infinite loop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with being able to interact with minigames and hotspots while the game is paused",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues where save/loading would cause items to disappear/reappear incorrectly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various visual and audio glitches on save/loads",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the strange behaviour on the How To Play Menu after completing Case 9",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various hotspot inconsistencies and placements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improvements and minor bug fixes to the menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where resetting the game caused the Power Button to show up in the Main Menu on Consoles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "General optimisation and improvements to load times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Riv Otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
