  {
   "id": "morsels-314931@0.34.2",
   "gameId": "morsels-314931",
   "displayName": "Update 0.34.2",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-02-09T21:10:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi folks - we've just added a feature that we've seen requested a few times: the option to rebind gamepad inputs in the controls menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I can assure you that this task was fiddlier than any reasonable person would imagine it'd be, but hopefully it'll be a helpful feature to have.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our capacity to test this on different hardware is a bit limited, so please let us know if you run into issues with it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Toby",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
