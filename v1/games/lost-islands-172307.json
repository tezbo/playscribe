  {
   "id": "lost-islands-172307@post-2023-12-11",
   "gameId": "lost-islands-172307",
   "displayName": "Bugs Fixed",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-12-11T22:36:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update fixes bugs and prepares the game for cross-platform play, will be unlocked in the next update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The icons in the map are enlarged for better viewing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Totem, causing blocking of construction has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed \"The End\" quest for PS5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "The lighting radius of torches has been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now control the Weather and UI sounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new climbing system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed falling under the terrain, that was sometimes happening to some people.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimizations have been made....",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game is being prepared for Cross-Platform Play, Co-Op, Multiplayer, will be enabled in the next update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
