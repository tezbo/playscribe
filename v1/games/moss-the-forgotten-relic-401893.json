  {
   "id": "moss-the-forgotten-relic-401893@1.0.2",
   "gameId": "moss-the-forgotten-relic-401893",
   "displayName": "Hotfix 1.0.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-07-29T15:11:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[p align=\"start\"]Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Hotfix 1.0.2 Patch Notes",
     "items": [
      {
       "text": "Using Skip Combat in Moss Book I will now correctly void the \"Protector of the Realm\" achievement/trophy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a rare crash in Moss Book I that could occur when returning to the game selection menu shortly after entering a level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players could get locked out of input after collecting the Armor or Weapon in the Twilight Garden.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players could get stuck and unable to proceed in the Twilight Garden when entering through the second or third portal.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in the Mire Temple where the camera didn't zoom out properly during the final puzzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the gates to the Twilight Garden trials could lower prematurely before exiting the area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare crash that could occur when transitioning between levels after using Skip Combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where certain debug commands could be triggered via keyboard input.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a rare crash related to Steam Input during game exit.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where Windows Resolution Scaling wasn't applying correctly in-game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the ability to Exit Game, toggle VSync, and adjust Resolution Scaling directly. (Steam Deck)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[p align=\"start\"]Thanks for all the kind words and feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]If you spot any issues or have suggestions, reach us here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
