  {
   "id": "moss-the-forgotten-relic-401893@major-2026-09-03",
   "gameId": "moss-the-forgotten-relic-401893",
   "displayName": "Play Together Update: Local Co-Op is Here! 🐭🎮🎮",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-03T15:57:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/46123654/778a3d1ddad5389cead89cb93adde8281fa7b669.png\"]Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been just over a month since launching Moss: The Forgotten Relic, and TODAY we’re releasing the free Play Together Update for Moss: The Forgotten Relic, introducing two-player local couch co-op.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🐭 One player controls Quill: platforming, fighting, exploring, and being generally tiny-but-brave.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✨ One player becomes the Reader: moving obstacles, helping solve puzzles, protecting Quill, and delivering some very important high-fives.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/46123654/6c5d23ebbd759d3a1081d3b7ea677425d1aa807c.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Alongside local co-op, today’s update includes",
     "items": [
      {
       "text": "Improved Library Scroll Camera to make viewing and tracking collectibles easier from the Library",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Quality-of-life improvements and bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For all the details on how Play Together works, supported controllers, and more, check out our Moss: The Forgotten Relic FAQ \\[Play Together Update].",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Steam Flash Sale: Save 20%",
     "items": [
      {
       "text": "Grab two controllers, decide who’s Quill and who’s the Reader, and share the adventure together. 🐭✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/3914860/Moss_The_Forgotten_Relic/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "— Team Polyarc",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/46123654/5106099d9eeab90075e3bab3412e24d0fc8ff3ff.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/46123654/43de8db2a2c06fa5b7b25e87178c9f06987b1bc5.png\"][img src=\"{STEAM_CLAN_IMAGE}/46123654/c8d954ad7efdf20ace2c06fa6dc1c6905de61467.png\"][img src=\"{STEAM_CLAN_IMAGE}/46123654/3248cb4f2a9cec28c3a4129e5bba1a105e5250f7.png\"][img src=\"{STEAM_CLAN_IMAGE}/46123654/67acbab97bbed668e98edbbf6080e6da128a874d.png\"][img src=\"{STEAM_CLAN_IMAGE}/46123654/532f623dec84bbfdcb31f70206fed9c8a3b97b48.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
