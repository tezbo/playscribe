  {
   "id": "blackwind-159751@1.0.2.5",
   "gameId": "blackwind-159751",
   "displayName": "Patch 1.0.2.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-02-28T01:21:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Battleframe Pilots!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are pushing more updates as we continue to improve the gameplay experience. This patch addresses the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removal of more dialogue lines that may sound annoying to some people.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the power icon was disappearing in certain occasions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Custom resolution settings now correctly restores when reloading the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a small tutorial for the ability to teleport the drone when it is too far from the player to re-join.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some minimap details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Unfortunately, this patch is only available for players currently on Windows. We are working on rolling out these updates for Mac users soon!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
