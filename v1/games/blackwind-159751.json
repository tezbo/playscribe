  {
   "id": "blackwind-159751@1.0.2",
   "gameId": "blackwind-159751",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-02-07T00:55:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Blackwind Protocol: Updating… Updating… Updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Blackwind Patch 1.0.2 …",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "… Released.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Attention Battleframe Pilots!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We want to, firstly, thoroughly thank everyone who provided our team with feedback on the Blackwind release! The development team has been working incredibly hard to resolve the community’s concerns promptly, and we are proud to announce that we have delivered the first patch for Blackwind!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The focus for this patch was for quick turnaround with the key presented issues, and so you can now expect…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1) Adjusted the camera positioning to improve gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2) Reduced repetitive one liner voice overs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3) Provided a mini-map for outdoor environments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4) Resolved crashes at certain checkpoints.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5) Added the ability to teleport the drone back to the player when it's too far to re-join.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to report any issues to our team support@blowfishstudios.com.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wish you luck!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
