  {
   "id": "disgaea-7-vows-of-the-virtueless-214530@1.04",
   "gameId": "disgaea-7-vows-of-the-virtueless-214530",
   "displayName": "Patch 1.04",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-10T20:12:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Doods,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've released an update for Disgaea 7: Vows of the Virtueless to address crashing issues with the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For players unable to play the game after selecting Full Screen, it'll now give you an error message and revert to Windowed mode instead of closing. Additionally, fixed a crash that can occur if you try to select a full screen resolution from the list when the functionality isn't supported.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "For players unable to play the game after version 1.02's update, fixed an issue with language selection that was preventing the game from starting properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a problem in which Evilities referring to elements were not applying to composite elements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed possible slowdowns when loading files, which may improve performance during some effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please continue to discuss issues you may have in our Troubleshooting forum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
