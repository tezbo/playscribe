  {
   "id": "disgaea-7-vows-of-the-virtueless-214530@1.08",
   "gameId": "disgaea-7-vows-of-the-virtueless-214530",
   "displayName": "Update 1.08",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-19T22:16:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Doods,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've released an update for Disgaea 7: Vows of the Virtueless to address crashing and performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reverted the fix \"Fixed possible slowdowns when loading files\" because it had the opposite effect for some players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Attempt to fix random crashes occurring when calling a vote at the Dark Assembly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Attempt to fix issues with the game starting for some players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've also provided a couple previous versions under the Beta branch functionality on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please continue to discuss issues you may have in our Troubleshooting forum. Please share your PC specifications in that forum if you're encountering crashes or performance issues with this version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
