  {
   "id": "disgaea-7-vows-of-the-virtueless-214530@1.02",
   "gameId": "disgaea-7-vows-of-the-virtueless-214530",
   "displayName": "Patch 1.02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-07T01:02:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Doods,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've released a small update for Disgaea 7: Vows of the Virtueless to address a couple more issues with the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Correct order that settings are saved so that you can't become unable to open the game. There was an issue with this taking effect in 1.01. Sorry for the inconvenience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you are currently receiving the \"Failed to resize the window size.\" error, please use the following instructions to reset your PC-specific settings:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Open in Windows Explorer: %appdata%\\Nippon Ichi Software, Inc\\Disgaea 7\\",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Delete the file: setting.ini",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This will not affect your game progress or gameplay-related settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that we're still investigating this error's root cause. If it affects you, try setting your Window Type to Borderless instead of Full Screen.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where Geo Symbol destruction and similar repeating sound effects could overlap and become louder than intended at high frame rates, with fast mode enabled, or with skip modes enabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the display of certain skills under certain Wickedhancements. Elements should now be reported correctly when it would previously appear as None.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the first-launch of the game not checking your Steam language and always starting in English.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please continue to report any issues in our Troubleshooting forum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
