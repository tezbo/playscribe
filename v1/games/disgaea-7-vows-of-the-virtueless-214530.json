  {
   "id": "disgaea-7-vows-of-the-virtueless-214530@1.01",
   "gameId": "disgaea-7-vows-of-the-virtueless-214530",
   "displayName": "Patch 1.01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-05T00:47:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Doods,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've released a small update for Disgaea 7: Vows of the Virtueless to address a couple critical issues with the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reset rank correctly on new seasons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix visual glitch when selecting the target using certain skills too quickly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Correct order that settings are saved so that you can't become unable to open the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you are currently receiving the \"Failed to resize the window size.\" error, please use the following instructions to reset your PC-specific settings:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Open in Windows Explorer: %appdata%\\Nippon Ichi Software, Inc\\Disgaea 7\\",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Delete the file: setting.ini",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This will not affect your game progress or gameplay-related settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that we're still investigating this error's root cause. If it affects you, try setting your Window Type to Borderless instead of Full Screen.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please continue to report any issues in our Troubleshooting forum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
