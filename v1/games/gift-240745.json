   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have implemented the following updates for the Mac version of \"Gift\":",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes from Version 1.0.7",
     "items": [
      {
       "text": "● We have addressed an issue where the red floor with logs on it could become indestructible, leading to game progression being blocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Other minor bug fixes have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The content for this update is the same as the previously released Windows version 1.0.8.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We sincerely apologize for the delay in updating this version compared to the Windows version.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
