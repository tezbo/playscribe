  {
   "id": "gift-240745@1.1.0",
   "gameId": "gift-240745",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-23T15:23:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Below are the details for the version update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes from Version 1.0.9",
     "items": [
      {
       "text": "Adjusted the breakthrough difficulty by adding checkpoints along the way where the chasing characters appear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the breakthrough difficulty by changing the speed of the chasing characters in several locations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the direction of the player when returning to the checkpoints to avoid being captured again immediately after restarting from a checkpoint.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "After watching the game ending, players will be able to select “Start Game” and choose to return to the checkpoint immediately before the ending.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An option to display a viewpoint marker of a small dot in the screen center is added to reduce the motion sickness that may be caused by the frequent screen shaking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A notification icon is added to the Album button on Option screen when there is a new photo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustment to the game opening cutscene of the sinking ship",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "●Bug Fixes",
     "items": [
      {
       "text": "Fixed the issue where the third controllable character is unable to move ahead in a tilted position in the area where the barrel falls from above the character.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue where the third controllable character is unable to move ahead in a tilted position in a specific area in the stage where the character’s paint is scattered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We hope you continue to enjoy playing “Gift” in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
