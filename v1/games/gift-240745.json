   "announcedAt": "2024-05-30T11:28:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have implemented the following update for the Windows and Mac versions of 'Gift'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes from Version 1.0.8",
     "items": [
      {
       "text": "● Addressed an issue where arriving at a specific location at a certain time would cause an unintended tilt state, making progression extremely difficult. This has been corrected to ensure the intended tilt state.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your continued support of 'Gift'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
