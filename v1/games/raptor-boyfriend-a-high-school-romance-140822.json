  {
   "id": "raptor-boyfriend-a-high-school-romance-140822@post-2021-07-27",
   "gameId": "raptor-boyfriend-a-high-school-romance-140822",
   "displayName": "AttributeError: 'TransformState' object has no attribute 'size' Issues",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-07-27T21:15:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are receiving reports from certain players in the last few days regarding a bug with a traceback text as follows:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I'm sorry, but an uncaught exception occurred.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "While running game code",
     "items": [
      {
       "text": "AttributeError: 'TransformState' object has no attribute 'size'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is due to the rollback on the build we had to do a few days prior. Essentially your old save file has stored a variable that no longer exists in the current build. We are looking in to eradicating this issue but for now, rolling back or clicking \"ignore\" in the bottom corner of this exception screen should momentarily resolve it. If any of you want a more thorough fix, we'd be happy to walk you through it, but the process may require you to lose your save files. If you are experiencing this issue please stay tuned for our updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rocket Adrift",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
