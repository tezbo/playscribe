  {
   "id": "raptor-boyfriend-a-high-school-romance-140822@1.4",
   "gameId": "raptor-boyfriend-a-high-school-romance-140822",
   "displayName": "Update 1.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-07-25T01:56:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It was brought to our attention that some pc users with NVIDIA graphics cards may be experiencing graphical/rendering errors with the game. We corrected the issue for now by rolling back on the latest version of our engine that still had support for certain GPU accelerators on the PC build. Hopefully, there will be no future issues with rendering and/or graphical bugs. If there are, please let us know here on our Steam updates page! Thanks for your support,",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Pat, Titus & Lindsay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
