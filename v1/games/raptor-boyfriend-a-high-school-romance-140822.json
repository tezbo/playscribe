  {
   "id": "raptor-boyfriend-a-high-school-romance-140822@2.0",
   "gameId": "raptor-boyfriend-a-high-school-romance-140822",
   "displayName": "Update 2.0",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-30T20:27:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for letting us know about some glitches, namely for the achievement \"Played the Field\". We have fixed this along with some other things:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An image glitch with Stella's composite showing the wrong size in episode 3, scene 8.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated the credits to reflect Sloane's proper name: As for getting this achievement, we won't tell you how, but it has to do with amount of times you call each character and the amount of times you choose to spend time with each one. :): Also another update - Raptor Boyfriend will be coming to consoles December 14th!: This will include PS4/5, Xbox series x/One, and Nintendo Switch. So now you can experience Stella's last year of high school from the comfort of your couch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    }
   ],
