  {
   "id": "raptor-boyfriend-a-high-school-romance-140822@1.1",
   "gameId": "raptor-boyfriend-a-high-school-romance-140822",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-07-18T19:01:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It was brought to our attention that there were accessibility issues regarding reading the dialogue history in case a player skips ahead by accident, as well as the \"no wait\" function disrupting player's reading experience. We've added the history log into the quick menu (in the top right-hand corner) so any dialogue missed can be read there. Also there should be no automatic skipping in the dialogue anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pat, Titus & Lindsay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
