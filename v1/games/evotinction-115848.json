  {
   "id": "evotinction-115848@1.05",
   "gameId": "evotinction-115848",
   "displayName": "Patch 1.05",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-09-24T08:18:46.000Z",
   "notes": [
    {
     "title": "v1.05 Patch Notes",
     "items": [
      {
       "text": "Changes and Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized the visual presentation of cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where VSync settings might not take effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some visual effects were incorrect after returning from the X-lab.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where item pickup effects in the late game were behaving incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an overlapping issue while P.I. was open.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where incorrect key prompts could appear in certain situations when using a keyboard and mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where text prompts from the training simulation could appear in other scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Known Issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter an issue where the conversation with 0z does not trigger early in the game, try removing any USB devices (other than keyboard, mouse, and game controller) and restarting the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We have noticed that certain USB devices, especially audio devices, may cause issues such as preventing NPC dialogue playing or, in some cases, even application crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "September 24, 2024",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spikewave Games & Astrolabe Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
