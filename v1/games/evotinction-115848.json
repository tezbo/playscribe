  {
   "id": "evotinction-115848@1.04",
   "gameId": "evotinction-115848",
   "displayName": "Patch 1.04",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-09-19T09:56:38.000Z",
   "notes": [
    {
     "title": "v1.04 Patch Notes",
     "items": [
      {
       "text": "Changes and Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now Doctor's batteries will fully replenish after death or restart.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new sets of attack indicators for the Swarm Queen encounter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue preventing the final achievement \"Survivor\" from unlocking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where key rebinding sometimes incorrectly reset.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved the cosmetic presentation of high ratings earned in simulation training.",
       "ps5ProOnly": false,
       "pcOnly": false,
