  {
   "id": "evotinction-115848@1.07",
   "gameId": "evotinction-115848",
   "displayName": "Patch 1.07",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-29T11:57:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the last week of October, the Genies in Evotinction have donned their Halloween costumes, so don’t let them catch you! Additionally, there are some QoL improvements and bug fixes. Wish you all a smooth stealth experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Holiday Update",
     "items": [
      {
       "text": "Added Halloween costume for the Genies!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Usability Update",
     "items": [
      {
       "text": "Supported more screen aspect ratios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized map loading—exploring feels safer now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the disappearing logic for collectible hints—good news for perfectionists.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimized the occlusion tolerance for the little cart transporting containers—no more worries about missing a bit of visibility that could get you caught.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced the tutorial guidance for the reflection mode (slow-motion when detected).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the visual effects when the geological scanner's movement module is hacked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced the visual representation of regional synchronization effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed issues with incorrect splitting of subtitles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved potential misrepresentation of game completion percentage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed subtitles in levels not disappearing after completing simulated training.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected the malfunctioning smoke alarm in the “Retrieve Data” training simulation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed timing issues for the “Firewall Not Installed” prompt.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved lighting errors that could occur in the Nature Hall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed potential loss of abilities when dying due to network downtime.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected logical errors in controls during the Queen Bee boss fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with DLC costumes not being applied in certain cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "That’s all for now; we look forward to your valuable feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "October 29, 2024",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Spikewave Games & Astrolabe Game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
