      },
      {
       "text": "Improved interaction experience for developing skills",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced gun retraction when against a wall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Refined adaptive trigger experience",
       "ps5ProOnly": false,
