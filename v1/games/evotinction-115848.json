   "notes": [
    {
     "title": "v1.01 Patch Notes",
     "items": [
      {
       "text": "Bug fixes and Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the jittery movement of the mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where VSync could not be enabled in certain situations. (Note: When DLSS 3 Frame Generation is enabled, VSync cannot be activated—this is expected behavior.)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug that prevented the L1+R1 (LB+RB) skill from being used in some cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue where keyboard and mouse control of AI skills could not be exited properly.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a conflict between the camera shut down input prompt and the zoom in/out input prompt.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We’re hard at work on more improvements, so stay tuned for future patches!",
