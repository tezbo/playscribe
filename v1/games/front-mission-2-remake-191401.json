  {
   "id": "front-mission-2-remake-191401@1.1.0",
   "gameId": "front-mission-2-remake-191401",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-01-08T13:39:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.1.0 for FRONT MISSION 2: Remake is now live, bringing UI improvements, AI enhancements, bug fixes, and stability updates. Thank you for your continued feedback and support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Find the full patch notes below",
     "items": [
      {
       "text": "Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the Wanzer Setup window at the start of stages for clearer navigation and better UI usability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved AI behavior on Level 14",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where equipped Zeder legs did not register melee attacks correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a problem where some OCU units did not take actions on Level 14",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed enemy units counterattacking despite having 0 AP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue causing some intermissions to auto-skip before Mission 4 and Mission 10",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Tank Smoke VFX appearing incorrect on Level 27",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed unnecessary explosion SFX during the cutscene before Level 15",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where in-battle saves did not store all pilot data, such as Honor and Levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect movement range calculations in Secret Missions 1 and 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a minor text visibility issue during the intermission before Level 10",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Stability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased Cloud Save storage space to help prevent save corruption issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Update your game to the latest version to enjoy the improved experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
