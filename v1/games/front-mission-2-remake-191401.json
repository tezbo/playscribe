  {
   "id": "front-mission-2-remake-191401@1.0.9",
   "gameId": "front-mission-2-remake-191401",
   "displayName": "Patch 1.0.9",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-14T07:41:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.0.9 for FRONT MISSION 2: Remake is now live, introducing improvements to localization, UI, gameplay balance, and overall stability. Thank you for your continued feedback and support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Find the full patch notes below",
     "items": [
      {
       "text": "Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Completely reworked English localization for campaign dialogues, tutorials, stats, and UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UI enhancements across Shop, Setup, and Battle panels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted difficulty balance for Stage 10 and Stage 17",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved animations during Quick Battles: Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed resolution and windowed mode issues on PC",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a camera bug when using long-range weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved a problem where attacks triggered by MG Blow, Double Punch, and other multi-hit skills were incorrectly counted as separate skills, breaking skill chains.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed unit setup issue during the intermission before Stage 16",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various minor bug fixes: Update your game to the latest version to enjoy the improved experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
