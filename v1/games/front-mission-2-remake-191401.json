       ]
      }
     ]
    },
    {
     "title": "FRONT MISSION 2: Remake Patch 1.0.7 patch notes",
     "items": [
      {
       "text": "Improvement: Added Grenade Launcher VFX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement: Added possibility to navigate World Map by using a mouse",
       "ps5ProOnly": false,
