  {
   "id": "the-shapeshifting-detective-105629@major-2019-02-04",
   "gameId": "the-shapeshifting-detective-105629",
   "displayName": "New Language Update - Now supporting Russian, Ukranian and Hebrew!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-02-04T18:36:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today we’re proud to announce new localisation updates including Russian, Ukranian and Hebrew languages!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We couldn’t have added this without the staggering support from all the FMV fans out there, so a big thank you to you all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have more languages on the way so stay tuned. Is the game translated in your language? Do you have requests for specific languages to be added? Leave your comments below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you're a member of the community and would like to get involved with game localisation then get in touch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
