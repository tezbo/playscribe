  {
   "id": "the-shapeshifting-detective-105629@post-2022-04-26",
   "gameId": "the-shapeshifting-detective-105629",
   "displayName": "The Shapeshifting Detective is on sale!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-04-26T15:57:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Shapeshifting Detective is a supernatural-noir murder mystery FMV game where you play as a detective who can shapeshift into other characters, allowing you to unlock secret conversations and private encounters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dorota Shaw is dead. And the prime suspects are three tarot readers with the uncanny ability to predict murder - or commit it. It’s your job to find out what else they know - but they won’t reveal their dark secrets to just anyone… Luckily, you can be anyone you want to be. Even the next victim.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game features more than 1600 full HD video responses, a simple questioning interface with unique ‘delete’ mechanic, and a randomly chosen murderer at the start of the game. Developed by the World Record-breaking makers of \"The Infectious Madness of Doctor Dekker\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As you explore the town of August, you'll be treated to a streaming radio broadcast of specially selected dark fiction read out by some of our favourite content creators...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jesse Cox",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tex Murphy (Chris Jones)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adam Day (CallOfCthulhu)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brandy Clarke (Brandykins)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jessa (The Jessa Channel)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "John Mark Clawson",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Laceya Finley",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Raw Geek",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tim Leftwich",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Venomous Platypus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don’t forget you can follow Wales Interactive on our Twitter and Facebook page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wales Interactive Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
