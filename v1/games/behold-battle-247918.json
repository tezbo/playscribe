  {
   "id": "behold-battle-247918@1.12",
   "gameId": "behold-battle-247918",
   "displayName": "Patch 1.12",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-08T09:38:17.000Z",
   "notes": [
    {
     "title": "Behold Battle patch 1.12",
     "items": [
      {
       "text": "When playing casual mode with casual autoplay enabled in options, the game will now automatically restart once round 20 is over. So you can now have an endless loop of fighting without having to do any user input.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
