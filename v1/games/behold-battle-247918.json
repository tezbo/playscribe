   "id": "behold-battle-247918@major-2024-01-06",
   "gameId": "behold-battle-247918",
   "displayName": "Development update and planned release month",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-06T09:42:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Behold Battle is soon ready for release. I have added winnable spectators to the release version, and now I am mainly doing the last testing to ensure a good launch experience. Currently I expect to release Behold Battle sometime in March this year. Thanks for your patience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
