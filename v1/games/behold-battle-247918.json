  {
   "id": "behold-battle-247918@0.2a",
   "gameId": "behold-battle-247918",
   "displayName": "Patch 0.2a",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-06-07T20:45:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added a reroll feature. No idea who will win? You can now reroll the random armies max 3 times during a game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed many sound issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug with priest not being able to be on green team in simulator.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a units button to the top left during battle, which enables you to pause and read info about the armies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added popup explanation to casual auto play option in settings: “When enabled right or left army will automatically be chosen when playing on casual. 20 rounds will thus be played without any input required.“",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
   "digest": {
