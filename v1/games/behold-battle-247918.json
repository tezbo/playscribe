  {
   "id": "behold-battle-247918@1.1",
   "gameId": "behold-battle-247918",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-07T09:47:09.000Z",
   "notes": [
    {
     "title": "Behold Battle Patch 1.1",
     "items": [
      {
       "text": "Fixed various unit attack and death sounds being buggy when too many units were attacking or dying at once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added steam achievement to beat the game on impossible.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Necro rat can now appear both in small battle size and medium battle size (was only in small before).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game mode selection screen: changed from green highlight to arrows to make it clearer what is selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Medium battle size now unlocked from the start.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
