  {
   "id": "behold-battle-247918@1.14",
   "gameId": "behold-battle-247918",
   "displayName": "Patch 1.14",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-04-12T15:20:28.000Z",
   "notes": [
    {
     "title": "Patch 1.14",
     "items": [
      {
       "text": "General: Two vs two unit type battles can now happen from round 6, instead of from round 8.: Three vs three unit type battles can now happen from round 12, instead of from round 14.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spell Balance:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Impending Doom",
     "items": [
      {
       "text": "Level 1 from 50 to 70 damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level 2 from 80 to 120 damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level 3 from 150 to 250 damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level 4 from 300 to 500 damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It will now be cast on an unit in the middle of the army.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bless",
     "items": [
      {
       "text": "Duration from 7 seconds to 30 seconds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bonus health",
     "items": [
      {
       "text": "Level 1 from 50 to 150 bonus health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level 2 from 100 to 300 bonus health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level 3 from 180 to 500 bonus health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level 4 from 300 to 800 bonus health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unit balance: Guardian Construct from 500 points value to 300 (It is a buff, more will spawn now).: Frost Giant from 160 points value to 220.: Elder Dragon from 3000 points value to 2500.: Forest Dragon from 2000 points value to 1700.: Hypno Fish from 125 points value to 150.: Arch Angel from 160 points value to 190.: Reaper from 130 points value to 110.: Goblin Mechs now don’t take up so much space (a buff).: Improved yeti and wendigo attack sounds when there are a lot of them attacking at once.: Thanks to DrawingDead on youtube for feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
