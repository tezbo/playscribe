  {
   "id": "behold-battle-247918@0.5a",
   "gameId": "behold-battle-247918",
   "displayName": "Patch 0.5a",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-10T12:24:36.000Z",
   "notes": [
    {
     "title": "Patch 0.5a",
     "items": [
      {
       "text": "The winning army continues next round is now the default mode. It now also starts with 1vs1 battles (eg. 17 Archers vs 9 Ghouls) and every 7 levels increases to 2vs2 and then 3vs3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added speed up/slow down buttons and zoom in/out buttons ingame.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Many improvements to the simulator: You can now see the food cost of each unit, and see the strength of each army you make. It also remembers the last armies you have made, and restores them after each battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
