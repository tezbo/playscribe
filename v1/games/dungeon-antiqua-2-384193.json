   "announcedAt": "2025-12-17T02:46:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added the option to skip system-related explanations in the fairy tutorial (configurable only at game start)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed the specification for certain items in the shop that couldn't be sold until an event was completed: they can now be sold, but cannot be repurchased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unified inconsistent terminology (e.g., “castle town” “castle” \"town\" → “town”) and improved other text prone to misunderstanding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fine-tuned the movement processing for enemy symbols during Auto Battle and on the field.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
