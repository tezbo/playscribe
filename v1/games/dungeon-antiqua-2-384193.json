  {
   "id": "dungeon-antiqua-2-384193@major-2026-01-13",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2026/01/13 Update (Full Version)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-13T06:09:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have re-applied a fix for a bug where the game would crash in \"General Merchant\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the scroll position would remain misaligned after opening other menus upon moving the cursor downwards in \"Info\" > \"Conversations\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the breath effect would continue indefinitely, making the game unplayable, if an enemy unleashed a breath attack while all party members were hidden using the \"Hide\" command.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
