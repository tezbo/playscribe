  {
   "id": "dungeon-antiqua-2-384193@major-2026-01-28",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2026/01/28 Update (Full Version)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-28T12:13:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added a Monster Encyclopedia feature. It can be accessed from Menu > \"Info\" > \"Bestiary\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where if a character was deleted and only rear-row characters remained, there would be no front-row characters left in the party.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the latest save data could be inaccurately identified if multiple save data entries had the same date and time (up to minutes).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where skills could not be changed under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
