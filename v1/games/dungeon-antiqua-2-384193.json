  {
   "id": "dungeon-antiqua-2-384193@major-2026-01-18",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2026/01/18 Update (Full Version)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-18T08:33:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added a setting to suppress screen flashes during combat, etc. If you are sensitive to flashes, please make use of this feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a setting to smooth screen display. (This is the same functionality as the setting in the previous game.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where players could sometimes pass through fixed symbols when evading enemies due to the effects of certain equipment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the game would crash when opening certain treasure chests if the game was progressed in a specific way (mainly occurring after reincarnation).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved the automatic formation restoration function to be applied even when returning to a \"town\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where stats were not immediately recalculated when equipment was unequipped after changing skills.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected some input errors in character dot art.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where performing \"Pin Shot\" with the skill \"Double Shot\" equipped would cause extra wait time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where selecting \"Run\" while a pop-up message was displayed during combat would cause abnormal behavior.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
