  {
   "id": "dungeon-antiqua-2-384193@major-2026-01-15",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2026/01/15 Update (Full Version)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-15T04:06:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "\\ Regardless of scenario branches during gameplay, all enemies can now be fought in the post-clearance area. (Additional events need to be triggered, but you do not need to replay the game to do so.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where the game would freeze in the \"Town\" under specific conditions (mainly after a reincarnation start, and depending on gameplay procedures).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where certain arm guards would not be auto-equipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
