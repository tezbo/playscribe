  {
   "id": "dungeon-antiqua-2-384193@major-2025-12-20",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2025/12/20 Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-20T05:21:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "\\ Regarding the operation of the \"Remember Cursor Pos\" setting, it will now carry over to the next battle, whereas previously it was reset after each battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\ For auto-battle spell usage policy, you can now select from \"Use,\" \"Heal Only,\" or \"Not Use.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After a battle ends, the field BGM will now resume playing from where it left off when the battle started.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where the question about whether to have a tutorial would be skipped when starting a new game by selecting an empty save data slot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
