  {
   "id": "dungeon-antiqua-2-384193@major-2025-12-21",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2025/12/21 Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-21T08:40:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Auto-saving is now implemented when returning to the \"Town\". The auto-save location is a separate slot from the manual save slots, and only the most recent save data is stored.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Drop items were not set for \"Coyote\", so they have now been set. (Currently, all monsters have drop items set.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where the field BGM would not resume from the interruption point upon returning from battle in certain environments on the second playthrough or later.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the cursor would become uncontrollable when resuming the game after opening the game menu in specific situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
