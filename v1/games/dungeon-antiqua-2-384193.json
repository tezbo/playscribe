  {
   "id": "dungeon-antiqua-2-384193@major-2026-01-21",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2026/01/21 Update (Full Version)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-21T08:42:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added a navigation message regarding the specification where enemy symbols in certain areas of \"Sealed Castle\" would not appear under specific conditions (as some players mistakenly believed it was a bug). The conditions for appearance have also been partially modified.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added visual effects for when enemies use HP absorption attacks (as it was found that multiple players were not noticing when HP was absorbed).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "For the command \"Identify\", the monster's No. will now be displayed. After the Reincarnation function is unlocked, bosses will also display their HP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The display of the first-defeat-time for defeating a specific boss in the post-game area has been changed from \"hours:minutes\" to \"hours:minutes:seconds\" (as some players mistakenly believed it referred to the total battle time). Concurrently, the playtime display on the loading screen has also been changed to \"hours:minutes:seconds\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where the screen would occasionally shift horizontally by a few pixels during the ending.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
