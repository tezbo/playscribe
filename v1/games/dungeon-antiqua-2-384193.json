  {
   "id": "dungeon-antiqua-2-384193@major-2026-01-09",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2026/01/09 Update (Full Version)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-09T02:53:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a critical bug where the game would freeze when defeating certain bosses under specific conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected an issue with the skill \"Eq Swords\" where the description stated \"Bypass job lock on swords & knives\" but knives could not actually be equipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Modified the \"Slash\" command so that it can now be used with certain weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved auto-battle behavior so that if multiple members can use the \"Identify\" command, no more than two will use it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted a small portion of the \"Demons Gate\" map (affecting only two tiles) for improved usability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
