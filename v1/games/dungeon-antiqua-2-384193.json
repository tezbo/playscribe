  {
   "id": "dungeon-antiqua-2-384193@major-2026-01-11",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2026/01/11 Update (Full Version)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-11T01:53:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The maximum HP/MP of enemies targeted by \"Identify\" will now be displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When a confused character attacks an ally, the \"Retaliate\" skill will no longer activate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The experience boost effect of the \"ORDEAL RING\" was mistakenly set to 4x and has been corrected to 2x.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where if you changed jobs while equipped with an item that had the same effect as a specific skill, that skill would remain active and auto-equipment would occur.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where after clearing the game, obtaining the third treasure in the \"Blazewave Cave\" would cause the mission display to remain visible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor bugs have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
