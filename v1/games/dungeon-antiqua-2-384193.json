  {
   "id": "dungeon-antiqua-2-384193@major-2026-01-04",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2026/01/04 Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-04T06:20:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In ver.20251231, a feature was added to display operation instructions immediately after the title screen. However, due to a bug, the environment settings screen, including language selection, was being skipped. We have fixed this so that the environment settings screen is now displayed immediately after the title screen, as was originally intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where some save data resumed from \"Inherit Data\" was corrupted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added an explanation regarding the auto-save specification in towns at the start of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "To address an issue where the game would not start on some PC environments due to BGM playback problems, we have improved it to start without BGM.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor bugs have been fixed and operability has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
