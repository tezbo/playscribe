  {
   "id": "dungeon-antiqua-2-384193@major-2026-02-04",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2026/02/04 Update (Full Version)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-04T01:20:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Monster drop items are now displayed in the Bestiary. Item names will only be shown if the target monster has been identified and the target item has been acquired.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where the \"Initiative\" skill might not grant a pre-emptive action if the speed difference between the user and the enemy was extremely large.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where combat would halt if enemies performed certain actions while all characters were hidden.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where opening the menu the instant a floor transition occurred would allow movement on the field with the menu open.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the Healing Spring would duplicate if a character's direction changed due to entering combat the moment they tried to use it, and then combat ended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
