  {
   "id": "dungeon-antiqua-2-384193@major-2026-02-20",
   "gameId": "dungeon-antiqua-2-384193",
   "displayName": "2026/02/20 Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-20T03:47:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue where the player could not interact with stationary NPCs while facing sideways or backward. (This resolves a bug where entering a battle while facing backward would cause a loop that re-triggered the battle immediately after escaping.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In the Equipment menu, identical items are now grouped and displayed together if you possess multiple copies of the same item.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In Hard Mode, the \"Save\" option will now flash when opening the menu on a tile adjacent to a spring. (This is to make it clearer that saving is possible.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If equipment that gradually restores or depletes HP is equipped, the HP recovery/depletion values are now displayed on the menu screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
