  {
   "id": "shin-megami-tensei-v-vengeance-287850@1.0.3",
   "gameId": "shin-megami-tensei-v-vengeance-287850",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-04T15:31:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Shin Megami Tensei fans, thank you for playing Shin Megami Tensei V: Vengeance!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch version 1.0.3 has been released and brings a new content update and minor bug fixes. Please see below for details:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Content additions",
     "items": [
      {
       "text": "Six new Demon Navigators have been added based on your community vote!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Mara, Idun, Mothman, Fionn mac Cumhaill, Hell Biker, and Cleopatra have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "These demons will appear at specific points in Da’at and can accompany you as Demon Navigators when spoken to.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "※ Some Demon Navigators can only be unlocked by completing specific subquests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The subquest “The Guardian of Light” has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Da'at: You can accept the sub-quest by speaking to Goko in Taito Ward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The brand-new demon, Marici of the Kishin race, has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Marici can be recruited and unlocked for fusion by completing the subquest “The Guardian of Light”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The “Elite Virtual Trainers” have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "After completing certain subquests, you can take on a series of brutal battles against the powerful demons that appeared in those subquests by speaking to the female researcher in the terminal room at the Tokyo Diet Building.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Various text fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various graphical fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some fixes to English voiceover.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other performance-related fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
