  {
   "id": "shin-megami-tensei-v-vengeance-287850@1.0.2",
   "gameId": "shin-megami-tensei-v-vengeance-287850",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-09-04T01:32:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Shin Megami Tensei fans, thank you for playing Shin Megami Tensei V: Vengeance!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The latest patch \"Ver. 1.0.2\" has been released to fix major / minor bugs and improve overall gameplay. Please see below for details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the controller became inoperable when playing across multiple devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where there was a low possibility of the game becoming unresponsive upon startup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where progression in the game became impossible upon meeting certain criteria.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed text-related issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed graphics-related issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed other functional issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In addition, several new demon navigators will also be implemented in future updates! Please look forward to further details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
