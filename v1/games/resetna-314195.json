  {
   "id": "resetna-314195@patch-2025-04-01",
   "gameId": "resetna-314195",
   "displayName": "New ReSetna Patch - more combat improvements",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-01T22:04:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We keep fine-tuning ReSetna to make the gameplay better!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "These changes are part of our ongoing effort to improve the experience based on your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our Patch #7 improves combat feel, enemy behavior and overall balance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay & Combat Adjustments",
     "items": [
      {
       "text": "New Enemy Dodge Animations – Certain enemies now have improved dodging animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Enemies Flash on Hit – Enemies now briefly flash when hit, giving clearer visual feedback during combat: This is how new enemy dodge animations and enemy damage VFX look like:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Other Combat Adjustments",
     "items": [
      {
       "text": "Cutter Biped New Combo – The Cutter Biped enemy received a new attack combo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Sola9 Looping Attack Bug Fixes – Fixed an issue where Sola9 could get stuck in an attack loop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Cerpiant Attack Hit Collision Adjustments – Tweaked hit detection on Cerpiant’s attacks for improved accuracy and consistency",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "General Boss Balancing – Adjustments to various boss encounters to improve difficulty scaling and combat flow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Player Improvements & Fixes",
     "items": [
      {
       "text": "Player Combo Skipping Issue Fixed – Resolved a bug where certain player attack combos would unintentionally skip sequences",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Player Attack Hitbox Adjustments – Fine-tuned hitboxes on player attacks to improve precision and responsiveness",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Player Charge Attack During Interaction Bug Fixed – Fixed an issue where charge attacks could trigger unexpectedly during interactive moments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Visual & UI Enhancements",
     "items": [
      {
       "text": "UI Scaling Option Added – Players can now adjust the UI scale",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enemy VFX Optimization & Updates – Improved enemy visual effects for better performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Boss & Quest Fixes",
     "items": [
      {
       "text": "Darkness Boss Quest & Behavior Fixes – Addressed various issues affecting the Darkness boss fight, ensuring smoother progression and more consistent behavior: This patch continues our effort to refine and enhance the ReSetna experience.: Let us know your thoughts!: If you need any help or tips&tricks, join our Discord Community: https://discord.gg/r7paMbkVvD: ReSetna Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
