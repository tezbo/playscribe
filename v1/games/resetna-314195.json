  {
   "id": "resetna-314195@4",
   "gameId": "resetna-314195",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-24T16:01:32.000Z",
   "notes": [
    {
     "title": "Changelog for Patch #4",
     "items": [
      {
       "text": "Removed stun lock and instant turn on light pushback for player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player levitation bug when hitting something above",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shield no longer works for traps that instantly respawn you",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player no longer jumps off wall / ladder by changing direction",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On player death, the equipped weapon remains equipped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Edge jumping triggers second jump bugfix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On chunk unload, the shield now disables",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera adjustments on multiple chunks",
