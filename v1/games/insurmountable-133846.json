  {
   "id": "insurmountable-133846@2.0.7",
   "gameId": "insurmountable-133846",
   "displayName": "Hotfix 2.0.7",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2022-04-25T15:35:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Mountaineers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "first of all, we like to thank all of you for sharing your feedback and the awesome stories of your (successful) climbs!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update adresses the following issues that some of you had while playing the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where some players would get stuck in the login/authentication screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Thai/Persian/Gregorian system languages caused a freeze in loading screens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved performance during scene transitions to prevent potential freezes in loading screens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "While this should address the most common issues, please do keep sharing any problems that you might encounter with us. Also, if you are still stuck at some point, please make sure that you meet the minimum system requirements and have Visual C++ as well as DirectX v11 or above installed.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Good luck on your adventures, Mountaineers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
    "new": 1,
    "fixed": 2,
