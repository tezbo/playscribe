  {
   "id": "insurmountable-133846@1.2.1",
   "gameId": "insurmountable-133846",
   "displayName": "Hotfix 1.2.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-06-02T14:52:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Mountaineer,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to see that Patch 1.2 is going down so well with you. Today we want to make a few small changes with our hotfix 1.2.1, which we did not want to leave in the game like this. You can see our changes here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed issue where for some players skills did not unlock correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed missing text in one event",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We hope that this hotfix will help to keep the quality of the game on a high level. Have fun climbing the mountains with the new update. If you haven't read the patch note of 1.2 yet you can check it out here: https://steamcommunity.com/games/1385100/announcements/detail/3040472300570216909",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Good Climbing,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Insurmountable Development Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
