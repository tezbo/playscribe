  {
   "id": "insurmountable-133846@1.3.1",
   "gameId": "insurmountable-133846",
   "displayName": "Patch 1.3.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-25T08:32:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Mountaineers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since some players still experience very high GPU Load, we have added a VSync Option with multiple Levels (instead of the existing FPS Cap).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you are having trouble with GPU Load, please try toggling the VSync Option (starting with VSync Level 1, and increasing if necessary), and let us know if you see improvement!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Good Climbing,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Insurmountable Development Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
