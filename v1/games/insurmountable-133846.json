  {
   "id": "insurmountable-133846@1.3",
   "gameId": "insurmountable-133846",
   "displayName": "Patch 1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-23T09:28:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Mountaineers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.3 is finally here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this patch we have again tried to follow suggestions from the community to further improve Insurmountable. There are now Steam trading cards and rewards like profile backgrounds or emoticons that you can collect. Additionally, this patch brings a few Quality of Life changes and UI improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would also like to mention that we are still working on Insurmountable and we are already working on the next patch. Until then, we wish you a lot of fun with 1.3!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's the full list of changes in this patch",
     "items": [
      {
       "text": "Added Community Items (Trading Cards, Profile Backgrounds, Emoticons)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Skills and Items can now be used during events",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved UI Navigation: UI Windows can now also be closed by pressing Escape or the Hotkey that opens the Window",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved stability of UI animations and status bars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved & unified UI interactability status of HUD & Buttons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More precise hover information for skill buttons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfixes for UI & UX navigation edge cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes for visual errors in some edge cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor Bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Good Climbing,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Insurmountable Development Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
