  {
   "id": "coffee-talk-episode-2-hibiscus-butterfly-186528@major-2023-06-21",
   "gameId": "coffee-talk-episode-2-hibiscus-butterfly-186528",
   "displayName": "Coffee Talk Episode 2 New Languages Update is Now Available!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-21T17:01:52.000Z",
   "notes": [
    {
     "title": "Greetings, Cafe Regulars.",
     "items": [
      {
       "text": "Two months had passed since the release of Coffee Talk Episode 2: Hibiscus & Butterfly. We are thankful for all the feedback we received so far as we gradually update the game to what our community has voiced. Currently, we are trying our best to make Coffee Talk Episode 2 available in several different languages, with more coming later this year.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Now Available in Bahasa Indonesia, Brazilian Portuguese, and Turkish!",
     "items": [
      {
       "text": "Enjoy serving coffee & tea of Coffee Talk to your favorite regulars in Bahasa Indonesia, Brazilian Portuguese, and Turkish. The first significant language update of the Coffee Talk Episode is here! We are releasing three languages simultaneously on Steam and other platforms. We hope that by reading the dialogues and stories of Coffee Talk Episode 2 in your native language, you will feel more familiar with the characters and understand more about the story.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "In-game preview of the three new languages available now to play!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Grab Coffee Talk Episode 2 here 20% OFF!",
     "items": [
      {
       "text": "More updates will come later this year, so keep updated through our social media platforms! If you have encountered bugs, typos, or technical issues, you can hit us on the Steam discussion or join our community to get a faster response. Please eagerly wait for us to tease more after-release treatment soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please stay safe and healthy, friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fully brewed with love,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Coffee Talk Team. ːctfreyaː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
