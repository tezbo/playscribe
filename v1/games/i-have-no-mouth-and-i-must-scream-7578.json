      {
       "text": "Lowered sound blocksize and prebuffering values which may have caused sound issues for some users.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enjoy the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
