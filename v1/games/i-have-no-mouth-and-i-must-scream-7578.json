  {
   "id": "i-have-no-mouth-and-i-must-scream-7578@major-2025-10-16",
   "gameId": "i-have-no-mouth-and-i-must-scream-7578",
   "displayName": "I Have No Mouth, and I Must Scream - Definitive Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-16T17:02:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/5215974/b15da5b724b206b6c643db9f384d387393496263.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I Have No Mouth, and I Must Scream has been updated on Steam and GOG for PC, Mac, and Linux!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Added modern menu options, allowing players to customize their experience as they prefer (screen size adjustments, background image selection, visual filters, aim sensitivity).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added in-game bonus content, including a fully localized manual and jukebox with the complete I Have No Mouth, and I Must Scream soundtrack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved controller support, added pre-set shortcuts for smoother and more intuitive gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an achievement system to encourage exploration and extend replayability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added cloud saves, game progress is now stored and linked to the player’s account, allowing the game to continue being played across different devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
