  {
   "id": "i-have-no-mouth-and-i-must-scream-7578@4",
   "gameId": "i-have-no-mouth-and-i-must-scream-7578",
   "displayName": "Update 4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2014-05-03T04:18:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "A new update is out now. It includes the following",
     "items": [
      {
       "text": "New Bonus Content! - Read the original short story by Harlan Ellison that inspired the game itself. You will find the content in your 'Bonus Content' folder inside your IHNMAIMS installation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "All users now have access to both the MP3 AND the OGG versions of the Soundtrack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More effecient depot management! - Backing up and restoring backups on a different OS should go much smoother now. It also allows us to put out updates much more effeciently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The original SDL.DLL has been restored for Windows. This should fix reported mouse stuttering issues on some computers.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Enjoy the new content :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
