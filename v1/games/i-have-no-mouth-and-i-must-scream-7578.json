  {
   "id": "i-have-no-mouth-and-i-must-scream-7578@1",
   "gameId": "i-have-no-mouth-and-i-must-scream-7578",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2013-11-27T16:38:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have a small update available now for I Have No Mouth, and I Must Scream which addresses the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A crash cause by an asset conflict has been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unimportant leftover build files have been removed from the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The PC version now has 128 save slots",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A situation where the player could not acquire the Gorrister's Heart achievement has been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A black screen issue caused by pressing New Game or Load Game too quick after pressing one or the other has been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Attempting to save the game in any language other than English will no longer fail",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Incorrect information about the save load system has been corrected in the manual",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When starting a new game on the Mac version, the audio issues have been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Linux ScummVM has been updated to 2.9.1",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Happy 30th birthday to the original game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Daniel G,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nightdive Studios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
