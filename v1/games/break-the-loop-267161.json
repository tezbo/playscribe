  {
   "id": "break-the-loop-267161@1.1",
   "gameId": "break-the-loop-267161",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-03-13T12:50:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Korean Translation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to MG2000, Break the Loop is now available in Korean! Many thanks to him for all his hard work.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balancing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've received a lot of feedback about the difficulty of Cataclysm mode. In addition to new mechanics to learn, enemies were gaining too many stats, so we're lowering Monster Power and Hit Points by 10% in Cataclysm modes 1, 2 and 3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Elisen",
     "items": [
      {
       "text": "Fluid Combustion: skill cost reduced from 45 to 40 energy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Incendiary Blade: direct damage increased by 10%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Modjo",
     "items": [
      {
       "text": "Marking territory: energy gain increases from 20 to 25 (and 4 charges instead of 5).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Hellmut",
     "items": [
      {
       "text": "Crimson cascade: skill cost reduced from 70 to 65 energy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Zoe",
     "items": [
      {
       "text": "House smoke: skill cost drops from 60 to 55 energy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Soporific Gas now inflic damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Carmenide",
     "items": [
      {
       "text": "Echo of chaos: direct damage increased by 10%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Pepperbeard",
     "items": [
      {
       "text": "One for the road: skill cost reduced from 50 to 45 energy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "The game will no longer crash when you obtain passives by killing the second boss when you already had all your passives.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Tooltips",
     "items": [
      {
       "text": "We've corrected or improved several tooltips to make it easier to understand the game's various mechanics (thanks to Lûte the Goblin).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Capsule Armored",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Capsule Favorite",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Double Agent capsule",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Capsule Battering Ram",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Superior Distributor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Contamination (Golem's passiv)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
