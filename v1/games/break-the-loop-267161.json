   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-30T13:12:47.000Z",
   "notes": [
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Bug fix with Upery, who wouldn't transform into a sheep against Yot-Soghoth (thanks to 寂寞的哲学家).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bug fix with the achievement How Much?!? which was more difficult to obtain than expected (thanks to Marcos).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tooltip error fix with the Cheeky capsule (thanks to 寂寞的哲学家).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Sorry for the players who experienced the pink version of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
