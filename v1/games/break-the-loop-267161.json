  {
   "id": "break-the-loop-267161@1.0.1",
   "gameId": "break-the-loop-267161",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-17T12:46:58.000Z",
   "notes": [
    {
     "title": "Balancing",
     "items": [
      {
       "text": "Yot-Soghoth seems to be a bit too strong for a first major boss on normal difficulty. We are increasing the loss of corruption when a corrupted hero heals the boss. The encounter in Cataclysm remains unchanged.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixed a bug with Upery not transforming into a sheep.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with the Colossus (boss 2 of the first biome) summoning a Locust with 0 HP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "When a hero is temporarily replaced, you can get a character that hasn't been unlocked yet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
