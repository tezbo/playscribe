  {
   "id": "break-the-loop-267161@1.0.2",
   "gameId": "break-the-loop-267161",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-20T13:37:48.000Z",
   "notes": [
    {
     "title": "Bugs",
     "items": [
      {
       "text": "• Fixed a bug with the Opportunism capsule that caused a crash when it was disabled by the Corrupted Forge event (thanks to 初雪樱花).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed a bug with the Midas capsule that could increase the healing of heroes when they were corrupted by Yot Soghoth (thanks to deee).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed the Vengeful Spirit capsule which might not reset between two games (thanks to 初雪樱花).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Fixed a bug that occurred with the Marcello capsule and the Putrid Golems (thanks to 初雪樱花).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Corrected tooltips for capsules that affected healing without specifying it in the text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Minor bug fixes to ensure game stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
