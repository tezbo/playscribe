  {
   "id": "beyond-enemy-lines-2-117082@major-2021-04-14",
   "gameId": "beyond-enemy-lines-2-117082",
   "displayName": "Beta Update | New AI Optimization",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-04-14T14:51:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Agents,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "a new Beta update is now available. Optin the development_preview beta branch to download the newest version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What is new?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "removed several AI related CPU Bottlenecks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "removed the agressive AI culling (disappearing and reappearing AI)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added new, more performant and less obviouse optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "What does this mean?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update does not adress the behaviour of the AI, it should function the same way as befor but with slightly better performance and and less visible optimization errors. Please report back if the new optimization works, the AI still functioning as before and if the pop-in was succesfully reduzed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
