  {
   "id": "beyond-enemy-lines-2-117082@post-2021-03-31",
   "gameId": "beyond-enemy-lines-2-117082",
   "displayName": "New gunplay in open Beta",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-03-31T13:54:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Agents,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "a new Beta update is now available. Optin the development_preview beta branch to download the newest version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What is new?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added reworked console maps to the PC version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "reworked the entire weapon code",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "attachements have now more impact on the handling of the weapon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added a crosshair and hitmarkers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "changed projectile handling to a more traditional methode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What does this mean?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game is changing a lot and all those changes are still subject to change. We did not do a full QA run on all those changes so expect bugs or broken features. But this is what we are here for. Tell me your toughts, ideas and feedback. This is a early build and BEL 2 is back in beta with this update and not to be considered a release build. Also only the main campaign is open for tests at this point.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What do you think?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
