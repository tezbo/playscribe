  {
   "id": "killing-time-resurrected-304742@1.1",
   "gameId": "killing-time-resurrected-304742",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-27T23:09:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we're excited to release Killing Time Resurrected version 1.1 on all platforms!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update for the game contains the following fixes and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Added ability to switch between low- and hi-res weapons and actors independently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added bindable crouch toggle input action",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added ability to burn enemies to cinders with fire attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Dead players will now respawn if the “fire” button is pressed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added “Duncan Chase” mode - set the player’s name to “DUNCAN” at the beginning of a new game to activate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved appearance of title screen for non-English localizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Separate settings are now available for linear filtering of sprites, world textures, and weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Health spheres now appear with an improved perspective and fade out when close to despawning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased frame rate of intro and ending videos to 24 FPS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved alpha channels of numerous ghost videos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved appearance of 3D skybox",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More enemies now utilize 8-rotation death sprites",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "High-resolution chef now uses its original death sound effect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixed Issues",
     "items": [
      {
       "text": "Fixed issue where swinging doors could become stuck or the player could become stuck inside them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rare issue where the sky texture could appear incorrect or non-sky surfaces could render as sky",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed occasional issue of music not resuming after loading a saved game or stopping when ending a game and returning to the title screen or viewing the credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some teleports causing player view or enemy positions to interpolate improperly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed doors sometimes not rendering when dynamic lighting was disabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where state of levels could carry across loading of saved games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where Duncan could spawn at the beginning of a new game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimized line-of-sight checking algorithm",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enhanced memory management for image resources",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect offsets for right side automap inventory background",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Video subtitle spelling and grammar fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "OG Ending video in Vault now plays back correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Duck quack animation speed more closely matches original version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Duncan is even more resistant to teleporting outside the valid area of levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Outline around flamethrower sprites removed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A graphics caching hitch could occur when the “Set Head” enemy fired its projectile",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ankh and melee related achievements no longer count destroying Molotov cocktails for their unlock requirements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed warped and see-through wall textures with mipmapping enabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed frame timing issue which could cause stuttering when vsync was enabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved input accumulation handling for sub-60 FPS scenarios (low-spec hardware only)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed lingering mouse cursor when using quicksave and quickload features",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed mouse speed calculation issue",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved behavior of mouse sensitivity slider in menu",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Editing: Sky textures specified in mapinfo.json are now fully respected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
