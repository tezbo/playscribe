  {
   "id": "killing-time-resurrected-304742@major-2025-12-09",
   "gameId": "killing-time-resurrected-304742",
   "displayName": "Killing Time: Resurrected - 3DO Update Delay",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-09T19:27:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45049145/925c7158d11ef8a64883b89e2f2eae73b83cff7e.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been hard at work on an update for Killing Time: Resurrected to add 3DO levels to the game, which we teased earlier this year in the Halloween episode of our Deep Dive podcast. We wanted to get this update out before the end of the year, but more work and adjustments are needed. With this in mind, we've made the decision to delay the update's release until early 2026.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Team Nightdive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
