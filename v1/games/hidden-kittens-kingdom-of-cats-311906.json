   "id": "hidden-kittens-kingdom-of-cats-311906@post-2024-12-19",
   "gameId": "hidden-kittens-kingdom-of-cats-311906",
   "displayName": "Meow! Help in the Kingdom Just Got Even Better! 🐾",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-12-19T17:46:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A brand new update has arrived to make your search for the hidden kittens even smoother! Thanks to the invaluable feedback from our amazing community of feline detectives, we’ve made a few key improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✨ Help cooldown is now persistent: The cooldown timer for asking for help no longer resets when you enter castles or return to the menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✨ Improved help highlight: The highlight opacity has been increased, making it easier to spot those sneaky kittens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✨ Color-friendly adjustments: The help icon now adapts perfectly when you change the game’s color palette. Cuteness and clarity for everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A big thank you to all of you for your feedback and support! You’re the true heroes of this paw-some kingdom. 🐱✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep sharing your adventures and suggestions — they help us make Hidden Kittens: Kingdom of Cats even more purr-fect! 🎮🐾",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v1.0.0.7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
