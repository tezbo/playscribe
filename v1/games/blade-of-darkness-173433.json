  {
   "id": "blade-of-darkness-173433@major-2023-03-15",
   "gameId": "blade-of-darkness-173433",
   "displayName": "Blade of Darkness Major Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-15T09:00:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Last months were quite busy working on the major update for the Blade of Darkness. We've checked your feedback, talked to some of you directly and as a result came up with the list of improvements that we want to implement. Let's go straight to this list to show what was done:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "upscaled textures (thank you for all your help and support SrRaulCL)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "bug fixes for the game’s save system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "reworked camera with the ability to freely look around outside of the combat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "better controller support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "new visual features: improved anti-aliasing, HDR, bloom, SSAO, motion blur",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "massive patchwork across the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "SteamDeck support (pending Valve's approval)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
