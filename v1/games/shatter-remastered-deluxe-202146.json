  {
   "id": "shatter-remastered-deluxe-202146@1.0.1",
   "gameId": "shatter-remastered-deluxe-202146",
   "displayName": "Hotfix 1.0.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2022-11-04T06:04:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A hotfix has been released addressing an issue pointed out by a number of players in the community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed issue where VSync wasn't initializing properly and where frame limiting was occurring when VSync was disabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Note: We aim to address many of the issues raised by our community as soon as possible and will have hotfixes rolling out throughout the upcoming week.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reminder: If you're experiencing issues in Shatter Remastered Deluxe, you can reach our Customer Support team at Support@PikPok.com. Please make sure to include the platform/OS you're playing on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Visit the official Shatter website and follow PikPok on Twitter and Facebook for the latest news and updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
