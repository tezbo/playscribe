  {
   "id": "shatter-remastered-deluxe-202146@1.1.0",
   "gameId": "shatter-remastered-deluxe-202146",
   "displayName": "Update 1.1.0",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-28T04:11:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In version 1.1.0 we've addressed issues where the shatter ball would stutter while playing at a high refresh rate, issues where player leaderboard positions would display incorrectly, and we've made some changes to the balancing of circular levels and the Cold Shoulder boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed ball stuttering issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Leaderboard display issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted controller sensitivity in circular levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Boosted the power of the “blow” mechanic during the Cold Shoulder boss encounter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Known issues",
     "items": [
      {
       "text": "Issue where players are experiencing input lag.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for all your feedback and support as work through these fixes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you're experiencing issues in Shatter Remastered Deluxe, you can reach our Customer Support team by emailing Support@PikPok.com. Please make sure to include the platform/OS you're playing on in your message.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visit the official Shatter website and follow PikPok on Twitter and Facebook for the latest news and updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
