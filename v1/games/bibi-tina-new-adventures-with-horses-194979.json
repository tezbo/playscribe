   "displayName": "Hotfix - Cleopatra side mission",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2022-12-12T16:15:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released a new build with fixes for the Cleopatra side mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There was an issue with the Mill-Farm or Clover paddock version of this mission not terminating properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you've encountered this issue in your game, simply reattempt the race with Cleopatra. It should now complete properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
