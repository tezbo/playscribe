  {
   "id": "bibi-tina-new-adventures-with-horses-194979@major-2022-11-09",
   "gameId": "bibi-tina-new-adventures-with-horses-194979",
   "displayName": "Functional Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-09T10:29:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Horse Adventurers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this update, we fixed a bug that prevented Steam achievements from being unlocked.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "All achievements should now work again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To trigger achievements that you already unlocked, but that were not displayed in Steam, you can complete any race in the game - since that is where the savegame gets updated - and it should work.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If problems persist, hop over to the discussions in the Community Hub, and we will have a look.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Best,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "your KORION-Team!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
