  {
   "id": "citydriver-217210@major-2025-12-22",
   "gameId": "citydriver-217210",
   "displayName": "City Driver | Small Update ⚙️",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-22T15:05:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42791338/0c564060bb8fe47b1fe71f6e21bc8ccfcf0eb3cb.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we're releasing a small update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It fixes the issue where some traffic lights disappear or are not visible to the player. It also finally fixes the bug where the steering axes were swapped when configuring steering wheels, which sometimes prevented them from being set up correctly. Unfortunately, due to this fix, we had to make a change that means steering wheels can now only be adjusted in the main menu!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update is also available for PS5 and Xbox Series X|S. Many more steering wheels are now supported on these platforms, such as various Thrustmaster and Fanatec steering wheels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      }
     ]
    }
   ],
