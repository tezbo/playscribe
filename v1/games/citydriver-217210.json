  {
   "id": "citydriver-217210@1.0.1",
   "gameId": "citydriver-217210",
   "displayName": "Update 1.0.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-14T06:25:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update 1.0.1 is now live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶️ What's New",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Added the Vela GT vehicle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Added Steam Achievements that can now be unlocked in-game",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "◽ Force Feedback has been expanded and improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Added default button/axis mappings for the Logitech G920",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Radio stations \"Flashbass.fm\" and \"Double Bass FM\" have been added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Modding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▫️the rotation direction of the vehicle wheels can now be inverted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▫️The wheel friction value can now be configured which is used during braking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶️ Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ During transport missions, the parking options available in the vehicle are now displayed using a UI element when loading the packages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ There are now various force feedback customization options in the settings under \"Advanced Controls\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ In the settings under \"HUD and Gameplay\" you can now adjust the wheel adhesion value of the vehicles to fine-tune the handling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Brake and wheel grip values have been adjusted for all vehicles so that braking distances are now more realistic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ With the default key binding of the Logitech G29, the radio menu can now be closed with the same key that opened it",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "◽ Interiors of all vehicles have been brightened (only affects \"High\" and \"Ultra\" graphics presets)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The warning lights on the dashboards of the vehicles are now always sharp",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The engine sound of the Alvarez-Lenz BPW C64 has been revised and improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The vehicle mirrors can now be adjusted so that they are displayed without stuttering (Warning: this setting reduces overall performance!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The rear camera views of the Alvarez-Lenz Marathon and Ferdinand Habanero Turbo have been improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ After completing a quest, new quests are now offered even after a while",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The Alvarez-Lenz BPW C64 is now in Sport mode by default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The appearance of Chrome materials has been revised",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶️ Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The radio now also works correctly in mission vehicles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Driving vehicles now works correctly even after abandoning missions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The correct joystick button icons are now displayed for the Filters on the World Map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Correct joystick axis icons are now displayed for World Map Zoom",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ After changing a vehicle the radio now works correctly again",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Radio playback can now always be started correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Collisions with pedestrians will now correctly reset, so the collision message will not reappear immediately after a collision",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Pedestrians are now not on the road at intersections while waiting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ When driving on the road, the speed limit display in the UI now works more reliably",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Pause menu navigation calculation now works more reliably so the game no longer crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The Pedastrian Collision Message can now also be properly dismissed by pressing the \"B\" key on gamepads",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The Engine RPM Needle no longer appears twice on the Habanero Turbo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The AI marathon transporter the turn signals now work correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ In the pause menu, the force feedback effects are now correctly stopped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
