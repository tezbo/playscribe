  {
   "id": "citydriver-217210@1.2",
   "gameId": "citydriver-217210",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-09T15:00:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "CityDriver Update 1.2 is now live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶️ What's New",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ The time set in photo mode remains active in the game even after exiting photo mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶️ Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Vehicle physics improvements for Moruga Turbo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Vehicle physics improvements for Vela GT",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Performance enhancements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▫️ Update to Unreal Engine 5.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▫️ Optimization of geometries, material count, and texture sizes for player and NPC vehicles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▫️ Optimization of foliage geometry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▫️ Optimization of foliage texture sizes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▫️ Optimization of environment textures",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▫️ Optimization of building textures",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▫️ Cleanup of obsolete asset references",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Update of the DLSS plugin to version 3",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "◽ Addition of decorations on Türkenstraße",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶️ Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◽ Fixed an issue where lights were not working on AI Marathon vehicles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
