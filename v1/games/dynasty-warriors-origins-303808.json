  {
   "id": "dynasty-warriors-origins-303808@1.0.0.1",
   "gameId": "dynasty-warriors-origins-303808",
   "displayName": "Update 1.0.0.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-13T01:26:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Additional Features and Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Made adjustments so that the controller used for the first button input upon launching the game will be set as the game controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted the default key assignments for keyboard/mouse controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Made it possible for the left, middle, and right mouse buttons to be set as key configurations.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Resolved the issue causing key configurations to be reset on the title menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Made it possible to remove keyboard controls for actions that were assigned mouse controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Took measures to deal with the issue causing the key guide to switch between the keyboard/mouse display and controller display when using keyboard/mouse controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed other minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
