  {
   "id": "dynasty-warriors-origins-303808@1.0.0.6",
   "gameId": "dynasty-warriors-origins-303808",
   "displayName": "Update 1.0.0.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-19T01:15:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Additional Features and Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added Arabic as a text language option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted the staff weapon. The continuous attack executed by holding the Strong Attack button has been made more potent and the \"Furious Tiger Dance\" Battle Art has been given an effect that staggers enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added a Skill Points trading feature. After completing the game, you can trade them for Portable Items and gold at the Shui Jing Retreat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an exploit allowing high walls and cliffs to be scaled by repeatedly attacking in midair.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed other minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
