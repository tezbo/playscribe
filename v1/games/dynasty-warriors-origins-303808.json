  {
   "id": "dynasty-warriors-origins-303808@1.0.0.3",
   "gameId": "dynasty-warriors-origins-303808",
   "displayName": "Update 1.0.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-20T01:10:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Additional Features and Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added Call Horse Response Time to control settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Default: Your horse will be called the instant you press the Call Horse button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hold: Your horse will be called when you hold down the Call Horse button for a certain amount of time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Made it possible for the Call Horse function to be set to the touchpad buttons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Made adjustments so that when the Call Horse function is set to either the down button or touchpad buttons and lock-on is set to R3, pressing L3 + R3 will still activate Rage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Display Settings: Added the Helpful option to the Highlight Officers settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Helpful option improves visibility for the player on the battlefield.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Made adjustments so that pressing the confirm button during the cutscene after a defeat will instantly bring up the restart menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Controls Settings: Increased max camera rotation speed from 99 to 199.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed other minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: Controller buttons have been labeled according to PS5 console standards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    }
   ],
