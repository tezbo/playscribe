  {
   "id": "dynasty-warriors-origins-303808@1.0.0.5",
   "gameId": "dynasty-warriors-origins-303808",
   "displayName": "Update 1.0.0.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-21T01:14:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Additional Features and Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• The Gold Serpent Spear has been added to the game. After obtaining a weapon of the Lance type, a letter will arrive at your current base.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Solved an issue that caused text rendered at high resolutions to appear less clear than it should.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added Rumor Settings to the Configuration menu. These new settings allow you to make the rumors that play automatically when on the World Map occur less frequently or make them play without sound.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added Frame Skip to the Graphics Settings menu. Turning it off when using VRR may make graphics smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Shortened the length of time that enemies are invulnerable during the animations that play out when they enter Rage mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added a feature that allows events to be paused by pressing the TouchPad button and allows UI elements to be hidden.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted controller vibration for the Steam/Xbox Series X|S versions so that when Vibration Settings are set to Full Experience, more areas of the controller vibrate during actions like attacking and charging.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that caused officers to be highlighted as though the Highlight Officers setting in the Display menu had been set to the default even when the feature was turned off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that was causing the portable item Incense of Vitality to not always heal allies properly when used.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that disabled the upgrade boost for the Adamantine Flesh Battle Art (Crescent Blade) after mastering it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that caused the strength of Crescent Blade Battle Art Azure Dragon Bellow to not increase in line with its upgrade level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that caused unintended damage when certain Battle Arts were canceled with Battle Arts with Sp. effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed other minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: Controller buttons have been labeled according to PS5 console standards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    }
   ],
