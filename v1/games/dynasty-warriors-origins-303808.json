  {
   "id": "dynasty-warriors-origins-303808@1.0.0.7",
   "gameId": "dynasty-warriors-origins-303808",
   "displayName": "Update 1.0.0.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-23T01:07:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Additional Features and Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added Photo Mode. To start it, open the menu on the World Map or in battle and press the TouchPad button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added Lion Dragon Armor as an outfit for the protagonist. You can try it on by selecting Change Outfit at your current base.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue causing graphical distortion when AMD FSR3 is enabled on Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Fixed minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: Controller buttons have been labeled according to PS5 console standards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    }
   ],
