  {
   "id": "azura-s-crystals-318352@1.0.5",
   "gameId": "azura-s-crystals-318352",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-01-29T15:04:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Adventurers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First off, a huge “thank you” to everyone who played Azura’s Crystals during the Taipei Game Show! Your feedback has been invaluable, and we’re excited to share our latest update. Here’s what you can expect in Patch 1.0.5:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Auto Saves: Never lose progress again! The game will now automatically save after each quest!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial Input Lock Fix: Resolved a rare issue that caused controls to become unresponsive during the tutorial.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera Transition Improvements: Enjoy smoother camera movement and an overall better flow during dialogue scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gamepad Cursor Visibility: When using a controller, the cursor is now hidden for a more seamless gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ancient Ruins Brenda’s Quest Bug Fix: Addressed a rare bug that prevented players from completing Brenda’s quest line in the Ancient Ruins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What’s Next?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re currently working on adding more tutorials in the early portions of the game. These improvements will guide new players more thoroughly through the mechanics and ensure a smoother journey for everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you again for your support—please keep the feedback coming! We’ll continue to work hard and deliver the best possible experience in Azura’s Crystals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "— The Dev Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
