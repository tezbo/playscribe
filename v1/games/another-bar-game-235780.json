  {
   "id": "another-bar-game-235780@major-2024-02-16",
   "gameId": "another-bar-game-235780",
   "displayName": "Game Update Announcement!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-16T14:39:37.000Z",
   "notes": [
    {
     "title": "I'm excited to announce the latest update for Another Bar Game!",
     "items": [
      {
       "text": "In this update, players now have the option to choose their preferred difficulty level, allowing for a more personalized gaming experience. Additionally, we've expanded language support, introducing German, Spanish, and Korean languages to make the game accessible to even more players worldwide. I have also implemented several bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I hope you enjoy these new features and continue to have a fantastic time playing our game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
