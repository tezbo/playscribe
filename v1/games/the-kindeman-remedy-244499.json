  {
   "id": "the-kindeman-remedy-244499@1",
   "gameId": "the-kindeman-remedy-244499",
   "displayName": "Update 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-06-23T09:58:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We heard you loud and clear: on popular demand, we increased Dr. Kindeman and Oliver's movement speed while carrying bodies down in the Morgue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now you also have 4 carts for the drips.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While we were at it, we fixed some localization problems (especially with Italian language) and other game loading bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's the full change list",
     "items": [
      {
       "text": "Increased characters' movement speed while carrying bodies (Kindeman/Oliver)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Localization: fixed wrong tags in Italian localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Oliver (assistant)'s behavior",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Phone bug when loading a game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Pippi bug when loading a game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added Drip Cart N.4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Minor and Major Report values when loading a game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Sister Anna's cloth mesh compenetrations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a new Credits screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enjoy and stay tuned for more improvements/fixes/updates in the next few days!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- Troglobytes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
