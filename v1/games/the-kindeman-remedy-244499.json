  {
   "id": "the-kindeman-remedy-244499@4",
   "gameId": "the-kindeman-remedy-244499",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-12-21T20:29:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone, we've got a small new update just in time for the holidays for you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NEW!: We added a brand new gameplay section for Sister Anna; she can now make poison from mushrooms and pesticide into the Warehouse (Please note that you'll need to start a new run in order to do it)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Oliver's behavior when carrying bodies; now he'll take bodies to the incinerator as intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where lights in the Drip Room were off during gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players would unlock Pills Dispenser 2, but be unable to use it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Refactored the Daytime/Nighttime Report UI with improved icons and layout",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
