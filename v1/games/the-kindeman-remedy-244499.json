  {
   "id": "the-kindeman-remedy-244499@3",
   "gameId": "the-kindeman-remedy-244499",
   "displayName": "Patch 3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-12-07T15:47:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are back with a new update that addresses some of the issues that have been reported by the community! Once again, thanks to everyone for sharing your feedback with us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is the list of what is included with this update",
     "items": [
      {
       "text": "Added camera pan (hold the right mouse button or use the gamepad's right stick)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added Enhanced Lighting to Graphic Settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Gore Death for poisoned inmates (you need to enable the Gore option in the Game Settings Tab)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the assistant's velocity when he's carrying a corpse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Percy's dialogues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made object icons clickable (you can interact with an object by clicking on its icon as well)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Room icons appear as soon as an inmate enters a room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Replaced Corpse Disposal with Incinerator",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Greyed out inactive rooms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased Freight Lifter speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased guard's speed when he's dropping a corpse in the Morgue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased Chemical Desk speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased Morgue Table speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
