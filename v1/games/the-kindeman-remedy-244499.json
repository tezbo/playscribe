  {
   "id": "the-kindeman-remedy-244499@5",
   "gameId": "the-kindeman-remedy-244499",
   "displayName": "Patch 5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-04-11T16:49:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we have a small new update for you that addresses some minor issues and also adds a few new features! We have also added Catalan language. You can find the full list down below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, today we are happy to let you know that The Kindeman Remedy will be available on PS4|5, Xbox Series and Xbox One, and also the Nintendo Switch! For those of you who would like to try the game on consoles, you now have the option to do so! You can watch the trailer here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Added a new 'special treatment' to unlock: the Bath Tub",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Screen Resolution option to Graphic Settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Catalan localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added 'special treatments' list in the Prescription Book: you can check which treatments you already performed on inmates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some cutscenes: corrected some compenetrations with objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Drips and Poison tutorial: locked useless doors during tutorials",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
