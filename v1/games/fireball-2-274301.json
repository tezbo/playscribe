   "announcedAt": "2025-06-05T11:16:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Made enemy spawning location more obvious prior to spawn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added some dark backgrounds to a couple UI elements (mode matrix and leaderboard)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased brightness of sliders in option menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made menu background not get quite so bright",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated background/music flashing to ignore volume of music",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated achievement destroyed count to count enemies being destroyed on wall deaths too",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also added 3x bonus for killing enemies with bombs, 5x (+2x more) for kills that create a nova",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed arena size in very high waves (30+) being too tall vertically (enemies couldn't reach player)",
