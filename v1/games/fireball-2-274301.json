  {
   "id": "fireball-2-274301@1.0.0.3",
   "gameId": "fireball-2-274301",
   "displayName": "Update 1.0.0.3",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-05-08T20:47:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Optimized the game a bunch, with one compromise as a result.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced max particles on non-Low GPU Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced linear color buffers from 64 to 32 bit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made sure MSAA is disabled by default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed distortion pass from enemies (only with MSAA and 64bit buffers): The distortion pass may come back at a later date, but console versions already don't have it due to performance. The overall performance improvement (2-3x in some cases) seems more important.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
