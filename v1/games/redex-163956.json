  {
   "id": "redex-163956@1.0.1",
   "gameId": "redex-163956",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-11-29T13:39:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "User Interface",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mouse can be used in menu and pause",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Now the position of the box is marked with a beacon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reworked skill leveling window",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New skill \"Engineering\", which allows you to pump the characteristics of weapons and turrets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reworked some perks, now they are more important for comfortable gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added platform jumping mechanic. The game now supports full WASD control",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Cut out the regeneration of armor, increased the regeneration of health, and now its speed is affected by the skill \"Strength\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The maximum points of armor is now more dependent on the skill \"Mastery\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added cooldown for registering enemy bullet damage (cooldown does not apply to shotguns)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The difficulty of enemies grows with the wave",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
