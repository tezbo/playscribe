  {
   "id": "electronics-puzzle-lab-264799@0.2.1",
   "gameId": "electronics-puzzle-lab-264799",
   "displayName": "Update 0.2.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-05T19:31:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update v0.2.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Notifications no longer appear if the level has been completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Inserted double checks for level completion or failure conditions. The failures were occurring because in one frame all the red LEDs on the level were red and then the blue LED was on. With the double checks, I added a small delay to avoid these types of situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level 52 bug fixed: At level 52 I found a bug where the SW3 switch was listening to a wrong component.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level 64 bug fixed: At level 64 the game object called NOR Gate 3 Inputs was listening to an incorrect component.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level 75 visual bug fixed: In level 75, there was a visual bug where the striped line for the SW3 key output does not appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level 85 bug fixed: At level 85, the level could be successfully completed with only 2 of the 3 LEDs lit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visual bug fixed in some levels: Some dotted lines were not appearing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
