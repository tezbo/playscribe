        "pc"
       ]
      },
      {
       "text": "Fixed an issue with the Jujitsuka when yeeting throwing the Shogun with 1hp on an ennemy, that ended up in softlocking the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
