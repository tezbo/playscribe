  {
   "id": "shogun-showdown-208533@major-2023-10-04",
   "gameId": "shogun-showdown-208533",
   "displayName": "Jujitsuka Update - Early Access Milestone",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-04T16:54:30.000Z",
   "notes": [
    {
     "title": "Hellooooooo everyone!",
     "items": [
      {
       "text": "We've reached the next major milestone of the Early access. The big star of this update is the new hero, the Jujitsuka!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're so excited for you to get your hands on this new hero and the new mechanic! (That I personally call the Yeeting, but you'll see more when trying it :D)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Along this new hero, Elites ennemies are coming, new skills, new tiles, and more! Please find the complete changelog below !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition, we'll be discounting the game, so you can GRAB SHOGUN SHOWDOWN AT -20%, LASTING 24 HOURS!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New content",
     "items": [
      {
       "text": "New Hero: Introducing The Jujitsuka",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Gameplay Mechanic: Elite Enemies make their debut from Day 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "4 New Tiles (Scar Strike, Signature Move, Meteor Hammer, Kaitenryuken)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "4 New Skills (Combo Deal, Monomancer, Karma, Cursing Move)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "4 New Quests (Steel Summit, Honorable Death, One-Way Hero and Frugal Fighter)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Enemy: Yumi Sniper",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Location: Hibiku Wastelands",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Boss: Baru the Barricader",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Balance changes",
     "items": [
      {
       "text": "Tweaked Back Strike tile: from 2DMG, 1CD to 3DMG, 3CD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Tweaked Perfect Strike: +2CD -> +1CD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Tweaked Combo-Recharge:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Level 1: recharge 4CD on the tile dealing the combo kill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Level 2: recharge 8CD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Tweaked spawning probability distributions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "New attack pattern for Nobunaga",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "We do hope you'll like this additions to the game, if you do, take a bit of your time to review the game, that definitely helps us! (In addition to make us smile, which is great!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
