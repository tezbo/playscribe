  {
   "id": "shogun-showdown-208533@0.6.0.8",
   "gameId": "shogun-showdown-208533",
   "displayName": "Update 0.6.0.8",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-08-21T14:51:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey there, just a little update fixing some stuff we/you found!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "Fixed a bug where the game would soft-lock in the shop if you sacrificed a tile when using the gamepad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Fullscreen mode option was displayed in the wrong language",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Offscreen inputs could mess up with the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with French localization displaying a button wrong",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a display issue with \"Perfect Strike\" description",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
