  {
   "id": "shogun-showdown-208533@0.5.7",
   "gameId": "shogun-showdown-208533",
   "displayName": "Update 0.5.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-07-06T11:56:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've got some more fixes coming today! That's not a lot, but we felt that you wanted to have a way to lock the Scroll wheel. It's now possible!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patchnote 0.5.7 ",
     "items": [
      {
       "text": "Fixed a bug with the interaction between the 'Damaging Move' and the 'Back Stabber' skills.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "New option in \"Controls -> Scroll Wheel\" to disable the scroll wheel input.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some descriptions and translations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
