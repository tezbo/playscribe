   "id": "shogun-showdown-208533@1.0.2.1",
   "gameId": "shogun-showdown-208533",
   "displayName": "Update 1.0.2.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-23T15:45:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're pushing this little patch to fix some issues we (or you)'ve catched!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks a lot for playing Shogun Showdown, and for the cool reviews we see all day. That's really heartwarming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "Bug fix: On MacOS, if you alt-tabbed / switched workspace the game would become unresponsive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fix: Enemies and heroes \"death animation\" would not trigger under certain conditions leading the \"death standing\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fix: Thorns retaliation damage was set to 0 after quitting the game and continuing a run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fix: True Mastery quest could incorrectly trigger after completing only 4 out or 5 heroes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a few typos (English & Chinese)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
