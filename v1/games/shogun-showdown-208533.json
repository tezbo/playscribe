  {
   "id": "shogun-showdown-208533@0.5.6",
   "gameId": "shogun-showdown-208533",
   "displayName": "Update 0.5.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-30T09:46:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey there! Here's the changelog for the first small update of Shogun Showdown! We adressed some bugs we/you found",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A lot of you folks requested to be able to unassign/lock the mouse wheel. It requires a bit of translation, so it's not in this first small update, but this will come!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Later (but it'll be in a major update), our plan is to let you rebind your keys (and buttons when there will be gamepad support) as you want!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed a soft-lock situation when entering a reward room with only maxed-out tiles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a soft-lock situation in the Twin boss fight when one twin is killed by being pushed on a trap.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a soft-lock situation when both player and Shogun die in the same turn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a major bug involving incompatible alpha-version save files (from an old itch.io alpha version) causing startup errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor localization and translation issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
