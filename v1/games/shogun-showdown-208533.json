  {
   "id": "shogun-showdown-208533@major-2024-05-13",
   "gameId": "shogun-showdown-208533",
   "displayName": "New update out now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-13T17:09:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Endless Replayability Fest is here, along with a new update for Shogun Showdown -- including key remapping for gamepad and keyboard, new upgrades and shop and more!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "New stuff",
     "items": [
      {
       "text": "New upgrade: +2DMG, +3CD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New upgrade: Warrior's Gamble",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Rei the Rutheless alt boss in bamboo grove (unlocked by defeating the shogun)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New environment graphics for shops",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Moonlit Port Shop (services: skull exchange, skull reroll, bone soup).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Italian localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Option to select different gamepad glyphs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New default gamepad layout",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Option to switch between \"default\" and \"alternative\" gamepad layouts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Key remapping for gamepad and keyboard",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Keyboard only mode",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Sword renamed to Katana and buffed from 1CD to 0CD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Tweaks to enemy spawning positions probabilities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "When you reroll a reward multiple times, you are now guaranteed not to get repeated outcomes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Tweaks to upgrades probabilities (slightly lower chance of -1CD)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Renamed \"+1 max level\" upgrade to \"+1 upgrade slots\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Restructured the UI for reroll/skill rewards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reworked poison effect graphics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Shop on shogun island is unveiled on the map after defeating Kowa/Sato (before it was unveiled only after defeating Hideyoshi/Nobunaga)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed togglable controls summary button (might reintroduce it in the future)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reworked tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Restructured some menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "New font for Japanese/Chinese. This solves the issue with the previous font where a \"smaller font\" was used as a fallback option if some logograms were missing from the main font.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed bug with d6 sometimes not being sellable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed graphical glitch for shinobi smoke bomb + karma death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some shop navigation issues with gamepad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue if you give up during a reward with a gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with shogun phase 2 appearing in the wrong cell if the killing blow was pushing shogun phase 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you want to try out the game, the public demo is still available and has been updated as well:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "new tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "gamepad support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "save game will carry over to main game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "different final boss for the demo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "removed \"stamps\" in the demo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Have fun! 🎉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Roboatino & Goblinz Publishing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
