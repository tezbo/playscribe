 "releases": [
  {
   "id": "mxgp-24-the-official-game-323182@1.2.2",
   "gameId": "mxgp-24-the-official-game-323182",
   "displayName": "Update 1.2.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-23T13:00:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The 1.2.2 update for MXGP 24: The Official Game is out now! This patch introduces many improvements, especially about gameplay physics . Check out the full details below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Physics and animation",
     "items": [
      {
       "text": "Grip has been generally improved, allowing for better cornering at all speeds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Braking aids are now applied in manual gear mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Suspensions had a general rework",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brakes have now more power and a more neutral distribution between front and back brakes. Curves of brakes have been reworked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The pilot's weight have been improved and the bike is generally more responsive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Noise has been added to dirt surface to add texture to the road when riding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pilot has more yaw control during air time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General bike settings have been reworked to prevent falls from high altitudes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tyres profile has been updated to balance settings on all surfaces including wet variant",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Handlebar collision have been reduced to avoid collision on the top of other pilots and yourself",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collider radius has been increased on the sides to leave more space between riders",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement on leg movement of the rider during turns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The torso of the rider rotates more during jumps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Detection of jumps is more precise, allowing the rider to move more when doing small jumps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jump position of the rider have been improved overall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Head rotation of the rider has been improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Interface",
     "items": [
      {
       "text": "Rider creation have been polished overall when entering a new name",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected inputs on the sticker edition screen when using keyboard and mouse",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed medal scoreboard display for Last Man Standing, Trail and Enduro gamemodes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed photo mode helpers (input on the bottom of the screen) when changing controllers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "AI",
     "items": [
      {
       "text": "General AI rework to match physics upgrade. AI has been reworked on all tracks to improved on \"Semi-pro\" \"Professionnal\" and \"Expert\" difficulties",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steering parameters now depends on the AI skill level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug fix",
     "items": [
      {
       "text": "Fixed Career money checks that were present during chapter 1 pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed refresh bug when scrolling through the sitcker list in sticker editor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed wrong letterng for player's nickname in multiplayer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed back to default issue for HUD settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed helper resizing error",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Holeshot validation on all GP steps instead of race 1 and 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Best season score for MX2 and MXGP saving the lowest score instead of the highest score",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed camera shake when resetting a race when falling with an IA controlled rider",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed PS4 pro controller detection and added PS4 wireless adaptor as well as PS5 edge controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixed Ghost compatibility with DLC Fox suits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Career crash related to private messages in the social media tab",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed sticker offset when opening customization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed memory leak with stickers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash when deletting sticker if the player is holding the \"Add sticker\" input",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed graphical errors on some spot of the Free Roaming",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Flyby distance view with asset cliping on Agueda and Riola Sardo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash when changing the sound peripheral in game with a fresh save file",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Track fix",
     "items": [
      {
       "text": "Fixed floating haystacks on Cozar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dust trail VFX on Cozar have been calibrated to have to correct color based on the ground type",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Career has been increased in difficulty following player feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Both brakes (front and back brakes) now allow the rider to go in reverse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added better transition between screen in customization mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Modified the rider customization screen to allow the player to see the boots of the rider when customizing them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enheanced the quality of the pad image during the first screen of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
