  {
   "id": "stray-gods-the-roleplaying-musical-194506@1.2",
   "gameId": "stray-gods-the-roleplaying-musical-194506",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-08T05:17:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey folks,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We recently released a patch with a number of fixes but unfortunately upon release some players encountered unexplained crashes. Because of this, we made the decision to roll it back.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're happy to say we're releasing a new patch today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This patch includes the following fixes",
     "items": [
      {
       "text": "Fixed voiceover equalisation, which brings the volume of each character’s VO into alignment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a number of issues that were causing crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various issues where binding actions to specific keys didn't work as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some localisation issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed brackets from some speaker labels to make them more readable. (The last encore for our beloved ‘Ibothi’ and ‘Ialli’)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where you could get similar conversations with Pan one after the other during the Medusa storyline.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you again for your support and feedback. As always, if you encounter any further issues please reach out to us via our support form so our team can investigate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "And a 5 6 7 8!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
