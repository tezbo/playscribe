  {
   "id": "stray-gods-the-roleplaying-musical-194506@patch-2024-06-27",
   "gameId": "stray-gods-the-roleplaying-musical-194506",
   "displayName": "Stray Gods: The Roleplaying Musical Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-27T01:02:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello folks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With Stray Gods: Orpheus about to take the stage, we thought it'd be a great time to revisit Stray Gods: The Roleplaying Musical with some updates & fixes in one final and beefy patch. Thanks to those of you who have reached out to the team along the way and helped us investigate these issues — our team couldn't have done it without you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today’s final Stray Gods: The Roleplaying Musical patch includes the following:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for bug where trait selections were incorrectly inaccessible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes for bugs when pausing during load screens/audio descriptions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Additional Optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several minor cinematic fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor environmental tweaks: Menus/UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes for Option Menu bugs (some visual and technical)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Update to New Game Menu to make overwriting saves more explicit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed Gamesight functionality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Re-sized UI scaling to handle localized text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Re-localized some text that was not translated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for some subtitles not appearing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved controller navigation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Support for Stray Gods: Orpheus: We hope these fixes find you well - and just in time to enjoy Stray Gods: Orpheus!: It’s about time for an encore don’t you think?: xoxo,: Summerfall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
