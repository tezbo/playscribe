  {
   "id": "stray-gods-the-roleplaying-musical-194506@patch-2023-09-02",
   "gameId": "stray-gods-the-roleplaying-musical-194506",
   "displayName": "Patch Rollback",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-02T13:05:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Earlier today, we soft launched a Patch #1.1 on Steam, which aimed to address the audio imbalance, localisation fixes, some keybinding issues, and more. However, we are receiving reports that the patch is causing some game crashes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We have decided the best course of action is to roll back this patch and re-release it after we’ve remedied the problem.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are very thankful of the patience of our community!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
