  {
   "id": "stray-gods-the-roleplaying-musical-194506@major-2023-07-13",
   "gameId": "stray-gods-the-roleplaying-musical-194506",
   "displayName": "Stray Gods: The Roleplaying Musical Date Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-07-13T20:00:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re so excited - Stray Gods is under a month away!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re counting the days and we know you are too, but we need to make a slight adjustment to the calendar. We’re moving our launch date to August 10th, 2023.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We want everyone to have ample space to check out Stray Gods when it launches. Baldur’s Gate 3 is hotly anticipated (by us, too!) and we want to give our fans room to celebrate Stray Gods.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also want everyone to be able to play on their preferred device at launch. This is a huge undertaking for any team, let alone an indie shipping its first title. This extra week allows us to have performance parity as close as possible - across every platform.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're so excited to share Stray Gods with you and we hope you'll join us on August 10th to play and celebrate this game we've poured so much love into!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
