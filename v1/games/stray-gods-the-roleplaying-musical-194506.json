  {
   "id": "stray-gods-the-roleplaying-musical-194506@1.1",
   "gameId": "stray-gods-the-roleplaying-musical-194506",
   "displayName": "Hotfix 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-12T03:54:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey folks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you have been enjoying your ‘time to shine’ with our idols in Stray Gods: The Roleplaying Musical.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you again for all of your feedback and bug reports. They have enabled us to investigate and address a number of issues which have been fixed in today’s patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The most commonly reported issue was the uneven volume levels, and that has now been corrected. Our gods are now in perfect harmony with one another - no more extra quiet Muses or super sonic Goddesses to be seen!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "In today's patch we have",
     "items": [
      {
       "text": "Fixed voiceover equalisation, which brings the volume of each character’s VO into alignment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a number of issues that were causing crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various issues where binding actions to specific keys didn't work as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some localisation issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed brackets from some speaker labels to make them more readable. (A fond farewell to ‘Ibothi’ and ‘Ialli’)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any further issues please report them via our bug report form for our team to investigate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "May the Chorus judge you kindly!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Summerfall Studios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
