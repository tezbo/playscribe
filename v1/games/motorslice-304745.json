  {
   "id": "motorslice-304745@1.06",
   "gameId": "motorslice-304745",
   "displayName": "Patch 1.06",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-09-07T12:57:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello slicers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I was on a vocation after release! It was good, but back to work ːPjudgeː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's the list of fixes",
     "items": [
      {
       "text": "Small tweaks on the air control",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Boss life save glitch starting with life completed - affects Boss 02 in specific",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Slicing boss 02 tentacles life depletion adjustment and bug fixing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor level design tweaks on Chapter 02, 04, 06 & 08",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A bug where P becomes very sensitive to turn in air after motorslicing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A rare case when Guard Excavator enemies fall trough the floor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cranes on levels missing “sliceable” highlight on VR scan mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Returned the slope angle relative to height fall damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A rare occasion getting stuck while parrying boss 06",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed wrong orb icon on chapter screen on chapter 6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Assets not loading properly on some rare occasions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Safety checks to prevent teleportating to a different boss while on a boss fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Also, don't forget about the Plushie campaign, it ends in just a few days.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
