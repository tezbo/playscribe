  {
   "id": "full-metal-schoolgirl-352205@major-2025-11-14",
   "gameId": "full-metal-schoolgirl-352205",
   "displayName": "[Important] Update Information (Nov. 14th, 2025)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-14T09:56:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45681582/fa96c7a1301ec59e8d17052702e1b9e0cabba61d.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed issue where, when changing the command for Prepare Punishment Move, the MOD Reshuffle command would display as the default command.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed issue causing the game to load in Japanese when creating a new data save, regardless of the console's language setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted the cutscene skip command.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased the rate at which MJP is dropped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where mouse sensitivity decreased during free camera mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Adjusted the transparency of the smoke from fire extinguishers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
