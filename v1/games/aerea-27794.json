  {
   "id": "aerea-27794@1.0.1",
   "gameId": "aerea-27794",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2017-06-06T09:50:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've received your feedback and we’ve implemented a couple of changes especially regarding the balancing of the game. The new patch is online now! You can find the list of changes made below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balancing of enemies at the start of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balancing of skills of all classes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed text at character selection screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed text at shop screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed controller input for locking character movement using the left stick press: We’d like to thank you, the community, for your feedback which made this patch possible! We’ll keep our eyes and ears open for more.: Enjoy the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
