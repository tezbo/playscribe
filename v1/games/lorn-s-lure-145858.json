  {
   "id": "lorn-s-lure-145858@post-2024-11-22",
   "gameId": "lorn-s-lure-145858",
   "displayName": "Explore Mode QOL Changes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-22T02:28:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey climbers, just pushed a minor update to the Explore Mode for quality of life improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This includes",
     "items": [
      {
       "text": "Explore mode saves are now separate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many more checkpoints in Chapter 8!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Alert icon to show new folks where the settings is",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Regarding separate saves, this also implies separate records! So when you hover over the chapter in the level select menu, while Explore Mode is selected, you'll see empty records.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Just beat the chapter in Explore Mode and you'll see a record populated. Do the same for regular mode if you beat the game on Explore mode first.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This also applies to the full run mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Records had to be separated cause chapter 8 has a different number of scans in Explore mode, and folks probably want a way to measure their runs separately anyway.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let me know if you have any issues!",
       "ps5ProOnly": false,
       "pcOnly": false,
