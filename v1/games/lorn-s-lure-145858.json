   "id": "lorn-s-lure-145858@post-2026-03-25",
   "gameId": "lorn-s-lure-145858",
   "displayName": "UI Click fix .... again...",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-03-25T18:30:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Minor patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NOW you should test the UI click issue changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Technical details",
     "items": [
      {
       "text": "Theoretically, the unity asset I was using: ReWired was detecting mouse pads as the first input, and not including the mouse as a player.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "So if this was affecting you and you were NOT using a laptop let me know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
