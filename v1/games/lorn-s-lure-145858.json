  {
   "id": "lorn-s-lure-145858@major-2021-05-25",
   "gameId": "lorn-s-lure-145858",
   "displayName": "Boring Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-05-25T17:27:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I've been working on boring stuff for a while now, BUT I have a lot to show for it now, and the boring is almost completely done.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What I've Been Up To",
     "items": [
      {
       "text": "Controller support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Redone main menu, with level select!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level select shows high scores for each level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Redone stats summary at end of level, with broken record diffs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fully functional options menu, that can be accessed while playing as well",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Saving / Loading with multiple levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New in-game HUD - now with crystals + scans, including total possible in the level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bunch of bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay Video",
     "items": [
      {
       "text": "As you can see, I've been very busy. And with a lot of this out of the way, soon I can focus on the fun stuff - designing the main campaign!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned for more",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
