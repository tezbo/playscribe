  {
   "id": "teacup-142419@post-2021-12-20",
   "gameId": "teacup-142419",
   "displayName": "Teacup available in 5 new languages!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-12-20T18:47:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Better late that never! We're happy to share that in the latest update has added the following languages to the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "French",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "German",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Portuguese (Brazil)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Russian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spanish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game's language can be set via the options screen found in the main menu. We hope you enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
