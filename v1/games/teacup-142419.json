  {
   "id": "teacup-142419@post-2022-01-12",
   "gameId": "teacup-142419",
   "displayName": "Improved option menu and accessibility fixes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-01-12T22:32:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ever needed to tweak the game's resolution? Or lower the music volume? We've updated the options screen in the main menu so now you can now do this and more. We've also added some accessibility improvements and are working on more, so look forward to them. We hope you enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
