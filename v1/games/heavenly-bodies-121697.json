  {
   "id": "heavenly-bodies-121697@major-2023-06-29",
   "gameId": "heavenly-bodies-121697",
   "displayName": "Update Notes For June 26",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-29T03:06:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This patch includes the following fix for players on Windows:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixes issue where players could not start game if more than one player was paired to a keyboard and was the first paired player.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thanks to everyone for helping to report these issues. Being a 2 person team, having your support in identifying bugs means the world to us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, if you experience any further issues, please don't hesitate to let us know on the Steam forums, our Discord, or via our email at help@2pt.com.au.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
