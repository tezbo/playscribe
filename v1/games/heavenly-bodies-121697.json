  {
   "id": "heavenly-bodies-121697@major-2022-03-01",
   "gameId": "heavenly-bodies-121697",
   "displayName": "Update Notes For March 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-03-01T05:16:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you're all enjoying Heavenly Bodies! We've been taking a little break from things to rest our heads, but we're starting up with fixes again now. Thank you to everyone who has reported their issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We just have a couple of fixes today",
     "items": [
      {
       "text": "Added support for DualSense controller on Windows and Mac platforms (including M1).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issue where unsupported devices could cause the game to close as soon as the title screen became visible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We are still actively working to add support for additional devices, but it's unfortunately a slow process which we too are frustrated by! With this, we thank you so much for your patience. If you can't get your controllers to work, please reach out to us at help@2pt.com.au - we make it our duty to help you out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "☆ Thanks for playing! ☆",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
