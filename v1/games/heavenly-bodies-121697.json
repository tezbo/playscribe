  {
   "id": "heavenly-bodies-121697@major-2022-01-20",
   "gameId": "heavenly-bodies-121697",
   "displayName": "Update Notes for Jan 20",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-01-20T06:50:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone! We've been working hard on fixing a bunch of small issues, most of which you'll find in this patch! Check out this massive change log:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added support for pairing multiple users to keyboard and mouse controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issue where some spawn points could cause the player to become stuck in space in Newtonian movement mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the game would not end if a single player was connected to both ropes in the outro scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the ability to speed up the Operations Manual objective and challenge completion animations using Button South on gamepad and Spacebar on keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed zoom action input threshold on Operations Manual.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the ability to navigate back to the title screen using Button East on gamepad and Back on keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed music playback issue in Data if antennas were completed out of sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed music playback issue in Minerals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing I character when playing using a Turkish system region.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed collectable trophy display logic so that it now requires user input to finish the sequence instead of using an automatic timer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where speedrun timer would pause during cinematics where gameplay was still in progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where speedrun timer would not work for some system cultures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where speedrun timer would stop before the game had finished.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where speedrun timer would have a non-zero value at the start of Evacuation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where speedrun timer modes would have the same behaviour. The ‘Game’ timer mode now displays the total play time for the loaded save slot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rare issue where Evacuation airlock door would not open if the lever was pulled at a very specific moment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where Operations Manual could be opened after completing a mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed potential exploit where players could complete Data time challenge by restarting from checkpoint.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue on PlayStation where players could not reconnect devices after the play session expired.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixed issue where escape pod would not depart if the player entered the seat before closing the hatch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where ropes could break in the vents section of Evac.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Once again, thank you to all of our testers for ensuring that this patch is nice and tight. If something has slipped us by and you run into an issue, please don't hesitate to let us know - we'd greatly appreciate it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you around.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Alex from 2pt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
