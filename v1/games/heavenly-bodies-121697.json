   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks for playing, everyone! A couple of small bug fixes today:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where Perfect Signal and A Classical Mechanic achievements could not be unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where asteroid mining drill could sometimes extract minerals from any part of an asteroid.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue in Vision where the telescope would take forever to deploy if yeeted too gently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please note, for players who have already fulfilled the criteria for the unlockable achievements, just complete Data again in any movement mode and you should receive the achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
