  {
   "id": "heavenly-bodies-121697@major-2023-08-07",
   "gameId": "heavenly-bodies-121697",
   "displayName": "Update Notes for August 7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-08-07T07:19:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for being so patient as we work to fix a bunch of new issues. This update addresses the following:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where Proud Souvenirs achievement would not unlock properly when Cleanup DLC was purchased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where achievement stamp page would overlap challenge page when some challenges were first completed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved Cleanup signal station UI to better communicate how to leave the station",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed speedrun timer not resetting between days on Cleanup mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where speedrun timer UI navigation prompts were out of order",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thanks again to everyone who has reported these issues. We have more to come, including some new options for character control customisation!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you round,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2pt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
