  {
   "id": "dandy-randy-dx-193624@major-2022-05-06",
   "gameId": "dandy-randy-dx-193624",
   "displayName": "New Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-05-06T16:18:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "For this update we focused on fixing bugs and performance improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have a new Electron version which should run ways better than the old version, but please keep in mind that we could not bring saves over to this version!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So we decided to make it an option when you launch the game - if you pick the Electron version you'll have performance improvements + other bug fixes, and if you pick the NWjs you still get the bug fixes, but without the performance improvement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unfortunately this is the only way we could bring improvements to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We strongly advise on starting the game over for the performance, even if you already have a savegame.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog for v1.1",
     "items": [
      {
       "text": "Fixed a bug where the countdown in Azure Mountains wouldn't reset after dying",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that prevented the player from running away after the boss in Azure Mountains",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made it so the countdown after the Azure Mountain's boss doesn't appear in practice mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a pause related bugs where sprites would continue to spawn while the game is paused",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where items spawned by rocks would sometimes go inside walls and getting impossible to collect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where level titles wouldn't appear fully in some languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where frog enemies sometimes couldn't be killed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added windowed support (press F2 or Right Alt + Enter to toggle between fullscreen and windowed modes)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Exported a new version using Electron, should improve performance a ton compared to the old NWjs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
