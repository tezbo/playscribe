   "id": "dandy-randy-dx-193624@post-2025-02-25",
   "gameId": "dandy-randy-dx-193624",
   "displayName": "Dandy & Randy DX Changelog Feb 24 2025",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-02-25T18:09:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Along with Asteristic Game Studio we have prepared a new build that addressed the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where if player 1 died at the last boss, the final cutscene would hang",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the final cutscene wouldn't go past the sentence \"6 months later\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the last boss's laser wouldn't pick the right player to shoot (both lasers should always only pick one player)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
