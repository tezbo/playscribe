  {
   "id": "star-trek-resurgence-185255@major-2024-06-26",
   "gameId": "star-trek-resurgence-185255",
   "displayName": "Star Trek: Resurgence // Enhancement Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-26T19:12:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "You asked, and we listened! The Resurgence Enhancement Update is now on Steam with new features to enhance your experience aboard the USS Resolute.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Achievements Engaged: Show off your skills and dedication with all-new achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Choose from four graphics pre-sets: Minimum, Standard, High, and Maximum – tailor your game visuals to your taste and your system’s performance capabilities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Take control of V-Sync: Toggle it on or off to find the perfect balance of smoothness and performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy enhanced performance across the board, including a smoother experience on Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Your ongoing feedback is invaluable, and we can’t wait to hear what you think of these enhancements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note: Achievements can only be acquired via a NEW play-through of the game. So, now's the chance to make some different decisions to see what will happen to you and your crewmates aboard the Resolute!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "LLAP - The ST: R team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
