  {
   "id": "pentiment-204623@1.0.1215",
   "gameId": "pentiment-204623",
   "displayName": "Hotfix 1.0.1215",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2022-11-18T20:04:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Over the next few days, we will roll out a hotfix patch for Pentiment on all platforms. This patch includes the following changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Several issues that could cause spoilers for later acts to appear in your journal too early have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-A slider to adjust the volume of writing sounds has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-An issue causing text to be missing for users whose systems are set to Turkish-speaking regions has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Other minor stability and presentation fixes have been addressed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When you see this patch is available, please download and install it before continuing your game. Thank you for your patience and understanding, and we hope you continue to enjoy your time in Tassing and Kiersau Abbey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
