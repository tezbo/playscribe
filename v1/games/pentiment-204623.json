  {
   "id": "pentiment-204623@1.2.1716",
   "gameId": "pentiment-204623",
   "displayName": "Hotfix 1.2.1716",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-08-07T20:17:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fix for issue related to doing a return to Main Menu and Continue causing the game state to become corrupt (midnight and no quest/progression data). Also added safeguards to prevent loading into an invalid game state in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you were affected by this bug, please check your old saves by selecting New Game on the Main Menu, highlighting the save slot and selecting \"Old Saves\" to see your save history. The game will save 5 scene transitions and 3 time advance saves. If you overwrote all of your save games, contact support and we might be able to get you started at the most recent act using the developer console.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
