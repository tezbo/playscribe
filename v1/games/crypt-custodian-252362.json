   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-09-25T20:20:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Just updated with a small patch fixing a handful of bugs and tweaking some systems slightly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Your vessel refills after death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed some issues with the camera zoom setting (including some background glitches)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed a rare crash during the final boss fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed a rare crash if you exited to menu in the Tower boss room, and re-entered",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Made the broomerang break pots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-A few speedrun changes (allows speedrunning boss-rush mode, debug save states, etc)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Various other tiny fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
