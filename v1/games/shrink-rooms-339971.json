  {
   "id": "shrink-rooms-339971@1.1.3",
   "gameId": "shrink-rooms-339971",
   "displayName": "Update 1.1.3",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-03T16:17:34.000Z",
   "notes": [
    {
     "title": "Content Update",
     "items": [
      {
       "text": "Several main levels have been added to the fourth area of Chapter Three, and the difficulty curve has been adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Level 2 - 48 has been adjusted to a side - level, and a new main level has been added to this sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Level 3 - 34 has been adjusted to a side - level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Level optimization (Levels 3 - 51, 3 - 61, 3 - 48, 3 - 58, 3 - 59)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Level 5 - 20 has been adjusted to a side - level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Experience Optimization",
     "items": [
      {
       "text": "After the player dies, the level will no longer be automatically reset. You can choose to manually reset or undo the last step.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Problem Fixes",
     "items": [
      {
       "text": "The polymer blocks in the cave will no longer be consumed and create new connections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The number of the disappeared Level 2 - 07 is back!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the localization and interaction issues on the level completion screen in some languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The achievements for Inspect all exhibits, Complete Chapter 5, and Complete the Game can now be normally unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The unintended solutions of the following levels have been fixed. Welcome to continue the challenge! —— A - 05, 2 - 13, 2 - 18, 2 - 33, 2 - 45, B - 03, B - 05, B - 09, 3 - 48, 4 - 19, 4 - 22, E - 06, E - 10",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
