   "id": "car-service-simulator-326466@1.02",
   "gameId": "car-service-simulator-326466",
   "displayName": "Update 1.02",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-08-30T22:09:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45177040/fc2fabb5b90ee77bb9c2713e1767a1155efadf7c.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Hello mechanics! 🚗🛠️",
     "items": [
      {
       "text": "Our new update is live! Thanks to your feedback, we’ve made the game smoother, more enjoyable, and more realistic. Here’s what’s new:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🆕 New Features & Improvements",
     "items": [
      {
       "text": "Removed the total money slider in the customer panel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated post-process effects for clearer visuals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added interaction hints for hood and trunk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added hint for picking up dropped tools when failing with the hammer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved car physics for a more realistic feel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a pop-up warning when trying to select a locked skill in the skill tree.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In battery and engine filters, damaged parts can no longer be processed or installed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved save game visual popup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a message popup when entering the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Cargo cart can now be purchased from the PC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added “ESC” exit support in both PC and physical shop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed errors in the player’s toolbar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved workers AI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new mission: Radio Quest 📻",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🐞 Bug Fixes",
     "items": [
      {
       "text": "Fixed the issue where tools duplicated after re-entering the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for your support! 💙",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We’ll keep improving the game with your feedback. Have fun! 🚙💨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
