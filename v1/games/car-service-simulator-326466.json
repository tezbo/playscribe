      {
       "text": "🔄 Fixed the game reset issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🖥️ Resolved the problem with locked tabs on the computer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🗑️ Fixed the issue where trash reappeared after some time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🚘 Fixed vehicles getting stuck in the garage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "👷 Various worker improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "⚡ Performance optimizations implemented.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🪟 Fixed missing window issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "👥 Customer interaction improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🚿 Fixed FPS drops during the first car wash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "💦 Improved water gun particle effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Your feedback helps us grow the game every day. Thank you for your support! 🙏",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
