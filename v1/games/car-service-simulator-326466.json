  {
   "id": "car-service-simulator-326466@hotfix-2025-08-30",
   "gameId": "car-service-simulator-326466",
   "displayName": "🚀 Car Service Simulator – Hotfix Released!",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-08-30T02:05:47.000Z",
   "notes": [
    {
     "title": "🔧 Hotfix v0.1.1 Update",
     "items": [
      {
       "text": "🎯 A small but impactful patch is here! This update fixes many issues and improves UI and systems for a smoother experience. Here are the details:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🏚️ Junkyard System",
     "items": [
      {
       "text": "The junkyard system has been completely updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Equipment now has a cost.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Equipment selling has been added and made easier to use.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The basket system has been removed from the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔊 Audio Updates",
     "items": [
      {
       "text": "New footstep sounds have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Trash pickup/drop sounds are now included.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vehicle sounds have been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A sound effect for receiving money has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "📋 Task & UI Improvements",
     "items": [
      {
       "text": "Task panels are now more descriptive (especially for junkyard tasks).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Action steps in task texts are now highlighted with color and bold font.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Foam and water animations now trigger correctly upon task completion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The sleep indicator will now remain visible until the player falls asleep.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Visual improvements have been made to the inventory system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Incorrect money display during payment has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🤖 Worker System",
     "items": [
      {
       "text": "Worker equipment system has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various bugs in worker AI have been resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "⚙️ Repair Mechanics",
     "items": [
      {
       "text": "The auto-aim behavior of the tool during car wash/painting has been disabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In engine repair, failed steps now repeat until done correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In hammer repair, the tool no longer drops instantly after a mistake – it drops after several failed attempts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the issue where the moving line wouldn't stop when hit during hammer repair.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🅿️ Parking System",
     "items": [
      {
       "text": "Vehicles now exit the parking area smoothly without getting stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cars now leave properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "— Red Axe Games Team 🚗💨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45177040/f35188cc267850d5b0d604f311802237c3d6940d.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
