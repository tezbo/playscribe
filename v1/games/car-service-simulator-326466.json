  {
   "id": "car-service-simulator-326466@0.1.11.4",
   "gameId": "car-service-simulator-326466",
   "displayName": "Update 0.1.11.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-26T13:20:45.000Z",
   "notes": [
    {
     "title": "Hello Dear Players! 🎮",
     "items": [
      {
       "text": "With this update, we’ve added new features and fixed several issues in Car Service Simulator. Here are the details:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🆕 New Features",
     "items": [
      {
       "text": "Theft System: You can now steal items from customers’ trunks to use or sell.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Electricity System: Added the ability to steal fuel from customers’ tanks to refill the generator.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🎁 New Loot Items",
     "items": [
      {
       "text": "Basketball → A hoop is added to your garage. Players can play basketball, and each successful shot gives +5 EXP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Plastic Boxes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Cardboard Boxes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Wooden Crates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Electric Panels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Laptop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Envelope with Money",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Paint Buckets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Spray Paint",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Radio → A radio is added to your garage so you can listen to music.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Wristwatches → The first watch is worn on your character’s wrist and visible. Additional watches can be sold at the junkyard for profit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🐞 Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue where the wrench could rarely not be picked up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the car wash machine panel remained white.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, your feedback is invaluable to us. ❤️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for your support. We can’t wait to bring you more content in future updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Join our Discord to stay updated!",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45177040/f35188cc267850d5b0d604f311802237c3d6940d.jpg\"]",
