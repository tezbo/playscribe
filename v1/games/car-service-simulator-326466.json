   "notes": [
    {
     "title": "Hello Mechanics! 🚗🔧",
     "items": [
      {
       "text": "Thanks to your feedback, we continue improving the game and delivering a smoother experience. This update brings several important fixes and performance improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "✨ What’s New in V1.05?",
