  {
   "id": "car-service-simulator-326466@1.04",
   "gameId": "car-service-simulator-326466",
   "displayName": "Update 1.04",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-01T20:28:31.000Z",
   "notes": [
    {
     "title": "Hello Mechanics! 🚗🔧",
     "items": [
      {
       "text": "We continue improving our game based on your feedback. With this update, both the gameplay experience and the technical side have become smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "✨ New Features & Fixes",
     "items": [
      {
       "text": "🎥 Improved vehicle camera – Smoother driving and better control.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🌳 Updated Skill Tree panel – More intuitive and streamlined interface.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🚘 Improved vehicle spawning system – Vehicles now spawn more reliably.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🎨 Reworked paint tank system – More user-friendly painting process.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "👥 Fixed customer issues – Interactions are now smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "💥 Fixed rare crash issues – The game is now more stable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thanks to your feedback, our game keeps getting better every day. Thank you for your support! 🙏",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Don’t forget to check out our other games! 🎮",
     "items": [
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/3721530/Motorcycle_For_Sale_Simulator/\"][dynamiclink href=\"https://store.steampowered.com/app/2248760/Car_For_Sale_Simulator_2023/?beta=0\"][dynamiclink href=\"https://store.steampowered.com/app/3393240/Banker_Simulator/\"]",
       "ps5ProOnly": false,
