       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Right click the game, and select Properties....",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select Betas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select the branch from Select the beta you would like to opt into drop-down list.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Close the window. The game should update to reflect the selected branch.",
       "ps5ProOnly": false,
