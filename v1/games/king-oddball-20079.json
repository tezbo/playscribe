  {
   "id": "king-oddball-20079@post-2017-05-08",
   "gameId": "king-oddball-20079",
   "displayName": "40 levels and a bunch of translations added!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2017-05-08T10:51:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Puny hunams! King Oddball now features 40 new levels, previously only available in the Xbox One version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "The game has also been translated to German, Russian, Simplified Chinese, and Traditional Chinese. We welcome feedback on these translations, and in fact we're aware of a couple of missing glyphs in the Chinese translations. It'd be great to hear from native speakers of these languages how you'd translate those bits!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
