  {
   "id": "beach-invasion-1944-228204@1.02",
   "gameId": "beach-invasion-1944-228204",
   "displayName": "Update 1.02",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-01-06T18:44:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "First update of the year 2023 is here! We are planning some big things for 2023 but for now we bring you the first update which deals with some of the known issues, also with some language updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam community items added! (trading cards, badges etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Waves don't end abruptly any more",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Poison gas upgrade does no longer decrease penetration power of shells",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Japanese language updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Italian language added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some minor bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
