  {
   "id": "beach-invasion-1944-228204@major-2024-04-12",
   "gameId": "beach-invasion-1944-228204",
   "displayName": "Major Update for Beach Invasion 1945-Pacific: New Maps and more!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-12T16:57:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Beach Invasion fans, today we announce the first major content update for Beach Invasion 1945-Pacific!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this content update, Beach Invasion 1945-Pacific gets two new playable maps, Peleliu for the Japanese and Attu, Alaska for the Americans. The update also introduces:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New weapons for each map, Type 11 LMG for Peleliu, M45 Quadmount and M3 Stuart for Alaska",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Two new enemy types for each map, DUKW(Amphibious Truck) and Seep(Sea Jeep) for Peleliu, and Fu-go balloons and Type-2 Ka-mi amphibious tanks for Alaska",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The new M45 Quadmt. also replaces one of the 6-inch guns in the Philippines map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GPU,CPU and memory optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New music",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New weather conditions in the Alaska map: snow and blizzard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Damaged trees can be broken in the Peleliu map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achivement system reworked: Wave completions changed: 10>5, 20>10, 50>20, 100>35, 200>50, 500>75, 1000>100",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other changes",
     "items": [
      {
       "text": "Supply box intervals increased to 45 from 30 for COOP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Siren sounds decreased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rocket trucks aiming and firing reworked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Plane health and speed reworked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Infantry movement reworked in the Philippines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Killcams fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weapon healths reworked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fog amount adjusted for each map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Landing crafts do not disappear immediately when going back",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ricochet chances increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Max FPS limited for resource consumption",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Aiming for weapons reworked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mouse sensitivity reworked",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Sound attenuation adjusted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
