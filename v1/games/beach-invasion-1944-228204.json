  {
   "id": "beach-invasion-1944-228204@1.01",
   "gameId": "beach-invasion-1944-228204",
   "displayName": "Update 1.01",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-07T11:16:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone, thanks again for your support and patience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we are happy to announce our first update for our game, addressing some of the immediate issues about the game according to the feedback we got from you:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now resume from where you left",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mouse invert axis added to the options menu",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can now scroll through weapons with the mouse wheel",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can now hide and unhide the hud (press h) to take more cinematic shots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted camera movement when switching between weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated German language and added Hungarian language",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the number and efficiency of the troops on our side",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Other bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
