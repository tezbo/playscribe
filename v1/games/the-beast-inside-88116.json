   "id": "the-beast-inside-88116@1.05",
   "gameId": "the-beast-inside-88116",
   "displayName": "Patch 1.05",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-12T14:49:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Beasts!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just release a new patch, and it's a game-saver for players on Intel processors! The update focuses on eradicating a persistent bug that has been causing game crashes, ensuring a smoother and more enjoyable gaming experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Beast Inside has just become a whole lot smoother and more beastly than ever before!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can always rollback to previous version of the game simply by clicking right mouse button on the game's title, select \"Properties\", then select \"Betas\" and from the \"Beta Participation\" select version 1.03",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
