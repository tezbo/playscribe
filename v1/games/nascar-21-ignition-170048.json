  {
   "id": "nascar-21-ignition-170048@major-2022-10-06",
   "gameId": "nascar-21-ignition-170048",
   "displayName": "22 Season Update Available Now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-06T13:21:50.000Z",
   "notes": [
    {
     "title": "NASCAR 21: Ignition - 22 Season Update includes",
     "items": [
      {
       "text": "2022 NASCAR Cup Series racetracks from both the regular season and playoffs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The 2022 lineup of drivers, teams and paint schemes have been directly pulled from the 2022 season, providing players with the most up-to-date version of the sport.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Ignition update also sees the addition of all three Next Gen car models from Chevrolet, Ford and Toyota, playable on every NASCAR track.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Refreshed user interface elements, making navigation of menus and settings more seamless.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An upgraded HUD has also been developed with all new tire wear and fuel indicators to closely monitor the real-time status of the car’s condition while racing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Newly-recorded broadcast introductions from Motor Racing Network’s On-Air Announcer, Alex Hayden, will be featured throughout",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Fanatec wheel support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Front end stability improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Multiple idling crashes/hangs in race",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Options menu volume slider inconsistencies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed AI having headstart on certain tracks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where contigency textures stay upon starting new car",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where car engine audio can go silent",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed situations where cars would not enter pit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed AI cars slowing down on certain tracks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved handover from AI to player control on race restarts from caution",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved Quaification session player starting position",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed road collision gaps on certain tracks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
