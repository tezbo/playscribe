  {
   "id": "nascar-21-ignition-170048@1.4.1",
   "gameId": "nascar-21-ignition-170048",
   "displayName": "Update 1.4.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-01-25T10:01:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Added Stages in Career and Race Now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added Private Party sessions for groups of 6-18 in Online Multiplayer. Players outside of your Party will not be able to join a Private Party session.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added brief period of AI control to player cars during start of Online races to prevent crashes at start of race",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Implemented corner cutting penalties in Online and Offline game modes (Offline requires enabling NASCAR Rules)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue that caused the player car to be damaged at the start of a Practice session",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For additional information and the full patch notes, please go to: https://support.nascarignition.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
