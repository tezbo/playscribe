  {
   "id": "nascar-21-ignition-170048@1.25",
   "gameId": "nascar-21-ignition-170048",
   "displayName": "Update 1.25",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-11-18T10:00:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added support for additional Wheels and added Wheel button functionality for in game actions such as Pit Menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added AJ Allmendinger to the driver roster",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added initial implementation of “ghosting” feature to Online play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved sensitivity of Yellow Flags, especially on Speedways",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted the AI to better handle large obstacles on track such as accidents involving multiple cars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the autopilot to be able to drive the player car with a burst tire when in the pit road",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue that could cause UI prompts to disappear when the player chooses to restart a race while holding the Datapad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "For additional information and the full patch notes, please go to: https://support.nascarignition.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
