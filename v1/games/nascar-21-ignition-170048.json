  {
   "id": "nascar-21-ignition-170048@1.5.1.0",
   "gameId": "nascar-21-ignition-170048",
   "displayName": "PATCH 1.5.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-23T09:01:58.000Z",
   "notes": [
    {
     "title": "CARS & SCHEMES",
     "items": [
      {
       "text": "Fixed an issue for Career Mode where players were appearing under their car",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where anti-lock brake system was stuck on",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where sponsored logo’s light was heavily reflected on the cars while on track",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "TRACKS",
     "items": [
      {
       "text": "Fixed an issue with the lighting at some of the night race tracks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "PIT STOPS",
     "items": [
      {
       "text": "Fixed an issue in which high assists caused difficulties while pitting at certain tracks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "AI",
     "items": [
      {
       "text": "Fixed an issue in which the AI are driving off the apron and cutting corners short at Homestead",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in which AI takes control of a user’s car when passing next to the pit stop entrance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI",
     "items": [
      {
       "text": "Fixed an issue that showed miscellaneous stats incorrectly for stages in standings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in which a quick selection of options from the Garage Pause Menu would trigger a softlock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that would cause the title to crash while being idle in Race Results screen at COTA after unlocking the “Road Course Ringer” and “Winner” trophies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
