  {
   "id": "city-of-springs-217219@patch-2025-02-07",
   "gameId": "city-of-springs-217219",
   "displayName": "First Patch & 100% POSITIVE review rating!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-07T16:01:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "At this very moment, City of Springs has been released for exactly one week and I'm absolutely thrilled to read all the positive reviews that are coming in!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "To all the wishlisters, this is the moment to get the game cheap!",
     "items": [
      {
       "text": "However the work has just started and I'm gearing up to release Patch 1 (RC 1.05), with:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated to Unity 6 (watch the video at the top for more info on this!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many small quality of life improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Massive performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved draw distance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved loading speeds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved texture streaming",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Decreased memory usage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated to FSR 3.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated to DLSS 3.10: Just got a few days of Q&A testing left and then I will launch the patch!: In the meantime, have fun playing City of Springs!: Dominic",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
