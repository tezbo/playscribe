   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have just launched the second patch for Elex II on steam rest of PC platforms should follow shortly.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Patch notes are as follows -",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added alternative game camera",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug in certain quest with Crane",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bugfix for Skyands boss Haraac could not be found",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfixes for certain NPCs, who could not find their way, like Skibor",
       "ps5ProOnly": false,
