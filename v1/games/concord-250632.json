 "releases": [
  {
   "id": "concord-250632@major-2024-09-03",
   "gameId": "concord-250632",
   "displayName": "An Important Update on Concord",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-03T16:18:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Concord fans — we’ve been listening closely to your feedback since the launch of Concord on PlayStation 5 and PC and want to thank everyone who has joined the journey aboard the Northstar. Your support and the passionate community that has grown around the game has meant the world to us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "However, while many qualities of the experience resonated with players, we also recognize that other aspects of the game and our initial launch didn’t land the way we’d intended. Therefore, at this time, we have decided to take the game offline beginning September 6, 2024, and explore options, including those that will better reach our players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While we determine the best path ahead, Concord sales will cease immediately and we will begin to offer a full refund for all gamers who have purchased the game for PS5 or PC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Steam Store will refund players who bought the game over the coming days. Steam will send confirmation of the refund once it has been processed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Once refunded, players will no longer have access to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ll keep you updated and thank you again to all the Freegunners who have joined us in the Concord galaxy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
