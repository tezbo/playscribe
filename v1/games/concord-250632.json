  {
   "id": "concord-250632@post-2024-08-21",
   "gameId": "concord-250632",
   "displayName": "Patch Notes - 08/21/2025",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-08-21T18:10:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Freegunners!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you're enjoying your time out in the Wilds! We just deployed a patch to fix a few things, but you may need to restart your game before queuing up again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Summary",
     "items": [
      {
       "text": "Matchmaking bug fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphics fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Solo Play Training progression fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "In-game Issues",
     "items": [
      {
       "text": "There was a chance that you would not be able to exit that state when cancelling matchmaking. This has now been addressed, and you should be able to cancel matchmaking normally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also addressed an issue impacting visibility of the first player body under some circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Solo Play",
     "items": [
      {
       "text": "Fixed an issue in training where players could not progress past the Teo section under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Matchmaking",
     "items": [
      {
       "text": "Players should now be able to cancel matchmaking without getting stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Known Issues",
     "items": [
      {
       "text": "There is a known issue that occurs when you restart the client, and you may need to re-equip your customizations. Your customizations have not been lost. This is currently under investigation for a fix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
