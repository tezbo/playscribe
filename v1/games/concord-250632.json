  {
   "id": "concord-250632@post-2024-08-25",
   "gameId": "concord-250632",
   "displayName": "Patch Notes - August 25",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-08-25T18:10:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Freegunners!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you're enjoying your time out in the Wilds! We just deployed a patch to fix a few things, but you may need to fully restart Steam to download this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay Changes & Tuning",
     "items": [
      {
       "text": "Made changes to Rivalry modes – Reduced level for entry and added bonus XP rewards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "PC Issues",
     "items": [
      {
       "text": "Improvements to mitigate performance degradation over long periods of gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's all from us for now, and we'll see you out in the Wilds!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
