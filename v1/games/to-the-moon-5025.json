  {
   "id": "to-the-moon-5025@post-2023-03-22",
   "gameId": "to-the-moon-5025",
   "displayName": "Missing old Save Files' location",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-03-22T15:15:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In updating to the new and more stable build (ironically), the location of save files for some localizations may be changed. To get your saves back, you can move the files like this:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Go to C:\\Users\\\\AppData\\Roaming",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Your old saves are in the folder \"To the Moon\". Copy paste all files into the folder \"To the Moon - Freebird Games\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For other potential issues (e.g. Achievement unlocking), please see Troubleshooting thread here. Thanks for your patience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
