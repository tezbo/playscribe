  {
   "id": "exo-mayhem-312143@major-2024-09-12",
   "gameId": "exo-mayhem-312143",
   "displayName": "Quality of Life Update Out Now",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-12T20:01:14.000Z",
   "notes": [
    {
     "title": "This update has the following changes",
     "items": [
      {
       "text": "Azerty Keyboard support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved gamepad support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Animations related to weapons have been sped up to feel more responsive to controls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Robbing stores outside of missions now earns you more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rampage missions now give you more score per kill, this should make it easier for new players not in sandbox mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fix on menus where input would be disabled after closing via a hardware button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "sprinting is now a toggle instead of hold for gamepad users.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some bug fixes for mission progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When trying to open a time portal, if not on level ground UI will appear letting you know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Main menu now has tooltips for the different modes, just hover over them to know more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Death menu now has a voice acting line to it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Holes have been patched in the cave biome.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
