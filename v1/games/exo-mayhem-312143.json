  {
   "id": "exo-mayhem-312143@hotfix-2026-03-06",
   "gameId": "exo-mayhem-312143",
   "displayName": "February HotFix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-03-06T18:49:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update fixes some older issues that have not been addressed in prior patches due to technical issues with the project that previously existed and could not be resolved at the time, resolves UI bugs/design quirks mentioned in a few reviews, improves the speed of text dialogue appearing, and updates controls to feel a bit better on both mouse and Gamepad.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Additionally, the controls pop-up on your HUD is now context sensitive for what you can currently do gameplay-wise to prevent control confusion, and all localization languages are supported as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I am committed to working through bugs that users report either through steam, discord, email, or anywhere else that is easiest for players to reach me.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
