  {
   "id": "exo-mayhem-312143@major-2025-02-10",
   "gameId": "exo-mayhem-312143",
   "displayName": "Balance and Gamepad Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-10T21:10:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update focuses on balancing, controller support, and other quality of life improvements, Here are the patch notes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Directional damage indicators now show from where you got hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Melee will now lock onto the nearest target.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ai Enemies can no longer shoot as far giving you time to get away.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Police helicopters should follow you now if you are wanted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Controller",
     "items": [
      {
       "text": "A new lock on aim assist feature has been added when you ADS(Left trigger).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Controls have been slightly reworked to feel better. Be sure to check the controls HUD to see what changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Using the gamepad in menus and UI should be more stable now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Look sensitivity has been improved for gamepad users.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sprinting is now a button hold not a toggle on gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue where returning to the chrono station would not trigger when you walk through the portal.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where grenades would explode on spawn hitting the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with rocks in specific parts of the level not spawning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where medium settings were incorrectly applied as low settings. Be sure to apply your settings again if you were using anything under high settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI",
     "items": [
      {
       "text": "Made the cursor slightly larger and it should now scale properly with different screen resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Performance",
     "items": [
      {
       "text": "Fixed an issue with stuttering from the level streaming loading in objects on hard drives and lower end devices when flying at top speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you to everyone who has left feedback so far, hearing your suggestions and bug reports helps make the game better for everyone. if you left a review regarding controller issues please consider updating your review with this new update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
