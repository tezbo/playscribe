  {
   "id": "exo-mayhem-312143@major-2025-01-07",
   "gameId": "exo-mayhem-312143",
   "displayName": "The Apocalypse Update Out Now",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-07T23:02:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This is the first major update of 2025 for Exo Mayhem, featuring new content, improved lighting, improved performance(2x faster), and a lot more. See the full patch notes below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Lighting",
     "items": [
      {
       "text": "Updated lighting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fog has been improved in Paradise Mall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New lighting and look for the Chrono Station.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Added a new Zombies mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Aim acceleration has been added to improve aiming feel on controllers and mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Completely redesigned main menu with game mode selection and a social/news feed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New game mode \"New Game\" renamed to Progression Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can now shove NPCs and zombies by running into them at full speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue where moss appeared on characters and was glitchy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Police no longer attack after you are safe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed dialogue quips playing even if dialogue volume was set to 0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "HUD position no longer changes unexpectedly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Environment",
     "items": [
      {
       "text": "Added buildings to Paradise Mall to enhance the city atmosphere.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New graphics for Red Death Mall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a downtown background vista to Paradise Mall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved soundscapes in Paradise Mall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "Improved NPC performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Higher detail LODs on characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added controller vibration support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Heroic music now plays when flying, ambient music when running with thrusters, and combat music when wanted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Birds now fly in the sky inside the jungle biome.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NPCs spawn farther from the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated post-processing for higher visual fidelity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Damage effect appears on-screen when hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Blood effects and heartbeat sounds occur when health drops below 30%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Waterfall now splashes water on-screen when passing through it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Speed lines added for flying or thruster running.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced spatialized audio.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added slow-motion effect when getting a kill (40% chance with weapons, 100% with laser swords).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "All weapons and their tiers have been significantly buffed; early-game enemies are no longer bullet sponges.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved police AI; they now shoot during every reposition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Destroying stores now increases your wanted level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Police now deploy a helicopter when you are wanted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Flamethrower now supports fire propagation for extended spread.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several performance improvements across all levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
