  {
   "id": "exo-mayhem-312143@major-2025-07-15",
   "gameId": "exo-mayhem-312143",
   "displayName": "Aura Farming And Story Update Out Now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-15T01:21:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update addresses several review criticisms, adds a new 4-8 hour story mode, and a character redesign for all skins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Content",
     "items": [
      {
       "text": "All missions have been reworked into a guided story set across Paradise Mall and the Chrono Station.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sandbox Mode no longer has missions—only Free Roam. Story Mode contains all missions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "All missions have new music for consistency and to help maintain a cohesive feel. The previous music, from a royalty-free site, was used in other game trailers and didn’t fit the game’s theme, so custom music was created.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Weapon and power unlocks have been integrated into Story Mode to make progression more intuitive and encourage trying different weapons and powers beyond the starter ones.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Wave-fighting missions have been adjusted to be less repetitive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You now earn 3–4x more money per mission than before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Performance",
     "items": [
      {
       "text": "FPS should increase by 30–100% for all users. I went from 55 FPS to 90+ FPS on average.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Deck and similar handhelds should now be able to play the game at higher settings and maintain above 30 FPS consistently. Desktops should easily run above 60 FPS.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Replaced FSR and DLSS with Unreal Engine TSR for better platform compatibility and to keep the engine up to date.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Flight has been reworked based on feedback, with new heroic animations and improved controls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shooting should feel more consistent across all weapons, with better hit detection and more impactful damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The menus now have better support for gamepads, specifically the Weapon and Power wheel, which should see significant improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Character controls on gamepad have been tightened and made more fluid, with features like tap-to-sprint (previously required holding), improved aiming, and more responsive button placement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera shakes have been remade across the board and adjusted to reduce nausea while increasing immersion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The camera now operates on a dolly system, similar to how movies are filmed, for a more realistic and smoother feel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cape physics and other cloth physics have been added to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes and QOL Changes",
     "items": [
      {
       "text": "Slight reverb was added to the world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added extra layers to the soundscapes in Paradise Mall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced loading times by 3–6 seconds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with shadows flickering on moving trees caused by overlapping leaves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added music to the main menu for a better intro feel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where scroll menus did not work with gamepads.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the gun-out animations to look more consistent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with delivery missions where the item would clip through the ground or hover above it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where quickly switching between weapons would cause the HUD to break.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
