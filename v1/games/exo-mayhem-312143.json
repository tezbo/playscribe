  {
   "id": "exo-mayhem-312143@major-2026-01-28",
   "gameId": "exo-mayhem-312143",
   "displayName": "UI and Localization Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-28T22:11:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Guys,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update aims to address some issues with the main menu and settings menu that had caused confusion among new players, along with updating the dialogue code to be instant for the campaign(previously called story mode).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Exo Mayhem is now 1.5 years old and so I will not be paying for real-time dialogue generation anymore, it will be entirely prebaked so all players will get the same dialogue for the campaign with this update. The story and content remains the same though. Given the game now has multiple hours worth of content and is in a good state, updates will likely move to small bug fixes or minor design issues(like menu text confusion) when users report them to me and I can reproduce the issue. If you do run into an issue I am open to feedback, all I ask is that it remain civil.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
