  {
   "id": "exo-mayhem-312143@hotfix-2026-03-27",
   "gameId": "exo-mayhem-312143",
   "displayName": "March HotFix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-03-27T20:30:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey guys,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update fixes an issue in the tutorial with the skin selector being available too early, and the new contextual system from the last update, causing UI issues with unlocks in the story mode for players with older save data.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Over the next few months, we aim to update the onboarding process further, but will likely do smaller updates like this one to ensure game analytics show the changes are healthy and not causing confusion. Analytics showed the early game design was too confusing and caused the game to feel clunky, so we want to be careful while addressing those issues players kept running into.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
