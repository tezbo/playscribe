  {
   "id": "exo-mayhem-312143@patch-2025-03-06",
   "gameId": "exo-mayhem-312143",
   "displayName": "DLSS 4 and FSR Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-03-06T22:30:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "DLSS 4 and FSR has been added. for GPUs that support it you can use up to 4x Multi-Frame Gen. the game will auto detect which mode is best suited for your PC. This should help giving you extra performance.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Other Quality of life updates have been added as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
