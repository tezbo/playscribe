  {
   "id": "exo-mayhem-312143@patch-2025-02-17",
   "gameId": "exo-mayhem-312143",
   "displayName": "QOL Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-17T22:49:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some users suggested improving these things, so I added them to this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "1. The gamepad and mouse sensitivity have been increased to give a faster feel. You can still adjust them in the settings to further refine your preferences.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "2. Fixed an issue where if you got close to a target with the lock-on system your camera would spin.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Added new tips and fixed some typos in the loading screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Improved the positioning of the aim assist, it should now target the torso and not the waist of enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Fixed a bug where the lock-on system would work through store walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
