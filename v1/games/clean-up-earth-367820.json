  {
   "id": "clean-up-earth-367820@major-2025-11-25",
   "gameId": "clean-up-earth-367820",
   "displayName": "Charming cleaning sim Clean Up Earth gets demo update with new features today",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-25T15:54:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new version of the Clean Up Earth demo is now live on Steam, introducing multiple features and improvements inspired by early player feedback. This update expands gameplay depth, narrative elements and overall ease of play ahead of the upcoming Kickstarter campaign.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The game will also be featured in the Best Indies Showcase next month, and in week two of the forthcoming Jingle Jam via a special activation in support of Jingle Jam’s charity partner, WWF.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What’s new",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Companion Drone: A friendly helper that assists players by spotting and cleaning waste.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crafting & Reconstruction: Gather, manage and combine resources to restore structures and unlock new areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A New Map: playable by up to 10 players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quantum Memory: A new mechanic that lets players visualise past buildings and human activity in the environment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More Complex Level Design: Environments have been redesigned with richer layouts and exploration paths.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NPCs & Dialogues: An NPC with voiced lines now introduces key mechanics and enhances world-building.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wildlife: A few first species will return to repopulate restored areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhances tutorial: A smoother, clearer onboarding experience across four short lesson maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Expanded Character Customisation: More detailed options, including hair and clothing styles and colours.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Performance Improvements: Better frame rate and overall optimisation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Localisations: The demo is now available in Chinese, Japanese, Korean, Brazilian Portuguese, Russian, Polish, Dutch and Czech.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Player Interaction: A new whistle mechanic to communicate with others.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Debug & General Fixes: Additional stability and quality improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you'll enjoy the experience! Share your feedback on our Discord",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
