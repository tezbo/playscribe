  {
   "id": "clean-up-earth-367820@1.00.06",
   "gameId": "clean-up-earth-367820",
   "displayName": "Update 1.00.06",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-04-08T18:19:34.000Z",
   "notes": [
    {
     "title": "A new update fixing certain bugs has been released",
     "items": [
      {
       "text": "Added a respawn button in the pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed UI framing issues for the association panel at certain resolutions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed text overflow issues for some objectives",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Turbo boost time no longer increases during pause",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The UFO can now be picked up in solo mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Gadgets and attachments are now always shared in multiplayer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Debris stuck inside walls have been moved outside (desert map)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "To be noted, the game is now playable in co-op cross-platform with consoles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "New improvements, content and features coming soon, stay tuned",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
