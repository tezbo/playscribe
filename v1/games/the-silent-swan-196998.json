  {
   "id": "the-silent-swan-196998@0.8.4",
   "gameId": "the-silent-swan-196998",
   "displayName": "Update 0.8.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-15T15:57:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are ecstatic about the incredible amount of feedback we have been receiving lately, and we would like to thank you all for it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As promised, we continue to work hard to improve the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As such, here is the first batch of changes and corrections. This is the changelog:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixed",
     "items": [
      {
       "text": "Quicycles cannot be interacted with",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tree and vegetation popping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hanan elevator has no sound",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In road parkour it is not possible to go back up easily due to collision errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Neuron Box door cannot be opened (partial fix, still researching for bugs)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some postprocessing not working as intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Transition fading with Selene sometimes do not trigger when it should",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Improved",
     "items": [
      {
       "text": "Player now jumps slightly higher",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changed",
     "items": [
      {
       "text": "Gamepad control for jump rebinded from A (XBOX) / X (PS) to B (XBOX) / O (PS)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "That is all for now, we keep working, see you Beyond the Walls!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
