  {
   "id": "the-silent-swan-196998@1.2",
   "gameId": "the-silent-swan-196998",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-10T15:27:31.000Z",
   "notes": [
    {
     "title": "The latest The Silent Swan update is now available!",
     "items": [
      {
       "text": "This update mainly fixes the recurrent low texture quality throughout the game alongside the following minor bug fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“The Belltower” achievement can now be obtained, requiring to ring the bell atop the belltower.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Lost in the Woods” achievement has been fixed, requiring to reach the Verdurant Lair (Shaman’s lair).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“The Last Road” achievement has been fixed, requiring to walk through the gates of the Unseen Complex.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“The Bells of Kavrazyma” achievement has been fixed, requiring to interact with 10 different bells.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Notebook is now disabled during the opening sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected low quality textures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "City props added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected sounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Programming changes of some achievements, now they are easier to get.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
