  {
   "id": "the-silent-swan-196998@0.8.5",
   "gameId": "the-silent-swan-196998",
   "displayName": "Update 0.8.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-17T12:32:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We continue to work hard to improve the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As such, here is the next batch of changes and corrections. This is the changelog:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixed",
     "items": [
      {
       "text": "Music reset its volume after looping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Start music volume is too low",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Improved",
     "items": [
      {
       "text": "Optimized some props in the main road and Hanan",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upgraded some Hanan wires for better comprehension",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changed",
     "items": [
      {
       "text": "Moved hanan's electric cabin to avoid being overlooked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That is all for now, we keep working, see you Beyond the Walls!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
