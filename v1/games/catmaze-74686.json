  {
   "id": "catmaze-74686@post-2018-12-09",
   "gameId": "catmaze-74686",
   "displayName": "Faster, Better, Faster!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2018-12-09T15:08:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here goes Catmaze 1.06!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's the most serious update I made. What's new?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Character's speed is now much faster",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Character's physics improved. That made controls less \"clunky\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed jumping system near the edge of the platforms. Now the player have a possibility to jump a few moments after Alesta begins to fall. That makes the character more responsible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Screens changes three times faster from this moment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug when Alesta stuck in the chests",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a few more minor issues: I'm still working on Catmaze, so feel free to report about any bugs you find - I want to make this game as good as possible!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
