  {
   "id": "fantasy-aquarium-319878@1.21",
   "gameId": "fantasy-aquarium-319878",
   "displayName": "Update 1.21",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-17T09:54:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1. The sorting function of fish tank details has been upgraded. After all functions are sorted, the same fish will be distributed together.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. The new interface novice guide includes basic settings and game tutorials. Players can open it again in Settings->More->Tutorial.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. The boss lady added a \"starry eyes\" animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. A new function has been added to the fish ticket purchase interface. Click the pre-order number button to \"one-click maximum\" function.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Optimize the boss lady investment house.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
