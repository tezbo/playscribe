  {
   "id": "fantasy-aquarium-319878@1.2",
   "gameId": "fantasy-aquarium-319878",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-23T06:57:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1. Updated new gameplay: Boss Lady's Investment House. Enter the store and click on the Boss Lady. Players can invest gold coins and the Boss Lady will give you rewards! ~",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Added 32 new colorful fish. Try clicking on the new fish!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PS: The new fish added in this update can only be obtained in the Boss Lady's Investment House and will not be counted in the full picture book achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
