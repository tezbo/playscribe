   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-23T08:29:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "* Adjusted the growth and revenue values of some fish, reducing the cost of unlocking new fish tanks in the early game to help players get through the early stages faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* The one-click selling button has been changed to a hold-to-sell button with a footnote indicator to prevent players from accidentally selling fish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Then I will show you the subsequent fish box O(∩_∩)O",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
