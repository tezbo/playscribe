  {
   "id": "rule-no-1-146645@02",
   "gameId": "rule-no-1-146645",
   "displayName": "Update 02",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-12-11T12:07:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Check out these changes",
     "items": [
      {
       "text": "A new game mode has been added!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bouncy Bois Only. A more relaxed style game mode, see just how many waves you can survive of: just these guys coming at you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2 new weapons have been added!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Aunt Rhody (Musical Grenade Launcher).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Winchester Lever Action Rifle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Info buttons detailing the basics of each mode have been added to level select.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All game modes now begin with 3 Red Reward Boxes instead of only 1 from the previous builds!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New functionality for an image gallery has been added and (hidden) in the main menu for an on-demand look at the wonderful art from the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A (rather spicy) new death screen has been added and the previous (3) versions are now viewable in the image gallery.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Coming Soon game mode buttons have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Credits and Acknowledgements have been added.: That's it for now! Thank-You, so much, to everyone that has supported the game thus far and there is so much more where this came from!: See you on the Grid, Users!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Oddkins: : )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
