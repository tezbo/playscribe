  {
   "id": "rule-no-1-146645@1.5",
   "gameId": "rule-no-1-146645",
   "displayName": "UPDATE 1.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-04-05T20:30:53.000Z",
   "notes": [
    {
     "title": "We're finally here",
     "items": [
      {
       "text": "-- 2 new game-modes and leaderboards (Zombies and You Miss, You Die).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- 1 new weapon (AK-47).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- 1 new reward image (Sleepy Rule).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- Gameplay changes (Weapons are all available at the start and auto-cycle).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- Controller support (Partial).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- Game functions now bindable to the mouse (accessibility).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-- Recoil and camera motion changes (Not so spazzy, really pulled back or eliminated).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- Removed the sprint function and sped up Rule's default movement speed to the old sprint speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- HUD changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- Sprint recharges much faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- Fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We REALLY hope that you enjoy this one! Please tell your friends about the game (if you can) and go to the community hub or the discord if you need to reach us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Whew! Now back to work on Rule No. 2!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- Oddkins, Director, Walk Without Rhythm Games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ": )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
