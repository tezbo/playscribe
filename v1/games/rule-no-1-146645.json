  {
   "id": "rule-no-1-146645@1.2",
   "gameId": "rule-no-1-146645",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-12T22:36:18.000Z",
   "notes": [
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Sound Effects should now be properly calibrated to the Sound Effects controls. Wohoo!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "SteamVR should no longer try to load upon launching the game. OUT, OUT DAMN SPOT!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug to do with the God Stilettos seizing up. Fingers crossed on this one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the player's save data would not load properly and lock them out of playing new versions. I hope that this also has an effect for folks who had black screens when selecting a game-mode.: As always, Take Care and let us know if anything breaks!: -- Oddkins, Director, Walk Without Rhythm Games.: : )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
