 "releases": [
  {
   "id": "strategic-mind-the-pacific-113330@4.00",
   "gameId": "strategic-mind-the-pacific-113330",
   "displayName": "UPDATE 4.00",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-08-28T17:00:10.000Z",
   "notes": [
    {
     "title": "Hello, guys!",
     "items": [
      {
       "text": "This is an update dedicated to the Strategic Mind: Spirit of Liberty release later today. It includes all the fixes and improvements we did to the core mechanics while working on Strategic Mind. This is just one in a series of updates aimed at polish and post-launch support of the entire series.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we addressed one of the series issues that was especially noticeable if you own all Strategic Mind titles - we reduced the disk space required for all games in the series. So, now it is easier to store them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update 4.00",
     "items": [
      {
       "text": "The game now requires significantly less disk space (Before 42.3 GB | Now 27.2 GB)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed various bugs while working on Strategic Mind: Spirit of Liberty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some localization errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "More fixes to come soon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Non-exhaustive list of fixed issues",
     "items": [
      {
       "text": "Bug with “flying” Recon unit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "3rd equipment slot abuse for some units.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The torpedo sound could still be heard when the volume is at 0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Units not getting extra EXP for capturing enemies that could not retreat due to various reasons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Units keeping bonus from aura effects, even if the UNDO button returned the aura-giving unit away from them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Abuse that allowed to return units to Reserve outside of the Deployment area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The crash caused by the illegitimate equipping of units outside the Service Zone (Which was possible due to a UI bug).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "All other Strategic Mind titles are also receiving a similar update today.",
     "items": [
      {
       "text": "You can expect more updates and quality-of-life improvements as we keep polishing the series and provide post-launch support for Strategic Mind: Spirit of Liberty and other titles. All relevant improvements will be delivered across all titles of the Strategic Mind series, as always.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With best regards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Starni Games team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
