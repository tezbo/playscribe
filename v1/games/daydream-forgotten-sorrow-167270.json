  {
   "id": "daydream-forgotten-sorrow-167270@1",
   "gameId": "daydream-forgotten-sorrow-167270",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-26T10:58:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello dreamers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been a while, and we're excited to share our first update. Here's what we've improved:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Better Camera Review",
     "items": [
      {
       "text": "We've made significant improvements to the camera review, resulting in higher quality and clearer visuals. Capturing moments is now more satisfying than ever.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Simplified Challenging Areas",
     "items": [
      {
       "text": "We've streamlined some of the difficult and hard-to-navigate sections, making gameplay smoother. Now, players can progress through these once tough obstacles with ease, ensuring a more enjoyable and seamless journey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Enhanced AI Characters",
     "items": [
      {
       "text": "We've given Birly and Mira, our lovely characters, notable enhancements. The AI has been refined, bringing more depth and realism to these lovable characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So, brace yourselves, gamers! Get ready to explore a world filled with wonder, danger, and secrets waiting to be uncovered. Will you help Griffin and Birly on their quest? The adventure starts now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
