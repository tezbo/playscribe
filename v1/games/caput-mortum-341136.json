  {
   "id": "caput-mortum-341136@0.2.3",
   "gameId": "caput-mortum-341136",
   "displayName": "Update 0.2.3",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-04-25T17:41:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Big thanks to the people who have shared the issues they encountered with us. If you enjoyed the demo, please write us a review on the demo page :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's what's been fixed and added in version 0.2.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disabled the item drop action while using a weapon or holding healing herbs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Homunculus now has more health and says, \"Copy my hand\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Homunculus now shoves the player away while giving the tutorial. Fixed a few other issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reworked the game initialization process when resuming from a game over and/or from the title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Normal doors don't play the web sound effect when attacked anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
