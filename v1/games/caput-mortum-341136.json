  {
   "id": "caput-mortum-341136@0.2.4",
   "gameId": "caput-mortum-341136",
   "displayName": "Update 0.2.4",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-05-01T19:57:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here are the changes in version 0.2.4!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made the homunculus' hand game more forgiving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a caption when you're full on healing herbs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Game Over sting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New keyboard only option. Moved sheathe/unsheathe to R.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Rework of the control's code and the settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaks to the post-processing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a lighting issue in the Living Quarters.: I also updated the game's manual! You can download it from the store page :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
