  {
   "id": "caput-mortum-341136@0.2.6.1",
   "gameId": "caput-mortum-341136",
   "displayName": "Update 0.2.6.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-12T00:27:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here are the changes in version 0.2.6.1!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "NEW SETTING OPTIONS",
     "items": [
      {
       "text": "If you are easily motion sick, you can now disable all camera shakes in the options menu!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The FOV can now be set from 80° to 110° in the options menu. We recommend keeping the default of 90° if you can.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "BUG FIXES",
     "items": [
      {
       "text": "Moved a previously unreachable hiding spot for the homunculus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Attempted a fix for the rare occasion where dropping the cane in the Living Quarters would spam the notification sound effect. If you encounter this bug again, we would appreciate a detailed breakdown of how it occurred to you (control method, prior actions, hardware, etc.).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thanks a lot for the reviews and discussions you've all left! We are really proud of this project and we can't wait for you to experience the full thing later this summer ^u^",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
