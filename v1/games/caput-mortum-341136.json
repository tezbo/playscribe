  {
   "id": "caput-mortum-341136@0.2.6.2",
   "gameId": "caput-mortum-341136",
   "displayName": "Update 0.2.6.2",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-11T21:11:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here are the changes in version 0.2.6.2!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Localization",
     "items": [
      {
       "text": "Japanese has been added!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed a bug that removed player's input when timing an attack with the homunculus' dialogue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved uncrouch detection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a display bug with the dropping item tutorial when triggered before the crouch tutorial.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Progress on the main game has been going very well and we're super excited to see people's reactions to the new areas and enemies >:) We've also made a good amount of polishing and minor bug fixes in the full version, but didn't include them in the demo since it would require a lot of unnecessary time. However, please let us know if you come face to face with a very nasty bug!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
