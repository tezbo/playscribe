  {
   "id": "caput-mortum-341136@1.2.2.0",
   "gameId": "caput-mortum-341136",
   "displayName": "Update 1.2.2.0",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-03-18T16:33:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This tiny patch aims to solve the loading issue some players experienced, specifically when loading back into the Tunnels. I changed how the checkpoints save the level data, so hopefully that'll fix the issue!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any weird bugs, please let us know in the forums!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
