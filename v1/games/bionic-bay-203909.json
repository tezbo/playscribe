  {
   "id": "bionic-bay-203909@1.3.5.2",
   "gameId": "bionic-bay-203909",
   "displayName": "Patch 1.3.5.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-05T10:58:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Fixed an issue where the leaderboard displayed incorrectly the first time during special online levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that caused incorrect leaderboard rankings under specific conditions after uploading a score in special online levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed boundary issues and oversized checkpoints in some levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Removed the countdown timer display in special online levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "By the way, the special level Shuhei's Gauntlet is now live! Beat Shuhei Yoshida’s record to unlock his exclusive outfit!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
