  {
   "id": "bionic-bay-203909@1.3.4.1",
   "gameId": "bionic-bay-203909",
   "displayName": "Patch 1.3.4.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-02T13:08:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Adjusted several systems in online mode and added extra version checks for compatibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed checkpoint trigger ranges in certain levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed boundary issues in some levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue where enabling Chronolag under specific conditions caused the game to run slowly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue where manually selected ghosts in online mode did not update correctly in certain situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed various joystick connection-related errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
