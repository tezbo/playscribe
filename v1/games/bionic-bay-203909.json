  {
   "id": "bionic-bay-203909@1.3.2.3",
   "gameId": "bionic-bay-203909",
   "displayName": "Patch 1.3.2.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-22T09:27:33.000Z",
   "notes": [
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed a bug where deleting save data would reset progress toward achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various level boundary and camera issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Added Advanced Controls in the option menu:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new Spherical Gravity Controls setting, allowing players to choose between Screen Space (default) or Character Relative for movement direction control.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Large Hint Buttons option in Advanced Graphics options now also scales the size of the ChronoLag timer display, enhancing visual clarity on handheld devices like the Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
