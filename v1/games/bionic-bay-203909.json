  {
   "id": "bionic-bay-203909@1.3.3.3",
   "gameId": "bionic-bay-203909",
   "displayName": "Patch 1.3.3.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-23T09:20:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a bug where the unlocking condition check for the Omega achievement could be skipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Now, the game will check for the Omega achievement upon launch to compensate for missed unlocks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where resetting save data could cause issues with achievement tracking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We’ve identified that DirectX 12 may cause crashes on certain setups. This launch option has been temporarily disabled.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed boundary issues in some levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
