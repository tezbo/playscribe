   "announcedAt": "2023-01-04T17:58:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As always, we are listening to all feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The following list should be working",
