   "gameId": "togges-182117",
   "displayName": "Togges First Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-10T16:35:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are listening to all bug reports, and we are working to fix them ASAP, but keep in mind that we are an Army of Two™.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the first fixes (1.03.1)",
     "items": [
      {
       "text": "Adjusted some minor shaders problems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted some minor sound problems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "HUD showing white letter after returning from Mini Levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Steam Cloud Save compatibility",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Reduce Lens Flare intensity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hidden Seeds not appearing problem",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Endless Wall fruit count problem",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Carrot Cake problems (Horse/Fisherman/Dark Area/Race)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "For the achievements hunters out there: We are facing some problems with Steam Backend, but we are working on it :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Have a great weekend! ːsteamhappyː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
