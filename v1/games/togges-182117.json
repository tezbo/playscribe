  {
   "id": "togges-182117@post-2022-12-12",
   "gameId": "togges-182117",
   "displayName": "Steam Achievements",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-12-12T16:14:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Steam Achievements should be working now. Give it a try.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you were playing, don't worry, when you get to the world map, if you have completed the requirement, it will unlock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There are some with specific requirements that involve a specific action, if you have already done it, you will need to do it again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sorry for any inconvenience. ːsteamfacepalmː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's all for now! ːsteamhappyː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
