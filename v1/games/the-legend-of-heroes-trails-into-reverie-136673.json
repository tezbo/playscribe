  {
   "id": "the-legend-of-heroes-trails-into-reverie-136673@1.1.5",
   "gameId": "the-legend-of-heroes-trails-into-reverie-136673",
   "displayName": "Update 1.1.5",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-12-09T16:54:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "today we are releasing a patch for Trails into Reverie which improves how the game interacts with platform achievement APIs. This should prevent performance issues in some circumstances, specifically when a large number of achievements was already unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note that this issue surfaced due to changes in how Steam deals with repeated achievement API calls, and this change affects many of our prior releases in similar ways. We are committed to patching all affected releases, but this has taken some time, especially for cases where we need to re-build games for which we already archived various development resources.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman, PH3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
