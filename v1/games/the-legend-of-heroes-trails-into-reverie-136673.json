  {
   "id": "the-legend-of-heroes-trails-into-reverie-136673@1.0.5",
   "gameId": "the-legend-of-heroes-trails-into-reverie-136673",
   "displayName": "Update 1.0.5",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-07-19T12:46:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "we've resolved a few more issues in this update",
     "items": [
      {
       "text": "Fixed a short sequence during the ending scene playing with EN voices despite JP voice language being selected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The game now correctly uses the button rebindings selected for battle attack and battle move actions in all relevant circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a legacy script issue in the \"Intimate Moments\" minigame that prevented interaction during one particular question",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some stretching issues with ultrawide aspect ratio support in the \"Horror Coaster\" minigame",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the background of the battle target info screen being stretched in non-16:9 aspect ratios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a possible brief flicker when entering the gamepad rebinding menu from the pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Note that you can always revert to earlier versions of the game by selecting them in the Steam \"Beta\" menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
