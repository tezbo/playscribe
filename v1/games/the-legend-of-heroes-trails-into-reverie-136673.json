  {
   "id": "the-legend-of-heroes-trails-into-reverie-136673@1.1.4",
   "gameId": "the-legend-of-heroes-trails-into-reverie-136673",
   "displayName": "Update 1.1.4",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-03-26T17:01:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "it's here! This update includes all the localization improvements which are also available for other platform versions of the game, and we took this opportunity to improve the encoding quality of all English and Japanese voice files on PC.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Update English text, images and all other assets with various localization fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Re-balance English voice lines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improve encoding quality of all Japanese and English voice lines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improve support for Steam Dynamic Cloud Sync.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various other minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note that, primarily due to the increase in audio quality, this update increases the storage requirements of the game by roughly 2 GB.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While we expect this patch to improve the situations for all users, with the great variety of hardware and software configurations available on PC this is not always guaranteed in all circumstances. As such, you can return to previous versions of the game by selecting the any of the public \"version_*\" branches on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
