       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Add Japanese localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add Steam Deck support.: If you did not have leave a review already, please consider to do so. It helps me a lot :): Also if you like fast paced action shooter platformer game, consider add my next game to your wishlist, it will help a lot as well: Corebreaker: Cheers,: Marcel",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
