  {
   "id": "galaxy-champions-tv-108321@major-2020-10-19",
   "gameId": "galaxy-champions-tv-108321",
   "displayName": "Galaxy Champions TV - Golden Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-10-19T18:42:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Champions!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I would like to announce that Galaxy Champions TV \"Golden Update\" is available now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "40+ new upgrades.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Score system is back!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Global leaderboard: compete against other players from other platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Collection: collect all enemies and upgrades.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Difficulty levels: select difficulty before starting a run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Continue system: you have a limited amount of continues to beat the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Loop: in Champions mode you can loop the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Support more gamepad models.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Replaced the skill tree with 60+ upgrades to create more replayability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Replaced the revive system with shared continues in co-op mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced amount of arena in each world, it makes the progress more solid and direct.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed gamepad detection issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Vysnc and high frame rate issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Steam Cloud sync issue with Linux and Mac.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "It took longer than we expected but the update is finally here! Hope you enjoy it! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you very much everyone for the feedback, support and patience which made it possible for Galaxy Champions TV to get this far!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Have a great week!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Best regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "aQuadiun Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
