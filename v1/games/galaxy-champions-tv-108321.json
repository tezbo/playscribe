   "announcedAt": "2024-03-30T11:02:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been a long time! I just added a very small update. It is more for players that have Steam Deck and for Japanese players.",
