  {
   "id": "threaded-191001@major-2022-02-14",
   "gameId": "threaded-191001",
   "displayName": "Valentine's Day Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-02-14T02:21:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Happy Valentine's Day! Celebrate with 8 more Threaded puzzles in this new update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you like Threaded, you will also love I Love Finding MORE Cats! It is a classic hidden object game where you can collect MORE adorable cats as you visit different locations, solve puzzles, and play minigames!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "You can get it here",
     "items": [
      {
       "text": "We also recently launched a classic hidden object game,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Faircroft's Antiques: The Forbidden Crypt! Search through gorgeously rendered locations, breathe new life into a collection of antiques, and discover the secret that lies in the crypt of Porto Nacosti!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Coming Soon: First time in Paris! In this hidden object game, join amateur travel blogger Kate Robinson and her daughter Nicole as they go on their first big business trip to save a Parisian hotel!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add First Time in Paris to your wishlist now! https://store.steampowered.com/app/1767150/First_Time_in_Paris/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
