  {
   "id": "motogp-24-291932@patch-2024-05-20",
   "gameId": "motogp-24-291932",
   "displayName": "New patch released!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-20T07:44:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Our latest MotoGP™24 patch updates Moto2™ and Moto3™ for the 2024 season, along with other fixes to enhance the racing experience. Read the patch notes below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▪️ Riders & Bikes of the Moto2™ class has been updated to the latest changes of current season",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▪️ Riders & Bikes of the Moto3™ class has been updated to the latest changes of current season",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▪️ Skills of the riders of every category have been updated to better match real championship results",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▪️ Fixed a problem with rider suits in podium cut scenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▪️ Most of the Circuits have been updated with 2024 new sponsors layout",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▪️ Minor fixes to A.I. on Lusail & Chang",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▪️ Minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
