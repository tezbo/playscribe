  {
   "id": "among-ashes-258510@1.1.5",
   "gameId": "among-ashes-258510",
   "displayName": "Update 1.1.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-04T08:48:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This version of Among Ashes includes the option to access the Night Call main menu from the pause menu, allowing you to switch between different Night Call save slots at any time without having to die.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This will hopefully solve some issues where due to some rare bugs (which I'm still trying to squish) players can end up stuck and unable to complete the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I hope this helps!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
