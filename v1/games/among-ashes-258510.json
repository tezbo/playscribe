  {
   "id": "among-ashes-258510@1.1",
   "gameId": "among-ashes-258510",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-15T17:30:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It's been a month since the launch of Among Ashes! Thanks everyone for sharing your feedback and reporting bugs you've found throughout the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Even though the feedback has been really positive overall, I wanted to add some options for those who have found the game to be too challenging! I'm also super happy to add more languages to the game so that more people can experience it all over the world!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Languages",
     "items": [
      {
       "text": "Traditional Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Turkish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Added the option to activate \"Censor Bars\" over all the butt and breast-shaped polygons in the game. The game has been streamed and uploaded to sites like Youtube in its entirety without any issues, but for those afraid of the algorithms, this one's for you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Aim Assist\" settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Infinite Saves\" option for Easy and Normal difficulty modes, for those who find limited saves too stressful",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Infinite Ammo\" option for the Easy difficulty mode, for those struggling with ammo conservation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Infinite Health\" option for the Easy difficulty mode, for those who prefer to focus on the story and puzzles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Balancing Changes",
     "items": [
      {
       "text": "Made Blocking more effective at absorbing damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced damage from enemies in Normal difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed enemy from the garden maze in Easy and Normal difficulty modes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed Night Call puzzles still receiving input when tabbing out",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added slight input delay in Night Call main menu to avoid loading errors when spamming buttons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the ability to aim an shoot when inspecting the children's book",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the ability to interact with the lift buttons after pressing them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added missing subtitle to a specific sequence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed final boss door issues when reloading to a previous save file",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added additional checks to avoid getting stuck after grabbing Amalia's Key",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Limited frame rate to 120fps to avoid some graphics cards from working at 100%: Thanks again for everyone's feedback and whatever you do, remember... K̴͉͚̗̅̃̄E̷͓̤̺̊͠E̴̤̰̿̽P̴̠̳̀́ ̴̨̮̭̕̚P̷̠͇̳͐̓̀L̶̹̔Ả̷̧Y̵̘̺͆̓Ï̸̻̏͂N̷͙̯͊G̵͖̹̠̽̿",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
