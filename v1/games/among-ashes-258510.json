      {
       "text": "Added a small delay when entering or exiting the PC before you can enter or exit it again to prevent the game from glitching out if you do it too fast",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved some parts of the Simplified Chinese translation",
       "ps5ProOnly": false,
