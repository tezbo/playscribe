  {
   "id": "among-ashes-258510@1.0.3",
   "gameId": "among-ashes-258510",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-16T18:47:40.000Z",
   "notes": [
    {
     "title": "Features",
     "items": [
      {
       "text": "Added \"Streamer Mode\", which tells the game never to display your name on screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Polished Chinese texts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "Added extra health and ammo pickups for Easy and Normal difficulty modes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added extra clue for basement maze",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed game breaking when starting a new save file after advancing a lot in Night Call",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added checks for lighter and other puzzle objects to make sure you have them when needed, in case something went wrong",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed game breaking if you somehow get the Ankh key without solving the monkey puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed camera getting stuck on Night Call music box if you reload your game and inspect it after opening it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added checks to make sure the weak spots of the final boss don't glitch out after too many game overs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
