  {
   "id": "quit-today-192015@04.02",
   "gameId": "quit-today-192015",
   "displayName": "Update 04.02",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-05-08T08:25:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": ". Fixed the problem of being unable to continue reading files",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Fixed the issue where the character temporarily disappears when Zero competes with the player for execution.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Fixed an issue where throwing thumbtacks from the top floor would not stay on the ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Quickly closing the game upon death will no longer result in loss of stamina after loading",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Interacting with partners will no longer trigger skill \"Down to Earth\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Corrected the orientation of the Stamper when executing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". The Limit Break skill can no longer be used during the execution of the general manager.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Dancing game will only fail until the button is close to the target",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Unsaved progress will indeed be discarded when returning to the title",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Caught some bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
