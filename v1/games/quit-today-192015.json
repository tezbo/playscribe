  {
   "id": "quit-today-192015@01.00",
   "gameId": "quit-today-192015",
   "displayName": "Update 01.00",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-04-06T18:52:16.000Z",
   "notes": [
    {
     "title": "Fix",
     "items": [
      {
       "text": ". Fixed an issue where photographers could not be pinned by paper clips",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ". Fixed the issue where the Limit Break would be canceled by a Perfect Dodge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ". Fixed ceiling collision in protagonist's home",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ". Fixed the ability of Ming gold coins to increase the amount of money dropped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ". Fixed the issue of being squeezed out of the door during battle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ". Fixed an issue where dying with colleagues would not fail",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ". Fixed an issue where the menu could be opened before reaching the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ". Fixed some achievements in Ming's Office",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ". Fixed the problem that the department can be changed after confirming the department in the lobby elevator.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ". Fixed the issue of abnormal volume when opening a new game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ". Fixed the issue where the music disappears after Satoko transforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ". Caught some bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Experience optimization",
     "items": [
      {
       "text": ". Shorten the length of the execution of the PR Manager",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Modify the rules for the appearance of the Drunk salesperson's fire-breathing execution",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Lower the threshold for high damage performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Overworked Zombies will now fall asleep as long as they touch the floor and will not be woken up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". The number of combos (LIKE) is now more visible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Added defense breach responses for the Legal Manager and General Manager",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Enhanced the special effects and damage bonus of guard-breaking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Reduced Paralyzed time after dashing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ". Button to call partner avoids covering entry arrow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
