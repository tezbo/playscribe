  {
   "id": "videoverse-213618@major-2025-10-15",
   "gameId": "videoverse-213618",
   "displayName": "A big update is coming November 14th!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-15T12:13:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I’m happy to announce that VIDEOVERSE will be receiving a HUGE update next month on November 14th! This update will:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Provide Japanese localisation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add controller-friendly UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improve animation and artwork",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix a few bugs, but also…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bring VIDEOVERSE to consoles, including PlayStation 4, PlayStation 5, Nintendo Switch and XBOX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "Please enjoy the new story trailer!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "VIDEOVERSE is my love letter to video games – A coming-of-age story interwoven with the death of a video game console. It explores how capitalism and time march on but leave people and their personal relationships behind. It’s really a game for anyone who’s grown up loving video games, and I really hope you’ll check it out if you haven't already!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42816405/510c1d5dc7bfd845d9dab67664d63a6a5681670d.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can learn more about VIDEOVERSE here: https://www.kinmoku.games/videoverse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Never miss an update by signing up to the Kinmoku Newsletter: https://www.kinmoku.games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Until next time! ːvideoverse_happyː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
