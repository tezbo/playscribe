   "announcedAt": "2024-03-27T09:52:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new build of VIDEOVERSE has dropped with the following improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New community posts easier to find",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Community scrollbar easier to navigate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Potential crash fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Old/ unused files removed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Credits update: Please update to 1.1.3.0 to enjoy. Thanks again for continuing to support VIDEOVERSE! ^_^",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
