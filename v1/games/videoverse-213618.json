  {
   "id": "videoverse-213618@1.1.2.5",
   "gameId": "videoverse-213618",
   "displayName": "Update 1.1.2.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-14T10:46:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the previous update, achievements got disabled by mistake on export, so this update fixes that. If you believe you unlocked achievements between February 9-14 but didn't receive them, they should now appear the next time you open the game in Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There are also a couple of typo and UI fixes in 1.1.2.5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again for bringing these to my attention! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
