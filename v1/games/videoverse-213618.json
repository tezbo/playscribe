  {
   "id": "videoverse-213618@1.1.2.7",
   "gameId": "videoverse-213618",
   "displayName": "Update 1.1.2.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-15T16:18:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Three updates in one week? What's going on?!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Yesterday, a Steam user found a bug with a MarKun666 conversation, where it would repeat under certain circumstances. It's somehow evaded detection until now, but update 1.1.2.7 fixes it. Please update so you don't encounter it as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you again for the support! Happy gaming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
