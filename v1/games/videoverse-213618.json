  {
   "id": "videoverse-213618@1.2.0.3",
   "gameId": "videoverse-213618",
   "displayName": "Update 1.2.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-14T11:05:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A small new update has released for VIDEOVERSE, which contains a whole new look for Kinmoku (that's me, not the in-game corporation!) plus some minor bug fixes. Please update so you have the latest version of the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Inspired by the early roots of visual novels – from PC-98 to Sega Saturn – the new splash artwork features Kinmoku in their studio. If you look closely you can see references to Kinmoku's games, and even their dog, Goro!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please keep a look out for more VIDEOVERSE news in the coming months! ːvideoverse_smileː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To learn more about the developer, please check out the new website at www.kinmoku.games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
