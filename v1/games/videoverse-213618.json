  {
   "id": "videoverse-213618@1.1.2.9",
   "gameId": "videoverse-213618",
   "displayName": "Update 1.1.2.9",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-08T16:02:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While playing the demo, I noticed a minor bug when commenting on a drawing; where Emmett's comment wouldn't go all the way to the bottom. There was also a bug where the phrase book tutorial would not appear under rare circumstances. These have now both been fixed, in addition to some typos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The demo has also been updated to align with this update! Thanks again to those who brought these to my attention.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
