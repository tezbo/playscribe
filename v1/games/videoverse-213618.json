  {
   "id": "videoverse-213618@1.2.0.2",
   "gameId": "videoverse-213618",
   "displayName": "Update 1.2.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-08T13:43:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today's update fixes a bug at the end of chapter 1, where some players reported being unable to progress past Vivi's notification. It was a tricky one to fix but everything looks good now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There have also been a few sprite and text fixes. The VIDEOVERSE demo has also been updated with these improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again to those who reached out and helped fix the bug! You make VIDEOVERSE what it is :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
