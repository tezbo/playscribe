       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vsync, and controller vibration sliders added in the setting menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor visual bugs fixed with equipped weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
