  {
   "id": "morbid-the-lords-of-ire-237772@post-2024-05-29",
   "gameId": "morbid-the-lords-of-ire-237772",
   "displayName": "Patch notes 2 + Deluxe Edition Now Available!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-05-29T13:19:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Magratheus blesses you, Striver.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for answering the call and fulfilling your duty once more as the Striver, by ridding the land of Ire of the evil Gahars. We have been working hard to fix commonly raised bugs and issues that our brave Strivers have encountered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're happy to push through our second patch for the full game, fixing a range of issues with New Game+ and various bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes - 29/05/2024",
     "items": [
      {
       "text": "Fixed an issue causing players to lose mouse control after exiting certain UI.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a visual bug where dual handed weapons stay on the Strivers back after unequipping then.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(NG+) Fixed an issue causing the Dare of Hardship to allow enemies to 1-Hit the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(NG+) Fixed an issue where the Dare of Insanity wasn't working correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(NG+) Added a redundancy to recover save data if corrupted during NG+ (If save data is corrupted you will be reset to previous shrine)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Alongside this we are also delighted to announce that we now have a Digital Deluxe edition of the game available which includes an artbook and a full soundtrack!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Find the link to the Digital Deluxe edition here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any other bugs on your journey through Ire, please leave your bug report on our dedicated reporting thread here. We are monitoring these issues and will continue to fix as many issues as we can.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And please continue to leave your thoughts and feedback in discussions and reviews, we’d love to hear what you think about the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
