      {
       "text": "Small tutorial improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved combat feel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Stuck spots lessened",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for all the amazing feedback on this demo! We hope you have enjoyed battling through the fearsome enemies of Rimehold so far, and hope that this new patch helps improve your experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
