       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the combat feel of all weapon classes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Balanced shroom effects on bosses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
