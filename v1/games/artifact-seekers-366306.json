  {
   "id": "artifact-seekers-366306@major-2025-10-02",
   "gameId": "artifact-seekers-366306",
   "displayName": "New episodes — new incredible adventures in the latest update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-02T08:45:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We invite all fans of circus art to take part in an unforgettable show! But not as a spectator — as a performer. Explore the backstage area and help the actors to become a true star.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Or maybe you’re more drawn to warm shores and the sound of the sea? Then get ready to land in a pirate’s bay! Somewhere on the island, pirate treasure is hidden. Show all your cunning and perseverance to uncover the long-awaited riches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
