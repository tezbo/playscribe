  {
   "id": "artifact-seekers-366306@post-2026-02-26",
   "gameId": "artifact-seekers-366306",
   "displayName": "New Episodes: Behind the Scenes of the Festive Stage",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-02-26T10:17:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "On a snowy winter evening, the world stood still in anticipation of a Christmas miracle — but it was stolen. Who dared to interfere with Santa? Dress warmly and set out in search of the Christmas thief in the new episode Santa’s Manor. Brave the harsh weather, follow the criminal’s trail, and solve devious puzzles to bring the holiday back.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ahead lies an adventure worthy of the stage. Haunted Theatre awaits — and something has gone terribly wrong: the audience is frozen, the curtain won’t rise, and the show never begins. A dark force has seized the stage. Examine the evidence, question the witnesses, overcome clever trials, and uncover who is holding the theatre captive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
