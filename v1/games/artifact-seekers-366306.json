  {
   "id": "artifact-seekers-366306@post-2026-06-02",
   "gameId": "artifact-seekers-366306",
   "displayName": "Fairy-tale worlds open their pages in new episodes!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-06-02T13:12:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Look beyond the fairy tales to discover the true price of being a hero. In the Dragon Vale, you must claim a powerful artifact from the clutches of an ancient beast. But to do so, you will have to risk a princess's life. Are you ready to make such a trade for your own gain?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you prefer darker secrets, welcome to the Witch Wood. There, under the waxing moon, a werewolf's curse grows stronger, and time is running out. Find out what enraged the witch and clear the curse before this story reaches a tragic end.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Conquer the obstacles of the new episodes and write your own legend!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
