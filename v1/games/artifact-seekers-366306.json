   "id": "artifact-seekers-366306@post-2026-08-17",
   "gameId": "artifact-seekers-366306",
   "displayName": "Wanted: Experienced Artifact Seekers to Perform an Exorcism!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-08-17T09:14:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "What makes an item worthy of becoming an artifact? Everyone has their own answer, but this time the choice is made for our heroes. They must safeguard the treasured belongings of someone who can no longer do so.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unlock intricate mechanisms, find your way through a maze of rooms, and brace yourself! This episode will not only challenge your wits but also send chills down your spine.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
