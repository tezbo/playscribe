  {
   "id": "mars-base-194273@1.024",
   "gameId": "mars-base-194273",
   "displayName": "Patch 1.024",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-10-28T14:37:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone! We've got another patch for you all today continuing to address the bugs you all have found. We've also added in some more quality of life stuff, like mouse support menu interactions!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We're also working on our first big content patch that we want to tease a little bit for you all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Welcome to the wild west of Mars Base, a new enclosed biome to explore and new resources to salvage. In the effort of sustaining future colonies, you are tasked with setting up a ranch to acquire animal livestock from Earth. You will raise them up, and then move them on to the Mars zoo or sell them off to the markets. The base inhabitants can visit the zoo for recreational purposes and earn you additional income in the process. Lastly, there will be new buildings, interior and exterior props to engineer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Mars Ranch patch will be landing soon. Now onto v1.024 patch notes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Addtions/Fixes",
     "items": [
      {
       "text": "Fixed crash if player is carrying crop seeds and interacts with bun.ie droid in the greenhouses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash when swapping weapons in the Dungeon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added transparency when the player walks behind a building or machine.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added mouse support for Build, Freedom, Terrain and Planter mode. The mouse can move or select objects within the camera view now.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added mouse support for all menu interactions.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added mouse right click support to open the menu throughout the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added mouse left click to shoot in the dungeons if any enemies exist.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
