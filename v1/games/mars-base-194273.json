  {
   "id": "mars-base-194273@1.1202",
   "gameId": "mars-base-194273",
   "displayName": "Patch 1.1202",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-12T11:02:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New patch v1.1202 is out now for PC and macOS with minor fixes for the game and preparation for new content (later this year).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Fixes include",
     "items": [
      {
       "text": "Rover disappearing from main base when the player visits the Mars Ranch and comes back.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Player is able to purchase the same rocket parts multiple times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In chef mode, the player's own ingredients aren't used in the final calculations and not deducted properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game crashes when placing water bucket in Mars Ranch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Player cannot add food to the animals bucket (when its been resorted).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
