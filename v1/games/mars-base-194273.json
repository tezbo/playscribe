   "id": "mars-base-194273@major-2023-02-13",
   "gameId": "mars-base-194273",
   "displayName": "Mars Base Ranch Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-13T15:55:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Mars Ranch update is here! Now you can live out your cowboy dreams on Mars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "3 New Buildings!",
     "items": [
      {
       "text": "-Mars barn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Coop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Train Loop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Animals!",
     "items": [
      {
       "text": "-cows",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-goats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-sheep",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-pigs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-chicken",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-rabbits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Other than that, we have quality of life updates such as adding a new Mars wood resource and other inventory enhancements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
