  {
   "id": "mars-base-194273@1.015",
   "gameId": "mars-base-194273",
   "displayName": "Patch 1.015",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-10-20T13:18:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've got another patch for you all today updating and adding some things, as well as fixing some more of the issues that you all have been reporting. Please keep the reviews and feedback coming. We love reading through it all, plus it will help us continue improving the game! If you run into any issues or want to send more feedback than what you want to include in a review, feel free to post in our discussion boards, or in our Discord!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Updates/Fixes",
     "items": [
      {
       "text": "Fixed soft lock issue with recycling the buildings or machines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Allow camera to zoom out when in Freedom or Terrain mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed camera issue where it prevented the player from moving or placing objects closer to the edge of the map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with non-pistol weapons not equiping properly in the dungeons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed low energy darkness levels so it won't get darker each time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed camera zoom setting before and after going to bed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed oxygen and water machines max levels as you recycle the respective machines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added Inventory key 'i' which will load straight the player straight into the blueprint or items inventory depending where they are.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added 'exit' button to the market or forging menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated shop functions so it won't sell blueprints or recipes that the player have already.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated enemy stats (knock back, speed and hp) in the dungeons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
