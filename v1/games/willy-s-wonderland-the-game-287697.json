   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Merchant items are generated for each merchant node, and not for each sublevel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Better visual feedback for UI buttons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When adding a new spirit to the party the game will auto select an empty space if able",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A warning popup will now be displayed when the player is about to replace a spirit in the party with a new spirit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New 3D Graphics for the map nodes!: Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where the game would freeze in a black screen after finishing an expedition",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where registered spirits would be registered without any powers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bug fix for when a new turn started during combat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Translation to pt-br for the warning pop ups in the loadout screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changes in the UI 3D models to properly show illumination and particles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Progression properly saving after forfeiting a battle during an expedition",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that made it possible to mold multiple relics using the same spirit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Upgrade Tree button that had a different size in each structure screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the list of skills and archetypes in the Training Grounds were being displayed repetitively",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the rapport rank up were showing the wrong character and level rewards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Feral Warrior archetype was displaying the wrong name in pt-br",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where a specific dialogue with Caipora would cause the game to freeze",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where upgrades in the Upgrade Tree were showing the wrong requirements and would be impossible to be unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused upgrades to display the wrong cost to be unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
