   "id": "gigantosaurus-dino-sports-300466@post-2024-06-05",
   "gameId": "gigantosaurus-dino-sports-300466",
   "displayName": "Controller Setup Guide for Optimal Gameplay",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-06-05T11:10:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Controller Setup Guide for Optimal Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To enhance your experience with Gigantosaurus: Dino Sports, please note that the 'B' button on Xbox controllers and the 'O' button on PlayStation controllers may not function correctly if Steam Input is enabled. To fix this, please:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "Open your Steam library and select \"Gigantosaurus: Dino Sports\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Right-click and go to \"Properties\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Head to the \"Controller\" tab.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select \"Disable Steam Input\".",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "By adjusting these settings, your controllers should work perfectly in-game. Thank you for your continued support and happy gaming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
