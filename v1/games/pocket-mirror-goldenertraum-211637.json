  {
   "id": "pocket-mirror-goldenertraum-211637@1.1.4",
   "gameId": "pocket-mirror-goldenertraum-211637",
   "displayName": "Update 1.1.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-29T08:52:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Pocket Mirror fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have been paying close attention to all the reported issues and have fixed and implemented as many as possible in the newest update, \"Version 1.1.4.\" We are always improving the game to make it enjoyable to all players, and hope this update can resolve most of the known issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The update details are as follows",
     "items": [
      {
       "text": "Minor fixes for character sprites getting stuck in certain frames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor dialogue and text formatting fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed potential softlock in opening new game+ door",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed certain charms reappearing when reloading the save file",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed charm position in new game+ that wasn't supposed to be accessed in the normal game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some minor collisions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated character portraits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some sprite artifacts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where some objects re-moving when exiting and re-entering the room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the need to talk to pumpkins in the bloody ballroom for achievement - they are technically 'same ones' as the normal ballroom ones",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated localization in Gallery and Settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated Korean localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added FPS fix to avoid issues like 300 FPS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated Opening Video with higher quality one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
