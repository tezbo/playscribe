  {
   "id": "pocket-mirror-goldenertraum-211637@1.1.1",
   "gameId": "pocket-mirror-goldenertraum-211637",
   "displayName": "Update 1.1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-22T10:11:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Pocket Mirror fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just released a hotfix, \"Version 1.1.1,\" to address a few issues in \"Version 1.1.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The video preloading function that we implemented in the previous \"Version 1.1\" update seems to prevent some users from playing the video properly and is causing an error. We have reverted the function, and the videos should be playing as usual.",
       "ps5ProOnly": false,
