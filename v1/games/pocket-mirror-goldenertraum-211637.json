   "kindBasis": "studio",
   "announcedAt": "2023-05-23T08:53:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Pocket Mirror fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are sorry for being unable to resolve the \"fonts/GenRyuMin-R.ttc\" issue that some users are experiencing through the last update. With \"version 1.1.2,\" we decided to replace the font with an already-working one, which should solve all the problems.",
       "ps5ProOnly": false,
