  {
   "id": "pocket-mirror-goldenertraum-211637@1.1.3",
   "gameId": "pocket-mirror-goldenertraum-211637",
   "displayName": "Update 1.1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-26T06:13:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Pocket Mirror fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope everyone is enjoying the game so far!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This game can be difficult at times, and we understand the frustration of rewatching the death animation over and over again. In the newest update, \"Version 1.1.3,\" you are now able to skip the death animation by clicking the button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As usual, we also have fixed several bugs reported by the communities and will continue to improve the overall experience for everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The update details are as follows",
     "items": [
      {
       "text": "Fixed the issue of resetting config data / global save data",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor spelling errors / character dialogue names",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed character portrait graphical artifacts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor issues to character sprites",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added confetti to replace pumpkin charm in Rose Labyrinth pumpkin interaction when the charm has already been collected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added ability to skip game over video",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Update to video loading for videos not loading for some players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updates/fixes for localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
