  {
   "id": "pocket-mirror-goldenertraum-211637@1.1.6",
   "gameId": "pocket-mirror-goldenertraum-211637",
   "displayName": "Update 1.1.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-22T07:14:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Pocket Mirror Fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Winter holidays are here, and we hope you are having a wonderful time with your loved ones. We also hope that all the work we've put into Pocket Mirror ~ GoldenerTraum will help make it even better!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this update, we are adding a huge new feature: The New Game+ Chapter Select Hub. Now instead of restarting at the beginning, you can choose to restart the beginning of any chapter!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, we've worked to fix several bugs that were still popping up in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "implemented NG+ Chapter Select Hub",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fixes to legacy art portraits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "minor spelling errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed videos played from extras menu stuck in dark screen when replayed after skipping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Attemptrd to fix crashes that could be related to slower computers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added more time to load at the start of Cerberus map which sometimes causes an error for some players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "changed death scene trigger in mirror maze that sometimes causes an error for some players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
