  {
   "id": "pocket-mirror-goldenertraum-211637@1.1.5",
   "gameId": "pocket-mirror-goldenertraum-211637",
   "displayName": "Update 1.1.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-08-01T03:50:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Pocket Mirror fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We strive to improve the overall experience, and we understand the hassle of choosing the language each time the game launches. To make things easier, the language selection will only appear once at the beginning, and you can switch to another language from the settings from now on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What's more, except for implementing some minor fixes, we've also added Mac support to this \"Version 1.1.5.\" There is more to come, and we hope you will like it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The update details are as follows",
     "items": [
      {
       "text": "Fixed certain lines in Russian and Italian that didn't show up in the prologue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Enjel's portrait artifacts and sewn mouth expression that wasn't showing correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a typo in Harpae's Extra Room Dialogue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Language Selection only appears once and can be switched in the settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Mac support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
