  {
   "id": "bloodhound-195382@1.3",
   "gameId": "bloodhound-195382",
   "displayName": "Patch 1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-13T14:49:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello again Demon Hunters! o/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prepare to dive into a world of intensified action and demonic encounters with Bloodhound's latest update! Delve into the heart-pounding thrill of:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced camera movements for seamless walking, providing immersive exploration 🚶‍♂️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Smoother transitions during sprints, enhancing your speed and agility in combat 🏃‍♂️💨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dynamically enhanced camera movements for lightning-fast dashes and strategic maneuvers ⚡",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved shooting sensations across various weapons: Revolver, Shotgun, Assault Rifle, Crossbow, Harpoon Shotgun, Rocket Launcher, Minigun, and Railgun, ensuring a satisfying combat experience 🔫🔥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Crisp hit impact sounds, ensuring every strike feels powerful and satisfying 💥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced combat immersion with 2D hit reaction sounds for select enemies, from Fanatic Cultists to Demon Berserkers, heightening the intensity of battles 🎶👿",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Refined collision zones on Akt4_Map3 and Akt1_Map1, providing smoother navigation and challenging encounters 🗺️💥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Better path finding algorithm enhancement for Fallen Angel 🎮",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Captivating storytelling through a captivating comic-style opening cutscene, setting the stage for your demonic adventures 🎬",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Full control over your experience with 'Skip All Cutscene' and 'Skip Cutscene Page' options, conveniently accessible via ESC/space, allowing you to tailor your gameplay ⏭️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Seamless gameplay with a default FPS limit of 60 (opt for unlimited FPS in display settings), ensuring a smooth and responsive gaming experience 🕹️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced Minigun sound volumes, adding depth and intensity to your demon-slaying exploits 🔊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Other minor improvements and fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your unwavering support! Play fearlessly and embrace the challenge! 😈✨\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Check out our FREE DLC",
     "items": [
      {
       "text": "\"Bring the Bloodhound world fully into the retro dimension 🕹️ and enjoy juicy old-style gameplay! o7. 🎉 Dive in and embrace the challenge! 🎮🔥\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Join us and let the demonic adventures begin! 🎮🔥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bloodhound Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "From Players for Players! o7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
