  {
   "id": "bloodhound-195382@1.2.2",
   "gameId": "bloodhound-195382",
   "displayName": "Patch 1.2.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-26T13:12:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In patch 1.2.2, we are pleased to present the following improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Better ragdoll system. Now enemies die ragdoll on inclines and stairs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adding thanks and a full list of backers from the kickstarter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adding achievement secrets to earn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements to AI of flying enemies better detect collisions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved optimization of minor enviroment elements in Act 5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Preparing the game to be able to correctly add and run Retro DLC: More improvements are coming soon. :): Join to our server discord! https://discord.gg/PEAJyyHUQ7: All best from Bloodhound Team. :) o7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
