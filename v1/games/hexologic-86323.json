   "gameId": "hexologic-86323",
   "displayName": "Hexologic's Steam Deck Compatibility Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-04T09:15:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone 👋",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Long time no see! Just wanted to let you know that Hexologic runs perfectly fine on Steam Deck - oof what a suprise! 😅 The game has a download size of 446MB and also supports touch screen controls and that's pretty much it - we're still waiting for the official Steam Deck support green tick.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Experiencing any issues on Steam Deck or any other platforms? Let us know on Discord.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "MythicOwl Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
