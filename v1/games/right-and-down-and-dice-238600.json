  {
   "id": "right-and-down-and-dice-238600@0.8.2",
   "gameId": "right-and-down-and-dice-238600",
   "displayName": "UPDATE 0.8.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-19T20:12:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First of all, we would like to thank everyone who has tried the demo and sent us feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With all the data received, we have updated the demo version of Right and Down and Dice with these changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "VERSION 0.8.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game animations are generally faster and more dynamic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game difficulty has been adjusted. Overall the game should feel a little easier and with a fairer difficulty curve.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General bugfixes (especially some interactions between artifacts and/or abilities.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you play the demo again let us know your opinion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kiko",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
