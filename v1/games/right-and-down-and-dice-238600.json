  {
   "id": "right-and-down-and-dice-238600@1.0.7",
   "gameId": "right-and-down-and-dice-238600",
   "displayName": "Update 1.0.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-07T10:18:50.000Z",
   "notes": [
    {
     "title": "v1.0.7 UPDATE",
     "items": [
      {
       "text": "· BALANCE: Some of the summoned enemies by the ability to summon new enemies were too weak and could be abused, so they have been changed to more powerful enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· BALANCE: Cryo Fortification (Ice Paladin) skill could be abused, is now harder to use.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· BALANCE: Numerical Resilience (IMechanoid) skill could be abused, is now harder to use.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· FIX: Pyrofrost Supression (Ice Paladin) skill has been clarified.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· FIX: Stopwatch (Mechanoid) artifact has been clarified.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· FIX: Cloud Saving is now working.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· FIX: After saving a game and restarting you could end trying to get more than 5 skills. Now the game restarts correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· FIX: Skill \"Cryogenic Transmutation\" now rolls 2 dices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· FIX: Summoning various enemies could cause the game to get stuck and make it impossible to end your turn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
