  {
   "id": "right-and-down-and-dice-238600@0.9.1",
   "gameId": "right-and-down-and-dice-238600",
   "displayName": "UPDATE 0.9.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-06T20:04:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just released a new demo version with some minor adjustments, this will be the final version for the Steam Fest for next week!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "VERSION 0.9.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We added a mini boss fight in the last level of the game just before the final treasure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balancing (artifacts cost, hero skills...).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kiko",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
