  {
   "id": "arzette-the-jewel-of-faramore-256403@patch-2024-02-21",
   "gameId": "arzette-the-jewel-of-faramore-256403",
   "displayName": "Arzette Patch Live!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-02-21T22:16:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you so much for playing Arzette! We're still reeling from the overwhelmingly positive response. Based on community feedback, we're pleased to roll out a patch that fixes a myriad of small issues as well as added a much-requested feature - quest cutscenes for NPCs will now always play the first time!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "FIXES",
     "items": [
      {
       "text": "Various minor gameplay fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor localization fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game will now detect system language and switch automatically (language preferences can still be changed and saved)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added mouse button icons to Steam version",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Steam screenshots not working",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash error caused by certain controllers on Steam",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed fullscreen stretching issue on Steam version",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a certain unlockable mode retaining Casual difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed background corruption in certain situations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Heart Hoarder achievement triggering during a certain mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bonus stages spitting you out of elevators too early on all platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed certain HUD elements to only display appropriately in a certain mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed uneven pixel scaling with HUD elements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "GAMEPLAY UPDATES",
     "items": [
      {
       "text": "Added version number to title screen for all versions (version 1.1.0)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added exclamation points above important NPCs when you have items to give them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "NPC character's first cutscenes are always seen (currently-existing save files should see most first scenes even if character's quest is complete)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added clearer hint for Arzette Coin in the Count Denny stage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made key easier to find in Creece Canyon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed blue magic from certain enemies in Ryha River",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed Zazie quest requirement to finish Rudy's quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Miscellaneous: The previous version of the game on Steam is accessible via the 'archive' branch. Additionally, creating an empty text file called \"sceneskip\" and placing it in your installation folder will restore the previous cutscene behavior.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
