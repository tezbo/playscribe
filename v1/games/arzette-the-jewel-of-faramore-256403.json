  {
   "id": "arzette-the-jewel-of-faramore-256403@major-2024-04-15",
   "gameId": "arzette-the-jewel-of-faramore-256403",
   "displayName": "Arzette Update Notes 4/15/24",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-15T18:59:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone, we have one last big update patch for Arzette rolling out now! These are mostly minor bug fixes and small tweaks, as well as features for speedrunners and advanced users. Thank you for playing Arzette, we sincerely appreciate it! We look forward to seeing players enjoy their time in Faramore for years to come.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "FIXES",
     "items": [
      {
       "text": "Fixed uncommon crash error in prologue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed HUD text lowering in size when non-English languages are selected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various minor gameplay fixes and tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various minor sprite fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Restored last frame of cutscenes being held as the scene ends",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed dark rooms that had lamp layering issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a variety of minor localization errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated ratings for certain countries",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "GAMEPLAY UPDATES",
     "items": [
      {
       "text": "Updated version to 1.2.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The number indicating the active resource amounts (for example, the number of rubies you're carrying) will now turn green when that resource is maxed out",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a hidden option to skip NPC quest introduction scenes if you already have their required quest item, replicating version 1.0.0 cutscene behavior. This option can only be accessed after you've cleared the game once and set before starting a new game.: To enable this option, once in the new game menu, hold the attack button for a moment - red warning text will appear as confirmation. Press the attack button again to disable the option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added launch options for advanced users on Steam. See here for details.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Miscellaneous: The previous version of the game on Steam is accessible via the 'archive-patch' branch (alongside the original version under 'archive'). Additionally, the 'sceneskip' text file method on PC for skipping scenes has been removed in favor of the updated method, seen above.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
