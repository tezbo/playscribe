      {
       "text": "A new update for Magical Drop VI is now available!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "See the complete list of changes",
     "items": [
      {
       "text": "Added Options in the Pause Menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added customizable button layouts in the Options.",
       "ps5ProOnly": false,
