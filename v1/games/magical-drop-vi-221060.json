  {
   "id": "magical-drop-vi-221060@major-2023-04-28",
   "gameId": "magical-drop-vi-221060",
   "displayName": "Magical Drop VI update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-28T11:24:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Magical Drop fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hear your feedback, and are doing our best to improve!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Today's update includes",
     "items": [
      {
       "text": "Friend invitation to a multiplayer session addition",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New region settings including: \"Global\" and \"Auto\" search to find matches quicker enabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Path of Destiny can now be unlocked by finishing Story Mode on \"Easy\" difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4 Characters available in Match mode from the beginning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Easy mode difficulty changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now bind \"instant move\" to any input you'd like",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pattern modification in the \"collect coins minigame\" to increase the number of coins gained",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And many more fixes applied to the following: user interface, soundtrack, translation, and many more...: We'll keep on listening and improving!: Thank you for your patience and ongoing feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
