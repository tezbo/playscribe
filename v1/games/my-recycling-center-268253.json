  {
   "id": "my-recycling-center-268253@2.36",
   "gameId": "my-recycling-center-268253",
   "displayName": "Update 2.36",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-05T22:43:20.000Z",
   "notes": [
    {
     "title": "New functionality",
     "items": [
      {
       "text": "You can now purchase an automatic photo sensor for all compactor containers (SPB, MPB, APB, Shark and Midi LM). This will automatically turn on and off the compactor based on the current fill level of the hopper.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The message \"A skip is full\" will now also display the container type and trash type.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Fixed the problem that the rear gate would not open with the tow truck for some players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved functionality of the document shredder and used clothing box to avoid trash objects getting stuck or lost in the containers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
