  {
   "id": "my-recycling-center-268253@2.22",
   "gameId": "my-recycling-center-268253",
   "displayName": "Update 2.22",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-09T15:55:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added a reset function for the resource machines in the DLC \"Resources Trading Expansion\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In case a pallet gets stuck or lost, aim at the machine to display the current fill percentage and press Delete to reset it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The process duration for wood chip shredding was reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Fixed the problem that caused duplicated cardboard pallets after loading a savegame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a problem with the temporary save directory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
