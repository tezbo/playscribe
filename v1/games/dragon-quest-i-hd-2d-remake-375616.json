   "gameId": "dragon-quest-i-hd-2d-remake-375616",
   "displayName": "DRAGON QUEST I & II HD-2D Remake Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-09T08:21:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "An update (version 1.0.2.0) for the game was released on 03/09/2026.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The patch contains the following changes",
     "items": [
      {
       "text": "DRAGON QUEST I",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The way the protagonist’s attributes change when leveling up on the “Dragon Quest” and “Draconian Quest” difficulties has been adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DRAGON QUEST II",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The ship now moves faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A bug which could cause the screen to freeze after fading to black when players obtained the Yggdrasil leaf in Yggdrasil's Arbour has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Miscellaneous Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More “Traveller’s Tips” entries have been added concerning game systems and progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A bug which left players with DRAGON QUEST III HD-2D Remake save data unable to claim bonus items on SteamDeck has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Other minor bugs have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Check the official DRAGON QUEST I & II HD-2D Remake website for more information.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
