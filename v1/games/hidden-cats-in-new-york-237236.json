  {
   "id": "hidden-cats-in-new-york-237236@post-2026-09-15",
   "gameId": "hidden-cats-in-new-york-237236",
   "displayName": "General Bug Fixing",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-09-15T19:22:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to announce that we have fixed the following issues with the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Congratulations screen not showing up in advanced mode;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Steam Cloud not working properly;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-No achievement for completing advanced mode without hint;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Cat is floating in invisible building when black and white;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Invisible cat that prevented level completion is now visible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With these fixes the game should now be running smoothly!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you continue to enjoy Hidden Cats in New York, let us know if everything runs as intedend on your end, happy finding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
