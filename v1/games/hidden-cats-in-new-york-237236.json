  {
   "id": "hidden-cats-in-new-york-237236@post-2024-01-16",
   "gameId": "hidden-cats-in-new-york-237236",
   "displayName": "Last Updates",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-01-16T14:30:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello friends, we have been working on all games from Hidden Cats Series to fix reported issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here are the last updates for New York.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FIXED - Objects not getting colored;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Meow SFX options not working properly;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Camera keyboard (WASD) controls;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "FIXED - Achievements that were not unlocking properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "REMOVED - 850 and 800 cats achievements. You don't need to replay to get the Number of Cats Achievements anymore. This won't affect your 100% completion status.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "NOTE",
     "items": [
      {
       "text": "Due to the technical nature of the game, sometimes updates can be quite big compared to the game size already installed, even when the update itself is a small thing. But, make note that this won't increase too much of your install files as it is already.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
