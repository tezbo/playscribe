   "gameId": "hidden-cats-in-new-york-237236",
   "displayName": "Game Security Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-08T20:48:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! This is a quick update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Recently there was a security issue related to Unity's game engine world wide, for this reason we have updated the game to a new version that is free from this problem. We will be doing this update with the rest of our games as well to ensure no issues occur!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
