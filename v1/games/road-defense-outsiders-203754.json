  {
   "id": "road-defense-outsiders-203754@0.1.028",
   "gameId": "road-defense-outsiders-203754",
   "displayName": "Update 0.1.028",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-08T15:08:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello players! 👋",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this update, I have added a new menu where you can now create a new game or continue a game that you started previously. This feature allows you to start a new game and test the game's balancing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that I am still working hard on balancing the game, so your feedback is always appreciated. I hope you enjoy this new update and have fun playing Road Defense: Outsiders.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
