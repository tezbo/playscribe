  {
   "id": "road-defense-outsiders-203754@major-2023-02-21",
   "gameId": "road-defense-outsiders-203754",
   "displayName": "New update! - Drone and more🎉🕹️",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-21T20:48:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In this new version, you can further improve your player's regeneration, armor, and speed, making your character more durable and efficient on the battlefield.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "But that's not all. I've also introduced a new military drone that provides air support for you. The drone can aim and fire automatically, adding a new layer of strategy to the game and providing you with an even more thrilling and engaging experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your continued support, and I hope you have a great time!😊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
