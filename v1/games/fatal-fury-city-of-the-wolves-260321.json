  {
   "id": "fatal-fury-city-of-the-wolves-260321@post-2025-07-11",
   "gameId": "fatal-fury-city-of-the-wolves-260321",
   "displayName": "New game modes for Cristiano Ronaldo are coming to FATAL FURY: CotW on July 15!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-11T08:43:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45050745/afc0040fc556a76c1cc181ff4bbd39406fbe6200.jpg\"]New game modes for Cristiano Ronaldo are coming to FATAL FURY: City of the Wolves on July 15!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Content update trailer out now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "CR7 Update Trailer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://youtu.be/GMOlBxi9Iss\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "At long last, experience the South Town story of CR7 in Arcade and EOST Mode!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players can enjoy every character's story in Arcade Mode, with this update introducing the thrilling events of CR7's visit to South Town as he strives to elevate his skills to new heights. But that's not all: in the single-player RPG mode, EOST, players can follow his heartfelt quest to inspire a young child and nurture his love for the sport!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45050745/cf46c02d6a1ea00f19079edf06b38eb90c037ffb.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45050745/ddb6b3eeb10ca88dabdaa40c125900b960142381.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All-new music from the popular DJ Alok serves as CR7's character theme!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brazilian DJ and producer ALOK brings his signature style to FATAL FURY City of the Wolves with ‘Fury (Siuuu)’ a powerful new single now available on all streaming platforms. Composed exclusively for Cristiano Ronaldo’s character, the track serves as his official in-game theme and captures CR7’s energy, precision, and global impact. The track is now available on major streaming platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fury (Siuuu)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Music Streaming Platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lyric Video",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://youtu.be/t5dCI4qlRtU\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ALOK",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "YouTube: [dynamiclink href=\"https://www.youtube.com/@alok\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Instagram: https://www.instagram.com/alok/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TikTok: https://www.tiktok.com/@alok",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
