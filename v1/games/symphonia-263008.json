  {
   "id": "symphonia-263008@1.1.1",
   "gameId": "symphonia-263008",
   "displayName": "Patch 1.1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-01-06T10:29:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Symphonia 1.1.1 Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First, the whole Sunny Peak team wishes you all a happy new year! This patch mainly covers level design and camera tweaks, alongside light bug fixes. Other patches will be coming in early 2025 to add more level design tweaks and fix more bugs; some of them take some time to find and fix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Level Design",
     "items": [
      {
       "text": "S22: Moved up the collectible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "S23: Reduced the height of the central pillar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "S24: Removed a cushion on the top left and added a one-way platform",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "S30: Light killzone colliders rework in the collectible area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "S37: Simplified the transition to the first vertical string",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "S41: Moved the first checkpoint farther to the right",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "S42: Removed spikes and a pillar in the second section",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "B19: Adjusted the third pendulum timing to match with the rest of them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "B29: Moved the bottom right bell farther to the left",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "B36: Inverted rotating block faces",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Camera",
     "items": [
      {
       "text": "Tweaked camera movements to make them more fluid in those rooms : S7, S42, W31, B24",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixed a bug that can softlock the player if they die at the very end of the escape sequence in Brass",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that can softlock the player inside the Wayfarer Tune menu when dying while having it open",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an animation bug that can lock Philemon when landing on a horizontal string with a double jump",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor audio and animation issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other tiny modifications",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thanks again for your feedback and for playing the game. See you for the next patch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Musically yours,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Sunny Peak 🌄",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
