  {
   "id": "symphonia-263008@1.1.0",
   "gameId": "symphonia-263008",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-12T15:39:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello dear platforming lovers !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today sees the launch of our first patch since launch day… It is a pretty big one, as we tried to tackle some of the most important problems we have been seeing in this first week : confusions about some features, and some annoyingly common bugs. Thanks again to the Symphonia Discord members for sending us your bugs, that really helps fixing them faster !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Without waiting, here are the patch notes for Symphonia 1.1.0 (spoilers ahead !) :",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Reworked the settings menu to clarify the utility of gameplay variants.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new warning popup, that appears if you enter secret areas without having the core abilities needed to complete the area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new achievement, related to aura shards !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new splash screen (Razer Interhaptics).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed the credits to include new entries for Razer Interhaptics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed the debug input for the camera movements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixed a bug on the horizontal strings that allowed you to clip under when using the double jump on them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that changed Philemon’s orientation when he died and stuck on a cushion at the same time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that froze Philemon when using the grappling bow on a horizontal string.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused coins to instantly teleport if you died while collecting them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that displayed unwanted dust vfx when the player tried to move during one of the Trickster’s cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused Philemon to be unable to use the Wayfarer Tune in the Palace Jail.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that made the catapult preview and grappling bow trail go behind the scenery sometimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused some animation issues when using alt+tab at specific moments.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug that caused Philemon’s animation to be wrong when launching the cutscene in the second room of Palace Jail.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that lowered the audio volume when dying while playing the Wayfarer Tune.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Attempt to fix the bug that causes some rooms to not load sometimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor issues in audio.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor animation issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed many other tiny bugs and imprecise behaviors.: Thanks again for this awesome launch week and see you next week for another patch !: Musically yours,: Sunny Peak 🌄",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
