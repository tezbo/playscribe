  {
   "id": "lego-brawls-117006@major-2023-06-15",
   "gameId": "lego-brawls-117006",
   "displayName": "UPDATE: New LEGO NINJAGO: Dragons Rising level & content hit LEGO Brawls!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-15T22:00:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Summoning all Spinjitzu Masters! It's time to stand up to The Imperium and stop MergeQuakes from destroying the realms in an all new level inspired by NINJAGO: Dragons Rising.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dragon Power!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Power up Dragon Cores in a new fast-paced, round-based level featuring the mighty dragon, Jiro.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• The first team to power up 3 Dragon Cores wins!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• But watch out, MergeQuakes will quickly change the level and the tide of the brawl.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Go Ninja!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Collect 16 new minifigures including ninjas-in-training, Arin and Sora.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Taunt your enemies with 4 new emotes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Watch for 2x stud bonus events throughout the summer!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
