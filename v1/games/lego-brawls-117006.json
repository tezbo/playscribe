   "id": "lego-brawls-117006@post-2022-12-01",
   "gameId": "lego-brawls-117006",
   "displayName": "Jingle Brawls!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-12-01T23:33:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
