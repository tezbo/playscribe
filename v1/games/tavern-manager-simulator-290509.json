  {
   "id": "tavern-manager-simulator-290509@1.5.2",
   "gameId": "tavern-manager-simulator-290509",
   "displayName": "Patch 1.5.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-09-02T19:08:08.000Z",
   "notes": [
    {
     "title": "Improvements",
     "items": [
      {
       "text": "added 2 more warehouse expansion levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "the observer sees a little further",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "fairies can now fly into the room under the king's room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "guests will not try to go under the new stairs, and the tracks under the stairs should disappear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "treasure items should no longer fall through the display case and visitors no longer drop them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "items that have already fallen through the floor should return to the inventory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fairies near the houses should not block hungry fairies and push less",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "stuck riders on horses should disappear over time or after a reboot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "if you thought that the tables were missing from the store, now you will see them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "the tutorial about the end of the game is shown only 1 time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "a bed with bamboo is correctly placed at the far wall of the tavern on the 8th level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fix for saving the position of the pitchfork",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "small edits in the Simplified Chinese localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
