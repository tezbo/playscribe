   "id": "tavern-manager-simulator-290509@1.5.4",
   "gameId": "tavern-manager-simulator-290509",
   "displayName": "Update 1.5.4",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-29T19:40:23.000Z",
   "notes": [
    {
     "title": "Improvements",
     "items": [
      {
       "text": "The price change in the menu has been reworked. Now it should work more efficiently and clearly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a \"feed all fairies\" button with one of their upgrades for those who are tired of pressing all the buttons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed axe animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The concierge now correctly interrupts cleaning if you clean up faster than her.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The clock in the player's room now shows the correct time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the wiping of spills on a single VIP table.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the fairy service at the table in front of the stairs against the wall between levels 12 and 13.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
