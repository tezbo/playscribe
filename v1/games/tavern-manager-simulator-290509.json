  {
   "id": "tavern-manager-simulator-290509@1.4.3",
   "gameId": "tavern-manager-simulator-290509",
   "displayName": "Patch 1.4.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-03-05T15:50:46.000Z",
   "notes": [
    {
     "title": "Fixes in the hotel",
     "items": [
      {
       "text": "We tried to fix all the cases you sent us about jammed doors and missing keys in the hotel. Thanks for your messages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "It is now easier to jump over railings and into windows",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Death bones no longer threaten the construction site",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "More clear tips on what to do when cleaning and in which room there is dirt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can put your favorite cactus on the reception desk. We didn't think you loved them so much",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fed and hungry horses are counted even when the tavern is closed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
