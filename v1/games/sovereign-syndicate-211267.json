  {
   "id": "sovereign-syndicate-211267@post-2024-11-27",
   "gameId": "sovereign-syndicate-211267",
   "displayName": "Pусский / Russian Language Support Now Available!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-27T18:39:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pусский / Russian language support is now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks so much for your patience, we're working on a few other localizations that will release in the coming months as we complete them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simplified Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Traditional Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Turkish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spanish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brazilian Portuguese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've also setup a bug report / discussion thread for any issues with the Russian translation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And as always you can follow all the latest developments and chat directly with the developers by subscribing to our newsletter or joining our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Newsletter: https://www.crimsonherring.com/newsletter-signup/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord: https://discord.gg/vrVrE3vBSx",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Until next time, Take Care!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
