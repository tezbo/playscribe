  {
   "id": "sovereign-syndicate-211267@major-2022-01-30",
   "gameId": "sovereign-syndicate-211267",
   "displayName": "Development and Funding Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-01-30T02:16:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "H Everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It’s been a busy few months over here at Crimson Herring Studios, putting the final touches on our demo; but I wanted to take a few moments and share some really exciting news.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our Game has been selected by Canada Media Fund to receive $250,000 in development funding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Check out the announcement here",
     "items": [
      {
       "text": "We’re really excited about what this means for our community and everyone working on Sovereign Syndicate. Being able to grow our development team and accelerate production means a lot to us. And we’re hopeful this funding will open more doors to additional funding and business opportunities to help make the best possible game for our community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ll be releasing our demo to our Discord community soon for some user feedback and QA testing. So head on over there if you haven’t already.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
