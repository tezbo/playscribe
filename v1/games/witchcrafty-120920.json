  {
   "id": "witchcrafty-120920@major-2022-02-21",
   "gameId": "witchcrafty-120920",
   "displayName": "DEMO UPDATE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-02-21T18:27:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Good news, everyone and thanks for your feedback! Demo just got major update So, here is patch note:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* fixed dsplay on different resolutions (like 3440x1440 and 1024x768)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* added mana fountain near the first magic stone - so you wont stuck if you spent all you mana",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* fixed mushroom boss battle - more mushrooms added, but explosion hitboxes now more correct",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* gerbera (evil plant, you know) wont shoot after destruction",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* gerbera projectiles wont damage you after the actual explosion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* horizontal slime hitbox now dissappear after their death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* some witchy animation fixes (last but actually the most major update)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
