  {
   "id": "witchcrafty-120920@major-2022-02-28",
   "gameId": "witchcrafty-120920",
   "displayName": "GAME UPDATE (AGAIN)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-02-28T04:10:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello there! General Keno.... Thank all of you, who played our demo! After getting your feedback we made some adjustments to the game, which will be included in full version. So, here is the major of them:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now there is only one difficulty level. If wont be so frustrating as previous \"normal\" level. For example, you will get more hp at the beginning of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Flowing difficulty curve",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Objects placement - there will be more mana fountains, herbs and potions on stages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We got a lot of feedback that current keyboard mapping is not very confortable. Unfortunately we cant do customizable controls right now so we changed keyboard mapping. Now its ZXCV instead of QERF",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Animation fixes for witchy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
