  {
   "id": "haunted-castle-revisited-314976@1.0.1",
   "gameId": "haunted-castle-revisited-314976",
   "displayName": "Update 1.0.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-15T06:20:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We just released an update to fix some bugs and improve some aspects of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Update details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added new art from Order of Ecclesia in the Gallery Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・In Dawn of Sorrow, fixed a bug that would make the behavior of some bosses incorrect in Julius Mode .",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・In Portrait of Ruin, reproduced some of the original minor glitches that were used by the community to create exploits (\"it's not a bug, it's a feature\").",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the Steam version, you can now save the screen mode preferences (Window Mode / Full Screen Mode).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "In the Steam version, you can choose between Window Mode and Full Screen Mode directly from the Pause Menu.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed other bugs and improved stability.: We thank you for playing Castlevania Dominus Collection!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
