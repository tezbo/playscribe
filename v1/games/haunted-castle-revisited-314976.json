     "items": [
      {
       "text": "■Update details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a new Boss Rush Mode in Haunted Castle Revisited!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added new display layouts to change the position of the different screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In order to unlock the Boss Rush Mode in Haunted Castle Revisited, you need to either beat the game, or to enter THAT code on the title screen of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, we thank you for playing Castlevania Dominus Collection, and we hope you will enjoy this update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
