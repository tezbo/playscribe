  {
   "id": "daymare-1994-sandcastle-152844@patch-2023-05-17",
   "gameId": "daymare-1994-sandcastle-152844",
   "displayName": "Daymare: 1994 Sandcastle - Steam Demo patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-05-17T16:03:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear survival horror fans, thank you for the #daymare1994sandcastle Steam demo's stunning success in less than a week!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We got an incredibly hot reception from the worldwide press, streamers and the public! 🔥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛑 From now on, you can play the demo with a new patch we made for bug fixing and general improvements. If you haven't yet, download it on Steam and wishlist the game following the link below!🛑",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "👉STEAM: https://bit.ly/3ghPr8C",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get ready, flow of amazing activities ahead!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "#DaymareTheGame #Invaderstudios #LeonardoInteractive #STEAM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
