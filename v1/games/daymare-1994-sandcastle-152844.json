 "releases": [
  {
   "id": "daymare-1994-sandcastle-152844@2",
   "gameId": "daymare-1994-sandcastle-152844",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-26T08:39:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Major update #2 for Daymare: 1994 Sandcastle is now live, bringing a new difficulty mode and some other quality of life improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We received many requests for a New Game+ mode in the game, to add more replayability to the experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Looking at the game we thought that simply restarting the same playthrough with all the upgrades wasn’t enough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So we created the H.A.D.E.S. mode, a new difficulty based on Hardcore and we tweaked it a little bit, keeping in mind that the player starts with all the available Frost Grip and weapons related upgrades.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also addressed other feedback we received, such as the possibility to customize the camera distance and the ability to activate the Automatic Hacking process and the Frost Beam anywhere during the playthrough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Finally we added the chance to drop Steam Trading Cards from playing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We thank you for all your feedback and your support, if you find other issues you can report them to us on our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Below are all the changes we made in detail",
     "items": [
      {
       "text": "H.A.D.E.S. MODE",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New difficulty mode, unlocked by completing the “Special Agent” challenge, this mode will feature:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Player will start the game with all Frost Grip and Weapons upgrades unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemies will be stronger and harder to kill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Altered combat encounters and more enemies to fight a the same time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "EXTRA",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an option in the Camera menu to customize the distance of the camera from the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option in the Bonus menu that completes Hacking minigames automatically, unlockable by completing the “Computer Wizard” challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option in the Bonus menu that gives the player the ability to use the Frost Beam in the game, unlockable by completing the “Highlander” challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "FIX AND IMPROVEMENTS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug related to the shotgun upgrade material.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the contest winning arts in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some localization typos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved audio during specific cinematics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Super secret easter egg now has sound.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
