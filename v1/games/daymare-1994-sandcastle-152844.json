   "id": "daymare-1994-sandcastle-152844@post-2023-06-29",
   "gameId": "daymare-1994-sandcastle-152844",
   "displayName": "Daymare: 1994 Sandcastle - Charlie Kraslavsky cameo reveal",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-06-29T14:57:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Returning to the original evil, we bet you can't forget this face!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been a while since you didn't spot him in a game, but now Charlie Kraslavsky is back, and he's here to reveal his cameo in #daymare1994sandcastle with a special video for you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Can you imagine which role he's going to play?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And remember to wishlist Daymare: 1994 Sandcastle and try the Steam demo here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👉STEAM: https://bit.ly/3ghPr8C",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "#NoPlaceIsSafe #DaymareTheGame #InvaderStudios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
