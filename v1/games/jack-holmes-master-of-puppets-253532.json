  {
   "id": "jack-holmes-master-of-puppets-253532@major-2023-12-14",
   "gameId": "jack-holmes-master-of-puppets-253532",
   "displayName": "A small update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-14T15:22:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "These last three months have been a little crazy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Being on my own, I have had to dedicate myself to polish the game so that it is in the best possible state, without bugs and crashes. There is also the issue of translations and their implementation. There is very little left. Everything will depend on how long it takes us to make the fixes, I hope that by the beginning of 2024 everything will be ready!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
