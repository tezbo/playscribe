  {
   "id": "jack-holmes-master-of-puppets-253532@1.1.5",
   "gameId": "jack-holmes-master-of-puppets-253532",
   "displayName": "Patch 1.1.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-07T14:48:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Now JACK does not take the ammunition if he does not have the corresponding weapon with him to avoid confusion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The oil of the Ferris wheel is more visible (change texture).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent the last level BOSS to save game for load game and ride Medieval Madness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now you can close the inventory by pressing escape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The wall switch of level 4 has been made bigger.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now in the mines, the fuse looks better model.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now when Jack dies, the controller doesn't vibrate if the vibration is deactivated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
