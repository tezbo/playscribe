  {
   "id": "jack-holmes-master-of-puppets-253532@1.2",
   "gameId": "jack-holmes-master-of-puppets-253532",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-15T17:26:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The game has been optimised, it now performs better on low-end computers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The space occupied by the game has been optimized, it used to occupy 28GB and now it occupies 16Gb.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The object interaction icon has been improved so that it is always visible even if there is a light source.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Due to some complaints about the handling of the protagonist, it has been improved a lot: The aiming is now more agile, and shoots faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Due to some complaints about the speed of the protagonist, the speed has been improved. In open environments he moves faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A double confirmation has been placed at the time of deleting games, to avoid mistaken deletions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several stability improvements have been made to the levels.: Thank you all for the feedback. My second (smaller and cheaper) game will be published at the end of the month and I'm making a third one for 2025! Thanks to the people who have supported me!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
