   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Skill feature has been added to the game. You can change a character's skill from the Party menu. New skills are learned by level-up. (The 'Spin', 'Throw' and 'Summon' commands that were used by Ignus, Teryl, and Frida, respectively, in the previous demo are now selectable as skills.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor graphical updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor difficulty balance changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
