  {
   "id": "starlight-legacy-277465@2.0",
   "gameId": "starlight-legacy-277465",
   "displayName": "Update 2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-02T06:17:41.000Z",
   "notes": [
    {
     "title": "CHANGES",
     "items": [
      {
       "text": "* The English and Japanese scripts have been completely re-written. (The Japanese script was re-written by an anonymous writer, while the new English script is a translation of the new Japanese script.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* New Game+ is now selectable from the title screen after beating the game once. In this mode you can carry over items, magic, and stats from a save file that has beaten the game, and enemies will be twice as strong as usual. In addition to that, all item boxes will be available from the start regardless of how many Starlight Relics you have. (Key items will not carry over from the beaten save file.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Auto-Battle can now be enabled from the Options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* CRT filter has been updated. To enable it, select Filter B from the Screen Settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* LCD filter has been added. To enable it, select Filter C from the Screen Settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* The encounter rate has been slightly lowered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Magic descriptions can now be viewed in-battle by pressing the R button (gamepad) or S key (keyboard) & assigned magic button together.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "* Magic descriptions are now shown on both the shop screen and item menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Status-inflicting magic will no longer work on Form III & IV Guardian bosses, .exe bosses, and the final boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* The Start menu and Party menu have now been combined into one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* The Map can now be viewed by pressing the Start button or C key. (As a result, the Map has also been removed from the Start menu.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Ending cutscene background has been redone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Sky Province roads now have their own unique song.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Ryuna now has her own theme song.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* A new song plays during the ending cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* The credits sequence has been redone, and a new song also plays during the credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* New background effects added to the final floors of Starlight Castle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Other minor changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "BUG FIXES",
     "items": [
      {
       "text": "* The \"First Steps\", \"Rock Destroyer\" and \"Starlight Master\" achievements are now checked when loading a save file, allowing the player to get these achievements even if the save file was started on the demo version or if they did not trigger during normal gameplay for whatever reason.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Issue regarding stat debuffs not working correctly has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Fixed an issue where MP was not being calculated correctly upon level-up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* The Guard skill will no longer work on fainted characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Fixed an issue where fog would appear upon warping to Eternity Forest in the cutscene after collecting the fourth Starlight Relic if Mountain Province was the final province chosen by the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* The Magic shop exterior in Cliffside now shows the correct logo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Other minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44758255/b893720a08f4c5b57dec31bc554c7bac8ab81840.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
