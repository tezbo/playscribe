  {
   "id": "starlight-legacy-277465@0.2.7",
   "gameId": "starlight-legacy-277465",
   "displayName": "Update 0.2.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-05T03:17:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "On the naming screen, pressing the top face button or spacebar will move the cursor to the 'END' position.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The protagonists now start at Lv1 instead of Lv2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The protagonists now start with +10 more MP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Characters can now learn any spell and are no longer limited by their element.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Characters can now change their element by using one of the new Gem items (Fire Gem, Earth Gem, etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The EXP sequence can now be skipped by pressing the confirm button/key (A button or Z key by default).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When buying a weapon, the shop menu now shows if a weapon is stronger than the currently equipped weapon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue where the game could softlock in certain edge cases after returning from battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fullscreen mode should now work properly on multi-monitor setups.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
