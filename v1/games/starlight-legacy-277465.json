  {
   "id": "starlight-legacy-277465@1.0.4",
   "gameId": "starlight-legacy-277465",
   "displayName": "Update 1.0.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-12T00:59:25.000Z",
   "notes": [
    {
     "title": "CHANGES",
     "items": [
      {
       "text": "1) The demo version has been updated to include all engine changes made to the full version. In addition to that, demo saves made in this update (v1.0.4) can be carried on over to the full version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2) Scrollbar menus have had their scroll speed adjusted to be slightly slower.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3) Scrollable menus now have a slightly different cursor to indicate that they can be scrolled through.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "BUG FIXES",
     "items": [
      {
       "text": "1) The Sound Test menu can now be scrolled through by holding down one of the directional pad buttons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "2) Eternity Beam and Final Hatred battle animations now take up the whole screen when playing the game in 21:9 ultrawide aspect ratio mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "3) Other minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "WARNINGS",
     "items": [
      {
       "text": "Demo data from older versions will not carry over. However, if you follow the below procedure you can continue using older demo version save files in the v1.0.4 demo, but we cannot guarantee full compatibility with the full version of the game if you do this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1) In file explorer, head to: \"C:\\Users\\yourname\\AppData\\Local\\pocket_rpg_demo\\\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2) Copy the \"starlight_legacy_saveX.save\" files to: \"C:\\Users\\yourname\\AppData\\Local\\pocket_rpg\\\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3) Rename the save files as \"file_demo0.save\", \"file_demo1.save\", etc.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We apologize for the inconvenience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
