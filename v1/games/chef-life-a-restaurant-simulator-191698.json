  {
   "id": "chef-life-a-restaurant-simulator-191698@patch-2023-08-07",
   "gameId": "chef-life-a-restaurant-simulator-191698",
   "displayName": "Small Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-07T15:28:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings Chefs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're grateful for your continued support, as the entire the team has been wording to resolve the new bugs that some of you encountered after our latest update. Your feedback has been invaluable, and we wanted to thank you all once again for pointing these issues out and for your patience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have now pushed a new patch that includes the following fixes for our PC users:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix of the major errors on the stove, mixer and mixing table, no unresponsive controls and blocking bugs anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix on the warm keeper station with the different kitchen tools",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix on Horace's quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Best regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chef Life's Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
