  {
   "id": "chef-life-a-restaurant-simulator-191698@05",
   "gameId": "chef-life-a-restaurant-simulator-191698",
   "displayName": "Patch 05",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-21T09:41:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Chefs!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is a small patch to address a recent issue softlocking players during the celebration service. With this fix, you should be able to finish the day as usual, without any blockers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you (very!) soon for more delicious news!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the meantime, you can get our most recent (free) DLC: the Cooking Lab!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Follow our socials for more",
     "items": [
      {
       "text": "Discord Twitter Instagram Facebook",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
