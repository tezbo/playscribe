  {
   "id": "chef-life-a-restaurant-simulator-191698@patch-2023-03-03",
   "gameId": "chef-life-a-restaurant-simulator-191698",
   "displayName": "Post-Launch Patch — Fixed Your Blender Chef!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-03T15:30:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings Chefs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We've just released a new patch for Chef Life on PC, containing a lot of requested fixes and updates on certain mechanics. Here's the full list",
     "items": [
      {
       "text": "Fixed the soft block issue with the blender and the mixing table.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Tweaked mouse sensitivity options.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Preheating or boiling water won't remove points if it's not a criteria.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added help for cooking the \"perfect steak\" during the tutorial.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Tweaked the tutorial to avoid soft blocks.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Kassim can prepare more complex food sooner.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Balanced dish pricing.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "\"Give Order\" input is always available during services.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the cursor randomly disappearing.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Better food products are available sooner.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Decoration mode should not soft block the player character anymore.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed following recipes: Cordon Bleu, Tartare, Seafood Spaghetti.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the \"Chef, Oui Chef!\" achievement.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "An other fix for your team members' quests will be coming early next week.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We want to thank all of you for your patience and cooperation. Your feedback is always appreciated and helps us tweak the game to make it a great experience. We hope you're enjoying Chef Life and that this update will bring much desired changes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If any other issue arises, we're always reading your posts on the Steam forums.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can also send us feedback on our Discord server.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "SIncerely,",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The development & publishing team.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
