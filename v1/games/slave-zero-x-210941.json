   "displayName": "Demo Update! Training Room, Opening Cutscene, and Performance Improvements!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-09T20:21:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "An update to the Slave Zero X Demo has been released! In this updated demo (Build ID 11428315), you’ll find:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Training Room mode added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Opening cutscene added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Button command to skip cutscenes added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changes and additions to Shou’s attacks (find the new secret super move!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lighting improvements and graphical polish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Performance improvements and bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you enjoy the demo! Please refer to the FAQ and Support threads with any questions. And wishlist the game, will ya?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
