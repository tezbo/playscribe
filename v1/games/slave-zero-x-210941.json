   "id": "slave-zero-x-210941@patch-2024-10-18",
   "gameId": "slave-zero-x-210941",
   "displayName": "New Patch S1.06 - Performance Fix",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-18T17:02:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The patch to version S1.06 is now live! This patch fixes a performance issue observed on some PC systems. Affected systems were displaying very low framerates when the game was paused, idle, or in a menu for 35 to 75 seconds. The build ID for patch 1.06 on Steam is 15669028.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We welcome any feedback or reports you'd like to share with us on this version in the forums, and we appreciate your support of Slave Zero X!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Poppy Works and Team Ziggurat",
       "ps5ProOnly": false,
