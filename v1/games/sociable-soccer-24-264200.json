  {
   "id": "sociable-soccer-24-264200@1.2.1",
   "gameId": "sociable-soccer-24-264200",
   "displayName": "Patch 1.2.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-02-21T10:04:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Barely a week after our last update, we have another set of improvements for you to get your studs into.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this update, we have introduced a new PvP meter to help bring players together at the same time for online play. The meter ticks down every 15 minutes and when the meter is active, it's time to head online and get matched up with opponents for some online friendlies!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now also choose the difficulty for friendly matches and world mode competitions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjustments to new goalkeeper behaviours introduced in the previous update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Difficulty selection now available in friendlies and world mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• New PvP meter. The meter counts down to a PvP Party every 15 minutes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you on the pitch! ⚽",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
