  {
   "id": "sociable-soccer-24-264200@post-2024-11-14",
   "gameId": "sociable-soccer-24-264200",
   "displayName": "Sociable Soccer 25! - Patch Notes: 14/11/2024",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-14T09:34:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Sociable folks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today is the big day. Sociable Soccer 25 is here. As owners of Sociable Soccer 24, there is no need for you to purchase Sociable Soccer 25. The game will update itself. It will still appear in your Steam list as Sociable Soccer 24, but rest assured the next time you boot up it will load Sociable Soccer 25.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The two big new features you will find in Sociable Soccer are…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated player and team data for 24/25 season.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Offline Mode - It is now possible to play World Mode and Friendlies without an internet connection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy! ⚽",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
