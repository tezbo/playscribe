  {
   "id": "sociable-soccer-24-264200@1.1",
   "gameId": "sociable-soccer-24-264200",
   "displayName": "Patch 1.1",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-12-28T08:49:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes to the in-game chat system. More variety of chat options after scoring and conceding goals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix to chat send button also kicking the ball at the same time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added end of day club clash messages showing; club clash results, club group tables.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved goalkeeper animations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved goalkeepers ability to save high and low shots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
