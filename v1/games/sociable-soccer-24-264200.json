  {
   "id": "sociable-soccer-24-264200@1.0.3",
   "gameId": "sociable-soccer-24-264200",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-28T21:38:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi folks,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have had some reports of crashes while attempting to start PvP matches. After some time investigating we have found the cause of the issue and have applied a fix in the latest patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fix for matches exiting while attempting to kick off in online PvP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Minor tweaks to new chip values",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you on the pitch online! ⚽",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
