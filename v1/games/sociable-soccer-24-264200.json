  {
   "id": "sociable-soccer-24-264200@1.0.1",
   "gameId": "sociable-soccer-24-264200",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-22T15:10:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey there Sociable Soccerites!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have continued to work away on tuning based on your feedback post-launch. We have received a lot of feedback regarding the game's difficulty so are pleased to provide this new patch with further improvements in that respect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have also added a new overhead camera to the game, in addition to the existing overhead camera. This is a bit more zoomed out, lets you see more of the field, and therefore requires less camera panning to keep up with the action. Try this if you look the overhead view but don't get on with the motion of the other cam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More fixes to league difficulty. There is now a larger difference between easy, medium and hard difficulties in career mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a second overhead camera. More zoomed out with no horizontal panning in 16:9 aspect ratio resolutions. Some small panning remains in 16:10 and 4:3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "As always, you can keep up-to-date with us and other players over on our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay sociable! ⚽",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
