  {
   "id": "sociable-soccer-24-264200@1.0.2",
   "gameId": "sociable-soccer-24-264200",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-27T09:28:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you once again for your continued feedback. We really appreciate your passion for the game and we have been continuing to work on improvements based on what we are hearing from the community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the latest update, we have...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixes to a couple of gameplay exploits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Further improvements to overhead cameras",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Increased strength and variance of chip",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Other minor gameplay tweaks and balancing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you enjoy the new update! Let us know in the comments and on our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay sociable! ⚽",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
