  {
   "id": "sociable-soccer-24-264200@patch-2023-11-18",
   "gameId": "sociable-soccer-24-264200",
   "displayName": "Patch to in-game difficulty",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-18T14:11:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you to each and every one of you who have purchased the game so far! It's fantastic to see you all rising the up the leagues in career.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have been listening to your feedback posted on the Steam community and in our Discord server. In response, we have made some changes to improve the difficulty of the game, effective immediately.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your feedback is incredibly important to us, and we will always look to use it to make improvements to the game where we can.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We already have further improvements in the pipeline, including to the difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you, and stay sociable! ⚽",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
