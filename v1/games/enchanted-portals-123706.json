  {
   "id": "enchanted-portals-123706@major-2023-09-24",
   "gameId": "enchanted-portals-123706",
   "displayName": "NEW UPDATE IS OUT!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-24T07:36:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "NEW PATCH RELEASE 1.02!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "·The spell change system has been revamped. Spells can now be changed instantly and you can switch midair using a single button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Perform actions with minimal delay between spell and action",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Increased invulnerability time to 2 seconds after being hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· The direction of your dash can be changed to make it easier to adjust your fall. You can also use double jump to adjust your fall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Some enemies in the jungle level will now drop health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· The second phase of the witch boss has been adjusted to improve balance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· You can now use D-pad as movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Collisions on enemies and projectiles have been improved for a smoother gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Players will no longer be sent back to the first level when reaching the second level of the hotel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope these changes enhance your gaming experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
