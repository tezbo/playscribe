  {
   "id": "enchanted-portals-123706@major-2025-11-05",
   "gameId": "enchanted-portals-123706",
   "displayName": "Enchanted Portals Gets a Major Spellbinding Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-05T09:00:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Enchanted Portals Gets a Major Spellbinding Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rookie magicians Penny and Bobby return in a major update packed with fresh content, new modes, and gameplay improvements, designed to deliver a smoother, more engaging, and challenging experience for all players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update introduces two brand-new modes for seasoned adventurers:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Book Mode, featuring all-new bosses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44152890/f5379b0179148a7474cd114e426b40dd0b8826d2.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Boss-Only Mode, offering nonstop action for the ultimate challenge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The notoriously tough Insane Mode has been rebalanced for a fairer yet thrilling experience, and now includes progress saving. Plus, 2-Player Co-op Mode now uses health pools aligned with single-player for better consistency.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44152890/e27e476bebd28912e03b49bd84bec9f322591833.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay pacing has also been improved, with shorter Platforming levels and smoother progression",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44152890/7563cd2ae4b4360b13097b386f4e1e1af969cfd7.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44152890/1cb65867c648ea6e38834a5728edf031bec3509f.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
