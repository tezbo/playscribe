  {
   "id": "enchanted-portals-123706@1.03",
   "gameId": "enchanted-portals-123706",
   "displayName": "PATCH 1.03",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-22T07:32:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Welcome back to Enchanted Portals!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are pleased to announce that we have been working hard to improve the gaming experience for all our players. As always, we're listening closely to your feedback and suggestions to make sure Enchanted Portals is the best game it can be.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In our latest update, we have added a lot of new sound effects. Now, players can enjoy an even more immersive gaming experience thanks to new sounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, we have added a new option to select Penny when playing in single player. Now you can play with your favorite character!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you enjoy these new features as much as we enjoy improving the game for you. Thank you for playing Enchanted Portals and for being part of our gaming community!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
