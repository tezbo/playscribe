  {
   "id": "minishoot-adventures-191761@post-2024-04-04",
   "gameId": "minishoot-adventures-191761",
   "displayName": "Minipatch #1 - Covfefe Jar",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-04-04T15:57:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "First patch is here! Thank you all for your precious feedback and especially to Moojuiceman for the help with the achievement issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I fixed all that was fast and safe to fix, will get back to work asap to fix the rest!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Important",
     "items": [
      {
       "text": "Fixed softlock at the final boss, being stuck behind the crystal barrier. It will now re-open if needed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Arena achievement being awarded one arena too soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where you could finish the game in Advanced without getting the achievement. Unfortunately this in not retroactive as I have no way to know who picked what difficulty due to the bug itself. I apologize for your lost efforts. If you still care to get the achievement, I’d suggest waiting for a future content update, and redo the game in Advanced on such occasion. Really sorry about this annoying issue :'(",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Minor",
     "items": [
      {
       "text": "Removed confusing map icon/ping and fixed a cave position",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some typoes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lowered Teleport module price",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed a softlocking gap in dungeon 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed the annoying crackling looping sound",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the covfefe jar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
