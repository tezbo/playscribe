  {
   "id": "nexoria-dungeon-rogue-heroes-128859@1.0.1",
   "gameId": "nexoria-dungeon-rogue-heroes-128859",
   "displayName": "Update 1.0.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-01-12T21:56:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "After the release I got some more very useful feedback, based on which I made some small updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of changes",
     "items": [
      {
       "text": "The normal difficulty mode now shows you the walls in the dungeon, making it easier to navigate;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cell with boss now has a special icon, after its exploration;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When selecting a hero, you can now see his basic attack power;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a lot of buggies (really a lot).: In future updates I will try to add more hints in the control and explanation of the mechanic of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
