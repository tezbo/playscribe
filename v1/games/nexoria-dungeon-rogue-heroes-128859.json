  {
   "id": "nexoria-dungeon-rogue-heroes-128859@1.2.2",
   "gameId": "nexoria-dungeon-rogue-heroes-128859",
   "displayName": "Update 1.2.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-10-14T22:38:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I found my mistake - I hid the Paladin and the Archer from everyone! Now everything is back to normal and the Archer is available to everyone from the first launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An explanation of how to open each of the heroes was also added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And, of course, bug fixes! The game is now more stable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
