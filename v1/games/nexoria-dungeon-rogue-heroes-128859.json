  {
   "id": "nexoria-dungeon-rogue-heroes-128859@1.2.1",
   "gameId": "nexoria-dungeon-rogue-heroes-128859",
   "displayName": "Update 1.2.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-10-05T16:44:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi! This is small update that cleans bugs after the last major update. Also for those who find the game too hard or too easy - you can change the difficulty in the options of the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
