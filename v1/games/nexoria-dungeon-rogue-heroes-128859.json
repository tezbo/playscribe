  {
   "id": "nexoria-dungeon-rogue-heroes-128859@1.6",
   "gameId": "nexoria-dungeon-rogue-heroes-128859",
   "displayName": "Update 1.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-25T00:23:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Stability & Crash Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a crash when navigating the cursor after all enemies are defeated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash when enemies try to attack with no players alive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash when enemies attempt to heal with no allies remaining",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash related to the interrogation system when no target exists",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash caused by division by zero for units with 0 Agility",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash when using the zombie resurrection spell on invalid targets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a memory leak where card deck data was never cleaned up between battles, causing performance degradation over long sessions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Gameplay Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Invisibility effect lasting forever instead of expiring after its duration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the \"Convinced\" debuff permanently disabling enemy attacks instead of wearing off",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the \"Disgust\" debuff permanently slowing units even after it expired",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Speed and \"Attack Again\" effects canceling each other out",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed toxic rain weather not properly applying poison ticks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed weather effects sometimes not applying to players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed consumable items corrupting the Hunger stat when used in battle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed heroes losing all HP when any party member is destroyed, even if they were still alive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Balance Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rage damage multiplier reduced (x3 → x2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Invisibility damage bonus reduced (x2.5 → x2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stealth + Defense combo bonus reduced (x2.5 → x2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy mana is now capped at 20 (same as player), preventing infinite scaling in long fights",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Invisibility perk (Perk 4) now grants 15 seconds of stealth instead of being nearly instant",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
