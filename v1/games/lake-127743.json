  {
   "id": "lake-127743@4",
   "gameId": "lake-127743",
   "displayName": "Patch 4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-30T15:29:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed missing collider diner",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Update farm missing chairs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent mail truck from blocking conversations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed font missing characters in Chinese and Japanese localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed credits in menu not matching end game credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed not being able to walk when loading a save while sitting on a bench or delivering a letter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated Vsync and Window mode settings. Fullscreen should now be exclusive fullscreen. Vsync and refresh rate should be applied correctly again.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed car horn only usable once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lots of smaller audio related fixes. Hopefully the problem is solved, if not a lot less frequent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you do still encounter any audio issues, please let us know. Here are some things you can try that might help:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changing the priority and affinity of the executable through the Task Manager might help resolve audio issues in some cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enable or disable Vsync and try limiting your framerate. Several players have reported the problem occurs (more often) on higher frame rates. This might help reduce the issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please try to enable or disable exclusive mode via the properties of your audio device through Windows (\"Allow applications to take exclusive control of this device\"). This has been reported to solve the issue in some rare cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
