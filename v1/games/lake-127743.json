  {
   "id": "lake-127743@1.0.6",
   "gameId": "lake-127743",
   "displayName": "Hotfix 1.0.6",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-09-20T19:17:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed black camera pictures! Finally admire your snapshots in all their glory. (Any pictures that are still black are definitely Nancy's fault.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the seemingly random teleport bug on Friday September 12! Poor Meredith was sometimes hurled across time and space to Robert's home, without her trusty mail truck. Not anymore!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, we are working hard to solve any remaining issues. If you have any additional info, or experience any (new) bugs, please feel free to share it with us in the Bugs/Known Issues subforum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
