   "gameId": "lake-127743",
   "displayName": "Hotfix 1.0.5",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-09-08T16:40:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed \"Return to post office\" bug. In several cases this was shown too early or not at all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several issues related to saving/loading. Please let us know if you're still experiencing any issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Slightly reduced splash screen audio volume. Let us know if this is still too loud!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lots of smaller narrative fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are working hard to solve any remaining issues. If you have any additional info, or experience any (new) bugs, please feel free to share it with us in the Bugs/Known Issues subforum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
