      },
      {
       "text": "Fixed bug where Beth is not spawning at her store",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where Frank is looking away during scene at the shed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected a branching error in the scene where Frank is hiding behind the counter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated demo build.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Demo saves cloud saving and several other small fixes. Hopefully all saves can be played again, if not make sure to let us know!",
       "ps5ProOnly": false,
