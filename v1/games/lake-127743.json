  {
   "id": "lake-127743@3",
   "gameId": "lake-127743",
   "displayName": "Hotfix 3",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-11-21T16:18:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed phone ringing audio missing in classic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several smaller technical improvements and changes to help track down the audio issue(s).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Politely asked Frank to leave the Weiss residence during the evening, he can no longer be seen in the kitchen.",
       "ps5ProOnly": false,
