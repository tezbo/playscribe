  {
   "id": "lake-127743@1.0.5.1",
   "gameId": "lake-127743",
   "displayName": "Hotfix 1.0.5.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-09-10T14:52:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A few changes in late game dialogue branching, improving the clarity and gameflow, as well as updated sound implementation, and several technical improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Updated sound implementation, hopefully fixing certain reported issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor technical improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the number of options to give the RV to Angie during the Open Mic Night, thereby hopefully reducing the perceived importance of that option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added the option in the finale to choose the RV ending even when Angie has it in her possession. This felt like a better fit after the conversation that came before it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "As always, we are working hard to solve any remaining issues. If you have any additional info, or experience any (new) bugs, please feel free to share it with us in the Bugs/Known Issues subforum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
