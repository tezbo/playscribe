  {
   "id": "lake-127743@1.0.7",
   "gameId": "lake-127743",
   "displayName": "Hotfix 1.0.7",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-09-29T18:32:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed: the Fast Travel feature would sometimes explode when the mail truck was already on Auto Pilot. Added extra checks resulting in much safer journeys.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: when setting a course using the Auto Pilot feature, opening the map while the loading screen was active would pause the game. No longer possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: on low framerates, the camera would move frantically all the time when walking around as Meredith. The camera found inner peace again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: when playing GhostBlasters for the first time, the tutorial would somtimes stay on-screen even when you stopped playing. Now disappears and resets properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, we are working hard to solve any remaining issues. If you have any additional info, or experience any (new) bugs, please feel free to share it with us in the Bugs/Known Issues subforum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
