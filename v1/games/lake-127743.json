  {
   "id": "lake-127743@1.0.4",
   "gameId": "lake-127743",
   "displayName": "Hotfix 1.0.4",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-09-03T16:43:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "More achievement fixes. All achievements should be working. Let us know if you encounter issues!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Licensing information updated (English only for now, sorry! Translations are on their way).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again for all the reported issues/bugs and feedback so far! We really appreciate it and we are hard at work to squash bugs and make improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note, we are a very small team so please have some patience! Thank you for understanding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
