  {
   "id": "lake-127743@1.0.3",
   "gameId": "lake-127743",
   "displayName": "Hotfix 1.0.3",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-09-02T16:14:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Since the release yesterday we have been hard at work trying to solve as much of the reported issues as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Invert Y axis setting applied to photocamera controls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Input Plugin (Should fix several controller issues). TIP: Try turning on or off Steam Input -> Lake > Properties > Controller > Enable/Disable Steam Input. Also try turning on/off the controller support in Controller General Settings (Steam).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Achievement (final choice Robert) fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Azerty detection fixed. Formerly it would detect a qwerty keyboard as azerty. This should now be fixed.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Tech detail. Now using new Unity Input API.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any other issues, especially input related, please let us know!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Any info related to bugs and/or issues can be posted in the Bugs/Known Issues subforum and we will try our best to look into it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
