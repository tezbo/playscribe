  {
   "id": "lake-127743@1.0.8",
   "gameId": "lake-127743",
   "displayName": "Hotfix 1.0.8",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-10-13T15:42:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed: Localization issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Large & overlapping fonts for all languages have been brought back to normal size.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Situation where Meredith would make a phone call while holding another object (Sorry Mortimer!).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Opening Steam-Overlay prevents player from interacting when returning to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Several cases where engine audio was noticeable when it should not have been.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, we are working hard to solve any remaining issues. If you have any additional info, or experience any (new) bugs, please feel free to share it with us in the Bugs/Known Issues subforum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
