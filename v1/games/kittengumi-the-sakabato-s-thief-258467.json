   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've been listening to your feedback, and we went to work to improve Kittengumi: The Sakabato's Thief. And now you can enjoy this improvements in this latest patch. Some of these new additions are:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New backlog menu where you can re-read all the past dialogue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New font size option in the option menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New entering to the scene animation for characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New option to mute the sound at the end of a sentence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Further more, we've fixed small bugs, that you the community, have been reporting to us. Thank you very much for all your support, and stay tuned for future news!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
