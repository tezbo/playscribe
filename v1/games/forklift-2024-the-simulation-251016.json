  {
   "id": "forklift-2024-the-simulation-251016@major-2024-12-05",
   "gameId": "forklift-2024-the-simulation-251016",
   "displayName": "Coming Soon: The Free Year 2025 Update DLC!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-05T09:13:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Get ready to take your forklift adventures to the next level! We're excited to announce the Year 2025 Update, a free DLC for Forklift 2024 - The Simulation, launching this January. Packed with new features and improvements, this update delivers the most immersive forklift experience yet!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What’s New in the Year 2025 Update?",
     "items": [
      {
       "text": "📦 Improved Forklift Controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enjoy smoother, more precise handling with refined controls designed for maximum realism.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "📦 Enhanced Light and Shadow Rendering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Immerse yourself in stunning visuals with upgraded lighting and shadow effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "📦 New Location: Harbor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tackle fresh challenges in the bustling coastal setting of the new Harbor location, featuring narrow docks and unique layouts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "📦 Dynamic Weather Effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Face ever-changing weather conditions like rain, fog, and clear skies, adding a new level of unpredictability to your workday.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "📦 Overall Visual Quality Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Experience detailed textures, polished environments, and a vibrant world brought to life with enhanced graphics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "When and Where?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Year 2025 Update DLC will be available for free in January 2025 for all owners of Forklift 2024 - The Simulation on Steam, Epic Games Store, and other PC platforms. We are currently evaluating the possibility of bringing this update to PS4 and Nintendo Switch—stay tuned for further announcements.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you for your support, and we can’t wait to see you in the new Harbor location, lifting in style with enhanced controls and visuals! 🚛📦",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Make sure to follow us here on Steam for the latest updates, and don’t forget to add the DLC to your wishlist. Let’s lift into the future together!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
