  {
   "id": "outcast-a-new-beginning-171215@patch-2024-04-22",
   "gameId": "outcast-a-new-beginning-171215",
   "displayName": "Outcast - A New Beginning Patch 2024/04/22",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-04-22T13:35:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This patch brings a lot of fixes following bugs reported by players, whom we’d like to thank.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "“Hide HUD”: Players can now select the option “Hide HUD” from the Game Settings, removing all interface elements from the screen for a more immersive experience. Note that with this option enabled, the HUD will briefly appear while using the scanner and partially (life and shield gauges) during combat gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Quality of Life Improvements and Optimization",
     "items": [
      {
       "text": "Skill Tree: adapted the font size and the skill costs to make it more readable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved performance in Tower of Reality significantly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ultra Graphic Mode: improved shadow quality.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugs Fixed",
     "items": [
      {
       "text": "Fixed several crashes happening while using Oru’s Gun on the PS5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixed several crashes on console saves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several crashes related to dialogs and missions (all Platforms).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Anatok’s Diaries - all 33 Anatok’s Diaries can now be collected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed Quality/Performance selection mode on Xbox Series S.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Fixed various environment issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed NPC being stuck inside walls or the ground.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various localization issues including as-recs, non-localized voice-overs, facial animations, and overflowing texts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various dialog issues (context and logic).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where saves were getting corrupted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed auto-save issues - the game auto-saves more regularly and auto-saves triggered by dialogs launching missions always happen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various Game Credits issues including a bug preventing specific entries from displaying in the end game credits, missing contributors, and typos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed status update of Base SAN-1S - the status is updated to “done” when all the chests are open.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several Gork Eruptions creatures spawning points position.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the achievement “The things you own end up owning you” - the achievement will unlock without having to unequip the modules from the weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the achievement “Kitchen Nightmare” - launching the game will unlock the achievement if all the recipes have already been purchased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the achievement “You want fear? I’m the fear” - launching the game will unlock the achievement if all 30 Outposts have been neutralized.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug when restarting side activities or instantiated missions during the loading fade-out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed dialog camera (Zaleb in Sappa).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Bases guidance status - the relevant information now displays when hovering on Bases in the Quest Map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed keyboard mapping - players no longer need to restart the game to have their mapping applied.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed soft-lock issue during the “Find the Artifact” mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
   "digest": {
    "new": 4,
    "fixed": 21,
