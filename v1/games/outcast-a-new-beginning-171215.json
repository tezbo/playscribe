  {
   "id": "outcast-a-new-beginning-171215@patch-2024-06-04",
   "gameId": "outcast-a-new-beginning-171215",
   "displayName": "Outcast - A New Beginning Patch 2024/06/04",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-04T13:07:53.000Z",
   "notes": [
    {
     "title": "New and updated Features",
     "items": [
      {
       "text": "Added new Quality Mode (40 FPS) on consoles (requires a 120Hz monitor and the output of the console set to 120 Hz)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved performance and stability on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Updated the \"Hide HUD\" feature:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "When Hide HUD option is enabled, damage numbers, enemy health bar and enemy names are hidden",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "During combat, crosshair, \"Quick use items\" and \"Weapons ammo\" are still shown, also with Hide HUD enabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "When Hide HUD option is enabled, several other UI elements are now hidden during various gameplay segments (Orym trail plants, glide for seed plant, items on the ground)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved support for Super Wide monitors (32:9) by fixing various scaling issues",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Implemented reverse Camera Up/Down in Tower of Reality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Player-reported bugs fixed",
     "items": [
      {
       "text": "Fixed a bug that disabled music after the start of a cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a massive frame drop in the center of Emea once the Galenta has hatched",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing audio on the first line of a cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with pick up items not working",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed frame drop in the pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing audio in the WFA cutscene when Jack reports to the Earth Command",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with Jack Boerum fight triggering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Lehaz comlinks triggering during the Nôm-Nôm races",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various bugs on Gork Eruption",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with AI ending in T-Pose after loading a save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with the Fae Fruits Quest in Bidaa remaining unfinished if you find Mirko before talking to Marzo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Galenta's growing Quest trigger",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various localization issues (as-recs, voiceovers, context and logic issues)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various flying assets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Additional bugfixes and optimization",
     "items": [
      {
       "text": "Fixed black background when coming back to main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that made the Fae fruits transparents",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various collision issues in the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed AI teleporting and T-Pose in Outposts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed low FPS when the game is played in Arabic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug involving Scoot not moving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various physics bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various Optimization and fixes on several stalls happening in-game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
