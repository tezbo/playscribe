  {
   "id": "outcast-a-new-beginning-171215@patch-2024-03-28",
   "gameId": "outcast-a-new-beginning-171215",
   "displayName": "Outcast - A New Beginning Patch 2024/03/28",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-28T19:04:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Nom-Nom race controls have been simplified. You can now steer Nom-Noms easily with your controller or WASD on PC.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Players can now save their game on the Galenta",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Optimisation",
     "items": [
      {
       "text": "Fixing the FPS drop in the Base SAP 1 on PS5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixing the FPS drop around Base EGZ 0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Fixed a bug that triggered an infinite energy boost on PC",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug where the Daoka did not open when the player reaches Prokriana to find Kureg",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where English texts where shown in the German language setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed \"The Anomaly\" spawn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Scoot the Twon-Ha did not wake up during its challenge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused a crash in the Main menu if not connected to the Internet",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the number of convoys the player must destroy in the UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players are no longer able to kill Scoot or the Twon-ha’s in Bidaa with the Oru's gun",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the black Save Screen and the wrong number of Daokas in the save game information",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several Kamenaïs spawn points so they don’t look like they’re floating in the sky",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where you could speak to an invisible NPC in Palana",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where White Helidium wasn’t counted correctly for a quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
