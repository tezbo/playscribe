  {
   "id": "outcast-a-new-beginning-171215@patch-2024-02-14",
   "gameId": "outcast-a-new-beginning-171215",
   "displayName": "Demo Patch 2024/02/14",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-02-14T15:27:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We appreciate and examine every bit of feedback we get, especially from long-time Outcast fans, and are working on making adjustments and improvements where we can, especially the stutters so many of you encountered, which we will fix until release.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For a start, we are providing you with a patch to the demo today, which will include the following fixes/features:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reset the tries for each demo so you can give it another go in case you already used your tries (in some cases due to technical problems)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved performance in general",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed collision issues where Cutter can be stuck in the ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added tool tip prompting the use of melee attacks against the blue NaGamors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Gork eruptions can now be cleared by only destroying the Krakit nest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved Display of Glide / Jetsprint in the control image",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
