  {
   "id": "the-walking-zombie-2-112665@major-2020-12-01",
   "gameId": "the-walking-zombie-2-112665",
   "displayName": "Last part of the story update is here!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-12-01T08:18:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello survivors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Final part of story is here. It was difficult and long way, but definitely satisfying one! This is one of the biggest updates yet, full of story quests, cutscenes and fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Northtown, Part 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The third and final part of the Northtown and main story",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added side quests for City of Sun and Springfield",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New cutscenes and bossfights!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New enemies (Zombie Firefighter, Zombie QB's Girlfriend)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New encounter quests",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New karma quests",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New locations (Castle, Mountain hotel)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New localization (Estonian, Italian)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Game balancing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ton of bugfixes and tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also recently added Trading Cards so you can enjoy a little bit of collecting frenzy. :-)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are finalizing plans for the future of the game. Story is finished, but we don't want to stop working on the game yet - we will let you know once we decide what will be the future of Walking Zombie 2. :-)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
