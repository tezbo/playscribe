  {
   "id": "the-walking-zombie-2-112665@3.0.7",
   "gameId": "the-walking-zombie-2-112665",
   "displayName": "Hotfix 3.0.7",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2019-11-08T14:38:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just released a small hotfix that gets rid of a few small bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues with mortar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game balancing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removal of Twinkies from game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other small fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are working on a big update that will bring closure to the City of Sun part of the game with new quests, bosses, enemies, and weapons. In that update, we will also try to fix performance issues, add achievements and make it possible to start the game from scratch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
