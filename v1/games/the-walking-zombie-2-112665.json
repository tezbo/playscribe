  {
   "id": "the-walking-zombie-2-112665@hotfix-2019-10-15",
   "gameId": "the-walking-zombie-2-112665",
   "displayName": "First hotfix released!",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2019-10-15T09:08:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, we just released the first update/hotfix. We are still trying to fix problems with framerate that some people experience but right now we have smaller enhancements and fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can invert mouse Y axis",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can map missing controls (WASD)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam edition purchase is applied even when you start the new game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balancing - basic enemies have less HP and lower damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Falling through floor in Science base fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemies in T-pose fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
