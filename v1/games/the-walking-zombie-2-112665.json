  {
   "id": "the-walking-zombie-2-112665@2",
   "gameId": "the-walking-zombie-2-112665",
   "displayName": "Hotfix 2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2019-10-18T08:10:08.000Z",
   "notes": [
    {
     "title": "Version 3.0.6 was released with plenty of fixes and changes",
     "items": [
      {
       "text": "Time between promo offers is twice as long now (10 minutes) - it looks like we also introduced bug with more offers being offered after buying the Ultimate PC edition, we are working on fixing that",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed wrong karma calculation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed graphic presets not making intended effect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed problems with physics (falling through floor)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "All nonconsumable inapps returned to player after reseting progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We are already working on another patch to make game more enjoyable for you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
