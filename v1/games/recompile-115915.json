  {
   "id": "recompile-115915@major-2021-08-20",
   "gameId": "recompile-115915",
   "displayName": "Update Notes for 20th Aug",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-08-20T17:43:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added options for camera sensitivity and smoothing for both regular gameplay and aiming.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added option to disable controller vibration.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added option to invert X axis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added option to change aiming technique curve from Dual Zone to Linear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Arrow keys can now switch tabs on the Pause/Options screen.: Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed various minor localization issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various minor dynamic music issues in all biomes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
