  {
   "id": "recompile-115915@post-2021-08-21",
   "gameId": "recompile-115915",
   "displayName": "Patch Notes for Aug 21",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-08-21T08:49:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed critical softblock bug where backtracking to Install without certain abilities means you can't get back to the portal. Have re-enabled the original Installation button for players to escape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
