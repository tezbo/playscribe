  {
   "id": "recompile-115915@post-2021-08-26",
   "gameId": "recompile-115915",
   "displayName": "Patch notes for Aug 26th",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-08-26T08:27:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've just updated the game with an incremental patch. Based on community feedback, we've fixed/added the following :-",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted maximum upwards aiming angle, you're now able to aim significantly higher than before",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added a new Audio tab to the options menu, allowing adjustment of music and SFX volume",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tweaked lighting and colors on the Quantum Cores and Batteries in the OKT areas, making them easier to see if they've been activated or not.: These are relatively minor/quick fixes, but please be assured we are also tackling bigger issues and features for future patches. Thank you for supporting the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
