  {
   "id": "the-legend-of-heroes-trails-to-azure-23323@1.1.12",
   "gameId": "the-legend-of-heroes-trails-to-azure-23323",
   "displayName": "Patch 1.1.12",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-04-18T19:25:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "in today's patch for Trails to Azure, we have included the following fixes and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improve audio device initialization on some software setups (should now match the behaviour of Zero in all aspects)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update the ED and OP movies for some platforms/languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix potential reference leaks when switching resolution",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix mouse scrolling on minimap with respect to camera rotation",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Change input binding used in Horror Coaster minigame from `S-Break` to `Shortcut Menu`",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various minor map geometry fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always for our releases, in case you experience any regressions you can revert to prior versions of the game using the Steam \"Beta\" feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
