  {
   "id": "the-legend-of-heroes-trails-to-azure-23323@1.2.7",
   "gameId": "the-legend-of-heroes-trails-to-azure-23323",
   "displayName": "Patch 1.2.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-06T20:47:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "this is just a small follow-up patch to 1.2.5 with the following improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix a crash when leaving the camp menu and opening the save list in the same frame.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a regression on map textures in the intermission event \"Lloyd's Nightmare\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a boat hull texture when using the original texture option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Exclude a few additional specific textures (e.g. cloud shadows) from point sampling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add a Japanese translation for the new settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman, PH3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
