  {
   "id": "the-legend-of-heroes-trails-to-azure-23323@1.1.18",
   "gameId": "the-legend-of-heroes-trails-to-azure-23323",
   "displayName": "Patch 1.1.18",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-28T19:31:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "in today's patch for Trails to Azure, we have gathered a large number of mostly relatively minor fixes and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimize text rendering, particularly reducing frametime spikes when rendering new text at high FPS and with the fast text speed option enabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes to text and text layout issues in both Japanese and English",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various fixes to map rendering and/or collision geometry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Allow the use of multiple controllers simultaneously",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Display the correct button prompts in some circumstances when playing in Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix a small potential memory leak in the movie player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improve the handling of input binding reset",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent a rare potential soft-lock when closing shops",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Limit maximum screen flashing speed of some effects with turbo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always for our releases, in case you experience any regressions you can revert to prior versions of the game using the Steam \"Beta\" feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
