  {
   "id": "the-legend-of-heroes-trails-to-azure-23323@1.1.11",
   "gameId": "the-legend-of-heroes-trails-to-azure-23323",
   "displayName": "Patch 1.1.11",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-29T16:07:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "in today's patch for Trails to Azure, we have included the following fixes and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the same experimental fast text option included in Zero. To use it, set \"fastTextSpeed\" to \"true\" in the category in \"%localappdata%\\Falcom\\Ao\\settings.toml\". This is not intended for general use -- please use this option at your own risk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix a potential crash caused by a memory corruption when unlocking too many records at once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Don't trigger records repeatedly when resuming from the latest save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix an issue in windowed mode where content might be drawn at an offset on startup.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
