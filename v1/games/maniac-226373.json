  {
   "id": "maniac-226373@0.9.18",
   "gameId": "maniac-226373",
   "displayName": "Update 0.9.18",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-02T17:28:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Followers (which you get with the Leader upgrade) can now enter cars and shoot the law enforcement from your vehicle. How popular can you get? :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other than that a bunch of important bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "0.9.18",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "followers can enter cars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "higher Leader upgrade level gives better guns for followers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed immediate first wanted level on second and later runs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed mafia from mafia house not counting to stats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed issues causing levelup hobo to not spawn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed NPC gun jitters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "worse gun pickups don't drop or spawn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "nerfed money gained from money maker upgrade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "upgrade prices slightly adjusted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "MM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
