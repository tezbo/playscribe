      },
      {
       "text": "Added a medicine cabinet/mirror in the bathroom",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a UI issue where selecting the Bathtub Royale map would select Gentle Swim instead",
       "ps5ProOnly": false,
