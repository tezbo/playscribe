  {
   "id": "duck-race-142875@major-2023-05-07",
   "gameId": "duck-race-142875",
   "displayName": "Urgent update note - May 7th",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-07T15:37:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Good afternoon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Following the report of a pretty irritating bug, we have had to push an emergency hotfix! This does however mean a couple of extra bits have been included, too:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Should no longer have an issue spawning ducks in subsequent races.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "'Seasonal' Accessories tab has been changed to 'Featured' and is updated, removing unusable Easter limited hats and showcasing new ones, including moustache!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some behind the scenes changes to make an upcoming update easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
