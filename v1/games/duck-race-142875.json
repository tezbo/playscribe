  {
   "id": "duck-race-142875@post-2024-10-30",
   "gameId": "duck-race-142875",
   "displayName": "Duck, Duck, Ghost!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-30T23:02:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Sorry, we're quite limited when it comes to Halloween duck puns...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is the *official* Halloween update, bringing you a selection of spooky costumes for your little ducks, and a couple of maps which you may or may not have seen before!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The all encompassing \"sheet ghost\" costume has been removed, allowing streamers to select a ghostly duck as a skin option instead. It also comes in \"accessory\", so !duckhat ghost to continue the scares.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hat Options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ghost",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "greg (Over the Garden Wall)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "wirt (Over the Garden Wall)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "pirate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "pumpkin",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "witch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "horns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "wraith",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Map Options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graveyard (from last year)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Heathen (previously exclusive map for DJ Descent)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
