  {
   "id": "duck-race-142875@major-2023-05-02",
   "gameId": "duck-race-142875",
   "displayName": "Update notes for May 2nd",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-02T21:03:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A necessary update to keep Twitch connectivity working, but also a couple of bug fixes and updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Congratulations to RocklandUSA for finding the most Easter Eggs - you can now use your exclusive Easter Bonnet with !duckhat easter (it will appear in the Accessories window next update)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fans of indie game Intrepid Izzy can now use !duckhat izzy to get her signature style",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prepare for interstellar warfare with a crossover with upcoming TPS Cross Planet - !duckhat commander",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Streamers can now add additional racers manually (or even play Offline in their own homes!) using F2 before starting a race.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
