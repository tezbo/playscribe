  {
   "id": "duck-race-142875@post-2023-06-27",
   "gameId": "duck-race-142875",
   "displayName": "More bug fixes, and public gratitude",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-06-27T10:58:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a few more bugs in BtR (mostly created by the last patch)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ducks will now be properly eliminated when they hit the floor and plug hole whirlpool",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ducks should no longer be able to linger under the tap or on the edge of a full bath (requires live testing)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced eliminated duck name opacity - a little easier on the eye",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Ducks should sink properly/always when eliminated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Duck hat should now appear on Winner screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also added is a new custom hat for Twitch.tv/Pokerbrahs as thanks for all the testing and suggestions from them and their community. Try out !duckhat pokerbrahs and don't forget to check out their poker streams if you get a chance!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
