  {
   "id": "duck-race-142875@2.2.2",
   "gameId": "duck-race-142875",
   "displayName": "Update 2.2.2",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-06-23T12:48:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Water wheels moving faster as originally intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bath toys now appearing in bathroom mirror.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ducks will no longer gather by the Wraith tub.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bringing up the results before the end now unlocks the mouse cursor.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Bathtub Royale results now being tracked correctly (internal)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Finish button now always returns to menu if the race hasn't been started.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upgrades",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Duck HP (BtR only) will now scale with the amount of ducks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Elimination text (BtR only) added to bottom left.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Esc key now brings up results same as Tab (more intuitive)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Special thanks to BarronVonCheese and PokerBrahs for helping realise these issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
