  {
   "id": "duck-race-142875@post-2022-11-13",
   "gameId": "duck-race-142875",
   "displayName": "Early big fixes and new sound effects!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-13T23:32:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some early bugs were spotted and have been fixed, see below full list of changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "!IMPORTANT! - Q and Space have now been switched - Q will show/hide duck names while Space will raise the camera. This feels more intuitive (jumping, init?)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Snowy Beaks previously unable to Finish race - this is now fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some ducks could get stuck in the sand castle of Quackpool Pleasure - added current to encourage them out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed duck textures",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Invisible issue related to Twitch connection resolved, don't worry about it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved textures in Quackatoa",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added more sound effects as requested by Jamie Spector",
