  {
   "id": "duck-race-142875@major-2025-02-04",
   "gameId": "duck-race-142875",
   "displayName": "Emoji Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-04T23:39:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Add a little extra character to your Duck Race, with the Emoji update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "!quack during a race will now make your little racer show some emotion. Options are:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "!quack cool",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "!quack cry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "!quack angry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "!quack laugh",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "!quack love",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "!quack wink",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "!quack grin",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let your audience know, and let us know what you think in the Discord or on X!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
