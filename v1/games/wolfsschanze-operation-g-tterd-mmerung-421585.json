  {
   "id": "wolfsschanze-operation-g-tterd-mmerung-421585@1.2.0",
   "gameId": "wolfsschanze-operation-g-tterd-mmerung-421585",
   "displayName": "Update 1.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-20T13:52:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added the knife as a default weapon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved medkit visibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased the lifetime of weapon pickups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced the range at which AI reacts to footsteps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added more vehicle spawn locations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed incorrect player character rotation inside vehicles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We've made several changes for Steam Deck that should resolve some of the issues reported on the device. Please note that Steam Deck is not officially supported.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We've also simplified weapon unlocking, making it easier to unlock new weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your feedback! We're continuing to review your reports and suggestions and are already preparing the next updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
