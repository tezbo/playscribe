  {
   "id": "wolfsschanze-operation-g-tterd-mmerung-421585@1.1.5",
   "gameId": "wolfsschanze-operation-g-tterd-mmerung-421585",
   "displayName": "Update 1.1.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-16T08:45:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Improved AI spawning logic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed incorrect player behavior when the vehicle they were controlling was destroyed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved vehicle exit logic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimized performance based on player feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated training.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the drop rate of health pickups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Key rebinding is available again on PC. This feature had to be temporarily removed due to a crash bug.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We've also seen reports that resolution settings aren't being applied. After selecting your resolution and window mode, please click Apply Changes below these settings to confirm your selection. We've made this button more prominent in this update.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you for your feedback! We're continuing to review your reports and suggestions and are already preparing the next updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
