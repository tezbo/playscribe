  {
   "id": "crescent-tower-339979@1.0.3",
   "gameId": "crescent-tower-339979",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-23T05:12:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The following updates have been implemented.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added the ability to change character colors after creation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added the ability to change equipment at the Adventurers' Guild",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added the ability to view the Item Index anywhere",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added the ability to check monster stats during battle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Changed so characters blown away by enemy monsters' “gust of wind” return to the party immediately after battle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Shortened the effect when using “Slash” on the field",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Changed the design of the icon indicating your current location on the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45565070/f48b98cccb19cd29aff9321a254170275c541104.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
