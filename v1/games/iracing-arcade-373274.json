  {
   "id": "iracing-arcade-373274@1.0",
   "gameId": "iracing-arcade-373274",
   "displayName": "Patch 1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-12T17:10:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, drivers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It’s been a week since we released iRacing Arcade and we are excited to be working on new upcoming content. It’s been great to see many of you enjoying career mode, building your campus and taking on different challenges. We also want to thank you for giving feedback on what you’d like to see in the future in iRacing Arcade, your feedback is being heard!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch 1.0.a1 - Notes",
     "items": [
      {
       "text": "Career",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New functionality to control damage per chosen difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Players will experience less damage to their vehicle when in lower difficulties",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed non-functional Pole Position goals (for now!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now reset your career progress using the “Delete all career progress” button in the career overflow menu (the … button in the upper left)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI & Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The AI will make a bigger effort to brake before crashing with a player in front of them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UX / UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Career: You'll see an unlock notification when a new series is unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Career: Improved the week transitions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Campus: Rotate controls in relocate mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Free Play: Small layout updates to Free Play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Time Attack: Added button in Pause Menu to make it easier to restart in time attack (you can still hold Y/space to do the same)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "iRacing account linking is now accessible under Extra Settings if you've previously clicked Dismiss Forever",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Achievements",
     "items": [
      {
       "text": "Revamped the conditions under which the Milkman appears",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upcoming Constructor and Official Constructor achievements should unlock properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Performance",
     "items": [
      {
       "text": "Adjusted Steam Deck default quality settings",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We’re excited to bring you new content soon. In the meantime, thank you for playing iRacing Arcade!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
