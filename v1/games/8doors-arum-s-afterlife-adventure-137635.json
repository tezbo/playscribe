  {
   "id": "8doors-arum-s-afterlife-adventure-137635@post-2021-06-23",
   "gameId": "8doors-arum-s-afterlife-adventure-137635",
   "displayName": "Patch Notes #3 & Announcement",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-06-23T07:56:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch Notes #3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello Afterlife Adventurers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "8 Doors: Arum’s Afterlife Adventure is participating in this Steam Summer Sale!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If there are any of you who had never played our game before, please don’t miss this chance!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What’s more, there will be a new patch going live today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re also preparing for some content updates for Boss Rush and so on. You’ll love it for sure!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes #3",
     "items": [
      {
       "text": "Game Engine: We figured out some bugs with savings occurred due to the previous game engine. So we upgraded it to the newest version. It took a long time for us and we’re apologizing again for the late content update. Feel free to let us know any problem occurs with this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Controls with Controllers: Now it’s available to change controls on your controllers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Red Specter Index: The ghosts will share their stories within the Red Specter Index from now on!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And please look forward to the upcoming patches!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have a problem or feedback while running 8Doors, please let us know anytime via the contacts below :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord : https://discord.gg/94qFECw",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Email : 8doors_support@neowiz.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
