  {
   "id": "8doors-arum-s-afterlife-adventure-137635@post-2021-04-12",
   "gameId": "8doors-arum-s-afterlife-adventure-137635",
   "displayName": "Patch Notes #1 & Announcement",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-04-12T05:27:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Afterlife Adventurers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we just released a patch to fix a couple issues (detailed below).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[Balancing Adjustments]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a save point at the final boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made some changes to map design",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Altered balancing of some boss battles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[Control-related Bugs]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed problem where button inputs sometimes registered incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the inputs for Xbox and Playstation controllers.: (Ex. Not being able to jump when pressing ‘down’ on the d-pad)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "[Misc.]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some translation errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We've found an issue with the Cloud Save feature and will try to fix it in the next patch, but it will be turned off for the time being. We’re sorry for the inconvenience and hope you can understand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch also includes several other bug fixes and overall balancing adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If for some reason the game isn’t running properly, please follow the steps below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Find the save files at the location below.: C:/Users//AppData/LocalLow/Rootless/8Doors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Delete the file shown above and restart the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re also working on the contents listed below and hope to implement them into the game soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thurible Upgrade : Increase the number of fugitive souls that can be harvested.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cloud Save Support : We know that there is an issue with the Cloud Save if the game shuts down unexpectedly, so we’re actively working on a fix for this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Misc. Bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any questions or comments, please contact us via Discord or send us an email and we’ll get back to you as soon as we can.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord : https://discord.gg/94qFECw",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Email : 8doors_support@neowiz.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
