  {
   "id": "phantom-breaker-battle-grounds-ultimate-319268@1.03.3459",
   "gameId": "phantom-breaker-battle-grounds-ultimate-319268",
   "displayName": "Patch 1.03.3459",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-25T22:25:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for continuing to battle with us in Phantom Breaker: Battle Grounds Ultimate! This hotfix rolls out a handful of key improvements and bug fixes to keep your experience running smooth and solid:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy Clearing Fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved an issue where certain enemies weren’t being properly counted, which could prevent progression in some areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ranking Display Tweak",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The leaderboard now correctly caps at 999 entries as originally intended. Keep climbing and make your mark among the top!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Offline Launch Support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game now boots normally on Steam while offline—as long as your Steam client is running.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Throw Attack Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where enemies could become stuck after being hit with a strike throw.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If a character is damaged mid-throw, the game now handles it correctly without freezing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional Stability Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved error handling to prevent edge-case progression blockers and online play disruptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks again for all the support and feedback—you help us keep pushing PB:BGU to the next level!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy gaming,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Rocket Panda Team 🐼",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
