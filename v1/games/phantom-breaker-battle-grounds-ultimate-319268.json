  {
   "id": "phantom-breaker-battle-grounds-ultimate-319268@1.04.4141",
   "gameId": "phantom-breaker-battle-grounds-ultimate-319268",
   "displayName": "Patch 1.04.4141",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-09-04T08:30:58.000Z",
   "notes": [
    {
     "title": "Gameplay Adjustments & Balancing",
     "items": [
      {
       "text": "Adjusted enemy AI patterns and overall balance in DLC stages (especially on Easy/Normal).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Refined boss mechanics and event timing to improve flow and prevent progression locks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted enemy attack frequency and damage values in several DLC encounters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Skill loadout available during co-op play (result screen)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue where certain bosses or mid-bosses could get stuck or fail to appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved camera and UI misalignment during Battle Ground and event scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a progression blocker caused by client disconnects or stage transitions in online play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected missing shadows and background assets in some DLC stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple crashes related to online lobbies, session cleanup, and character select transitions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed boss retreat events not resetting the camera to default view.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved a bug where characters could remain controllable in a KO state after area changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed errors when reconnecting to lobbies or attempting to join full sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Addressed various localization errors and profile card asset issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Online / Networking Improvements",
     "items": [
      {
       "text": "Improved session stability across all platforms (PS4/PS5, Xbox, Switch, Steam, Epic).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "Better session cleanup when a host disconnects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed lobby hang-ups and sync issues after returning from character select.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved handling of client disconnects so remaining players update correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added better timeout and kick logic for inactive/missing player input.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Refined error recovery and session logic across platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We’ve fixed a lot with this update, and more improvements are on the way. Thanks for sticking with us and sharing your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Rocket Panda Games Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
