     "title": "Changes",
     "items": [
      {
       "text": "Hey Players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just pushed a small hotfix to address a specific issue affecting throw behavior during combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hitstop throw fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where canceling a throw move during a hitstop instant caused it to fail and behave incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thanks for sticking with us as we fine-tune the game. More updates are on the way—stay sharp and keep those combos going!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– The Rocket Panda Team 🐼",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
