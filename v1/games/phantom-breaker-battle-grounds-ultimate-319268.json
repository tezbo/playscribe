  {
   "id": "phantom-breaker-battle-grounds-ultimate-319268@1.03.3506",
   "gameId": "phantom-breaker-battle-grounds-ultimate-319268",
   "displayName": "Patch 1.03.3506",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-10T00:00:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is a quick patch to improve your gaming experience",
     "items": [
      {
       "text": "Ending View Count Issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Skipping some endings under rare conditions was preventing them from being properly recorded. This is now fixed—your progress should reflect accurately going forward!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor Bug Fixes & Optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've tackled several minor bugs and made some behind-the-scenes improvements to keep things running smoothly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for sticking with us—we appreciate your feedback and support. Stay tuned for more updates soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Rocket Panda Team 🐼",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
