 "releases": [
  {
   "id": "taco-tom-2-113047@1.2.1",
   "gameId": "taco-tom-2-113047",
   "displayName": "Update 1.2.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-08-29T20:16:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Taco Tom 2 has (finally) been updated to v1.2.1 on Steam! This update adds all of the new features from the console versions of the game, including a Visual Novel mode, Random bonus mode, and more. If you're wondering why this build is v1.2.1 and not v1.2.0, that's because it also adds an alternate character art pack, available in the Options menu!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "New Visual Novel difficulty mode - now you can read the story without playing the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Random bonus mode - the ingredients in each level are randomized!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bonus modes can now be played across a single world",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Menus can now be navigated using the thumbstick on controllers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Anpu’s Cool Character Art, accessible in the Options menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Graphics Updates",
     "items": [
      {
       "text": "New ingredient and sidebar graphics (the old graphics are still selectable)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a loading screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added fadeouts between menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Worlds that are not yet unlocked now say “Locked”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Multiplayer Mode platform graphic updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Full taco graphic updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Taco Tom 2 logo in start screen and main menu updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Intro screen logo updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Achievements",
     "items": [
      {
       "text": "Updated “Professional Taco Tom 2 Player” to require 10,000 points instead of 20,000 points",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated “Yee Haw!” to require getting a full taco in Arcade Mode in under two seconds instead of under one second",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Renamed “Star Master” to “Star Guru”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated “Star Guru” to require 30 stars instead of 60",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added “That Was Random” - Complete any world in Random Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added “Picky Eater” - Collect the same ingredient five times in a row.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed the game running too fast on >60Hz monitors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Endurance Mode on soft-shelled difficulty had 5 lives instead of 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed being able to restart a level in Endurance Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the game could hang for some time when a new round started in Multiplayer Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a background picture in Multiplayer Mode being the wrong size",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where menus would sometimes appear incorrectly on the first frame they were loaded",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the menu option change sound effect would play when the main menu first loads",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the confirmation sound effect would sometimes play multiple times when selecting a menu option a second time after it was selected, but before the menu faded out to load the selection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the cursor not staying on the Back button when selecting it from the World Select menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where options settings would not be saved properly if the menu was exited by pressing B or Esc instead of selecting the Back button",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the wrong menu would sometimes be loaded after the credits ends",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Other Changes",
     "items": [
      {
       "text": "Updated the credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
