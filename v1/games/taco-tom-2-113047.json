  {
   "id": "taco-tom-2-113047@1.1.0",
   "gameId": "taco-tom-2-113047",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-03-16T19:09:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update adds several highly requested features into the game, including an easier difficulty mode and Taco Sally as a playable character! Here's the full changelog:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Additions",
     "items": [
      {
       "text": "New Soft-Shelled difficulty mode, allowing for infinite mistakes per level instead of just three",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New slow movement mode, allowing for more precise adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New playable character: Taco Sally!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Level Adjustments",
     "items": [
      {
       "text": "1-1: shortened level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "2-2: modified ingredients, lengthened level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "2-9: added ingredients",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "4-2: removed blocks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "6-6: modified ingredients",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "7-3: added ingredients",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "9-9: modified ingredients",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "10-8: modified ingredients",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Other Changes",
     "items": [
      {
       "text": "Lowered the initial fall speed of the ingredients",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Lowered the requirements for most score stars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed the background on the credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the volume of the panic music in Multiplayer Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Wins in Multiplayer Mode are now displayed as soon as a player runs out of lives, instead of waiting until the playing field is reset",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
