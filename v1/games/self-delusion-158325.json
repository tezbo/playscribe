  {
   "id": "self-delusion-158325@major-2022-09-27",
   "gameId": "self-delusion-158325",
   "displayName": "First Big Self-Delusion Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-27T17:56:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update 36.26.09 is already available for everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "In the September update 36.26.09 you will find",
     "items": [
      {
       "text": "UPD - Discount has been removed due to technical issues. I offer my deepest apologies. I hope soon I will be able to solve it and return the discount to Halloween.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fast levels replay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes incomprehensible moments of the gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved indication of events in the game (the appearance of Leshy, Antsybal, Scarecrow).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Level balance improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the logic of Antsybal's attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The design of Antsybal has been changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Faster loading of some levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Leshy's \"disappearance\" logic from the stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adding a section with add-ons in which free content will appear later.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The menu items in the scene selection have been renamed to be more understandable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the atmosphere of some levels of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "And much more!: This update mainly aims to improve gameplay and create a better experience for all types of players. The next updates will focus on additional content and new challenges :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Tnx for the broadcasting",
     "items": [
      {
       "text": "@DrewTheDude28",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "@HaydenTV",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "For all questions, bugs and suggestions, please email me",
     "items": [
      {
       "text": "selfdelusiongame@gmail.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
