 "releases": [
  {
   "id": "guts-54925@major-2018-08-28",
   "gameId": "guts-54925",
   "displayName": "GUTS Update now available!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-08-28T09:36:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The new update for GUTS brings a multitude of improvements to the game that will not only enhance gameplay but also make the game more accessible for new players entering battle. Apart from enhanced graphics, the game receives a complete overhaul of the fighting system to allow for faster and more fluid action.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The main changes to the game are",
     "items": [
      {
       "text": "Full rework of the move system, with rebalancing and streamlined controller input",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After losing a limb, the remaining body parts now allow for more powerful combos and moves, giving the player a chance for a big comeback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All GUTS moves have been optimized and can be executed quicker and more fluidly, also every character now features two GUTS moves",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players can now specifically select the limbs to target with their GUTS moves",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New blocking system; the blocks are easier to pull off and now feature an energy bar, that, if depleted, can lead to dizziness of the character",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New lighting, many new graphic effects, higher framerates and a more streamlined gameplay experience with optimized integration of bullet time lead to a more fluid gaming experience",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
