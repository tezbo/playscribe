  {
   "id": "guts-54925@1.0.3",
   "gameId": "guts-54925",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2017-12-06T18:25:23.000Z",
   "notes": [
    {
     "title": "New Features",
     "items": [
      {
       "text": "Story Mode completion state is now available in Story Mode’s Character Select. You can check if you’ve completed the Regular ending or the Special ending. It also indicates what conditions have to be achieved to complete the Special ending.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More resolution options are now available, based on the aspect ratio of the monitor;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "Fixed controller input binding problems for GUTS Move panels;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed controller input binding problems in tutorials;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed menu navigation problems in the Spin-Offs section;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Online",
     "items": [
      {
       "text": "Fixed flow problems when playing Offline after playing Online;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "When timing out in stage select the current highlighted stage is automatically selected;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Known Issues",
     "items": [
      {
       "text": "The current resolution information shown in the options menu is not your actual resolution. The change works normally, but when you return to the options menu the current resolution information does not correspond to the resolution you are currently on.: Please send any bug reports to support@fluxgamestudio.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
