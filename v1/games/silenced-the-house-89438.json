  {
   "id": "silenced-the-house-89438@major-2024-06-14",
   "gameId": "silenced-the-house-89438",
   "displayName": "Update Silenced: The House",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-14T11:10:52.000Z",
   "notes": [
    {
     "title": "Greetings to all fans of our visual novel!",
     "items": [
      {
       "text": "We are pleased to announce an update to our game that will bring numerous improvements, making your gaming experience even more exciting and immersive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Localization into 9 new languages",
     "items": [
      {
       "text": "We are excited to announce that our game is now available in nine new languages: Chinese, Spanish, French, German, Portuguese, Japanese, Korean, Italian, and Ukrainian. This will allow even more players to enjoy our story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Updated text and character backstories",
     "items": [
      {
       "text": "We have revised and expanded the game's textual elements, adding new dialogues to immerse you deeper into the storyline. Now, each character has a more detailed and rich backstory, allowing for a better understanding of their motives and actions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improved graphics quality",
     "items": [
      {
       "text": "We have enhanced the game's graphics to create an even more atmospheric and terrifying world lurking in the dark.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "We have worked diligently to fix known bugs, especially those related to the save system and text scrolling issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you have any additional questions or suggestions, please feel free to leave comments or contact us directly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enjoy the game and see you in the world of horror!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
