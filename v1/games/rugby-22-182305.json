   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've got quite a large update for Rugby 22, which brings some much needed corrections and improvements to the team rosters (including restoring some star players). Additionally, we've included some gameplay improvements & bug fixes which should make the overall gameplay experience a lot more enjoyable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let us know what you think about the update and read on for the full patch notes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
