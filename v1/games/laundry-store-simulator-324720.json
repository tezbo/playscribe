     "items": [
      {
       "text": "We’re excited to announce the official release date for Laundry Store Simulator is set for December 9, 2024! Mark your calendars as you get ready to dive into the ultimate laundromat management experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
