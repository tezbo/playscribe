  {
   "id": "laundry-store-simulator-324720@major-2025-12-12",
   "gameId": "laundry-store-simulator-324720",
   "displayName": "Laundry Store Simulator Anniversary Update Is Here!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-12T17:56:13.000Z",
   "notes": [
    {
     "title": "Thank you for a wonderful year of Laundry Store Simulator!",
     "items": [
      {
       "text": "To celebrate, we've prepared a special update for you, making your laundry experience fresh and exciting! Here’s what’s included in the Anniversary Update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ":csgostar: New Feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wait... what is this mysterious new place behind the laundry store?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45156294/71813c7528d1b26918aaa08c69227023f83eb6fc.jpg\"]:csgostar: New Quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Are you ready to meet a new challenge? Pay off your loan and unlock the bakso cart, and you'll get the chance to talk with this guy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45156294/95ef5ec52a82b000733f05d021284955d234dee9.jpg\"]:csgostar: New Machines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Give your laundry store a stylish feel! New designs for your machines are available!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45156294/38525e0ecc57312e689f674bc2e762adb4d89d7d.jpg\"]:csgostar: New Decorations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Personalize your space! Make your store look fantastic with a ton of new decorations!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45156294/2e3ef0deff082048191bb77baeb3022ca91558a2.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ":csgostar: Plenty of bug fixes & QOL improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45156294/6f323201db77706b90ef618b2e2b94b7acf7b025.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is not the last update for Laundry Store Simulator. We're cooking up new stuffs for the future. But for now, update your game and dive into this new story!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/3150440/Laundry_Store_Simulator/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
