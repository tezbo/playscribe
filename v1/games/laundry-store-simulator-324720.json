  {
   "id": "laundry-store-simulator-324720@5.0.14",
   "gameId": "laundry-store-simulator-324720",
   "displayName": "Update 5.0.14",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-04-02T14:05:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Tweaked the order of availability of story quests in order to provide a better experience for new players. Story quests now needs to be completed in this order:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DJ",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Christmas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Comic Book",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Paint Store",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Police",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Horror Quests",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If before the update you have made some progress on a certain quest but haven't completed the previous quest necessary to unlock it, then your progress on that quest will be halted until you completed the previous quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For example, if you have made some progress with the Comic Book quest, but haven't completed the Christmas quest, then after the update the Comic Book quest will be temporarily locked. After you complete the Christmas quest, you will be able to continue your progress on the Comic Book quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
