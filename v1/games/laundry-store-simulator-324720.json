  {
   "id": "laundry-store-simulator-324720@7.1.2",
   "gameId": "laundry-store-simulator-324720",
   "displayName": "Update 7.1.2",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-03-31T05:32:19.000Z",
   "notes": [
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay: Fixed a bug where the Exclusive Store status did not reset when starting a new save slot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay: Fixed an issue where the Crouch key could not be rebound",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay: Fixed a bug where the first few upgrades for the Shoe Cleaning apparatus were incorrectly priced at $0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay: Improved the Save Slot system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay: Decreased the chance of machine malfunctions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Map: Fixed a visual glitch in the Coin Laundry Bottom Room where walls would disappear or reveal inaccessible areas when approached",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NPC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NPC: Fixed an issue where Mini-Mart customers were purchasing an excessive amount of items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NPC: Fixed a bug where customers would leave behind uncollected laundry baskets at the end of the day",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
