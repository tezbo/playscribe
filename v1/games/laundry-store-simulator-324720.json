  {
   "id": "laundry-store-simulator-324720@5.0.9",
   "gameId": "laundry-store-simulator-324720",
   "displayName": "Update 5.0.9",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-29T07:25:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Small hotfix and some quality-of-life fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lori will now prioritize putting items that were placed previously in the empty shelf/vending machine if stock for that item exists on the storage racks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Notification for carpet customer waiting to be served",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements to notifications for obstacle spawning so that they always appear even if the player is currently in a UI screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements to NPC behavior to help with customers and staffs getting stuck walking in place. Please let us know if this issue persists after updating to this version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Further fixes to common issues are still ongoing and will be released in a future update. New staffs for features that currently doesn't have one are also planned for a future update. Stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
