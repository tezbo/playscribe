  {
   "id": "laundry-store-simulator-324720@5.0",
   "gameId": "laundry-store-simulator-324720",
   "displayName": "Update 5.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-22T17:04:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re excited to present the latest update packed with new features and improvements for your favorite game! 💖 Thank you for your support, feedback, and continued love for the game – it’s because of you that we can keep expanding the world of laundry!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Maximum Laundry Rank increased to 7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New feature: Carpet Cleaning! A satisfying cleaning system to help relax your day",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New app: Lootbox! Push your luck and get special decorations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New app: Exclusive Store! Buy special items inside to further improve your laundry store",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Gamepad support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fixes and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for being part of our community. Your passion and dedication inspire us to keep working hard. 💕",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Time to get washing – see you in the game! 🚿✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Laundry Store Simulator Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
