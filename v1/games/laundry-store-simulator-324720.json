  {
   "id": "laundry-store-simulator-324720@major-2025-05-18",
   "gameId": "laundry-store-simulator-324720",
   "displayName": "🧺 MAJOR UPDATE IS HERE! 🎉",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-18T17:09:33.000Z",
   "notes": [
    {
     "title": "Hey, Laundry Legends!",
     "items": [
      {
       "text": "We’ve just dropped a huge update to Laundry Store Simulator — and it’s packed with fresh content you won’t want to miss! Check out what’s new:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✨ What’s in the update?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔹 Max Laundry Rank boosted to 8",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔹 Added 10+ new languages – play in your preferred language!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔹 Restocker now grabs boxes from outside too – smooth workflows incoming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔹 Brand-new staff: shirt printer, shoe cleaner, carpet cleaner",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔹 A new story to dive into",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔹 New items & decorations to upgrade your space",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update your game, try out the new features, and let us know what you think. We're excited to hear your feedback and see your new stores!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you in the spin cycle! 🌀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Laundry Store Simulator Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
