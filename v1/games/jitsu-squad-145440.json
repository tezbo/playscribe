  {
   "id": "jitsu-squad-145440@post-2022-05-06",
   "gameId": "jitsu-squad-145440",
   "displayName": "Bug fixes and balance improvements!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-05-06T14:05:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for supporting and playing Jitsu Squad. We really appreciate the warm reception on Steam. We wish to continue to update the game and make Jitsu Squad even better for the player. We have more improvements planned for the future so stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game not advancing because Brimstone or Grimstone going offscreen when tagging out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Memory allocation failed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Aros walking in the air after getting hit while in the Nuada charge attack.: Balancing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Origami fight has been tweaked to be less overwhelming and more readable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced armour and health of the Brimstone.: Polish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added some more visual polish to stages and enemies.: We also have a great favour to ask the Jitsu Squad community: For our visibility to improve on Steam, we need more reviews, we need your voices!: Let the world know that you want more games like this & we'll keep making them!: Thank you so much for your support.: ---: Tanuki Creative Studio",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
