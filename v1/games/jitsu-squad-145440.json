  {
   "id": "jitsu-squad-145440@post-2022-04-20",
   "gameId": "jitsu-squad-145440",
   "displayName": "New weapon features, BG animations, balancing & bug fixes.",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-04-20T15:08:16.000Z",
   "notes": [
    {
     "title": "New Features",
     "items": [
      {
       "text": "1 Up has been added to items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Discord server is now public: https://discord.gg/aJ9Xhxp7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "All weapon pickups now enhance the charaters in some way. (Shout out to Kevin \"Toph Bei Fong\" Furlow who inspired the idea.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Hero",
     "items": [
      {
       "text": "Rasetsu Sword - Raises attack level of all attacks, making breaking armor easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hayakushin Saber - Increases Max Weapon Gauge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Momoji - Hero can perform one additional Air Tobujin.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Baby",
     "items": [
      {
       "text": "Bombs - Increases Max Weapon Gauge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Green Star - Baby can perform one additional Air Witchcraft.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boomerang - Enhances Chain 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Jazz",
     "items": [
      {
       "text": "Blue Destiny - Enhances Amun Hazzard.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Morbid Start - Raises attack level of all attacks, making breaking armor easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gullimorphous - Jazz can perform an additional Air Jump.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Aros",
     "items": [
      {
       "text": "Gunlock - Increases Max Weapon Gauge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nuada Gauntlet - Enhances Helmsplitter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Symbiote - Enhances Painkiller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Background updates",
     "items": [
      {
       "text": "Various backgrounds have been updated with new animations. These include:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sakura Hills Village, Crash Site, River and Dojo Entrance, Castle Hellstorm all stages, Neon Boulevard Streets, Arcade Entrance and Elevator, Yamagiwa Village, Pirate Bay Entrance and Cave.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boss Balancing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All bosses have been rebalanced based on feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tag bug during boss fights, making bosses disappear. (Thanks to Tetsuo9999 (tag combo advocate) for pushing the tag system to it's limits.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Loading crash on startup (for certain system setups).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players now don't have to stand still to progress in certain stages (which happened sometimes in multiplayer sessions)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
