   "id": "jitsu-squad-145440@major-2022-12-08",
   "gameId": "jitsu-squad-145440",
   "displayName": "Achievements, balance improvements, menu update and bug fixes!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-08T10:10:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone! We've released a new update that introduces achievements and has some balancing, improvements, and bug fixes done for Jitsu Squad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is a list of the changes",
     "items": [
      {
       "text": "Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can unlock achievements!: Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed demo save incompatibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed softlock when pressing start during door transitions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash fixes.: Balancing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaked enemy behaviors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Revamped resource system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Introduced fury gain. You gain fury when getting hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Introduced guts system. Your defense becomes stronger when you have less health.: Polish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new sound effects for the Storm Wolf.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Redesigned menu with better readable fonts.: Optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Decreased game file size: Thank you for your support, and stay tuned for the DLC release very soon!: ---: Tanuki Creative Studio 🦝",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
