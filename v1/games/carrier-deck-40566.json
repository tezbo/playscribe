  {
   "id": "carrier-deck-40566@1.1.1",
   "gameId": "carrier-deck-40566",
   "displayName": "Update 1.1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2017-06-30T16:25:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Improved feedback for invalid launches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved mission launching mechanism where missions can be launched without needing to select units",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed cargo missions to immediately add Logistics mission on landing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Missions no longer have to be launched in their order in the mission queue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced number of slots in the mission queue to 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Missions in queue show chevrons when the mission is ready to launch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Aircraft can turn around on elevators",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed unnecessary loadout options from loadout radial on Greyhound, Hawkeye and Osprey",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved damage effects on units",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed Abort Mission behaviour to be a once off deferral rather than ditching the aircraft and launching a rescue mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed mouse clicks not being recognised on some occasions",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "HOW TO UPDATE TO V1.1.1 Open Beta",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In your Steam Library, right-click \"Carrier Deck\" and select “Properties.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select the “Betas” tab.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Beta tag \"Beta - Open Beta\" will appear in the Beta dropdown list. Select it and close the Properties window.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam should now update \"Carrier Deck\" to the beta version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If the update does not start automatically, launch the game to force the update process or...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select \"Local Files\" tab",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select \"Verify Intergrity of Game Files\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
