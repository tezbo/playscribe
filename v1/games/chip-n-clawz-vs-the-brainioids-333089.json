  {
   "id": "chip-n-clawz-vs-the-brainioids-333089@post-2025-09-29",
   "gameId": "chip-n-clawz-vs-the-brainioids-333089",
   "displayName": "New Skirmish Mode Now Live – Patch Notes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-29T16:05:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have just added the brand-new Skirmish Mode to Chip ‘n Clawz vs. The Brainioids - for FREE! This game mode introduces new multiplayer maps with AI opponents. Now you and a friend can squish even more Brainioids together! Skirmish Mode is available for solo, online co-op and split-screen play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Check out the full patch notes below, including new Friend’s Pass features. We’ll see you in-game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New features",
     "items": [
      {
       "text": "Skirmish mode is added to the game! Pack 1 is now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Play battles against AI-controlled Brainioids.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Choose between 5 difficulties ranging from casual to unfair!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Pack 1 comes with 3 maps: Brainioid Central, Commanding Heights, and Secret Base.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Play solo, or invite friends in online or split-screen Skirmish co-op.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Friend’s Pass - 2 PvP maps now available for free!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Friend’s Pass players can now host public and private PvP games on the maps “Commanding Heights” and “Brainioid Central” for free!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Tweaks and fixes",
     "items": [
      {
       "text": "Fixed missing Railgun VFX. Sniping the bad guys is flashy once again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The “For Whom the Brain Tolls” achievement now works properly. If completed, simply opening up the game will trigger it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Like us: https://www.facebook.com/ArcGames/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Watch us: [dynamiclink href=\"https://www.youtube.com/@ArcGames\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Join us: https://discord.gg/2DEGRggKA2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
