  {
   "id": "chip-n-clawz-vs-the-brainioids-333089@patch-2025-02-25",
   "gameId": "chip-n-clawz-vs-the-brainioids-333089",
   "displayName": "Known Issues with Steam Next Fest Demo & Upcoming Demo Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-25T01:21:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Earthlings!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks so much to everyone who's played the Steam Next Fest demo so far! It's incredible to see you all enjoying the demo and of course, showing those pesky Brainioids who's boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We wanted to give a quick update on Known Issues we've spotted (see below). We plan to go out with a patch tomorrow to fix the issues mentioned in the Levels section -- stay tuned for updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Co-op",
     "items": [
      {
       "text": "Sometimes accepting a Steam invitation through Steam's \"Friend Invite\" feature does not work the first time, then accepting a second invitation works correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Levels",
     "items": [
      {
       "text": "Toxic Pond Level (The 5th Challenge Level) - Watchtower's collider does not work and cannot be destroyed by Shooters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Commanding Heights (PvP Map) - miners may get stuck and not mine one of the central Brainium crystals correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
