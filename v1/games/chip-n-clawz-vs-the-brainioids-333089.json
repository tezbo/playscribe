  {
   "id": "chip-n-clawz-vs-the-brainioids-333089@post-2025-09-09",
   "gameId": "chip-n-clawz-vs-the-brainioids-333089",
   "displayName": "Patch Notes September 9",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-09T09:03:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version Number: 23185",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Major fix",
     "items": [
      {
       "text": "Fixed an issue causing the game to crash when placing buildings on missions with pre-placed Gun Turrets (“Guns Blazing” and “Stating the Blobb-vious”).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Tweaks and fixes",
     "items": [
      {
       "text": "Gun Turrets now properly target General Blobbius and all of his cronies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A small rework of the mission “Stating the Blobb-vious” improves visuals and gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Artillery now properly targets high-ranking Brainioids in the mission “We’re in Big B Trouble”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Janitors now properly yell when hurt, or if their doom is imminent. Poor things.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Small tutorial tweak in the mission \"Guns Blazing\" now properly highlights Chip's Overdrive ability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A few typos were corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The “IDKFA” achievement now works properly. If completed, reloading your save will trigger it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A mysterious sphere named “Alien Cat Spawner” was removed from the game. Or was it?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
