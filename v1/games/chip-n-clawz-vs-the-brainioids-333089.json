  {
   "id": "chip-n-clawz-vs-the-brainioids-333089@major-2025-11-11",
   "gameId": "chip-n-clawz-vs-the-brainioids-333089",
   "displayName": "Area Control Update Now Live – Patch Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-11T17:01:27.000Z",
   "notes": [
    {
     "title": "New features",
     "items": [
      {
       "text": "New multiplayer map with a brand-new mode - Area Control.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reach the victory point goal before your opponent does to snatch the win!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Available in PvP and Skirmish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Skirmish Map Pack 2 is added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "All multiplayer maps now have a Skirmish variant. Go win them all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Intel XeSS",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Quality profiles are now properly applied when using XeSS",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Integrated Intel® XeSS Frame Generation (XeSS-FG)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Integrated Intel® Xe Low Latency (XeLL)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Tweaks and fixes",
     "items": [
      {
       "text": "Skirmish rebalance - we did some fine-tuning thanks to your feedback and amplified the opposite difficulties. Easier difficulties are now easier, and harder difficulties hit even harder!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Panic music now plays correctly when the Brainioids press the Panic button in Skirmish battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare issue where the camera could get stuck inside the hero character when starting a level. Yikes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare issue (we’re talking really rare!) where the Pause Menu does not show correctly when pausing/unpausing quickly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Wireless DualSense controllers are now detected correctly. No need for chords anymore!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
