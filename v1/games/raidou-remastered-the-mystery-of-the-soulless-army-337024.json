   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released patch 1.03 for RAIDOU Remastered: The Mystery of the Soulless Army, please see the details of the fixes included:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The freezing issue at the Soda Joint in the final chapter has been resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Issue where progression became impossible on the loading screen, under certain language settings, following the cutscene after entering a name has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your continued support of RAIDOU Remastered: The Mystery of the Soulless Army!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
