  {
   "id": "dusk-diver-2-171860@post-2022-04-19",
   "gameId": "dusk-diver-2-171860",
   "displayName": "2022/04/19更新說明",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-04-19T10:27:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear all Dusk Diver 2 Players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released a new patch today with the following updates:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Fixed a bug in Chapter 11 that might result in the story being unable to proceed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Fixed Leo's side quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Improved stutter situations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Other minor bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue to fix bugs throughout the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please stay tuned for our announcements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
