   "id": "port-of-jumanah-304537@post-2026-06-18",
   "gameId": "port-of-jumanah-304537",
   "displayName": "Port of Jumanah Demo Now Speaks 5 Additional Languages!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-06-18T03:09:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Divers, adventurers, and fish‑punching enthusiasts, we’ve got exciting news! The demo for Port of Jumanah is now available in five new languages:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simplified Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Traditional Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Portuguese (Brazil)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spanish (Spain)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This means more players around the world can dive into the chaos of the Arabian Gulf and experience the roguelite madness in their own language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And that’s not all! other languages are also in progress. We’re working hard to expand accessibility even further, so stay tuned for future updates as we continue to bring Port of Jumanah to more communities worldwide.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Explore the ocean and restore peace upon the sea!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "[p align=\"start\"]Join the Port of Jumanah community",
