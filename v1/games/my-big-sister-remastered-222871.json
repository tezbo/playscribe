      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is just a small patch for some edits made to the Japanese version of the game. Hopefully all save files should work without having to roll back.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "But, just incase",
     "items": [
      {
       "text": "Warning: Updating could result in possible corrupted save files, here's how to fix them!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To fix the save file issue, you will have to revert to a previous update. To do this; right click the game in your steam library and go to properties, under the beta tab select the dropdown box and select a rollback version (rollbackver0.2 to be precise) until your save files work again",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
