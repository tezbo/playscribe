   "gameId": "rubber-hose-rampage-285259",
   "displayName": "Boom Time, Baby!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-25T05:44:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Rubber Hose Rampage just got even more chaotic! Along with your trusty guns, you now have a brand-new way to wreak havoc: throwable BOMBS! That's right, explosions are now part of your daily rampage. Just tap the shiny new bomb button to casually drop a little mayhem at your feet or hold it down to hurl destruction like a true lunatic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Why settle for just bullets when you can blow stuff up too? Get out there and start flinging some fiery fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
