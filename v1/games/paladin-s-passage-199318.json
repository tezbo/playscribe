  {
   "id": "paladin-s-passage-199318@1.2.1",
   "gameId": "paladin-s-passage-199318",
   "displayName": "Update 1.2.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-21T20:58:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Updated to Unreal Engine 5.3.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Switched to UE 5.3.2 orthographic camera with Lumen lighting to give more 2.5D appearance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Switched leaderboards to use PlayFab so all platforms are on the same system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated to FSR 3.0.4 for AMD GPUs, Steam Deck and Apple Silicon Macs",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Updated to DLSS 3.5.10 for NVIDIA GPUs with full hardware ray-tracing support",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added some minor aesthetic changes to menus and levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Major cleanup of the Steam Workshop",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Return to menu from in-game goes back to the same chapter and level just played",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved 2-D camera display widths for some oddball resolutions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Steam Deck cloud sync path to match cross-platform requirements",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Dozens of other bug fixes, tweaks and performance enhancements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
