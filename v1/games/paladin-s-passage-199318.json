  {
   "id": "paladin-s-passage-199318@1.0.2",
   "gameId": "paladin-s-passage-199318",
   "displayName": "Update 1.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-07T19:14:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The 1.0.2 release of Paladin's Passage is now available for all platforms, fixing the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Switched Steam Deck and Apple Silicon GPU builds to use Temporal AA Upsampling for better performance. Unfortunately, FSR 2 doesn't work on Steam Deck with UE 5.2.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "When closing the Steam Overlay with Escape/Back button, in-game menus no longer close.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Spawned skull enemies no longer intermittently get stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed mouse settings from UI.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issues with Community involvement and Popularity achievements not working.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cleaned up some extra items in level editor palette.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disabled erroneous achievement for unlocking chapter 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated scoring for collecting fairies (or fairy).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
