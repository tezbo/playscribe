  {
   "id": "river-city-rival-showdown-255878@1.0.1",
   "gameId": "river-city-rival-showdown-255878",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-20T08:42:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The update patch to Ver 1.01 releases today with the following changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch addresses various in-game issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Turned vertical synching off, framerate locked at 60 FPS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "→The framerate no longer varies depending on the monitor refresh rate and is now locked at 60 FPS.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Pause Menu for local multiplayer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "→The 2P side player (guest) can now open the Pause Menu during local multiplayer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Controller settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "→Changed the default controller settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* If the controller settings cannot be changed in your play environment, the following may help:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1) “Enable Steam Input” from Steam settings",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "2) “Controller Layout” → Select “Gamepad”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Please follow the above steps for each controller needed.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
