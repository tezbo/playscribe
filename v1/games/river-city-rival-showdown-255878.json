   "id": "river-city-rival-showdown-255878@1.0.2",
   "gameId": "river-city-rival-showdown-255878",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-12-14T02:38:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have applied a hot-fix patch today for “River City: Rival Showdown” to address several issues with the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "【Steam】ver1.0.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the game does not register for the save data of “River City Saga: Three Kingdoms” to unlock the Riki story arc.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed other minor bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We apologise for the inconvenience caused, and we thank every user for the continued support for the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
