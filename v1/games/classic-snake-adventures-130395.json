  {
   "id": "classic-snake-adventures-130395@major-2020-02-14",
   "gameId": "classic-snake-adventures-130395",
   "displayName": "Classic Snake Adventures major update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-02-14T11:34:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "* NEW FEATURE: Run the snake with 'SPACE'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Glitch fixed that made you invulnerable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Hit boxes fixed. Now the hit box detection is more accurate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Bosses fixed. The lightening now appears in places that are not impossible to reach.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Better handling of mouse selection in map area.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "* More music. Much more music variety added during gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Speed portals are now seen much easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Some rounds are corrected in world 5. (was impossible)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
