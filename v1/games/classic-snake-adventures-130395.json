 "releases": [
  {
   "id": "classic-snake-adventures-130395@1.2.0",
   "gameId": "classic-snake-adventures-130395",
   "displayName": "Update 1.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-01-20T11:24:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1.2.0 Major Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* 4K@120FPS* / 4K@60FPS [* Requires >= 120Hz TV/Monitor & 2.1 HDMI]* Added Gamepad & TouchScreen support (Xbox & Playstation GamePads).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "* The game is easier now. Especially in the hard rounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Now its easier to complete the game with 3 stars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Fixed all hit boxes issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* We redesigned all 'snake obstacles' add added hit-box 'red lines' to be clear where the snake hits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* These 'Red lines' can be made more 'bold' or be 'completely removed' from game settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Added 1 language: Japanese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Major game engine update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Bugs fixed in Geography.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Other bugs fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "GAMEPAD SUPPORT",
     "items": [
      {
       "text": "For the Xbox or PS4 gamepads to work it must be detected at the game loading screen. To do this you must disable Steam Input.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "1) Go to Steam Library, find the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2) Right click the game and click 'properties'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3) Select 'Controller' and then Disable Steam Input.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "4) Click ok.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5) Start the game. In the main dragons screen you should see an option to select 'keyboard' or 'gamepad'. Select gamepad.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thats it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See the main image for help.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
