  {
   "id": "cthuloot-235448@major-2025-04-02",
   "gameId": "cthuloot-235448",
   "displayName": "Demo update: progression saved and release date changed to April 14!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-02T14:50:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Cthulooters,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Due to other announcements and an opportunity, we've postponed the game's release by a few days, to Monday afternoon, April 14.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you're not too disappointed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you're from the press or a content creator, you can e-mail us for a key to the game at cthuloot@pixelnest.io.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "CTHULOOT dev team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
