   "gameId": "cthuloot-235448",
   "displayName": "New CTHULOOT demo update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-10T11:30:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello adventurers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "From today you can play the new version of the CTHULOOT demo for free:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The essential beginner's tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The first level of the Lost Catacombs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Unfathomable Depths level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The first Misty Reef level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And the invisible catacombs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And discover the new version of Morgazhan's lair, full of surprises!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't hesitate to tell us what you think about the update on our Discord!",
