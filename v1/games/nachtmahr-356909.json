 "releases": [
  {
   "id": "nachtmahr-356909@1.0.2.0",
   "gameId": "nachtmahr-356909",
   "displayName": "Patch 1.0.2.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-09-24T02:53:33.000Z",
   "notes": [
    {
     "title": "Latest Patch Notes",
     "items": [
      {
       "text": "The latest game patch contains major changes and bug fixes. The most notable is the new Game Compass. This is a new game setting that is off by default but can be enabled via the Game Settings menu. When enabled, key items, objects, puzzles and zones will be marked on the compass to help keep you on the right path. Other notable changes/fixes include:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Engine level game breaking bugs that could cause interactable objects to silently reset their values, causing states to save that did not match with the actions as well as cause DataLayer loading crashes. These were game breaking bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reworked some puzzle positions to make things more clear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reworked zone transition tunnels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Auto save now increments through 5 slots, allowing breaking bugs to be recovered from.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced loading aggressiveness on consoles. This will slow load time but prevent crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "DLSS has been repaired and can now properly be enabled.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Created a restore system that will restore Objects to their proper saved state on reload if they had not properly triggered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lastly, if you experience any bugs or issues, please reach out to use at https://mangygoblingames.com/support so we can address them right away! We value your input and time to help make this game an experience that can be enjoyed by all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
