   "kindBasis": "studio",
   "announcedAt": "2025-09-03T11:57:08.000Z",
   "notes": [
    {
     "title": "Multiple Bug Fixes from the Frozen Expanse including",
     "items": [
      {
       "text": "-Crystals are lit up for timed puzzles, but don't count.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-The player gets trapped in the statue puzzle of the frozen expanse.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Tutorial windows will not close when pressing the prompted button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-When exiting an re-entering a save lock zone the game rarely will not let you shoot magic projectiles in save lock areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
