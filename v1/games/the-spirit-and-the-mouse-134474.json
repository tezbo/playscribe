  {
   "id": "the-spirit-and-the-mouse-134474@post-2023-10-24",
   "gameId": "the-spirit-and-the-mouse-134474",
   "displayName": "Japanese Localization is here!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-24T16:12:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone 👋!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you're doing well. It's been more than a year since the game release!! Happy game anniversary to us!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update includes the Japanese localisation (Done by Teyon Japan), which was exclusive to the console version that released last June. Japanese speaking player can now enjoy the game on PC! It also comes with minor fixes listed below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New features",
     "items": [
      {
       "text": "Japanese language added in settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Typo fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Staff roll displaying wrong on specific ratios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare softlock issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, we thank you for your support and all the nice messages we received 💛 If you are playing the game and have run into issues, please reach out on Discord or via email (thespiritandthemouse@alblune[.]com) and we'll see what we can do to help.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Squeak squeak,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Luka & Alex 🐭⚡",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
