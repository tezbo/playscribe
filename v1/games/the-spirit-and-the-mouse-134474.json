  {
   "id": "the-spirit-and-the-mouse-134474@1.13h",
   "gameId": "the-spirit-and-the-mouse-134474",
   "displayName": "Patch 1.13h",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-06T15:54:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello all! Thanks to your feedback and reports, we fixed a few issues in the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the changes in this patch",
     "items": [
      {
       "text": "North",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resized Kiclumsy objective trigger zone, preventing a soft lock if the player exited the zone or the game after finishing Kiscribe minigame.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "West",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed softlock state occurring if the player quit the game without saving after Kilearn's first dialogue in the West Residence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a failsafe for players with a softlocked save due the issue mentioned above.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed visual bug when triggering ending cutscene while in Electric mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected typos in English & French text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Pressing F6 on the keyboard unlocks the cursor completely. Pressing it again hides it.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "As always, we thank you for your support and all the nice messages we received :yellow_heart: If you haven't yet left a review on Steam, it would mean a lot to us if you do! If you are playing the game on Steam and have run into issues, please reach out and we'll see what we can do to help.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Squeak squeak,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lucie & Alex 🐭⚡",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
