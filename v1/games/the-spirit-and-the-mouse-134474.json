  {
   "id": "the-spirit-and-the-mouse-134474@1",
   "gameId": "the-spirit-and-the-mouse-134474",
   "displayName": "Update 1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-12T19:12:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With Squeakross out, we finally had time to update The Spirit and the Mouse, we had this update in our back log for a while",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "This is a small patch that fix the Map screen being transparent and rendering incorectly on MAC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Because the game was rebuild with a newer version of unity, you can also expect overall better performances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
