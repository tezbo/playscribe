  {
   "id": "city-limits-208438@post-2025-01-24",
   "gameId": "city-limits-208438",
   "displayName": "Leaderboards Fixed",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-01-24T01:17:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sorry this took so long but I think I fixed a bug with leaderboards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some of you are probably like, \"whaaa there's a problem with the leaderboards??\". Well that's because it was only effecting some players. Should be working for every one now. :) Edit: You may need to do a \"verify integrity of game files\" check after the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hey I got a goal for you! Could we get the games review score to 10?? That'd be rad. Lets Steam know whats what.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Space",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
