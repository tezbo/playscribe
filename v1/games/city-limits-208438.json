  {
   "id": "city-limits-208438@1",
   "gameId": "city-limits-208438",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-08-05T23:00:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello! This patch addresses just a few little things :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-f12 now works to take screenshots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-updated leaderboards to be cleaner looking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-added tool tip icons for some buildings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-clearing buildings with spike towers rewards points now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That is all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "edit: I should mention, if you had a run in progress before downloading this update, when you load it, your map may be a jumbled mess. I suggest deleting the run from the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
