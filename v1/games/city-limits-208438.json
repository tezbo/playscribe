  {
   "id": "city-limits-208438@13",
   "gameId": "city-limits-208438",
   "displayName": "Patch 13",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-01-06T00:15:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is just a small patch to fixe a couple crashes that were reported. One was related to the new free build mode. The game wasn't saving/loading the correct size of the island and this would cause a crash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The other was some bad copy/paste shenanigans :D Basically when game would check a certain tile for a building, the game would find it and then create an effect on a non existent tile.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That is all! Enjoy :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
