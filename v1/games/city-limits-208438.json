  {
   "id": "city-limits-208438@10",
   "gameId": "city-limits-208438",
   "displayName": "Update 10",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-12T17:04:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "updated sound fx icon to not look like a music icon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "save file icon now says that it's for the run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "updated some building descriptions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "gave the expand button a bit of a wobble until the player uses it for the first time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added an in game option to disable ui movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added an in game option to disable most ui",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added a few stats that display at the end of a run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added several different scenes that play during specific songs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added several bits of ui that aid in playing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "polished the controls when using a controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "reduced the sound duck when achieving certain combos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "added sound fx to a couple different actions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "loads of polish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "so many other little things that I can't remember off hand :D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Aaaand that is all. If you enjoyed City Limits, consider leaving a review! The goal is to hit at least 10 reviews. That'd be suuuuper helpful and much appreciated :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
