  {
   "id": "city-limits-208438@15",
   "gameId": "city-limits-208438",
   "displayName": "Patch 15",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-08T23:27:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Yoo. I must've missed patch 14 :D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is just a minor patch to address a little ui glitch when using the minimal ui option. And a fix to the ui button for music.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That is all! If you haven't, please consider leaving a review for City Limits. It helps a ton! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
