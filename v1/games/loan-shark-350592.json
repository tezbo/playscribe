  {
   "id": "loan-shark-350592@post-2025-08-12",
   "gameId": "loan-shark-350592",
   "displayName": "Fixed some minor rendering bugs",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-08-12T09:40:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi folks! This patch should just fix some rendering bugs some people are having, including the game defaulting to the OpenGL renderer even though the game doesn't support it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I'm still gathering info on the camera spinning so fast it crashes people's game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
