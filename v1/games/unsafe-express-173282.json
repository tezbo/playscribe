  {
   "id": "unsafe-express-173282@major-2021-11-29",
   "gameId": "unsafe-express-173282",
   "displayName": "Update Notes 29/11",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-11-29T16:06:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone! We just pushed an update that includes some fixes and some preparations for new features! Here's a list of changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Observer mode: Downed players can now enter observer mode and see what their friends are doing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New signal amplifier model and some sounds, preparing for rework.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New enemy proximity sounds for large enemy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New smaller enemy animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue that would stop players from running or crouching after getting caught by enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to your help, we have identified an issue that causes the game to not restart and get stuck on the Logo screen, when using the Steam invite interface. This will be fixed very soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for all the reports and your understanding, especially in our discord server! More fixes will be rolled out frequently!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "OnSkull Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
