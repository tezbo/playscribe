  {
   "id": "unsafe-express-173282@major-2021-11-19",
   "gameId": "unsafe-express-173282",
   "displayName": "Update notes for 19/11",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-11-19T16:22:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone! We just pushed an update, fixing a lot of problems! Here's a list:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bigger & Smaller enemy sounds have been updated and fixed to work better!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that cause voice chat to not work after starting new run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused some looping sounds to never stop playing after losing/winning the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an bug that sometimes caused players to lose the game without some members having been killed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Audio volumes now save and work after game restart.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added indication of having to drop item before picking up another. (More to come soon!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed audio and visual queues for suit powering down in power pad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Easy and Hard mode now updates for all players in the lobby.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lots of other minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for all the reports and your understanding, especially in our discord server! More fixes will be rolled out frequently!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "OnSkull Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
