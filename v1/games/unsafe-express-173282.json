  {
   "id": "unsafe-express-173282@major-2024-06-07",
   "gameId": "unsafe-express-173282",
   "displayName": "MAJOR UPDATE - HASTUR INDUSTRIES IS HERE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-07T14:55:59.000Z",
   "notes": [
    {
     "title": "Important Announcement from Hastur Industries",
     "items": [
      {
       "text": "Aspiring workers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "At Hastur Industries, we understand the importance of continuous improvement in the face of evolving challenges. In the spirit of this, we are pleased to announce to you a comprehensive overhaul of the \"UNSAFE\" experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This update includes",
     "items": [
      {
       "text": "Multiple new enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New, unforgiving traps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Over a dozen new tools",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Procedural map generation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Revamped gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upgraded Graphics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We feel that this is a step in the right direction, but will need your help and feedback to optimize, polish, as well as debug the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "THIS IS A CALL TO ALL AVAILABLE PERSONNEL, GET TO YOUR STATIONS AND START TESTING!",
     "items": [
      {
       "text": "We will be happy to read your feedback on our discord server here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hastur Industries Management",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PS.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The old version of the game will always be available on Steam under \"betas\" -> \"oldschool\".",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
