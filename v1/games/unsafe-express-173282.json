  {
   "id": "unsafe-express-173282@major-2021-12-10",
   "gameId": "unsafe-express-173282",
   "displayName": "Update Notes 10/12",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-12-10T16:20:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone! We just pushed an update that includes a lot of Quality of life changes, a bunch of fixes and some work in progress changes. Here's a list of changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that caused the game to not start when inviting people to the lobby.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused players to not be able to revive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Visual upgrade of some ground-floor rooms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added in-game hints/tips for some mechanics of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an intro sequence with some lore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added visual indication of important objective completion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made the lighting a bit more moody and dark, especially in long corridors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for all the reports and your understanding, especially in our discord server! More fixes will be rolled out frequently!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "OnSkull Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
