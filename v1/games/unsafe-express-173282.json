  {
   "id": "unsafe-express-173282@major-2022-06-03",
   "gameId": "unsafe-express-173282",
   "displayName": "Update testing weekend!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-03T17:26:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Great news! We are working hard on finishing a big update for Unsafe's first map, Black Monolith.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update overhauls the game's UI, upgrades graphics and gameplay and (most importantly) fixes a lot of bugs!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As the update time gets closer, we want to invite all of you to try it out and help us test it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Any players that want to have an early peek at the new update can do so by following these steps:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Find Unsafe on your Steam Library",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Right-click -> Properties...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Click on \"BETAS\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enter code \"unsafebeta2022\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select \"testweekend\" from the list above",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wait for the game to update and Play!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will be waiting for your feedback on the Community Forums as well as on our Discord server here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are very excited for this update and hope you are too!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "OnSkull Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
