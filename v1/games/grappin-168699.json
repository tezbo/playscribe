  {
   "id": "grappin-168699@1.0.6",
   "gameId": "grappin-168699",
   "displayName": "Update 1.0.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-13T05:09:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GRAPPIN has been updated! (v1.0.6)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelist",
     "items": [
      {
       "text": "・Fixed an issue where the screen could turn pitch black in the Mysterious Shrine.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Various game balance adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Various adjustments in the game menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Gamepad: the menu can be displayed by pressing the Menu button. (Xbox controller)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "・Gamepad: the left gamepad stick is now supported in the game menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Gamepad: the Relic screen can now be closed with the B button on a gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Gamepad: the Relic screen can now be displayed with the View button. (Xbox controller)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "・Fixed an issue where the menu couldn't be opened in one of the levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Minor bug fixing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any issues with the game, please feel free to join GRAPPIN Discord server!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ahmin",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
