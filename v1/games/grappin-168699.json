  {
   "id": "grappin-168699@1.0.7",
   "gameId": "grappin-168699",
   "displayName": "Update 1.0.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-29T13:49:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GRAPPIN has been updated! (v1.0.7)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelist",
     "items": [
      {
       "text": "・Keyboard: the keys I, J, K, and L are now supported for controlling the character. Right Shift key can also be used for sprint. (for left-handed players)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Note: while a key remap feature is being considered, this fix should offer a more comfortable way for left-handed players to enjoy the game in the meantime.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The difficulty in \"Ancient City\" area has been slightly adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・New confirmation popups have been implemented.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・In-game Control Guides have been adjusted to reflect the left-handed controls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Some adjustments in \"The Peak\" area have been made to improve the visibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Performances in \"Ancient City\", \"Forgotten Ridge\" and \"The Peak\" areas have been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Minor bug fixing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please feel free to join GRAPPIN Discord server!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ahmin",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
