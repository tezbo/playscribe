  {
   "id": "hero-u-rogue-to-redemption-64359@2.1.1",
   "gameId": "hero-u-rogue-to-redemption-64359",
   "displayName": "Update 2.1.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2020-04-09T16:40:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re releasing a new update to fix the Equipment screen and Mac saved game index!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "The Equipment Screen has been fixed. Dragging and dropping to remove your gear will now work as expected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix to the Save and Load screen; the top save will automatically appear in the preview window.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix to the vignette image that appears when examining a dead body in the Sea Caves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix to the lighting outside the tomb in the Dungeon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix to the Spark runestone visual effect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix to the Mac version not referencing old saved games. The files are still there, but weren’t referenced in the index.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Keep us posted on Discord, or support@hero-u.net if you run into any more issues!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Team Transolar Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
