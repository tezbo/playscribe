  {
   "id": "hero-u-rogue-to-redemption-64359@3",
   "gameId": "hero-u-rogue-to-redemption-64359",
   "displayName": "Patch 3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2018-10-04T00:50:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "There is a new patch, primarily to fix 16:10 monitors and the Fitness ability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes include",
     "items": [
      {
       "text": "The game now supports 16:10 ratio monitors properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Statistician achievement now works properly with 100 Fitness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We've fixed some typos and improved some game text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The final \"endgame\" combat is more challenging now, as the boss avoids all traps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Occasional camera problems after combat have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We have not yet changed the Wraith combat. It will be a much more dangerous battle in a future patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
