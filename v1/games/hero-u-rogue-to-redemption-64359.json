  {
   "id": "hero-u-rogue-to-redemption-64359@1.5",
   "gameId": "hero-u-rogue-to-redemption-64359",
   "displayName": "Update 1.5",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2019-02-21T01:56:40.000Z",
   "notes": [
    {
     "title": "Version 1.5 of Hero-U: Rogue to Redemption released!",
     "items": [
      {
       "text": "We have just released Version 1.5 of Hero-U: Rogue to Redemption. This is a small change in nomenclature – We might have called it Patch 5 previously – but it contains some big quality of life improvements to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphical version of this announcement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Version 1.5 includes",
     "items": [
      {
       "text": "Added a version label to the Start Menu, especially for GOG players who do not get automatic updates.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixes to the “pacifist” route against the Wraith King.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Using the Null runestone against the Wraith King will now behave more logically.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thomas can only be given the One and Only Ring once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cleaned up an inconsistency with “Lockpicking” and “Tool Use” in the user interface.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved appearance of the Tentacle Monster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tweaked sound effects and particle effects on monsters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix combat bug with traps and messages not reporting the same damage amount.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Cloaker in the Catacombs now properly registers as magical.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Only allow Shawn to greet the Librarian once per day.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes to bulk sales of the Dried Fish and Empty Wine Bottles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweak to early game quests and sound effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix nonsensical tooltips for some late-game monsters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hundreds of typos and minor scripting bugs, pointed out by our players on Steam and on the forums. Thanks, everyone!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A newer, shinier Tentacle Monster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam will automatically update Hero-U: Rogue to Redemption to the latest build when you start the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
