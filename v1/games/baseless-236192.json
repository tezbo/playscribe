  {
   "id": "baseless-236192@1",
   "gameId": "baseless-236192",
   "displayName": "Hotfix 1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-12-12T00:01:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "🧣 Howdy howdy! Andrew here, the solo-dev of Baseless.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been one week since launch and my cheeks hurt from smiling while reading all your shining reviews so far. If you haven't left a review yet, please consider it - it really helps me out. 💛",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Something more exciting may be cooking for the future, but for now here's a quick Hotfix patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v1.2512.10.1 Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "// 🐛 Bug fixes",
     "items": [
      {
       "text": "✅ Fixed issue with Djough's fishing side quest sometimes not completing, sorry Guppy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✅ Fixed issue where Zone 2's boss fight (Khanductor) Zone Orb could get stuck in a wall in last train car, causing soft lock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✅ Fixed Zone 4's Sticky Boss fireball crash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✅ Fixed Seedcret typo \"longs too inhale\", whoops!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✅ Removed inaccurate mission brief in Drowned Foundry (Zone 5, Stage 2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✅ Fixed Chapter 2's intro monologue sequence sometimes happening more than once",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✅ Fixed unintended music volume dip during some stage intros",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "// 📊 Optimization",
     "items": [
      {
       "text": "✅ Disabled edge blur shader on \"Low Graphics\" mode which was causing fps issues on lower spec machines (if you are still having issues, contact me)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "// ✨ QOL / Polish",
     "items": [
      {
       "text": "✅ Clarity on 1st Zone's Seedcret",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Minigame / 3-Star doors visual upgrade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Lessened overall edge blur shader strength (when bubbled or swimming)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And a special thanks to anybody reporting issues, I'm doing my best to squash any and every bug! Keep 'em coming here if you spot any more issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Andrew // @FermenterGames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
