  {
   "id": "baseless-236192@major-2026-03-18",
   "gameId": "baseless-236192",
   "displayName": "LEADERBOARD UPDATE!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-18T14:05:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Baseless is getting a new competitive edge: Introducing LEADERBOARDS!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Go hard and solidify your rank within the community’s sharpest shots! But that's not all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition to proving your mettle in the zones, you'll get the chance to put you money where your, er... thumbs are!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "From now until 10:00am PST on April 9th, the top three players on the Zones Combined board have the chance to win cash prizes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The top spot: $200 USD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Second place: $50 USD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Third place: $25 USD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you're in one of the top 3 spots at 10:00am PST on April 9th, reach out to Andrew on Steam or The First Break Labs team on Discord so we can verify your win. Have you got the skills to pay the bills?",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "*Only 18 and older may enter. Terms and conditions apply.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
