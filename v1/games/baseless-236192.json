  {
   "id": "baseless-236192@4",
   "gameId": "baseless-236192",
   "displayName": "Hotfix 4",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-12-24T10:07:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "v1.2512.24.1 Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "// ✨ Polish",
     "items": [
      {
       "text": "✅ Extra visual pizzaz on the Hornucopia equip menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "// ⚖️ Balance",
     "items": [
      {
       "text": "✅ Rebalanced \"Synergy Guard\" scarf enhancement - Buffed base % bonus from 4%->6%, but added short 0.75s cooldown between instances of possible block bonuses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "✅ Buffed \"Scavenger\" scarf enhancement - Base % bonus from 3%->4%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "✅ Greater distance lenience for Scout's \"bubble dash in near danger\" side quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "// 🐛 Bug fixes",
     "items": [
      {
       "text": "✅ Fix crash with explosive barrels destroying before born",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✅ Fix crash when using \"railer\" weapon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✅ Optimized railgun/beamer code",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✅ Less bright bloom during slomo while using Time Thief horns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "And a special thanks to anybody reporting issues, I'm doing my best to squash any and every bug! Keep 'em coming here if you spot any more issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Andrew // @FermenterGames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
