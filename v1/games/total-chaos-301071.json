  {
   "id": "total-chaos-301071@major-2026-07-24",
   "gameId": "total-chaos-301071",
   "displayName": "Retro Mode Update | Now Available!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-24T11:51:07.000Z",
   "notes": [
    {
     "title": "The Retro Mode Update is Available Now",
     "items": [
      {
       "text": "The nightmare is remembering.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44984194/901f97fff03fa0aa2f79195959ea17416e942024.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Retro Mode Update has arrived for Total Chaos, bringing players back to the game's award-winning DOOM II roots while introducing new content and quality-of-life improvements across every platform.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Experience Fort Oasis through a new low-fi visual style inspired by the original Total Chaos total conversion mod. Retro Mode features pixelated post-processing, classic-inspired visuals, and monsters recreated using assets from the original DOOM II WAD, transforming the island into a haunting tribute to its origins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44984194/540ec63eacbb4d57af8c24b2ccf839e5f93dba3f.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Retro Mode",
     "items": [
      {
       "text": "Relive the horror with pixelated visuals, reduced texture resolution, low-poly monsters, and classic-inspired post-processing effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Game+ Epilogue",
     "items": [
      {
       "text": "Uncover a brand-new fifth ending that expands the story for those brave enough to complete the New Game+ Epilogue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Map & Location Markers",
     "items": [
      {
       "text": "Navigate Fort Oasis more easily with an in-game map and location markers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Save Time Tracking",
     "items": [
      {
       "text": "Save files now display your total playtime, with an optional in-game HUD timer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Garbage Chute",
     "items": [
      {
       "text": "Store unwanted items in the new garbage chute and retrieve them before the chapter ends.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Forgotten Chapter Improvements",
     "items": [
      {
       "text": "The Protector encounter has been reworked to provide a smoother experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44984194/960622a0a5867e1ca026ac54e3d6793da9466656.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Whether you're returning to Fort Oasis or stepping onto the island for the first time, there's never been a better time to descend into the nightmare.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Retro Mode Update is available now on all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/2208350/Total_Chaos/\"]Stay up to date with Total Chaos by following @PlayTotalChaos and @Apogee_Ent on Twitter/X. Join the Apogee Discord to connect with other survivors, share your stories, and prepare for what comes next.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The island is always watching.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
