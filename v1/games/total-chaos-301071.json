  {
   "id": "total-chaos-301071@major-2026-03-16",
   "gameId": "total-chaos-301071",
   "displayName": "Total Chaos: New Game+ Free Update Now Available",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-16T12:55:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The nightmare does not end.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "It evolves.",
     "items": [
      {
       "text": "Today, Total Chaos receives its largest update yet with the launch of New Game+, a free update available now across PC and console.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This brutal remix of the original experience expands the story, introduces a terrifying new stalker enemy, and pushes players deeper into the nightmare of Fort Oasis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Game+ Has Arrived",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44984194/b6dc1249c0d6ba80c30b3380b3f0c6ff8f9c76d4.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Game+ reimagines the first seven chapters of Total Chaos, twisting familiar locations into far more hostile gauntlets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Each chapter now begins with a warning",
     "items": [
      {
       "text": "Something has been unleashed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "At the center of this new mode is The Hunter, a relentless stalker that tracks your movements across the island. Once it finds you, there is no stopping it. Survival depends on speed, awareness, and quick decision-making.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Game+ culminates in a brand-new final chapter",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44984194/03fac74289af0fb89cdf92423709dedb7ee95446.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Chapter 8 – Reckoning",
     "items": [
      {
       "text": "This new chapter expands the narrative and introduces a new ending that reveals more about Fort Oasis, its collapse, and the truth behind the protagonist’s descent into the island.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44984194/1abfcbd1a8a5f660ba0ea6fef9227780629974f8.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What’s New in the New Game+ Update",
     "items": [
      {
       "text": "• New Game+ mode remixing the entire campaign",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Chapter 8 – Reckoning, a brand-new final chapter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• The Hunter, a persistent stalker enemy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Expanded story content and alternate ending",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• New enemy-specific death animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• New locations throughout Fort Oasis",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Retro Tyler Voice Option from the original DOOM II mod",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• 4 additional save slots (8 total)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44984194/a59e9a55918fc0a03bf9c0101526e9f573d1e8ee.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Additional Improvements Since Launch",
     "items": [
      {
       "text": "Since Total Chaos launched on consoles in November, the team has continued improving the experience through multiple updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Recent improvements include",
     "items": [
      {
       "text": "• Improved framerates in Performance mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Expanded language support including French, German, Spanish (LatAm), Polish, Portuguese, Turkish, Russian, Korean, Japanese, and Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Controller vibration support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Numerous gameplay fixes and quality-of-life improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Combat and AI balancing updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Improved destructible environment feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Expanded stun mechanics for several enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44984194/330865f94c1e3f2094edde161184de84455517d0.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "These updates are available now for all players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Total Chaos is available now on Steam, Xbox Series X|S, and PlayStation 5. Physical PlayStation 5 edition is also available through Atari, Infogrames, and Clear River Games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44984194/c4899aafdf2867baad67712ff4e625d9ac90611a.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Buy the PS5 Physical Edition",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "The island is always watching.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/2208350/Total_Chaos/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
