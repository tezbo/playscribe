       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Implemented known hacker ban list",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Insight Aim setting defaults to 'On' (Insight Aim only ever applies while using gamepad)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"dontUploadToLeaderboard\" option to powerprefs.txt. This prevents your game from submitting any scores to leaderboards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed issue that caused BGM to play multiple instances at once",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed certain cases that made the last Heavenly Delight ticket unobtainable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some movement exploits that were possible only at super-low framerates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed numbers from Heavenly Delights prize board graphic (This was confusing some players into thinking the numbers were ticket cost values rather than the order of the delights)",
