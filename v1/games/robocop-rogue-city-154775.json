  {
   "id": "robocop-rogue-city-154775@03",
   "gameId": "robocop-rogue-city-154775",
   "displayName": "Patch 03",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-27T15:28:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've just pushed a third patch, fixing crashes and other issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "All platforms",
     "items": [
      {
       "text": "Fixed 22 crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor environmental fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localization updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PC only",
     "items": [
      {
       "text": "You can now choose the reflection method between Lumen and Screen Space Reflection.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Automatic DLSS choice has been removed. The default setting is set to TAA.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Small fix for Lumen reflections.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Follow our socials for more",
     "items": [
      {
       "text": "Discord Twitter Instagram Facebook Website",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
