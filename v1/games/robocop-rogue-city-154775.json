  {
   "id": "robocop-rogue-city-154775@post-2025-07-20",
   "gameId": "robocop-rogue-city-154775",
   "displayName": "Patch Notes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-20T16:29:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello all,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Earlier this week, we pushed a new patch for RoboCop: Rogue City, these were some small changes, but required the files to be reconfigured, which is why the patch seems so large.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "RoboCop: Rogue City Patch Notes",
     "items": [
      {
       "text": "Shader Creation Initial Screen,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game Crash Fixes,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix when starting New Game Plus with language set to Italian,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Intel XeSS Updated to 2.0.2,",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Other game fixed and optimisations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you're enjoying your time in Old Detroit, and if you're checking out RoboCop: Rogue City - Unfinished Business, we hope you're having a great time!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
