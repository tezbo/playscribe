  {
   "id": "moonscars-194507@1.5.004",
   "gameId": "moonscars-194507",
   "displayName": "Update 1.5.004",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-03T19:19:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've listened closely to your feedback, and we're excited to announce this update which focuses on late game improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gilded enemies reworked: Instead of a permanent resistance to sword attacks, Gilded enemies now will have a magic shield that will be destroyed by a single Spell. Once the shield is broken, the enemy will receive weapon damage as normal.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lajos Boss got nerfed and also will be affected by the new Gilded magic barrier. This should make fighting him more intuitive, and feel less like grinding ichor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Parry system update: adjusted which enemy attacks can or cannot be parried. The unparriable attacks will now have a Blue Eye effect for clarity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed many freezes when fighting some large enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chokran Boss nerfed a bit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Childspawn Spell improved: now it will properly attack airborne units and bosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a progress blocker in Earth Bowels, where a door wouldn't open after a broken mirror.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other miscellaneous fixes and performance improvements overall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
