  {
   "id": "moonscars-194507@1.6",
   "gameId": "moonscars-194507",
   "displayName": "Update 1.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-20T21:16:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're happy to announce the v1.6 patch which introduces 3 new languages, 2 new Special Weapons, and a lot of small improvements and bugfixes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "You can read a more detailed list below",
     "items": [
      {
       "text": "Added support for Ukrainian, Brazilian Portuguese, and Turkish languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Introducing two powerful Special Weapons:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Scimitars: An efficient way to deal with airborne enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gauntlet: A good way to keep enemies at a safe distance with a strong blow!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discover two new amulets that will enhance your experience, whether you're struggling, or you want a tougher challenge:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved inventory items:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Breakable Amulets will leave behind Leftovers, which can be sold back to The First One.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Memory Moulds can be reused to repeatedly listen the lore-discovering dialogues with Vladyslava.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the Map with various additions. New icons added for Upgrades, Collectibles (Adelinka's Earrings), and Locked/Unlocked states for Doors and Flesh Walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Superdash: Altered its input mechanics to avoid accidental triggering during combat. Also added the Up button as an alternative to the Jump button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
