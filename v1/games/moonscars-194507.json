  {
   "id": "moonscars-194507@1.4.007",
   "gameId": "moonscars-194507",
   "displayName": "Update 1.4.007",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-11T20:05:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It’s been one month since release and we’ve been hard at work on Moonscars while listening to your feedback. We’re happy to announce this update and hope it will improve your experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Controller rebinding option added, fixed old input rebinding bugs.: DualShock support can be toggled in the menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Navigation map completely overhauled. Added markers and other fixes related to it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new type of Dark Mirrors introduced. Now only rare, CORRUPTED mirrors require sacrificing in order to be unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moonhunger system modified - now for it to activate, the player has to achieve at least 3 Spite Levels before dying.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Mirrors gland drop bonus now costs Bone Powder instead of Glands.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spells mana cost, upgrade costs and timings are better balanced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Late-game balancing, including the boss Lajos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial parts improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Multiple general fixes leading to soft locks or progression stopping.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate the feedback, and we'll continue working on the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
