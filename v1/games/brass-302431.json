  {
   "id": "brass-302431@post-2025-06-24",
   "gameId": "brass-302431",
   "displayName": "Patch Notes: A livelier look for dialogue, and more freedom in graphics settings",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-24T01:04:02.000Z",
   "notes": [
    {
     "title": "Subtle animation added to dialogue bubbles",
     "items": [
      {
       "text": "Character dialogue now features gentle movement. It’s a small touch, but it helps make conversations feel a little more lively and natural.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Cloud sync for graphics settings disabled",
     "items": [
      {
       "text": "Since sharing the same graphics settings across PCs with different performance levels doesn’t make much sense, we’ve disabled cloud sync for these settings. This allows each PC to use graphics settings that best suit its own environment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🛠 For advanced users",
     "items": [
      {
       "text": "If you’d like more fine-grained control, you can manually edit the following file to customize resolution, effects, and other settings:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "%USERPROFILE%\\AppData\\Local\\Umi\\Saved\\Config\\Windows\\GameUserSettings.ini",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
