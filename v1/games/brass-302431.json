  {
   "id": "brass-302431@major-2025-07-24",
   "gameId": "brass-302431",
   "displayName": "Patch Notes: Minor Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-24T08:48:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update is a small one, but it brings a few subtle improvements to the story and overall feel of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🛠 Improved Story Experience",
     "items": [
      {
       "text": "Some cutscenes have been adjusted to make the flow of the story feel more natural.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A few new cutscenes have also been added to help deepen the characters and their backgrounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔊 Sound Additions",
     "items": [
      {
       "text": "We've added several sound effects to cutscenes (using Soundly), bringing more life and atmosphere to character movements and scene changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🐞 Other Fixes",
     "items": [
      {
       "text": "A handful of minor bugs have been fixed. If something felt a little off before, you might notice things running a bit smoother now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
