  {
   "id": "brass-302431@major-2025-11-04",
   "gameId": "brass-302431",
   "displayName": "Brass Update: Korean Language & Improved Accessibility!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-04T06:25:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're excited to announce that Brass now fully supports the Korean language! We hope this allows even more players to enjoy the game in their preferred language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45032089/9eaad142f464422c93ff450e8197e874131b4fb5.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To make your experience even smoother, we've also improved the Title and Settings menus. You'll now find it much easier to locate and adjust language settings, regardless of the currently displayed language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45032089/bd72c7d330ea6db8e11b460e95c0cb0bbdcc2e91.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
