  {
   "id": "brass-302431@major-2025-09-29",
   "gameId": "brass-302431",
   "displayName": "Patch Notes: Achievement Improvements & Price Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-29T09:34:11.000Z",
   "notes": [
    {
     "title": "This update includes",
     "items": [
      {
       "text": "Added new achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can now go back for achievements even after finishing the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Pssst…) Price has been significantly reduced → $5.99",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tips",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "How to go back for achievements after finishing the game",
     "items": [
      {
       "text": "Select Continue from the title screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ignore the character in front of you and move left",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You’ll return to the previous stage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy the relaxing postal adventure at your own pace ✉️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
