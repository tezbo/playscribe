  {
   "id": "brass-302431@major-2025-05-31",
   "gameId": "brass-302431",
   "displayName": "Update: Italian and Brazilian Portuguese Now Supported!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-31T04:14:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ciao! Olá!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello to everyone visiting the village of Brass.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you're enjoying your time at a gentle, relaxing pace.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this update, we've added support for Italian and Brazilian Portuguese!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now even more players can experience the story of this little village in their own language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "No matter the words, warm feelings always find their way through.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
