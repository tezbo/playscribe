  {
   "id": "brass-302431@post-2025-05-02",
   "gameId": "brass-302431",
   "displayName": "Patch Notes: Graphics Quality Settings",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-05-02T10:39:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve added a new “Graphics Quality” option to the settings menu, allowing you to choose between Low, Medium, and High settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you find the game is running slowly, try setting this option to Medium or Low.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Previously, the game defaulted to High quality. Starting with this version, Medium is now the default setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve also made various small fixes and adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
