  {
   "id": "dungeons-and-ducklings-294319@major-2024-08-23",
   "gameId": "dungeons-and-ducklings-294319",
   "displayName": "Demo Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-23T04:21:05.000Z",
   "notes": [
    {
     "title": "Lots of exciting new updates to the Dungeons and Ducklings demo",
     "items": [
      {
       "text": "Full original soundtrack has been added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adorable intro cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fully voice acted dialogue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New enemies, including the Minotaur!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Brand new traps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Brand new hats and better hat art",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Zone 2 has been added after the first boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Settings menu allows volume adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "UI updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "It has been really exciting adding all of these new features to the game. More bosses, enemies, traps, player gear, and more is in the works.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "I can't wait show off some of the Library that contains an adorable Panda Bear Librarian. Panda helps you learn about enemies, and the lore of the world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you all for playing the demo. I could use your help to spread the word about this indie game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
