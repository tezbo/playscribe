  {
   "id": "dungeons-and-ducklings-294319@patch-2024-12-23",
   "gameId": "dungeons-and-ducklings-294319",
   "displayName": "Endless Mode Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-23T05:01:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added an Endless Mode after the True Ending is unlocked!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The coin amount above the players head now shows the amount of coins you get with the current combo multiplier. This makes the number above your head accurate to what you are actually getting as currency to spend in the store",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bosses no longer coins on death, instead the amount just goes right into your total coins and appears above the players head. This helps fix frame drops due to too many coin objects moving at once, and it fixes the issue that could cause you not to collect coins if the boss died outside of the maze.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There is now a little red meter next to your combo that lets you know how long you have until the combo goes away",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When getting an equipment upgrade, it will no longer select gear that is at max level, and will only upgrade items that can use upgrades.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bosses can no longer spawn on left and right maze chunks. The game will wait until you make it to a corner chunk, and then the boss will spawn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Getting stuck in Slow Mo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Audio glitch with Bush Monster and Enemy Death Noise",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Boss meter being full but boss never spawns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
