  {
   "id": "dungeons-and-ducklings-294319@major-2024-11-12",
   "gameId": "dungeons-and-ducklings-294319",
   "displayName": "Final Demo Content Update before Release",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-12T22:56:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Quack Quack,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bad news first. to prepare for the full release of the game, this update had to reset demo progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The demo has been updated with lots of features and bug updates to prepare for the full game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Release date announcement coming soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New features!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Traps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Each level has several different color palettes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rebalancing of the store and enemy spawns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Im so excited for the full games release. Thank you for all of the support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
