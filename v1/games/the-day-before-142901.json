  {
   "id": "the-day-before-142901@major-2023-12-12",
   "gameId": "the-day-before-142901",
   "displayName": "Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-12T01:57:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Community,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would like to provide with an update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are sorry for the fact that the game didn’t meet the expectations of the majority of the players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we are working with Steam to open up refunds for any players who choose to make a refund.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ll give further updates in the nearest future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
