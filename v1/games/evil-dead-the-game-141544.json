  {
   "id": "evil-dead-the-game-141544@major-2023-04-26",
   "gameId": "evil-dead-the-game-141544",
   "displayName": "Game of the Year Update is now available!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-26T12:10:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "💓 The Game of the Year Edition is here! It’s packaged with the base game and a variety of goodies from all 6 DLCs and more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🪓 New Survivor – Brock Williams: Ash’s old man himself, Brock is immune to knockbacks and has several auras he can unleash to help his squadmates. These auras change dynamically based on how many Williams family members are on the team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "😈 New Demon – Schemer: Based on the notorious demon boss Baal, the Schemer is a trap specialist who confuses Survivors with illusions. His Meat Puppets inflict increased damage with a variety of attacks based on the fear levels of the Survivors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "💅 New outfits for Amanda, Ash, and Pablo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Added Japanese and Korean language support (Xbox Series X | S, Xbox One, Epic Games, and Steam).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "All weapon mastery statistics will now be displayed in the skill tree.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Free Content",
     "items": [
      {
       "text": "New Weapons: Pipe & Submachine Gun",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Mission: Kelly fights Eligos in “Stalking in a Winter Wonderland”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Outfit: Kelly’s “Stay Frosty” Outfit can be acquired by completing the “Stalking in a Winter Wonderland” mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Premium Content",
     "items": [
      {
       "text": "You can purchase the following in the “Who’s Your Daddy” Bundle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Demon: Schemer Class, Baal with his Skinned Proselyte and Meat Puppets minions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Survivor: Brock Williams.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Outfits:",
       "ps5ProOnly": false,
       "pcOnly": false,
