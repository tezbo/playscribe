  {
   "id": "evil-dead-the-game-141544@post-2023-08-16",
   "gameId": "evil-dead-the-game-141544",
   "displayName": "August 16, 2023 - Patch Notes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-08-16T12:17:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Survivors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Brock Williams’s “Master of Influence” perk now buffs his aura correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Brock Williams’s healing bonus per non-family member for the “Blood Ties” ability decreased from 5% to 4%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Brock Williams’s damage reduction per family member for the “Blood Ties” ability decreased from 5% to 4%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Brock Williams’s fear reduction per leader for the “Life of the Party” ability decreased from 10% to 8% (for Prestige, from 12% to 10%).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Brock Williams’s melee damage per warrior for the “Life of the Party” ability decreased from 10% to 8% (for Prestige, from 12% to 10%).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Brock Williams’s ranged damage per hunter for the “Life of the Party” ability decreased from 10% to 8% (for Prestige, from 12% to 10%).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Brock Williams’s cooldown reduction per support for the “Life of the Party” ability decreased from 10% to 8% (for Prestige, from 12% to 10%).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Demons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Schemer is now unable to force Survivors into activating traps when using Survivor's dodge before unpossessing and cycling the possessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Ranged weapons will no longer stop inflicting damage and playing gunshot sounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The ping wheel now will not get stuck in the middle of the screen when used during the crate trap animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Various environment and player collision fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-General localization fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
