   "id": "evil-dead-the-game-141544@major-2025-04-30",
   "gameId": "evil-dead-the-game-141544",
   "displayName": "An update regarding Evil Dead: The Game",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-30T15:09:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We can confirm we've begun the process of removing the game from digital storefronts. Anyone who has purchased the game will still be able to play it as we plan to keep our servers online for everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We want to extend a sincere thank you to our community, to those who have been part of the game from the very beginning, and those who have recently joined us. We appreciate all of your support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
