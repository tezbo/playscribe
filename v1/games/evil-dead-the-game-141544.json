  {
   "id": "evil-dead-the-game-141544@post-2023-05-17",
   "gameId": "evil-dead-the-game-141544",
   "displayName": "May 17, 2023 - Patch Notes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-05-17T12:17:48.000Z",
   "notes": [
    {
     "title": "New Features",
     "items": [
      {
       "text": "Players who complete/have completed all missions will get the remaining two Knowby Tapes, unlocking the complete story of Professor Knowby.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Survivors",
     "items": [
      {
       "text": "Survivor icons are updated in the pop-up map during the Mass Paranoia ability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Survivors no longer detect Baal during \"Peekaboo\" ability by the sound of his steps or voice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Survivors now receive fear after dodging the trap’s activation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hunter's \"Lone Wolf\" ability will no longer be inactive if only dead teammates are around the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Demons",
     "items": [
      {
       "text": "Demon units will no longer miss hits on the Necronomicon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Baal can no longer chain possess Survivors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Baal no longer has Support Ash's Marked Target and Kelly's Countershot ability effect during Peekaboo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now Power Possess ability doesn't get cooldown after the usual possession if the respective button was pressed without the target before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Demon traps no longer stop working after unpossessing a survivor and letting him activate the trap.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Demon no longer receives increased damage while possessing a survivor marked by \"Manhunter\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buttons for opening and placing proximity portals are correctly displayed in the HUD when the demon unpossesses the vehicle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Witch can no longer cancel the slow-down delay after an attack by a particular button combination.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Deadites downed with finishers will no longer perform a small jump on the ground.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The \"vanishing\" effect of the demon now appears when exorcized from a page/dagger objective.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The VFX of the evil tree will no longer disappear for the demon after the first possession.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Demon no longer sees the colored beam above the Survivor's items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "Leader Ash’s voice lines for killing Baal are now correctly played.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the tutorial, hand axes over the table now have a natural spawn location.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weapons are now unable to spawn vertically.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "SMG and Grenade Launchers are now included in Handgun and Special ammo descriptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hair physics no longer misbehaves when exiting cars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weapons can no longer twitch on the character's back after getting out of the car.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The supply crate mark will no longer disappear when all players near it move to another map location.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Soul-calling voice lines will no longer be played in the Necronomicon phase if the player carries them in inventory before entering this stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Eligos’s neck will no longer unnaturally stretch if shot with a shotgun in the 8th Mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with some players fighting invisible deadites.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various localization fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balance Changes",
     "items": [
      {
       "text": "Brock Williams’s healing bonus per non-family member for ability “Blood Ties” decreased from 7% to 5%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Brock Williams’s damage reduction per family member for ability “Blood Ties” decreased from 7% to 5%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Game Crashes",
     "items": [
      {
       "text": "If you're experiencing game crashes with Evil Dead: The Game, we recommend reviewing our guide and following the steps: https://support.saber.games/hc/en-us/articles/8630856292369-Evil-Dead-The-Game-Crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Experiencing issues after going through the steps of the above guide? Don't hesitate to contact our support team: https://support.saber.games/hc/en-us/requests/new",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
