  {
   "id": "candy-rangers-265694@1.0.3.2",
   "gameId": "candy-rangers-265694",
   "displayName": "Update 1.0.3.2",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-05T08:14:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patched the boss not saving your medal and memory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have played the boss already and didn't get the rewards, go to",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "C:\\Users-User-AppData-LocalLow-Mechano-Candy Rangers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Find the .CandyRangers file and open it with notebook",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adding these two lines should do the trick",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "area_tower-bossmedal0_bool: True",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "area_tower-bossmemory_bool:True",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
