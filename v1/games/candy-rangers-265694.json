  {
   "id": "candy-rangers-265694@1.0.4",
   "gameId": "candy-rangers-265694",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-16T16:16:55.000Z",
   "notes": [
    {
     "title": "Made a few QoL changes to make things clearer",
     "items": [
      {
       "text": "Added a dash prompt next to the can in est-2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed Dash prompt to Dash Jump prompt in Coast-Boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Moved triggers in Tower-2 to avoid clipping issues when dashing out of an elevator.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Credits music now stop when skipping them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The bridge in pop-5 is now inactive until players have stopped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other small fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
