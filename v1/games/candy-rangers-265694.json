  {
   "id": "candy-rangers-265694@1.0.3.5",
   "gameId": "candy-rangers-265694",
   "displayName": "Update 1.0.3.5",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-06T19:38:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed boss 4 exploit breaking arcade mode. To be clear, the exploit is still there but now it shouldn't break arcade mode progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The game now checks for achievements in the extras screen too, this should fix some achievements only triggering after rebooting the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Medal requirements have been lowered again in Poplars. Poplars-5 is no longer medal locked and Estuaries-1 and Poplars-Boss got lowered down by a couple of medals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
