  {
   "id": "easy-delivery-co-330673@major-2026-07-06",
   "gameId": "easy-delivery-co-330673",
   "displayName": "Easy Delivery Co. Free Update - EasyCo EasyRally Out Now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-06T13:55:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today is the day! Welcome to EasyCo EasyRally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This game mode let’s you rediscover the the world of Easy Delivery Co. in an alternate, re-imagined version of the game featuring:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New rally style driving physics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Time trial races with cinematic replays",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New music tracks by Sohaoying",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Approximately 1.5 new maps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is a FREE update to the base game, focusing on new driving physics. Please view this as an alternate way to explore and play EDCo, and not a continuation of the story. For more info on the update check out the previous post:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/news/app/3293010/view/678502350181106460\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have an Easy day!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
