  {
   "id": "easy-delivery-co-330673@1.08a",
   "gameId": "easy-delivery-co-330673",
   "displayName": "Patch 1.08a",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-09-23T15:15:04.000Z",
   "notes": [
    {
     "title": "patch v1.08",
     "items": [
      {
       "text": "cookpot should no longer cease to exist",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "adjusted road signs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "you can make new save files again",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "save system tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "AND patch v1.08a",
     "items": [
      {
       "text": "fixed save file issue for certain regions: If you were effected by the save file issue, here's how you can fix it: Head to C:\\\\Users\\\\YOUR_USERNAME\\\\AppData\\\\LocalLow\\\\SamC\\\\EasyDeliveryCo: in file explorer and edit the save file with notepad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "You'll have to edit the fields",
     "items": [
      {
       "text": "'deliveryMoney:'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "and 'deliveryFuel:'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For fuel place a '.' after the first one or two numbers (eg: \"7040854\" should be \"7.040854\")",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And same goes for money (eg. \"1415134\" should be \"14.15134\")",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save, and relaunch the game and it should be fixed :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have an Easy day! (and so sorry for the trouble!!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
