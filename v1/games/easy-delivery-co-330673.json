  {
   "id": "easy-delivery-co-330673@1.12b",
   "gameId": "easy-delivery-co-330673",
   "displayName": "Patch 1.12b",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-05T18:05:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "patch 1.12b: Simplified Chinese & Old font",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simplified Chinese support is finally here! The readability of the font is questionable, I'm very very sorry! This was the best pixel font I could find that supported all of the characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have also added an option to use the old font again for English. Unfortunately its not as simple as \"swapping the font\" all the text is a custom system and its placed very precisely so supporting two fonts is a challenge, but I was able to hijack the new system to use the old font (hopefully nothing is broken)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have an Easy day!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
