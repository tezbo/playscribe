  {
   "id": "kreaturekind-152194@1.0.17",
   "gameId": "kreaturekind-152194",
   "displayName": "Patch 1.0.17",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-01T15:00:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Made sure settings save even before choosing a save slot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you lose the encounter when trying to recruit an activist, they should no longer be unlocked anyway",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved flow when choosing not to use an Ability card with slots. It should now be more clear how they work and you can return them and the infused cards easily to hand",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rebalanced \"HoT\"/\"DoT\" cards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made tutorial encounters slightly easier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made sure clouds don't get stuck overhead when an activist gives up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resetting a save now resets which opponents you have talked to properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed visual issue with end of encounter screen backgrounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed visual issue with Mitra's coat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased text border size (it had been decreased due to some font changes)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
