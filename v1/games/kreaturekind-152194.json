  {
   "id": "kreaturekind-152194@1.1.04",
   "gameId": "kreaturekind-152194",
   "displayName": "Patch 1.1.04",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-07-01T10:33:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue where you could get stuck in loading screen after failing an encounter, if you play with a controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where you could press things behind intro cinematic when starting a new game (also when using controller)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Going back/forward in dialogue now displays the same activist as talking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Monsters could in some cases get stuck throwing the same card over and over again. Should no longer be happening!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In upgrade screen, the cards that cannot be upgraded will now be visible but blocked to avoid confusion. Also some cards previously not upgradable can now be upgraded",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some plushies' effects were not disabled when stolen, so I fixed that",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
