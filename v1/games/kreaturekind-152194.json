  {
   "id": "kreaturekind-152194@1.1.05",
   "gameId": "kreaturekind-152194",
   "displayName": "Patch 1.1.05",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-07-03T16:04:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The effect of base cards (heal, deal, block, prep) can now be clearly seen in the top part of the cards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you feel like the HP bars are too cuttered, there's now a button to hide the icons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Combo now has the correct hover text, and is described in the legend",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"Paint into a corner\" now only costs 1 energy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Assistants can now cast curse cards on activists",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Language will now be determined based on OS on first opening the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Description for how Attention works is now in the tutorial, and the Legend",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Curse cards put into opponent decks are now properly cleared out after they are cast",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can no longer get the 20 block achievement due to an opponent stacking Block (sorry)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
