  {
   "id": "kreaturekind-152194@1.0.23",
   "gameId": "kreaturekind-152194",
   "displayName": "Patch 1.0.23",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-07T13:59:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I have heard you! You can now change the VO volume separately from SFX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There was an issue with the 7 plushie achievement, which has now been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In rare occasions, the dialogue UI could get stuck at the bottom of the screen. It has been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Carnival music should no longer overstay its welcome",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can no longer open the currently unused dialogue log with controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mummy now has a voice",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gelatine cubold has gotten some new materials",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
