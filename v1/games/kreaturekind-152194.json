  {
   "id": "kreaturekind-152194@1.2.0",
   "gameId": "kreaturekind-152194",
   "displayName": "Patch 1.2.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-08-14T10:06:32.000Z",
   "notes": [
    {
     "title": "Updates in this patch",
     "items": [
      {
       "text": "The card descriptions have been simplified, making them easier to understand at a glance with clear icons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There is now an explanation of each part of the card when you hover it. This can be turned off with the icon on the card, if you don't like it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There was an issue with the pause menu when playing with controller, which has been resolved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game should now be less likely to crash unexpectedly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When you start dragging card, the wrong (X) was shown sometimes - this is now fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Target arrow used to get stuck on screen, which is no longer the case",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You are now reminded when you have a new plushie",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Undo button has been moved in the end of encounter screen, to decrease risk of clicking it accidentally",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
