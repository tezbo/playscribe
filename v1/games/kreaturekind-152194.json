   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-20T10:20:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "When you're playing with controller, there is now a handy arrow which makes it more clear which opponent/activist you're targeting with a card",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where Luca's plushies didn't work if he was unlocked before Finley (long story)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the hover effect on HP bars stuck around after a card was cast with controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The next node in the encounter map should now be seleted for you when you use a controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where VO volume sometimes didn't load properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "To make it more clear when you can unlock a new activist, the Encounter node is now turned off when it's unavailable, and has a NEW marker when you can go it it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
