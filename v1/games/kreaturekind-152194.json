  {
   "id": "kreaturekind-152194@1.1.03",
   "gameId": "kreaturekind-152194",
   "displayName": "Patch 1.1.03",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-24T09:23:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The X overlay no longer remains after the end of the encounter, which could look confusing when entering the next one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Play speed is now reset at the end of encounter, meaning if you speed up and encounter ends on opponent's turn you will no longer have a SPEEDY wanderbeast in the encounter map (sorry)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The outro audio should now be in synch with the text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There is not a warning before the final encounter that save will be wiped if you complete the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pixie legs are now just a little less stiff",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
