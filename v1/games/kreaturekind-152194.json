  {
   "id": "kreaturekind-152194@1.0.21",
   "gameId": "kreaturekind-152194",
   "displayName": "Patch 1.0.21",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-03T17:31:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue where achievements didn't unlock properly when getting full standing with some factions (most notably Cooks). If you should have recieved the achievement but didn't, you will get it when you start the game with v 1.0.21 or later.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Achievements should now pop up right away, not just when you quit the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
