   "id": "kreaturekind-152194@1.0.19",
   "gameId": "kreaturekind-152194",
   "displayName": "Patch 1.0.19",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-02T17:49:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue where the player could get blocked from progressing when giving up from a DoT on opponent's turn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The tutorial checks on the left side of screen should now look correct in all languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed localization issues in activist selection screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed localization issues in merchant/home panel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed small issue where there could be a font error in world map when switching languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made sure circus music doesn't keep playing in encounter map when unlocking activist",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where locked characters sometimes showed up as unlocked in activist selection screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed small color issue on the Wendigo back arm, holding phone",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made sure the middle of the screen arrow button works as intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made sure the middle of the screen arrow button disappears when casting activist card with slots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There should no longer be a sound when gaining 0 block from plushie",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Put music visualizer back in",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
