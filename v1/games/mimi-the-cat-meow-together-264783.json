  {
   "id": "mimi-the-cat-meow-together-264783@major-2024-07-25",
   "gameId": "mimi-the-cat-meow-together-264783",
   "displayName": "Update: Achievements and New Outfits Coming Soon!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-25T14:59:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We want to let you know that we are currently working on implementing achievements for Mimi the Cat - Meow Together. Although the achievements are visible on the store page, they are not yet available in the game at the moment. We are dedicated to ensuring everything works perfectly before releasing them to you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, we are working on new outfits for Mimi! A general update is on the way to bring these new features to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your patience and support as we continue to improve the game. Stay tuned for more updates soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
