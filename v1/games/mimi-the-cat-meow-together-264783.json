  {
   "id": "mimi-the-cat-meow-together-264783@post-2023-12-20",
   "gameId": "mimi-the-cat-meow-together-264783",
   "displayName": "Bug Fix",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-12-20T23:08:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We noticed an inconsistency in acquiring new cosmetic items. Some items were not collectible with a brief touch, such as how the controls for the Pupupu Express (toy train) work. As a result, the functionality of cosmetic items has been altered. Now, any contact will activate the item. This includes jumping from one platform to grab it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Correction of the hint system in stage 16.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
