  {
   "id": "mimi-the-cat-meow-together-264783@major-2024-09-10",
   "gameId": "mimi-the-cat-meow-together-264783",
   "displayName": "Update! Collections, Achievements and New Levels",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-10T02:31:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, in this update, we’ve implemented significant changes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After receiving several improvement suggestions from you, we decided to return to work on Mimi the Cat – Meow Together to provide a better experience. This update includes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "15 New Levels – All handcrafted with care, ensuring challenges and fun! We also organized the level progression to make the evolution smoother and more satisfying.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Achievements – Now you can unlock achievements as you progress in the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "New Outfits! – Mimi and her friends are ready to show off their style! We added 5 new customization options, allowing you to create the perfect combination!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Critical bugs related to the trains have been fixed. If you encounter any issues, please report them in our Community Hub.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Follow our developer page on Steam to stay updated!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Wise Box Studios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
