  },
  {
   "id": "sunshine-manor-138426@1.02",
   "gameId": "sunshine-manor-138426",
   "displayName": "Update 1.02",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-11-01T21:53:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you to everyone that has submitted any issues over the past few days, this patch comprises 1.01 and 1.02 which fixes the following issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gnarlie no longer steals your Rocks as you're about to throw them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rocks no longer re-appear when they shouldn't on specific processors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Screamers now do as they're told and sit back down again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an instance of Double Diaog (tm) appearing during the 2nd Dungeon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Multiple pylons were created in one spot on certain processors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added text to the main menu showing input controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted timing of first boss fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "If you do experience any issues with Sunshine Manor please email us at hello@fossilgames.com with as much information about what you've encountered so we can help you as much as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
