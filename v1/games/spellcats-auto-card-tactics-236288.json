  {
   "id": "spellcats-auto-card-tactics-236288@major-2023-06-16",
   "gameId": "spellcats-auto-card-tactics-236288",
   "displayName": "Demo Update June",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-16T14:29:43.000Z",
   "notes": [
    {
     "title": "Hello summoners!",
     "items": [
      {
       "text": "Demo version is 0.6.0 Live",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Flamepurr",
     "items": [
      {
       "text": "Fixed a bug that enemies Flamepurr gives you mana reduction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug when getting 3 Flamepurr then selling 1 will permanently increase buy cost by 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Developer notes: Flamepurr was filled with bugs so i had to take it to the vet",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "NekoBurst",
     "items": [
      {
       "text": "Effect Die: give fire nekos 2 Atk -> New effect: Die :deal 3 damage to target enemy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Developer notes: NekoBurst previous design was to use targeted damage and now it's implemented.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Purrlem",
     "items": [
      {
       "text": "Effect Allied died: gain +3 Atk -> Die: give random ally shield",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Developer notes: Ground cards should be focusing on shield usage. so it will shift to that design.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Game",
     "items": [
      {
       "text": "Fixed a bug when you finish the game and start a new game you cant summon cats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that having 7 cats sometimes doesn't trigger the die effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Battle",
     "items": [
      {
       "text": "Token spawn order: now it pushes back the cards in the 6th position, preserving the order.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Battle System: now the enemy places its cards before fighting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Effect System Stack: now there's a delay between effect triggers to know what is happening",
