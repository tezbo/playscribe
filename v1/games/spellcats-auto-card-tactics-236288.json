  {
   "id": "spellcats-auto-card-tactics-236288@1.3.0",
   "gameId": "spellcats-auto-card-tactics-236288",
   "displayName": "Patch 1.3.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-09T12:18:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Saturday patch 1.3.0 is Live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Quality of Life 🌱",
     "items": [
      {
       "text": "Improved effects descriptions.: The following effects explanations and name have been reworked:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rally: when a cat is summoned",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Water Rally: when a water cat is summoned",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Summon: when you summon the actual card.: Dev notes: noticed there where a few cards that had Rally on their effects but didnt match what how they trigger so I created the Summon effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balance ⚖️",
     "items": [
      {
       "text": "Charge: occurs when an electric ally cat dies.: Dev notes: For the synergy update it will give more freeway to mix electric cards with other types",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Banner: Effects now all cards regardless of their type.: ##: The following cards: their effects can target other elements: +7 more: The following cards changed their trigger \"Rally\" -> \"Summon\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes 🪲",
     "items": [
      {
       "text": "Removed the tooltip and tutorial pop up when you tried to quit the game.: Noticed some UI and navigation issues that will be adressed on next small patch.: If you encounter any issues, let me know on our Discord server! Prioritizing the toughest bugs since I am the only one on it!: Regards,: Johan Croix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
