  {
   "id": "spellcats-auto-card-tactics-236288@1.0.2",
   "gameId": "spellcats-auto-card-tactics-236288",
   "displayName": "Hotfix 1.0.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-05-19T10:48:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks for pointing it out! I was playing too and found the battle-stuck bug when using electric cards, so I fixed it ASAP. Sorry for the inconvenience! 🙇",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balance ⚖️",
     "items": [
      {
       "text": "Surfstripe can now transfer its stats to other cats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bugs 🪲",
     "items": [
      {
       "text": "Fixed a bug that caused the player to get stuck in battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you find anything weird, let me know on our Discord server!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "P.S. I'm also addressing an issue where upgraded cards lose their stats. This was a game-breaking bug, so I had to release this hotfix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
