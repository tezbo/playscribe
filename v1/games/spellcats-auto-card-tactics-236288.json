  {
   "id": "spellcats-auto-card-tactics-236288@1.0.3",
   "gameId": "spellcats-auto-card-tactics-236288",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-20T11:36:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.0.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upcoming Patch 1.0.3 is Live",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Quality of Life 🌱",
     "items": [
      {
       "text": "Updated Japanese translations. Credits to @まさぼ🐸, thank you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now pause during battle, allowing the player to end the run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If the player returns to the main menu, the game over screen will trigger and unlock cards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balance ⚖️",
     "items": [
      {
       "text": "Fixed Upgraded Scorcheon ability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Flarelynx and other incremental or multiplicative modifiers to non-fight damage will now affect the small match trinket. Thanks @SteamPoweredBot!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Emergency bandages have been removed until further notice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bugs 🪲",
     "items": [
      {
       "text": "Endless battle bug fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you find anything weird, let me know on our Discord server!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "I know there are other bugs out there, but since I am the only one, I'm prioritizing the toughest ones!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Johan Croix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
