  {
   "id": "spellcats-auto-card-tactics-236288@patch-2024-05-25",
   "gameId": "spellcats-auto-card-tactics-236288",
   "displayName": "Fixes Are Incoming! New Patch Every Saturday!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-25T08:38:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Spellcats community,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've heard your feedback loud and clear – thank you for sticking with us through the glitches! 🐾✨ In our commitment to improving your gameplay experience, we've decided to adjust our patch schedule.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While the enthusiasm to fix issues quickly led us to release daily updates last week, it also meant some bugs slipped through without proper testing. We're taking a new approach: rather than rushing, we're dedicating the entire workweek to develop, test, and ensure the quality of each patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Expect a new, polished update rolling out every Saturday. This way, we can deliver the fixes you need and the quality you deserve.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for your patience and passion. Let's make Spellcats better, together!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Best wishes,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Johan Croix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
