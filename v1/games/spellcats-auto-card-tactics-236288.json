  {
   "id": "spellcats-auto-card-tactics-236288@1.0.4",
   "gameId": "spellcats-auto-card-tactics-236288",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-25T09:05:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Saturday patch 1.0.4 is Live",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Quality of Life 🌱",
     "items": [
      {
       "text": "Improved the feedback form; it was previously hiding the mouse cursor.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Now the version label is fixed to the corner to pinpoint which version is having issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balance ⚖️",
     "items": [
      {
       "text": "Adjusted the XP curve so you can have a chance unlocking the Achievement that requires you to upgrade a level 6 card.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Rock necklace rework: now gives 1 hp to all earth cats each round.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Upgraded Current cat was giving temporal buffs, it should be permanent for water cats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes 🪲",
     "items": [
      {
       "text": "When a player chooses to level up in a \"?\" encounter, it now actually levels up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the Circuit card upgraded would spawn 2 copies of itself when defeated, creating an infinite loop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cards changing size/scale after fights, some cards get squashed, so this fix will prevent that.: If you encounter any issues, let me know on our Discord server! Prioritizing the toughest bugs since I am the only one on it!: Regards,: Johan Croix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
