  {
   "id": "spellcats-auto-card-tactics-236288@1.1.2",
   "gameId": "spellcats-auto-card-tactics-236288",
   "displayName": "Patch 1.1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-15T09:34:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.1.2 is Live",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Quality of Life 🌱",
     "items": [
      {
       "text": "Huge rework to the battle system and turn manager to ensure better game stability and remove crashes during battle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When you examine a token card it will show its actual effect instead of a generic summon explanation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "when you return to the menu during a boss scene it leaves a banner description now the banner hides if you decide to leave",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sometimes when playing against the boss the label battle start pops off before spawning the boss remaning cards so now it waits for all cards to be placed and then the battle actually starts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balance ⚖️",
     "items": [
      {
       "text": "Water cats buffs are lost between fights, you can not longer have a 2000/2000 water cat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes 🪲",
     "items": [
      {
       "text": "Fixed an issue that the sacrifice trophy will not pop up unless is your first playthough when you opened the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Monochrome chains: fixed a bug where this trinket doesnt give buffs to the cards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Goopy Duplicate: Now actually summons a token copy of your first sacrifice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Spikes damages multipliers are correctly calculated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you encounter any issues, let me know on our Discord server! I'm prioritizing the toughest bugs since I am the only one on it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Johan Croix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
