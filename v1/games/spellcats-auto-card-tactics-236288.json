  {
   "id": "spellcats-auto-card-tactics-236288@major-2023-07-24",
   "gameId": "spellcats-auto-card-tactics-236288",
   "displayName": "Demo Update July Part II",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-07-24T11:18:59.000Z",
   "notes": [
    {
     "title": "Greetings summoners!",
     "items": [
      {
       "text": "Demo version 0.6.5 is Live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are excited to announce that Demo version 0.6.5 is now live, bringing you a more stable and polished Spellcats experience! Thank you for your valuable feedback and support during our physical booth event, where we encountered and successfully squashed numerous bugs. As we worked tirelessly through the nights, we managed to eliminate approximately 8 pesky bugs, ensuring a smoother gameplay experience for all of you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Highlights",
     "items": [
      {
       "text": "Resolved an issue preventing players from starting a second game after losing or defeating the boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced overall stability for a more enjoyable playthrough",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": ".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you for your continued enthusiasm for Spellcats! Your feedback is essential in helping us shape the game into an even more magical adventure!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sincerely,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Nintai Studios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
