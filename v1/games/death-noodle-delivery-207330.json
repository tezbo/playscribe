  {
   "id": "death-noodle-delivery-207330@1.3.6",
   "gameId": "death-noodle-delivery-207330",
   "displayName": "Patch 1.3.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-04-24T15:41:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi chooms!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We inform you that we just released a new patch (build 1.3.6) for the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the main features added and fixes",
     "items": [
      {
       "text": "Added Catalan as playable language for the game! Hola amics!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in the highway chase levels for the cat bomb: now it's easier to destroy enemy cars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed difficulty of some game level, especially the last one (now easier)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved global performance of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Small fixes on texts and other minor bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Should you find any bugs, do not hesitate to contact us or to write on the official discussion!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, thank you for your support! We hope you'll have a good time in Death Noodle Delivery!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Yours fellow gamedevs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Stefano & Fabio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
