   "id": "farm-for-your-life-30248@post-2015-10-29",
   "gameId": "farm-for-your-life-30248",
   "displayName": "Another year, another halloween... and some added features",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2015-10-29T17:05:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's that time of the year again. Halloween is upon us and our zombies are becoming unrestul. Well, they're always unrestful I guess :-) We opened our scavenger hunt back up again for those who missed their chance last year. Happy hunting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We also added two often requested features into the game",
     "items": [
      {
       "text": "You are now able to create your own fertilizer through the new compost object",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The sprinklers and turrets now show you a preview of the area they affect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We hope you like these additions. Especially the compost really expands upon the endless game mode :-)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Have a great halloween everyone",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Anny and Oliver",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
