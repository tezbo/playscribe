  {
   "id": "blazing-strike-193531@02",
   "gameId": "blazing-strike-193531",
   "displayName": "Patch 02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-14T06:59:59.000Z",
   "notes": [
    {
     "title": "bugs",
     "items": [
      {
       "text": "being able to parry while getting hit by specials and supers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "screen shake moving the camera position over time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "jump in -> walk fw -> light normal would not let light normals to come out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
