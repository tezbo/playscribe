  {
   "id": "hermitage-strange-case-files-130256@major-2020-11-22",
   "gameId": "hermitage-strange-case-files-130256",
   "displayName": "Launch date update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-11-22T15:10:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For a text based game like Visual Novels, having a proper translation is mandatory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It is therefore in our outmost interest to deliver high quality translations, especially for a game with such an intricate and complex story as Hermitage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Like everyone else, we are of course extremely excited for the launch of Hermitage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "However, because the localization is taking up more time than expected, we have made the decision to postpone the launch, to ensure that everything is up to our standards on release.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the meantime, be sure to join our official Discord server to receive are latest news and updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We thank you for your patience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
