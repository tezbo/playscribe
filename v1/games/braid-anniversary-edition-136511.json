   "id": "braid-anniversary-edition-136511@major-2024-05-16",
   "gameId": "braid-anniversary-edition-136511",
   "displayName": "Update notes for May 16th. Happy Thursday!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-16T12:29:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Restored World 4 audio timings to their OG speeds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restored the OG Chinese translations for the story text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed flickering ladders in World 1-1 at some frame rates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed confusing World 8 commentary door order",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed falling through the floor after completing the game and playing a commentary in World 0-0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved support for OLED Steam Deck and for Steam Deck frame rate limiter",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Enabled variable frame rate when vsync is explicitly disabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
