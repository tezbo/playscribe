  {
   "id": "ovivo-29388@2.0",
   "gameId": "ovivo-29388",
   "displayName": "Update 2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2017-11-23T15:11:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Folks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have great update of our game OVIVO on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "New music tracks.: Folks, we know you love original tracks but we had to change the tracks because of the copyright issues. We asked the composer(Brokenkites) to make a special version of his tracks for OVIVO. The new tracks came out great and we think that they fit the game even better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New feature (only for Windows and Linux): We’ve added a special liquid like effect when OVO switches between Black and White worlds.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
