  {
   "id": "ovivo-29388@patch-2026-10-28",
   "gameId": "ovivo-29388",
   "displayName": "Patch: resolution setting and fixes",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-28T17:29:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A small update for OVIVO.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a Screen item to Settings: choose the resolution and fullscreen or windowed mode. If the screen size looks off after the update, change it there.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "New installs start at your display's native resolution.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Gamepad: the Start button no longer jumps you to the next checkpoint.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed leftover developer keys (Q, R, C, F1, F2).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Linux: fixed the launch setting.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Updated the engine to Unity 6, which also closes the Unity vulnerability CVE-2025-59489.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game no longer sends anonymous usage statistics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If something doesn't work, let us know in the Steam discussions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
