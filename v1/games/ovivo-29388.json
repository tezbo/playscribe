  {
   "id": "ovivo-29388@post-2021-06-02",
   "gameId": "ovivo-29388",
   "displayName": "FIXED: Achievements Bug",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-06-02T08:46:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi folks! We have finally fixed the issue when the game didn't give the last two achievements (all dots collected and all symbols collected). Just update the game and you will receive achievements if you had reached them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your support and patient. We are so grateful that our game after all these years still has such attention.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
