   "id": "fuga-melodies-of-steel-3-307648@post-2026-11-05",
   "gameId": "fuga-melodies-of-steel-3-307648",
   "displayName": "Additional Languages for Fuga: Melodies of Steel 3",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-11-05T05:50:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In response to the many requests we have received we're pleased to announce that we have added seven more languages to Fuga: Melodies of Steel 3. We hope that players around the globe can enjoy playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Additional Language Support",
     "items": [
      {
       "text": "Spanish, Latin American Spanish, Italian, Korean, Brazilian Portuguese, Russian, and German.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Release Date: November 5th, 2026, 10:00 JST",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please enjoy playing Fuga: Melodies of Steel 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
