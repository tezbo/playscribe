       "text": "Added a tip to conserve speed in \"Hyperdrive\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Renamed \"Back to Lobby\" to \"Sumo Lobby\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed \"Reconnect Controller\" text on the end screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed 0 FPS from frame rate options and always have a 60 FPS option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
