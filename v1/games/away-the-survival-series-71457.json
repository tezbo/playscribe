  {
   "id": "away-the-survival-series-71457@1.11",
   "gameId": "away-the-survival-series-71457",
   "displayName": "Update 1.11",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-21T22:02:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "🌿 AWAY: The Survival Series - Update v1.11 Now Live on Steam! 🌿",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Hello, wilderness explorers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're excited to bring you the latest patch for AWAY: The Survival Series - Version 1.11, now available on Steam. This update brings a mix of bug fixes and an exciting new feature that we hope you'll love!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "What's New",
     "items": [
      {
       "text": "🐱 Cat Mode Unleashed: Now, you can roam the wilderness as a cat in exploration mode. Experience the world from a whole new perspective!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🖥️ VSync Option Added: For a smoother gameplay experience on Windows.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Various achievements system enhancements completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fast travel issues addressed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Snail achievement and hologram issues in exploration mode rectified.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Localization improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Xbox icon display issues fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Enhanced NPC 3Cs for better gameplay comfort.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Scorpion collision and attack animation bugs fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "...and several other minor fixes to enhance your gameplay experience.: Thank you for your continued support and feedback. These updates are for you, and we hope they make your adventure in AWAY even more thrilling. Don't forget to share your cat adventures with us!: Happy exploring!: The AWAY Team 🍃",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
