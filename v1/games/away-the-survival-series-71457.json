  {
   "id": "away-the-survival-series-71457@1.10",
   "gameId": "away-the-survival-series-71457",
   "displayName": "Update 1.10",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-16T22:21:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey there, fellow gamers! 🎮",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're thrilled to announce the release of Version 1.10 for our game on Steam! This update is packed with improvements, bug fixes, and a brand new feature that we're sure you'll love. Get ready to experience the game like never before!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Introducing the Skin Feature! 💥",
     "items": [
      {
       "text": "Customize your character with unique and stylish skins, making your gameplay experience even more personalized and fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Major Improvements: 🛠️",
     "items": [
      {
       "text": "Enhanced NPC control, collisions, and ragdoll",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Smoother locomotion and camera control",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Default camera now slower and further away for a more comfortable gaming experience",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved jumping camera movement for seamless action",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Advanced NPC AI behaviors for more engaging interactions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes Galore! 🐛",
     "items": [
      {
       "text": "Audio and stability fixes in exploration mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Performance optimizations for smoother gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bug fixes for progression-related bugs in main quests, achievements, HUD, UI, statistics, save games, fast travel, side quests, and progression trees and skills",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Better subtitle timing for hologram videos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "This update is all about enhancing your gaming experience and fixing those pesky issues that could have been getting in the way of your fun. We can't wait for you to dive into Version 1.10 and see all the improvements for yourself! As always, we appreciate your continued support, and we're eager to hear your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "So, what are you waiting for? Update your game now and let the adventure continue! 🌟",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Happy gaming,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Breaking Walls Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
