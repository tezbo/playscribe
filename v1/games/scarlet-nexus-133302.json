  {
   "id": "scarlet-nexus-133302@post-2021-07-19",
   "gameId": "scarlet-nexus-133302",
   "displayName": "Regarding supported controllers",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-07-19T10:04:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have received inquiries from our customers regarding controller compatibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Currently, the Steam ver. for SCARLET NEXUS is guaranteed to only work with the following controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Xbox Wireless Controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "DualShock 4 Wireless Controller: If the button icons displayed in-game are different from those of your compatible controller, please try the following setting changes.: 1) Access your Steam Library, right click on \"SCARLET NEXUS\" and select \"Properties...\": 2) In the \"CONTROLLER\" tab, use drop-down menu to change override settings to \"Disable Steam Input\".: Thank you for your continuous support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
