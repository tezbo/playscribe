  {
   "id": "scarlet-nexus-133302@1.03",
   "gameId": "scarlet-nexus-133302",
   "displayName": "Patch 1.03",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-14T13:12:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Scarlet Nexus Ver1.03 has been released, and the game has become more fun and playable with new gameplay options (camera, lock-on settings, animation toggles) and tweaks in this update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new gameplay options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Camera position and tracking speed option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy lock-on aim assist (Left stick control ON/OFF) option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy lock-on camera speed option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Text size (brain talk messages / system log) adjustment option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "SAS Activation Animation toggle option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Smoother and quicker protagonists’ start movements outside battles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please apply the latest update (1.03) and enjoy playing Scarlet Nexus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
