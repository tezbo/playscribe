  {
   "id": "scarlet-nexus-133302@1.07",
   "gameId": "scarlet-nexus-133302",
   "displayName": "Patch 1.07",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-02-08T15:38:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "You Asked, And We Heard!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this free update, several highly-requested elements from SCARLET NEXUS fans are added into the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The New Photo Mode",
     "items": [
      {
       "text": "Play around with the whole-new \"Photo Mode\" to capture the best moments in the game! Multiple camera options are made available, allowing you to take your favorite photos at the convenience of a button press, any time while exploring the world of SCARLET NEXUS.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can capture and save photos not only during gameplay, but also at your favorite moments during cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "\"Very Hard\" Difficulty and New Challenges",
     "items": [
      {
       "text": "For those who want more challenging gameplay, set the game's difficulty to the new \"Very Hard\" mode and face-off enemies with even more powerful attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "On top of that, for those who are in search of an ultimate challenge, try out the new Challenge missions and get extremely rare rewards, only if you can…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Equipable Support Plug-ins",
     "items": [
      {
       "text": "For players who feel like the game is still too hard even in “Easy” difficulty, and those who would like to experience the story without all the effort with defeating strong enemies, we have added new plug-ins to support your journey in SCARLET NEXUS! Just update your game and obtain the plug-ins immediately in Shop for free!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Collaboration Item",
     "items": [
      {
       "text": "In commemoration of the release of the Chapter 1 Blu-Ray Disc Set in Japan for the SCARLET NEUXS anime series, the designed package and discs are added into the game as a new present!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
