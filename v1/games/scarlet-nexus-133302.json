  {
   "id": "scarlet-nexus-133302@1.08",
   "gameId": "scarlet-nexus-133302",
   "displayName": "Update 1.08",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-03-30T14:15:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "SCARLET NEXUS newest free upgrade is available today, it brings a new story mode difficulty: “Very Easy”, aimed at players who want less challenge or want to focus on the intricate story of SCARLET NEXUS.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Teaming up with another JRPG; this upgrade also welcomes new objects from BANDAI NAMCO’s critically acclaimed game Tales of Arise, players can now bring the adorable Hootle and other elements with them on all their future adventures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And for players who have yet to join the Other Suppression Force, a new story demo is coming soon with the first few chapters of the game and the possibility to keep the save data after purchasing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
