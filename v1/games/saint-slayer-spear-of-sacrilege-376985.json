  {
   "id": "saint-slayer-spear-of-sacrilege-376985@major-2026-07-15",
   "gameId": "saint-slayer-spear-of-sacrilege-376985",
   "displayName": "July 15th 2026 Saint Slayer Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-15T14:50:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "With today's update to Saint Slayer we made some minor touch ups to improve and clean things up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Adjustments to scoring, and point values",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Adjustments to layer/depth of point displays",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Removal of point display when collecting single coins",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Adjust faith value of Miracle Water (the red jug) item to 3 within stages to match it's power in Lavinia's shop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixes placement issues with corpses that are a hat or a skull in some situations (such as cauldrons on Stage 14)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Adds an optional minimalist Screen Filter setting to the \"OPTIONS\" menu to simulate an older school look",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Other minor fixes and adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45853355/8759030b36870c2652b5dd53eb359c198cc3dba5.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
