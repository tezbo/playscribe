   "gameId": "saint-slayer-spear-of-sacrilege-376985",
   "displayName": "Saint Slayer Steam Machine Improvement/Fix",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-07-25T14:02:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A minor update is now live for Saint Slayer fixing a recently discovered issue with Steam Machine/Steam Controller. The game was being locked into the Steam Deck aspect ratio (16:10), this bug has now been fixed. Saint Slayer will still lock to 16:10 while playing on the Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Below are before and after photos of playing on a TV using the Steam Machine and Steam Controller.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
