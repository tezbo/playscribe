  {
   "id": "gladio-mori-278415@major-2025-03-11",
   "gameId": "gladio-mori-278415",
   "displayName": "The Second Update just went live! 🌋",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-11T12:00:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Second Update just went live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🌋 We have added the lava map, watch out, the floor is lava!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚔️ This marks the first Chinese weapon in the game, the Hook Swords. We hope you'll enjoy them!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🤵🏻 Grab a community skin in the settings now, or upload your own non branded (No character, existing person or brand) in #skin-share and we'll put it in the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🦀 To crab or not to crab? Join the Classic modes to enjoy some more realistic fighting, or show of all of your freedom moves in the Creative mode!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you in the arena!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "More patch notes",
     "items": [
      {
       "text": "PATCHES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Version 0.12.2*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added points and game type to lobby list",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Game now remembers lobby settings in multiplayer and local play modes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a \"Game Type\" setting to lobbies: > Classic: Custom animations for the lower body are ignored and movement is replaced with default movement: > Creative: No restrictions to custom animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a \"Rules\" setting to lobbies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The host can freely write text to this field and it will be displayed to players that join the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added keybindings for up and down for free look camera",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Free look camera movement now respects the joystick value",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed joystick deadzone not working correctly in multiplayer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where letting go of a weapon at the beginning of a round could cause synchronization issues. This could result in clients seeing a floating weapon.: POINT COST CHANGES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "All armour reduced by 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bardiche 14 -> 13",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Daneaxe 15 -> 13",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Twinblade 15 -> 12",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
