  {
   "id": "gladio-mori-278415@hotfix-2024-11-30",
   "gameId": "gladio-mori-278415",
   "displayName": "📢 Hotfix Update for Gladio Mori! 📢",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-11-30T15:30:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Gladiators,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just rolled out a hotfix update to address some issues and improve your gameplay experience. Here’s what’s included:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Backup System: A backup system is now in place to handle error situations when saving a moveset.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moveset Name Validations: Added checks to ensure moveset names meet proper standards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Move Editor Fixes: Resolved an issue where the Move Editor UI could break.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Action Slot Fix: Fixed an issue where \"Passive\" and \"Play At Start\" moves could take up an action slot and block other moves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Invalid Moveset Handling: Prevented the game from hanging when encountering an invalid moveset file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Voice Chat Issue: Fixed voice chat activating while typing in text fields.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moveset Selection Fix: Corrected the moveset selection process after deleting another moveset.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your feedback and reports—This has been helping me to find and fix these bugs. Let me know if you encounter any further issues or have suggestions!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚔️ See you in the arena!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "LittleLegatus: https://store.steampowered.com/app/2689120/Gladio_Mori/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
