  {
   "id": "gladio-mori-278415@major-2025-01-28",
   "gameId": "gladio-mori-278415",
   "displayName": "January Update just went live! ⚔️",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-28T12:00:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The January Update just went live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🕹️ We have added an Arcade campaign mode where you climb the ladder with your basic movesets against improved AI, when you win, unlock custom movesets!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🥷🏻 The Naginata adds another Japanese weapon to use in the Dojo and in all other arena's. We hope you'll enjoy playing it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🤖 We have improved the AI, meaning that they will be smarter and harder to fight against!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you in the arena!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
