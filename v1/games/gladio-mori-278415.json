  {
   "id": "gladio-mori-278415@major-2025-03-25",
   "gameId": "gladio-mori-278415",
   "displayName": "The Second² Update just went live!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-25T12:00:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Second² Update just went live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🏃🏻 We have added a Stamina system, bringing some more reality back to the game! You can toggle this on and off in your matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚔️ We have added the Falx and the Sica & Parma (smaller shield)!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📜 We added a Legacy mode, which preserves the stronger player characters that many people have grown used to.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you in the arena!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "--------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "More patch notes",
     "items": [
      {
       "text": "PATCHES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Version 0.13.8*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Less friction for metals(weapons and armour) and bones",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased friction for ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added drag to weapons and player character",
       "ps5ProOnly": false,
