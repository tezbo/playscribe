  {
   "id": "gladio-mori-278415@major-2024-09-02",
   "gameId": "gladio-mori-278415",
   "displayName": "Gladio Mori Demo Update and Publisher Announcement",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-02T11:05:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Big News! We’ve updated the Gladio Mori demo with some exciting new features that many of you have asked for.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First, we’ve added Replay Mode! You can now save your fights and share them with the world. This was one of the most requested features, just behind the call for more weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Speaking of weapons, we’ve added New Weapons! These will give you more options to take down your enemies in style.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I’m also thrilled to announce that Bonus Stage Publishing has joined me as a publisher for Gladio Mori. With their help, we’re aiming to make the game even better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And here’s something crazy: Gladio Mori was the 3rd most played demo on Steam, just ahead of Final Fantasy XIV Online. As a solo developer, this is beyond anything I imagined, and I’m so grateful for your support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you for playing, and keep the feedback coming! The journey is just beginning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "You can now change your move set while in-game in multiplayer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The default AI amount changed to 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mouse control",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Replay mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Overhauled blood painting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Overhauled blood decals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated visuals for all weapons in the demo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Joining a game that is already in progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lobbies should no longer be filtered by region",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New lobbies are \"Friends Only\" by default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tweaked the strength of some joints",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remade some of the players' colliders, including the head colliders",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slight tweaks to player's muscles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where a single device was registered multiple times in local play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "New weapon!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Play, wishlist, and tell us what you think.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "littlelegatus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Developer of Gladio Mori",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
