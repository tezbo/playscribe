  {
   "id": "gladio-mori-278415@1.0.2.1",
   "gameId": "gladio-mori-278415",
   "displayName": "Hotfix 1.0.2.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-09-17T16:19:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The launch went really well and we’re happy with the honest feedback you’ve given us! We will take your suggestions and ideas into consideration for the future and see if they fit and match in the plans we have currently. We appreciate your enthusiasm more than anything.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v1.0.2.1 - Today’s hotfix tackles some achievement related issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that caused round losses to count as wins in multiplayer for achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a separate moveset for the Pollaxe",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue that sometimes caused the pollaxe blade to pop out of whatever it was cutting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "\"Demo compatible\" info is now shown to console lobby hosts (full version only)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DEMO",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "updated to maintain compatibility",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to let us know if you run into any issues so we can flag and fix them!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord: https://discord.gg/gladiomori",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
