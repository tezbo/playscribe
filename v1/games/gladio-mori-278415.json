 "releases": [
  {
   "id": "gladio-mori-278415@major-2026-10-29",
   "gameId": "gladio-mori-278415",
   "displayName": "Hallowed Dungeon Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-29T12:00:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, Gladios!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version \\[1.0.4.2] is out now and it’s a spooky one! This update adds a new map, new weapon and equipment piece, and something extra for demo players as a thank you to the amazing past weeks since launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "EQUIPMENT",
     "items": [
      {
       "text": "CHARACTER SKIN - Prisoner",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "EQUIPMENT WEAPON - Prisoner’s Machete - This rusted blade can be equipped in two hands, and has its own added moveset.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "EQUIPMENT ARMOR - Prisoner’s Mask (13 equipment points)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "MAP",
     "items": [
      {
       "text": "THE DUNGEON - This map offers narrow stone bridges leading to a tight arena. Watch your step lest you fall into the acid pools surrounding you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General note: These additions are permanent, and will not go away after a particular day.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes & Fixes",
     "items": [
      {
       "text": "1.0.4.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Weapon: Prisoner's Machete",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Armour: Prisoner's Mask",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Arena: Dungeon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Moveset: Prisoner's Machetes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "DEMO",
     "items": [
      {
       "text": "Included Dungeon arena in demo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Included Prisoner's Machete weapon and moveset in demo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44768650/e459289ebf5c5a4143a4a8217f9fb4e799b19c4d.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "DEMO UPDATES",
     "items": [
      {
       "text": "The \\[Prisoner’s Machete] and the \\ map are also available for demo players for a limited time, kicking off a rotation cycle for the demo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve decided to bring some more variety in a contained manner and will be introducing a random moveset with its assigned weapon on a regular interval. This means demo players can look forwards to each cycle what moveset and arena becomes available for them each time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This does not replace any of the four available movesets, but rather adds a fifth set for you to use. The \\ map is now part of the rotation to allow Demo players to join in on the Halloween theme until we drop the next update, when it will cycle in a different map. Equipment will still be locked and no skins or mods can be used, but we hope to tickle your fancy a tad more by showing what else the game has available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you again for playing Gladio Mori. Enjoy the treats!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
