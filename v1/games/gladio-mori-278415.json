  {
   "id": "gladio-mori-278415@1.0.3.4",
   "gameId": "gladio-mori-278415",
   "displayName": "Hotfix 1.0.3.4",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-10-01T11:00:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We heard you loud and clear! We're adjusting the Pugilist moveset once more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "1.0.3.4 Hotfix",
     "items": [
      {
       "text": "Reverted previous changes to Pugilist moveset and copied Special Attack 3(hammer fist) to block stance under action 2 (stab)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "so Special Attack 3 can be used by Action 9 and when in block stance also Action 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
