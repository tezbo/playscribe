  {
   "id": "gladio-mori-278415@1.0.3.2",
   "gameId": "gladio-mori-278415",
   "displayName": "Hotfix 1.0.3.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-09-24T11:00:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Another week, another round of fixes and tweaks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch notes for version 1.0.3.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI in multiplayer now waits until all players have joined before moving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI amount is no longer shown in lobby list, if player count is high enough that no Ai is spawned",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crossplay lobby hosts now have a button that will set the lobby settings to be demo compatible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: Only changes settings. Mods need to be disabled manually.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an option for setting the default p2p port for crossplay lobbies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a text field for providing reason when kicking or banning a player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Mod Manager menu added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that caused mouse clicks to register when navigating back from mod browser (caused random navigations)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Renamed \"Mods\" menu button to \"Mod browser\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Modified the Pugilist moveset",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crouch is now a stance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moved Special Attack 3 under the new stance and changed its binding to Action 5 (Attack High)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Invert camera Y option now also affects free camera in replay and spectator modes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tooltips now scale based on screen size",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed demo compatible tooltip not updating when navigating back to lobby from a gameplay scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed equipment select window not scrolling automatically to the selected equipment when opening the window",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a panel to show equipment name while selecting it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks for reporting your bugs and sharing your feedback. It helps us ensure that Gladio Mori gets better and better!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
