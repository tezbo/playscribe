  {
   "id": "fallen-fatal-force-298476@major-2024-10-15",
   "gameId": "fallen-fatal-force-298476",
   "displayName": "Major update on October 15, 2024!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-15T01:44:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update Details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.Improved Processing Load",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Optimized processing load in all areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2.Improved Game Flow Clarity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Relocated the boss fight area in Chapter 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Changed important item icons to be displayed in 3D space when using the remote viewing skill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Added destination animation markers to the mini-map for each chapter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Minor text discrepancies have been corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Moved puzzle room hints to more visible locations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Repositioned the coins in puzzle rooms to more noticeable spots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3.Improved Enemy AI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Enhanced the AI to relentlessly pursue players within the laboratory floors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Adjusted shielded enemies so that their exposed areas are easier to hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4.Improved Player Actions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Implemented TurnInPlace functionality.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Improved camera behavior.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Enhanced attack abilities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
