  {
   "id": "architect-life-a-house-design-simulator-144766@1",
   "gameId": "architect-life-a-house-design-simulator-144766",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-26T15:05:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Architects!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing Architect Life and for all your valuable feedback on our Discord or on the Steam forums!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this update, we’ve addressed several community-reported issues, including a fix for the language selection bug and improvements to overall stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've also implemented an initial solution for multiple crash reports. However, if you continue to experience any crashes, please let us know so we can investigate further!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements and Fixes",
     "items": [
      {
       "text": "Language Selection Bug - Performing a clean install (deleting the Architect folder in AppData) should prevent the language prompt from appearing on the first boot in the demo version. However, after this initial setup, language changes and reboots should function correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "AZERTY Keyboard Issue - Due to limited reports, we are still investigating this issue further.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Stability improvements",
     "items": [
      {
       "text": "We've implemented initial fixes for the following crashes. In our tests, these issues were not reproduced on our end anymore, but we are continuing to investigate. If you still encounter these crashes, please report them to us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash when moving a wall in the demo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash when placing a door on a wall while the building is surrounded by fences.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash when separating a fenced area with a room inside.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash after deleting a curved fence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash after placing fences around a specific house.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash related to placing interior doors on partitions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash occurring while playing in Free Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash when using the \"Move a Wall\" feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash related to the Wall Edit tool.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Architect Life Team 🏡",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
