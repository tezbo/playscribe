  {
   "id": "this-means-warp-132443@4.02",
   "gameId": "this-means-warp-132443",
   "displayName": "Patch 4.02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-03-28T15:51:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some small tweaks to balancing as a result of player feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Easy Difficulty",
     "items": [
      {
       "text": "Bot Movement modifier increased from 0.8 to 0.85",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Progression Modifier increased from 0.8 to 0.85",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Enemy Ammo Respawn duration decreased from 1.4 to 1.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Multi-gun rarity modifiers",
     "items": [
      {
       "text": "4 guns: 0.5 -> 0.7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5 guns: 0.4 -> 0.6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Boss 2",
     "items": [
      {
       "text": "Offensive window has been reduced by 5s",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Health curve has been flattened reducing HP by roughly 10%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Boss 3",
     "items": [
      {
       "text": "Timer for the primary mechanic has been reduced from 45s to 38s",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Overall health range increased from 50-200 to 75-270",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
