  {
   "id": "this-means-warp-132443@major-2021-09-10",
   "gameId": "this-means-warp-132443",
   "displayName": "This Means Warp Update Notes - 10th September",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-10T10:04:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "With PAX behind us and the demo for This Means Warp a few weeks away, we thought we'd share some of the things we've been working on based on feedback from the beta!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Missions",
     "items": [
      {
       "text": "The game's procedural generation is now seed-based, meaning you can enter a specific seed and recreate a run, or replay your friends' runs with the same maps, missions, items and encounters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New 'Trubbles' minigame - a frantic race to incinerate troublesome critters before they overrun the ship.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New 'Doubloons' minigame - don your space suits and dodge speeding debris to collect as many pirate doubloons as you can!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Story",
     "items": [
      {
       "text": "New intro cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New messages from the Norg to decipher as you progress through the story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated tooltips.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Items",
     "items": [
      {
       "text": "New 'Repair Pulse' system to repair lots of items around the ship at once and stay on top of AOE damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Completely rewritten crew AI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mouse controls for aiming.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Localization support for multiple languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lots of bug fixes and performance improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can also try This Means Warp yourself - the demo will be available on Steam from October 1st! Sign up to the newsletter at www.ThisMeansWarp.com for a reminder.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
