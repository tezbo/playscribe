  {
   "id": "this-means-warp-132443@2",
   "gameId": "this-means-warp-132443",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-23T17:15:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're delighted to announce that This Means Warp's second major Early Access update is now available! This update includes a host of changes, focused around the areas most requested by players - missions, quality of life improvements, and AI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "10x New Decision Events",
     "items": [
      {
       "text": "We've added a host of new random events during a run, from pirates raiding ancient ruins to merchant ships leaking spacepuffs. These additional dialogue choices enable greater variation and ensure there's always something new to discover each time you play. As part of this, the dialogue choice system has also been expanded to enable multi-stage conversations with the characters you meet along the way.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Training Mission Type",
     "items": [
      {
       "text": "Building on the crew progression system introduced in Update 1, friendly merchants can now offer you the chance to improve character stats for you and your crew.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Item Swap Mission Type",
     "items": [
      {
       "text": "Merchants will now sometimes look to trade for an existing system on your ship rather than cash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Merchants aren't always friendly - they can now also confront the player and appear in battles if you get on their bad side!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "\"Inspect\" Button",
     "items": [
      {
       "text": "Tired of waiting for an item or upgrade so that you can see your system stats? You can now use the dedicated button to inspect an item during gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Reroll Shop",
     "items": [
      {
       "text": "If there's nothing you fancy in a shop you can now reroll for a new selection of items. Use it sparingly - it doesn't come cheap!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Skip Intro Cutscene",
     "items": [
      {
       "text": "You can now skip the intro cinematic if gameplay has fully loaded before it ends.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Packages",
     "items": [
      {
       "text": "Crew members will now automatically pick up ammo, toolboxes, etc from the floor if available rather than always heading back to the dispenser.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Shields",
     "items": [
      {
       "text": "Crew members will now actively use shields to block incoming damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Survival",
     "items": [
      {
       "text": "When entering a Survival mission crew members will start getting ready before the ship takes damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bee Gun",
     "items": [
      {
       "text": "A new bee-themed unlockable weapon type featuring a new \"slow\" effect that impacts target systems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you have fun with the new content! If you have enjoyed This Means Warp, please leave a review on Steam to help others discover the game. You can also drop us a note on the Steam forums or chat to us on Discord - we'd love to hear your feedback!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
