  {
   "id": "this-means-warp-132443@4",
   "gameId": "this-means-warp-132443",
   "displayName": "Update 4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-16T14:01:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've spent the last few months working on This Means Warp's biggest ever update, and are looking forward to hearing what you think!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Boarding",
     "items": [
      {
       "text": "One of the top player requested features finally arrives in This Means Warp! The new Teleporter system enables players to board and cause havoc on enemy ships, but be careful - enemy crews might do the same to you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Cosmetics",
     "items": [
      {
       "text": "This Means Warp now has hats! Unlock a selection of hats and accessories to outfit your characters and show off the coolest croc in the galaxy. All cosmetics are free to unlock - no microtransactions or lootboxes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Ship Mods",
     "items": [
      {
       "text": "The Ship Mod system has been completely overhauled, with players able to install new rarity-based modifiers in one of three available slots. Mods are also purchasable from the shop, and feature several new variants to help build synergies with the systems on your ship.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New mods include",
     "items": [
      {
       "text": "Mutiny - an enemy crew member will turn against their own ship for a short duration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Evasion - enemy projectiles miss for a short duration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved tick rate for beam guns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased damage for ricochet projectiles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased radius for AOE projectiles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased damage multiplier on weakened systems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased slow effect for slowed systems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Faster gun overheat recovery",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Faster timers on offensive bombs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Improved AI",
     "items": [
      {
       "text": "Faster decision making, intelligent repair prioritisation, new AI for boarding other ships, dropping packages rather than destroying them, and more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balance overhaul",
     "items": [
      {
       "text": "The new mod system leads to a lot more opportunities for synergy and ramping up your ship's power, so the game's balancing has also been updated to include updated shop prices and reroll system, enemy health changes, and tweaked difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "2x New sector mods",
     "items": [
      {
       "text": "Maps that increase the risk of permanent damage, or randomly set fire to systems on both the player and enemy ships.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "2x New weapons",
     "items": [
      {
       "text": "The Grenade Launcher lobs AOE grenades, and the Rainbow Laser fires lasers with random effects each round.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "10x New missions",
     "items": [
      {
       "text": "Includes unique characters, visuals, and backgrounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Lots of minor bug fixes",
     "items": [
      {
       "text": "With Update 4 we feel This Means Warp is in great shape for full release, and look forward to sharing some special surprises for the 1.0 update later this year. If you enjoy the new content and have a few moments to spare please do take a second to leave a Steam review, and you can chat to the developers directly on Discord as well!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
   "digest": {
    "new": 12,
    "fixed": 1,
    "balance": 1,
    "other": 5,
    "ps5": 0,
    "topNew": [
     "Mutiny - an enemy crew member will turn against their own ship for a short duration",
     "Evasion - enemy projectiles miss for a short duration",
     "Improved tick rate for beam guns"
    ]
   },
