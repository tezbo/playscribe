   "gameId": "night-slashers-remake-290795",
   "displayName": "Update 1.0.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-23T08:33:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update 1.0.6 is now live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "• New Ghoul variant",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• New loading screen hint (enemy kill info)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• New SFX: item throw, Zarutz shoot, Jake air attack, bounce, werewolf howl",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• New mutator: customize enemy count!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Pre-boss cooldowns = better prep time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Difficulty tuning + portrait fixes (Level 3)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Jake: improved unlockable colors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• New unlockable colors for all characters 🎨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• No more blood VFX on certain enemies (as in OG)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed: double hit SFX bug, Ghostcopter shaking, Jake's desperation move height",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Tons of other fixes & tweaks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
