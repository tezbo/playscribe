   "gameId": "night-slashers-remake-290795",
   "displayName": "Update 1.0.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-18T07:29:59.000Z",
   "notes": [
    {
     "title": "New Custom Game Mutators",
     "items": [
      {
       "text": "Bosses Remix: Fight random bosses throughout the game, including new boss variants.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Stinger Up: Adds a chance for regular items to turn into Stinger Powerups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Extended Werewolf Chase: Makes the Werewolf Chase in Level 2 longer and more demanding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Extended Elevator Fight: Makes the Elevator Fight in Level 3 longer and more demanding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Extended Airplane Fight: Makes the Airplane Fight in Level 5 longer and more demanding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Slower Characters: Characters move slower for an even more old-school experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Improvements and Adjustments",
     "items": [
      {
       "text": "Added a new visual effect for the active Stinger Powerup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the position of the Gyoza item in Level 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Slowed down the playback speed of Chris’ running animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed an issue where wall bounce could trigger twice in a row during a single interaction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added other minor fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
