  {
   "id": "elementallis-140804@1.0.10",
   "gameId": "elementallis-140804",
   "displayName": "Patch 1.0.10",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-09T11:20:26.000Z",
   "notes": [
    {
     "title": "Includes the following fixes",
     "items": [
      {
       "text": "The purple tint that appears when you are near the Academy could persist if you went from the Academy to the beach over the water on a specific position",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you swapped your inputs for accept and cancel, the game didn't properly register inputs on the upgrading equipment or buying gems screens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a couple mechanisms on the Water Temple to make easier to retrace your steps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You could trigger a cutscene earlier than intended by exiting Amalric's house, re-entering and going to bed instead of picking the tree branch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can no longer use the heavy ball while climbing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Quick Assign for elements now persist after closing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the design of a room in the Earth Temple (the one where you have to extinguish torches)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed a couple sentences so it's easier to know what to do in the desert and in the mountains",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
