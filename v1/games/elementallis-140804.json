  {
   "id": "elementallis-140804@1.0.13",
   "gameId": "elementallis-140804",
   "displayName": "Patch 1.0.13",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-17T10:51:54.000Z",
   "notes": [
    {
     "title": "Includes the following changes",
     "items": [
      {
       "text": "A couple scene transitions in the overworld could be skipped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustments to the Wind Temple Boss. Now the wind streams leave you more room to move and the dashing should feel more responsive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There was a room in the last temple where the player could get stuck, forcing to reset",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When using RT on gamepads that have a digital instead of analog trigger, if pressed very quick it stopped working for a bit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Fire Temple Boss had an issue where it made the player able to move even when drowning on lava",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You could place portals right on the room transitions, so you could teleport while moving between rooms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
