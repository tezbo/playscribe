      {
       "text": "Added a safety check to prevent heart pieces and mana shards from being duplicated when collected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a fix to teleport players who got stuck in unreachable areas in the beach",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you got the Fire element and, withouth finishing the temple, went to the Nature Temple, the progress was a bit confusing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
