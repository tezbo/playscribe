  {
   "id": "elementallis-140804@1.0.15",
   "gameId": "elementallis-140804",
   "displayName": "Patch 1.0.15",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-30T11:10:37.000Z",
   "notes": [
    {
     "title": "Changes based on feedback",
     "items": [
      {
       "text": "Last temple miniboss and final boss stage now use electricity and ice much less frequently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a shortcut between the volcano village and the teleport, making the path to the upgrades shorter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Now the compass also show the completion percentage for each area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Colossus enemy didn't chase player when frozen during the initial animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a safety check for jumps. If the player is stuck, then the jump stops.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the music could stop during the final boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the arrow traps on the earth temple could stop firing arrows",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "There was a spot in the forest where the player could get stuck when jumping from water",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you went to the second floor of the mall and purchased something, went back and talked to the shopper again, the game could freeze.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the elementadium description on English and German. They now point the player towards Roc to upgrade equipment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A chest in the Earth Temple had a duplicate id.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
