  {
   "id": "elementallis-140804@major-2026-05-15",
   "gameId": "elementallis-140804",
   "displayName": "Fixing one issue with last update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-15T17:08:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Last update introduced a bug related to items. When obtaining the first sword, it wasn't able to cut grass.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When upgrading an armor, the armor value didn't apply.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Both were fixed by reloading the game, but now it's not necessary.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
