  {
   "id": "elementallis-140804@1.0.9",
   "gameId": "elementallis-140804",
   "displayName": "Patch 1.0.9",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-04T07:34:37.000Z",
   "notes": [
    {
     "title": "Includes the following fixes",
     "items": [
      {
       "text": "When entering and exiting a cave hole very fast, the game could spawn the player in a wrong position",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a fix to ensure that if the big chest is opened, the player always has the boss key available",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "There were certain spots in the beach that respawned the player in a wrong position when drowning there",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A puzzle in the last temple was intended to be solved with the temple's element, but could be solved without it. Also, it could be solved on its own by exiting and entering the room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
