  {
   "id": "elementallis-140804@1.0.12",
   "gameId": "elementallis-140804",
   "displayName": "Patch 1.0.12",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-15T13:37:01.000Z",
   "notes": [
    {
     "title": "Includes the following changes",
     "items": [
      {
       "text": "Portals that go under walls now become red and blocked until they don't have walls above",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There was a spot in the Earth Temple where you could jump to the lower floor and you shouldn't be able to",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the shape of a room in the Training Temple",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Wind Boss now stays vulnerable a bit more and the trigger for the dash to make it spin is a bit larger",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed how the game loads inventory to avoid certain issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
