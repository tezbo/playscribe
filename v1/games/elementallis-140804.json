  {
   "id": "elementallis-140804@1.0.16",
   "gameId": "elementallis-140804",
   "displayName": "Patch 1.0.16",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-02T12:18:18.000Z",
   "notes": [
    {
     "title": "Includes the following fixes",
     "items": [
      {
       "text": "Now you can't use the heavy ball while being frozen or while falling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Earth Temple boss waits half a second after transforming so that a couple animations don't overlap",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Worm enemy didn't always show the frozen layer when frozen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The boss in the Training Temple could not drain life properly under a certain situation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A spot in the beach you could rarely get stuck on (this was fixed by reseting the game)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
