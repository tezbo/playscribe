  {
   "id": "elementallis-140804@1.0.7",
   "gameId": "elementallis-140804",
   "displayName": "Patch 1.0.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-02T20:34:58.000Z",
   "notes": [
    {
     "title": "Includes the following fixes",
     "items": [
      {
       "text": "A block puzzle in the Nature Temple could keep you inside",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you dashed backwards right after changing scene, you could avoid changing scene again, placing the character out of bounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you placed Ice on the training ground in the Academy, it wasn't visible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "There was a spot in the factory that if you fall there, the player didn't respawn on the floor and kept falling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed sentences in Catalan.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you gothit while drowning and you died, you respawned with the wrong sprite and collisions. Allowing to move to places you shouldn't be and getting a possible softlock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
