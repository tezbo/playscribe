  {
   "id": "elementallis-140804@1.0.18",
   "gameId": "elementallis-140804",
   "displayName": "Patch 1.0.18",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-07-13T08:39:40.000Z",
   "notes": [
    {
     "title": "Small update that includes the following fixes",
     "items": [
      {
       "text": "You could place a sliding pillar in a place blocking the exit in a cave in Draganeu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You could get the ethereal bestiary achievement without beating the living statue enemy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rare bug where player could get stuck inside walls. To prevent this, we reinforced some walls in the Electric Temple miniboss and all the last temple's minibosses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You could get stuck if you moved a box inside a conveyor belt a certain way in a room in the Training Temple",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "There was a camera change collider a bit too big in the beach",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "When placing ice on an elevator, the player kept sliding while going down or up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you set the attack button to \"cancel\" you couldn't trigger the attack animation of the enemies inside the bestiary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
