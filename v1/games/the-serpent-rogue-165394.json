  {
   "id": "the-serpent-rogue-165394@01",
   "gameId": "the-serpent-rogue-165394",
   "displayName": "Patch 01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-09-03T14:14:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Wardens,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've made a few changes to our demo, including some issues reported by the community. Check out the full changelist below...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Fixed an issue that would cause a corrupt save file",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an item duplication issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash that could occur with using Warden Chests",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused distorted terrain visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused smeltery recipes to be lost",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an animation issue for chickens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue causing the Moonchest quest to not end",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a tip on how to lock on in combat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added ability to go back from character selection screen (this avoids having to see whole intro again)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We hope you are enjoying The Serpent Rogue demo. Don't forget to add the game to your Steam Wishlist:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Want to leave feedback? Come chat with us in the Steam forums: https://steamcommunity.com/app/1453790/discussions/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
