  {
   "id": "mouthole-290732@post-2024-04-02",
   "gameId": "mouthole-290732",
   "displayName": "Welcome, Mouth Dwellers",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-04-02T20:24:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello! We're so grateful to everyone who's settled into their new homes already. We're enjoying watching the ways you're learning to interact with your mouth. Keep going and see what happens when you delve deeper.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're currently working on a post-release patch that fixes some small issues and adds support for different keyboard layouts (apologies to AZERTY users!)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Remember, if you find a bug, click the \"Bug\" button on the main menu to report it, or feel free to email us at anythingnoseproductions@gmail.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
