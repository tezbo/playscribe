  {
   "id": "beer-manufacture-simulator-373268@major-2026-08-13",
   "gameId": "beer-manufacture-simulator-373268",
   "displayName": "The Bigger, Better Brewery Update Is Now Available!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-13T13:03:15.000Z",
   "notes": [
    {
     "title": "Cheers, Brewmasters! 🍻",
     "items": [
      {
       "text": "The vats are full, the production lines are polished, and the Bigger, Better Brewery Update is officially LIVE! Thank you for your patience and incredible support. It's time to step back into the brewery and take your beer empire to entirely new heights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is everything fresh and bubbling in today's update",
     "items": [
      {
       "text": "New beer style - expand your portfolio with brand-new brewing possibilities!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New ingredients - get creative and craft unique, mouth-watering flavor profiles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Upgraded automated machines - now featuring a larger crate capacity to keep your production flowing smoother than ever.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New radio tracks - fresh tunes to vibe to while you manage your factory floor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased max level - push your brewing skills and business limits even further.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "New high-level contracts - take on massive orders for equally massive rewards!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Custom recipe deletion - you can finally clear out those failed experiments and organize your recipe book.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New achievements & diplomas - prove your true mastery and decorate your office walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Varied employee parameters - manage a much more dynamic workforce with unique traits and skills.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Grab a Cold One and a Sweet Deal! 💸",
     "items": [
      {
       "text": "Have fun! 🍻",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Beer Manufacture Simulator Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
