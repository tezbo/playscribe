  {
   "id": "beer-manufacture-simulator-373268@1.1.0",
   "gameId": "beer-manufacture-simulator-373268",
   "displayName": "PATCH 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-02T22:58:41.000Z",
   "notes": [
    {
     "title": "Hello Brewers! 🍻",
     "items": [
      {
       "text": "The premiere is just around the corner! 🔥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get your empty mugs ready so we can fill them with YOUR beer from YOUR own beer manufacture on March 5, 2026! 🍺",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buuut before that, we have the latest update for the Beer Manufacture Simulator demo, which you can download now! 👇",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changelog for Patch 1.1.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Interactive system for pouring and filling ingredients without the need for a UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements and a refreshed interface.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved mechanics for pouring, capping, and labeling beer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Beer characteristics and styles system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quality of life improvements such as auto-stacking items, picking up multiple items (hold LMB), and feedback messages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Contracts with different requirements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New sound and visual effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We also have a challenge for you... 👀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Beer Manufacture Simulator Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
