  {
   "id": "beer-manufacture-simulator-373268@major-2026-08-11",
   "gameId": "beer-manufacture-simulator-373268",
   "displayName": "🍻 The Bigger, Better Brewery Update is Coming!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-11T12:36:39.000Z",
   "notes": [
    {
     "title": "Grab a pint, Brewers! 🍻",
     "items": [
      {
       "text": "We have been hard at work in the cellar, brewing up something completely fresh for you! The Bigger, Better Brewery Update is officially on the way, and it’s packed with exciting new features that will take your beer empire to the next level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is a quick sneak peek at what’s coming to the game",
     "items": [
      {
       "text": "New beer style - time to expand your brewing portfolio!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fresh ingredients - experiment with entirely new flavor profiles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upgraded automated machines - now featuring a much larger crate capacity for maximum efficiency",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New radio tracks - fresh tunes to keep the vibes right while you work",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased max level - keep growing and pushing your brewery's limits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "New high-level contracts - bigger challenges and better payouts for our veteran brewmasters!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Custom recipe deletion - you asked for it, now you can finally clean up your recipe book",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New achievements & diplomas - more milestones to show off your brewing mastery",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Varied employee parameters - build and manage a truly unique and diverse team!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get your vats ready, clean your kettles, and make sure your production lines are prepped. We can't wait to share this with you! Let us know in the comments which new feature you are most excited about! 😎",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you soon! 🍻",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Beer Manufacture Simulator Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
