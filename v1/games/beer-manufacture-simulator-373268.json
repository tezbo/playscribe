  {
   "id": "beer-manufacture-simulator-373268@1.0.1",
   "gameId": "beer-manufacture-simulator-373268",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-07T15:30:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new update is now live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Patch is available to download.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This update focuses on fixing several issues reported by the community and improving overall gameplay stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch 1.0.1",
     "items": [
      {
       "text": "Fixed a bug causing the game to freeze when using the crate table",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues where UI panels for tables and machines could get stuck, and secured cases where they prevented the pause menu from opening",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where bottles disappeared from crates after placing them on pallets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where a glass could remain stuck under the tap",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where high-level festival contracts appeared too early",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug preventing players from exiting the thermometer view",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The “Trash Container” upgrade has been moved higher in the upgrades tab; purchase information and an encyclopedia entry have also been added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added indicators in the tutorial showing the next step after pouring beer (Quit button)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added pallets visualizing the space for kegs near the keg filler",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you for all your reports and continued support - it really helps us improve the game! 🍻",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you soon,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Beer Manufacture Simulator Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
