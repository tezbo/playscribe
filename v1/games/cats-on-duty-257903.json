   "displayName": "Hotfix 1.0.0.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-08-01T11:21:46.000Z",
   "notes": [
    {
     "title": "Atten-shun, Cat Defenders!",
     "items": [
      {
       "text": "We just launched a quick patch for Cats on Duty with a few tweaks and fixes based on your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's what's in it",
     "items": [
      {
       "text": "Fixed freezing that could happen starting from Stage 2 after Slime enemies break through defenses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixing minor issues with music in game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level balancing changes for smoother difficulty progression",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, if you encounter any issues with Cats on Duty or just want to leave your feedback, feel free to drop 'em at the Community Hub!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cats Defense Squad, over and out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
