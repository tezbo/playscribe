 "releases": [
  {
   "id": "cats-on-duty-257903@post-2024-08-15",
   "gameId": "cats-on-duty-257903",
   "displayName": "Cats on Duty Now Available on Linux with Full Steam Deck Support!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-08-15T15:06:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are excited to announce that Cats on Duty has finally been released on Linux with full support for Steam Deck! Along with this release, the new version of the game sparkles with all the latest fixes and QoL improvements to enhance your gaming experience:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the issue with the right RT trigger not moving the cursor to the right half of the game field, on Linux and Steam Deck;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the level loading animation for the Steam Deck version;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the screen resolution issue for the Steam Deck version;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug with the slug;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "OST playback issues fixed, again…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved visual effects;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug with small slugs, chicken and a jumping beetle (yes, we know that you love that little fella very much);",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The difficulty of levels 3-5 has been rebalanced (these levels are now easier due to numerous requests from the Community).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get ready to lead your feline troops to victory, now on even more platforms!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
