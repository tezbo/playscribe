  {
   "id": "clash-artifacts-of-chaos-154769@post-2022-10-06",
   "gameId": "clash-artifacts-of-chaos-154769",
   "displayName": "Steam Next Fest Demo - Patch Notes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-10-06T13:21:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Howdy All,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for checking out the Clash: Artifacts of Chaos demo as part of the Steam Next Fest. We've been blown away by the support and feedback we've received so far. We're hard at work preparing for the release on February 9th, but we couldn't leave some of the problems with the demo unaddressed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So we've pushed out a small patch that should fix a few cases of crashing and expand on a few missing options. As always, we remain disposable on our Discord and in the Steam Discussion boards if you have any more feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Steam Fest Demo Patch",
     "items": [
      {
       "text": "Added Invert Y axis to camera options in settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added camera sensitivity options in the settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed crash in dialog manager.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash related to challenge totems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed stability issue related to achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed AIs not locating the player if they were too far away.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ensured enemies will not retreat when they are engaged in first person.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AIs not participating in the Ritual can no longer attack the player during it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Manual camera lock is enabled on ragdolled enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Area confinement function uses a collision mesh instead of gradually affecting the player’s velocity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
