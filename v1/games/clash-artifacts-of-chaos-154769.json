  {
   "id": "clash-artifacts-of-chaos-154769@28402",
   "gameId": "clash-artifacts-of-chaos-154769",
   "displayName": "Patch 28402",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-03-10T13:56:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A small patch has just been pushed to Steam to fix a number of issues that were reported to us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's what changed",
     "items": [
      {
       "text": "Added confirmation pop-up for assigning skill points and figurines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Boy disappearing after the Palace Cinematic. For corrupt save files visiting the area where Claw Boss is located restores the Boy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Boss not responding after being attacked in night phase.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added additional facial animations and lip syncing to Pseudo and other characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed enemy physics bug where they could be pushed at a great distance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed first person camera pain animation not showing up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dead enemies no longer collide with invisible walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed water volumes sometimes not working.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved smoke artifact Player vs Enemy (enemies strike each other accidentally)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issues with hard lock in first person mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed foot placement \"jittering\" and collision detection for giant enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved enemy placement for non-targeted enemies in first person mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Titan mammoth has updated hitboxes and less predictable attack patterns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Credits updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We want to thank you for your cooperation and patience, and hope you're having a grand time in the lands of Zenozoik.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
