  {
   "id": "decollate-decoration-266187@major-2026-03-24",
   "gameId": "decollate-decoration-266187",
   "displayName": "[Update] Point Shop Open & Traditional Chinese Support!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-24T12:45:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing \"Decollate Decoration.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are excited to announce that the highly requested Steam Point Shop is now open!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A variety of items are available, including animated avatar frames, beautiful profile backgrounds, and cute stickers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please enjoy \"decollating\" your Steam profile to your heart's content!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition, we have added Traditional Chinese support in this update! You can now switch between the following languages in the game settings:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "English",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simplified Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Traditional Chinese (NEW!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are currently participating in the Steam Spring Sale!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't miss this chance to check out the newly added Traditional Chinese support and our brand new Point Shop!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45194381/4fc249fd629d22cb2d88bd322fef4e136045a84e.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
