  {
   "id": "decollate-decoration-266187@major-2026-01-29",
   "gameId": "decollate-decoration-266187",
   "displayName": "[Update] New \"DIARY\" Feature & UI Improvements",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-29T09:40:11.000Z",
   "notes": [
    {
     "title": "We have made the following adjustments in this update",
     "items": [
      {
       "text": "Added \"Diary\" to the main story menu.: This feature records the action commands selected each week, allowing you to review your past choices.: Please note that for save data created prior to this update, logs for previous weeks will appear blank.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted Hint screen layout of the main story.: The third page now contains hints regarding the icons, so refer to this if you find it difficult to progress through the story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed text colors in specific ending scenes.: While we will not go into detail to avoid spoilers, this change was made to help distinguish between different scene variations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "On the first page of the Hint screen, a checkmark will now be displayed for any endings you have already achieved.: [img src=\"{STEAM_CLAN_IMAGE}/45194381/5b84c72555c3ca6855a0660c472aa0986a4681ba.png\"]: [img src=\"{STEAM_CLAN_IMAGE}/45194381/db68c8ee961b64be6da35e850058d98ad96ee07f.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
