  {
   "id": "tour-de-france-2024-288855@patch-2024-06-20",
   "gameId": "tour-de-france-2024-288855",
   "displayName": "First patch is here!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-20T15:34:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now update your game with the first TDF 2024 patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Visual",
     "items": [
      {
       "text": "Added new unlicensed headsets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Pro Team/Pro Leader mode: activation of licensed equipment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Criterium Mode: correction of wrong skin color and body shape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "AI: Fixed sprint trains being too slow at the end of a stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI: Fixed cases where the race leader works at the head of the group to catch up with riders who are not very dangerous for him while his main rivals are in the same group.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI: Fixed cases where a leader is working at the head of the group while he still has teammates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI: Fixed cases where a leader puts his best climbers to work from the start of a mountain stage while he still has riders to keep the pace.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI: Fixed the role “Aim for the mountain ranking” which no longer worked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI: Fixed dropped rider when using Fast Forward from the start.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI: Fixed cases of escaped riders no longer wanting to collaborate without a valid reason.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI: Fixed the composition of morning breakaways on flat races to no longer only have breakaway climbers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI: Fixed cases of peloton being too passive on classics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pro Team/Pro Leader mode: fixed cases where races are not unlocked despite the required conditions being met.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed loss of tracking due to triggering save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated rider notes and squads.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Multi",
     "items": [
      {
       "text": "Criterium mode: adjustment on the change of rider to avoid taking control in the middle of a turn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Race of the Moment: correction of problem sending results.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Split Screen Mode: Fixed cases where the player could get dropped when using Fast Forward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Split Screen Mode (Versus): Fixed the wrong rider being controlled at the start for player 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "UI",
     "items": [
      {
       "text": "Fixed incorrect icons in the Fast Forward menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the ranking of intermediate sprints which do not display 15th position.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed flickering issues on the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with sorting riders in the Editor Registrations menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Activation of the display of energy gauges for teammates on the rider cartridge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Criterium mode: change of the icon indicating that changing riders is not possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Split Screen Mode: Restored the display of player 2's name during the race.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Split Screen Mode: Fixed incorrectly displayed text on the results page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Split Screen Mode: correction of incorrect display at the start of time trials.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Split Screen Mode: Fixed incorrect display when a player finishes the race.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Audio",
     "items": [
      {
       "text": "Setting the triggering of comments to Fast Forward to have fewer delayed comments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the inappropriate triggering of certain comments during the race.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Re-enabled split-screen comments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed case where the Sports Director starts the briefing at the same time as the stage intro video.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Tour de France game team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
