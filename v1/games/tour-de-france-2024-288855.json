  {
   "id": "tour-de-france-2024-288855@patch-2024-09-30",
   "gameId": "tour-de-france-2024-288855",
   "displayName": "New patch - Various Fixes.",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-09-30T07:53:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear cyclists fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our new patch for Tour de France 2024 on PC is now available.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Patchnote",
     "items": [
      {
       "text": "Updated Vuelta jerseys (Arkéa B&B Hotel - Quick-Step - Movistar)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated cyclist stats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved AI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved handling of dangerous riders in breakaways",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjustments to trains so tired riders no longer attempt to stay in relay lines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved sprint cornering on summit finishes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted AI trajectories to reduce collisions in downhill turns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved \"follow\" mode for better positioning behind the rider ahead",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted outsider reactions to favorites’ attacks to be less passive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed incorrect acceleration stat use in sprints",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed sprinters attempting breakaways early in the Tour on hilly stages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed sprinter teams trying to catch breakaways on mountain stages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with leaders losing protection in Fast Forward",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed leaders sacrificing themselves for teammates and losing general classification chances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed teammates not working in the final stage even when able",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed overprotective teammates switching leaders too often",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed teammates not taking over relay duties in the last 25km even when commanded",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted energy consumption and speeds based on the latest Tour de France ascent times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted attack patterns of leaders to prevent unnecessary flatland attacks by riders like Vingegaard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted teammate trains on hilly terrain to preserve energy for longer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced breakdowns on flat terrain",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted sprint launches to better account for freshness in estimating sprint distances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Optimized CPU calculation times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Tour de France game team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Join-us",
     "items": [
      {
       "text": "Facebook Twitter Instagram Official Discord Server Nacon TikTok",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
