  {
   "id": "eriksholm-the-stolen-dream-305107@major-2025-07-28",
   "gameId": "eriksholm-the-stolen-dream-305107",
   "displayName": "Eriksholm: The Stolen Dream – Bug Fix Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-28T13:50:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just released a patch for Eriksholm: The Stolen Dream with a number of fixes and improvements based on your feedback. Thank you so much for playing and sharing your thoughts – it helps us make the game better for everyone!💛",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s what’s included in the latest update",
     "items": [
      {
       "text": "Bug Fixes & Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a number of possible soft locks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed body placement when dragging someone",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Vent leaving logic on Mouse and Keyboard controls have been updated to have better pathfinding when clicking far away from the vent exit",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Adjusted chapter complete for the final level to trigger after last cutscene instead of after credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue with lingering animations not ending as intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several fixes and adjustments to improve visuals and fix glitches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimizations to several areas to improve performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, please keep your feedback coming and let us know if you encounter any issues. Thanks again for your support and for being part of the Eriksholm journey!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– The River End Games & Nordcurrent Labs Teams",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
