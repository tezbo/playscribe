  {
   "id": "eriksholm-the-stolen-dream-305107@major-2025-06-17",
   "gameId": "eriksholm-the-stolen-dream-305107",
   "displayName": "The Journey Continues - Demo & Pricing Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-17T13:00:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re incredibly grateful for all the love you’ve shown for Eriksholm over the past week. It means the world to us. Seeing so many of you connect with a game we’ve poured our hearts into is truly humbling — and the best part is, there’s still so much more waiting to be discovered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you haven’t had the chance to try the demo yet, we’ve got good news: it will remain available right up until the game’s full release, just four weeks from now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While our journey as a team on this project is nearing its end, your journey into the world of Eriksholm has only just begun. We can’t wait for you to experience the full game soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Eriksholm: The Stolen Dream will be priced at 39.99€ / 39.99$ / 33.50£ on PC.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Stay tuned, and thank you again for being part of this with us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "— The Eriksholm Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
