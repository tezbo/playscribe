  {
   "id": "a-castle-full-of-cats-210901@major-2024-05-24",
   "gameId": "a-castle-full-of-cats-210901",
   "displayName": "Final update is coming June 12th!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-24T18:13:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, hoomans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have a furtastic ameowncement for you! ːlovecatː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The final update for A Castle Full of Cats is coming on June 12th! ːcatbatː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are overjoyed with all the love you guys have been constantly shedding over us and our Castle Full of Cats. ❤",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fofiño and Lily's story in the castle is complete, but who knows what the future holds, right?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Lily is always \"glued\" to Fofiño, she loves him very much in real life too!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can see their faces again and enjoy new stories in our newest game, A Tower Full of Cats!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Help Leo unravel the mysteries of the Tower, discover over 1400 cats, and conquer 70 different achievements. 🚀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't miss out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Love & Purrs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Devcats ฅ^•⩊•^ฅ",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
