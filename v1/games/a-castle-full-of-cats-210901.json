  {
   "id": "a-castle-full-of-cats-210901@major-2022-11-26",
   "gameId": "a-castle-full-of-cats-210901",
   "displayName": "Update & News",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-26T17:52:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi, humans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Catherine's Mission minigame has been updated to include Steam Leadearboards! ːcathspawː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prove you're the best in helping cats!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can grab the DLC 20%OFF if you already have A Castle Full of Cats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "December 14th Update",
     "items": [
      {
       "text": "If you found the arcade poster, you saw this mysterious date in the title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update will bring you an Arcade Mode, that is going to be an endless version of Fofiño's battle, also with Steam Leaderboards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We know some people don't like this type of challenge/competition, but don't worry, there won't be achievements related to this update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just want you to have some fun. :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's all fur now, humans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Love & Purrs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Devcats ฅ^•ﻌ•^ฅ",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
