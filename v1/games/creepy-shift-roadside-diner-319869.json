  {
   "id": "creepy-shift-roadside-diner-319869@major-2025-10-30",
   "gameId": "creepy-shift-roadside-diner-319869",
   "displayName": "🎃 Halloween Update + Security Notice",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-30T15:54:34.000Z",
   "notes": [
    {
     "title": "Heya creeps!",
     "items": [
      {
       "text": "Unity recently flagged a security issue, so we bumped the game to the fixed version. Nothing suggests players were affected, but better safe than sorry. Grab the update to stay on the safe build.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unity post (for the curious): https://unity.com/security/sept-2025-01",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changeloge",
     "items": [
      {
       "text": "✅ Unity security update applied",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚡ A couple of performance/stability tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📱 Steam Deck / handheld: UI text now scales better, so you don’t have to squint",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "*All of the above changes also apply to the demo version. Additionally, the demo also includes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Removed AI VO and replaced with community-recorded voices",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🖼️ Replaced AI-generated Pastor portrait with a new one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚡ Game optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🌍 Improved translations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔧 Fixed occlusion issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎮 Improved controller ergonomics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If something bugs out or you’ve got a cool idea → drop it on our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have a scary Halloween and stay creepy!💀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Night Shift Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
