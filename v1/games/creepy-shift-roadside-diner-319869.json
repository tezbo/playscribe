  {
   "id": "creepy-shift-roadside-diner-319869@patch-2025-01-27",
   "gameId": "creepy-shift-roadside-diner-319869",
   "displayName": "Big changes in the latest patch.",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-01-27T17:52:01.000Z",
   "notes": [
    {
     "title": "Ave creeps! A BIG patch just dropped",
     "items": [
      {
       "text": "Save system – you can now start the game from any of the 3 chapters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "10% longer gameplay – more time for sim tasks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New achievements",
     "items": [
      {
       "text": "True Hero – Spend at least one minute hiding in a locker in the changing room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fatal Finale Connoisseur – Discover every possible death scene that ends the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Terror Tracks – Listen to every track on the jukebox for at least 10 seconds each.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Simulator quest completion – You can now wrap up side quests even after finishing the main storyline!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We’re so grateful for your feedback and ideas. Thanks to your involvement, this project has taken shape into something we’re truly proud of.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Night Shift Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
