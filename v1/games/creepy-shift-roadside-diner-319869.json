  {
   "id": "creepy-shift-roadside-diner-319869@patch-2025-05-27",
   "gameId": "creepy-shift-roadside-diner-319869",
   "displayName": "Patch Drop & New Creepy Shift on the Way!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-27T14:06:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Heya creeps!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just dropped a patch packed with improvements, fixes, and tweaks based on your feedback:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🖱️ Fixed incorrect button icons in the UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🚀 Improved overall game optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👁️ Fixed FOV-related graphical glitches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🐞 General gameplay bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✋ Polished hand animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "But that's not all...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re thrilled to announce that the next chapter in the Creepy Shift series is in the works!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are cooking surreal blend of simulation, horror, and psychological depth, all wrapped in a dark noir atmosphere.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game page just went live – don’t miss it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Creepy hugs!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "— Night Shift Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
