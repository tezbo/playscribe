  {
   "id": "creepy-shift-roadside-diner-319869@patch-2024-11-29",
   "gameId": "creepy-shift-roadside-diner-319869",
   "displayName": "Steam Deck Ready with a Game-Changing Patch!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-29T10:37:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Creeps,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re thrilled to announce that Creepy Shift: Roadside Diner is now fully compatible with Steam Deck! Dive into the eerie adventure wherever you go and enjoy the chilling experience on handheld.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Alongside Steam Deck support, our latest patch introduces some useful improvements:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Head Bobbing Toggle: Disable head bobbing for a more stable camera view.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lens Distortion Toggle: Enjoy clearer visuals by turning off lens distortion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Skip Game Intro: Jump straight into the action by skipping the intro sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope these updates make your shift even more terrifyingly smooth. Thank you for your continued support and feedback—it’s what keeps us crafting the spookiest experience possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay creepy, and may everything be frightfully fantastic!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "— Night Shift Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
