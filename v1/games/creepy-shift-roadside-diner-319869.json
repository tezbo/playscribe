  {
   "id": "creepy-shift-roadside-diner-319869@patch-2025-10-02",
   "gameId": "creepy-shift-roadside-diner-319869",
   "displayName": "Community Patch JUST DROPPED!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-02T14:38:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ave Creeps!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are back with a patch addressing the things that frustrated you the most. First and foremost, we made a complete clean-up of AI – all AI-generated voices have been removed and replaced with real voices from our amazing Discord Community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We would like to personally thank",
     "items": [
      {
       "text": "OctopusCarDoor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "JMackstreams",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "CruelJustice",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And everyone who helped and offered their support during the making of this patch. Without your energy, recordings, and contributions, this update would not have been possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "✅ Removed AI VO and replaced with Community-recorded voices",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🖼️ Replaced AI-generated Pastor portrait with a new one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🏆 Added 6 new achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚡ Game optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🌍 Improved translations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⏳ Extended gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👻 Fairer difficulty balance (red ghost movement adjustments)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "☁️ Added cloud save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔧 Fixed occlusion issues (disappearing objects at camera angles)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎮 Improved controller ergonomics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to you, the Creepy Shift series not only exists but continues to grow. We are beyond happy to see the Community on Discord becoming more active and creative every day. Special thanks go to our talented admin Fin, who keeps the server alive and welcoming. Join us there, help shape the next episodes, and let’s keep the creepy fun going together!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NIGHT SHIFT TEAM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
