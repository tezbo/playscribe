  {
   "id": "brave-x-junction-342093@post-2025-12-08",
   "gameId": "brave-x-junction-342093",
   "displayName": "Release Notes for 12/08/2025",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-12-08T02:43:12.000Z",
   "notes": [
    {
     "title": "Main fixes include",
     "items": [
      {
       "text": "Corrected status display in the Monster Encyclopedia and added display of monster capacity (denominator).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a shortcut to call up the save screen by pressing the + button while moving through a dungeon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As a balance adjustment, the attack power of the fighter's unique ability \"Three 7\" has been increased from x2 to x3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased damage taken when the auxiliary effect \"BJ Guard\" is successful from x1.5 to x0.5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other typos and omissions in the text have been corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
