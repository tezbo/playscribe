  {
   "id": "brave-x-junction-342093@1.0.1",
   "gameId": "brave-x-junction-342093",
   "displayName": "Update 1.0.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-09T03:34:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve released Ver. 1.0.1!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The main fixes and adjustments include",
     "items": [
      {
       "text": "Corrected status displays in the Monster Encyclopedia and added the missing capacity (denominator) information for monsters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45600298/d1d3a63f67c89f2e96fa7f608fe88b3be2170960.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a shortcut that allows you to open the save screen by pressing the + Button / Options Button while moving through dungeons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45600298/57e4b446b7bf2a6979d6cfddd9af6897ad7d4f61.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Balance adjustment: increased the Fighter’s unique ability “Three 7s” damage boost from 2× to 3×.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45600298/f4269558272d908ade6c763e0bc8606560a62a23.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Strengthened the support effect “BJ Guard” so that the damage received when activated is reduced from 1.5× to 0.5×.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enjoy the new improvements in this update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
