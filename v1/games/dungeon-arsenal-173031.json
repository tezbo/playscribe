  {
   "id": "dungeon-arsenal-173031@1.0.4",
   "gameId": "dungeon-arsenal-173031",
   "displayName": "Update 1.0.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-21T02:34:58.000Z",
   "notes": [
    {
     "title": "List of Changes",
     "items": [
      {
       "text": "> Twitter page link added to the Title Screen;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> “USE” text replaced by “DUR” (durability);",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> The Relic “Devil’s Scarab” is now a Shop-only Relic. Additionally, its bad effect was adjusted from -3 max Life Points to -2 max Life Points;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> Blade Oil item now visually identifies its target Card;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> fixed a bug that caused an error when finishing the game with the “Thief’s Belt” Relic;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
