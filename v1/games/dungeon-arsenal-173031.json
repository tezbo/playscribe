  {
   "id": "dungeon-arsenal-173031@1.0.5",
   "gameId": "dungeon-arsenal-173031",
   "displayName": "Update 1.0.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-22T21:33:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "> Information about how many times you finished the game with each hero added to the hero’s information box on the Hero Select screen;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> Build version is now also displayed on the Floor Room;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> “Dagger” Weapon effect is now working properly and was increased from 20% to 25% chance;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> “Assassin’s Dagger” Weapon effect is now working properly and was increased from 40% to 50% chance;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
