  {
   "id": "dungeon-arsenal-173031@1.0.2",
   "gameId": "dungeon-arsenal-173031",
   "displayName": "Update 1.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-11-01T13:29:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 1.0.2 ends the Halloween event.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.0.2 Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes and Balance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug on the item card “Key” which allowed it to be used even with 0 AP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Now the \"Blade Oil\" item card will give +1 ATK to all Axes variants.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The requirements for some Steam Achievements were adjusted.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The requirements to unlock some heroes were adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The requirements to unlock some hero’s card borders were adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A new difficulty mode was added: “Insane”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Two new Steam Achievements were added, both related to the new difficulty mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Now some stats of your run will be displayed on the game over screen and when you finish the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Misc",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A few spider webs from the Halloween event will stay where they are, for now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
