   "announcedAt": "2021-09-28T02:53:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "> Added 5 unlockable Card Borders for Hero Cards (customization);",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> Fixed a bug that made the “AP Source” Card to not be destroyed when changing floors;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> The “X” Card on Boss Battles will now be automatically destroyed 1.5 seconds after being revealed;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> “Rat” and “Imp” monster cards’ effect was updated;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
