  {
   "id": "dungeon-arsenal-173031@1.0.6",
   "gameId": "dungeon-arsenal-173031",
   "displayName": "Update 1.0.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-25T01:05:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "> Adjusted the rate for the Weapons on Normal Floors and Boss Floors;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> The “AP Source” Event Card must now be clicked for its effect to be activated;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> The Cards’ rows are now identified from 1 to 3 for future features;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> The Cards’ columns are now identified from A to D for future features;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> Added two new unlockable Weapons;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> Save system on previous versions was broken and a new one was made. The game on this version (1.0.6) will be as it was installed for the first time. Sorry about that but beta is beta.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
