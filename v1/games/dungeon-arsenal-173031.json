  {
   "id": "dungeon-arsenal-173031@1.0.3",
   "gameId": "dungeon-arsenal-173031",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-20T02:27:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1.0.3 Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes and Balance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The “Omamori” relic cost was reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The “Tower Scheme” cost was reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a button in the Shops to refresh the Relic (works once per Shop visit).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added three new Relics: Magical Hat: Whenever you discard a “Wooden Staff”, heal 1 extra HP.: Framed Heart: Every time you fill up the Special Gauge, heal 2 HP.: Thorn Shield: Whenever an enemy misses an attack it takes 1 damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bosses now have effects! Fight them to see what they are capable of now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Misc",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The item “Blade Oil” will no longer appear on Chests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The “Thief’s Belt” relic is now exclusive to the Rogue and its effect was updated to: Floor Start: if you have no cards in hand create a 'Dagger' Card in hand. If your hand is full, heal 1 HP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
