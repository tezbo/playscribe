  {
   "id": "disaster-band-229138@1.10.3.0",
   "gameId": "disaster-band-229138",
   "displayName": "Update 1.10.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-13T16:05:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello fellow disaster musicians,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we can announce the next stop on our update tour, where we not only have some fixes in store, but perform new songs with new instruments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you enjoy the additions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Added",
     "items": [
      {
       "text": "Add custom character animation for the electrical guitar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Add new Song: 'The Blue Danube'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Add new Song: 'Morning Mood'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Add new Instrument: 'Timpani'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Add new Instrument: 'Kazoo'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixed",
     "items": [
      {
       "text": "An issue that could break the UI in the lobby if a savegame with an unknown date format was loaded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "An issue in multiplayer that notes played by others would be audible twice for the local player even though they were just played once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "An issue that could occur when multiple keys to play a note would be pressed very fast and would cause a single note to be audible indefinitely.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Important: All new instruments will be released with a barrel organist as a character animation. This is a placeholder that will be replaced when the actual animation for the new instrument is ready.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "More chaos with more songs and more instruments to follow...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The teams from",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Produktivkeller Studios and Toplitz Productions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
