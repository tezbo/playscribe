  {
   "id": "disaster-band-229138@1.6.0.0",
   "gameId": "disaster-band-229138",
   "displayName": "Update 1.6.0.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-01-17T09:57:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new small fix for you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Added",
     "items": [
      {
       "text": "Using green as default note color.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixed",
     "items": [
      {
       "text": "Cleaned up memory of background track manually when unloading the 'Music Arena' and does not load background tracks to memory in lobby to prevent excessive RAM usage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Set default maximum FPS to 60 to prevent GPUs from burning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Load settings in splash screen to remove stuttering when opening the settings, the first time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Accuracy Rating of player will no longer break when a song contains overlapping notes in a glissando (Happened in track from workshop).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
