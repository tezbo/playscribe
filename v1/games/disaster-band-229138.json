  {
   "id": "disaster-band-229138@1.12",
   "gameId": "disaster-band-229138",
   "displayName": "Update 1.12",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-06T15:04:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello fellow Disaster Bandmates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The good things keep on coming.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this case a new content patch that not only gives you more choice in terms of songs and instruments, e.g., now you can play the traditional Chinese instrument Erhu, but also some technical improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "But we don’t want to keep you longer than necessary from taking center stage so here are the changes and additions:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Background tracks can now be either .mp3 files or .wav files, to allow for smaller song directories. Also, the .wav files of all the base tracks have been replaced with .mp3 files.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new hint after the start screen has been added that shows the user Steam workshop songs that he has not subscribed to. This can be adjusted and also disabled in the settings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A button to download the missing song will be shown to the user when the host selects a Steam workshop song that is missing. The game no longer has to be restarted.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The animation for the Theremin is now more satisfying. There now is more visual feedback for pressing the play button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new animation for the Choir has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new traditional Chinese instrument, the Erhu, has been added, including a custom animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new instrument has been added: The Cat. Miaow!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new song 'Frère Jacques' has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy while we prepare the next content serving coming to your screen very soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The teams from",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Produktivkeller Studios and Toplitz Productions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
