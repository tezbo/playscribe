  {
   "id": "disaster-band-229138@1.11",
   "gameId": "disaster-band-229138",
   "displayName": "Update 1.11",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-27T15:24:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello chaos musicians,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "another week, another update for your favorite rhythm game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This time we kept it short and sweet, so next time you take this show on the road you have one more encore song as well as two more instruments to choose from.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Over the next few weeks there will be more to follow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "But for now let's stay in the present... These are this weeks' patch additions:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add custom character animation for the theremin.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add new Song: 'Prelude No.1'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add new Instrument: 'Vocal Soloist'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add new Instrument: 'Whistler'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And remember: Don't stop the music!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The teams from",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Produktivkeller and Toplitz Productions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
