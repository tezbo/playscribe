 "releases": [
  {
   "id": "disaster-band-229138@major-2024-07-01",
   "gameId": "disaster-band-229138",
   "displayName": "Tour Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-01T18:00:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "To all band members old and young,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It means the world to us and it feels good to see that your passion for music games aligns with ours.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the next few weeks, we will focus on the console versions for PlayStation 5, Xbox Series X|S and Nintendo Switch, but will take care of critical bugs that the new update might have caused, of course.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "We want to make sure that we can give the fresh members of the Disaster Band family the same experience that you can enjoy on PC already.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "In particular in terms of multiplayer and the cross-platform-compatibility, so everybody can join and jam with everybody, regardless of their preferred platform.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'll see you on the Disaster stage!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Produktivkeller Studios and SunDust",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
