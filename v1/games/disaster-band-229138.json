  {
   "id": "disaster-band-229138@1.9.0.0",
   "gameId": "disaster-band-229138",
   "displayName": "Update 1.9.0.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-03T17:41:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends of the world's most chaotic band!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There will be rock and there will be spherical! With the electric guitar, the rock feeling is coming into play, and with the theremin, you get a touchless instrument that you can cuddle with your computer mouse from now on.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Plus, two classics of music history: the \"Ride of the Valkyries\" and \"Amazing Grace\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Plug in the instruments, warm up your fingers and get playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Added",
     "items": [
      {
       "text": "Added new Song: 'Ride of the Valkyries'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new Song: 'Amazing Grace'.",
