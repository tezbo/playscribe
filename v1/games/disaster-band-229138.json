  {
   "id": "disaster-band-229138@1.13.4.0",
   "gameId": "disaster-band-229138",
   "displayName": "Update 1.13.4.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-19T15:00:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disaster Band receives a new update. We also want to take the opportunity to announce that Disaster Band will start to move to mod.io for adding modding content and Steam Workshop will be in read only mode afterwards. We’ll provide further details in the near future!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "1.13.4.0",
     "items": [
      {
       "text": "Add animated character for playing the Timpani.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added animated character for playing the Cat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added animated character for playing the Whistler.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added animated character for playing the Singer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added animated character for playing the Kazoo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
