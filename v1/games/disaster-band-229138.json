  {
   "id": "disaster-band-229138@1.15.0.2",
   "gameId": "disaster-band-229138",
   "displayName": "Update 1.15.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-26T14:09:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another round of updating for Disaster Band!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disaster Band will start to move to mod.io soon for adding modding content and Steam Workshop will be in read only mode afterwards. We’ll provide further details in another update!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Make UI while playing songs responsive for Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Change width of header on narrow resolution to not intersect with back button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Anchor elements in the corner when resolution is narrower than 16 to 9 so they don't get cut off on Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix position of instrument label in player list in lobby when player is not ready.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix cursor configuration so the click happens where the cursor points at (there was a small offset).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Add fallback logic for parsing 'Last Played' date on song information (could fail after changing the system language).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update region badge in lobby when language changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix backwards navigation in connect screen with controller (B button now works).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players left or joined notifications (on the left) on Steam Deck no longer get cut off.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Kick Player button in lobby on Steam Deck is no longer covered by the player list on the right.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Add a lobby browser to easily find open multiplayer sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add automatic matchmaking for multiplayer sessions in the current region (Quick Join).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
