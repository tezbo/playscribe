  {
   "id": "deathverse-let-it-die-178297@1.1.2.2",
   "gameId": "deathverse-let-it-die-178297",
   "displayName": "Patch 1.1.2.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-11-04T00:10:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone, thank you all for playing DEATHVERSE: LET IT DIE! We're now halfway into the Season, and with the beginning of Season 1 - Phase 2, we've introduced a number of updates and changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PATCH NOTES - ver.1.1.2.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New weapon \"Twin Knives\" added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New machete, katana, hammer, arms, and buzzsaw added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New mastery bonus \"Dropkick\" added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Two new areas added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Material Tickets (Common, Uncommon) are now available for exchange in units of 50.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues that occurred when starting Special Matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed description displayed when upgrading Jamboree Passes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The \"!\" icon will no longer be displayed when acquiring materials you have previously obtained.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the balance of materials available from match results.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where players would become unable to move in certain locations, preventing game progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where performing certain actions allowed the use of Deathblows while airborne.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Begin Match button will no longer be displayed during the rank change animation,: as finalizing matchmaking during this animation prevented it from being displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the behavior that occurs when opening the Resolution tab on the Graphics Settings screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Additional Information",
     "items": [
      {
       "text": "LET IT DIE Collection 7-Day Login Bonus begins",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spiky Punk Bundle, Mince and Cut Bundle, and Metro Fighter Outfit added to the Shop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player ranking adjusted based on previous placement, Phase 1 rewards sent to reward box",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Phase 2 will last until December 7th, 2022: Stay up to date with DEATHVERSE news using our Twitter: https://twitter.com/LETITDIETheGame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
