  {
   "id": "soundfall-106821@major-2022-09-02",
   "gameId": "soundfall-106821",
   "displayName": "Update Notes for 9/2/2022",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-02T18:28:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added a HUD indicator of the current best-possible mission award tier the players can achieve",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made Banshee and Discord drop loot on death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a gate that was sometimes blocking players from entering in Beach",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed each world map region’s initial dialogue playing each time the region map is opened, until the first level is completed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several menu issues when using a 3:2 aspect ratio (such as with the Surface Pro)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made Jaxon’s Audio Axe projectile penetrate multiple enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues with Jaxon’s charged smash ability movement on ice",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a slight bounce-to-beat to BeatRail nodes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Brite's shield interfering with gamepad auto aim when deployed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Balance updates",
     "items": [
      {
       "text": "Increased player equipment damage at level 50+",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Slightly reduced Lethal intensity enemy health",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced Brute enemy health across all intensities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased loot quality from non-final treasure chests",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased general quality of mid-game loot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Slightly reduced enemy counts on Lethal intensity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Decreased delays between enemy spawns to make it a bit easier to finish songs before they loop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
