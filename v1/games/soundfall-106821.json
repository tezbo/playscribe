      },
      {
       "text": "Bioluminescence (Late Night Nostalgia Mix) - SonikBuster",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bit Fight - White Drift",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Inner Stress - Autohacker",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Beholder - Ruzer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dancing with the Devil - Bonkers Beat Club",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get Out of My Way - Tape Machines feat. Vicki Vox",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wasn't Even Close - Velveteen feat. Astyn Turr",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new quests associated with Song Pack 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a “Featured” tab to the Free Play menu that showcases newly added music",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enable FLAC support for importing songs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed Extreme and Lethal intensity unlock quests to remove the story completion requirement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Ping display to Multiplayer menu and Pause menu for non-host players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Replay Mission Dialogue\" option to Options Gameplay tab to allow players to disable replaying of dialogue when replaying missions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a simple “Teleport to Teammates” keybind action that teleports a player to an area near their teammates if they are having trouble getting through an area",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Prevent the Tutorial level from confusingly granting a mission reward medal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed reset to default keys to correctly re-add secondary keybinds",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Stop score/kills/etc from updating in UI after mission complete as it won't affect rewards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Smasher’s Fissure knockback not respecting players’ knockback resistance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several miscellaneous fixes for level stuck spots and potential progression blocks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
