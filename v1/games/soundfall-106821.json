  {
   "id": "soundfall-106821@major-2022-05-19",
   "gameId": "soundfall-106821",
   "displayName": "Update Notes for 5/19/2022",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-05-19T20:55:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added a restart level option to the pause menu when playing in single player or local co-op",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue that could cause long stalls in online multiplayer and Cityscape levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed manual beat map label loading and UI display for songs imported from the same windows drive letter as the game installation directory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added an Imported Songs category to the top of the Biome list in Free Play. They will also be listed in the appropriate biome",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed metadata parsing for some MP3s with non-English titles and correctly enable Arabic font for imported songs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a confirmation prompt when trying to remove imported songs and correctly update the Free Play menu UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added language select to the display options shown before starting a new game. It is also accessible from the main options page in the menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a depth of field toggle to the video options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed FOV scaling to use the window height instead of width, this correctly zooms the camera for ultrawide resolutions like 21:9",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Made Intensity on the World Map only reset to the highlighted location’s default if the player hasn't adjusted it during that session, until they return to the Overworld map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor balance adjustments based on player feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made health pickups more frequent",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slight increase to early game health",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made equipment drop rarity a bit more generous, but pushed Legendary chance down a bit in early and mid levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced Banshee boss health",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a bug that was preventing the final boss from using some of his attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed auto-aim not applying to enemies on pressure plates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a spot in Cityscape where players could fall out-of-world",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an enemy spawn delay that was happening in some Crypt levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed enemies occasionally spawning inside of collision in Depths",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a spot near Forest exit doorways where players could get stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made the metronome sound option default to \"After no recent on beat input\" for new players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent the metronome sound from playing during dialogue and cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed incorrect BPM being displayed in the menus for \"Toss the Salt\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "NOTE: Some of the new options are missing translations, which will be fixed in a future update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
