  {
   "id": "soundfall-106821@major-2022-06-06",
   "gameId": "soundfall-106821",
   "displayName": "Update Notes for 6/6/2022",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-06T17:57:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added content creator whitelisting message to startup screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added secondary key binding display to tutorial tip widgets",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug where viewing or changing gamepad binds would re-add keyboard binds removed by the user",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some incorrect song BPM displays",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Beatmap fixups for a few sections of \"It's Almost Spring Back Home\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that caused some equipment perks to not always apply properly during missions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made encounters start when all alive players enter an encounter zone, no longer counting downed players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made the entrance gate to an encounter zone not close if there is a downed player outside of the encounter zone when it starts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Brite's plantable shield leaving its SFX active after subsequent activations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Brite's plantable shield immediately destroying if deployed just as the previous one is destroyed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue causing Ky’s ultimate to occasionally break aiming input after ending",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added some Legato dialogue lines mentioning the Calibration options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue that would occasionally prevent Banshee from properly transitioning to the next phase of the boss fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed misaligned Jaxon primary ability Nocturne slash VFX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed heroes not properly being unlocked for guest players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Don't track on/off beat actions after mission complete as the medal has already been decided",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several misc fixes for level stuck spots and potential progression blocks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes for several misc crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
