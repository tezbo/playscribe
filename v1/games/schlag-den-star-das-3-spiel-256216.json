   "gameId": "schlag-den-star-das-3-spiel-256216",
   "displayName": "Update 9.0",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-20T12:39:02.000Z",
   "notes": [
    {
     "title": "Verbesserungen",
     "items": [
      {
       "text": "dieses Update stellt die technische Grundlage für das Zusammenspielen aller Plattformen dar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "der Lobby-Ersteller wird nun in der Serverliste mit angezeigt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bei der Tastenbelegung für den 2. Spieler wurde Y zu Z getauscht",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nach dem Verlassen eines Servers wird die Serverliste nun automatisch aktualisiert",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "der Beschreibungstext für \"Wörter finden\" wurde aktualisiert",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spieler im eigenen Match können jetzt geblockt, und/oder gemeldet werden",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fehlerbehebungen",
     "items": [
      {
       "text": "das Problem, dass in diversen Minispielen eine Asynchronität auftreten konnte, wurde behoben",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ein Fehler wurde behoben, dass manchmal nur schwarze Symbole statt Text angezeigt wurde",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ein Fehler wurde behoben, dass im Show Modus die Punkte manchmal nicht korrekt gezählt wurden",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ein Fehler wurde behoben, dass die Charaktere entgegen der tatsächlichen Situation glücklich oder traurig schauten",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "diverse weitere kleinere Fehler wurden behoben",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
