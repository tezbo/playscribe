  {
   "id": "schlag-den-star-das-3-spiel-256216@9.02",
   "gameId": "schlag-den-star-das-3-spiel-256216",
   "displayName": "Update 9.02",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-31T15:02:27.000Z",
   "notes": [
    {
     "title": "Änderungen",
     "items": [
      {
       "text": "ein Problem bei sehr langen Spielernamen wurde behoben",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ein Problem wurde behoben, dass der Ball bei Zick-Zack durch das Spielfeld fallen konnte",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ein Problem wurde behoben, dass in Multiplayer-Runden Antwortoptionen verschwinden konnten",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Probleme mit der Synchronisation im Multiplayer wurden behoben",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "der Fehler wurde behoben, dass Objekte manchmal die Tasten überdeckten, wenn man im Pause-Menü war",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "der Fehler wurde behoben, dass Spieler die Charakterauswahl manchmal nicht verlassen konnten, ohne zuvor einen Charakter ausgewählt zu haben",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "das Problem wurde behoben, dass nach einem Controller-Disconnect manchmal keinerlei Eingabe mehr möglich war",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
