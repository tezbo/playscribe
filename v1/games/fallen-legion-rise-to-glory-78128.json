  {
   "id": "fallen-legion-rise-to-glory-78128@major-2020-06-13",
   "gameId": "fallen-legion-rise-to-glory-78128",
   "displayName": "Fallen Legion: Rise to Glory arrives on Steam as a free update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-06-13T13:20:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Bringing Fallen Legion: Rise to Glory to Steam was a bigger challenge than we anticipated. Rise to Glory uses a different codebase than Fallen Legion+ and integrating the extra content led to bugs. We were determined to do it and the sole programmer that built Fallen Legion: Rise to Glory for Nintendo Switch rebuilt the game for PC.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you have Fallen Legion+, you also have Fallen Legion: Rise to Glory! If you want to play the original release, Fallen Legion+, please go to the directory where the game is installed and run fallenlegion.exe. The update adds fallenlegion-rtg.exe which plays Fallen Legion: Rise to Glory. Unfortunately, save data is incompatible between the two versions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fallen Legion: Rise to Glory has",
     "items": [
      {
       "text": "Five bonus playable characters including the elusive Succubus pictured here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Face the Alarune, Prince Thuradal and Ignis in new boss battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More levels and story branches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A Japanese voiceover option starring Shizuka Ishikami as Cecille, Hidenori Takahashi as the Legate, Kengo Kawanishi as the Grimoire, Ai Kakuma as Antoinette and Shinya Fukumatsu as Maurice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "English, Japanese, Korean, Simplified Chinese, and Traditional Chinese language options.: We hope you enjoy finding Fallen Legion: Rise to Glory’s secret characters and new story routes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
