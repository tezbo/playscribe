   "id": "ghetto-zombies-graffiti-squad-255711@5.2.6",
   "gameId": "ghetto-zombies-graffiti-squad-255711",
   "displayName": "Update 5.2.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-27T19:02:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're back with a big announcement: *Ghetto Zombies: Graffiti Squad* is now available on all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45069274/ec7dedb010d1833fa8edc44dcbb6b3b694ecc760.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would also like to announce that a new update is available:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustment to game startup that could cause freezing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustments to Gamepad aiming where the reticle was always stuck in \"Auto\" mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustment to character sprites that, in some cases, could exhibit \"pixelation.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added camera smoothing when aiming.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We continue to monitor all community feedback, both for bug fixes and suggestions, and are working to deliver the best for you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks everyone!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
