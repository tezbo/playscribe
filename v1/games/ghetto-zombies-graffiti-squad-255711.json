  {
   "id": "ghetto-zombies-graffiti-squad-255711@1.1.0",
   "gameId": "ghetto-zombies-graffiti-squad-255711",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-12-19T21:27:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just released Patch 1.1.0 for the Ghetto Zombies demo, our very first official update, focused on making the experience smoother, more fun, and scare-free… at least when it comes to bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch includes important fixes, performance improvements, and gameplay adjustments based on testing and player feedback. Now you can explore the demo and enjoy this apocalyptic universe we crafted with so much care.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are more details about the main improvements and fixes included in this patch",
     "items": [
      {
       "text": "General performance improvements;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed zombies that were becoming inactive in certain areas;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed progression issues involving graffiti, resolving soft lock cases;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Gameplay adjustments for the Boss, weapons, characters, and enemies;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crashes related to save loading and character switching;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjustments to the randomization of special weapons in dumpsters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you’ve already played the demo, it’s definitely worth jumping back in.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you haven’t yet, now is the perfect time to experience Ghetto Zombies the way we originally envisioned it — and don’t forget to tell us what you think, we always love hearing from you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
