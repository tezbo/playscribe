  {
   "id": "ghetto-zombies-graffiti-squad-255711@5.1.2",
   "gameId": "ghetto-zombies-graffiti-squad-255711",
   "displayName": "Update 5.1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-21T16:50:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve received your reports and feedback, and we’re continuing to update the game to make the experience as good as possible! Here are some of the most important fixes and improvements in this update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updates to the achievements system to ensure everything is working correctly;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balance adjustments to the final Boss battle, along with polish on the battle cutscenes;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustments to the soundtrack and SFX;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug and crash fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ll keep working on more fixes, improvements, and gameplay polish, and we’re always paying close attention to what you share with us. Huge thanks to everyone who takes the time to send feedback — we really appreciate it! <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
