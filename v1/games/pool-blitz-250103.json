    {
     "title": "Changes",
     "items": [
      {
       "text": "This is our first post-launch update, and with your support over the past few days, we have focused on improving the PC experience. We’ve made a range of fixes and improvements across controls, UI, localisation, and overall stability — making things smoother whether you're playing on mouse & keyboard or controller.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Stability & Technical Fixes",
     "items": [
      {
       "text": "Fixed issue preventing some players from getting in to game on start-up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved recovery from PC standby/hibernation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed game freeze when Steam overlay is disabled while making purchases (now shows a message instead)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "General stability improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
