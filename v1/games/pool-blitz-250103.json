       "category": "fixed"
      },
      {
       "text": "Resolved cases where controller inputs would break or disappear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing button prompts in store and menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Addressed mouse escaping fullscreen",
