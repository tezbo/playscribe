  {
   "id": "atama-207724@1.06.1",
   "gameId": "atama-207724",
   "displayName": "Update 1.06.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-27T06:53:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Atama 1.06.1 is a bug fix release addressing several minor issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelist",
     "items": [
      {
       "text": "Fix a bug where Kaede's death scream on story and dev commentary mode would sometimes awkwardly play after the full death animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Kaede's crouch animation hovering a little over the ground.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a bug where random sound effects (most notably the crows in Manor) would still play while gazing through enemies not in the area where the sound effect originates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a small issue where the player could clip/see into into the giant stone head",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a small story/dev comm bug where remote viewing ambient sounds would continue if you died while viewing the last remaining enemy in an area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix minor visual issues in Servants' Quarters along with an issue that would sometimes make you return from crouching to standing in certain places in Servants' Quarters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix an issue where for some monitors, the proper resolution options would not be listed on settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
