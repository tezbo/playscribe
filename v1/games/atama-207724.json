  {
   "id": "atama-207724@1.7.2",
   "gameId": "atama-207724",
   "displayName": "Update 1.7.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-25T02:47:38.000Z",
   "notes": [
    {
     "title": "This is just a minor update with a few small fixes",
     "items": [
      {
       "text": "Fix a bug where crouching in the mines when leaving a light sources could in certain circumstances erroneously mark you as still \"in the light\" for enemies to be able to detect you",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a bug where some settings buttons were louder due to doubling up on the selection sound",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix an issue on title screen settings where you could see the settings change from default to your saved settings upon opening settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Add a dynamic extra tip to help onboard players to the fact that they can look through multiple views.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
