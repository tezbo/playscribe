  {
   "id": "atama-207724@1.7.1",
   "gameId": "atama-207724",
   "displayName": "Patch 1.7.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-27T01:22:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.7.1 brings with it major improvements to Atama's performance especially in the first area of the game as well as an overall reduction in file size for the game. If you experienced frame drops in the first area of the game please consider trying the game again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Minor fixes",
     "items": [
      {
       "text": "-Fix a keyboard/controller menu navigation bug with the controls rebind page.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Fix a possible audio bug in the intro.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fix a bug where player movement audio could continue while on the ladder if you held down a movement button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fix a bug where you could trigger the shrine door opening multiple times by spam clicking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
