  {
   "id": "atama-207724@1.06.0",
   "gameId": "atama-207724",
   "displayName": "Update 1.06.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-31T00:27:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.06.0 introduces a few additional settings including the ability to reduce flashing from the remote viewing \"eyeball\" animation for those who found this bothersome, the ability to reduce the draw distance which should help performance issues on some computers in outside areas of the game, and several small fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelist",
     "items": [
      {
       "text": "Added a setting to change the view distance. Set it to a lower quality to improve performance on low-spec machines, this should be especially effective for people who had performance issues on the outdoor segments of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a setting to reduce flashing graphical effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a setting to inverse vertical mouse input",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Enemies can now be distracted in any state as long as they aren't already distracted or actively chasing (so, if they are returning, readjusting, or searching last known area they can be distracted)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Minor Fixes/Changes",
     "items": [
      {
       "text": "Turn down volume on some additional sound effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Better placement on the number key gazing tip trigger",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a situation in Tower where a head could get caught in an aggro-loop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a bug where an enemy would clip through a building if you kited it back from Manor Exterior to Residential",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix ability to go out of bounds in rooftop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix possible storymode softlock in Residential",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Small improvements to first scene for performance, add obstacles blocking the inaccessible stairs in Residential",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Make it so if you attempt to open Tower door with Servants' Quarters Key it specifies that your key doesn't fit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Make it so Metal Buuku in Servants' Quarters won't clip through the doors with the back side of his head.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Update Missing Statue Head image in inventory screen to be accurate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other extremely minor tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
