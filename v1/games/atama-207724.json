  {
   "id": "atama-207724@1.06.2",
   "gameId": "atama-207724",
   "displayName": "Update 1.06.2",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-02-17T02:20:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Atama v. 1.06.2 is now available!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Major changes",
     "items": [
      {
       "text": "Controls can now be remapped in the settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Developer commentary now has optional subtitles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When poor performance is detected, a tip pointing to the draw distance setting is displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other fixes",
     "items": [
      {
       "text": "The 'inn' in Residential District was playing default footstep noises instead of wood/tatami mat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some small issues with flickering textures and holes in environment in Servants' Quarters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Make the large gate by the padlock key inspectable to give hint to players that they need to use the key elsewhere.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The item descriptions for coins 2 and 4 were backwards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Very minor audio bug in dev commentary mode when in the final cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various other minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
