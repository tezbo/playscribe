  {
   "id": "atama-207724@1.06.4",
   "gameId": "atama-207724",
   "displayName": "Patch 1.06.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-05-26T14:15:56.000Z",
   "notes": [
    {
     "title": "Bigger changes",
     "items": [
      {
       "text": "Improve 3D Audio in the game to fix some audio issues and make it more clear where sounds are coming from.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A few more changes to make the first area of the game more clear (another hint about where to use key, make the second gate a little more obvious by adding a gap between the doors, and add an extra checkpoint in case the player died after thinking they needed to re-traverse the factory district).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Small fixes",
     "items": [
      {
       "text": "Fix a bug where you could re-trigger the earlier checkpoint in Old Town after dying and re-loading at the shrine checkpoint.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improve some enemy collision in Factory District and Shanty Courtyard.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Add an extra folding screen in a house in Residential District to make it so one patrolling enemy can't see you if you are hiding behind it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a situation where the Overseer would occasionally repeat the same taunt in one scenario.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a bug where RNG audio triggers (like bell 'dings') weren't playing while remote viewing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
