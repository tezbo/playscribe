  {
   "id": "atama-207724@post-2022-11-01",
   "gameId": "atama-207724",
   "displayName": "Soundtrack now available!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-01T01:21:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Atama Soundtrack by Jonny McBane is now available to purchase on Steam! In addition to all the music featured in the game, the soundtrack also contains 11 bonus tracks featuring prototype versions of many of the game's tracks.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We've also set up a bundle for the game and its soundtrack for a small discount.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
