  {
   "id": "atama-207724@1.7.0",
   "gameId": "atama-207724",
   "displayName": "Patch 1.7.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-11T17:05:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Japanese localization is out now! (Dev Commentary mode is still only English, but everything else is fully translated.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix an issue where the audio of the Journal Archive would erroneously double, triple, quadruple, etc. up for each time that you viewed it and reloaded an area either by dying or any other way.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix an issue where an enemy could see through a window in Residential District and fly up into the wall and get stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix an issue where the \"It's too risky to touch the bell again\" message would erroneously appear when the enemy was chasing you instead of just when it is already distracted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix an issue where you could click the ladder before Residential multiple times and trigger the climb event multiple times in a row which could cause the game to lockup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
