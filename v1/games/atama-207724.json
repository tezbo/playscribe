  {
   "id": "atama-207724@1.06.3",
   "gameId": "atama-207724",
   "displayName": "Patch 1.06.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-04-13T21:56:15.000Z",
   "notes": [
    {
     "title": "Bigger changes",
     "items": [
      {
       "text": "Refactored save system to allow for Cloud Saving support which is now live! Your save file should seamlessly update to the new save system, but if you experience any save-related issues please let us know and we will try our best to resolve your situation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increase hitbox of colliders for most items and journal entries so that they are easier to select.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Small fixes",
     "items": [
      {
       "text": "Fix a bug where hitting 'J' after dying would still bring up journal and could cause various issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Slightly increase the threshold for triggering the \"low FPS\" warning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Make it so you can't interrupt/repeat the sound of the large gate in Factory District while it is still playing its sound",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix an issue where the first enemy in the game could consistently do odd pathing if detected in a certain location",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Move the spawn point in mine back so that the first enemy can't see you when you respawn (It was previously in this area but a small change unintentionally affected it)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
