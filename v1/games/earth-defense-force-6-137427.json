   "gameId": "earth-defense-force-6-137427",
   "displayName": "[Important]Update Information",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-03T07:39:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This application has been modified so that you can play online missions without signing in to your Epic Games account.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Signing in to your Epic Games account is no longer required. If you wish to unlink your Steam account from your Epic Games account, please visit Epic Games website in a web browser.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "For details on how to unlink accounts, please visit the website below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
