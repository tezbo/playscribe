  {
   "id": "earth-defense-force-6-137427@major-2025-01-22",
   "gameId": "earth-defense-force-6-137427",
   "displayName": "[Important]Update Information",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-22T05:49:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "・Fixed an issue with the Ranger vehicle “Free Bike,” where contact damage would occur with objects when not in the vehicle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Reduced load times by increasing read speeds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue with the Air Raider vehicle “Combat Wagon,” included in the Additional Mission Pack 2. The “Giga Launcher” can now be fired when using keyboard and mouse controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Fixed an issue that occurred on some GPUs that caused the game to stop during play on PCs with AMD GPUs (Radeon series).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Fixed some enemy sound balancing issues. Additionally, the “SE Volume” setting in the “Game Settings” menu will now correctly be reflected in game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
