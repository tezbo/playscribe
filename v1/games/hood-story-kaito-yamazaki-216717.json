  {
   "id": "hood-story-kaito-yamazaki-216717@1.01",
   "gameId": "hood-story-kaito-yamazaki-216717",
   "displayName": "Update 1.01",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-04T16:10:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Enhanced performance: This update improves the overall smoothness and responsiveness of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced texture footprint: We've optimized textures to decrease file size without compromising visual quality. This can lead to faster loading times and potentially smoother gameplay, especially on lower-end devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Manual save fix: An issue preventing players from saving their progress manually in the pause menu has been addressed. You can now reliably save your game whenever needed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
