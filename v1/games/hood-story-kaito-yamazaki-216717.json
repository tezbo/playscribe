   "gameId": "hood-story-kaito-yamazaki-216717",
   "displayName": "Price Drop & Japanese Language Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-27T01:33:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks to your feedback, I've decided to drop the base price of HS:KY by over 35%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I'm also excited to announce that Japanese localization will be available in the next update. I'm always listening to your suggestions, and I'll consider adding more languages in the future based on demand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
