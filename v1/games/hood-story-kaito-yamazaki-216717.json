   "announcedAt": "2025-07-14T03:45:33.000Z",
   "notes": [
    {
     "title": "The recent engine update introduced several new bugs. They should all be fixed now, but if you notice any remaining issues, feel free to contact me, and I’ll address them as soon as possible.",
     "items": [
      {
       "text": "Reduced game size from ~10GB to ~6GB",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing collider on the toy prize in the claw mini-game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing lighting in some cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated DLSS and FSR to their latest versions",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "##",
       "ps5ProOnly": false,
