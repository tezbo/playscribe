  {
   "id": "dreamcore-253474@3",
   "gameId": "dreamcore-253474",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-21T14:45:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[ General ]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new feature: Focus Pointer, which allows players to place a custom point on the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option to disable chromatic aberration (only available when VHS mode is OFF.: [ Languages ]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added support for the following languages: Hungarian, Korean, Ukrainian, Catalan, and Polish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved translations and corrected various issues in Spanish and Russia.: [ Eternal Suburbia] – Major Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Expanded the bunker and laboratory areas with new rooms and branching paths.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reworked suburb transitions: elevators are now located only at the end, and players must now find red doors that lead to a red hallway to travel between suburbs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a bug where the player’s speed would become abnormally high after exiting the first suburb.: [ Dreampools ]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where systems without dedicated GPUs were unable to render lighting properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
