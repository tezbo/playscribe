  {
   "id": "dreamcore-253474@2",
   "gameId": "dreamcore-253474",
   "displayName": "Patch 2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-13T18:52:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Dreamers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just released the second patch for Dreamcore, bringing a bunch of fixes and improvements to enhance your experience. Here’s what’s new:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Fixed camera zoom sounds not being affected by volume settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Fixed multiple issues with holes in the ground/walls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Fixed music in the main menu pausing after changing VHS settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Keybindings are now properly saved",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "✅ Fixed missing collisions in Eternal Suburbia",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Fixed camera jumping positions when the game hitched",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Water now correctly stops you from running",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Improved performance in both intro sequences",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is just the beginning—more fixes, tweaks, and new content are on the way. Thanks for playing, and keep an eye out for future updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let us know if you run into any issues, and as always, keep dreaming. ✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
