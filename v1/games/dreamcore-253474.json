  {
   "id": "dreamcore-253474@major-2023-12-28",
   "gameId": "dreamcore-253474",
   "displayName": "Final demo update and New STUDIO",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-28T22:45:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "About Us",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After Dreamcore's success over the past several months, we have established a dedicated studio (Montraluz) to focus the ongoing development of the game. Additionally, we have undertaken a logo rebranding in conjunction with the demo's final update. The upcoming map development is already underway and is targeted for release in the first quarter of 2024.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The final demo update includes",
     "items": [
      {
       "text": "The logo rebranding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A brand new studio intro",
