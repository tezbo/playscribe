  {
   "id": "dreamcore-253474@1",
   "gameId": "dreamcore-253474",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-01-31T18:07:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, friends of liminal spaces!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our first patch is live! Below is the list of fixes and improvements. We're hard at work on even more updates, and we truly appreciate all the feedback—so keep it coming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We aim to roll out patches every week or so, prioritizing the most pressing issues. If you reported a bug and don’t see it fixed yet, rest assured that we're working on it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you all for playing and for the incredible support this community has shown us. We couldn't be more thrilled! Stay tuned for more news soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔧 Patch Notes",
     "items": [
      {
       "text": "Fixed: Default zoom level being out of focus when VHS mode was off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved: Smoother transition when toggling VHS mode on/off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed: at the start of the level in Dreampools.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted: detection radius in Dreampools.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Tweaked: Game balance in Dreampools.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Softlock in Eternal Suburbia where players could fall off the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Invisible exterior walls on a house in Eternal Suburbia.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Let us know if you run into any more issues, and thanks again for being part of this journey! 🚀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
