     "items": [
      {
       "text": "Ever wondered what the DEEP, RICH LORE behind GUNGUNGUN’s extremely sophisticated plot is? In Version 1.1, you can find out it’s entirety with our Prologue Mode Update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Experience Gal’s backstory— the reasons as to why bandits want to murder her dead while you complete tutorial objectives!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "1.1 Release Notes",
     "items": [
      {
       "text": "Added PLAYABLE PROLOGUE MODE",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added 2 new achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Settings menu optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
