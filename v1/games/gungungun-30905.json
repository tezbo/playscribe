  {
   "id": "gungungun-30905@1.3",
   "gameId": "gungungun-30905",
   "displayName": "UPDATE 1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-02-01T17:22:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Heya guys, long time no talk. Got some big news for everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "1.3 Release Notes",
     "items": [
      {
       "text": "Engine updated to GMStudio 2 (save files and progress should be unaffected)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some hats have been replaced with newer, shinier hats!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hats are now more reasonably priced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Misc. game logic and rare crash causes fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Also....",
     "items": [
      {
       "text": "The Gun Gals were featured in a crossover comic with Tom n Artie! Check our feature and read the full series on Tapas here: https://tapas.io/episode/1322038?fbclid=IwAR1dyBawFI_kYmHx0hAzlkFcazPCMu5NRlWQDF7hFDKiQkpV81UrVXuBMDo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Pick up a copy for portable or big screen play!",
     "items": [
      {
       "text": "SWITCH",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PLAYSTATION 4 and PLAYSTATION 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    },
    {
     "title": "Mystery Egg Games is now working on a new title: HERO.EXE!",
     "items": [
      {
       "text": "Follow our progress on our socials and Steam page!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
