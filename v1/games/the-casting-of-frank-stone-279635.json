  {
   "id": "the-casting-of-frank-stone-279635@hotfix-2024-09-04",
   "gameId": "the-casting-of-frank-stone-279635",
   "displayName": "Hotfix Update – Sep. 4, 2024",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-09-04T17:48:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "UPDATE Sep. 5: The hotfix is now live on Xbox and Windows Store.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "This hotfix is now live on Steam, EGS, and Playstation. It will be deployed later on Xbox, and Windows Store due to the certification process; we will keep you informed once it is live.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "We are investigating the reports of performance and optimization issues on PC, and will share more information in the future.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Dead by Daylight Rewards",
     "items": [
      {
       "text": "You can claim your Dead by Daylight rewards through your Behaviour account, following these instructions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are aware that players are experiencing issues receiving some or all of the Dead by Daylight rewards. We are currently investigating this issue and are working to get it fixed ASAP. If you are missing any rewards, please submit a Support ticket to ensure we get you what is missing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Game Crashes",
     "items": [
      {
       "text": "Fixed an issue that could cause the game to crash when continuing from the beginning of Punch save point",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could cause the game to crash after opening the drawer in the reliquary that contained the camera",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could cause the game to crash in the Prologue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Misc.",
     "items": [
      {
       "text": "Removed the 4-hour limitation when using Twitch Integration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the intro video on PS5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixed the issue where Xbox created large save files",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Removed the Player Marker on Xbox",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    }
   ],
