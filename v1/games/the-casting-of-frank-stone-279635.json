   "id": "the-casting-of-frank-stone-279635@major-2024-09-16",
   "gameId": "the-casting-of-frank-stone-279635",
   "displayName": "Bugfix Update - Sep. 16, 2024",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-16T16:14:09.000Z",
   "notes": [
    {
     "title": "Crashes and Blockers",
     "items": [
      {
       "text": "Fixed a crash in The Phantom of Cedar Steel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the user could not return to the main path after reloading a save during The Phantom of Cedar Steel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Compatibility and Compliance",
     "items": [
      {
       "text": "The SteamVR plugin has been disabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where accessibility settings were not applied when changing them on the start screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Achievements",
     "items": [
      {
       "text": "Fixed Cutting Room Floor related issues where the All-Seeing achievement unlocks incorrectly in some instances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where achievements related to collectibles became frozen at 50% completion in some instances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players were not gaining the Plangonologist achievement after collecting all Relliks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Entity Displeased trophy was incorrectly unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Relationships",
     "items": [
      {
       "text": "Fixed an issue tied to the Relationship screen when playing through the Cutting Room Floor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Sam’s relationship bar is not affected following certain interactions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Audio",
     "items": [
      {
       "text": "Fixed an issue with an abrupt stop in music during The Massacre at Gerant Manor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an Audio issue in The Massacre at Gerant Manor where a heartbeat SFX persists not as designed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where jump-scare audio is played at an incorrect moment in A Curiosity on Main Street.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the choice loop music was inaudible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the credits music continued throughout The Massacre at Gerant Manor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with SFX for the Trapper doll.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with incorrectly triggered dialogue during Closing the Noose.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with distant audio being incorrectly played in A Curiosity on Main Street.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with missing SFX in Murder Mill and The Massacre at Gerant Manor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with missing dialogue in Murder Mill and The Massacre at Gerant Manor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with missing music during In the House of Darkness and A Curiosity on Main Street.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Graphics and Performance",
     "items": [
      {
       "text": "Film Grain settings are now always applied to fix an issue with possible graphical corruption.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the DLSS Anti-Aliasing was sometimes missing.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue with lighting exposure within the relationship screen in The Massacre at Gerant Manor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced hitching with shaders in various scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased the target framerate to 60fps default if the dynamic resolution is turned to on. Dynamic resolution is now off by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "UX/UI",
     "items": [
      {
       "text": "Fixed an issue with keyboard incorrect inversions when selecting dialogue options.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue with chapter names in the Cutting Room Floor whilst using a mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Object and Environments",
     "items": [
      {
       "text": "Fixed an issue with asset flickering during The Phantom of Cedar Steel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with texture popping during Beyond the Gate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a collision issue causing players to fail collecting a Trinket in The Phantom of Cedar Steel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed collision issues in various chapters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with missing or incorrect doors in These Walls Have Eyes, Murder Mill and In the House of Madness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with floating objects in A Perilous Place, Mystery Manor and The Massacre at Gerant Manor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Characters",
     "items": [
      {
       "text": "Fixed an issue where an incorrect character appears for brief appearances in The Massacre at Gerant Manor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with incorrect character behavior in A Curiosity on Main Street.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with floating hair on Madi during The Massacre at Gerant Manor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with a character disappearing during Beyond the Gate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with Jaime incorrectly wearing a backpack in The Phantom of Cedar Steel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with an incorrect animation looping in Murder Mill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with Jaime when using the Cutting Room Floor to restart Murder Mill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with missing or freezing animations during Murder Mill, Hunting Ground and Beyond the Gate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with character textures in The Massacre at Gerant Manor, Murder Mill and All Paths Must Cross.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Misc",
     "items": [
      {
       "text": "Fixed an issue with a missing camera filter in some endings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue experienced with pausing during Twitch polls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
