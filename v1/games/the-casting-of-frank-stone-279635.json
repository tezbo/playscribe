  {
   "id": "the-casting-of-frank-stone-279635@hotfix-2024-09-10",
   "gameId": "the-casting-of-frank-stone-279635",
   "displayName": "Hotfix Update - Sep. 10, 2024",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-09-10T15:51:40.000Z",
   "notes": [
    {
     "title": "An update on Standard & Deluxe Edition rewards",
     "items": [
      {
       "text": "We are working around the clock on getting rewards out to everyone - it is top priority to ensure that all impacted players get their rewards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will be rolling out fixes for these issues this week, and all affected players will receive 2 million Bloodpoints as compensation alongside your rewards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Performance Issues",
     "items": [
      {
       "text": "Enabled Frame Generation option for NVidia 40xx series card",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A future update is planned to address ongoing performance issues. If you have experienced performance issues, please submit a Support ticket with the following information:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DxDiag logs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphics card settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Framerate issue (video or FPS number)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
