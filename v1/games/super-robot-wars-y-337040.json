  {
   "id": "super-robot-wars-y-337040@1.1.0",
   "gameId": "super-robot-wars-y-337040",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-18T03:39:19.000Z",
   "notes": [
    {
     "title": "Thank you for playing SUPER ROBOT WARS Y!",
     "items": [
      {
       "text": "We’ve released a new update for Steam® versions of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-Challenge Mission​",
     "items": [
      {
       "text": "A new special mission has been added to Chapter 6!​",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Choose your best 5 units and take on the challenge!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "​-EX Level Pilot Skills​",
     "items": [
      {
       "text": "EX has been newly added to Pilot Skills!​",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collect Skill Programs to craft the greatest pilot.​",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-DLC 1 Area Mission​",
     "items": [
      {
       "text": "DLC 1: Area Mission Episode 1 “A Smile on the Street Corner” is available as a free update!​",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Unlock requirement: Complete Chapter 2 “A Mission for Brave Heroes” to access this mission.​",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-The other adjustments",
     "items": [
      {
       "text": "A fix for a security vulnerability found in games built with Unity as reported by Unity Technologies on October 3rd, 2025 (Fri).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Please see the official announcement from Unity Technologies for further details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
