  {
   "id": "super-robot-wars-y-337040@1.2.0",
   "gameId": "super-robot-wars-y-337040",
   "displayName": "Patch 1.2.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-02-04T08:31:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve released a new update for Steam® versions of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-Additional STG Memory​",
     "items": [
      {
       "text": "By clearing Chpater 4, a new STG memory will be unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "​-Special Mission: Battle Rush 2",
     "items": [
      {
       "text": "Following on from the special mission Battle Rush added in version 1.1.0, Battle Rush 2 is added as part of this latest update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Battle Rush rules remain the same, but the mission has been powered up to include a total of 20 waves!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You will be required to manage your resources skillfully and make full use of your damage output and mobility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Prerequisites: Either reach the Ending, or play “Special Mission: Battle Rush\" at least once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-Stats Caps Unlock",
     "items": [
      {
       "text": "The upper limit of powered up pilot stats is increased by 50, while Pilot Level max is increased from Lv 99 to Lv 150. Now, you can also upgrade a mech's stats or weapons by 5 more levels. Take your favorite mechs to new heights!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collect Skill Programs and develop the ultimate pilot!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-DLC 2 Area Mission #1 Omen",
     "items": [
      {
       "text": "The free update will also include DLC 2 Area Mission #1 Omen. This Area Mission is playable even by players who have not purchased DLC 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Available to play by applying update Ver. 1.2.0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Players must fulfill the below condition in order to play the new mission Omen, included as part of the free update: Clear the first episode of CHAPTER 2, A Mission for Brave Heroes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
