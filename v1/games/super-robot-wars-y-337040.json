  {
   "id": "super-robot-wars-y-337040@1.3.0",
   "gameId": "super-robot-wars-y-337040",
   "displayName": "Patch 1.3.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-21T04:14:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A brand-new update is now available for the Steam® version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■“Revol. War” – All 3 Episodes (Free)",
     "items": [
      {
       "text": "All three episodes of “Revol. War” are now available to play as part of the free update released on Tuesday, April 21.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This scenario serves as a prequel to the main story, offering new insights before the events of the campaign.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※It becomes playable after updating to ver. 1.3.0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※Unlock Condition: Clear CHAPTER 6 “On to a Never-Ending Battle”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■“NOAH Brand’s Battles” – All 3 Episodes (Free)",
     "items": [
      {
       "text": "All three episodes of “NOAH Brand’s Battles” are also included in this free update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This storyline takes place just before Chapter 7, adding more depth to the unfolding narrative.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※It becomes playable after updating to ver. 1.3.0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※Unlock Condition: Clear CHAPTER 6 “On to a Never-Ending Battle”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Expansion Pack Episode 1: “Contact” (Free Playable Preview)",
     "items": [
      {
       "text": "The first chapter of the Expansion Pack, “Contact,” is available in Ver. 1.3.0 and can be played even if you haven’t purchased the Expansion Pack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※It becomes playable after updating to ver. 1.3.0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※Unlock Condition: Clear CHAPTER 2 “Aliens Adrift”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※Upon completing Expansion Pack Episode 1: “Contact,” the new units and pilots do not join your team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※Upon completing Expansion Pack Episode 1: “Contact,” pilots who appear for the first time in Area Missions are not being added to the “Character Profiles,” and the units are not being added to the “Robot Encyclopedia.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
