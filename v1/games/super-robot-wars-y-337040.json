  {
   "id": "super-robot-wars-y-337040@1.4.0",
   "gameId": "super-robot-wars-y-337040",
   "displayName": "Patch 1.4.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-08-04T04:37:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve released a new update for Steam® versions of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-20 Million Copies Sold Commemorative Mission Free streaming",
     "items": [
      {
       "text": "To commemorate the Super Robot Wars series surpassing 20 million copies sold, we are releasing the mission CONGRATULATION 20000000! for free.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*This content becomes available after updating to version 1.4.0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Unlock requirement: Complete CHAPTER 2, “Aliens Adrift.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "​-35th Anniversary Mission Free streaming",
     "items": [
      {
       "text": "We are releasing the mission CONGRATULATION 35th! for free to commemorate the 35th anniversary of the Super Robot Wars series.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*This content becomes available after updating to version 1.4.0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Unlock requirement: Complete CHAPTER 2, “A Mission for Brave Heroes.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "​-New game mode BOOST added",
     "items": [
      {
       "text": "With the free update to version 1.4.0 on Tuesday, 4 August, we will be adding a new game mode called “BOOST”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In this mode, you’ll earn double the EXP, CREDIT, and MXP, while aircraft modification costs, pilot training costs, and item selling prices are halved—making it easier to level up your characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "*This mode will become available after updating to version 1.4.0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "*The enemy difficulty is the same as in the \"CASUAL\" game mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "-Level Cap Increase",
     "items": [
      {
       "text": "The pilot level cap will be raised from Lv. 150 to Lv. 200.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*The base game is required to use the Anniversary Expansion Pack. If the latest patch is required, please update the game before use.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
