  {
   "id": "makis-adventure-188863@patch-2023-08-14",
   "gameId": "makis-adventure-188863",
   "displayName": "BIG Patch with dozens of improvements",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-14T23:20:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I worked super hard on the new Patch and would love to get your feedback! Tried to watch every stream and video to collect your feedback! Please share some more feedback and impressions in the Discussion forum :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
