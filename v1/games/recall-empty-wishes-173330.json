  {
   "id": "recall-empty-wishes-173330@1.0.4.0",
   "gameId": "recall-empty-wishes-173330",
   "displayName": "Update 1.0.4.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-24T19:42:22.000Z",
   "notes": [
    {
     "title": "Version 1.0.4.0 Update Details",
     "items": [
      {
       "text": "Updated some art assets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased backpack capacity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed some incorrect text and translations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[Phoebe’s Chapter] Fixed an issue where flipping pages in the Book of Leviathan using the controller’s joystick acted abnormally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[Phoebe’s Chapter] Adjusted the playback mechanism for the CG video in the living room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[Tommy’s Chapter] Adjusted the mechanism of the translucent goldfish in The Shore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[Yonny’s Chapter] Picking up the ladder in the 1F corridor will no longer place it in the backpack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[Yonny’s Chapter] Rearranged the dialogue choices before entering the ending.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[Yonny’s Chapter] Fixed an issue where Levi summoned using the 1F corridor telephone would not target the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[Yonny’s Chapter] Fixed an issue where if Yonny was killed by Levi while holding the ladder, she would be unable to enter Tommy’s room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
