  {
   "id": "tokyo-psychodemic-248944@major-2024-06-25",
   "gameId": "tokyo-psychodemic-248944",
   "displayName": "The Second \"Steam version\" Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-25T10:56:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This is the Tokyo Psychodemic Development Team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have updated the \"Steam version\" on Tuesday, June 25, 2024, at 20:00 JST.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Target: \"Steam version\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■ UI/UX Fixes",
     "items": [
      {
       "text": "1) Adjusted to allow selection of video tapes and cassette tapes from the PC folder",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "2) Fixed to allow verification of all evidence in the Dark Pit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "3) Added an icon to indicate the active monitor on the analysis screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "■ Improved Usability for Steam Version",
     "items": [
      {
       "text": "4) Revised keyboard assignments",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "■ Enhanced Save Function",
     "items": [
      {
       "text": "5) Added auto-save feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "6) Added a feature to set auto-save slots arbitrarily",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will notify you again once the update schedule for the PS5 version, PS4 version, and Nintendo Switch version is confirmed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Thank you for your support for \"Tokyo Psychodemic.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
