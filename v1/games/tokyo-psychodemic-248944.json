  {
   "id": "tokyo-psychodemic-248944@major-2024-06-14",
   "gameId": "tokyo-psychodemic-248944",
   "displayName": "TOKYO PSYCHODEMIC Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-14T10:08:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As of June 14th 2024 19:00(JST) TOKYO PSYCHODEMIC has been updated to the latest version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Target: Steam version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Update Contents are as follows",
     "items": [
      {
       "text": "1）Implementation of automated text playback function and ability to change text display speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2）Fast-forward function implemented in text function",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3）Ability to access options mid scenario",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4）Enabled double speed range for video playback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Additional Update Contents",
     "items": [
      {
       "text": "・ Addition of Save/Load feature to the System Menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new announcement will be made at a future date for the above update on PS5, PS4, and Nintendo Switch versions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "We hope you'll continue to support TOKYO PSYCHODEMIC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
