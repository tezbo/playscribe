  {
   "id": "cute-bite-152325@major-2021-10-28",
   "gameId": "cute-bite-152325",
   "displayName": "Halloween Update + Special Achievement!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-10-28T10:02:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Happy Spooktober!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "From now until Nov 1st, hunting in town now has a chance to trigger a special encounter with a Halloween-themed target. Defeating this target will earn you the new Pumpkin Pie achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(This also means the town has more hunting targets available than usual, especially during the late game, so get stalking!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For seasoned players, we've also unlocked Developer Mode, for those who are interested in playing with cheat codes to adjust your stats (especially useful for tracking down extra ending variations you might not have seen yet) Chat with others in the forums to figure out new tricks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
