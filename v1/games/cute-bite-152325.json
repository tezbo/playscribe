  {
   "id": "cute-bite-152325@major-2021-07-18",
   "gameId": "cute-bite-152325",
   "displayName": "Development Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-07-18T14:10:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "At this point, all art planned for the initial release has been completed. There's always the chance of more being added if something strikes our fancy, but the basic roadmap is 100%. There are no barriers to release on this end.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All career endings have been added to the game and are currently in beta-testing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Currently working on writing and adding all the optional character plotlines, romances, and ending variations. Some of these scenes can be quite hard to find. You never know when you might stumble over a secret!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "No specific launch date at the moment but things are still on target for a fall release.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
    "new": 0,
    "fixed": 0,
    "balance": 0,
