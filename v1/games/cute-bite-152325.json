  {
   "id": "cute-bite-152325@major-2021-09-02",
   "gameId": "cute-bite-152325",
   "displayName": "Minor patch update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-02T18:41:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New version is available on the default branch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Achievement added: Jack of All Trades, which is achieved by unlocking ALL the jobs on a single run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fixed: Quick saves and auto saves often had incorrect name data on them. This should now be improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fixed: The Computer and Gardener romances were incorrectly triggering in some circumstances when they were meant to be blocked. This should now be fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please let me know if you encounter any problems!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
