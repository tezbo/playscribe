  {
   "id": "cute-bite-152325@post-2024-10-24",
   "gameId": "cute-bite-152325",
   "displayName": "Halloween updates locked and loaded",
   "kind": "dayOne",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-24T14:58:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello! If you've seen a small patch update go by, this is just a modification to set the internal dates correctly for this year's Halloween event on Steam (which will run from Oct 28th to Nov 4th).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "During that time, the Pumpkinhead character should spawn on Hunting activities, allowing you to claim the Pumpkin Pie achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "But it won't be active until then this year so wait for it! (If you hunt and hunt and can't find a pumpkin *after* the 28th, let us know.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In unrelated news Cute Bite is coming to consoles this Halloween! Got a friend who would enjoy an adorable vampire chomping on things? Look out for Cute Bite on Xbox, Switch, and PS4/5 web stores, it should be available on Oct 25th.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    }
   ],
