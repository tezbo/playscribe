  {
   "id": "cute-bite-152325@1.6",
   "gameId": "cute-bite-152325",
   "displayName": "Patch 1.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-08-26T19:58:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Due to a minor bug, previously the Collector achievement for completing the ending gallery was failing to unlock when you achieved your final ending and would only unlock the next time you finished the game after that. This should now be corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have previously completed the gallery but not received the achievement, you will still need to reach an ending again in order to trigger the check and get the achievement. Any ending will do, even a bad one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please let us know if you have any problems or if the achievement still fails to fire.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
