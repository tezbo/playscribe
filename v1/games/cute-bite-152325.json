  {
   "id": "cute-bite-152325@patch-2021-11-02",
   "gameId": "cute-bite-152325",
   "displayName": "Pumpkin Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-11-02T17:18:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Small update to fix a bug in the code that calculates pumpkin creation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have a save made during the Halloween event, you might still be able to get a pumpkin to show up while hunting, but it's unlikely. For the most part you'll need to wait until next year (or cheat).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
