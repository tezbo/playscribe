   "announcedAt": "2024-10-15T19:54:27.000Z",
   "notes": [
    {
     "title": "Features",
     "items": [
      {
       "text": "Added \"Reduce Bright Effects\" Accessibility option for people who have issues with bright flashes or other photosensitivity issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the text \"Time's Up!\" when losing from reaching 0 seconds during ritual phase.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Balance",
     "items": [
      {
       "text": "Moved one enemy spawner further away from the tunnel on Extreme Campaign",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Changed the Ritual music and Trial win or fail to the correct Music Category, so they should now work with the music volume slider.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the death cinematic sounds to the SFX Category, so they should now work with the SFX volume slider.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
