  {
   "id": "the-devil-is-in-the-details-289626@1.1.0",
   "gameId": "the-devil-is-in-the-details-289626",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-17T17:45:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.1.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Feature: Added the Trial Settings \"Clock Stopped\", making the count down timer disabled unless the player falls onto traps or when they are hit by enemies. This option makes the game more acessible for people who don't want the stress of a timer, and when paired with other settings such as no enemies and no traps, the game essentially becames a vanilla \"Anomaly detection\" type game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Also, this option provides more flexibility for players who are interested in doing the side quests as well, such as solving each one of the trials big riddles or finding mini arbiters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
