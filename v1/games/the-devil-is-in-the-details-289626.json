  {
   "id": "the-devil-is-in-the-details-289626@3.0.0",
   "gameId": "the-devil-is-in-the-details-289626",
   "displayName": "Update 3.0.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-27T16:54:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update 3.0.0.0 — Story Mode & Gameplay Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Story Mode: Play through the Initiate, Adept, Veteran, and Extreme trials as one continuous journey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Automatic Story checkpoints: Progress is saved when entering a new trial, so you can quit and continue later.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated lives mechanic: Pick up Life Potions to allow you to do mistakes during Judgements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted difficulty: Rebalanced the experience to better match the console version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Traps no longer respawn during a playthrough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New cursed-object hints: Added hints for some of the more difficult-to-understand cursed objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reworked Hardcore mode: Take on trials with half the normal lifetime allowance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved Statistics menu: Track trial records and your best Story Mode completion time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More accurate timing: Paused time and time spent outside the game are excluded from completion times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved progression: Smoother transitions between trials and corrected end-of-trial menu behavior.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved menus: Better controller navigation and confirmation before replacing an existing run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Mouse movement fix: Corrected uneven horizontal camera movement.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Engine upgrade: Updated the game’s underlying engine.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note: This update rebuilds much of the game, so the download may be larger than a typical patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
