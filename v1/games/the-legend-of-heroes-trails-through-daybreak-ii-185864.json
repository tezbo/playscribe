  {
   "id": "the-legend-of-heroes-trails-through-daybreak-ii-185864@1.2.19",
   "gameId": "the-legend-of-heroes-trails-through-daybreak-ii-185864",
   "displayName": "Patch 1.2.19",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-11-10T22:19:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we are releasing an update which includes the following changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix motion blur that got broken with the introduction of motion-vector-based AA (e.g. DLAA).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix application of camera jitter for motion-vector-based AA (e.g. DLAA).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a bug that could cause the whole screen to go black when using TAA (especially during battle animations).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix temporal AA/upsampling issues on map geometry in a few specific maps which loop around.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix possible problems in animation bone handling for motion vector computation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix scaling/aspect ratio of the expanded minimap for narrow/wide resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix potential crash after saving the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix possible overwrite of Daybreak 1's system save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Along with some minor improvements/fixes",
     "items": [
      {
       "text": "Fix swapped L/R 4/5 button assignment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improve behavior upon loading of corrupted saves (that were corrupted by e.g. filesystem issues, we do not have any known save corruption bugs).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix Healing Arts button binding description.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix alignment of Close button prompt on item-get screen in quest report UI for narrow resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix placement of legend and key help of expanded map for narrow/wide resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Make Craft List prompt on member change screen in battle clickable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimize p3a archive loading and path lookup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improve Japanese strings in button binding menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Decrease field fade-in time to what is used in Daybreak 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In the unlikely event that this update causes any new issues for you, you can revert to the previous \"version_1.2.15\" branch on Steam",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
