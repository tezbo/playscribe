  {
   "id": "the-legend-of-heroes-trails-through-daybreak-ii-185864@1.1.3",
   "gameId": "the-legend-of-heroes-trails-through-daybreak-ii-185864",
   "displayName": "Update 1.1.3",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-02-15T17:40:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we just released an update for Trails through Daybreak II with the following changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent startup crashes on systems with very unusual number formatting locale settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Implement mouse wheel zoom for the camp/costume menu",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "No longer display the BGM information for \"pinch\" battle music every turn when in the pinch state in a command battle and \"Always\" is selected as the BGM information mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix light probes on one specific map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Add a space between item descriptions and counts in the in-game achievements rewards display",
       "ps5ProOnly": false,
