  {
   "id": "the-legend-of-heroes-trails-through-daybreak-ii-185864@1.2.15",
   "gameId": "the-legend-of-heroes-trails-through-daybreak-ii-185864",
   "displayName": "Update 1.2.15",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-29T20:57:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "today we are releasing a minor update for Trails through Daybreak II.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This patch includes the following changes",
     "items": [
      {
       "text": "Integrate a variety of localization improvements and fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slightly improve GPU-bound performance on Intel GPUs when using XeSS",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix wrong button prompts being displayed in the fishing bait item description",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix minimap icons disappearing in some circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Apply the light distance setting to spot lights as well (it erroneously applied only to all other, more common, light types before)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Make the \"Ultra\" SSR setting behave as intended in all circumstances (previously, it would not actually apply the intended quality after a game restart)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, if you want to revert to the previous version for any reason, you can do so using the Steam \"Beta\" feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman, CTO, PH3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
