  {
   "id": "the-legend-of-heroes-trails-through-daybreak-ii-185864@1.1.8",
   "gameId": "the-legend-of-heroes-trails-through-daybreak-ii-185864",
   "displayName": "Update 1.1.8",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-02T15:33:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we just released an update for Trails through Daybreak II with the following changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimize loading time performance by reducing file metadata lookups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix basketball minigame ball motion FPS dependence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix some specific scripted animations being locked to 30 FPS (sitar player, falling armor).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improve performance in the Marduk Support Shop in the Märchen Garten.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Force black bars during movie playback at aspect ratios where this is required when idle on the title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent direct shortcut menu actions from triggering while in turn battles or during the drone minigames.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix button prompts when applying Droplets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Offer the choice to have Steam verify the game's integrity when a crash occurs while running with Steam enabled. We've noticed that several reported crashes are caused by corrupted game content, this should make verifying that easier for everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
