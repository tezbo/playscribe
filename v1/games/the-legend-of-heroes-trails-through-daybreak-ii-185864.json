  {
   "id": "the-legend-of-heroes-trails-through-daybreak-ii-185864@1.1.7",
   "gameId": "the-legend-of-heroes-trails-through-daybreak-ii-185864",
   "displayName": "Update 1.1.7",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-02-20T18:04:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we just released another update for Trails through Daybreak II with the following changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ": Add Steam Timeline markers when a new BGM track is played, if BGM information is enabled. This e.g. allows you to quickly check the name of a music track that started playing recently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix a rare potential soft-lock in battle when an enemy interrupts themselves during casting an art with an S-Break.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix mouse scrolling in shop menus with more than 8 party members.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix mouse menu navigation in exchange menus for all kinds of Sepith.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix alignment of Camp/Tactics menu for wide aspect ratios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix dynamic button prompt for scrolling displayed in shop menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix handling of cinematic bars when entering the Märchen Garten.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Correctly update Sepith/EP when opening orbment slots with mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Check for direct field shortcuts only when the shortcut menu is closed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
