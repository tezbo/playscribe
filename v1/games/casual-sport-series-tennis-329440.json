 "releases": [
  {
   "id": "casual-sport-series-tennis-329440@1.2",
   "gameId": "casual-sport-series-tennis-329440",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-28T09:07:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First of all, thanks for the huuuge feedback—reaching out to us, making YouTube videos, and discussing the game in Reddit posts. We heard you, and we want to improve our game so it will be even better for you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We added new map called \"Blossom Lane Court\" stylized as rural Japanese city",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We added new map \"Beachside Court\" stylized as Italian coast city",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We fixed major bug that caused the game to crash when playing a tie-breaker in the fifth game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We fixed major animation bug that occurred when character did very specific movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also fixed a few minor bugs that were so rare you probably didn’t even notice them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for staying with us, and hope that you enjoy our game and we'll be getting more feedback from you guys!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
