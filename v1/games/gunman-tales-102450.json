  {
   "id": "gunman-tales-102450@major-2018-08-02",
   "gameId": "gunman-tales-102450",
   "displayName": "Update Patch Notes - August 2, 2018",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-08-02T18:37:20.000Z",
   "notes": [
    {
     "title": "The following updates have been implemented",
     "items": [
      {
       "text": "Added better and smoother movement for crosshair.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "(Especially with Thumbstick on the controller.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lowered the game difficulty for some of the enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Indian boat can fire only 2 shots. Enemy from the lake can throw only one knife.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the chicken collision with Dynamite and Bomb explosion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The poor Chickens... :(",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy gaming! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
