  {
   "id": "gunman-tales-102450@major-2018-08-01",
   "gameId": "gunman-tales-102450",
   "displayName": "Update Patch Notes - August 1, 2018",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-08-01T14:49:18.000Z",
   "notes": [
    {
     "title": "Added Special Abilities for Each of the Characters",
     "items": [
      {
       "text": "Press the \"V\" or \"E\" on the Keyboard or \"B\" on the Controller.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Remember that the each ability need to be fully charged before use.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The time for fully recharge is 10 sec.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Red Gunman have \"Bombs\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Green Gunman \"Burst Shot\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Blue Gunman can \"Freeze Time\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "and Yellow Gunman have nice \"Boomerang\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added 1UP Power-Up like in the Super Mario (Green Mushroom)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Finally, you can raise number of your lives. Of course it's rare Power-Up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Toxic Mushroom \"Power-Up\" ...Power-Up??!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Don't eat this Mushroom... really.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Hammer Power-Up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Now, you can fortify yourself by building a barricades!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed / Reduced the difficulty in the \"Stagecoach\" quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated in-game and PDF manual.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "I'm really recomended to read this manual before your first game. :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some graphical glitches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enjoy the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
