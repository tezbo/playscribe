  {
   "id": "gunman-tales-102450@major-2018-08-13",
   "gameId": "gunman-tales-102450",
   "displayName": "Update Patch Notes - August 13, 2018",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-08-13T15:33:32.000Z",
   "notes": [
    {
     "title": "The following updates have been implemented",
     "items": [
      {
       "text": "Added Difficulty Options to the Settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Now you can choose from the Three Difficulties: Thumbsucker, Normal and Clint Westwood.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ThumbSucker = Less HP and Slower Bullets for the Enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clint Westwood = More HP and Faster Bullets for the Enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added / Fixed better movement on the map with the Thumbsticks on your Xbox360 controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed collision for Player with the Cow Skull on the Stampede mini-game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you hit the skull, your HP will be lowered. (you'll not lose a whole life like before)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Two New Achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "ThumbSucker - Finish the game on the \"ThumbSucker\" difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Guardian of the Lost Treasure - Finish the game on the \"Clint Westwood\" difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed \"collision bug\" with the Train.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enjoy the game! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
