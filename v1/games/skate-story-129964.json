     "items": [
      {
       "text": "The Devil’s Patch - Softlocks, Photomode, and New Game+",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello all, we’ve got a nice new patch here straight from the Desk of the Devil. It came with a changelog, which I’ve quickly doused in water so it’s readable, and then formatted for you below.",
       "ps5ProOnly": false,
       "pcOnly": false,
