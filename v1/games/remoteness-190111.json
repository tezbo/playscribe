   "id": "remoteness-190111@1.90",
   "gameId": "remoteness-190111",
   "displayName": "Update 1.90",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-27T14:41:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello folks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As we continue to work on Remoteness and listen to you, we wanted to express a genuine thank you to everyone supporting us and we hope you will enjoy our new game update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Build v 1.90 has just been pushed, which includes many changes such as:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unity engine version update (HDRP 12+)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "totally revised and improved AI (enemies are now smarter, able to use cover points, throw grenades, find close shelter points if damaged, and communicate better)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "new physically based camera depth of field",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "revised and fixed ladders climbing system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "diagonal ramping added (such as short stairs)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "support for dynamic resolution (enable from main menu -> graphics settings)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added support for TXAA",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "revised game difficulty internal system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "overall performance improvement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "overall graphics improvement: + minor fixes: KR Games team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
