  {
   "id": "karma-city-police-132198@major-2020-06-01",
   "gameId": "karma-city-police-132198",
   "displayName": "First major update.",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-06-01T07:20:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First of all I would like to thank you all for the messages and feedback. They were very important to improve many aspects of the game. I would like to announce now our first major update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This new version gives you about 30 minutes of play time. More rooms, characters, calls, soundtracks...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A more polished experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Joystick Support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any suggestions, or find any bugs, please leave a message at the forum or send me a direct message!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
