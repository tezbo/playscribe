  {
   "id": "karma-city-police-132198@1.05",
   "gameId": "karma-city-police-132198",
   "displayName": "Update 1.05",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-02-15T21:23:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our new update 1.05 is here. Check below the list of improvements we did since launch:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New save slot system implemented.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A 6th shift (3 more calls) was added in the second half of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player movement improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An option to skip battle was added after you fail the last battle two times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor bugs and adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
