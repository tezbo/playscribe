  {
   "id": "karma-city-police-132198@major-2021-03-28",
   "gameId": "karma-city-police-132198",
   "displayName": "New Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-03-28T22:32:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi! It's time for a new update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This one gives you around 2x more gameplay than the previous version. More calls, battles, soundtracks, achievements, and another big chunk of the story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I also added requested features like shake function for combat, ultra-widescreen auto scale, more hints for missions, solved bugs, and more. The game is a lot more polished now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I uploaded a new trailer too!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any suggestions or find any bugs/errors, please leave a message at the forum or send me a direct message!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PS: As the whole combat went through some sort of overhaul, your old save will not be compatible with this new version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To stay up to date with our latest news, visit karmacitypolice.com or http://www.twitter.com/mecagamesdev",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
