   "gameId": "spongebob-squarepants-titans-of-the-tide-358751",
   "displayName": "SpongeBob SquarePants: Titans of the Tide is now Steam Deck Verified!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-27T11:04:00.000Z",
   "notes": [
    {
     "title": "Patch Update: Steam Deck Verified!",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45722846/0162576680f7001d44fa3bc2373b29f5b10bccc9.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Ahoy, players! We’re excited to announce that SpongeBob SquarePants: Titans of the Tide is now Steam Deck Verified!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Enjoy smooth gameplay, optimized UI, and a seamless handheld experience across the entire adventure. Whether you’re splashing through story missions or taking on side quests in Bikini Bottom, everything will run swimmingly while you are playing on the go.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45722846/04a5f37e450e794233b3ae6190ab08bd6c068f4c.png\"]",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
