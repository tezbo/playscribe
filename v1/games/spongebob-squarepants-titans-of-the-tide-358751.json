  {
   "id": "spongebob-squarepants-titans-of-the-tide-358751@major-2026-02-03",
   "gameId": "spongebob-squarepants-titans-of-the-tide-358751",
   "displayName": "Titans of the Tide - February Patch + Double Deluxe Costume Pack DLC",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-03T14:00:49.000Z",
   "notes": [
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Adding unlock time and date to award screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adding play time to load/save screen information",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Implemented golden balloon counters per level in the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved performance in Haunted Bikini Bottom, on the slide to the final boss with lasers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Update of credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed progression blockers after revisiting or loading a save game (e.g. objective getting stuck or not updating, enemy not spawning, etc.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several persistency issues after loading save game (e.g. final boss platform Haunted Bikini Bottom)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several DLC bugs, e.g. challenges not updating and other edge cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "DLC costumes now remain saved after loading save game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor localisation fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "General minor fixes and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "New Content!",
     "items": [
      {
       "text": "SpongeBob SquarePants: Titans of the Tide: Double Deluxe Costume Pack - now Available for purchase or owners of the Tidal Season Pass: https://store.steampowered.com/app/3870870",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
