  {
   "id": "xel-164866@1.0.6.370",
   "gameId": "xel-164866",
   "displayName": "Patch 1.0.6.370",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-06T08:08:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We got another XEL patch for you, version 1.0.6.370 is now live for you to enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The most important change of course that you can enter the boss area in the Scorched Wasteland (Dungeon 3) again. Time to get your butt kicked, yay!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As promised the list below not only contains the current changes but also the changes from the previous update (sorry, we missed sharing a proper changelog with you):",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed an issue where you got stuck when entering the boss area in the Scorched Wasteland (Dungeon 3)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some water not acting like water. How rude.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some ladders that you could climb down but not back up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed not being able to leave shirls shop after purchasing all items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the game would get stuck when entering the finale",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several locations where you could get stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some occasions where the game got stuck after loading a file",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where snow was still active when fasttraveling from the Glacial Glades to Needle Eye",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the passage between Glacial Glades, Bog and The Divide for performance reasons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Chap",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Minimap not updating properly under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a chest that was already open when restarting the game in the Bog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some wonky loading triggers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where you could get stuck in the Science Station (Dungeon 2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an invisible NPC near the Divide",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Reid's backpack rendering black",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed being stuck in the finale because the window wouldn't break",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the passage between Glacial Glades, Bog and The Divide for performance reasons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Additions & Improvements",
     "items": [
      {
       "text": "Added Chap UI animation to all loading scenarios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved a lot of unneccessary Pop-Ins (geometry appearing out of nowhere)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Your Teams of Tiny Roar & Assemble Entertainment-",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
