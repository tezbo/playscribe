   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today, we are releasing Patch Version 1.1.0.1, which addresses these issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where when a device (controller, mouse, headset, keyboard) was inserted or removed while Sonic Generation was booting up, the game would crash.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issue where if a monitor’s resolution options exceed 32+ options, the game would crash when you would open the Options menu in Shadow Generations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Error message now displayed when game crashes on PCs that are not compatible with AVX.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
