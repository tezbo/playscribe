   "id": "aeon-drive-135410@1.5.01.1919",
   "gameId": "aeon-drive-135410",
   "displayName": "Hotfix 1.5.01.1919",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-12-30T22:07:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Neo Barcelona visitors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A small hotfix just went live to address some minor issues found in our latest patch (update #3).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is the list of hotfixes",
     "items": [
      {
       "text": "Eliminated delay in throwing dagger at the end of dash animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Eliminated delay when throwing dagger when touching the ground.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thank you for all the support that you have shown, and we hope you continue to have fun with Aeon Drive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For feedback and/or bug reports, feel free to join our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
