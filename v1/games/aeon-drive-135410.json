  {
   "id": "aeon-drive-135410@major-2021-10-21",
   "gameId": "aeon-drive-135410",
   "displayName": "Aeon Drive Update: Bug fixes + improvements",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-10-21T11:27:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Neo Barcelona visitors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new patch just went live featuring bug fixes and general improvements to the UI, menus and gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s a list of the main changes",
     "items": [
      {
       "text": "Collectible information (gems, hotdogs, data cubes and number of time capsules used) will now correctly display on the save slot, sector selection and level section.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Confirmation step when deleting a save slot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Twitter video replay sharing system re-implemented.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More options: disabling vibration, screenshake and countdown at the start of a level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remapping is no longer in playerprefs (this will solve the crashing issues some players were experiencing).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In-game bug fixes: fixed camera boundaries, fixed the bug where sliding and pausing the game would cause the timer to stop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For feedback and/or bug reports, feel free to join our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
