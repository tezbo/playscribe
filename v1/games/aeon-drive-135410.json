  {
   "id": "aeon-drive-135410@3",
   "gameId": "aeon-drive-135410",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-12-28T17:21:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We meet again, Neo Barcelona visitors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new patch just went live featuring several bug fixes and improvements to the mobility and responsiveness. This patch was created with the help of our speedrunning community feedback, so the game should feel and play better than ever!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s a list of the main changes",
     "items": [
      {
       "text": "Time will no longer stop when pausing on respawn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jack will no longer face a different direction when attacking/throwing dagger while idle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Levels beat using wall glitches will no longer count towards the leaderboards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed landing animation delay and input bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that prevented players from teleporting to the dagger while slashing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added input buffers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ground pound animation can now be canceled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wall jump is improved and should feel more responsive now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Grabbing a diamond while in co-op mode will now correctly show in the level report",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug that would show all save slots with 100% collectibles unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed end of tutorial game crash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added button remap localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Overall polish of animations and inputs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thank you for all the support that you have shown, and we hope you continue to have fun with Aeon Drive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For feedback and/or bug reports, feel free to join our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
