   "id": "lawn-mowing-simulator-2-375076@patch-2026-06-15",
   "gameId": "lawn-mowing-simulator-2-375076",
   "displayName": "Lawn Mowing Simulator 2 | Demo Patch!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-15T15:19:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ahead of June's Next Fest event, we've just pushed a new patch for the Lawn Mowing Simulator 2 Demo!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Build: 1.0.1.712852.3312",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The update includes",
     "items": [
      {
       "text": "Optimised grass cutting buffers, reducing memory usage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved motion vector performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimised static shadow casters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General performance improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that was causing incorrect in-game language",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
