  {
   "id": "lawn-mowing-simulator-2-375076@1",
   "gameId": "lawn-mowing-simulator-2-375076",
   "displayName": "Patch 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-11T17:00:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi, LMS2 Players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Last week, we released the LMS2 Roadmap 1.0, we're pleased to announce that Quality of Life Update 1 is out now on Steam, PlayStation & XBOX.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      }
     ]
    },
    {
     "title": "Featuring",
     "items": [
      {
       "text": "Employees will now rank up when they complete contracts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First Person Dot Setting added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Field of View Setting added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sensitivity Settings added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Run by default setting added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enabled Grass Density Settings within the menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enabled Unit Settings within the menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "KMpH, MPH",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Metres & Feet",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "KG & LBS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "L & GAL",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug which caused the game to crash after weed trimming for a long period of time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug which caused fulfilled objectives not displaying as completed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug which did not allow for saved camera settings between scenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug which caused mower to respawn in the wrong direction on the trailer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor bug fixes & improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Work has already started on the next QoL update. Further hotfixes such as, achievement fixes & more are currently being investigated and addressed by the team!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please get in touch with us via our feedback form to report any issues you’re experiencing – https://skyhookgames.com/lms2_feedback/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
