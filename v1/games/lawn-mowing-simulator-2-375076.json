  {
   "id": "lawn-mowing-simulator-2-375076@major-2025-10-27",
   "gameId": "lawn-mowing-simulator-2-375076",
   "displayName": "Lawn Mowing Simulator 2 - Kickstarter Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-27T17:00:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Who wants to see some exclusive new LMS2 content? We have updated our Kickstarter “Coming Soon” campaign page with additional content so click here for more info: https://www.kickstarter.com/projects/skyhookgames/lawn-mowing-simulator-2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There are a few new extras, including some concept art for US buildings, plus an example of how locations can change slightly between visits - which should keep things interesting as you progress through your career.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will be updating the Coming Soon page periodically as we build our Followers towards the launch of the campaign - so if you’ve not Followed us yet, please consider it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45829199/4324938996735055254b0c0774ff6c30fac01b8b.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
