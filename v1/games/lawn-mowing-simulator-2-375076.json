  {
   "id": "lawn-mowing-simulator-2-375076@2",
   "gameId": "lawn-mowing-simulator-2-375076",
   "displayName": "Patch 2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-19T15:26:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are pleased to confirm that the latest hot fix we shared yesterday has now gone live on Steam. This update includes:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Build number - 1.0.1.1296945.5400",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General Fixes",
     "items": [
      {
       "text": "Fix for \"Black screen\" or \"Can't progress with buying handheld equipment\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "These were caused by saved game compatibility issues between demo and full game. We have updated the save system to stop some issues of the game not creating a suitable save file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "New Feature",
     "items": [
      {
       "text": "Respawn option in pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We have added an option to respawn to the pause menu as a safety option whenever people get trapped behind objects and are falling through the floor. We are already working on fixes that cause these issues, but in the meantime, this feature should prevent people from being blocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Performance Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated loading technique to improve memory usage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More improvements are being worked on by the team so we will share more updates later this week for you all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
