  {
   "id": "lawn-mowing-simulator-2-375076@major-2026-09-30",
   "gameId": "lawn-mowing-simulator-2-375076",
   "displayName": "Lawn Mowing Simulator 2 | News Update | 30/09/26",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-30T16:24:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi LMS2 players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Once again, we would like to say thank you all for your support since LMS2 launched last week! Since then, we’ve been pushing to bring a range of improvements to the gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are working hard to bring a series of patches, and following the previous news update & the patch notes post, we’re releasing another patch across all platforms today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Contents",
     "items": [
      {
       "text": "Respawn option added to the pause menu (Consoles)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PS5 save issue fix – this resolves some of the save-related problems being experienced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Performance improvements (Consoles)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Screen tearing fix (PS5)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "D-Pad navigation added to the menus (All platforms)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have been monitoring your feedback since launch and are working hard to improve aspects such as mower handling, collision, etc. We will update you all when these fixes will be available as soon as we can!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue to monitor feedback across our social media channels, store reviews and our dedicated feedback form - https://skyhookgames.com/lms2_feedback/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
