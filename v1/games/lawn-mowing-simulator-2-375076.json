  {
   "id": "lawn-mowing-simulator-2-375076@3",
   "gameId": "lawn-mowing-simulator-2-375076",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-08T12:01:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After taking a look at your comments on the LMS2 Demo, we have just released an update which provides a range of improvements/fixes to create an even more satisfying & immersive experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This update includes",
     "items": [
      {
       "text": "A new Grass Deformation system which allows you to leave some sweet lines!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vehicle handling has been improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Greater steering stability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Uneven ground & slopes are passed over with greater ease",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Further optimisation improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated Leaf blowing physics & tarp collection visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're just under 3 weeks out from the release of the full game! If you haven't checked out the Release Date Reveal Trailer, take a look for a sneak peek at the Town Hall & park locations!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
