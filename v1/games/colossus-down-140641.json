       "category": "other"
      },
      {
       "text": "Alfiia Salakhova - translator",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Galina Leshchenko - translator, linguistic tester",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
