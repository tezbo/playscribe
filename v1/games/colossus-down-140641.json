  {
   "id": "colossus-down-140641@04",
   "gameId": "colossus-down-140641",
   "displayName": "Update 04",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-12-16T19:37:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Join forces with Nika, MechaNika, Agatha and the Great Bleeding Pig in Colossus Down, a unique and twisted mission of destruction of everything that isn't cool.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bringing this game to life has been quite a ride and we can't wait for you to discover our new Psychotic Adventure. We'd love to know what decisions you make and what outcomes you face throughout the game. Your experience, what you feel and what you think of it means a lot to us. So, please, feel free to share your thoughts about the game on social networks and leaving a review on Steam. That will help us A LOT!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
