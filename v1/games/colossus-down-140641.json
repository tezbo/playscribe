  {
   "id": "colossus-down-140641@05",
   "gameId": "colossus-down-140641",
   "displayName": "Update 05",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-12-21T18:34:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey destroyers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some of you have been reporting some issues on the Community Hub or our Discord server. We are really thankful for your patience and for helping us tracking these errors. Now it's time for a patch! It fixes some issues with controller and keyboard assignment on 2 player mode, frozen cutscenes and respawn errors, among other gameplay bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you find any other issue while playing Colossus Down, please, post it on the Technical issues subforum so we can help you with it as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
