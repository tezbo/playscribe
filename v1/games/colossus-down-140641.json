  {
   "id": "colossus-down-140641@1.0.4",
   "gameId": "colossus-down-140641",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-02-13T09:54:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, destroyers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this new patch 1.0.4 we have tweaked some gameplay features so you can feel more powerful since the beginning of your mission. We have also added Catalan localisation, so now the game can be played in English, Spanish, Korean, Russian and Catalan.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Aaaaaaand, that's it. Best of luck in your destruction quest!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
