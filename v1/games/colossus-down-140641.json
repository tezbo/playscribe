  {
   "id": "colossus-down-140641@06",
   "gameId": "colossus-down-140641",
   "displayName": "Update 06",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-02-11T18:12:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks to the effort of LSW, who already worked with us on localization for Agatha Knife and MechaNika, we have been able to add Korean localization for Colossus Down too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And to celebrate, all Psychotic Adventures are joining the Lunar New Year Sale!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Three indie games. Three epic quests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🕯️ Create a religion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🤖 Craft a mecha",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "💥 Destroy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
