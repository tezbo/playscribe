       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Andrey Busniuk - translator, linguistic tester",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Egor Popov - localization engineer, translator",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
