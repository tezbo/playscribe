  {
   "id": "shotball-329532@1.2",
   "gameId": "shotball-329532",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-25T11:31:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re thrilled to announce the release of Update V.1.2, packed with exciting gameplay improvements, matchmaking enhancements, and a better store experience to elevate your gameplay!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🎮 Gameplay Improvements",
     "items": [
      {
       "text": "🔥 Ultimate Ability Fix: Resolved an issue where the ultimate ability couldn’t be used in certain situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🎉 Enhanced Celebrations & Emotes: Enjoy smoother and more dynamic celebrations and special emotes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "💥 Improved Visual Effects: Upgraded visual effects for the special energy ball for a more immersive experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🎯 Friendly Fire Indicator: A new indicator now shows if a teammate accidentally hits you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🌐 Matchmaking & Search Enhancements",
     "items": [
      {
       "text": "📊 Region Session Count Indicator: You can now see the number of active sessions in each region to help you choose the best one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "⏱️ Minimum Player Limit for Matches: Matches will now start with a minimum player count, allowing players to join mid-game if needed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🌍 Automatic Region Switching: If matchmaking takes longer than 8 minutes, the system will automatically switch to a more active region. If you cancel the search, it will revert to your original region.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🛒 Store Experience Improvements",
     "items": [
      {
       "text": "🏷️ Redeem Code Feature: Players can now redeem special codes for exclusive rewards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🤝 Support Code Feature: Support your favorite Shotball content creators with the new support code option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "⚡ Shotball Box Shortcut: A new shortcut has been added for quick and easy Shotball Box purchases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "💬 We’re Always Listening",
     "items": [
      {
       "text": "If you encounter any issues or have suggestions, feel free to reach out. The Shotball team is dedicated to providing you with the best gaming experience possible!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✨ Update your game now and enjoy the latest Shotball experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔥 Get ready for the challenge see you in the arena! 🎮",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
