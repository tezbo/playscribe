  {
   "id": "shotball-329532@1.4",
   "gameId": "shotball-329532",
   "displayName": "Update 1.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-05T15:56:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Shotball Update 1.4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hey players, we’ve got a fresh update rolling out with some big quality-of-life improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Animations – Movement and actions now look smoother with remade transitions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bots in Matchmaking – No more empty lobbies. Bots will fill in to keep matches flowing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Custom Games + Server Viewer – Set up your own games or browse servers to play your way.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for all the feedback—you’re helping shape Shotball every step of the way. Jump in and give these new features a try!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
