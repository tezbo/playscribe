  {
   "id": "shotball-329532@1.3",
   "gameId": "shotball-329532",
   "displayName": "Update 1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-11T20:17:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "📢 Shotball Update V.1.3 is Live! 🚀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re excited to introduce Update V.1.3, bringing major gameplay improvements, a new ranked mode, and more competitive action",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🏆 Ranked Mode is Here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Ranked Mode has officially launched! Test your skills and climb the ranks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "⚡ Matchmaking Improvements",
     "items": [
      {
       "text": "Faster matchmaking for a smoother and quicker experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🎭 Movement Animation Enhancements",
     "items": [
      {
       "text": "Improved movement animations for a more fluid and responsive feel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🛒 Store Update & New Bundle Release",
     "items": [
      {
       "text": "A fresh new bundle is now available—check it out in the store!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🎯 Enhanced Enemy Visibility",
     "items": [
      {
       "text": "Opponents now appear with a red outline for easier identification.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy team equipment is now highlighted in red, making it easier to locate, disable, or destroy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "⚖️ Gameplay Balancing & Adjustments",
     "items": [
      {
       "text": "Various in-game elements have been fine-tuned for better balance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased knockdown protection time, giving you a chance to recover after being taken down.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "✨ And much more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "💬 We’re Always Listening",
     "items": [
      {
       "text": "If you have any feedback or encounter issues, let us know! The Shotball team is committed to continuous improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🚀 Update now and jump into the action!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔥 See you in the arena! 🎮",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
