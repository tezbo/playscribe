  {
   "id": "shotball-329532@1.1",
   "gameId": "shotball-329532",
   "displayName": "Update 1.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-02-21T12:17:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "📢 Shotball Update V.1 is Live! 🚀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re excited to share that we’ve addressed key technical issues from the previous version to improve your gaming experience:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔧 Server Stability and Availability Fixed",
     "items": [
      {
       "text": "Server stability issues have been resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you encounter long matchmaking times, it could mean there aren’t enough players in your region. For a smoother experience, we recommend switching to more active regions like Bahrain or Frankfurt.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🛠️ Loading Screen Issue Resolved",
     "items": [
      {
       "text": "The problem causing the loading screen to freeze after matches has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🤝 Improved Invite System (INV)",
     "items": [
      {
       "text": "We have enhanced the invite system for a smoother and faster experience when inviting friends to your matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "💬 We’re Listening",
     "items": [
      {
       "text": "If you face any other issues, don’t hesitate to let us know! The Shotball team apologizes for any technical issues you may have faced and is committed to resolving them as quickly as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✨ Update your game now and enjoy an enhanced Shotball experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔥 Let’s hit the field see you in the arena! 🎮",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
