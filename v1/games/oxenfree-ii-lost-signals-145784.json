  {
   "id": "oxenfree-ii-lost-signals-145784@1.3",
   "gameId": "oxenfree-ii-lost-signals-145784",
   "displayName": "Patch 1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-15T05:07:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you so much for playing OXENFREE II during our launch week! Your reviews, social media posts, and reactions to the game have been overwhelming and amazing. Camena’s been overrun with disruptions in the electromagnetic spectrum but you've made it a cozier place to be.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just updated the game with a patch to fix a few things including:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved click and drag for mouse controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Made changes to the Community Center scene to fix freezing/crashing, audio distortion, muted music or other instabilities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved animation and traversal.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed general auto-save and save file issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We're working to address other issues in an upcoming patch. If you encounter something strange – other than ghosts – visit our customer support portal for extra help. Also, if you love the game so far, help us out by leaving a review or giving us a shout on Twitter, TikTok, Instagram, or Facebook.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
