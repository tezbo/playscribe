  {
   "id": "oxenfree-ii-lost-signals-145784@1.4",
   "gameId": "oxenfree-ii-lost-signals-145784",
   "displayName": "Patch 1.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-29T22:28:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Welcome back to Camena. OXENFREE II's 1.4 patch is now live and thanks to your feedback and help, we fixed a few things in this version of the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved Jacob's walking, traversal, and conversation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More stable walkie talkie conversations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved crashing or blockers at the Community Center, Garland, General Store, Funnie's Family Market, Copper Creek Trail, Berenson Creek, caves, mines, and end game content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "So many more minor fixes that we can’t list them all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Loop back and if your return trip is smooth, leave us a five star Steam review and tell us what you liked. If you run into any other issues, give us a shout at our customer support portal. You can do this, Ryebread -- you’re more capable than you think.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
