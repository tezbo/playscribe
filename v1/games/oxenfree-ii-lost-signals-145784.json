  {
   "id": "oxenfree-ii-lost-signals-145784@1.4.8",
   "gameId": "oxenfree-ii-lost-signals-145784",
   "displayName": "Patch 1.4.8",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-19T20:24:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve fixed an issue that would cause players to be stuck in Copper Creek after speaking with Evelyn while getting your climbing gear. This prevented you from moving onward toward Camber Cape or interacting with other items. This patch fixes that issue: load your save file and restart your conversation with Evelyn to continue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for the feedback and helping us fix the issue!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now, grab your climbing gear and head back. If you loved the game, give OXENFREE II a five star Steam review and tell us what you liked. If you run into any other issues, give us a shout at our customer support portal.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
