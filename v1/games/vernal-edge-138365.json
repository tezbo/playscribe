      },
      {
       "text": "Have certain special hurtboxes ignore swift slice e.g. mushrooms, levers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disable active frames on axeman triangles until they launch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Make saffron spear pre-stab more noticable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add light source to creeps so they are easier to spot",
       "ps5ProOnly": false,
