  {
   "id": "vernal-edge-138365@post-2023-03-20",
   "gameId": "vernal-edge-138365",
   "displayName": "March 20 bugfixes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-03-20T13:57:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A handful of bugfixes and QoL improvements for you today",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add steam screenshot functionality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mark solid elevators as moving for ledge grab so the player doesn't float in the air",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent certain bosses from showing George sprites on defeat (Rook, Mia)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have arena director speak the \"no cheating line\" in Arena 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent a certain hidden collectible from adding to the treasure sense counter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remember cursor position in memory/spell menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Scroll map screen 2x as fast",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update door visuals on Mossy Island to better communicate its intent",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Animate floating little rocks on Fallen Tower island",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improve tutorial message popups, fixing logic that could have some messages show at the wrong time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improve bell detection by always checking the last N notes hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent solving bell puzzle by hitting 'clue' bells",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Possible fix for an issue where the player could get stuck in a wall when beginning the final boss fight. no that still happens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent slowdown effects from persisting across map transitions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix fps drops causing overworld collisions to spiral out of control",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Set the auto-skip text button to be unbound in the default controller scheme (keyboard is unchanged)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Handle saves from old versions of the game better when calculating profile completion percent",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remove debug features from the training dummy that were bound to numpad keys",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix the reward for completing the game on Vicious difficulty not being granted to players. For anyone who has already completed the game on Vicious, you will need to reach the credits sequence on your Vicious difficulty file to receive it. If you have a save near the end of the game, then beating the final boss again should suffice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
