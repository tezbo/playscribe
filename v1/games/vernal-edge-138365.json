  {
   "id": "vernal-edge-138365@post-2023-03-23",
   "gameId": "vernal-edge-138365",
   "displayName": "March 23 fixes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-03-23T13:53:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Another update for you today, mostly bugfixes with a few small balance changes as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to everyone who played the game and reported issues. If you don't see your bug here, hold tight as there will be more on the way soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add swingpole to the end of mineshaft ride",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add checkpoints around crushing blocks in spore_left",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remove a glowshroom in spore_undercity_right",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have cutscene vernal inherit hair colour",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Give the right item as a reward at mineshaft end",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix pyramid timer and ship radar not resetting draw alpha",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix fight enemy OOB detection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Add respawn points to final boss fights",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Block ceiling of finale_nature_1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy stoppers block shield guy projectile sword",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Allow shield guys to pick up the shield magically if they cant grab it for 7 seconds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix crash due to destroyed proj_shieldthrow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix crash with swordupper spell",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix crash when trying to reflect at nonexistant instance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix stinger bloom crash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Update cached foliage buffers to fix a visual error with floating small rocks getting stretched out",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix parry damage not being dealt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "More typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rename 'hard mode' palette to 'vicious'",
       "ps5ProOnly": false,
