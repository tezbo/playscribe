       "category": "other"
      },
      {
       "text": "Timebomb mana cost 500 -> 800",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Timebomb recast delay 80 -> 120",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Acid rain tick damage 20 -> 14",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add more particle effects to acid rain fight to make it clearer something is happening",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Autopickup timer for shield guys 3s -> 7s",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Make axe guy triangles semi-transparent when in a non-damaging state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add an indicator for where to go with a certain hard-to-reach creature",
       "ps5ProOnly": false,
