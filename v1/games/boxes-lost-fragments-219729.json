  {
   "id": "boxes-lost-fragments-219729@major-2024-03-12",
   "gameId": "boxes-lost-fragments-219729",
   "displayName": "Boxes content update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-12T14:04:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been reading your feedback and have implemented a substantial update for Boxes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We replaced several of the puzzles with more original, more diverse, and a bit harder ones. Additionally, we adjusted the clarity and difficulty of some of the puzzles, based on feedback and statistics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also changed the ending of the game, and we added a Story Notes menu, where you can read all of the unlocked story cards. Finally, we fixed several bugs and polished the art a bit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy gaming and thank you for your ongoing support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
