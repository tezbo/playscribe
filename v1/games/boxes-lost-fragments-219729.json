  {
   "id": "boxes-lost-fragments-219729@major-2024-01-04",
   "gameId": "boxes-lost-fragments-219729",
   "displayName": "Boxes: Lost Fragments Progress Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-04T11:33:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We want to thank you for your unwavering patience and support! The last 2 months have been a flurry of non-stop effort as we dedicated ourselves to finishing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boxes is now in its final form, having undergone several rigorous rounds of internal testing and refinements. However, before we can release it, we still need to test with more players for stability and clarity of the gaming experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our new target release date is January 25, depending on the successful outcome of the beta test.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
