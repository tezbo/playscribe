  {
   "id": "boxes-lost-fragments-219729@major-2024-01-24",
   "gameId": "boxes-lost-fragments-219729",
   "displayName": "Boxes: Lost Fragments Demo Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-24T15:57:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Following a successful beta test launch yesterday, we continue to roll out major news and improvements as we gear up for the official release of Boxes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🎮Our demo has been updated.",
     "items": [
      {
       "text": "The demo now features completely new content and lets players experience the beginning of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned for more updates as we approach the big day!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "📅 Boxes: Lost Fragments comes out on February 1st, 2024.",
     "items": [
      {
       "text": "The Big Loop Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
