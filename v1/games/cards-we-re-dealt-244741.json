 "releases": [
  {
   "id": "cards-we-re-dealt-244741@major-2025-09-18",
   "gameId": "cards-we-re-dealt-244741",
   "displayName": "Cards We're Dealt Directors Cut Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-18T14:33:33.000Z",
   "notes": [
    {
     "title": "Cards We're Dealt 1.0.4.8",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/43722029/4b6f77b12f5a7ad9870065e3ad4d08b2846f4643.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Directors Cut Part IV is here! This concludes all remaining changes I wanted to make to the game for the time being! The game will launch everywhere next month.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Cards We're Dealt Prologue now available for free on Xbox as a demo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Added parking garage floor in \"Escape\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new animation for players tripping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix game settings and stats not resetting when restarting from lobby menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/43722029/e22295a5d67d9b27430472cf6bfdc0eb28efd04d.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hope you all appreciated the journey as much as me.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Next time you hear from me the game will be out on Playstation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Back to work on Tiny Planet...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Love you. Appreciate everyone's patience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cole",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
