  {
   "id": "my-little-puppy-335660@major-2025-11-12",
   "gameId": "my-little-puppy-335660",
   "displayName": "Update Notes #1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-12T12:33:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Based on everyone’s feedback and reports, the following updates have been made:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the cutscene skip controls and input timing to prevent accidental skipping.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where control inputs were delayed when returning to gameplay in certain situations. Riding the rapids at Steep Valley should now be easier—go for that achievement!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several reported bugs have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Following the recommendation of #PolishOurPrices, the game’s price in Poland has been adjusted from 114,99 zł to 89,99 zł. As a Korean developer, we were not fully aware of the pricing issue in Poland. Our Polish friends, we are truly sorry! We know it is late, but we hope you understand. 😂",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please report any game-related issues or bugs on the discussion board. Our development team will review and respond as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the end, we will meet again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you! Bark bark! 🐶",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
