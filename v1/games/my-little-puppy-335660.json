  {
   "id": "my-little-puppy-335660@major-2025-12-16",
   "gameId": "my-little-puppy-335660",
   "displayName": "Update Notes #2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-16T08:30:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Based on everyone’s feedback and reports, the following updates have been made:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To make the chase sequence more thrilling and intense, we revamped the sounds of the Descent Trail. Jump back in and enjoy the chase!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Tug-of-War mini-game now features a new BGM that better matches the gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several reported bugs have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please report any game-related issues or bugs on the discussion board. Our development team will review and respond as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the end, we will meet again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you! Bark bark! 🐶",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
