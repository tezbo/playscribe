 "releases": [
  {
   "id": "fresh-tracks-335842@major-2026-09-10",
   "gameId": "fresh-tracks-335842",
   "displayName": "Fresh Tracks 1 Year Anniversary Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-10T15:40:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The one year anniversary update of Fresh Tracks is officially out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To celebrate 1 year around the sun, we are launching a brand new gamemode. Replay your favourite tracks with the brand new Playlist Mode. Create your own 5 song trail and seamlessly transition between your favourite songs after completing each level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy Scenic Mode for a low-stress, no-combat adventure where you glide along the tracks to the beat of our unforgettable original soundtrack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Remixes have also been added to the Lark to enjoy your favourite tracks with a new spin! And finally, we’ve added bug fixes and new quality of life improvements to make your trip through Norwyn even better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In addition to the new updates, Fresh Tracks is now 50% off in the bundle with the new VR edition of the game. Complete your bundle with the Norwyn’s Champion Bundle on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "That’s all from us folks, happy trails!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your friendly neighbourhood devs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buffalo Buffalo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
