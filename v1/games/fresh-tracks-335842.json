  {
   "id": "fresh-tracks-335842@major-2025-09-23",
   "gameId": "fresh-tracks-335842",
   "displayName": "Update Notes for September 23rd 2025",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-23T17:04:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks for playing Fresh Tracks! Here's another small update addressing a few issues players have reported!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed achievements not unlocking on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed cases where the incorrect Rhythmic would be equipped after using an encore in certain Boss Songs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed boss shortcuts not appearing during certain points of progression",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
