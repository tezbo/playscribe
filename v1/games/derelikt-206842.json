  {
   "id": "derelikt-206842@3",
   "gameId": "derelikt-206842",
   "displayName": "Hotfix 3",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-11-25T16:16:08.000Z",
   "notes": [
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed an edge-case issue where enemies could get massive HP buffs from nearby Oculuses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in LVL 05 that allowed for skipping the central security hack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a visual issue where the player’s HP could appear incorrect until opening the inventory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Cheats can now be entered in the “Cheats” menu during gameplay, without having to quit back to main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the responsiveness of inputting cheats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Additionally, we have also resolved the lingering inventory problem which resulted in items disappearing from said inventory or occupying spaces designated for other items. Let us know, if you encounter the bug after this hotfix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
