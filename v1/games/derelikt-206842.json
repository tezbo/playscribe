  {
   "id": "derelikt-206842@2",
   "gameId": "derelikt-206842",
   "displayName": "Hotfix 2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-11-15T16:22:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Small number of fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As usual, please report any issues you encounter. Share your feedback, write reviews - we read them all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Replaced music track playing during the gym fight to avoid potential strikes for content creators",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed player being able to heal during Cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed explosive barrels not exploding when there's an item placed on top of the barrel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added HUD Feature to indicate no full Magazine is available",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "- If no full magazine is available, the magazine counter in the HUD (the number on the right side) will now appear greyed out to notify you that your next reload may not be a full one. Time to stack some ammo in your inventory!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed not being able to shoot enemies through certain railings in LVL 05",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed leftover collision after pillar collapses over kill volume, allowing the player to stand in mid-air",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
