   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Flashlight batteries replaced by heavy duty 24h super space battery from AOC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An improvement when player is given an item with full inventory - the key item will be placed inside inventory, pushing one stack of low tier ammo on the ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Robots being audible from across the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Schiller' Door Softlock in level 6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where an Abomination could spawn in clear sight when player destroyed a door with an explosive barrel in level 4 (Exo Labs)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare case where Lightning Rifle disappears during reload",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed downed Abominations being invulnerable to explosives",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Proxy Spawn Animations in level 9",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed possible performance issues on level 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Documents and Insight are now counted correctly on the save screen\". For existing saves, this issue will fix itself after saving again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The option to change FOV is coming along with more improvements and fixes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to everybody for their reports, feedback and opinions. We read them all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
