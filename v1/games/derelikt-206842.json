  {
   "id": "derelikt-206842@1",
   "gameId": "derelikt-206842",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-11-23T16:27:34.000Z",
   "notes": [
    {
     "title": "INCOMING TRANSMISSION",
     "items": [
      {
       "text": "Administrator clearance upgraded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your field reports came through loud and clear, so we’re deploying a software update to the outpost as requested.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "FOV slider, a stash near every save point, improved key remapping, and toggle options for sprinting and crouching.",
     "items": [
      {
       "text": "Just to name a few of the changes included in this update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let us know if everything is running more smoothly, and don’t hesitate to report back if you spot any glitches or weird interference.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also, if this update fixed the specific issues that made your first playthrough rough, we’d be super grateful if you updated your review. Every bit of support helps boost the signal from Von Neumann Outpost even further.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New features and improvements",
     "items": [
      {
       "text": "Added adjustable FOV option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added toggle options for sprinting and crouching",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Streamer Mode option (in the Sound section in the Options, available from the main menu)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added player's stash next to every save pod",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced Self-Damage with the Sentinel Arm weapon from 35 to 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General improvements to menu navigation on controllers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed lot of collisions that could cause player to become stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed enemy state persistence and position restoration on load that could cause enemies to \"respawn\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where selecting an unequipped Glyph could reduce the player’s health",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where it became impossible to stash items away after reading documents",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed possible level skip in LVL 06",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed UI Screens persisting after player's death, causing a softlock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the total amount of all possible documents to find shown in the statistics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed items respawning on top of destroyed barrels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed Kruger's Coin Half when revisiting LVL 06",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed glass collision in front of Vlodnikov in LVL 07 if it was destroyed in the cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the duplicate of Hartman in LVL 04 after Player enters LVL 07",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a possible autosave corruption when trying to manually save a game too quickly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where it was possible to use a hotkey to use a medpack during a cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in the battery puzzle where certain pieces could change their rotation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed few issues regarding controls remapping (especially remapping the arrow keys and mouse scroll)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed bunch of graphical glitches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some door's collisions remaining in place even when the doors were opened: Let us know how DERELIKT feels now on your end.: Discord: https://discord.gg/Cxp8rzUSX5: Talk soon!: [img src=\"{STEAM_CLAN_IMAGE}/45664223/837feb3f28a9199565f25131081dd9a6a06b4fa0.png\"][img src=\"{STEAM_CLAN_IMAGE}/45664223/9b4552647e4d6ba5012fff7fd36a5b78a2f613a3.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
