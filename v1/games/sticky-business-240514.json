  {
   "id": "sticky-business-240514@major-2024-09-26",
   "gameId": "sticky-business-240514",
   "displayName": "Free Among Us Out Update Now",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-26T12:31:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fellow Stickies!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The announcement of our collaboration with the fantastic people at Innersloth was just a few days ago - and now we're already here: the official Among Us meets Sticky Business Update has just gone live and is waiting for you to go all in on creativity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We can't wait to see your creative, wild, cozy, handsome, weird and wonderful stickers. Jump right in and show us your creations here or on our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun and stick with us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
