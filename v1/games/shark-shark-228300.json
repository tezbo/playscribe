  {
   "id": "shark-shark-228300@major-2026-06-05",
   "gameId": "shark-shark-228300",
   "displayName": "The latest update expands and enhances the gaming experience",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-05T12:10:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New dash/acceleration function for fish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved controls in the classic version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New pause function during gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimized controller mapping and user guidance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved animations and technical optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Numerous bug fixes and stability updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Noah Ezrin, a die hard Intellivision fan from Kuala Lumpur, Malaysia was working closely with the developers and is delighted about the new versions: “The reboot of Shark! Shark! was easily one of my most anticipated titles anyway. It’s been an absolute blast playtesting various console builds of Shark! Shark! across Nintendo Switch, PlayStation 5, and Xbox Series X|S. Many improvements have been implemented in the latest updates, which make these reimagined Intellivision classics the definitive way to experience these legendary games on modern platforms. The Classic Astrosmash now features significantly improved controls, along with the ability to pause the game mid-session. In the latest reimagined version of Shark! Shark!, players can now dart/speed up their fish while narrowly avoiding the sharks and hazards lurking in the deep waters.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44154459/bba304f9e983949d6fdec68cd02c66fd15166cf4.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
