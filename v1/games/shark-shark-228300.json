   "announcedAt": "2024-08-16T11:29:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Welcome to our new Shark! Shark! version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many of you have asked for the original Shark! Shark! version from 1982. We have fulfilled your wishes. This new update makes it possible to play the old original version from 1982 as well as the modern new Shark! Shark! version. We hope you enjoy this trip into the past of the video game world of 1982!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This update also contains",
     "items": [
      {
       "text": "General stability fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steamdeck support improvements",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "New localization languages support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
