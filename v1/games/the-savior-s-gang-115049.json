  {
   "id": "the-savior-s-gang-115049@1.01",
   "gameId": "the-savior-s-gang-115049",
   "displayName": "Update 1.01",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-03-06T18:43:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Few days before our launch, and it's already here! we hear your thoughts comments and watch your gameplays and screenshots to find bugs and improve the game. We are still working on solving bugs and adding new features that you asked for, this is just the first update of many more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-Box Update",
     "items": [
      {
       "text": "Worshippers move box faster, and they respond way better to your instructions at the moment of picking up the box!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-Menus - Setttings extended - exit button",
     "items": [
      {
       "text": "We have added a video settings. Until now, we set this settings internally by an initial benchmark, now you can change it at your desire.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have also added an exit button on the main page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-Epitaph first update",
     "items": [
      {
       "text": "We ask for people to send the epitaphs they want to see in the game, we have added it on this update. But we will do more updates! so if you want to see new custom epitaphs tell us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-Other bugs fixes",
     "items": [
      {
       "text": "Some balls get stuck on their path and the camera was vibrating continuously",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Worshippers no longer flyes when they go through a wooden bridge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some minor camera fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimization improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "-Next Updates",
     "items": [
      {
       "text": "Difficulty level selector",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adding some checkpoints on some levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More bugs solved!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Surprises!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
