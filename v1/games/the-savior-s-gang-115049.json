  {
   "id": "the-savior-s-gang-115049@1.04",
   "gameId": "the-savior-s-gang-115049",
   "displayName": "Update 1.04",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-06-04T16:13:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New Update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We finally did! we have just rebuild the whole camera system to prevent the strange collisions, low camera angles and full zoom to the Worshippers knees.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have also improved the navigation paths at some points in different levels, so worshippers will move a bit more smoothly now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Overall optimization has been done, and a few bugs has been sended to the hell.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep telling us your thoughts and ideas and we will keep improving this holy game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
