  {
   "id": "the-savior-s-gang-115049@1.03",
   "gameId": "the-savior-s-gang-115049",
   "displayName": "Update 1.03",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-04-12T17:02:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Mac OS X users can now be blessed with the glory of the Savior!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also, the game is updated to the 1.03 version!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Major optimizations had been done for this update, and also we added a new difficulty selector menu in order to let players enjoy the narrative withtout worry about the extra hard levels, but do not be fooled!! heaven will be only for the bravest players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discover this and all the other new features in The Savior's Gang!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
