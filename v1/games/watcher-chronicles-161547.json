  {
   "id": "watcher-chronicles-161547@major-2022-02-05",
   "gameId": "watcher-chronicles-161547",
   "displayName": "Update Local Co-op Improvements",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-02-05T02:06:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A local character can now be used for local co-op.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Local characters will retain their level, stats, and equipment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Local characters can acquire umbra and items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Local characters can talk to merchants, level up, and upgrade equipment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Everything will persist on the local characters save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Auto respawn player 2 when both characters die.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the ability to revive a player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Long story short player 2 will now be able to experience the game the same way as player 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NPC boss hit box fix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Katana hit box fix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
