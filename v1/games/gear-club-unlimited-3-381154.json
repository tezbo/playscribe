   "announcedAt": "2026-10-22T15:43:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "PC Update 1.2 for Gear.Club Unlimited 3 is now live on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Steam will download it automatically. If it doesn't appear, restart Steam. This update brings shader pre-compilation to cut stutters, working cockpit displays on 14 cars, and a fix for Career progression in Chapter 5.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "🎮 Playing on console? Update 1.2 arrives on PS5 and Xbox Series X|S early next week.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      }
     ]
    },
    {
     "title": "⚡ Performance",
     "items": [
      {
       "text": "Shader pre-compilation: on first launch, and after a graphics driver update, the game now prepares its shaders after the intro videos to reduce stutters during races. A progress indicator shows in the top-left corner while it works.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Faster loading: races load faster on many tracks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Smoother rendering: rendering optimisations and fixed stutters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Path tracing: optimisations and visual improvements.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Stability: memory usage fixes for long play sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🏎️ New: Working Cockpit Displays",
     "items": [
      {
       "text": "Digital instruments and screens now show live information: speed, revs, gear, gauges and trip computers, plus the in-game radio on some infotainment screens. You'll find them on:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "BMW Z4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
