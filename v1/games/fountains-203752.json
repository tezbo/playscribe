  {
   "id": "fountains-203752@1.4.6",
   "gameId": "fountains-203752",
   "displayName": "Patch 1.4.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-03-31T00:19:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "FOUNTAINS Patch Notes - Release 1.4.6 (March 30th, 2025)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hi FOUNTAINS players, this is just a small patch to tweak some issues players have found over the past few weeks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that patch notes can contain spoilers, read at your own risk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Can now press the \"Back\" button to cancel equipping a quick item or tool.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new set of armor to the game which was intended for release, but forgotten.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Tweaks to Japanese translation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced the amount of water gained from hits while slash-dashing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed a bug where Elias could become stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Elias's altar animation could be interrupted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the player having too long of a grace period after the boss died where they could not died",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Amtarr's music could stop mid-fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
