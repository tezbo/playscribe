  {
   "id": "fountains-203752@1.3",
   "gameId": "fountains-203752",
   "displayName": "Patch 1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-07-03T04:27:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The second patch of the demo is here! This patch adds a world map system, more music tracks, a lot of bugfixes, and more secret content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FOUNTAINS Demo 1.3 Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "World Map System: (To open, press X on keyboard, or down on the D-Pad)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "New music for Guard Dog boss fight (Thanks, Travis Moberg!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New music for Overgrown Church area (Again, thanks to Travis Moberg)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Buffed Guard Dog boss's melee damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Red Mushroom now heals less, and more slowly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Sprinting is faster",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Toned down Doyle's dialect a bit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fix a stuck spot in Palace Garden under some banners",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a typo in Sacha's dialogue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a possible sequence break: getting to Library before beating Hookmaster",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed being able to catch fish through a wooden bridge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed unnecessarily nagging the player about no energy even if they didn't try to use energy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed grapple-able wheat which would let you grapple to an island that wasn't supposed to be reached in the demo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Miners being permanently killable: ... and even more *secret changes*!: By the way - the game's Kickstarter is now at 84% funding with ten days to go! Thanks so much to everyone who has contributed to the development of a full version of FOUNTAINS, we're almost there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
   "digest": {
    "new": 2,
    "fixed": 7,
    "balance": 4,
    "other": 2,
    "ps5": 0,
    "topNew": [
     "New music for Guard Dog boss fight (Thanks, Travis Moberg!)",
     "New music for Overgrown Church area (Again, thanks to Travis Moberg)"
    ]
   },
