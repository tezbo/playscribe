  {
   "id": "fountains-203752@1.2.0",
   "gameId": "fountains-203752",
   "displayName": "Patch 1.2.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-24T06:04:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "FOUNTAINS Patch Notes - Release 1.2.0 (Dec 24 2024)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "本次更新为游戏添加了中文！",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This makes FOUNTAINS accessible to 1.3 billion more players. Huge thanks go to Huang \"Shuyuan\" Teng for his amazing (and fast!) work on the Chinese translation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that patch notes may contain spoilers; read at your own risk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Full support for Chinese (Simplified Chinese translation by Huang \"Shuyuan\" Teng)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Minor level design tweak to make it more likely for players to find Guard Dog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed some bosses being attackable before their fight starts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some issues with music timing in boss fights",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Ricard appearing too early near the temple",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed pets spamming smoke particles if the player is teleported away",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a visual bug in Retreat of the Old Believers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
   "digest": {
