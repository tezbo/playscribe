       "text": "FOUNTAINS Patch Notes - Release 1.3.1 (Jan 27 2025)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello, FOUNTAINS players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "こんにちは、私のゲームをこれからプレイするプレイヤーの皆さん！",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
