  {
   "id": "fountains-203752@1.1.1",
   "gameId": "fountains-203752",
   "displayName": "Patch 1.1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-22T00:28:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch Notes - Release 1.1.1 (Dec 21 2024)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that patch notes may contain spoilers! Read at your own risk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "All bosses now grant some kind of Tool",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Consequently, some Tools have been moved from their original location.: If you didn't pick them up before, you can go to the room of the defeated boss to pick them up.: (don't worry, none of these are required to beat the game)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "There are now two bosses which can grant you a free tool slot upgrade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Guard Knights have more readable animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated some dialogue in Russian and Turkish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Blessing of Amtarr bothers you much less frequently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed rare bug where you would fall off a cliff while dashing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Ricard's quest ending before Krus is killed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed being able to activate a specific door while you're standing on it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed performance issue with flamethrowers on low-end machines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
