  {
   "id": "fountains-203752@1.2",
   "gameId": "fountains-203752",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-19T06:40:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As promised, the first demo patch is here! The most important change here is sprinting, so when you're lost in the world of FOUNTAINS it won't take quite so long to find your way! There are tons of other bugfixes, tweaks and minor changes as well. I'd also like to thank everyone who has funded the full version of FOUNTAINS on Kickstarter, we're making great progress!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FOUNTAINS Demo 1.2 Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Added sprinting (Hold L2 on controller, shift on keyboard)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added tutorial for movement and sprinting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added dog petting animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added counter for how many dogs you've pet",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added ability to skip opening messages (Godot logo, controller recommendation)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added ability to turn down or disable screen shake",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added brightness and contrast settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Tall grass can now be walked through",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Crates and barrels can be broken by rolling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Buffed a lot of enemies' speed to compensate for sprinting being added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Sword Guard and Spear Guard enemies now attack much more frequently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Slightly lowered water gained from hitting normal enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added more flamethrowers in tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Shortened opening cutscene text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made roll go slightly further",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Roll will no longer go in the wrong direction after attacking while using keyboard direction controls",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Quick item count now properly updates after picking up more of the item",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various stuck spots and out of bounds glitches: ... and some *secret changes*!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
