       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed ice mesh and collider on Arctic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rendering issues with certain objects in Forest and Desert",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed tag event becoming stuck forever",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some localisation files",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor UI touch-ups and fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed unused code, since we're not using it",
       "ps5ProOnly": false,
