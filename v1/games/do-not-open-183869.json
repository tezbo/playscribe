   "id": "do-not-open-183869@post-2022-12-27",
   "gameId": "do-not-open-183869",
   "displayName": "Bugs found, bugs fixed",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-12-27T20:09:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This new patch includes changes to the main menu to make it more visually appealing, as well as some bug fixes that made it difficult to play DO NOT OPEN correctly, for example: the sudoku puzzle was coming out too bright.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remember that we are very grateful if you can tell us about any bugs you find and/or ways to improve the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
