  {
   "id": "do-not-open-183869@major-2022-12-23",
   "gameId": "do-not-open-183869",
   "displayName": "New update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-23T11:34:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have fixed some minor bugs that, although they did not prevent the game from running smoothly, could cause confusion. For example: we have fixed a furniture that, when opening its doors, you could still see other doors underneath.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have also made the maze puzzle easier by increasing the number of errors required and improving the physics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will keep working on improving your experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
