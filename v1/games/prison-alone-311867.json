  {
   "id": "prison-alone-311867@major-2024-10-24",
   "gameId": "prison-alone-311867",
   "displayName": "Prison Alone: Content update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-24T18:44:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In this first update of Prison Alone, we focused on addressing the main requests made by the community! And we took the opportunity to add new content!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Check out the list of improvements",
     "items": [
      {
       "text": "Autosave and load game system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Steam Cloud Save",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Option to turn off realistic font for letters and documents",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Replacement of 13 out of 20 letters to better explain the story",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Repositioning of all letters and documents on the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Deactivation of already collected letters and documents",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Now half of the cells will remain locked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Footstep volume reduced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Player speed slightly increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "High and Low graphic quality options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Visual improvement of the Control Panel puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Korean language added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More blood, more monsters, and more strange events!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
