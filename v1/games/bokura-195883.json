  {
   "id": "bokura-195883@0.3.0",
   "gameId": "bokura-195883",
   "displayName": "Update 0.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-12T07:26:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is tokoronyori.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I hope you are enjoying『Bokura』",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There were reports in the disscussions and reviews of matching issues and lag.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have been planning and working on a fundamental revision of the network system used in the game in order to solve the problem, and this update should fix these issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I hope this leads to a more comfortable playing environment for everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "－－－－－",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ver 0.3.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "〇System update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Stabilized network environment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added region selection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addressed the problem that prevented matching under certain environments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "〇In-game changes/adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・A mute icon will be shown when the players begin separate activities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "★Regarding region selection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The default setting 'AUTO' automatically selects the most suitable region.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you want to be matched with a player who is far away from you (e.g. from a different country) or if you cannot be matched using AUTO, select a specific region together.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
