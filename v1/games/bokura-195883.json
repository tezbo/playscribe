  {
   "id": "bokura-195883@0.2.3",
   "gameId": "bokura-195883",
   "displayName": "Update 0.2.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-16T10:33:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone, this is tokoronyori.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have another update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is related to what we received in the discussions forum that prevented the game to progress and a little update to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "－－－－－",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ver 0.2.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where \"the other\" player kept on drowning: Game update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a scene at the start of the second playthough to better understand the \"intent\": －－－－－: I am aware of some matching & network issues, and I am currently revising the system to try to fix this problem.: Due to how the game is built, the game has to be played between the same version.: If two different versions are connected, the host (purchased version) will receive the error message: “App version mismatch. Update to latest version”: If this appears, please enable Steam auto-update and restart Steam before playing the game.: Thank you again for your continuing support for Bokura!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
