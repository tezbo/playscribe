   "notes": [
    {
     "title": "SUMMARY",
     "items": [
      {
       "text": "This version focuses on gameplay balance, player progression, and the optimization of close encounter mechanics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "GAMEPLAY & ABDUCTION MECHANICS",
     "items": [
      {
       "text": "• SAFETY THRESHOLD ADJUSTMENT: An initial grace period has been implemented; abduction probability will now only trigger after the FOURTH PHOTOGRAPH.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• EVENT VARIABILITY: Abduction duration has shifted from a fixed value to a RANDOMIZED SYSTEM, allowing for shorter or more prolonged encounters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• PHOTOGRAPHY IMPROVEMENTS: The SAFE DISTANCE range for photographing the alien has been increased, allowing for valid captures from further away.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "MOVEMENT & PROGRESSION",
     "items": [
      {
       "text": "• MOVEMENT SPEED: The player's base SPRINT SPEED has been increased to improve responsiveness and evasion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "• EXPERIENCE (XP) REBALANCING",
     "items": [
      {
       "text": "General increase in XP gains for standard actions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional XP bonus granted after successfully completing an abduction sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
