  {
   "id": "hot-wheels-unleashed-144072@patch-2021-10-13",
   "gameId": "hot-wheels-unleashed-144072",
   "displayName": "New Patch Available, introducing additional functionalities and general fixes!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-10-13T09:44:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new update for #HotWheelsUnleashed is now available! Discover additional functionalities, fixes and new filters to easily find the best Tracks and Liveries created by the Community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Check it out: https://hotwheelsunleashed.com/game-updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added some filters to the Community Tracks and Liveries.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added shortcuts to the Store and Collection in the “Hot Wheels City Rumble” menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Improved UI for the “Add-ons” page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added new functionalities to the news box in the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added support for the “Racing Season”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed some bugs to improve stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Minor fixes to the UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
