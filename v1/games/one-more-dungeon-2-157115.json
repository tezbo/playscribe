  {
   "id": "one-more-dungeon-2-157115@0.6",
   "gameId": "one-more-dungeon-2-157115",
   "displayName": "Update 0.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-05-02T15:09:29.000Z",
   "notes": [
    {
     "title": "Changelog",
     "items": [
      {
       "text": "A system for gaining experience and leveling up a character has been added;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The hub has been completely redesigned;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New class - Warlock;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a fourth boss;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The inventory screen has been redesigned;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New special rooms and interactive objects;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Now you can purchase insurance before the boss battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several new items;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lots of small changes and fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
