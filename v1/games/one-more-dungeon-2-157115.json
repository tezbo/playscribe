  {
   "id": "one-more-dungeon-2-157115@0.3",
   "gameId": "one-more-dungeon-2-157115",
   "displayName": "Update 0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-10-07T15:26:35.000Z",
   "notes": [
    {
     "title": "Changelog",
     "items": [
      {
       "text": "The third area of the dungeon, with a new environment, traps, enemies and a Boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved behavior of some enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a class system. At the moment, there are three basic classes available - Stranger, Wizard and Warrior, each with its own unique skill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Expanded hub location. Added a Merchant Tent that allows you to buy items before going into the dungeon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added flooded areas on levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New negative effect - Burning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Dark Idols are objects that appear on levels and apply a negative effect until they are destroyed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lots of minor fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
