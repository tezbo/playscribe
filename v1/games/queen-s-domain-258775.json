  {
   "id": "queen-s-domain-258775@1.0.1",
   "gameId": "queen-s-domain-258775",
   "displayName": "Hotfix 1.0.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-12-05T10:30:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Huge thanks to everyone who tried out the demo yesterday, doing our best to fix the bugs you've found so far!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that caused enemies killed before death to not respawn on continue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Possible fixes for a crash bugs - we haven't been able to repro these locally but have tried a couple potential fixes based on crash logs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed life point display rounding error",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a typo in roasted ojum lizard item description",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed sticky sprint bug when falling in water",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where description in bestiary couldn't be scrolled with controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where life charm life point increase wasn't applied when loading a saved game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
