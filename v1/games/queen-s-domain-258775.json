  {
   "id": "queen-s-domain-258775@1.01.04",
   "gameId": "queen-s-domain-258775",
   "displayName": "Patch 1.01.04",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-11-06T05:50:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed certain weapons counting towards Extensive Armaments challenge that were not supposed to.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added missing throwing weapon type: Grave Knife. Available in the open chest near the middle of the Tower of Knowledge. Fixed Ring of Wind counting towards Versatile Volley challenge when it was not supposed to.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made secret door that concealed the Pandora Blade count towards Concealed Passages challenge and added a hint for finding it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added options to make some late game puzzles less frustrating.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated status effects guide with icons to make it easier to understand which status is which visually.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several graphical, audio, collision, and general bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix getting stuck behind statue at queen's grave.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix soft lock from resting multiple times in a row with specific timing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed return point from falling into water on several moving objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where Steam Cloud saves didn't restore properly when switching devices after a crash.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Updated controls when scrolling a list using digital inputs: left/right inputs now scroll a full page at a time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added option to disable screenshake.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix for Herald of Okbujo death animation that made very difficult to talk to them after the fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for talking to shopkeeper behind counter dialog getting stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Dagoom the Sea King poison ring remaining forever",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
