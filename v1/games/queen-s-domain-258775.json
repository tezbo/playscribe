  {
   "id": "queen-s-domain-258775@1.01.06",
   "gameId": "queen-s-domain-258775",
   "displayName": "Patch 1.01.06",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-11-12T07:41:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fix for Flying Sword challenge getting stuck in incomplete state.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Challenge data now works with Steam Cloud Save.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved error recovery when challenge save data is missing or corrupted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Save backup system is now more robust.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several graphical, audio, collision, and general bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some issues in the bestiary.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several issues with weapon evolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The boss of the Deimpo Mausoleum has been rebalanced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue causing a mid-game enemy to deal far more damage than intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several issues causing bosses to disappear during fights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with Wodaso's Holy Lightning causing input issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue causing some weapons to mix up their secondary attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted behavior of a few late game enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a few more minor input issues with weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rebalanced Dream Weaver's Colossal Syringe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue with some weapons interrupting the Holy Storm Ultra Attack animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues preventing several in-game guides from being granted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue causing some moving platforms to get out of sync.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several issues with enemies dying in midair.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue causing Sipeha's Void Maul secondary attacks to fail to deal damage to certain enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added some redundant checks for certain key items and world states.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue rarely causing obstacles in the library to fail to be cleared. This fix is retroactive, and should grant any missing achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where pressing interact in certain dialogue boxes could cause major issues with game state.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue causing a slow buildup of some screen effects, which would slow the game down over long play sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some issues with weapon XP being granted to the wrong weapon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a pushback effect while larger bosses are dying to prevent the player from getting stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added input bindings for Bestiary, Challenges and Guide menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added input bindings to toggle the compass and the HUD.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue with the framerate limit option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
