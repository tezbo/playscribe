  {
   "id": "manifold-garden-13621@1.1.0.17370",
   "gameId": "manifold-garden-13621",
   "displayName": "Patch 1.1.0.17370",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-08-31T22:32:55.000Z",
   "notes": [
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed bug where pressing the \"Steam\" button on the Steam Deck caused the gyroscope position to be reset, resulting in inability to take screenshots while using the gyroscope photo mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed bug that caused certain Restore points to be hidden. The restore points were being saved properly, but were not shown in cases where the number of seconds in the time played was zero (not the TOTAL seconds played, but the seconds of the timestamp). Since the default autosave period was set to 3 minutes, these auto-save entries would always end in zero eg 3:00, 6:00, 9:00 and were being incorrectly hidden.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the \"Capture\" button on Steam Deck since it isn't applicable on this device. It saved the file to the C drive which is not accessible to the user.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
