   "announcedAt": "2021-04-20T20:47:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Performance and Stability Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
