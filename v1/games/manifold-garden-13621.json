  {
   "id": "manifold-garden-13621@1.1.0.14704",
   "gameId": "manifold-garden-13621",
   "displayName": "Patch 1.1.0.14704",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-11-11T17:24:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed issue where users would get stuck on a blank credits screen after the ending",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed localization issue in control remapper",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed loss of focus when resetting the gameplay panel while colorblind options are selected with controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some tutorial keys displaying off-center",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added option for slow draw in the settings file for users experiencing invisible cubes. Players can now edit settings.txt file and addthe line \"slowdraw 1\" to permanently enable alternate rendering.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The opening start screen background now shows different levels depending on player progress in the most recent save on startup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Photo mode correctly saves DOF and Manifold Garden Logo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "900 level missing colliders are fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TOGGLE PHOTOGRAPHY MODE remap menu is localized correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Opening the debug console doesn't disable achievements unlocking. Only using a selected list of commands disables achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
