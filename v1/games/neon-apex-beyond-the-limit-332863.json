  {
   "id": "neon-apex-beyond-the-limit-332863@major-2025-05-23",
   "gameId": "neon-apex-beyond-the-limit-332863",
   "displayName": "Update notes for May 23",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-23T08:35:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've heard your feedback and made a few adjustments to the game in this first update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaked the visuals to improve clarity and reduce distraction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced intensity of collision VFX.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Disabled the camera angle change at the start of race and when activating nitro for the first time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Modified the AI behaviour to improve the overall racing experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the vehicle physics on cars and bikes to improve handling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made collisions with barriers and other vehicles more predictable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the amount of Nitro replenished when drifting or colliding with traffic cars in race.: Further updates coming shortly, but let us know what you think, how you feel the game could be further improved, or any other general suggestions and we'll get on to it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
