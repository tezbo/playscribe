  {
   "id": "serious-sam-shatterverse-396022@3",
   "gameId": "serious-sam-shatterverse-396022",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-01T15:56:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi folks,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We have a quick hotfix ready for you today. Changelog below",
     "items": [
      {
       "text": "All pings done by others in multiplayer sessions would register as ping from the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Challenge Rooms could fail to load for clients in multiplayer sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weapons could reload multiples times in a row when coming out of Dual Wielding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A crash could occurs while fighting Inverse Sam and skipping his cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A UI element could show the wrong price when viewing Intel in the shop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated Credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
