  {
   "id": "serious-sam-shatterverse-396022@major-2026-10-19",
   "gameId": "serious-sam-shatterverse-396022",
   "displayName": "Update Notes | Dec 19, 2026",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-19T16:14:39.000Z",
   "notes": [
    {
     "title": "CHANGELOG",
     "items": [
      {
       "text": "Health and armor pickups dropped by enemies in coop session are now consistently visible to all players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The challenge portal no longer states that there are enemies nearby despite none being alive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players are no longer able to make a Melee Bash at a greater distance than on the Melee Finisher Intel description.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The portal in the Cathedral now disappears when entering the arena.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Sketchy Sam's ultimate no longer allows the player to phase through raising elevators.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Zombies are reacting sooner to the player’s presence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Reptiloid Spell Book will no longer turn invisible after being swapped while charging a Laser Pistol.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Highlighting newly acquired trinkets no longer causes equipped trinket highlights to go away.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Navigating through the Trinket equipment interface no longer causes the exclamation toast on the Trinket to move randomly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Selecting any option using the Enter key in the “Settings” tab no longer automatically opens a window that allows Player to reassign a random key binding.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Alien Sam's Reptiloid Endurance now appears as a Boon instead of an Intel in the player's inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
