  {
   "id": "a-red-walking-robot-276712@post-2025-09-28",
   "gameId": "a-red-walking-robot-276712",
   "displayName": "A-RED Walking Robot joins the Steam Autumn Sale (27% OFF)",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-28T21:47:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "🍂 AUTUMN SALE — TURN THE KEY, NOT YOUR WALLET",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The workshop doors are open and the price just clicked down a notch: A-RED Walking Robot is 27% OFF from September 29 to October 6.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Why this is the moment to jump in",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Physics-first platforming: cans roll, planks wobble—every push is a puzzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jet-pack & electricity: glide across shelf-to-shelf gaps and reroute power to open paths.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "300+ facial expressions: read A-RED’s mood straight from his face-screen—no HUD needed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Award-winning indie charm with a retro workshop vibe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Play it, laugh, then… tell the world",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If A-RED makes you smile (or scream), please drop a Steam review—every review winds our little robot a bit further and helps new players discover the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also on consoles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛒 Buy now on Steam (27% OFF): [dynamiclink href=\"https://store.steampowered.com/app/2659840/ARED_Walking_Robot/\"]",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "📺 Watch the launch trailer: [dynamiclink href=\"https://www.youtube.com/watch?v=rekPDaukhig\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "💬 Check our users reviews and write your own review: [dynamiclink href=\"https://store.steampowered.com/app/2659840/ARED_Walking_Robot/#app_reviews_hash\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sale window: Sep 29 → Oct 6. See you in the workshop!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
