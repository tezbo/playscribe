  {
   "id": "atelier-resleriana-the-red-alchemist-the-white-guardian-318001@1.3.0",
   "gameId": "atelier-resleriana-the-red-alchemist-the-white-guardian-318001",
   "displayName": "Update 1.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-20T04:07:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Added support for additional content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added the highest difficulty level, \"Legendary.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added the \"Extra Tree,\" which allows characters' stats to be further enhanced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added the \"Ingredient Grouping\" feature to the basket and container.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted the basket and container to group Catalyst Ingredients into one slot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added \"Amount in Inventory\" as a sorting option when selecting items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added \"By Rank\" as a sorting option when selecting ingredients during synthesis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted sorting to respect previous sort order when applied.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted cursor behavior during filtered list display.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted filter settings to persist until the product shelf screen is exited when selecting products during shop management.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted the skill selection screen to display burst skills during Unite Burst.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Set the maximum amount of AP that a skill can consume to 100.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted the upper limit of \"Critical Damage Up\" to 300%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted the abilities of some items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed incorrect item sorting in the Guide.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue where the timeline prediction did not display correctly until after the cursor was moved when selecting Totori's \"Duplicate\" skill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed Item Mix being calculated as a skill instead of an item.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed the \"Critical Damage Up\" effect not applying correctly for some items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that caused purple objects to sometimes be displayed during battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed other minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
