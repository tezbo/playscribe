  {
   "id": "atelier-resleriana-the-red-alchemist-the-white-guardian-318001@1.2.0",
   "gameId": "atelier-resleriana-the-red-alchemist-the-white-guardian-318001",
   "displayName": "Update 1.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-30T01:33:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Added support for additional content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted the filter function so that when an option is already selected, only relevant options will be displayed for other categories.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Improved the encyclopedia's material tracking feature to take into account gathering rank and time of day, tracking only \"obtainable targets.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Enabled bulk selection by holding the confirm button and moving the cursor when delivering investment items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Adjusted precision guard to withstand KO from multiple-hit enemy attacks when HP is above 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Made it possible to skip day/night transition animations by pressing the confirm button or similar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Updated the calculation formula for traits that reduce AP consumption to align with the formula for AP consumption increase.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue where after viewing the event \"After the Festival\" in chapter 9, the game would stop when the recipe acquisition animation played.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug in Skyglow Path where wire action indicators appeared when wire actions couldn't be performed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed an issue where dummy text would appear after acquiring all fairy blessings in dimensional paths.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Other minor adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
