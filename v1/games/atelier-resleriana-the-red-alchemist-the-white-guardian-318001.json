  {
   "id": "atelier-resleriana-the-red-alchemist-the-white-guardian-318001@1.3.1",
   "gameId": "atelier-resleriana-the-red-alchemist-the-white-guardian-318001",
   "displayName": "Update 1.3.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-26T01:45:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "• Fixed a bug that made progression impossible when all enemies were defeated just before Sophie used the item \"Magician's Flute\" during a Multi-Action.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that caused the effects of \"Strong Alchemy Fibers,\" \"Snowflake Crystal,\" and \"Heavenly String\" not to be applied correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that made grouped ingredients unable to be discarded with \"Discard All.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that sometimes caused \"Encounters with Resna\" and \"Encounters with Valeria\" not to appear in \"Episodes\" under \"Quests.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug that sometimes caused the camera to be unable to be controlled immediately after placing a character in Photo Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed other minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
