  {
   "id": "the-empty-desk-333612@post-2025-03-02",
   "gameId": "the-empty-desk-333612",
   "displayName": "Adjusted object scales and other details",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-02T23:56:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I have corrected the scale of certain objects that were not properly proportioned to the protagonist.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, starting from this version, the game will launch without English and German voices by default. This is because some players are sensitive to AI-generated voices, which can affect their immersion or interest in the story. Out of respect for this part of the audience, I have set only sound effects as the default option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For those who enjoy the voices, don’t worry! You can still enable them anytime in the game settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
