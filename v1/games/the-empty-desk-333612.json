  {
   "id": "the-empty-desk-333612@post-2025-02-18",
   "gameId": "the-empty-desk-333612",
   "displayName": "PLAY YOUR WAY!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-02-18T18:52:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Throughout the chapters, there are certain moments where unexpected scares may appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can play with the scares enabled or without them—it's your choice. If you enjoy the thrill of the unexpected, keep them on. But if you don't like jump scares and prefer to focus on the story, you can disable them for a more immersive experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
