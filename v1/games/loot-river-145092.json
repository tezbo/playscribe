  {
   "id": "loot-river-145092@major-2022-12-14",
   "gameId": "loot-river-145092",
   "displayName": "Loot River Development Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-14T13:24:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I know it was some time since our last update - and I apologize.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't worry, we are still working on Loot River! Sadly our currently planned update is just a little bit bigger than expected and takes a little bit more time than we anticipated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are working on a Level Editor - design your own levels in game and share them with other players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hoped to bring this to you before Christmas, but it seems we might just need a little bit longer to make sure everything works as it's supposed to.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned and have a great holiday,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Miro and Loot River Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
