   "displayName": "Update 1.0.65",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-05-13T09:49:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "player can now 'walk' out attack animations a little bit sooner, so you should have a more control and faster response in combat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "if one of equipped spells is Leap, mana slowly regenerates until you are able to use it again, to prevent getting stuck on otherwise inaccessible platform",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "player can no longer teleport to backstab position with Backstab Charm using long range weapons such as Panopticon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Backstab Charm not only positions the player, but also parents them to appropriate platform",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
