  {
   "id": "loot-river-145092@1.0.8",
   "gameId": "loot-river-145092",
   "displayName": "Update 1.0.8",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-06-19T17:33:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Leaderboards - Best times in both Victory and Escape mode are recorded now - if the time is achieved in New Game +, the entry has a little + sign as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Animation adjustment: when an executed enemy falls down and doesn't die, it plays get up animation instead of blending into idle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lowered knockback across all weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed several enemy outline issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Trade Off Charm imbalance - critical damage is now properly multiplied",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed scaling issues of dropped loot icon when dropped in certain areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Backstab Charm teleporting player on the second attack instead of the first",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed parrying on Laser Mage Knights",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
