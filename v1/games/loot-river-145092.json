      },
      {
       "text": "Fix for seed 9555809 and related, where progression was impossible due to First City layout generation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for UI interaction prompt occasionally not disappearing during cutscenes",
       "ps5ProOnly": false,
