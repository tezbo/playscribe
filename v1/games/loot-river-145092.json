  {
   "id": "loot-river-145092@major-2022-08-29",
   "gameId": "loot-river-145092",
   "displayName": "Daily Runs Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-08-29T13:52:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added Daily Runs: Daily Runs can be started from the Load menu after securing at least one Victory or Escape",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reworked level loading system: Loading should be a bit faster now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Entrance to the Divide becomes auto unlocked after some time: Many users have trouble finding Karla and the Divide, so now this area is accessible after several runs even without having Gantley in the level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where Mod that prevented Extended Spears was not working",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where item drop would sometimes not have a visible sprite",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where player could be soft-locked if an unreachable Protector on one platform protected a Platform Locker enemy on another platform",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a visual bug where the Bat would have active shadow-mesh after death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a visual bug where the Protector range indicator would flicker after death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a visual bug where litter on elevated platforms was unaffected by light",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a UI bug where sometimes mouse position would select a button even if user is using keys/controller only",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
