  {
   "id": "loot-river-145092@1.0.63",
   "gameId": "loot-river-145092",
   "displayName": "Update 1.0.63",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-05-11T15:29:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "partial knowledge spend: you can add small amounts of Knowledge to the item or spell you wish to purchase over time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "laser mages now do a little taunt/warning move before the sudden melee attack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "chest rewards are now significantly better - there are no more coins in them, either item, or Knowledge, or both, and if Knowledge, there is more of it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "increased chance of finding already enchanted elemental weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "parrying no longer teleports you to the enemy; you make a fast dash instead",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "heavy attack now charges significantly faster with increased Strength: normal speed at 10 Strength, 5 times faster (almost instant) at 20 Strength",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "parried bombs from mages can now hurt enemies in blast radius",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
