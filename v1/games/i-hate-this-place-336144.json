      {
       "text": "Added key remapping function;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved streaming spikes in order to prevent falling under the map;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed display weight while the shed is open;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed world pop-ins;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
