   "id": "tempus-192223@1.3",
   "gameId": "tempus-192223",
   "displayName": "Patch 1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-04-20T16:41:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Change in the system of grabbing objects. Now, the hands disappear and the object does not teleport towards them, achieving a more natural grip sensation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The grappling distance has been changed to be able to grab objects on the ground more easily.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collisions have been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the way the options menu appears and it now follows the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several bugs have been corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
