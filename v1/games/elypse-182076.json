  {
   "id": "elypse-182076@1.0.8",
   "gameId": "elypse-182076",
   "displayName": "Patch 1.0.8",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-05-25T13:42:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone, 📢",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So here's a new important patch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This one is here to discard what was our \"assist mode\" and change it into \"Difficulty Settings\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Among other bugs fixes, we also patched the resolutions issues and 4K is now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚙️ Patch note Elypse 1.0.8 ⚙️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolution issues fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4K is now available",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Difficulty settings added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nyx not following Fay anymore corrected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some killzones and colliders adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game duration statistic issues fixed: Thanks for following and supporting our work, we are doing our best to adapt to your feedbacks.: Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hot Chili Games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
