  {
   "id": "elypse-182076@1.7.0",
   "gameId": "elypse-182076",
   "displayName": "Patch 1.7.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-05-19T14:57:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone 📢",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are super happy that Elypse released 🎉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And with every release, comes stuff that breaks so here's the first patch of correctives from what you've been reporting 👀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch note",
     "items": [
      {
       "text": "Visual bug during big platform elevator fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Elevator reset bug fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial input has been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Possibility to get out of the map in the Surface fixed: We will come back to you next week with another patch that concert more minor bugs like resolution issues reported.: You support us by playing Elypse, we support you by correcting the issues you find 😉: See you next week for another patch! 🎮: Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hot Chili Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
