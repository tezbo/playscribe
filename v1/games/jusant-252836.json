  {
   "id": "jusant-252836@1.02.1431188",
   "gameId": "jusant-252836",
   "displayName": "Patch 1.02.1431188",
   "kind": "dayOne",
   "kindBasis": "studio",
   "announcedAt": "2023-10-31T15:23:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Jusant is finally out, and we’ve put together a day one patch to introduce some improvements for smoother sailing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "ANIMATION",
     "items": [
      {
       "text": "Improvements on the jump mechanic feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements on zipline animations to add idle movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several improvements on gameplay animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Retakes on cutscenes animations to better reflect creative intentions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "ENVIRONMENT",
     "items": [
      {
       "text": "Improved environments in all cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
