  {
   "id": "jusant-252836@1.06",
   "gameId": "jusant-252836",
   "displayName": "Patch 1.06",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-02-08T11:04:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello climbers! Here are a few quick fixes we’ve made to ensure smoother sailing in Jusant.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Tech",
     "items": [
      {
       "text": "DLSS 3 added",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "VSync is now correctly disabled when activating Reflex or FrameGeneration",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Qualities not supported by hardware will be removed from the list",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DLAA quality has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other fixes",
     "items": [
      {
       "text": "Fixed Out of Memory crash when wind particles accumulate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed line breaks in letters (for French language)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added missing walking SFX for lizard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Achievements ‘Acrobat’, ‘Fresh Air’ and ‘Restored Connection’ should now be handled properly with reload and unlocked properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that prevented players to “Continue” their save, after completing and starting a new game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
