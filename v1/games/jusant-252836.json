  {
   "id": "jusant-252836@1.04",
   "gameId": "jusant-252836",
   "displayName": "Patch 1.04",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-21T11:20:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello climbers! Before we get into the patch notes, we wanted to give a big thank you to all players who have taken the time to leave feedback or a review of Jusant.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve titled this patch The Accessibility Update, as many new accessibility features have been added as well as bugfixes (ultrawide players, rejoice!) and quality of life changes of course. We’re pleased to welcome even more players to the tower with this update.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Accessibility additions",
     "items": [
      {
       "text": "Simplified Climbing Mode (instead of triggers, only the joysticks are used)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Alternate Rappel Mode and tutorials",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Simplified Interactions Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Jump Assistance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "No Stamina Mode (stamina mechanic can be deactivated)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Color Blindness options and intensity sliders (Deuteranopia, Protanopia, Tritanopia)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Animation",
     "items": [
      {
       "text": "• Improved shaky movements performed by the character during climbing and",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "when the rope is at maximum",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Improved character’s hand location on grips",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Improved multiple broken animations when jumping over several assets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed grass animation clipping through assets in chapter 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed Ballast clipping through character’s head during climbing and gripping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed animations on peebles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed the possibility to bypass the rope wind tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a possibility to get stuck at the top of a ladder",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Corrected character’s hands location on the gear in chapter 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Improved interactions with the relays",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed misplaced foot during game ending cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed wallrun animation missing when rope is at its maximum",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Improved out of bounds falling issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed jump animation after exiting seashell cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Improved wind’s interaction with character’s hair and poncho",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Environment",
     "items": [
      {
       "text": "• Fixed several missing collisions in environment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed invisible collisions in several parts of the environment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay Programming",
     "items": [
      {
       "text": "• Bluetooth now recognized for Dualshock 4 and Dualsense",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Collectibles now saved when starting a new game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed the missing peebles in biome 2 in a specific area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed the partly cut-off screen loading symbol on lower resolutions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed control option to invert X and Y camera axis when using mousepad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed remapping issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Language can now be changed from system’s default language",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Resetting default language to OS language is fixed for FR, IT, DE, PL, JP, KR, RU, ZH-Hans",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Improved ziplines and related rope",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Improved performance drops and FPS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed gamma submenu “back button” navigation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Cinematics and gameplay transitions in ultrawide won't stretch the image for one frame",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Ultrawide won't crop and zoom image in 21:9",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Lighting",
     "items": [
      {
       "text": "• Improvement on lighting at the end of biome 2 observatory cinematic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Camera",
     "items": [
      {
       "text": "• Fixed several incorrect camera zooms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Improved camera clipping through walls and character",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed incorrect camera location when reloading biome 3 checkpoint",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "UI",
     "items": [
      {
       "text": "• Fixed UI overlaps issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed prompts that used to hide climbing path",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Tech and Performance",
     "items": [
      {
       "text": "• Added auto HDR settings on XSS & XSX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added motion blur scale settings on all platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added DLSS3 settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed physics optimisation on low specs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed autodetection of graphics settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Audio",
     "items": [
      {
       "text": "• Fixed elevator SFX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed footsteps material",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Design",
     "items": [
      {
       "text": "• Fixed character stuck in several parts of environment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed UI tutorials remaining on screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed inconsistencies between credits from main menu and game ending",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed grappling hook interaction in chapter 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed the manual stamina spamming that was leading to unlocking the Fresh air achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• No more delay on Ballast loading after a continue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed various visible macros in texts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed lizard clipping through chapter 4 - mountain",
