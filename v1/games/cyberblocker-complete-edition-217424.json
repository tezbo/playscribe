  {
   "id": "cyberblocker-complete-edition-217424@1.3.1",
   "gameId": "cyberblocker-complete-edition-217424",
   "displayName": "Update 1.3.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-30T05:38:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ver 1.3.1 アップデート",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "多言語対応しました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "中国語簡体字/繁体字、ロシア語、スペイン語、ポルトガル語、ドイツ語、フランス語、韓国語",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Web翻訳ですので細かいニュアンスが違うのはご了承ください。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "チャレンジモードACT-6にてボールが残っている状態でミスするとプレイ出来なくなる問題を修正。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "その他細かい変更を行いました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ver 1.3.1 Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Multilingual support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simplified/Traditional Chinese, Russian, Spanish, Portuguese, German, French, Korean",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that the translation is web-translated, so minor nuances may be different.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where players could not play if they made a mistake while the ball was still in the air in Challenge Mode ACT-6.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor changes have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
