  {
   "id": "cyberblocker-complete-edition-217424@2.0.5",
   "gameId": "cyberblocker-complete-edition-217424",
   "displayName": "Update 2.0.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-27T15:44:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42843656/646644c0bcaf66078dda1397623a1905f9eebda4.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ver 2.0.5 Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated to use the same scoring system as the console version. Scores now increase for faster clears.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated title screen button graphics to match the console version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Challenge Mode 5: adjusted so points can be earned repeatedly within the 500-point area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Swapped the priority of power-ups and enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stage 15 only: added processing to set the player ball priority to “Round” (so it renders in front of the dragon).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added “Standard mode / Classic mode” display to the Start button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new tracks to the Sound Test.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added auto-play feature to the Sound Test.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new sound effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Various minor fixes and adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ver 2.0.5 アップデート",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "コンソール版と同しスコアシステムに刷新しました。素早くクリヤするとスコアアップするように調整。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "タイトル画面のボタン画像をコンソール版と同じに変更。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "チャレンジモード5、500ポイントエリア内で何度も点数入るように変更。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "パワーアップと敵のプライオリティ入れ替えました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ステージ15のみ自機ボールのプライオリティをRoundにする処理追加(ドラゴンよりも手前に表示させるため)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Standard mode / Classic mode をスタートボタンに表示。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "サウンドテストの曲追加。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "サウンドテストの自動演奏追加。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "効果音を追加。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "その他、細かい修正を行いました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
