  {
   "id": "cyberblocker-complete-edition-217424@2.0.6",
   "gameId": "cyberblocker-complete-edition-217424",
   "displayName": "Update 2.0.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-29T08:35:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ver 2.0.6 Update / Ver 2.0.6 アップデート",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have implemented measures to address the recurring pattern issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We sincerely apologize, but the scores for Ver. 2.0.5 will be removed. We appreciate your understanding and apologize for any inconvenience caused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "永久パターン対策を行いました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "大変申し訳ありませんがVer 2.0.5のスコアは削除させて頂きます。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "お手数をおかけしますがよろしくお願いいたします。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
