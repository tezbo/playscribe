   "notes": [
    {
     "title": "Update 1.0 is now available",
     "items": [
      {
       "text": "Starting today, you can enjoy Update 1.0, focused on improving overall stability, multiplayer, and the experience from the very start of each match.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update includes important fixes and adjustments designed to make gameplay smoother, faster, and more stable across all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Main improvements in Update 1.0",
     "items": [
      {
       "text": "Improved the multiplayer system to prevent issues when joining more than three players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Refined the game start and character selection screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue that could cause characters to disappear when entering a new level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Faster automatic character recovery to keep the action flowing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Shortened the character join message and increased its blinking time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new option to exit the game from the mode selection menu on PC",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "We keep working to improve the game",
     "items": [
      {
       "text": "This is just one more step. We are actively listening to your feedback and continuing to work on new improvements and adjustments coming in future updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues, please do not hesitate to contact us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
