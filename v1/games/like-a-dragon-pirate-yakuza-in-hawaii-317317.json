   "id": "like-a-dragon-pirate-yakuza-in-hawaii-317317@1.14",
   "gameId": "like-a-dragon-pirate-yakuza-in-hawaii-317317",
   "displayName": "PATCH 1.14",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-15T01:09:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The following fixes have been made in Patch 1.14, which was released today:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug in the OKA Surfer customization screen where the NEW display would appear again every time the game was started.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in SEGA RACING CLASSIC 2 where some inputs were not being accepted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in the PC version where “Intel® XeSS Frame Generation” and “Intel® Xe Low Latency” could not be selected after patch 1.12.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We apologize for any inconvenience and appreciate your ongoing support for the Like a Dragon & Yakuza series.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
