  {
   "id": "like-a-dragon-pirate-yakuza-in-hawaii-317317@1.12",
   "gameId": "like-a-dragon-pirate-yakuza-in-hawaii-317317",
   "displayName": "PATCH 1.12",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-03-07T01:58:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Announcement of Patch 1.12 Release for Like a Dragon: Pirate Yakuza in Hawaii",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing Like a Dragon: Pirate Yakuza in Hawaii. We have released patch 1.12 today, which includes the following fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where manual saving was not possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where loading a save data on a ship under certain conditions would cause the player to fall into the sea and be unable to return.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the golden ball could not be obtained.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where arcade game rankings were not being saved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected various typographical errors and improved localization issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various other bug fixes to improve stability and quality.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated to Intel XeSS 2.0.1.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a rare crash issue that occurred during resource loading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The cause of random driver crashes on certain NVIDIA GPUs is still under investigation by the GPU vendor. It has been confirmed that setting a frame rate limit to 60 FPS reduces the likelihood of crashes. If you are experiencing frequent crashes, please try this solution.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Go to Settings > Graphic Settings > “Set FPS to 60”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
