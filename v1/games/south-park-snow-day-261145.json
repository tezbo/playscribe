  {
   "id": "south-park-snow-day-261145@major-2024-04-11",
   "gameId": "south-park-snow-day-261145",
   "displayName": "First update for SOUTH PARK: SNOW DAY! going live today",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-11T15:41:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The patch addresses various issues across all platforms. Please find the details for PC below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some stability issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a visual glitch of Henrietta in Kupa Keep for clients.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimized and fixed some issues for Danse with Ravenous Shadows.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some collision issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some AI issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In addition to the above, we are working on another update with fixes and improvements for all platforms and are aiming for a release in April.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For answers to some commonly asked questions, please visit the FAQ at the bottom of this page:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any bugs while playing, please report them via our community bug database:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Detailed bug reporting instructions can be found in the following Steam thread:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
