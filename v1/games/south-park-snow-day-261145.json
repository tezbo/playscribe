   "announcedAt": "2024-06-27T13:30:08.000Z",
   "notes": [
    {
     "title": "Today's patch includes the following fixes/additions",
     "items": [
      {
       "text": "Tightened up melee weapon hit areas and movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Targeting improvements to open loot containers from any angle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaked dodge cooldown period to increase player feedback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added aiming friction and light targeting assist to the bow & arrow for controllers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Collision issues were fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Snowball cards in Butter’s Book Law is fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cosmetic: Skinny Cartman hat was added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
