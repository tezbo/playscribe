  {
   "id": "bunny-reversi-119535@2",
   "gameId": "bunny-reversi-119535",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-06-27T10:03:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The previous update provoke a new bug that happened when kick the bot and almost simultenously make a move + overlaping him - actually there are couple of bugs connected with these events (thanks to @Indelacio.co.uk for the vid).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We fixed that - at least we couldn't reproduce it anymore after fix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also we rearrange the pause menu so you could see the menu in the bottom above the exit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
