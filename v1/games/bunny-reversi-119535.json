  {
   "id": "bunny-reversi-119535@3",
   "gameId": "bunny-reversi-119535",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-07-11T09:36:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed bug when you accept Steam invitation when you are playing with Bot, then joining your friend, the game mode didn't change to host's ones. It caused wrong achievement issues on client.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Also now after accepting invitation you will see friends name you are going to join.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
