   "gameId": "bunny-reversi-119535",
   "displayName": "Update 4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-07-29T09:23:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We made SOS button more visible - so if you stuck somewhere - just press it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now if the bot stucks in a place where he couldn't move or swim and it's his turn to play now - he will be teleported to his default location and then will go to play. Before this fix you should come to his default location to manually teleport him back - but few knew about it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
