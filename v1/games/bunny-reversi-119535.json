  {
   "id": "bunny-reversi-119535@1",
   "gameId": "bunny-reversi-119535",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-06-24T21:15:26.000Z",
   "notes": [
    {
     "title": "General changes",
     "items": [
      {
       "text": "if you kicked IamBot so he lost his mind and forgot about his turn come to him to awake. Also we added additional check when IamBot come to conscious he will try to check if it's his turn. If it doesn't help - let us know",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "now if it is not your turn and you are not on the gameplay field you won't hear the error sound",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "changed the background image for the hint line in disk customization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Split-screen changes",
     "items": [
      {
       "text": "now if you press SOS then both of players will be teleported to the start location",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "when choosing a character the first focus for controller will be on the Bunny Boy - not on the finished button",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added on-screen hints for controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
