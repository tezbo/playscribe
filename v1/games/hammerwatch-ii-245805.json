  {
   "id": "hammerwatch-ii-245805@3",
   "gameId": "hammerwatch-ii-245805",
   "displayName": "Patch 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-25T15:19:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we've released a minor patch to address some issues people have encountered, particularly long loading screens and crashes when leaving certain locations. As an FYI, we're also working on a larger future patch to correct quest issues that some people are encountering and more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some cases where loading would get stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a fairly rare crash related to text rendering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some issues with teleportation of player tombstones",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue when using items while being dead",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with scrolling in inventory when removing some items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare hard-lock where you could lose Lond's Stone",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected cooldown reduction on unique item Spellfingers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some inconsistencies with Warlock's Demonic Resolve",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Flame Shield description error",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, if you have any feedback or run into any bugs, please reach out on our Discord server!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your Crackshell and Modus teams",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
