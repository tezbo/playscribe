  {
   "id": "adventure-of-samsara-348638@2.0",
   "gameId": "adventure-of-samsara-348638",
   "displayName": "Update 2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-27T14:03:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In the post-launch update, players can take on a new optional boss, the “Buzz Killer Swarm,” a high intensity battle against three cybernetic insects. The update also expands exploration with new secret rooms, hidden pathways, invisible walls and hidden upgrades. Movement and Combat has been refined, giving players more fluid control of the Solar Champion. A new in-game Bestiary has also been added, allowing players to view detailed enemy entries, including images, names and descriptions of foes encountered throughout the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Additional content in the post-launch update includes",
     "items": [
      {
       "text": "Combat Overhaul – Combat and movement have been refined to feel faster and more responsive, making it easier to avoid enemy attacks by dashing, and to use health potions during combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Quality of Life Improvements – New improvements include full PC input remapping, clearer map labeling when new areas are discovered, and an extra option on the main menu allowing players to replay cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Boss and Enemy Rebalancing – Several boss and enemy encounters have been rebalanced, including difficulty adjustments to Athalos, as well as refined AI, movement behavior, attack patterns and damage logic for Dhar’klaw and Doctor Gwar’udum, resulting in more consistent and satisfying fights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bug Fixes and General Improvements – A range of fixes and polish updates have been implemented, including camera behavior during unlock sequences, resolved progression blockers and various balance tweaks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Gameplay Changes",
     "items": [
      {
       "text": "Adjusted input buffering, making it easier to avoid enemy attacks with dash or to use health potions during combat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Knockback logic changes - Post-hit invulnerability works against body damage, making it harder for the player to pinball between enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boss fights rebalancing: Athalos, Gwar'udum, Dhar'klaw, Argonian Defense System, and Gargantuan Slime",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy rebalancing: Armadillo and Frozen Spear Ghoul",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brand new boss added to Murky Pipeworks: The Buzz Killer Swarm!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Spells",
     "items": [
      {
       "text": "Flame Spikes - Creates a sequence of fire pillars in front of the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rune Bomb - creates a proximity rune that blows after some time or by proximity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New CURSED items that provide great benefits with some risky strings attached:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Necromancer’s Touch - Gauntlet item that reduces max health but drains enemy life on melee damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Cursed Mage Strength - Gauntlet item that reduces max health but increases max Mana",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Progression Changes",
     "items": [
      {
       "text": "Brand-new rooms and secret areas to explore - providing alternate paths and exploration routes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Murky Pipeworks' teleport can now be activated before reaching the Dead Complex",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Health upgrades from altars provide a smaller health increase, but more altars are added to the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Quality of Life improvements",
     "items": [
      {
       "text": "Bestiary provides image, name and description of all defeated enemies (accessible via pause menu)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved Map: Area names shown on the map after first room for the area is visited",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Control remap available through Options menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "“Extras” menu on the main menu allows players to rewatch in-game cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Myth lines from interacting with Monoliths can now be read on the altar inside the Orphic Crypt Teleporter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ending cutscenes are now longer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New “Adventure” Easter Egg ending, if Kosmonauto quest is completed before finishing game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Polish and improvements to enemy animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
