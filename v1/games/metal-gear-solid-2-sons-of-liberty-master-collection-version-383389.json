  {
   "id": "metal-gear-solid-2-sons-of-liberty-master-collection-version-383389@1.3.0",
   "gameId": "metal-gear-solid-2-sons-of-liberty-master-collection-version-383389",
   "displayName": "Update 1.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-15T08:35:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ver.1.3.0 is now available for users on all platforms!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Ver.1.3.0 Patch Notes",
     "items": [
      {
       "text": "Please check the list of changes below for details on the main improvements and fixes in this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where a \"Damaged File\" error was sometimes displayed when trying to load save data",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue affecting users who purchased the game in Japan where the English opening video would play even in the Japanese version of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the Online Manual",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed the \"Download\" section from the game launcher (Check here for our guide on how to install/uninstall the DLCs)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some other minor issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Issues Under Investigation",
     "items": [
      {
       "text": "We are investigating the issues below and working to resolve them. We will provide further details regarding fixes for these issues at a later time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue that results in the laser pointer effect not displaying in some cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue that causes the sea lice to be displayed incorrectly in certain scenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue to provide regular updates on future improvements and fixes as further details are finalized.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
