  {
   "id": "metal-gear-solid-2-sons-of-liberty-master-collection-version-383389@1.2.2",
   "gameId": "metal-gear-solid-2-sons-of-liberty-master-collection-version-383389",
   "displayName": "Update 1.2.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-30T09:55:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released a beta update that resolves the abnormal speed issue. However, as this is a beta update there is a possibility that it may cause other issues to occur, and as such, we ask for your understanding. If this happens, please opt out of the beta and revert to the original release version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Follow the steps below to opt into the beta.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Go to your Library from within the Steam Client and select “METAL GEAR SOLID 2: Sons of Liberty - Master Collection Version”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Right click and select “Properties”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select “Betas” and input \"Kh48El4ZdYfU5TdaMg\" into the bar under \"Private Betas\" section.: If successful, \"Opt into: beta - beta test\" will be displayed in blue underneath the bar.: The option to select \"beta\" from the dropdown menu in \"Beta Participation\" will then become available.: Once selected, the beta update will download.: You will be able to play the beta version once the download is complete.: To revert to the original release version, simply change “beta” back to “None” in the dropdown menu. Once the download reverting the beta update is complete, you will be able to play the original release version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For those who are tried and are using the temporary solution, make sure to reset the settings to the original settings first before launching the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
