   "displayName": "Patch 1.0.3a",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-08-06T22:41:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, everyone. We've received bug reports and we have fixed them. Check out what has changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.0.3a",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some dialogue lines have been fixed. They were showing code commands;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Solo Ending B - Unleashed Beast Ending has been fixed;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Guide 1.0.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The option \"Invite Ulfric to rest together\" has been removed from the guide. It's a choice only available in the NSFW DLC but it doesn't have any influence to unlock the endings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boris Ending A - The Warrior's Rest has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We really appreciate your feedback, especially Dragon's and Daddy Hyperion's ones sent on our forum topic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Male Doll Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
