  {
   "id": "i-am-your-president-96471@post-2023-02-28",
   "gameId": "i-am-your-president-96471",
   "displayName": "Squishing bugs",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-02-28T17:17:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Why so big?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some of you who use Windows 10N couldn't start scenario and were getting black screen. We made changes to cutscenes and it should fix black screen blocker at the beginning of the game for Windows 10N users.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's fixed/improved",
     "items": [
      {
       "text": "1. Removed exploit with infinite defunding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "2. Removed blocker caused by president notes appearing after certain law.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "3. Pen should not get in a cursor way when accepting or rejecting law.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "4. Added descriptions to locked map actions on map with info where to unlock them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "5. Removed duplicated question in questionnaire",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "6. Fixed conteractions in some laws.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "7. Removed some map events.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "8. Fixed changes per turn from projects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "What we know and working on",
     "items": [
      {
       "text": "Junky cursor on map with ui opened under map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disappearing map events.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Incorrectly calculated neighbours for countries for example: Great Britain.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's next (sneak peak)",
     "items": [
      {
       "text": "Removing map action upkeep per turn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
