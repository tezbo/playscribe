 "releases": [
  {
   "id": "spongebob-squarepants-the-cosmic-shake-171219@patch-2023-10-23",
   "gameId": "spongebob-squarepants-the-cosmic-shake-171219",
   "displayName": "SpongeBob SquarePants: The Cosmic Shake's Gen9 version and patch is OUT NOW!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-23T13:01:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "\"SpongeBob! SpongeBob! SpongeBob!\" The crowd is cheering, the cameras are flashing – it's time to become the hero Bikini Bottom needs! SpongeBob SquarePants: The Cosmic Shake is releasing on next-gen consoles today, including new features like photo mode, brilliant new costumes, and overall game improvements. Watch the trailer here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With all that fame and glory at hand, don't forget about the important part: SpongeBob and Patrick's shenanigans have caused magical WishWorlds to open up everywhere, and they are causing chaos throughout the city. What started out as harmless fun with magic Bubble Soap has turned into a cosmic catastrophe! But there's no harm in taking cool pictures in fun new costumes while on an adventure to save SpongeBob's friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Those who own the game already will get a free Gen9 upgrade.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional updates will be provided via patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All platforms (PS4, PS5, XB One, XB X/S, Nintendo Switch, PC):",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "New Feature – Photo Mode! Apply one of 19 different filters to enhance your pictures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Costumes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New costume \"King Doubloon\" for collecting all doubloons is now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New costume \"Plush Gary\" for unlocking all awards is now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a rare bug where saving stopped working.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the playtime did not pause while on a loading screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Many general bug fixes to improve stability and playability of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Watch the latest trailer on YouTube: https://youtu.be/xn0yv5raoDY",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Download the Assets: https://bit.ly/3QChUWT",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "SpongeBob SquarePants: The Cosmic Shake is available now for PlayStation®5, Xbox Series X/S™, PC, PlayStation®4, Xbox One, and Nintendo Switch™ at an SRP of € 39.99 / $ 39.99 / £ 34.99.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "The Costume Pack DLC is available for purchase at an SRP of € 9.99 / $ 9.99 / £ 7.99.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
