  {
   "id": "spongebob-squarepants-the-cosmic-shake-171219@1.0.5.0",
   "gameId": "spongebob-squarepants-the-cosmic-shake-171219",
   "displayName": "Patch 1.0.5.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-05-30T13:00:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added an end screen after completing the story featuring instructions on what to do next (complete challenges, unlock awards and new costumes, etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an \"auto-continue\" option for dialogues to the settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Additional fixes and improvements for voice overs during cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved several travel point positions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Speed runners: The playtime now continues during cut scenes and in the pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Speed runners: Fixed a bug with the playtime getting frozen when SpongeBob dies during dialogues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Speed runners: Added a configurable cumulative loading penalty to the options that gives the player a playtime penalty when loading a save game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved support for the Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
