  {
   "id": "bum-simulator-101320@1.09.02",
   "gameId": "bum-simulator-101320",
   "displayName": "Hotfix 1.09.02",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-09-16T08:43:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The second hotfix is here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Blue Mold Seed recipe to the workbench",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug that caused planted tobacco to load incorrectly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the amount of Bear Garlic you get from harvesting your planted crop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a bug that caused you to enter building mode when exiting the chest inventory screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the voice of the bug who guards your pigeon in the \"Bird Cage\" quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Showing the middle finger targets people in a cone area now, so you don't have to put your crosshair exactly on the target",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the appearance and placement of the cardboard used when begging",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the cloth physics of the player sleeve while begging",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused bugs to lay dead even if they were still alive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a missing quest marker during the \"Lady Justice\" quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that stopped the tracking of the \"Respect Among Creeps\" quest if you did a side quest while on this mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Carl now drops any unconscious body placed on top of him when the \"Let Me Hook You Up\" quest starts, to make sure the timer is visible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More stuff coming soon :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
