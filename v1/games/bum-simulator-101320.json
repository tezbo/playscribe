   "id": "bum-simulator-101320@3.7.12",
   "gameId": "bum-simulator-101320",
   "displayName": "Update 3.7.12",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-07-13T10:12:41.000Z",
   "notes": [
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Added Japanese translation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "The incoming raid window will no longer appear during cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the description for roasted apple and tobacco.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug that caused the effects of fruit salad to be permanent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the plant harvesting widget so it disappears correctly after harvesting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Big Guano Collector so it provides the correct amount of guano.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug that caused building catalog and workbench list selection to change if the inactive mouse cursor was over them.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the bug that caused some buildings to drop below 0 health instead of getting destroyed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug that caused the target practice side quests to trigger repeatedly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the \"Ghost Cop Who Crashes The Game\" bug (hopefully... you can never tell with ghosts).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
