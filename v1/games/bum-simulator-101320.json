  {
   "id": "bum-simulator-101320@major-2022-06-23",
   "gameId": "bum-simulator-101320",
   "displayName": "Next Update: 07/01/2022",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-23T15:31:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are still in the process of creating the main story content. It goes rather well and we are expecting to deliver the rest of the storyline this summer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the meantime, we have prepared a smaller update containing decorative items for your bum bases. It will go live on 07/01/2022.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hopefully, this will sweeten the waiting time :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
