  {
   "id": "bum-simulator-101320@3.5.17",
   "gameId": "bum-simulator-101320",
   "displayName": "Hotfix 3.5.17",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-05-18T10:17:39.000Z",
   "notes": [
    {
     "title": "Major",
     "items": [
      {
       "text": "The unlimited FPS option no longer caps your FPS to 60.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now set your frame limit to 30, 60, 90, 120, 144 FPS in both the main and pause menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that was seemingly assigning the 'E' to Move Backwards input. You should now be able to remap keys as expected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Prevent erroneous firing of the \"Hide and Seek\" quest after it was already finished.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clown Royale created in legacy Early Access saves will now work correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wooden Floors built by players will now spawn (and save) in the correct rotation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the bug that caused Walls and Floors to disallow disassembly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dissasembled buildings will now correctly return materials when the recipe required 1x of the item. (previously it returned a stack of 0)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Raids no longer happen on peaceful difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that locked the camera after drawing on cardboard in Build Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added quest markers to indicate the current step required in many Main Story quests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can now skip the entry cutscene when entering a certain warehouse.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Drawing on the cardboard is now less sensitive to diagonal input when using a gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Minor",
     "items": [
      {
       "text": "Bum Simulator now has its own icon, instead of the Unreal Engine one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the bug that prevented the Trash Can Lids from respawning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can no longer jump while dying.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the ratio at which cars honk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Pigeons in cages will now correctly display the applied costume.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an item duplication glitch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Raids will no longer fire during the alchemy tutorial.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced edge collision for player-built fences, you can now build them slightly closer to each other.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Minor fixes for the shooting range quests, when entered with Shuriken skill equipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a low-key audio cue to the begging input.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Pigeon Lady and Mr. Jello icons on the map are now more visible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Minor UI fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor localization and credits typo fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
