   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-05T08:28:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, everybody!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "I've released a small update. The list of changes",
     "items": [
      {
       "text": "1. Added “Restart level” button to the “pause” section.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Added new languages: Ukrainian, Kazakh, Romanian, Polish, Turkish, Hungarian, Dutch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Fixed a bug with WASD camera.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you all for your positivity! Still working.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have a good day and week!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
