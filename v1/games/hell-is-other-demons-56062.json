  {
   "id": "hell-is-other-demons-56062@post-2019-12-20",
   "gameId": "hell-is-other-demons-56062",
   "displayName": "Issue with save files resolved. Your data is safe!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2019-12-20T20:51:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some of you players are reporting that their old saves didn't carry over to the new patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This has now been resolved in a new patch. Your data is safe! Just restart steam, check that you get the new patch and the data will be imported into the first free save slot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The version number can be found on the main menu screen, top right corner. It should say \"2019-12-20 21:07\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Extra special thanks to ChronoQuote for reporting this issue with some data that helped us quicky solve the issue!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I'm very sorry for this confusion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep on slaying!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "/Hannes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
