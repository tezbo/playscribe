       "category": "new"
      },
      {
       "text": "Fixed bug in the market that made change the appearance of several NPCs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bug fixed in the Hotel when placing the camera in first person during the investigation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bug fixed in the market when placing the camera in first person during the investigation",
       "ps5ProOnly": false,
