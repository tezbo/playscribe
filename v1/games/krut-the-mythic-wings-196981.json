  {
   "id": "krut-the-mythic-wings-196981@0.1.0.4",
   "gameId": "krut-the-mythic-wings-196981",
   "displayName": "Patch 0.1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-08-17T03:37:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! We hope you've been enjoying Krut so far. We're bringing you an update with some bug fixes and addressed some feedback we've had about the balance of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes v0.1.0.4",
     "items": [
      {
       "text": "Added a new back roll move",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Chest Boxes now drop spirits for upgrade too",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted enemy HP and difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced the difficulty of enemies in early stages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved enemy's AI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced the cost of highest-level upgrade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased the damage power of some combo moves",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a bug where the mini-boss in lvl 1 is missing the 2nd attack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where player can take advantage of air dashing to become invincible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
