  {
   "id": "virgo-versus-the-zodiac-28772@1.1.3",
   "gameId": "virgo-versus-the-zodiac-28772",
   "displayName": "Patch 1.1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-07-01T09:00:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We discovered a game-crashing bug in patch 1.1.2 that would consistently occur right after the cutscene with Pisces and Ginger on the zeppelin.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The issue has already been fixed, and the version was updated to 1.1.3. Everyone should be able to progress through the game without encountering any issues at the end of chapter one. We deeply apologize for any inconvenience that this issue may have caused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a crash that was accidentally introduced in the previous version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
