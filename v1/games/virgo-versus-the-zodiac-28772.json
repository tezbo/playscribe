   "notes": [
    {
     "title": "Version 1.0.7 patch details",
     "items": [
      {
       "text": "Fixed a crash that would happen on startup if a corrupted save was present.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the wrong theme being played during a certain boss fight in Virgo realm.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the battle theme not transitioning properly during a certain boss fight in Taurus realm.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare crash that would happen when inspecting equipment after obtaining it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the “Best Friends Forever” achievement accidentally not being obtainable during regular gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed double Ginger in the Mushroom Grove.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed floating goat in Angular Plaza.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Aries and Gemini Turn Order Display.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
