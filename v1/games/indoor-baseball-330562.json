  {
   "id": "indoor-baseball-330562@major-2025-05-26",
   "gameId": "indoor-baseball-330562",
   "displayName": "Huge UPDATE to Indoor Baseball Demo!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-26T20:54:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "After working through the feedback from the Home Run Derby Demo, it's now time to update the demo to include some 1v1 baseball! Please try the game out again if you tried it previously and let me know what you think!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now the demo let's you play a 2 inning 1v1 baseball game against a friend or CPU in the living room. The home run derby game mode is still available to play too!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There will be another HUGE update to the demo next month for Steam Next Fest! It will include a preview of the Story Mode! So please try things out, let me know what you think, tell all your friends, and help me back the coolest indoor baseball game of all time!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PLAY THE INDOOR BASEBALL DEMO",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Colby",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
