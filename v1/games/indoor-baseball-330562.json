  {
   "id": "indoor-baseball-330562@major-2025-06-03",
   "gameId": "indoor-baseball-330562",
   "displayName": "Demo Update - Story Mode Preview",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-03T14:56:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Try the Indoor Baseball DEMO and play a preview of the Story Mode! After not making the school's baseball team, you are determined to practice to make the team next year. Watch cut scenes, play indoor baseball, home run derbys and mini games to progress through the story!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please let me know what you think, especially if you come across any issues. I will still be putting out more updates and improvement to the demo regularly :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TRY THE INDOOR BASEBALL DEMO",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Colby",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
