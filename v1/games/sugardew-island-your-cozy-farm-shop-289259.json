  {
   "id": "sugardew-island-your-cozy-farm-shop-289259@3747",
   "gameId": "sugardew-island-your-cozy-farm-shop-289259",
   "displayName": "Patch 3747",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-03-03T10:39:18.000Z",
   "notes": [
    {
     "title": "Hey, Shopkeepers! 🏡✨",
     "items": [
      {
       "text": "We’ve been reading all your feedback from the Alpha Testers and Demo Players, and we’re working hard to improve Sugardew Island! Your thoughts help us make the game cozier and more enjoyable, so here’s what we’ve been polishing in this update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🛠️ Changes & Fixes",
     "items": [
      {
       "text": "🔹 Key prompts for Strafing (Precision Movement) and Running are now displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Tree chopping & rock smashing – You can now hold the button instead of pressing it repeatedly! 🌲💥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Improved seed planting & fertilizing – A visual indicator now makes it clearer that holding the button covers a larger area. The same applies to the upgraded Watering Can & Hoe! 🌱💧",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Some UI elements have been repositioned for a cleaner look.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Better support for non-16:9 resolutions – No more weird UI placements! 📏✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Fixed a bug where pets blocking the Bulletin Board prevented interaction. 🐶📜",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Fixed an issue where NPCs near the Harmony Tree caused interaction problems. 🌳💖",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Island animals should now really, truly, only give seeds once per day. Seriously. For real this time. We hope. 🤞🐑",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Island animals & their current seeds are now correctly saved in the Savegame.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 The fourth owl was stuck in the wrong bush... We freed it! 🦉🎉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 The Quest Progress Bar now behaves like a proper progress bar! 📊✅",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Steam Cloud Saves now work (including Steam Deck & Demo Savegames!) ☁️🎮",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "🔹 Your character won’t accidentally turn in the opposite direction when letting go of the analog stick.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 The Character Editor preview can now be rotated with the right analog stick. 🎨🌀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Steam Achievements are now properly saved! 🏆✨",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "🔹 Some icons have been updated for better clarity. 🎭",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Key mapping for Mouse & Keyboard in the options menu has been corrected. 🖱️🎮",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "🔹 Fixed a UI bug where cutscenes didn’t properly hide UI elements. 🎬🔧",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Overlong text in some languages has been adjusted for better readability. 📖🌍",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Inventory navigation between your Bag and Storage (e.g., Chest) has been improved! 👜📦",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 An unnecessary (and sometimes incorrect) sleep prompt has been removed. 😴❌",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🔹 Canceling a charged tool action now works properly with the right mouse button. 🛠️🚫",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "🔹 Various smaller bug fixes & polish improvements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "✨ Thank you for your support and feedback! Keep those suggestions coming – we love shaping the game with you! 💖",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "💬 Let us know what you’d love to see next!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Your Team rokaplay 🌿🏡",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[table noborder=1]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
