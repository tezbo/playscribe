   "id": "sugardew-island-your-cozy-farm-shop-289259@3961",
   "gameId": "sugardew-island-your-cozy-farm-shop-289259",
   "displayName": "Patch 3961",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-10T14:25:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "​🚨Security Patch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "​A security vulnerability has been discovered in Unity - the engine on which Sugardew Island runs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch is solely intended to close this security vulnerability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "​Further information is available on the corresponding page of the engine: https://unity.com/security/sept-2025-01/remediation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "​Stay safe and continue to enjoy playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "​Thank you for your support & have fun on Sugardew Island! 🌿✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "​Your rokaplay Team 🌿🏡",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
