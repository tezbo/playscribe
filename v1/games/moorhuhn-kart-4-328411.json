 "releases": [
  {
   "id": "moorhuhn-kart-4-328411@1.1.0",
   "gameId": "moorhuhn-kart-4-328411",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-25T18:17:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello racers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are very happy to announce a new, major update to Moorhuhn Kart 4, which adds a whole new game mode:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Time Trials",
     "items": [
      {
       "text": "Have a go at cracking the current track record by going against players from all over the world. Stay on the heels of the current best players by pursuing their ghost and learn new shortcuts, tricks and tactics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45157392/7cbf373cfdfff61477bd542caf4703e394934655.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Leaderboards",
     "items": [
      {
       "text": "Your time will be up there for all to see on the Online Leaderboards. Check how your friends are doing, or even tackle the top players by setting a new all-time record.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45157392/2bafab865b549166748e5708b57259475b0fb53f.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Right now, the leaderboards have all been wiped clean from the beta tests, so you can be one of the first to enter the challenge and submit your times!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "In preparation for this update, we also had a long look at the current kart parts and chose to rebalance some stats, to make some part combinations more viable for competetive gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45157392/b2cac691912516a6eaee6b9dbed60f66683f7bf5.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "Added Time Trials mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Result screen now shows which Kart Parts were unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Cross-Platform Play toggle in Settings & Matchmaking menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased Room Code length from 6 to 8 to support better error feedback on connection failures",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added player reporting options in the Lobby screen and in-game Pause Menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added platform icons to player names in Online mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Online Terms of Service now shown when entering Online Mode the first time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Touched up singleplayer mode icons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new background to Credits screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed blinking animation of various characters (especially the sheep in Sven’s meadow)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing characters in font display",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Increased top speed & top boost speed for underperforming Kart Parts to better align them with their counterparts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
