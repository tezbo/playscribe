  {
   "id": "moorhuhn-kart-4-328411@1.0.14",
   "gameId": "moorhuhn-kart-4-328411",
   "displayName": "Update 1.0.14",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-04T16:24:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, drivers! This update not only adds several fixes and improvements, but also the brand new award ceremony at the end of each Grand Prix. Happy Racing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "Improved UI scaling in Splitscreen setup screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an award ceremony after completing a Grand Prix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added indicators in track & Grand Prix selection screens to show whether the player has won the respective track or Grand Prix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced the number of decimal places in the refresh rate dropdown.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed a respawn trigger in Canyon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue causing inaccurate lap time recordings, which could result in players finishing simultaneously.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where rockets would sometimes fail to explode for clients.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Rocket Redirection achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed wrong sound being played when driving through the spiderwebs in Tangled Tracks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Disabled drifting while affected by the Heart item.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slightly increased the acceleration stat for all engines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
