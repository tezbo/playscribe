       "category": "other"
      },
      {
       "text": "Engine and Plugin Upgrades",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The core of the game has been modernized.",
       "ps5ProOnly": false,
