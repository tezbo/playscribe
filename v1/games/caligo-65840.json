       "category": "other"
      },
      {
       "text": "New engine version. Updated plugins. Including Post Processing for a richer atmosphere.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Asian Language Support",
       "ps5ProOnly": false,
       "pcOnly": false,
