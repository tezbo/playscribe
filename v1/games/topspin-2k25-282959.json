  {
   "id": "topspin-2k25-282959@major-2024-12-10",
   "gameId": "topspin-2k25-282959",
   "displayName": "TopSpin 2K25 Season 5 Patch Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-10T18:55:55.000Z",
   "notes": [
    {
     "title": "What’s New",
     "items": [
      {
       "text": "Added statistics between points to show various stats such as winners, unforced errors, aces, longest rally (and more) during matches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated swing animations for Carlos Alcaraz (forehand, backhand) and Taylor Fritz (backhand)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added ability for AI-controlled pro players in MyCAREER to use alternate outfits in tournaments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new World Tour League rewards exclusive to Season 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new G.O.A.T. objectives and rewards exclusive to Season 5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new Tennis Styles and Pro Outfits in the Pro Shop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Gameplay Balancing Update",
     "items": [
      {
       "text": "Updated the speed of the Timing Meter to make shots performed with a low Rally Energy meter and during long rallies harder to time perfectly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased the chance of errors on Flat Power shots performed with a low Rally Energy meter and during long rallies when the timing isn't perfect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Slightly increased the chance of errors on all other groundstrokes performed with a low Rally Energy meter and during long rallies when the timing isn't perfect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated logic to make the Rally Energy meter deplete faster when using Flat Power shots repeatedly during a rally",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made Slice Power shots consume less Rally Energy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated the speed of the Timing Meter to make volleys a little easier to time perfectly, especially with a high Volley attribute or when the incoming ball is slow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated the Focus Service, Advanced Serve Berserker, Diesel Server and Spin Serve Master skills to make them more noticeable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated attributes for Carlos Alcaraz, Roger Federer and Andy Murray",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Gameplay Stability Update",
     "items": [
      {
       "text": "Game stability and server improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
