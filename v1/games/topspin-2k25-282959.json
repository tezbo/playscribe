  {
   "id": "topspin-2k25-282959@6.0",
   "gameId": "topspin-2k25-282959",
   "displayName": "Patch 6.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-17T13:22:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Get ready for some exciting updates! A patch is scheduled for release today, February 17th, bringing new content to TopSpin!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Highlights",
     "items": [
      {
       "text": "Added Season 6 Center Court Pass and Pro Shop content",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated serve animations for Keys, Agassi, and Sampras",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added 3 new Tennis Styles and 10 new Pro Outfits to the Pro Shop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Net Points Won\" to the Statistics screen in the Pause Menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated the logic for entering the Player Selection screen in Exhibition and 2K Tour modes to randomly select default Pro Outfits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General bug fixes and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This patch is scheduled for release today, February 17th, at 1 PM GMT / 2 PM CET / 5 AM PST!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The excitement continues with the launch of Season 6 shortly after, on February 18th at 6 AM GMT / 7 AM CET / 10 PM PST (Due to time zones, this will be February 17th PST).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "For the best possible experience, we strongly encourage everyone to update to Patch 6.0 as soon as it's available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "See you on the court!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
