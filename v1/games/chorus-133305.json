  {
   "id": "chorus-133305@hotfix-2022-02-10",
   "gameId": "chorus-133305",
   "displayName": "Chorus - Hotfix 10/02/2022",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2022-02-10T15:19:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Based on your feedback and bug reports we have rolled out a small hotfix across all platforms, mainly addressing some of the issues with gaining credits and achievements. Please see the full list of fixes below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You will now be able to earn credits from collecting credit containers after completing the game and in random encounter events",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Progression for both \"Paragon\" and \"Space Traveller\" achievements is now fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You will be prompted to install the hotfix on 10th February, 2022.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep sharing your feedback, or send us a ticket if you are experiencing any technical issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
