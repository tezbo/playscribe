  {
   "id": "chorus-133305@post-2021-12-17",
   "gameId": "chorus-133305",
   "displayName": "[Chorus] PostLaunch fixes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-12-17T13:04:52.000Z",
   "notes": [
    {
     "title": "Improvements",
     "items": [
      {
       "text": "The long-range Rite of Sense now also highlights short-range items (long-press Rite of Sense button)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made it easier to dodge the snipe-attack of various NPCs at difficulty “Extreme”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made it easier to catch the thief in the mission “The Thief”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made it easier to find the cargo in the mission “Sensitive Cargo”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed a rare crash-bug in the “Defender of the Weak” mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare controller disconnection issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mouse and keyboard: Accepting and declining missions now can be done with any key-rebind",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
