  {
   "id": "bandit-trap-306417@1",
   "gameId": "bandit-trap-306417",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-13T15:20:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Our first update is live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Offline game mode is now default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Performance optimizations that should have big impact on lower-end",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bots now scale in difficulty based on rank. So new players should win more often then loose",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stack-up outfit is now unlocked by default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced matchmaking time from max 2 minutes to 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Bandit players can now late join up to 90 seconds instead of 60. Should drive players earlier towards each other",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved win-condition for the Bandits. Treasure collect detection was a bit un-fair",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Some smaller QoL fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition, we've seen reports from users about Motion Sickness and the Camera. We are looking into options on how to remedy this! Thank you to everyone who has broke in or defended their homes in Bandit Trap! We've got some more news to share soon. In the meantime, please keep the feedback coming and be sure to leave a review if you haven't!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
