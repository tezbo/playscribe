  {
   "id": "bandit-trap-306417@major-2026-01-22",
   "gameId": "bandit-trap-306417",
   "displayName": "Security Update For Launch",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-22T16:30:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Attention everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our upcoming security challenge was set to begin February 6, but the trap workshop is still buzzing. We want to make sure every trap lands with maximum mayhem.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Springs tightened.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Oiling swings tuned.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gadgets pushed to their limits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The new launch date is April 30,2026!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Smarter setups. Tricker challenges! No easy way through so...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Trappers - enjoy the chaos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bandits - bring your A-game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-BT Corp",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45049836/23e23713fd40c267ac553868bf8ac5e0ffc3d6fe.jpg\"]",
