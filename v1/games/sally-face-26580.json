  {
   "id": "sally-face-26580@post-2020-01-26",
   "gameId": "sally-face-26580",
   "displayName": "German Translation Now Available for Episode Five",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2020-01-26T23:41:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The German translation is now available for Episode Five!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, I will soon be looking for volunteers to help with translating the full game into Simplified Chinese and French. Possibly also Polish and Japanese. As a solo dev, it's a lot to manage more translations though I hope that with the help of fans, we can get more languages available. I am also working with someone on the Spanish translation, which should be available around summer time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you would be interested in helping with the translations, please shoot me an email at contact@portablemoose.com with your qualifications. Please only Simplified Chinese, French, Polish or Japanese for the time being.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
