  {
   "id": "sally-face-26580@post-2019-12-14",
   "gameId": "sally-face-26580",
   "displayName": "Patch Notes 12-14-19",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2019-12-14T22:44:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone, Thanks for letting me know about these issues. I work very hard to keep the game as bug free as possible. Below are the most recent fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "version 1.5.06",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Addison achievement not working in Episode Two",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Ash sometimes not attacking*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed game sometimes starting in Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Deadstone blast sometimes persisting in new scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with pausing overtop of 3d menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rare issue with the first hexagon puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor adjustments: * This is a theoretical fix, since I wasn't able to reproduce that particular issue. If anyone still experiences it, please let me know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
