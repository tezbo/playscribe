   "id": "sally-face-26580@1.5.53",
   "gameId": "sally-face-26580",
   "displayName": "Update 1.5.53",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-26T15:28:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Pushing out a new update to address some issues!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "version 1.5.53",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed translation image issue in Episode 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed SGB UI so that the popup properly displays only when it can be used",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with NPC pathfinding which could occasionally cause bugs or softlocks on certain platforms when running at lower framerates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Potential fix for Episode 4 issue where Sal would switch to the incorrect sprite during the guitar battle: For anybody experience any issues, please email me mike@portablemoose.com to let us know. Enjoy the game and thanks for all of the support from the community!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
