  {
   "id": "sally-face-26580@1.5.51",
   "gameId": "sally-face-26580",
   "displayName": "Hotfix 1.5.51",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-08-19T16:46:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released a hotfix to address some reported issues after the release of the 1.5.50 update! You can find the patch notes below. For anybody who experiences any issues, you can email me at mike@portablemoose.com and I'll help when I can!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.5.51",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues with the Clumpy minigame, including a possible softlock which could corrupt the save game file",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some translation issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "\\ Fixed incorrect input mappings for gamepads: Version 1.5.50",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "10th Anniversary Update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mobile version updates and enhancements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various minor fixes and tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
