  {
   "id": "sally-face-26580@1.5.46",
   "gameId": "sally-face-26580",
   "displayName": "Update 1.5.46",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-08T15:54:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Got a bit of a bigger update as we have updated the version of Unity we were using from 2019 to the latest 2021. This brings various improvements but most notably corrects a recently discovered security vulnerability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, this update restores the soundtrack which was accidentally removed after the most recent update, sorry about that!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Mike",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Version 1.5.46",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated engine to Unity 2021.3.45f2, this will fix the recently discovered Unity security exploit as well as bring various other improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restored the Soundtrack to the Season Pass version of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
