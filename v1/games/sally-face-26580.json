  {
   "id": "sally-face-26580@1.5.45",
   "gameId": "sally-face-26580",
   "displayName": "Update 1.5.45",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-23T15:01:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A small update is being released onto the Experimental branch. This mostly just contains a few more minor fixes/adjustments. If you would like to try out this update, right click on the game in your Library, select Properties, then Betas, and then change your branch to Experimental.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Mike",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Version 1.5.45",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the syncing for the EYE (The Unknown) achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash in episode 4 caused by equipping the guitar during certain cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted playable characters so that, when walking into a wall, their walking animation does not keep playing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
