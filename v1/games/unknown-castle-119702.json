  {
   "id": "unknown-castle-119702@major-2020-10-01",
   "gameId": "unknown-castle-119702",
   "displayName": "Update: controller support & more",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-10-01T11:47:45.000Z",
   "notes": [
    {
     "title": "New on version 1.9.3",
     "items": [
      {
       "text": "Partial controller support. Mouse is needed in some things in the menu and there are no instructions for gamepad controls. But the controls are very intuitive.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Credits now redirect to main menu automatically",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Game window can now be resized and fullscreen button is now enabled (you can still use F11 for fullscreen)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a little bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved & organized code: Also, if you don't know about my new game, Dr. Atominus, check it out. = )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
