  {
   "id": "unknown-castle-119702@2.0.1",
   "gameId": "unknown-castle-119702",
   "displayName": "Update 2.0.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-06-06T15:36:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update has many bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fix: In the Steam version when moving the player, the mouse moved randomly preventing the menu from hiding",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Bug fix: When using controller the menu didn’t hide",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fix: When using menu with controller it was possible to accidentally use a level door",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed a windows pop up to the game’s own pop up in the treasure room when using multiplayer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game window can be resized again",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
