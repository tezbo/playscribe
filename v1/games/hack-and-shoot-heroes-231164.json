 "releases": [
  {
   "id": "hack-and-shoot-heroes-231164@1.7.4",
   "gameId": "hack-and-shoot-heroes-231164",
   "displayName": "Patch 1.7.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-21T06:54:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, heroes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "HASH is back with a brand-new update to Survive the Hordes!, packed with new features, gameplay enhancements, and the kind of surprises that keep you coming back for more slashing, shooting, and looting!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Whether you're a veteran player or just stepping into the chaos, this update adds more depth, more secrets, and a smoother experience overall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔍 Item Library",
     "items": [
      {
       "text": "Ever wanted to keep track of all the epic loot you've discovered? With the new Item Library, you can now view every weapon, consumable, and stat modifier you’ve collected across all runs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Track your progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discover what you’re missing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Plan your builds ahead of time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "⚡ Evolution Library",
     "items": [
      {
       "text": "Evolving your gear just got smarter. The new Evolution Library lets you view all known weapon evolutions and the combinations required to unlock them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Learn how to evolve your favorite weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep track of discovered evolutions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Aim for powerful synergies and builds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🎯 New Hidden Ambush Events",
     "items": [
      {
       "text": "Explore the map carefully – new ambush events now lurk in the shadows, ready to test your reflexes and reward your bravery. Find them, survive them, and reap the rewards! Just follow the path!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "surprise attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bonus loot and experience if you survive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adds new layers of tension and excitement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🐞 Minor Bug Fixes",
     "items": [
      {
       "text": "I ve squashed several bugs to ensure a more stable and enjoyable experience. Thanks to everyone in the community for the feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "⚖️ Minor Balancing",
     "items": [
      {
       "text": "Tuning has been applied to weapons, enemies, and item stats for smoother progression and better gameplay flow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "🚀 Overall Speed Increased",
     "items": [
      {
       "text": "The game now runs faster and more smoothly than ever — across all supported systems, including the Steam Deck. Combat feels snappier and movement speed has been increased over all classes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "📈 Update Summary",
     "items": [
      {
       "text": "✅ Added Item Library",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Added Evolution Library",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Introduced Hidden Ambush Events",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Improved game performance and speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Minor balancing tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Bug fixes and stability improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
