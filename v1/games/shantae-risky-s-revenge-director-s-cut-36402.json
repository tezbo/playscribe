  {
   "id": "shantae-risky-s-revenge-director-s-cut-36402@1.0.1.4",
   "gameId": "shantae-risky-s-revenge-director-s-cut-36402",
   "displayName": "Patch 1.0.1.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2014-07-21T18:10:22.000Z",
   "notes": [
    {
     "title": "Version 1.0.1.4 includes",
     "items": [
      {
       "text": "-A fix for the achievement 'Mighty Shantae Champ!' If you have already met the criteria but did not unlock the achievement, you will need to re-beat the final boss and the achievement will unlock on the portrait after the credits. It does not matter which ending screen you get.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-An option to EXIT GAME has been added to the main menu and pause game menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-We have added the ability to enable v-sync. To do so, open the properties of the game through Steam, select \"Set Launch Options...\", and enter -v to enable v-sync.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
