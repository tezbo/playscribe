  {
   "id": "forest-farm-167556@major-2021-06-17",
   "gameId": "forest-farm-167556",
   "displayName": "Inventory Bag/Tutorial Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-06-17T09:47:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Inventory system has finally been added. This allows players to store all produce, seeds and anything foraged from the forest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This allows for much quicker and efficient planting of gardens and makes it much more enjoyable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All tutorial signs have also been removed and replaced with a friendly NPC who will guide you through the basics of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I feel this is a significant improvement on the overall look of the game and I hope you all enjoy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy Farming!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
