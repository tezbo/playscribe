   "id": "forest-farm-167556@major-2024-02-15",
   "gameId": "forest-farm-167556",
   "displayName": "Massive Localisation Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-15T02:34:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone, good news! I've finally updated the game with a massive localisation update. This will mean the following languages are now supported:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chinese Traditional",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chinest Simplified",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "French",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "German",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Italian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Korean",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Portuguese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spanish: Also a variety of fixes have been made over the last 6 months that should improve the game overall.: Please let me know if you experience any issues and thanks for hanging in there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
