  {
   "id": "forest-farm-167556@major-2021-04-30",
   "gameId": "forest-farm-167556",
   "displayName": "Trading Post Update - Trade fruit and vegetables for gold coins",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-04-30T08:39:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I've added the Trading Post, which will allow players to trade the produce they've grown for gold coins!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gold coins will be used to purchase upgrades to the farm such as the barn, more animals, chicken coop and more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More traders to come; magic scarecrow, lumber yard (for buying buildings) and the animal dealer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy Farming!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
