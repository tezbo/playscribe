  {
   "id": "tt-isle-of-man-ride-on-the-edge-3-228729@post-2023-05-30",
   "gameId": "tt-isle-of-man-ride-on-the-edge-3-228729",
   "displayName": "Patch notes 02",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-05-30T14:31:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's the patch note for the Steam update you all had this sunday! ⬇️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Advanced slipstream tuning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed AI Rider's pit stop during the official TT event.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved calculation of AI times during qualifications.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Leaderboards scrolling fix (\"Show Top\" function now works as expected).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New TT-specific leaderboard added, now including two leaderboards, one for best times and one for total session times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added TT option for custom race and lobby creation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New checks added to prevent the upload of fake times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix on some track collisions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix on some occasional crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix on crashes connected to Fanatec wheels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Life cycle update for tyres at Level 5 (SBK and SSP).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Follow us on",
     "items": [
