  {
   "id": "tt-isle-of-man-ride-on-the-edge-3-228729@post-2023-06-09",
   "gameId": "tt-isle-of-man-ride-on-the-edge-3-228729",
   "displayName": "Patch note 03",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-06-09T13:39:34.000Z",
   "notes": [
    {
     "title": "PATCH DAY! 🗒️",
     "items": [
      {
       "text": "Today we've got great news: after much research, we've finally managed to fix the grass and bumps bug.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The patch is currently being approved by Sony / Microsoft, and should be live on consoles next week.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "You can read about the Steam patch here",
     "items": [
      {
       "text": "Performance and frame rate improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed LOD and pop-in issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed grass spawning on racetrack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Audio quality improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player level cap raised up to 500",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your contribution and support have been great, we hope you'll now be able to enjoy the game to the fullest! For our part, we'll keep on working hard over the coming weeks for further improvements and corrections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
