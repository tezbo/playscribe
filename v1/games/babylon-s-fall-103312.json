  {
   "id": "babylon-s-fall-103312@1.3.0",
   "gameId": "babylon-s-fall-103312",
   "displayName": "Patch 1.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-29T09:02:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The upcoming version, Ver.1.3, will be the final update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition to some improvements, we have prepared an event to mark the end of BABYLON'S FALL.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As a reminder, service will be terminated for BABYLON'S FALL on Monday, February 27, 2023 (PT).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please enjoy during the remaining period until the end of service.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
