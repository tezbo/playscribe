   "gameId": "song-of-nunu-a-league-of-legends-story-182190",
   "displayName": "Song of Nunu: A League of Legends Story Patch Notes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-11-30T18:15:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have you ever played such a good song that it made Nunu freeze in his tracks? If so, it’s okay we’ve got a fix for that and some of the other issues you may have faced since launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FIXED",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that would cause the game to get stuck at the final sledding sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game now pauses when you open your Steam overlay.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue preventing players with AZERTY keyboards to key bind \"Equip Flute/Release\" to any other key.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We’ve made improvements so that game stuttering happens less frequently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After playing a snazzy melody on your flute, Nunu will no longer be stuck/unable to perform any actions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected the spelling of Volibear’s voice actor in the credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for playing Song of Nunu: A League of Legends Story and reporting these issues to us! If you come across any other issues or these still persist, please let us know in the Steam forums or via our Player Support form!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
