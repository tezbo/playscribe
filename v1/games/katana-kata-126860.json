  {
   "id": "katana-kata-126860@19.02.1",
   "gameId": "katana-kata-126860",
   "displayName": "Update 19.02.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-02-19T15:17:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It seems like a small update from outside perspective, but it's actually a huge deal - from now on all in-game texts are ready for localization to any language. I made first two by myself - Ukrainian and Russian, and with others I hope I will be able to find volunteers from community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
