   "gameId": "katana-kata-126860",
   "displayName": "Update 13.02.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-02-13T16:15:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New shortcut to the boss has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Shore path now have 2 enemies instead of 3, so it should be easier than dojo and make more sense to use.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I will not reset Garden leaderboards for now - level become a bit easier and not harder, so it should be fine to keep current scores.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
