  {
   "id": "katana-kata-126860@10.02.1",
   "gameId": "katana-kata-126860",
   "displayName": "Update 10.02.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-02-10T12:14:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "You should be able to use any controller to navigate all the game UI and menus (previously it worked only in fight). I'm still working on controls remapping and tutorial not only for keyboard, but also for gamepads, but now at least you can use it - if you know how to play it should be pretty straightforward to start using a controller. Please don't be shy to contact me if you find any bugs or inconvenience with controllers. Cheers!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
