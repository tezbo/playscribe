  {
   "id": "katana-kata-126860@29.01.1",
   "gameId": "katana-kata-126860",
   "displayName": "Update 29.01.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-01-29T16:01:55.000Z",
   "notes": [
    {
     "title": "Change Log",
     "items": [
      {
       "text": "Few stability improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fight radius now can be controlled with X-C keys, and not only with mouse",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "No blood splashes and severed limbs from fist and foot strikes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In resolution settings there is screen refresh rate now (to differentiate resolution duplicates)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing, please contact me if you have any problems, I will fix them ASAP!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
