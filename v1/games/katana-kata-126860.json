   "id": "katana-kata-126860@11.03",
   "gameId": "katana-kata-126860",
   "displayName": "Update 11.03",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-03-11T16:19:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Now there are no armored enemies at the beginning of the level, so players can learn new enemy types first, and armor mechanics later;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "less enemies on the shortcut way through the lake shore - so now there is more sense to use it;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "and less armor pieces on the boss (armored samurais later in the game still have full set of armor).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
