  {
   "id": "worldless-214709@post-2024-01-08",
   "gameId": "worldless-214709",
   "displayName": "Worldless Patch Notes - January 8th",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-01-08T13:23:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Space explorers! We hope you've had a great start of the year and have been enjoying Worldless so far! We've been reading your feedback and been working our way through many bug reports. Today's patch includes additional tips and context for HP locations in-game and in-game abilities. Additionally we've also squashed lots of bugs, crashes and softlocks. You can read the full list below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Game Improvements",
     "items": [
      {
       "text": "Guard Impact Skilltree video updated to make it easier to understand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Several value tweaking on enemies to decrease a bit the difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Some SkillTree texts updated to explain better some skills.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted some colliders on pink/purple area to improve movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Seal charged FX texture resolution increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new HP hint on map to make it easier to find them all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "LUCA should not show HP bar now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug & Crash Fixes",
     "items": [
      {
       "text": "Fixed error where Demon was crashing after losing against it and then reloading the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor issue with enemy blocks patterns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed hang if you dash right after entering an air boost in green area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed hang after sonaring HP improvement items from bellow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some vegetations wrong orientation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed thunders in grey area sometimes not working properly on PS4/Switch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Guard Impact and Assimilation problem where it was possible to use it without unlocking/chargin it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed softlock when quitting the game after rain starts again but before gaining the second character control in pink/purple area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Summum sonar not appearing sometimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Lightning Nightmare phase2 to phase3 not happening sometimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Lightning Nightamare using the wrong appear animation when fighting it for the first time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Summum phase 02 laser launched from the eye, not the hand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Ice not appearing on skilltree under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug on yellow area timed door if you ran really far from the door.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed collision problem next to 3 locked doors on yellow area which allowed players to go through a wall and get permanently stuck, forcing to restart the entire save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a patch to add ice magic to skill tree if detected a player who had no ice magic (due to another but) and couldn't unlock it anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor fix on DarkPaladin phase change.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash when using Glance of Tomorrow on the Holy Bat for Xbox players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Fixed a very unusual random hang when entering a combat for Switch players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you to everyone who has been sharing their feedback and bugs with us and we kindly ask you to continue reporting them to us on Steam & Discord.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
