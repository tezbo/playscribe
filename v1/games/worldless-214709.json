  {
   "id": "worldless-214709@post-2024-02-13",
   "gameId": "worldless-214709",
   "displayName": "Worldless Patch Notes - February 13th",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-02-13T08:26:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi fellow gamers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're back with a new round of bug fixes! Please find the details below. If you encounter any other issues that haven't been addressed, please let us know, and we'll address them promptly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "For version 1.3.1 we have fixed",
     "items": [
      {
       "text": "Fixed endless offensive turn and hang when absorbing after breaking a block using Fatal Ordeal technique.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several spawn zones to avoid players appearing on wrong areas when loading the game and being soflocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Total game time being reset sometimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Ice magic skilltree tutorial not appearing sometimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Worldmap locators shown on wrong locations sometimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed - Pressing move input right before some tutorials caused Edda to turn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a few typos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed outro sfx was sometimes still playing if cinematic was skipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "For version 1.3.2. we have also made the following changes",
     "items": [
      {
       "text": "Addressed combat hangs occurring when initiating an absorption immediately after an enemy's demise.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rectified instances where blocks failed to reset properly when fighting enemies recurrently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Implemented adjustments to enemy balancing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Resolved the darkness glitch in the Grey area of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Eliminated the possibility of instantly switching to an \"Axe charged\" action without any Technique or Guard Impact stacked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We kindly ask you to continue reporting them to us on Steam & Discord. Thanks for playing Wordless!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
