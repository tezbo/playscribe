  {
   "id": "worldless-214709@post-2024-08-14",
   "gameId": "worldless-214709",
   "displayName": "Worldless Patch Notes - August 13th",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-08-14T09:04:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi 👋",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here you have another round of bug fixes! You can find the details below. If you come across any other issues that haven't been resolved, please let us know, and we'll take care of them as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "For version 1.3.4. we have fixed",
     "items": [
      {
       "text": "Enemies general balance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hyperarmor added to player during all techniques.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Inner Will now resists all magics in addition to absorbing lightning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Yinyang second phase absorbs elements so blocks can be broken.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dark Paladin combat on Path of the Reminiscence was not throwing fx.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Running right after beating Summum was locking the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Aven was not double-deflecting counter attacks when using seal charged.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Gray branch darkness fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several platforms and orbs fixes and tweaks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We kindly ask you to continue reporting bugs to us on Steam & Discord. Thanks for playing Worldless!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
