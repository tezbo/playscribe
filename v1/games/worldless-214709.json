  {
   "id": "worldless-214709@post-2025-03-14",
   "gameId": "worldless-214709",
   "displayName": "Worldless Patch Notes - March 14th",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-14T02:31:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi 👋",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here’s another update with bug fixes! You can find the details below. If you encounter any issues that haven’t been addressed, feel free to reach out, and we’ll resolve them promptly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "For version 1.3.5. the changes we have applied are",
     "items": [
      {
       "text": "Player updates: more generous values for parrying and evading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemies updates: some attack patterns and values tweaked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ice Level 3, Wind Level 3 and Counterspell hit all targets on screen now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unified Division was performed instead of Glance Of Tomorrow on certain conditions even if the player had two techniques stacked. This doesn’t happen anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an error where Edda/Aven puppets were performing a technique with no technique stacked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Now Edda/Aven puppets should not perform any actions that have not been unlocked by the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The error where Duality Black was stuck on the floor when repeating the encounter after absorbing Duality Black with Glance Of Tomorrow is now solved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On assist whiff magic input has now been blocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vulnerabilities tutorial wrong absorption damage value and typos have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We kindly ask you to continue reporting bugs to us on Steam & Discord. Thanks for playing Wordless!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
