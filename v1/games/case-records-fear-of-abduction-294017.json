  {
   "id": "case-records-fear-of-abduction-294017@1.0.1",
   "gameId": "case-records-fear-of-abduction-294017",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-11T14:55:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all! All these days we have been carefully monitoring your feedback and messages. We've been working and releasing updates almost every day, and just recently released a big update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your opinion about the game is very important to us, we are very glad that you are helping to make this game better :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Main and important changes",
     "items": [
      {
       "text": "Most bugs and errors in localization have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the ability to turn off the camera effect, this can be done in the video settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added additional plot markers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The character's stamina and running speed have been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The flashlight began to work better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved game optimization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the ability to view the task on TAB",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Now you can skip dialogues using the left mouse button",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The system for evaluating your decisions has been changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bad endings will become more difficult to get.: Developer's comment: The player will now have to try hard to get to bad endings.: In essence, you must deliberately make wrong and questionable decisions that will ultimately lead you to tragedy.: Your opinion about the game is very important to us, we are very glad that you help make this game better :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
