  {
   "id": "mythwrecked-ambrosia-island-223097@1.04",
   "gameId": "mythwrecked-ambrosia-island-223097",
   "displayName": "Patch 1.04",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-12-13T09:34:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Happy to report that we've had very few bugs reported so this is just a minor update. The fixes for V1.04 are as follows:-",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed rare progression blocker where you can sprint from a non-Hermes friend favour to a gull and skip the dialogue quickly, meaning his points aren't allocated directly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed a typo in the game's final scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
