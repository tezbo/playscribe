   "displayName": "PATCH 1.11",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2017-11-21T15:11:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Happy Mewsday, everyone! A short new patch went up for Cat President this morning!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed a joke about Frankenstein",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaked an Achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a points bug in Rover's pathway (thanks, Kimchi Tea!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed DJ Nibbles' dong typo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaked a joke about Grumpy Cat in the Thunderpaw pathway (thanks Zach!!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a few other typos: Enjoy!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
