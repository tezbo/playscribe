  {
   "id": "cat-president-a-more-purrfect-union-23186@1.1",
   "gameId": "cat-president-a-more-purrfect-union-23186",
   "displayName": "PATCH 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2017-06-12T19:48:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Happy Meownday, everyone!! I'm delighted to announce that Steam Achievements are now live in Cat President!!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you've already completed the game, you can go back and unlock most of them by holding down control and skipping through the dialogue you've already seen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "FULL PATCH NOTES",
     "items": [
      {
       "text": "ACHIEVEMENTS. 21 in total, including two hidden ones.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected typos and added a catload of new puns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added pun names for all 50 states.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Questions now stay on-screen during decision points, in case you forgot what you were talking about.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaks to intro to make it more clear which cat is which, and what species the main character is.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug with name input: Now if the player doesn't type in a name, it defaults to \"Abigail\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added copyright information and social media icons to title screen.: Enjoy!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
