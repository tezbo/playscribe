  {
   "id": "cat-president-a-more-purrfect-union-23186@1.13",
   "gameId": "cat-president-a-more-purrfect-union-23186",
   "displayName": "PATCH 1.13",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-02-27T23:20:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The tiniest of tweaks to the game today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added code so that Cat President 2 will remember what you named the heroine in Cat President 1.: Yeah, that's right! Whatever you name your character in this game, that name will now appear in the sequel!: If you want to take advantage of this, update (or reinstall) Cat President, and just play up to the part where you name your character (right at the beginning). That name will then appear somewhere in Cat President 2!!: ...I'm sorry, I'm probably more excited about this than I should be. It's just a cool thing!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
