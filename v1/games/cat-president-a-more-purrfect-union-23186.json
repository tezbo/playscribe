  {
   "id": "cat-president-a-more-purrfect-union-23186@2.0",
   "gameId": "cat-president-a-more-purrfect-union-23186",
   "displayName": "PATCH 2.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-24T17:54:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey y'all! Big update today, just in time for the 2022 U.S. elections! We're clearing out some of the stock photos we used when we originally created the game and bringing you some all-new faces and places.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New character portraits for Bernice, Lola, Pet Store Clerk, Skateboarder, College Student, Rock Patriot, Michelle, Kimmy, and Mr. Mrs. Drew.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New hotel room for Thunderpaw, new office for Rover, new café, new pet store, new library, various other new backgrounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New selection of cute human photos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A few new music tracks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resized a couple cats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed text-highlighting effect (again) for enhanced readability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an options menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Corrected typos and grammar errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
