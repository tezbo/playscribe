  {
   "id": "cat-president-a-more-purrfect-union-23186@1.01",
   "gameId": "cat-president-a-more-purrfect-union-23186",
   "displayName": "PATCH 1.01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2016-08-24T16:43:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It's come to my attention (thanks, ayarger!) that dialogue in the game was just plopping on the screen all at once, instead of scrolling nicely like it does in most visual novels*. This is now fixed!! The magic of the Internet!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After you've downloaded the patch, it should set the text to the correct speed as soon as you run the game, whether you're starting a new game or loading a save file. If the text is still just plopping onto the screen, let me know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* This is actually how it's been running on my computer all this time; I didn't realize it was showing up differently on other people's computers. My apologies!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
