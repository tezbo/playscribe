  {
   "id": "ila-a-frosty-glide-305076@post-2024-11-21",
   "gameId": "ila-a-frosty-glide-305076",
   "displayName": "Updated Demo available until Dec 1st!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-21T09:58:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey! ❄️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We wanted to share with you that ILA: A Frosty Glide will be featured in not one, but TWO incredible events this week!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🌟 The MIX Fall Showcase",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🗓️ When: Nov 21st @ 9am PST",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📺 Where: Watch our new trailer live on The MIX YouTube & Twitch channels!: 🌟 Indie Arena Booth 2024 Recap",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🗓️ When: from Nov 22nd, starting @ 7pm CET until Nov 29th",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛠️ Where: Join the celebration during the Steam event!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Updated Demo Available Now!",
     "items": [
      {
       "text": "To make this even more special, we’ve updated our demo and it comes with improvements we think you’ll love!:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "✨ What’s New in the Demo",
     "items": [
      {
       "text": "❄️ Improved Movement: ILA’s walking mechanics are now smoother, preventing her from getting stuck in tricky spots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "💨 Enhanced Dash Communication: The dash ability is now clearer and more intuitive for a seamless experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🎨 Visual Upgrades: Enjoy a more magical look for the enchanted lake and skatebrooms—now even more enchanting!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🛠️ Tweaks and Fixes: We’ve made adjustments based on your feedback to continue improving you experience playing.: 🚨 This demo will only be available until December 1st, so don’t miss your chance to step into ILA’s frosty world. ❄️💫: 🗨️ We’d love to hear what you think—drop your thoughts in the comments below or share them in our Discord community!: Thank you so much for your incredible support—it truly means the world to us. 💖: If you want to receive more frequent updates on our development, join the newsletter💌: Let the magic continue!: 💫 The Magic Rain Studios Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
