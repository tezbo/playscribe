       "category": "new"
      },
      {
       "text": "Fixed a visual glitch when entering the overhead camera in the Arena",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rebinding of the Move and Look keys now works correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
