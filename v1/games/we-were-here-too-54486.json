  {
   "id": "we-were-here-too-54486@patch-2018-02-25",
   "gameId": "we-were-here-too-54486",
   "displayName": "We Were Here Too - Patch V.25022018",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2018-02-25T21:09:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since some people are having issues starting the game we have decided to initialize our systems in stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "During the Splashscreen you will be able to track the progress of systems being initialized. If you experience any issues during this process please let us know so we look for any issues in the specified system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay related issues will be addressed in a future patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
