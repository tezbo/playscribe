   "id": "we-were-here-too-54486@2.0.7",
   "gameId": "we-were-here-too-54486",
   "displayName": "Patch 2.0.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-09-16T08:04:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 2.0.7. is a maintenance patch upgrading our engine, plugins, render pipeline and internal systems in preparation for the crossplay update together with the Switch release.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The main menu got an update as well and looks different from before. You can manually select your checkpoint if necessary, by clicking on \"change\" > \"start new journey\" > \"select your checkpoint\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
