   "announcedAt": "2025-10-17T08:19:30.000Z",
   "notes": [
    {
     "title": "Patch notes for patch 2.0.11. for We Were here Too",
     "items": [
      {
       "text": "Fixed an out of focus issue when inspecting objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "At the relic puzzle, the stairs now disappear correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Progression is now synced properly between different clients",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Getting stuck while inspecting an object no longer occurs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a duplication glitch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "All correct windows must now be placed to complete the puzzle with the windows",
       "ps5ProOnly": false,
