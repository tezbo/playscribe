  {
   "id": "concept-destruction-123561@major-2021-01-18",
   "gameId": "concept-destruction-123561",
   "displayName": "New update brings mayhem with up to 49 AI cars",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-01-18T17:32:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This brings to Steam the update we made for PS5 & Xbox Series X: You can now go into gameplay settings and change the number of rivals up to 49.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "Please beware that this will be very taxing on your processor, NOT so much on your graphics card.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This means that you better have a good CPU if you want to go all the way up to 49 expecting good performance!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's why the default number will stay at 19 for new players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy the madness!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
