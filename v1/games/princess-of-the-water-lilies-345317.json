  {
   "id": "princess-of-the-water-lilies-345317@major-2026-06-04",
   "gameId": "princess-of-the-water-lilies-345317",
   "displayName": "Definitive Edition Update is Live!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-04T13:52:27.000Z",
   "notes": [
    {
     "title": "We are happy to announce that the Definitive Edition Patch is here!",
     "items": [
      {
       "text": "Explore the new difficulty level, possibilities, and much more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "1. New Difficulty Modes, play as Kitten or Cat",
     "items": [
      {
       "text": "Kitten Mode - Offers a gentler boss fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Cat Mode - Raises the difficulty with tougher boss encounters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "2. New Cat Skins",
     "items": [
      {
       "text": "Fresh cosmetic skins unlocked for both the Cat and Kitten modes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "3. New Image Gallery",
     "items": [
      {
       "text": "A brand new Gallery where hand-painted splash art unlocks as you progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "4. Expanded Localization",
     "items": [
      {
       "text": "Added support for more languages so more players around the world can experience Princess in their own language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Korean",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spanish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "5. Reworked Boss Battles",
     "items": [
      {
       "text": "Every boss encounter has been revisited and refined.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The updated fights bring tighter attack patterns, more dynamic phases, and improved balance across all difficulty settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Each boss battle is now more exciting, more challenging, and more satisfying to defeat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "6. Improved Cutscenes",
     "items": [
      {
       "text": "Upgraded and added more cinematic cutscenes to make the story feel even more immersive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "7. Improved Visual Experience",
     "items": [
      {
       "text": "Added and polished visual effects for better impact & better feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new sound effects for a better audio experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Repainted some of the in-game assets for visual quality consistency.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "⚖️ Balancing Adjustments",
     "items": [
      {
       "text": "1. Boss Difficulty Overhaul",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Every boss fight has been tuned for a smoother, fairer difficulty curve across both Kitten and Cat modes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "2. Dandelion Speed Adjusted",
     "items": [
      {
       "text": "Dandelion navigation now feels the way it should. Smoother, more responsive, less fighting the wind.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "3. More Save Slots",
     "items": [
      {
       "text": "By popular demand, the players have access to extra save slots to manage multiple playthroughs and difficulties.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "4. Driller Mechanics",
     "items": [
      {
       "text": "More precise landing point.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🛠️ Bug Fixes & Optimizations",
     "items": [
      {
       "text": "1. Performance Boost",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimized memory and CPU usage. Noticeably better frame rates on lower-end PCs and handheld devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "2. UI & Localization Fixes",
     "items": [
      {
       "text": "Fixed text overlap and formatting issues across different screen sizes and newly added languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "3. Visual Glitches",
     "items": [
      {
       "text": "Resolved various minor visual bugs to ensure a cleaner and more consistent experience across all five biomes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We’re excited to get to know what you think about the patch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wishing you all a fantastic day!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~Princess of the Water Lilies Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
