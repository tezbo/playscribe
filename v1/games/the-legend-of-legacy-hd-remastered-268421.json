   "id": "the-legend-of-legacy-hd-remastered-268421@major-2024-06-11",
   "gameId": "the-legend-of-legacy-hd-remastered-268421",
   "displayName": "June 11, 2024 Update Release Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-11T17:22:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have an update for The Legend of Legacy HD Remastered. This update has addressed the following issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the final boss form was not reverted after retrying.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with experience gain referring to the wrong reference instead of the enemy leader.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where equipment stats were not being reflected until reloading a save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We hope you enjoy these fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NISA",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
