  {
   "id": "arcadia-fallen-ii-293096@major-2026-05-05",
   "gameId": "arcadia-fallen-ii-293096",
   "displayName": "Update Notes for May 5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-05T17:09:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With the game now nearing the end of its first month since it was released, we're ready with another small update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Version 1.0.3",
     "items": [
      {
       "text": "Banter played from the extras menu will now consider the choices of the last save file to be saved or loaded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with the fourth banter between Elias and Kim appearing twice, instead of the final banter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with one particular combination of choices from Arcadia Fallen I not being properly considered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with an incorrect background variant being used at the beginning of chapter 5, during the morning assembly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a few typos and other text errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some minor audio improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you find any errors, please don't hesitate to share them with us on our Discord server at https://discord.gg/h5QUdmc",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope everyone is enjoying their time at the Seven Winds Academy! ❤️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Galdra Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
