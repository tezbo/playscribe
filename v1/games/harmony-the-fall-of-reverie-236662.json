  {
   "id": "harmony-the-fall-of-reverie-236662@1.02",
   "gameId": "harmony-the-fall-of-reverie-236662",
   "displayName": "Patch 1.02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-19T17:04:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you have been enjoying Harmony: The Fall of Reverie so far!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You will find below a non-exhaustive list of things we have implemented in this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New features",
     "items": [
      {
       "text": "· Added the possibility to check the paths you took on all Acts, with a short reminder of what happened",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Added the possibility to reload an Act you previously played once the game finished.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Added a Tutorial menu in the Pause menu that gathers everything you need to know about the gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Added various Accessibility & Controls settings in Game settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Language option is now available in Game settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Added Nodes Barriers opening effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Added Gamma tweaking setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Added more narrative sounds in playlets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Added a control rebinding menu for keyboards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "· Added controls reminder for controllers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugfixing",
     "items": [
      {
       "text": "· Fixed UI issues with specific keyboards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Fixed various typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Fixed various issues on the Augural",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Should you encounter issues or have any question, please check our dedicated FAQ or contact us if you need further assistance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
