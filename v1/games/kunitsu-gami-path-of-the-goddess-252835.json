   "id": "kunitsu-gami-path-of-the-goddess-252835@major-2025-06-05",
   "gameId": "kunitsu-gami-path-of-the-goddess-252835",
   "displayName": "Free update! New extra content, Otherworldly Venture added!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-05T05:40:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The extra content, Otherworldly Venture, is a skill-testing mode that emphasizes exhilarating action and strategic thinking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Set in an alternate world hidden behind the Torii Gate, this new game mode offers a streamlined version of the standard day/night cycle, featuring an endless horde of enemies. The Maiden's health does not regenerate in this mode, so it's game over when her health reaches zero.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players are challenged to strategically plan positions and villager placements more intensively than in the main game, resulting in a demanding yet rewarding experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
