  {
   "id": "orten-was-the-case-211596@1",
   "gameId": "orten-was-the-case-211596",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-01-02T09:01:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "And thank you everyone for all the amazing feedback on the game so far, and all greatly appreciated bug reports!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's a changelog of some fixes",
     "items": [
      {
       "text": "Fixed triggers for ~10 events that did not work preventing save file to be able to get to 100%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Sneakers not showing correctly on checkpoints",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game got locked when Abo screamed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mark on hand after using checkpoint",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some interactions not working with correct button when rebinding \"Interact\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cash bundle showing wrong UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed an unintentional interaction point in Tram room that made you walk out of bounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Being able to grab water tower ladder from outside",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Missing Dialogue on Minne by Abo Panel that soft-locked the game: If you find any more bugs, or if this patch introduces and new one, please join Discord and report them there: Discord",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
