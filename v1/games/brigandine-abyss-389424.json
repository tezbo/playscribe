  {
   "id": "brigandine-abyss-389424@1.01",
   "gameId": "brigandine-abyss-389424",
   "displayName": "Update 1.01",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-08T07:00:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[table equalcells=\"1\" colwidth=\"\"][td rowspan=\"2\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for all of your feedback. Based on your suggestions, we've released Version 1.01, which includes the following improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.01 Update Details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Graphics Settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "◆Graphic Options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The following graphics options have been added to the Options menu:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・V-Sync: On / Off",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Frame Rate: 30 FPS / 60 FPS / 120 FPS / 144 FPS / Unlimited",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◆New Unit Visibility Settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The following visibility options have been added to the Options menu:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Unit Color Coding: On / Off",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[carousel autoadvance=\"true\"][img src=\"{STEAM_CLAN_IMAGE}/45988264/874555b0aab0b25aba67f63f3f32e318ea99475d.jpg\"][img src=\"{STEAM_CLAN_IMAGE}/45988264/137594e5209eae181bc92f9a266d70c830207d05.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Unit Size: Default / Medium / Small",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[carousel autoadvance=\"true\"][img src=\"{STEAM_CLAN_IMAGE}/45988264/7e0f3d7b23e1f3a37b627101af128ce08501b07f.jpg\"][img src=\"{STEAM_CLAN_IMAGE}/45988264/1d2692a9fcf2a27f23db97c20e747e7350c99d83.jpg\"][img src=\"{STEAM_CLAN_IMAGE}/45988264/d07699b2403503d8c909d8b9f91ecd7f21bf4378.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◆Additional Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・You can now purchase equippable items directly from the Change Equipment screen for leaders and monsters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Mouse controls have been improved so that moving the cursor to the edge of the screen automatically scrolls the map.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Fixed several minor issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your continued feedback and support. We'll continue working to improve the game and provide the best possible experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
