  {
   "id": "kinnikuneko-super-muscle-cat-226869@1.0.3",
   "gameId": "kinnikuneko-super-muscle-cat-226869",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-23T18:36:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an error that makes KinnikuNeko don’t die in some situations, some of them causing an infinite fall state (Thank you nottsu for the report).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an error that makes lifting difficult or even impossible smashing the button (Thank you to the people that report it).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an error that cause the main menu can’t be navigated when the game lost focus in some specific states.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The unicorns now doesn’t shoot their rainbow laser if the rider on top of them is dead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an error causing the unicorns damages other enemies or KinnikuNeko even if their are not shooting the rainbow laser.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an error when in some specific situations if you crouch on top of a platform, KinnikuNeko doesn’t move with the platform.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the behaviour in the platforms of the second stage in Atlantia. Now only can be activated with the switchs and not by character proximity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the default mapping for the “para para minigame” in order to match the color buttons with the minigame colors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the full energy bar sound when reach the 100% in the second phase of the queen fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some situations when the full energy bar sound is triggered withouth need.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some situations when the full energy bar particle effect remains on screen even when the UI is hidden.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a small cooldown between the soldiers helmet drop their activation to hit it in order to avoid sound saturation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the final gym alien animation being missaligned with the weight sometimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that makes the door in Atlantia close visually but you can pass trough it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a new fan-art.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More minor fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
