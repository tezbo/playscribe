  {
   "id": "kinnikuneko-super-muscle-cat-226869@major-2025-03-12",
   "gameId": "kinnikuneko-super-muscle-cat-226869",
   "displayName": "SUPER AWESOME UPDATE!!!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-12T21:00:59.000Z",
   "notes": [
    {
     "title": "BIG NEWS AND MUSCLES!",
     "items": [
      {
       "text": "I'm very happy to tell you that thanks to the support of the publisher Mameshiba Games, the game has undergone many changes for this new update, which will also be public on consoles (Nintendo, PlayStation and Xbox).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "This update fixes some bugs that were still dragging before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The artwork of all scenarios has been updated and some areas have been slightly changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy intelligence and enemy feedback has been improved. For example the aliens in UFO now don't pass by when they shoot at you and the mole aliens give you a few moments to dodge them!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "FULL DUBBING ?!",
     "items": [
      {
       "text": "The game now has FULL DUBBING in Japanese, English and Spanish!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Even the NPCs are voiced!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It has also been subtitled in 9 languages: Japanese, English, Spanish, French, Italian, Simplified Chinese, Portuguese, German and Russian.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There are new achievements and some new secrets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I really hope you enjoy this great update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
