      },
      {
       "text": "This expansion was created as a mod to help introduce players to Teardown’s powerful modding systems. If you haven't tried your hand at modding, now is a great time to start!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
