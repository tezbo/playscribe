   "id": "teardown-122666@major-2026-09-30",
   "gameId": "teardown-122666",
   "displayName": "Teardown Rally - Free Multiplayer Update in Development",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-30T17:08:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ready to hit the track… and possibly everything beside it? 🏎️💥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our new racing mode is currently in development and will be coming to Teardown as a FREE update! Expect quick races, tournaments and cups, plus 18 new vehicles: 12 rally cars and 6 monster trucks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Picture up to 12 players drifting across Frozen Lake, launching off massive jumps in the Quarry and occasionally sticking the landing. 😅",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Need an advantage? Hop out, wreck your opponents’ vehicles and help your team win. Overtaking is easier when the other car needs reassembling. 🔨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned for more details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://www.youtube.com/watch?v=YOP4OMgtRdM\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
