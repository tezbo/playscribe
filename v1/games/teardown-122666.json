  {
   "id": "teardown-122666@post-2025-04-30",
   "gameId": "teardown-122666",
   "displayName": "Editor improvements and Bug Fixes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-04-30T08:14:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It’s been a little while since our last update, but rest assured we’ve been keeping busy behind the scenes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our team is hard at work developing not one, but two brand-new DLCs, as well as one of the most highly requested features yet: MULTIPLAYER! While those major additions are still in the works, today we're rolling out a minor update focused on improving your current experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update includes several bug fixes and some nice improvements to the editor, making it even easier and smoother to build, mod, and create in Teardown.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you enjoy the changes, and we can’t wait to share all the exciting new content we’ve been working on. Stay tuned, there’s a lot of cool stuff coming your way!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "/The Teardown Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
