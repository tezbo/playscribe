  {
   "id": "teardown-122666@major-2023-03-16",
   "gameId": "teardown-122666",
   "displayName": "Teardown Pricing Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-16T21:08:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After the Steam Spring Sale, the base price of Teardown will increase from $19.99 to $29.99. Now is your last chance to buy Teardown at a discounted price (currently also 20% off) before the change goes into effect on March 23.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We can’t thank the more than one million players who have already joined the Teardown community enough. The game has grown a lot since we entered Early Access in 2020 and we can’t wait to show you what we have in the works as we continue to expand it more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
