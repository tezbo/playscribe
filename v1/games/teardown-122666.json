  {
   "id": "teardown-122666@post-2021-12-20",
   "gameId": "teardown-122666",
   "displayName": "Minor updates and fixes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-12-20T15:09:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This is a minor update fixing a few issues from the 0.9 release and adding some new content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "Challenges added to Quilez Security",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Leaf blower can now remove snow and boost fires",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Snowy weather option in sandbox mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More valuables in Quilez Security",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New laser deflectors in Quilez Security",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue that caused certain mods to reset campaign progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor bug fixes and mission tweaking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
