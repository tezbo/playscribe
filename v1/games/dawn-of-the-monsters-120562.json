   "announcedAt": "2022-06-08T16:19:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added internal challenge system! View your currently unlocked challenges in the Main Menu!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a Restart Mission button! No more backing out all the way to the Command Center just to start a level over!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a warning popup in the Chat menu explaining that chats expire",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted some text visuals for readability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where the loot pool would pull from historical best instead of your actual mission results",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added Health readout to the inventory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated the credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Monster Mash description",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the training grounds wouldn't fully refill your rage if you have more than 5 bars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed display issues with telegraphs in Agnitor's fights",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
