  {
   "id": "ebenezer-and-the-invisible-world-244457@1.1.0.12",
   "gameId": "ebenezer-and-the-invisible-world-244457",
   "displayName": "Patch 1.1.0.12",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-09T19:16:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Merry greetings to all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for taking the time to play our game. It has been a labor of love for almost two and a half years. Your feedback is very valuable to us, one could say it’s our guiding star. We’ve had an exciting launch day and now we would like to share some updates with you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Below is a full list of fixes that come with the release of Patch 1.1.0.12. As we roll out these improvements, we express our heartfelt gratitude for your continued support and feedback. Thank you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed controller vibration not being disabled when turned off on the Settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Settings menu Exit button not working on the Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed missing graphics options on the Settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect font size in certain languages on the Settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed “Critical Health” visuals and sound FX staying active after exiting to main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed instance of Malthus Guard hovering slightly above the ground in a specific area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Ghost Challenges progression not counting properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing ladder climb animation missing certain frames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed vanishing cursor on Settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed invisible ledge in the Crypt before entering the Necropolis",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed weird mouse cursor behavior on the Trader menu",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed bug with “Santa Scrooge” skin when entering a mirror",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Ebenezer sometimes getting stuck between the movable blocks and the environment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Cane attacks not working under specific conditions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the \"Beautiful Dress\" quest item getting removed from inventory on death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Spirit Elixirs missing from the Trader’s inventory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Quest texts getting bugged if player dies after accepting quest but before saving the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Warren Gastrell getting stuck mid dash during rematch fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Malthus Guard walking towards Ebenezer during dialogue with Warren Gastrell before rematch fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Warren Gastrell using wrong dialog lines during rematch fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Quality of Life Changes",
     "items": [
      {
       "text": "Changed the angle at which the analog stick triggers Ebenezer’s ladder climbing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed input handling to make it possible to jump and attack at the same time (not one after the other)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased Ebenezer’s movement speed both with and without the Heirloom that increases run speed (Emi's Black Belt)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced intensity of screenshake on hitting enemies and getting hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced amount of damage done by Wailing Wendy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased size of item popups and their font sizes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased font size of Heirloom pickup popups",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added an additional Save room in the London area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased pickup hitbox size of the Warden’s quest item (Letter)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "We wanted to get as many of these fixes to you as soon as possible, so the patch may not include a fix for every issue you’ve brought up. Fear not, for we are continuing to test and improve the game and will continue releasing patches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay merry!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Luke",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Community Manager",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
