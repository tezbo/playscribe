   "id": "ebenezer-and-the-invisible-world-244457@major-2025-01-03",
   "gameId": "ebenezer-and-the-invisible-world-244457",
   "displayName": "Steam Update - Achivements",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-03T18:35:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Merry greetings, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We were alerted to a bug affecting Steam achievements in the game. Thanks to the help from our community members, we were able to diagnose and resolve the problem.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Summary of the fix included in this patch",
     "items": [
      {
       "text": "Fixed the bug preventing achievements from unlocking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "From the team @ Play on Worlds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
