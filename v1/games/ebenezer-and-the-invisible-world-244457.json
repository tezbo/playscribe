  {
   "id": "ebenezer-and-the-invisible-world-244457@1.2.0.1",
   "gameId": "ebenezer-and-the-invisible-world-244457",
   "displayName": "Patch 1.2.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-18T20:03:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Merry greetings, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It was brought to our attention that there is a block bug involving the miner quest. This was an issue we understood was solved, but has come up with older save files. Thanks to some help from members of the community we were able to diagnose and solve the problem.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Below a summary of the fix with this patch",
     "items": [
      {
       "text": "Fixed the Miner's quest bug where, upon defeating the boss, the room in the Observatory remained locked and the quest NPC did not appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "From the team @ Play on Worlds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
