  {
   "id": "ebenezer-and-the-invisible-world-244457@1.1.0.14",
   "gameId": "ebenezer-and-the-invisible-world-244457",
   "displayName": "Patch 1.1.0.14",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-16T18:55:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Merry greetings everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the course of yet another week, a fresh iteration of improvements graces Ebenezer and the Invisible World! It brings me great joy to report that the most pressing of bugs now reside in the annals of the past. Nevertheless, our unwavering dedication persists, akin to a tireless artisan honing a masterpiece.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Below is a rundown of the changes in Patch 1.1.0.14. As these improvements make their way to you, we want to extend our sincere thanks for your ongoing support and valuable feedback. We truly appreciate it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed dialogues getting jumbled under specific circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Ebenezer being able to hit himself with the Prisoner’s power",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with not being able to change consumables",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with Harpoonist sprite blinking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with wrong consumable showing upon loading the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Spirit Upgrade Trader refusing to upgrade Ebnezer’s max Spirit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with stair collision in specific area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with Critical HP overlay not properly applying over the entire screen on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Consumable UI not disappearing when Ebenezer dies with 0 consumables",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed London boss respawning if Ebenezer dies before reaching a save room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed rat from underwater level (we told him to find Kenji’s ring first)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Stay merry!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Luke",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Community Manager",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
