  {
   "id": "cannibal-cuisine-125671@major-2020-05-23",
   "gameId": "cannibal-cuisine-125671",
   "displayName": "Update: movement system and controls improved!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-05-23T22:21:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re over the moon to see you all play our game!!! The launch has been delicious and now it’s time to make the game even tastier!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This past week we have noticed some feedback on the controls, movement and difficulty of the game. We straight away started to process your feedback which resulted in today’s update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Expect an all new improved movement system and controls, and that’s not all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is the full list",
     "items": [
      {
       "text": "Adjusted controller thumbstick deadzone and sensitivity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Slowed overall player running speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted how players react with ledges making it easier to recover when running off one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made floating barrels travel slower in the jungle levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the amount of time a dish cook before it is no longer considered perfect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added mouse support for menu navigation",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Renamed Banana slap to Banana Grabber",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with Dash causing players to slide on walls or edges",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various bugs with scene transitions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue preventing some non-player characters from spawning in online games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the tourist boss was invisible to other clients",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various connectivity issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "To close off with, this weeks highlights are GameByte with a great summary of Cannibal Cuisine on Facebook and also a video of by YouTube channel Stumpt. Fun fact: they inspired us to change one of our recipes names to Banana Grabber.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Rocket Vulture Team –",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
