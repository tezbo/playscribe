  {
   "id": "duck-detective-the-secret-salami-279374@major-2025-03-18",
   "gameId": "duck-detective-the-secret-salami-279374",
   "displayName": "Duck Detective March Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-18T12:15:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Detectives,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been a busy year so far for us, and it's only just beginning! Here's the biggest pieces of duck news:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Duck Detective is coming to both Android and iOS on 9th April! You can find it here on iOS and here on Google Play stores.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game is perfect as a handheld experience, and now finally we can show our grandmas what we do for work and they can play! Give it a try or gift it to your own grandma!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Duck Detective sequel, Ghost of Glamping now has a free demo you can try out over here",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Go give it a go and let us know what you think on the Steam forums :D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Finally, we are continuing to bundle with super awesome duck and detective themed games so keep your magnifying glass at the ready! Our newest bundle is with the wonderful Loco Motive, a detective thriller on a train, what more could you desire? Check out the bundle here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~the Happy Broccoli Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
