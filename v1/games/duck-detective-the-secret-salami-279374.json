  {
   "id": "duck-detective-the-secret-salami-279374@major-2025-05-22",
   "gameId": "duck-detective-the-secret-salami-279374",
   "displayName": "New Game Out Now + Huge QoL Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-22T16:00:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Two big pieces of news",
     "items": [
      {
       "text": "The Ghost of Glamping is out now!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fedoras at the ready! Polish your magnifying glass! Iron that long, sweeping trench coat! Our new Duck Detective game is out now, a brand new standalone no-murder mystery adventure. With CAMPING!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Check out the launch trailer below…!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, we have polished up and fixed Duck Detective: The Secret Salami with a myriad of improvements, these include:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clue spots now turn gray if there is no new information",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Video playback improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed saving issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed end cutscene replay issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "On top of this, the game is currently on it's biggest sale at 30%! So now is the time to dive into the murky pond of delinquency and dredge up the truth!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~Happy Broccoli Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
