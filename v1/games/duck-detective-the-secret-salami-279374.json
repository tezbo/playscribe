  {
   "id": "duck-detective-the-secret-salami-279374@major-2024-11-29",
   "gameId": "duck-detective-the-secret-salami-279374",
   "displayName": "November Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-29T20:01:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there Detectives!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We're busy working away, and we have a few things to share",
     "items": [
      {
       "text": "The Duck Detective Plushie is live on YouTooz now. He's up for 3 weeks, get him before Freddy buys them all! : Get him here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Duck Detective is also available as a physical release on Switch!! Included are stickers, standees and a manual with never-before-seen artwork. It's a limited edition run, so only a finite number remain Grab a copy now here",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're still making good progress on a mobile version of Duck Detective (and have been silently updating the steam version with many of the improvements). Hopefully soon we will have a date for when you will be able to take Eugene with you on the go!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And there's still more to come before the end of the year, so stay in tune for more announcements in December!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again all for being so awesome and allowing us to make fantastic games with a fantastic team!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~ the Happy Broccoli Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
