  {
   "id": "duck-detective-the-secret-salami-279374@major-2024-09-26",
   "gameId": "duck-detective-the-secret-salami-279374",
   "displayName": "September Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-26T17:39:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there Detectives!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have so many things to show and so many exciting things in the works right now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Duck Detective is getting a physical release on Switch!! Included are stickers, standees and a manual with never-before-seen artwork. Grab a copy now here",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also celebrated Happy Broccoli Games' 5th anniversary with lovely friends and lovely handmade gifts!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you all for being so awesome and allowing us to make fantastic games with a fantastic team!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned for more updates in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~ the Happy Broccoli Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
