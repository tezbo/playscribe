  {
   "id": "time-to-wake-up-257932@1.0.2",
   "gameId": "time-to-wake-up-257932",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-15T08:59:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing Time To Wake Up and giving us your feedback! It's really heart-warming and motivating to read how you've experienced the game. With every written review and every word that has been spread about the game, you increase our chances of making another game like this and that truly means a lot! From the bottom of our hearts: thank you so much for your support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've also received some helpful bug reports from you, thank you for that as well! The game has now been updated to v.1.0.2. Here are the patch notes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "V.1.0.2",
     "items": [
      {
       "text": "Added arrow keys + right ctrl as alternate keybinds for movement + jump",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed players getting stuck when backtracking from ToiletBigFan (Toilets)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug with lunchbox puzzle when quickly inserting pieces consecutively (Toilets)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where players would teleport through wall next to the ticket printer (Library)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed backtracking bug with FerrisWheel puzzle (Library)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As mentioned in our previous post, we are planning to add more languages and yes, the porting to Xbox Series X/S and Switch is still happening.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Meanwhile, we keep our eyes glued to your feedback on the Steam forums and our Discord:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
