  {
   "id": "plague-hunters-375743@post-2026-02-08",
   "gameId": "plague-hunters-375743",
   "displayName": "Patch Notes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-02-08T19:22:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We made fixes around the curse system. We discovered a bug with the \"Failed Cure\" curse where the generated chance to fail was always 0% which makes the curse meaningless.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Increased the number of Shrines and Altars in expeditions and the balance between them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue with the \"Failed Cure\" curse where the chance to fail was always 0%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Disabled debug features accidentally left in the game in the main retail build.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
