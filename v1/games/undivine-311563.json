   "gameId": "undivine-311563",
   "displayName": "Patch 1.0.10",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-13T16:09:13.000Z",
   "notes": [
    {
     "title": "New",
     "items": [
      {
       "text": "New icons were added as options to mark the map;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "General changes",
     "items": [
      {
       "text": "Removed a Macula Box before the entrance of the Xelophos boss area;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added several “warning” signs near potentially dangerous areas;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed a bug where newly acquired quests weren't saved if the player died before saving the game;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where life wasn't fully restored when saving the game while under the Poison status effect;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Macula regeneration sparks would spawn endlessly when the Macula gauge was at 1/3 near a Kobold mining a crystal (this is too specific and makes no sense, but trust me on this one);",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
