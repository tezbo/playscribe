   "id": "undivine-311563@1.0.6",
   "gameId": "undivine-311563",
   "displayName": "Patch 1.0.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-10T21:54:33.000Z",
   "notes": [
    {
     "title": "General changes",
     "items": [
      {
       "text": "Slightly increased enemy knockback when attacking it with a sword;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased by 10% the chance for a chest to have items;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased chance for an enemy to drop a Macula regeneration spark;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed a bug where the mask icon was not showing correclty in a certain room regarding a certain hidden Memento;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where a certain item was not removed from the inventory when combining it with another certain item;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the Trial of the Ancestors room’s map was being displayed as a save room;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some major fixes and game breaking issues were already addressed in previous patches.",
       "ps5ProOnly": false,
       "pcOnly": false,
