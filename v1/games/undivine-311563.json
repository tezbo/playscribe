  {
   "id": "undivine-311563@0.14.250113",
   "gameId": "undivine-311563",
   "displayName": "Update 0.14.250113",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-13T21:16:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "After almost three years we can confidently say that we are close! Undivine is almost complete and we are working hard to make it the game we wanted to make. As we need a little more time to finish the game, polish and test, here's a new demo version:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New",
     "items": [
      {
       "text": "Attack an enemy will now push it back a little bit;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "General changes",
     "items": [
      {
       "text": "The base life of some enemies was slightly reduced;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visual improvement in several areas;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Scanlines intensity was slightly reduced;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Scanlines are not active by default;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Recommended” text from Scanlines option was removed;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemis will not be damaged by spikes anymore;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Inventory minimum slots increased: 15 → 18;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keys for keyboard mode were changed. Now the player movement uses the arrow keys and the attack, jump and conjure keys were changed to Z, X and C respectively.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "The rolling sound of Elkhor was STILL playing in some specific occasions after it was defeated. Now it was REALLY fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where sometimes after loading a game after a game over made the music volume to increase.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
