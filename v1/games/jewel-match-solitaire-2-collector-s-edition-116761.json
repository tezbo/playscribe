   "displayName": "Shadowhand Solitaire - Multi-Language Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-17T11:18:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/43351606/afa193882a6afa3257d6f6d873514bf160ed77f3.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now change language for Shadowhand Solitaire on Steam via the options screen.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Supported languages are: English, German, French, Spanish, Italian, Dutch, and Brazilian Portuguese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: at present we have no plans to officially support more languages because we are an indie microstudio. But we welcome fan translations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy playing Shadowhand Solitaire in your chosen language!",
