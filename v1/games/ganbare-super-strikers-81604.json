  {
   "id": "ganbare-super-strikers-81604@1.0.6",
   "gameId": "ganbare-super-strikers-81604",
   "displayName": "Update 1.0.6",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2019-02-09T05:28:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.0.6 is now live. This update is mostly bug fixes and small tweaks to make the game easier to use. The most important changes are:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Redesign of the Change Formation Menu screen to increase readability and make it easier to use with controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Addition of a \"Speed Up\" button to increase the speed of the AI's turn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new type of gamepad with icons for the Xbox One controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Tweaks on AI behaviour.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaks and fixes on controller behaviour in general.: If you enjoy the game and are happy with my work please consider leaving a review on Steam. It really helps small indie developers like myself!: Special thanks to the user Crusher who compiled an extensive list of bugs and posted it on the forums: https://steamcommunity.com/app/419990/discussions/0/1778262124921789573/: Thanks,: Ruben",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
