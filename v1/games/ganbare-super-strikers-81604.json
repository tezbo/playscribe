  {
   "id": "ganbare-super-strikers-81604@1.0.7",
   "gameId": "ganbare-super-strikers-81604",
   "displayName": "Update 1.0.7",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2019-06-09T17:00:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.0.7 is now live. Here is the list of changes introduced in this new version:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an easy mode. If you are having issues winning a match you can change the difficulty mode in the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the experience system. Part of the XP earned by a player is now shared with the rest of the team, to avoid more active players having a level way higher than the rest of the team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Short passes are now ground passes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now quickly select your players by pressing L and R triggers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug where PKs weren't playable with 2 controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes on Japanese localisation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor tweaks and bug fixes.: This is probably the last update I will upload for the game, other than to fix issues. It's been almost a year since I released the game on Steam and with the console versions shaping up nicely is time to start thinking about what's next.: Thank you everyone for playing the game and for your support!: Cheers,: Ruben",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
