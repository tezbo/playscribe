  {
   "id": "ganbare-super-strikers-81604@1.0.7.1",
   "gameId": "ganbare-super-strikers-81604",
   "displayName": "Update 1.0.7.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2019-06-25T15:29:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.0.7.1 is now live. This update is just a hot fix for an issue introduced in the previous version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.0.7 introduced an issue where rival teams didn't level up as you progress in the Story Mode. This now has been fixed and the team levels are back to normal. Apologies for the inconvenience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thank you for your support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ruben",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
