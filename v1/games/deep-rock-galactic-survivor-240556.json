   "announcedAt": "2026-05-06T11:54:38.000Z",
   "notes": [
    {
     "title": "Improvements & Fixes",
     "items": [
      {
       "text": "Fix a bug where Bosco was able to get into a state where he would refuse to pick up eggs in Egg Hunt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a potential crash if reload speed got too high on the Carrier Drone weapon",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix certain stat upgrade unlocks from masteries not having their reward text formatted correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where ‘Equip 2 Favourite Overclocks’ didn’t count Proximity Mines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed more RockDozer audio issues that could potentially cause a crash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where XP cubes could get stuck and remain stationary in the air",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where Gunner Weapon Specialist class mod effect was not dealing damage to enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed “Collect 4 eggs before alien threat level 2” milestone not completing if threat level has gone above 2 at any point in the run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed flickering loading screen when retrying run or returning to menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed OC Afterburner, Frequency Amp, and Marker Lights not counting correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Gear Elite Targeter’s Max HP bonus trigger is changed to when an elite is killed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Brood Nexus Sprout didn’t damage the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where colliders on Cargo Pod, Drop Pod, and the like didn’t block bullets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
