   "id": "animal-well-191435@post-2024-10-22",
   "gameId": "animal-well-191435",
   "displayName": "Minor change to input handling",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-22T19:12:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Input is now accepted from all connected gamepads, regardless of player index. This should result in a smoother experience when multiple gamepads are connected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can even play with multiple gamepads at the same time if, for whatever reason, you wanted to do that.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
