  {
   "id": "animal-well-191435@post-2024-05-20",
   "gameId": "animal-well-191435",
   "displayName": "More fixes!!!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-05-20T18:13:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "-- In rare situations where you missed out on a certain late game event, in previous builds, you now have another chance to access it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- Added an additional point where the speedrun timer flashes on screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- adjusted collider width of fish head by one pixel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- added more detailed error messages for when the game fails to start",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-- fixed missing glyphs in credits in some other languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch, does not fix the startup crash some people have been experiencing, but I am now setup to more easily debug it. If you are one of the people experiencing it, I would greatly appreciate if you could go into the Windows Event Viewer, and share the error details with me! Once again, I'm sorry this has been taking a while and really appreciate everyone's patience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
