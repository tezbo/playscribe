  {
   "id": "epic-mickey-rebrushed-287849@patch-2024-11-26",
   "gameId": "epic-mickey-rebrushed-287849",
   "displayName": "Second patch now live!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-26T14:00:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have just launched a second patch for the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is the changelog",
     "items": [
      {
       "text": "Fixed an issue with extra content movies not getting unlocked correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various quest progression issues from occurring",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the \"An Epic Journey\" and \"Out of my way\" achievements/trophies not triggering correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the \"Blue House\" concept art sketch not being awarded under specific circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed gargoyles that caused mickey to get stuck on them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various Audio fixes and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spelling and localisation fixes and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As a little bonus (maybe a late birthday present?), Trading Cards have been added as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
