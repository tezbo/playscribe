  {
   "id": "bullet-beat-129915@1.3",
   "gameId": "bullet-beat-129915",
   "displayName": "Update 1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-10-07T16:50:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A small but useful update for the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's new",
     "items": [
      {
       "text": "It is now possible to control the ship on the stick, not just on the d-pad (gamepad);",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changes in balance. The game has become easier at all levels of difficulty;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved support for gamepads (previously there were problems if more than one gamepad is connected to PC);",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved performance in Endless Mode;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed small bugs and misprints;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added message about possibility to upload your tracks to the game folder.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
