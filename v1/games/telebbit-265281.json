     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you have been enjoying the launch of Telebbit. Today, October 28, we have updated the game to Ver. 1.03. This version fixes the following bugs:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that prevents game progression when playing a game with the system language set to German.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that prevented some graphics from displaying properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for your continued support. If you experience any bugs, please report them in this thread:Telebbit Bug Reporting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
