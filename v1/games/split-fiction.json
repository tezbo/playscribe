  {
   "id": "split-fiction@major-2025-03-17",
   "gameId": "split-fiction",
   "displayName": "Split Fiction - Update Notes 17/03",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-17T12:04:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have just released an update for Split Fiction. This update aims to fix a number of issues that the community has helped us identify since launch.",
       "ps5ProOnly": false
      },
      {
       "text": "Fix the rolling wheel in \"Royal Palace\" not moving fast enough to complete the puzzle when playing with more than 150 FPS",
       "ps5ProOnly": false
      },
      {
       "text": "Fix the magnetized harpoon in \"Down the Rabbit Hole\" not taking into account camera sensitivity settings for aiming",
       "ps5ProOnly": false
      },
      {
       "text": "Fix not being able to stand inside the big pots in \"The Legend of the Sandfish\" (very important for immersion)",
       "ps5ProOnly": false
      },
      {
       "text": "Fix several minor visual glitches and pops visible during online play",
       "ps5ProOnly": false
      },
      {
       "text": "Improve the tutorial prompts in \"Walking Stick of Doom\" to be more clear about available actions",
       "ps5ProOnly": false
      },
      {
       "text": "Various localization and subtitle fixes across all languages",
       "ps5ProOnly": false
      },
      {
       "text": "If you are looking for someone to play with, join the Hazelight Studios Discord today and find the Mio to your Zoe in the Looking For Game channels!",
       "ps5ProOnly": false
      },
      {
       "text": "https://store.steampowered.com/app/2001120/Split_Fiction/",
       "ps5ProOnly": false
      }
     ]
    }
   ],
