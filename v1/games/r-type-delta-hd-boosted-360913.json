   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "R-Type Delta: HD Boosted Patch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Based on player feedback, we have released an update patch aimed at enhancing the gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The following fixes and adjustments have been implemented",
     "items": [
      {
       "text": "・The pre-Stage 1 cutscene can now be skipped by pressing the START button equivalent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Enemy placement in Stage 3 has been adjusted to more closely match the original version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・To better recreate the original version's gameplay in Stage 3, a 'Slowdown Setting' has been added in the options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Corrections and adjustments have been made to certain in-game cutscenes that were not triggering correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Sound effects have been adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Other minor bugs have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We hope you continue to enjoy this more accessible version of the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
