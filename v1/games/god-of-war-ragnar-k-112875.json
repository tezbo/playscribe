  {
   "id": "god-of-war-ragnar-k-112875@hotfix-2025-04-10",
   "gameId": "god-of-war-ragnar-k-112875",
   "displayName": "Hotfix for Game Launch Issues",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-04-10T20:28:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Add more error checking and logging for NVIDIA Streamline",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Add entries in settings.ini for controlling for NVIDIAStreamlineLog, NVIDIAStreamlineOTAUpdates: NVIDIAStreamlineLog=Off ; Values: Off, Default, Verbose: NVIDIAStreamlineOTAUpdates=On ; Values: Off, On",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When NVIDIAStreamlineLog enabled, a log file in the Save Game directory will be generated and overwritten every launch. If encountering errors, please submit a support ticket including this log.: C:\\Users\\\\Saved Games\\God of War Ragnarök\\sl.log",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When disabling NVIDIAStreamlineOTAUpdates, the driver over the air updates will be disabled. If encountering errors, please try disabling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update the PlayStation Overlay runtime installers to version 4.00",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    }
   ],
