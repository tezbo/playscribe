  {
   "id": "god-of-war-ragnar-k-112875@hotfix-2025-03-28",
   "gameId": "god-of-war-ragnar-k-112875",
   "displayName": "Black Screen Launch Issue Hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-03-28T19:28:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "An NVIDIA Driver Crash/Soft Lock that prevents the game from loading is under investigation. In the meantime, we've implemented a work around for the cause of the crash to change how shader compilation works. This change may cause some micro-stuttering during initial load, but will hopefully avoid the driver crash that prevents game from starting.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please verify files after patching.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
