  {
   "id": "god-of-war-ragnar-k-112875@7",
   "gameId": "god-of-war-ragnar-k-112875",
   "displayName": "Patch 7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-15T18:44:34.000Z",
   "notes": [
    {
     "title": "Updates",
     "items": [
      {
       "text": "Added more detection for corrupted files during content loading with a warning to user to validate files",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where the window location would not be saved upon subsequent launches when running in windowed mode",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where the camera would drift when playing with mouse and alt-tabbing",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issues with volumetric fog looking blocky when playing in 21:9 or 32:9 aspect ratios",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue with interact/evade swapping not working when using SteamInput",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue with on screen prompts not properly reflecting correct button prompts when using Switch controller and SteamInput",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Quick Turn buttons not working with SteamInput",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where bindings using mouse scroll would get unset upon relaunching the game",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved performance on Intel ARC GPUs (has very minor improvement on NVIDIA and AMD)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a number of visual bugs such as the water at the bottom of Alfheim well not appearing properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Note - We recommend validating files after every patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
