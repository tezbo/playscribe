  {
   "id": "god-of-war-ragnar-k-112875@5",
   "gameId": "god-of-war-ragnar-k-112875",
   "displayName": "Patch 5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-04T18:44:48.000Z",
   "notes": [
    {
     "title": "Updates",
     "items": [
      {
       "text": "Prevent crash on game boot due to corrupt or missing files - game will now tell you that there are bad files and ask you to verify installation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Volumetric fog in Realm Between Realms and during dream sequences will now appear properly on NVIDIA 10xx, 20xx, and 30xx cards",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "DualSense controllers will now default to rumble backup when connected wirelessly as haptics are only available with wired connections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achievements will now retroactively unlock when loading save games: Please note: If you reload your save and your missing Achievements do not pop, this is likely due to something causing the Steam API to fail via a temporary block such as a firewall, internet disabled, etc. Please double-check possible blockers if this issue persists after reloading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
