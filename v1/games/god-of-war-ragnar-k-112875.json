  {
   "id": "god-of-war-ragnar-k-112875@major-2025-01-29",
   "gameId": "god-of-war-ragnar-k-112875",
   "displayName": "Update to Edit Appearance Feature & Armor of the Black Bear Set",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-29T16:29:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Tomorrow on January 30th we will be releasing a patch to the PC and PlayStation versions of God of War Ragnarök with a few changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    },
    {
     "title": "Update to Edit Appearance Feature (AKA Transmog System)",
     "items": [
      {
       "text": "For all PlayStation and PC players, the Edit Appearance feature (AKA the Transmog system), will no longer require gear to be fully upgraded to level 9 and will instead be available from the beginning of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "ps5",
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Updated PS4 & PS5 Access to the Armor of the Black Bear Set",
     "items": [
      {
       "text": "After this update, PlayStation 4 and PlayStation 5 players will also get access to the Armor of the Black Bear set (no NG+ save required) via the first available Lost Items chest in new and in-progress saves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    },
    {
     "title": "PlayStation Network Sign-in Bonus on PC",
     "items": [
      {
       "text": "When signed into an account for the PlayStation Network when playing God of War Ragnarök on PC, you will gain access to the Armor of the Black Bear set for Kratos at the first Lost Items chest in the Realm Between Realms (previously only accessible in a New Game+ run) and a resource bundle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc"
       ]
      }
     ]
    },
    {
     "title": "This set includes",
     "items": [
      {
       "text": "Cloak of the Black Bear (Chest)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wraps of the Black Bear (Wrist)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Belt of the Black Bear (Waist)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The resource bundle includes",
     "items": [
      {
       "text": "500 Hacksilver",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "250 XP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For in-progress saves, you will be able to access the armor set and resource bundle in the Lost Items chest after the update is live.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you do not wish to log-in to an account for PlayStation Network while playing God of War Ragnarök on PC, you will still be able to access the Armor of the Black Bear set in a New Game+ run (the same as before).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc"
       ]
      },
      {
       "text": "Signing into the PlayStation Network will now be optional on God of War Ragnarök PC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    }
   ],
