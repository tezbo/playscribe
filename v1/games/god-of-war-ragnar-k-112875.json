       "category": "other"
      },
      {
       "text": "Dark Odyssey Stone Wall Shield",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Odyssey Shatter Start Shield",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Odyssey Onslaught Shield",
       "ps5ProOnly": false,
