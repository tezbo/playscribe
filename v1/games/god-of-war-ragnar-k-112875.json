  {
   "id": "god-of-war-ragnar-k-112875@6",
   "gameId": "god-of-war-ragnar-k-112875",
   "displayName": "Patch 6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-24T12:39:19.000Z",
   "notes": [
    {
     "title": "Updates",
     "items": [
      {
       "text": "Fixed a crash in UI when opening certain Journal pages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash that could happen when controllers get disabled or enabled in rapid succession",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash that would occur in various locations in Vanaheim",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved performance of AMD Zen1 and Zen2 processors in areas where the game was CPU limited",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Increased tessellation in Realm Between Realms back to PS5 quality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Note that the performance issue related to tessellation is resolved in NVIDIA drivers 565.90 or higher",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where lock on would rapidly bounce between targets when using mouse. It will now be more \"sticky\" requiring more effort to change targets",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where attack indicators would not look correct when using frame generation",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where cinematic dialogue audio would be lower volume than intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
