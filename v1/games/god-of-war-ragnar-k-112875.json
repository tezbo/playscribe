  {
   "id": "god-of-war-ragnar-k-112875@9",
   "gameId": "god-of-war-ragnar-k-112875",
   "displayName": "Patch 9",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-20T15:56:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As a gift to everyone who owns God of War Ragnarök, the Dark Odyssey collection is now available in-game at no additional cost!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Inspired by the working name of God of War (2005) and the skin that originally appeared in God of War II as a reward for beating the game on God Mode difficulty, we have brought back the black and gold theme for the anniversary.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Dark Odyssey Collection",
     "items": [
      {
       "text": "Dark Odyssey Armor & Appearance for Kratos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Odyssey Kratos Appearance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Odyssey Armor Set for Kratos (Dark Odyssey Breastplate, Dark Odyssey Bracers, Dark Odyssey Belt)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Odyssey Companion Armor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Odyssey Vestment for Atreus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Odyssey Witch Frock for Freya",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Odyssey Weapon Appearances & Attachments*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Odyssey Leviathan Axe & Dark Odyssey Knob",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dark Odyssey Blades of Chaos & Dark Odyssey Handles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
