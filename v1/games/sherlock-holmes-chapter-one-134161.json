  {
   "id": "sherlock-holmes-chapter-one-134161@1.03",
   "gameId": "sherlock-holmes-chapter-one-134161",
   "displayName": "Patch 1.03",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-12-09T09:15:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.03 for Sherlock Holmes Chapter One is now available on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "In this update we have fixed some major issues related to keys rebinding and AZERTY layout:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed issue which prevents camera movement in certain gameplay sequences",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed bug where players were unable to move a cart in a final scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed issues that caused incorrect HUD messages for AZERTY users: We are aware of some other minor issues related to custom keybinding and plan to address them in upcoming fixes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
