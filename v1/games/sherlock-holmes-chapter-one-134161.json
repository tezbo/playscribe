  {
   "id": "sherlock-holmes-chapter-one-134161@1.01",
   "gameId": "sherlock-holmes-chapter-one-134161",
   "displayName": "Patch 1.01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-11-19T12:45:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.01 for Sherlock Holmes Chapter One is now available on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Here's the list of changes for this update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed crash caused by RGB hardware incompatibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crashes on loading screen \\ after alt-tab when the game is run in Fullscreen + DX12: We are aware of the issue which prevents the investigation of the \"Mother's grave\" and affects certain AMD CPU configs, and we are going to release a second patch to fix this shortly.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
