  {
   "id": "chainstaff-304750@major-2025-09-30",
   "gameId": "chainstaff-304750",
   "displayName": "New Demo Update - Difficulty Modes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-30T15:38:26.000Z",
   "notes": [
    {
     "title": "Updated Demo",
     "items": [
      {
       "text": "Get a taste of the story in ChainStaff! There are now two new story cutscenes at the beginning of the demo, where you can see the origins of the Star Spore invasion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The demo update also has the ability to pick between Easy and Normal difficulty modes. The difficulty is hand-tuned for each level. There will be new attacks and more enemies in Normal difficulty. Easy mode might have more platforms to land on, plus you start with more player shields.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's the list of demo changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cutscenes added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Difficulty modes added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now has 3 Save Slots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Dual Stick controls fully supported",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Better button remapping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game balance changes: Players don't retract ChainStaff on Damage. You now need a full heart to take an extra hit (not just a subheart).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many more balances and game polish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Want to join the Beta Playtest?",
     "items": [
      {
       "text": "Come help steer the direction of the game balancing! I'm slowly finishing up the rest of the game and will be doing playtests soon. Join my newsletter to get in on it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
