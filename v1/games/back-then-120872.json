  {
   "id": "back-then-120872@major-2024-12-21",
   "gameId": "back-then-120872",
   "displayName": "Major Update: Portuguese & Spanish Localization Now Available! 🎉",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-21T17:40:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re excited to share some fantastic news: Back Then is now available in Portuguese and Spanish! 🇧🇷🇪🇸 Whether you’ve been waiting to experience the story in your native language or want to dive deeper into the emotional journey of Thomas Eilian, we’re thrilled to bring this update to you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This major update includes",
     "items": [
      {
       "text": "📝 Full Portuguese and Spanish localization for subtitles and the user interface.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🐛 Some bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your feedback has been instrumental in making these improvements, and we can't thank you enough for your support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you notice any issues with the new localizations or encounter bugs, please don’t hesitate to let us know via the Steam discussions or by leaving a review.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for being part of this journey. We hope these updates enhance your experience with Back Then!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Back Then Team 💙",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
