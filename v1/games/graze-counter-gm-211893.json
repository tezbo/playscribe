  {
   "id": "graze-counter-gm-211893@0222",
   "gameId": "graze-counter-gm-211893",
   "displayName": "Patch 0222",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-02-24T13:01:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The changes in this build are as follows.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added rewind function to the ship select screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Expanded the function of the practice mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added shield at the start of some stages in mission mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a function to return to the mission selection screen from the pause menu during the mission mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a skip function at mission clear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a function to restart in Extra Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Relaxed the correction rate of the counter gauge increase speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new skill to TYPE-6.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased the attack power of TYPE-8 and increased the amount of stars in break mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed the behavior of bits equipped by TYPE-9.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with TYPE-C and increased the amount of stars in break mode3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased the recovery speed of TYPE-E's manual shield.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed so that all ships can unlock Another monde, and the performance after applying Another mode will be displayed on the select screen of the ships.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weakened the barrier used by the last boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the type of ships that can be used in Pacifist mode (TYPE-5, TYPE-6, and TYPE-A cannot be used because they interfere with the mode system)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue in the processing of damage to the enemy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enhanced Laser Maiden 2's overall attack, reduced difficulty increase speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue in which sound effects become louder under certain conditions when acquiring and extending items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed transparency of HUD lower side (only when HUD position setting is TYPE-1)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated some graphics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased remaining ship bonus, secret bonus, and time bonus for destroying bosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue that caused sudden death or shield destruction under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the item acquisition event in the final stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed unintended behavior of the boss on side 2-B.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
