   "gameId": "the-darkside-detective-a-fumble-in-the-dark-109650",
   "displayName": "Update 2.32.378.9106",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-01-30T12:17:29.000Z",
   "notes": [
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "- Issue with dialogue not being in the correct state after Resetting the game, causing softocks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Issue using the Click to Start Menu Issue with a controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Loading Screen Music only playing for a brief second when exiting a Case",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Various Dialogue Choices and Menu issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Case 4: Ticket Booth Translation Issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Restarting a Case while Dialogue is on Screen making Dialogue Choices unable to be interacted with",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Item Hotspots overlapping inventory causing the wrong item to be picked up on smaller screens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Case 6: Cables Hotspot disappearring after picking one up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Case 6: Save/Load making the Science Bench Hotspot layer over Mcking's hotspot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Case 4: Save/Load causing McQueen's hotspot to reappear at his previously position",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Hotspot text not layering above items when dragging them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Case 2: No Door SFX when entering and leaving Nanny Dooley's Room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Raxa Case: Save/Load makeing Raxa's reflection disappear in the first WWW Screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Strange issue with Main Interaction Button if it's not mapped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "- Inventory items missing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
