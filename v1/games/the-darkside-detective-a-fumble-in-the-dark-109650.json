   "id": "the-darkside-detective-a-fumble-in-the-dark-109650@2.66.1626.10",
   "gameId": "the-darkside-detective-a-fumble-in-the-dark-109650",
   "displayName": "Update 2.66.1626.10",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-15T17:47:17.000Z",
   "notes": [
    {
     "title": "Release notes - The Darkside Detective: A Fumble in the Dark update 2.32.1295.10815",
     "items": [
      {
       "text": "The audio filter applied on the pause/options menu in game carrying over when exiting a case.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The ‘loading’ music having a muffled sound to it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PlayStation Controllers Set up having some of the wrong button images on PC Platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc"
       ]
      },
      {
       "text": "Press to Start Screen not detecting PlayStation Controllers until after input on PC Platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc"
       ]
      },
      {
       "text": "Dialogue repeating every time you visit a certain Screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Strange issue with the Screens being cut off",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brightside: Bits Box Interactivity Issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "D-Pad occasionally not working in the Main Menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PS5 Controller not working on most PC Platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Pause being enabled during Black Screen Transitions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some issues with the Interrogation Minigame and Bits Box Minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Small issue with the wrong Hotspots sometimes being layered on top in the Bits Box Minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Being able to place the Figurines anywhere using the Pause Menu on the Final Minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brightside: None of the correct combinations working in the Interrogation Minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Case 6: Not being able to progress past Screen Shakes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clicking \"Continue Investigation\" on any of the 9 Cases causes the first Scene of the Case to briefly flash on Screen before loading the correct Scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PS4 Controller Image not showing when using a PS5 Controller on PC Platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc"
       ]
      },
      {
       "text": "Computer Cursor staying on Screen until the In-Game Cursor appears",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
