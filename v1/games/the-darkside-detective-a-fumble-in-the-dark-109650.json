  {
   "id": "the-darkside-detective-a-fumble-in-the-dark-109650@post-2023-12-05",
   "gameId": "the-darkside-detective-a-fumble-in-the-dark-109650",
   "displayName": "The Darkside Detective: A Fumble in the Dark - Nintendo Switch / PS5 Patch Notes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-12-05T00:32:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey detectives,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released a patch for Darkside Detective: A Fumble in the Dark that fixed some hotspot inconsistencies and placements which could interfere with the players’ inventory, fixed an issue with some achievements not firing, and more. You can read the full patch notes below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Fixed an issue with some achievements not firing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some hotspots inconsistencies and placements which could interfere with the players’ inventory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some dialogue errors and typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some visual and sfx glitches which would appear after a save/load",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where resetting the game caused the Power Button to show in the the Main Menu on Consoles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimisation and improvements to performance and load times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some gameplay blockers where players where unable to progress past certain screens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with remapping controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added some missing localisation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue with the Face Buttons not showing on the PlayStation How to Play Screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixed issues with Restarting a Case taking you to the wrong Case",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with dialogue Choices not saving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed other issues with starting the game from a fresh Save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the slower cursor slower in Case 9",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed not being able to use the Pause Menu in the Christmas Case",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Riv Otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
