   "notes": [
    {
     "title": "Patch Notes (Ver.1.0.2)",
     "items": [
      {
       "text": "Implemented a repair feature to fix save data affected by the issue where the CX Bey customization screen could not be accessed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where certain Bey Challenge Box tasks could not be completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
