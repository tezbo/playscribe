  {
   "id": "beyblade-x-evobattle-369115@post-2026-01-29",
   "gameId": "beyblade-x-evobattle-369115",
   "displayName": "Release!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-01-29T01:34:35.000Z",
   "notes": [
    {
     "title": "Patch Notes (Ver.1.0.5)",
     "items": [
      {
       "text": "\\[New Events]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After defeating Hayate Kuroba and Sui Akizuki in the X Tower Challenge Battle, each character will now appear somewhere on the map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "By talking to them, you can enjoy special conversation events and additional battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new color variations for some DLC parts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "\\[Bug Fixes]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the display of certain X Skills was visually broken.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where displayed damage values became incorrect when dealing large amounts of damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted parameters for certain parts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed coating issues on certain parts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple issues related to online play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed control-related issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor bug fixes and stability improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
