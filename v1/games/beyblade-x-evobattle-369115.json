     "items": [
      {
       "text": "Fixed an issue where the game would stop responding to player input when attempting to access the rankings under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor bugs have also been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
