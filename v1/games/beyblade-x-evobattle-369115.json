   "notes": [
    {
     "title": "【New DLC Added】",
     "items": [
      {
       "text": "Includes 2 additional Beys!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "BEYBLADE X EVOBATTLE DIGITAL BEYBOOSTER VOL.8",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45675529/f5fc7cd1cf4d8df86327128d5c3358a5879bb418.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More freedom to customize your Bey Coating! The second Pattern & Color Add-On Kit is here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "BEYBLADE X EVOBATTLE BEY COATING PATTERN & COLOR ADD-ON KIT VOL.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45675529/15e2bd8d59786a421e9cd2ef8c9d616994111ef6.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
