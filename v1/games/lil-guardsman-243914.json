  {
   "id": "lil-guardsman-243914@major-2023-06-29",
   "gameId": "lil-guardsman-243914",
   "displayName": "Lil’ Guardsman - Demo Access Update 📢",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-29T17:07:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Good day, future Guardsman!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Surprise! - Guardsman Training (demo) will remain available beyond Steam Next Fest!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "NOTE",
     "items": [
      {
       "text": "We've decided to leave the LG demo up so people can continue to discover and share our game. We are, however, leaving it up in its current state, so it won't reflect all the changed based on the great feedback we've gotten this week, so think of it as a time capsule.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎥 Official Trailer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "💬 Official Discord Server",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📎 All Lil' Guardsman links",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you are excited for Lil’ Guardsman’s full release. In the meantime there are a few things you can do:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◦ Wishlist Lil’ Guardsman here on Steam",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "◦ Follow our socials for news, behind-the-scenes content & more",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◦ Tag us on socials when you post about Lil’ Guardsman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "💜 GLHF,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Versus Evil Community Manager – Rezza/Sydney",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
