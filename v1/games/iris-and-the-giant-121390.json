  {
   "id": "iris-and-the-giant-121390@1.1.6",
   "gameId": "iris-and-the-giant-121390",
   "displayName": "Update 1.1.6",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-05-11T13:24:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed the blocker where the player died from a trap during a Challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the blocker where the time expired during a Challenge in Chronos mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the blocker where the player petrified the Ferryman.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the blocker where the player has used a Mirror card and is attacked by a Stone Minotaur.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the blocker where the Imaginary Friend interface was opened at the end of a run and couldn’t be closed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug that allowed the use of a Ladder card on the boss stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where a player would keep a Sign (snake, pig or dog) until it has been replaced by one other. Now it disappears when the run ends.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where Signs were applied during a Challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where it wasn’t possible to exchange the rewards (applied to the next run) at the end of a run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where no stats were displayed in Spanish language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where using a dagger and a whip (that can damage first rank) on a Fire demon would not trigger his effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where the second effect of Magic Power Arrow would not apply.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where no star was earned if the player loses by time expiration during a challenge in Chronos mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hydras demons are now affected by the Wave card.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other small fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
