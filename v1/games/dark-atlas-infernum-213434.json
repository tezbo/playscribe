 "releases": [
  {
   "id": "dark-atlas-infernum-213434@2",
   "gameId": "dark-atlas-infernum-213434",
   "displayName": "Patch 2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-12-20T11:40:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today we are releasing the second patch for Dark Atlas: Infernum!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As we mentioned in the Roadmap, this patch adds new auto-saves as well as an indicator showing when the last save was made. We have also fixed a critical bug that prevented players from moving between chapters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As you can see, we haven't added the map yet. But don't worry, we're working on it and will have it ready as soon as possible!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "\\[ Added ]",
     "items": [
      {
       "text": "1 new save point has been added to Chapter 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "2 new save points have been added to Chapter 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "4 new save points have been added to Chapter 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an indicator showing when was the last save point made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "\\[ Changes ]",
     "items": [
      {
       "text": "The default voice language will now depend on the system language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The light symbols in Chapter 3 will now appear after finding the Resolutive Poem.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "\\[ Fixes ]",
     "items": [
      {
       "text": "Fixed an issue related to Steam Cloud saves.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue that forced all game audio to Mono instead of Stereo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could cause the player to fall into the void in Chapter 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the first auto-save in Chapter 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where you could get stuck in Chapter 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused death phrases to ignore volume settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players could not move.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the same scene was loaded multiple times, affecting performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the mouse pointer was enormous.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where the chase music in Chapter 4 would cut off abruptly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a visual glitch whereby some artefacts were visible through the security cameras.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue when starting a new game it loads the \"Point and click\" mode for accesibility",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "~ Night Council Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
