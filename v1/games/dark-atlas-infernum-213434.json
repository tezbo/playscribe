  {
   "id": "dark-atlas-infernum-213434@1",
   "gameId": "dark-atlas-infernum-213434",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-24T21:10:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today we are releasing the first patch for Dark Atlas: Infernum, which includes a more balanced Prologue, QoL improvements, and fixes for several bugs that we missed before launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "\\[ Added ]",
     "items": [
      {
       "text": "A couple of save points have been added to the Prologue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added clues for the first time you can use the Clypeus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A new musical theme has been added during a cutscene in Chapter 3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Death phrases have been added in chapters 2 and 3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Inactivity phrases have been added in chapter 4.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A new save point has been added in chapter 4.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "\\[ Changes ]",
     "items": [
      {
       "text": "Depth of Field will now be disabled in the EndGame Cinematic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The visibility of access to the Calavernary in Chapter 1 has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The visibility of the Chess Pieces Chest in Chapter 2 has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased volume when rotating the rams in Chapter 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The position and rotation of all save points have been adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed a couple of unnecessary interactions in Chapter 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The VFX when unlocking doors using the Clypeus will now only be displayed once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "\\[ Fixes ]",
     "items": [
      {
       "text": "Radio Subtitles will no longer reappear if you resume the game outside of radio range.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The \"Continue\" and \"Load Game\" buttons will now be hidden when all saves are deleted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with persistent values when exiting the options menu using the Escape key.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused some events not to trigger when using the Clypeus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that allowed the player to move with the inventory open.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that displayed a phrase in Spanish when using English subtitles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in Prologue where a collision would reactivate after loading an autosave.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in Prologue where starting a cutscene while crouching caused the player to noclip into the void.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in Chapter 2 that causes “Head Bob” setting to be reactivated after exiting a puzzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in a Chapter 2 cutscene with screen resolutions higher than FHD.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in Chapter 3 that prevented players from entering the bathroom after loading an autosave.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in Chapter 4 that caused players to have to return to the main menu after dying in order to continue the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in The Estate where the Spanish voice cut off before the end of a cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several visual glitches during the credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "~ Night Council Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
