  {
   "id": "dark-atlas-infernum-213434@post-2025-11-28",
   "gameId": "dark-atlas-infernum-213434",
   "displayName": "Small fix for Chapter 2 (saved games)",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-28T08:53:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We would like to thank you for your help and reports regarding the issue with saved games in Chapter 2. Due to an error in the object IDs, saved games prior to the patch stopped working, but now with this update, both saved games before and after the patch should load without any problems. We apologise for the inconvenience caused and thank you for your patience and help in sending us your saved games so we could review them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
