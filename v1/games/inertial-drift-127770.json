   "id": "inertial-drift-127770@major-2021-11-03",
   "gameId": "inertial-drift-127770",
   "displayName": "Second Update Available Now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-11-03T16:00:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We promised you updates, we promised you new cars … and so the time has finally come for us to announce that the second update is available to play now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It wouldn’t be an Inertial Drift update if it didn’t include a new car, right? Get ready for the HP Katana XT!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What are you waiting for? Get playing with the latest free update, it’s only a month until the next one! And you know what that means … exactly, more new cars are coming your way very soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Check out the trailer for the Second Inertial Drift Update here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
