  {
   "id": "inertial-drift-127770@23.09.20",
   "gameId": "inertial-drift-127770",
   "displayName": "Patch 23.09.20",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-09-25T11:07:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Drifters,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been overwhelmed by your enthusiasm and support for Inertial Drift over the past couple of weeks. Thanks to everyone who has provided thoughts, feedback and ideas as to how we can improve the game. We will assess all of these and will look to make improvements to the game in subsequent updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "For the time being, a smaller update is now live on Steam",
     "items": [
      {
       "text": "Adjusted the difficulty of the events in several Challenges and Grand Prix Mode. Including those for Dragon, Chrono, 7D, Jet Z, Bullet, Jester, Gecko RX and Gladio.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added the ability to Finish Event early from the pause menu in Endurance events after a medal has been achieved.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Happy Drifting!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "PQube & Level 91 Entertainment",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
