      }
     ]
    },
    {
     "title": "Here's a new update v 1.4 with some small changes",
     "items": [
      {
       "text": "-Added: Stats counter for some achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can see your unlock progress in the Main Menu - Trophy room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Fixed: bug with some Achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The stats were only counted if the player died or finished the game. But if you paused the game and went to the main menu, they were not counted for some achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-A few minor bugs and issues fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Happy Gaming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "@FobTi",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
