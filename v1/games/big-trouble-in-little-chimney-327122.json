  {
   "id": "big-trouble-in-little-chimney-327122@1.1",
   "gameId": "big-trouble-in-little-chimney-327122",
   "displayName": "UPDATE 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-20T18:04:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ho Ho Ho!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's a NEW update v1.1 with some important changes. I hope you enjoy it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-AddedNEW lvl-up upgrade for bigger presents opening zone",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added NEW lvl-up upgrade for increase weapon range",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added NEW lvl-up upgrade for faster DASH recharge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added NEW lvl-up upgrade for Pets: X - Collar (fires every 3 sec. on nearby enemies)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Changed and completely redesigned shooting system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now, You are only slower if you hold down the fire button. The old system was based on sprite animations, so the player was slowed down until the animation finished. This resulted in enemies hitting the player more often.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Changed: Faster Reloading and Firerate speed for Bazooka and Crossbow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed: Krampus HP bar in Hard mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed: A few minor bugs and animation issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun, folks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "@FobTi",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
