  {
   "id": "gnosia-117988@post-2022-01-25",
   "gameId": "gnosia-117988",
   "displayName": "Provisional Fix for Gnosia Display Bug",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-01-25T10:59:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Regarding the bug preventing some character images from displaying properly on certain operating systems, we have uploaded a closed beta build for the version of the game currently available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Branch: closed_beta",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Password: 68387392gnocb",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you are unable to play the game due to display errors, please try switching to the \"closed_beta\" branch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[How to change branches]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1: Open Properties for Gnosia from your Steam Library.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2: Input the above-listed password into the beta text input field and press \"Check Code\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3: Select \"closed_beta\" from the Beta tab and close Properties.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This should solve the problem for most users who have encountered said errors. If you still experience bugs or other errors, please report them on the bug report thread. Thank you very much for your patience and cooperation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Playism",
     "items": [
      {
       "text": "Visit the Playism Website",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
