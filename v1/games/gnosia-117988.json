  {
   "id": "gnosia-117988@major-2022-03-03",
   "gameId": "gnosia-117988",
   "displayName": "Update Notes (3/3/2022)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-03-03T04:08:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please find the list of fixes and adjustments included in the update below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Correction/adjustment of some localized text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The bug causing the screen to go black when gameplay starts has been fixed, with the \"save setting\" file properly regenerated.: *When resuming play, the name of the saved data will be temporarily rendered blank, but the game can be resumed normally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A separate vsync-enabled build is now available for players who prefer a version with no framerate limit.: Applicable branch: Closed Beta: Pass: 68387392gnocb: *There may be some issues with cursor movement in some environments with the vsync-enabled version of the build. If this occurs, please use the default build instead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you continue to enjoy Gnosia.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Playism",
     "items": [
      {
       "text": "Visit the Playism Website",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
