  {
   "id": "octopath-traveler-0-358535@1.0.7.0",
   "gameId": "octopath-traveler-0-358535",
   "displayName": "Update 1.0.7.0",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-03-05T09:28:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[Release Notes]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the number of people able to be trained at the training ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Now able to fight a specific boss again (activating the strange monument will respawn it)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved overall game performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where, during a specific boss battle, the enemy's HP could not go lower than one and thus it could not be defeated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where certain characters' post-battle voice lines would not play properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where certain equipment descriptions listed incorrect effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where, under certain circumstances, using the \"form party\" feature during the main story would render you unable to complete the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the maximum amount of influence could not be attained under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where broken enemies could not be dealt damage under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where you were temporarily unable to use nut-related items under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where, if you failed to use an item during battle due to paralysis, that item would still be consumed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
