   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Our team at Total Mayhem Games has been working relentlessly over the past few months to elevate We Were Here Forever.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just released version 1.2, containing the following changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "DLSS support! Turn on DLSS with an eligible NVIDIA video card and enjoy significantly enhanced performance and smoother gameplay, all while maintaining superb image quality.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Texture Streaming enabled! Texture streaming allows better memory consumption with better loading times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reworked Sound FX! The team has done an extra pass on some of the most noticeable sound effects in the game, and a lot of them have been completely reworked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Zoom factor of the zoom button has been increased, making it a lot easier to spot something in the distance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Patch 1.2 has been checked for the Steamdeck for optimal performance!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
