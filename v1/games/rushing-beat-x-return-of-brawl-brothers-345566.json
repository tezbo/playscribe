  {
   "id": "rushing-beat-x-return-of-brawl-brothers-345566@post-2026-04-03",
   "gameId": "rushing-beat-x-return-of-brawl-brothers-345566",
   "displayName": "Notice Regarding Gameplay Adjustments and Bug Fixes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-04-03T11:01:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released an update today to adjust gameplay content and fix known issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the behavior patterns of certain enemies in \"EASY\" and \"NORMAL\" difficulty modes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "\\",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug in certain areas where enemies could move outside of the combat area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed other minor bugs and improved overall stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We remain dedicated to the ongoing support of this title to ensure you can enjoy the world of RUSHING BEAT X for a long time to come.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
