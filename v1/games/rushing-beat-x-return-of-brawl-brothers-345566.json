   "displayName": "Fix for Stage 9 Progression Issue",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-03-20T07:31:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released a fix for a progression-blocking bug identified in Stage 9.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Issue: Game would freeze (softlock) during the Stage 9 boss fight when an enemy hit the central object.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Status: Fixed in the latest update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We apologize for the trouble and appreciate your patience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
