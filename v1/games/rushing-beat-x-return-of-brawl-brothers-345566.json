  {
   "id": "rushing-beat-x-return-of-brawl-brothers-345566@major-2026-06-25",
   "gameId": "rushing-beat-x-return-of-brawl-brothers-345566",
   "displayName": "Free Update: VS MODE is now available!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-25T14:00:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Content Update Is Now Live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Challenge Your Friends in the Brand-New 2-Player \"VS Mode\"!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Introducing VS Mode",
     "items": [
      {
       "text": "This mode is dedicated entirely to local 2-player PVP , featuring all seven playable characters. Yes, same-character match-ups (mirror matches) are fully supported—the second player will simply fight with a distinct color variation! Players can choose from six unique stages , ranging from a flat ring built for a good honest brawl , to a hazard-filled subway tunnel or a high-security jail. Since character controls and performance remain identical to the main game, VS Mode offers the perfect training ground. Test your hard-earned skills against a friend, or take the devastating techniques you've perfected in VS Mode back into Story Mode —the choice is yours! Grab a friend or family member, and jump into the action-packed, side-scrolling brawler fun with electrifying combos!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
