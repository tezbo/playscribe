  {
   "id": "paperhead-276028@48",
   "gameId": "paperhead-276028",
   "displayName": "PATCH 48",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-15T12:40:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey guys!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been busy fixing bugs, improving performance!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several updates have rolled out since launch, bringing optimizations, fixes for progression-blocking bugs, and some quality-of-life improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's what's changed!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PERFORMANCE & STABILITY",
     "items": [
      {
       "text": "a fckton of optimizations!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "a bunch of small bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "PROBABLY fixed the game crashing bug (it's on Unity's part, I'm trying my best here to duct-tape a fix for it)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "GAMEPLAY & QUALITY OF LIFE",
     "items": [
      {
       "text": "added an option to completely disable gamepad detection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added a dialogue skip button for levels you've already finished once",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fixed physics objects phasing through walls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed slow-motion ability stopping after killing 2 enemies at once",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "disabled bombs-to-pickups collision",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "removed propjump from Survival Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed the Survival Mode time exploit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "LEVEL & SOFTLOCK FIXES",
     "items": [
      {
       "text": "level 3 jumppad softlock fixed, along with a few other softlocks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "level 17 softlocks fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "level 11 water no-collision bug fixed + last door not working fixed too + fish bug fixed (the one where you can somehow find yourself behind it)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "level 10 boss died but not actually bug fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "drone 0 clipping out of bounds on slide fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "weird elevator bug fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "THANK YOU FOR PLAYING!",
     "items": [
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/2680280/PAPERHEAD/?curator_clanid=26684285\"]We're continuing to work on PAPERHEAD, and your bug reports and feedback have been incredibly helpful!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any more issues, please keep reporting them. We're reading everything and will keep on fixing stuff!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "THANK YOU FOR SUPPORTING PAPERHEAD! 📦",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
