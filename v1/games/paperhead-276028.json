  {
   "id": "paperhead-276028@52",
   "gameId": "paperhead-276028",
   "displayName": "Update 52",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-11-06T13:03:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update v52 is here! This time we've added a third-person mode and an experimental endless procedural map option. We've also made some improvements to existing mechanics and fixed a few bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's new",
     "items": [
      {
       "text": "Third-person mode added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Endless procedural map option added (alpha version)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved nuke (now destroys shields)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reworked ghost character flying",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A few bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The endless procedural map option is still in alpha, so let us know if you run into any issues!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks for playing PAPERHEAD and sharing your feedback. We're continuing to work on the game, so keep letting us know what you think.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "See you in the next update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
