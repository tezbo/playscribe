  {
   "id": "paperhead-276028@50",
   "gameId": "paperhead-276028",
   "displayName": "Patch 50",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-22T15:08:32.000Z",
   "notes": [
    {
     "title": "v50 Patch Notes",
     "items": [
      {
       "text": "golden buddy character is now cost 50 gold coins and 5000 normal ones",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "more optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "if u on fire u can now extinguish yourself by healing or using serum (super bandage boy can now survive in fire for 3 seconds)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "lowres icons bug fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "perncil sharpers are now detecting if you can use them a bit differently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added more music to survival",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "lore counting fixed on few levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "lvl11 (the sewer one) soft lock fixed. the one where when u die in sewer toxic goo you lock urself forever",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UI fixes for different resolutions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "mouse scroll wheel can now be rebinded",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thanks for playing PAPERHEAD and for all your feedback and bug reports!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
