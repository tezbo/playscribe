   "id": "paperhead-276028@major-2026-10-28",
   "gameId": "paperhead-276028",
   "displayName": "UPDATE №1: Akimbo, Wave Survival and Nightmare 1!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-28T09:33:28.000Z",
   "notes": [
    {
     "title": "Hey everyone!",
     "items": [
      {
       "text": "UPDATE №1 (v51) is here! This time we've added a new wave survival mode, a new difficulty, dual-wielding, and more ways to play around with your weapons. There are also some changes to combat mechanics and a bunch of smaller fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's new",
     "items": [
      {
       "text": "dual-wielding (akimbo)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new wave survival mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new difficulty \"nightmare 1\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "death cam",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "more weapon animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "spin weapons button",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "parry rework (now only first few frames of erasing animation counts as parry, holding wont work anymore)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "incinerator alt-fire added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new game button to restart campaign without guns and clips and upgrades",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "statistics screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "add small fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks for playing PAPERHEAD and sharing your feedback! We're continuing to work on the game, so keep letting us know what you think.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "See you in the next update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
