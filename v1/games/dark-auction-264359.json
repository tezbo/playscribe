  {
   "id": "dark-auction-264359@major-2026-01-21",
   "gameId": "dark-auction-264359",
   "displayName": "Major Demo Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-21T15:15:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The free demo has been updated today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45172921/5bf1aa8f5236940c23224ab0dcadfffa055767f7.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Previously available only up to the Prologue, the demo can now be played all the way to the end of Chapter 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This major update includes the long-awaited Auction segment, offering over 3 hours of gameplay!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Auction segment is divided into four stages, so be sure to give it a try!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45172921/dca1845aac0ba6ea655046e55eaa5ce18156db97.png\"][img src=\"{STEAM_CLAN_IMAGE}/45172921/db7ba4ad9264c2714a3d2293b7cd0e45c1881eb1.png\"][img src=\"{STEAM_CLAN_IMAGE}/45172921/b68486f20fb985e464894f7dfb8ef3b988b25535.png\"][img src=\"{STEAM_CLAN_IMAGE}/45172921/a027a22bd0a756031834102194aba6271ecf5871.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "▶ Try the Dark Auction Demo here",
     "items": [
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/2363180/_/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We look forward to hearing your reviews and feedback!! ✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On the Izanagi Games Steam page, we regularly share news about upcoming titles, in-game events, and sales.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
