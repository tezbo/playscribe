  {
   "id": "dark-auction-264359@major-2026-02-27",
   "gameId": "dark-auction-264359",
   "displayName": "Update Notice (February 27, 2026)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-27T08:00:22.000Z",
   "notes": [
    {
     "title": "New Features Have Been Added to Dark Auction!",
     "items": [
      {
       "text": "This update adds new features that are unlocked after completing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If you already have a cleared save file, you can check out the new features from the title screen after updating.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45172921/b0f712c4a8ba71d7c57dff37938df37755f539c9.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Chapter Select",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Start playing from the beginning of any chapter in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Gallery",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "View illustrations used in event scenes from the main story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In addition to the new features, the artwork displayed on Edgar’s floor has been updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We have also applied minor bug fixes and overall improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "To ensure the best possible experience, we kindly ask that you update the game to the latest version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If you encounter any issues or have questions regarding game progression, please contact us via the community forums or reach out to our customer support team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/2363180/_/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
