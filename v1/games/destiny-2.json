   "id": "destiny-2@major-2026-06-09",
   "gameId": "destiny-2",
   "displayName": "Destiny 2: Monument of Triumph Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-09T17:00:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Destiny 2: Monument of Triumph Update is available to all players. A new set of Triumphs guides you across Destiny 2 activities, turning familiar moments into a personal journey with new rewards to earn.",
       "ps5ProOnly": false
      },
      {
       "text": "Pantheon returns with rotating raid bosses and modifiers, Sparrow Racing League makes its D2 debut with classic tracks and new maps, Distortions send you back to key destinations, Heavy Metal adds the Cabal Behemoth and vehicle mayhem, and a unified Director brings activities into one place.",
       "ps5ProOnly": false
      },
      {
       "text": "New subclass updates, armor set bonuses, and access to past Season artifacts give you more ways to refine your buildcrafting as you chase those goals.",
       "ps5ProOnly": false
      }
     ]
    }
   ],
