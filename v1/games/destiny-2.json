  {
   "id": "destiny-2@post-2020-11-19",
   "gameId": "destiny-2",
   "displayName": "All New Raid - Deep Stone Crypt",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2020-11-19T22:09:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Below the frozen tundra of Europa lies the Deep Stone Crypt. For decades it has remained dormant. Your fireteam cautiously approaches, weapons raised, and the final plan is set in motion. Unique rewards await those who can triumph in its enigmatic depths.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tune-In Nov. 21 @ 10am PST and witness one team become legend.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't miss the 'Race To World First' featuring the all-new Beyond Light Raid: Deep Stone Crypt.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
