 "releases": [
  {
   "id": "sanya-189157@major-2024-03-10",
   "gameId": "sanya-189157",
   "displayName": "First update after launch",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-10T20:49:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The first week after SANYA's release has passed! Thanks to everyone who played, and gave feedback. Your kind words tell us that the 4 years spent developing the game were worth it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Today we're sharing our first update! Here's what's new",
     "items": [
      {
       "text": "SANYA is now available on MacOS!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug that made it hard to dial numbers on the phone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where the mini-game with the phone would freeze after the first phrase and not allow further progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Saves are now showing correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We're still working on a bug where sometimes you can't pull the Punpkin out of the tree roots . If you come across this issue, please email us at helpnodegames@gmail.com.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If you find any other bugs, please let us know wherever you can: here in the comments, game discussions, on Twitter, or via email.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sending everyone hugs, wishing you a fantastic week, and may Pumpkin always be by your side!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
