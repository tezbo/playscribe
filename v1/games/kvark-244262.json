       "text": "Folders in collectables are now expanded by default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added setting to invert inventory scrolling direction",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Smoking cigarrets now does consistent damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
