  {
   "id": "kvark-244262@0.6.12.59",
   "gameId": "kvark-244262",
   "displayName": "Update 0.6.12.59",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-01T21:36:31.000Z",
   "notes": [
    {
     "title": "Hey everyone",
     "items": [
      {
       "text": "This is just a small update to fix some bugs we encountered after release of the second chapter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you to everyone who reported bugs, we couldn't have fixed them so quickly without you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Weapons are saved correctly when you die after loading from level selector",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added preview to last save machine",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Elevator doesn‘t deal damage now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "One secret was made considerably easier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Camera shake plays correctly at the start of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cables should no longer spawn underground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "All paintings are displayed correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Acid in C2L3 deals damage now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some buttons are all caps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved font of censored text to be more clear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Best time is now correctly displayed",
