   "displayName": "Small patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-04T13:56:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We recieved a few reports about bugs so we fixed them.",
       "ps5ProOnly": false,
