  {
   "id": "vanishing-starlight-395337@1.0.3.001",
   "gameId": "vanishing-starlight-395337",
   "displayName": "Patch 1.0.3.001",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-31T06:20:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version V1.0.3.001 has been released. The primary fixes are as follows:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the boss in the Kingdom of Zhaoge would get stuck after appearing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the boss in the Kingdom of the Hanged would get stuck after appearing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Slightly increased the amount of Deuterium Fluid recovered after attacking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slightly reduced the difficulty of aerial bosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A Note from the Developers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you all so much for your incredible support, love, and feedback. As a small studio with limited manpower, we know our debut title still has many shortcomings, and we truly appreciate your patience and understanding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
