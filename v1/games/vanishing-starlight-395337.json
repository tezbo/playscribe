  {
   "id": "vanishing-starlight-395337@1.0.3.006",
   "gameId": "vanishing-starlight-395337",
   "displayName": "Patch 1.0.3.006",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-08T09:25:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you all for your valuable feedback. We have implemented a round of fixes and adjustments based on the reports received so far.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The details are as follows",
     "items": [
      {
       "text": "Optimizations & Adjustments (Ref)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Combat Experience: Optimized the overall combat feel and responsiveness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mini-map Improvements: Added map markers for Memory Shards and key NPCs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes (Fix)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visuals: Fixed an issue where certain skills of the monster \"Calamity\" would abnormally generate visual effects after the player's death.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Movement: Fixed a glitch where pressing the dash button while opening a UI screen caused abnormal player movement speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level Design: Removed the Memory Shard interaction switch in the High Priest's room within the Chronicles/Odyssey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collection Room: Resolved display issues with items in the Collection Room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collisions: Fixed a bug where abnormal collision volume changes for \"Five Elements\" (or \"Pentameter\") monsters caused them to get stuck in walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Environment: Fixed an issue causing an abnormal black screen when entering specific areas in certain scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Interactions: Fixed a bug where certain switches became non-interactive after being activated multiple times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achievements: Resolved an issue that prevented certain achievements from unlocking properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
