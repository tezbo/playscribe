  {
   "id": "ebaseball-pro-spirit-393762@1.2.0",
   "gameId": "ebaseball-pro-spirit-393762",
   "displayName": "Update 1.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-11T01:14:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "■ System",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of Supported Languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this update, Traditional Chinese and Korean have been added as selectable languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can change the language from the title screen after launching the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Change to Menu Name",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The English menu item previously labeled “Questions” has been renamed to “Contact Us.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ WORLD CHAMPIONSHIP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fix for Title Display Issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A consistency issue with the title “Nuclear Warhead” where the English name change",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "was only applied to in-game imagery has been fixed, and the English name is now “Hammer”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "across all in-game text and imagery.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fix for Displayed Players on Opponent Teams",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In some cases, depending on the Team Edit settings of both teams, the lineup shown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "was different from the one actually configured. This has now been corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that applying this update will invalidate any suspended save data from games saved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "prior to the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
