  {
   "id": "secret-paws-cozy-offices-348838@major-2025-10-14",
   "gameId": "secret-paws-cozy-offices-348838",
   "displayName": "Camera Movement Update + New Game Announcement",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-14T13:36:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I'd like to announce that we've added an update that now allows you to move the camera using just the mouse. After listening to community feedback, we realized this feature was highly requested. Thank you to everyone who took the time to give us feedback!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We'd also like to announce that the demo for our new game, Secret Paws - Cozy Apartments, is available and currently participating in Next Fest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/3396640/Secret_Paws__Cozy_Apartments/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'd love for you to play it and add our new game to your Steam wishlist.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
