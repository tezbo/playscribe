   "announcedAt": "2025-08-29T12:23:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Our first patch is live! 🎉 The demo launch went super smooth, no game-breaking bugs in sight! This update is all about small fixes and improvements. Thanks to all players for jumping in and sharing feedback! ⭐",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changed",
     "items": [
      {
       "text": "Quickreplay cannot be used during sequences or in option screens (to prevent unexpected behaviour),",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Challenges now indicate if the level can be completed with less shoes or if the challenge is exactly the lowest possible shoecount,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shoe count bubble showing the combined sum of all shoes on the pile and on the feet,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Campfire to be easier to hit,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixed",
     "items": [
      {
       "text": "Quickreplay sometimes showing success phrase,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Quickreplay not resetting timer,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Shoes not counting as hit if the same shoe touched ground in the last round,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Shoe count bubble showing up during success overlay,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved shoe pooling to improve performance on low end devices,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
