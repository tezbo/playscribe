  {
   "id": "fallen-city-brawl-172817@6",
   "gameId": "fallen-city-brawl-172817",
   "displayName": "Patch 6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-31T20:48:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/41147506/6b5840e9853bed9c854d1c5b20850ed5c4d46a46.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update moves Fallen City Brawl to v1.1 and introduces new Special Stages, unlockable character palettes, localisation support, increased difficulty settings, combat improvements and multiple bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some of the features below are unlocked following stage and game completions. These aren't retroactive and are triggered on new completions after this update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is the largest update since Fallen City Brawl's release, with new content, improved balance and stability and new reasons to return to and complete the game. Thank you for supporting Fallen City Brawl and we hope you enjoy v1.1!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Special Stages",
     "items": [
      {
       "text": "Two new Special Stages have been added, accessed via arcade cabinets within Stages 1 and 7. These become unlocked by completing each stage following the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Unlockable Character Palettes",
     "items": [
      {
       "text": "Each playable character now has 9 unlockable colour palettes, with one new palette being available to all characters following the update, and the rest unlocked incrementally by completing the game. Unlocked palettes can be selected using Up and Down on the character select screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Localisation Support",
     "items": [
      {
       "text": "Added support for the following languages : Japanese, Korean, Simplified Chinese, Traditional Chinese, French, German, Spanish, Brazilian Portuguese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Languages can be selected from the title screen menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Difficulty Modes",
     "items": [
      {
       "text": "Three difficulty modes are now available; easy, default and hard.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Special Move Gauge",
     "items": [
      {
       "text": "A new Special Move Gauge (the blue SP bar beneath the health bar) has been added. Special moves now consume SP rather than health. When the gauge is low, special moves become much less effective and the combo window becomes smaller. The SP gauge refills over time, and refills quickly with use of 'normal' attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Enemy Palette Variations",
     "items": [
      {
       "text": "Additional colour palette variations have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Weapon Handling Improvements",
     "items": [
      {
       "text": "Players no longer drop additional weapons like bats, swords and hammers when taking damage, if they remain on their feet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Stage-End Screen and Game-End Updates",
     "items": [
      {
       "text": "The stage-end results screen now visually displays the number of Chaos Ninjas defeated during the play-through. The end of game credits sequence can now be skipped after first viewing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Score & Leaderboard Balancing",
     "items": [
      {
       "text": "Coins are no longer retained between levels, to improve score balancing. To reflect the change this makes to scoring, the Steam leaderboard has been reset. The original leaderboard can still be viewed with a toggle in the 'Steam Leaderboard' option on the title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Multiple bug fixes and stability improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
