  {
   "id": "fallen-city-brawl-172817@3",
   "gameId": "fallen-city-brawl-172817",
   "displayName": "Patch 3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-08-20T00:40:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone, this update includes additional bug fixes, an increase to the size of the area a 'Ground Pound' attach can be triggered, and some initial work to further develop the game's sound effects. Details below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A further update will follow later this week, focused on boss battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers! Mike",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "increased the horizontal area a 'Ground Pound' can be triggered within when enemy on floor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "fix to prevent shotgun enemy from being able to shoot player from off-screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fix to prevent Clay's shotgun impacting enemies positioned much higher/lower in playfield than Clay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fix to address bug where pressing 'skip' between stages repeatedly could delay next-stage start.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Visual",
     "items": [
      {
       "text": "fix to blue attack hit explosion effect appearing in incorrect position when enemy is hit while being juggled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Sound effects",
     "items": [
      {
       "text": "fixed enemy killed sound effect not playing in some circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "added greater variety in enemy killed sound effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fix to motorbike sound effect only playing once",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "added greater variety in motorbike sound effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added laughter sound effect for hammer enemy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "increased volume of raising shutter sound effect stage 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "reduced volume of ninja sword-slash sound effect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
