  {
   "id": "fallen-city-brawl-172817@patch-2025-09-03",
   "gameId": "fallen-city-brawl-172817",
   "displayName": "Patch no.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-09-03T21:21:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch includes fixes and improvements across a range of areas identified by players - thanks for all the feedback received so far! - Mike",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added 'danger' signs at screen-edge to give warning of where vehicles will enter the screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "increased the pick-up range when walking over collectables eg ammo crate, cash, gems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "added ability to drop a held collected weapons/replace held weapon by picking up a new one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added brief slow-motion effect when defeating a boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fixed issue preventing later bosses being impacted properly by player 'Super' attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed collision between falling burning beams and player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed spelling error in Ricco's bio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "removed purple flame effect being applied to boss characters due to size discrepancy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed issue where wolf wouldn't attack in sections of the gym stage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed issue where heart icons appeared persistently in the gym stage when playing as Natasha",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fix to prevent repeated Clay reload animation which could occur when stage 1 boss appeared",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fix to timing of Clay reload animation / minor improvement to reload animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
