  {
   "id": "kingdom-of-night-117531@3",
   "gameId": "kingdom-of-night-117531",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-24T07:27:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We just released a new Kingdom of Night build!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased level cap to 22. Updated UI to properly handle leveling past 20. Ensure that you can spend all of your skill points.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added “Remove Player 2” option to the pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Strawberry tutorial now appears after charging the Obol, explaining its use",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Two new shops added to the Mall area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When using mouse targeting with Sorcerer/Necromancer, player now teleports to the mouse location.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Spider Silk appears on the hospital reception desk after defeating Lilith (allows completing the Boy Genius Quest chain if player has been locked out of Nod)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Floor numbers now appear on the Insect Burrow map to make navigation easier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated magic tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hopefully fix multiple issues where the game fades to black at the end of a cutscene and then never fades back in.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hopefully fix multiple issues where you can teleport out of bounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mouse no longer controls both players when playing with the keyboard & a controller",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Knight Prayer ability now functions as described",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players with Retaliation ability no longer get stuck inside Maneater enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix issues with control binding UI crashing/forgetting bindings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where you could leave Jimmy and Gramps on the cliff and reenter the mines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "No more infinite “Michael’s Brew,” Michael properly speaks to the player after drinking in the tavern",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
