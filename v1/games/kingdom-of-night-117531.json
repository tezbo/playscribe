  {
   "id": "kingdom-of-night-117531@6",
   "gameId": "kingdom-of-night-117531",
   "displayName": "Update 6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-18T03:15:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you're still enjoying your night in Miami, AZ! We made a small update to the game recently. Please see the patch notes below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved performance when there are many enemies and projectiles on screen at the same time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed many small typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where exiting the sewer by the school exterior would trigger two cutscenes and lock the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with mole dialogue that would lock the player in the “got item” animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with Black & White TV cutscene not starting: If you like Kingdom of Night, please consider giving it a review! As always, thank you everyone for all of your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
