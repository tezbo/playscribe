  {
   "id": "kingdom-of-night-117531@4",
   "gameId": "kingdom-of-night-117531",
   "displayName": "Update 4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-02T01:32:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As we mentioned in the previous update, the game supports downloading fan translations from Steam Workshop.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "It is now possible to upload translations to Steam Workshop directly using a special UI in the main menu of the game. For more details see the pinned discussion post.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "While the main goal of this system is to translate the game into other languages, you are more than welcome to modify the game's text in other ways and upload it. I have a few funny ideas myself.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have other ideas for things we could customize with Steam Workshop, please let us know!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Other notable changes since the last update",
     "items": [
      {
       "text": "Enemy spawners no longer reset on scene changes so once you’ve defeated enemies they won’t respawn until 10 minutes of game time has passed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made the locust junkyard maze significantly smaller and simpler with better loot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added “Resolution” option to the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue where players get stuck behind an invisible wall after the Pazuzu chase scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where a broken 3rd player can be spawned in remote play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bugs that would be a spoiler to explain.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated minimaps that didn’t reflect changes to the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Decreased vision range for sneak mission Golken soldiers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "We are still considering other suggested map/gameplay changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
