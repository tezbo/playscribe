  {
   "id": "kingdom-of-night-117531@major-2025-12-05",
   "gameId": "kingdom-of-night-117531",
   "displayName": "Game Update! Changes & Bug Fixes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-05T08:50:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi All,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just released our first updated Kingdom of Night build! Your feedback has been extremely helpful and we're looking forward to seeing how these changes affect your Kingdom of Night experience. These are all of the changes we were able to make relatively quickly. We are still prioritizing other suggestions that will take longer to implement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Split Equipment tab in the Inventory into two tabs, one for Weapons and one for Accessories.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Properly sort Inventory UI and Equip UI based on item rarity and stats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased move speed (Player now runs at full speed immediately instead of speeding up over 3 seconds)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Decreased time penalty for running out of stamina.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Primary Stats (MUSCLE, GUTS, WITS) show up larger in the item descriptions than secondary stats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sorcerer and Necromancer top level skills now cost 3 skill points instead of 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added option to disable camera shake.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added option to go between fullscreen/windowed modes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Zorn wave quest giver dialogue is now player 1 only",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Defeating Pazuzu third, now properly initiates the fourth Ophelia interlude",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pazuzu Quest entry no longer erroneously mentions the “Journal”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gramps no longer erroneously mentions coming down the stairs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remove 999 hp from boy genius potion (still provides one permanent stat point)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gadreel now only recognizes you at the church if you have defeated at least one demon general",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Jimmy Wits check during mall rooftop conversation now properly reads *\\[WITS 4]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
