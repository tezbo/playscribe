  {
   "id": "kingdom-of-night-117531@5",
   "gameId": "kingdom-of-night-117531",
   "displayName": "Update 5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-10T17:02:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new update for Kingdom of Night is now live, bringing gameplay improvements, new crafting options, and long-awaited Steam Community features!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Added 6 new recipes and adjusted enemy drops and shop inventories to support recipes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Shortened roads in Main Street, West Main Street and Old Road.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased Ghoul Heart drop rate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed issue where UI blur background gets stuck on screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where Equip UI appears empty when there should be applicable items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Steam Community Items are now available! Players can now collect Trading Cards, unlock Profile Backgrounds, and use Emoticons to show off their journey through Miami’s demon-infested streets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/35153050/0de3af8bc8a8768c4c58fc0c79e1ba4fc3d5d2f1.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/35153050/c0a4569fc2343f8d67916bb63a2b43463d99e117.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/35153050/c5112f020bfdf753958b3f38bdcb8998414a69c6.png\"][img src=\"{STEAM_CLAN_IMAGE}/35153050/1432553eecc4a43f5ec76078484e923054aa9c2b.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We’ll continue refining the experience as players go deeper into the night. As always, thank you for your support. And stay tuned, there’s more to come!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
