  {
   "id": "kingdom-of-night-117531@2",
   "gameId": "kingdom-of-night-117531",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-07T21:08:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We just released our second updated Kingdom of Night build!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your feedback continues to be extremely helpful.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're hoping these updates help smooth out the game experience with more to come!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Join the discord if you want to see previews of future updates and provide feedback on larger changes before we release them publicly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Magic Spellbook UI now only shows the 1,2, or 3 runes necessary to select a spell instead of always showing 3 runes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added “Camera Movement” option to allow making the camera be locked to the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Weapons and accessories now stack in the Inventory to decrease clutter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When you “Reset Skill Points” with Gramps it properly clears your archetype so you can switch between Sorcerer/Necromancer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Move “Add Player 2” “Controls” and “Controller Setup” to main pause menu, instead of options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When adding player 2, give player 2 the same EXP as player 1 currently has.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the layout of the quest UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add minimap icon for Challenge Totem rings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add icon to indicate button to get out of Samael grab attack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don’t allow player to go above Nod force field and get knocked out of bounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various Text/Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
