  {
   "id": "pecaminosa-140807@major-2021-09-07",
   "gameId": "pecaminosa-140807",
   "displayName": "La Soirée: Pecaminosa's free title update is coming soon",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-07T07:27:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Detective, Detective…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "No question shall remain unanswered. La Soirée, that is the name of the additional chapter, of the epilogue where every loose end of the story will be tied up...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "… Actually, you will be the one to close and define its last chapter: you can remain a mess, reinforce your role as a useful idiot, or do the right thing. It’s up to you detective.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Important: All owners of Pecaminosa will be playing La Soirée as a free title update!",
     "items": [
      {
       "text": "This game's extension has new areas in store for you, a new boss, more minigames (Poker and Slot Machines) and answers for your questions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hurry up,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sully might not have much time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "P.S - We’ll let you know when La Soirée will be finally available...Don't worry!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
