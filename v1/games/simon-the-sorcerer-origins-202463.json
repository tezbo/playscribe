  {
   "id": "simon-the-sorcerer-origins-202463@patch-2025-11-14",
   "gameId": "simon-the-sorcerer-origins-202463",
   "displayName": "November 14th Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-14T13:39:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "ADDED GRAPHICS MODE SETTING AT GAME START",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "When you launch the game, you’ll now be able to choose the graphics mode you prefer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "MAGIC LANTERN & MISSING GRAFFITI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some visual elements in the Magic Lantern room weren’t updated correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NOT-SO-MAGICAL DISCOVERIES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stone fragments were not updated and some inscriptions were barely visible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ETERNIS (FINALLY) INFELICIS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This will display correctly now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ABSOLUTE CINEMA",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several in-game camera shots weren’t updated properly. – Fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "KAPITALISM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where some of Mundus dialogue lines were not playing in the correct order.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "ANNOYING OWLS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In very rare cases, a game-blocking situation could occur in Sordid’s Laboratory. This should no longer happen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "MUSIC, MAESTRO!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We heard you’ve really been enjoying the soundtrack, so we raised the volume a little. Don’t worry, it won’t interfere with the dialogues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "MARATHON RUNNER",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We identified and resolved an issue that prevented the “Marathon Runner” achievement from unlocking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
