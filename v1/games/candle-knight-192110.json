  {
   "id": "candle-knight-192110@1.0.1",
   "gameId": "candle-knight-192110",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-06-02T02:55:56.000Z",
   "notes": [
    {
     "title": "Patch Notes 1.0.1",
     "items": [
      {
       "text": "General",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a feature that allows players to skip Credits at the end of the game by holding a button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tweaked the dead zones and aiming for a smoother experience using a gamepad controller while using Flamberge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added touch pad functionality to the Steam Deck while using Flamberge.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some crashes caused in the second area of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an error in the Inventory UI Screen in which the total of Solar Vials was x99.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in which dying right after using Dash while crouching, the game would freeze.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in which randomly spamming buttons while respawning would crash the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added some options to the Main Menu and a version number for easier tracking of future bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue in which if players died fighting a specific white orb in the area before the final boss, they would fall endlessly upon respawning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "After completing the game, if players bought all Sword and Shield upgrades, upon starting a new game they would still be in the player's inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Modified Hitstop timing for some enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced Hitboxes and sizes for some enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Polished collisions for the second and third areas of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a hidden chest that was previously unreachable in the tutorial area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in which the Interact Prompt would disappear in the Library Area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an error in which players could see underneath the Map by crouching in the first area of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that would make respawned cricket bandits turn invisible after getting hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Known issues we are still working on for future patches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chinese localization has translation errors pointed out by some users, we’re currently working on fixing them on future patches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ultra Settings in 4K have some performance issues that are being worked on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Scholar boss sometimes ignores the players if they've skipped some checkpoint Chalices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changing tabs while in full screen in certain resolutions causes the game window to not behave properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cricket Bandits occasionally freeze when jumping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue patching the game in the coming days so please keep reporting any and all issues and suggestions, we thank you very much for your continued support and we’re working to make Candle Knight the best experience it can be.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
