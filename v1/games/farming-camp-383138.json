   "id": "farming-camp-383138@major-2026-10-21",
   "gameId": "farming-camp-383138",
   "displayName": "Farming Camp – New Update Now Live!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-21T11:50:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new update for Farming Camp is here! Patch 1.1.0 is bringing important bug fixes and gameplay improvements to make your farming adventure even smoother!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "🌽 Fixed an issue where players could get stuck on the evening of Day 21 after leaving the barn. \\[Progression blocker]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🌽 Fixed a dialogue freeze occurring on the afternoon of Day 6 during the first week's competition ending when playing in Korean. \\[Progression blocker]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🌽 Fixed a dialogue freeze between Alessandra and Jefferson on Day 5 at the barn when playing in Polish. \\[Progression blocker]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🌽 Fixed an issue where barn animals' petting needs would reset after loading a save file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🌽 Fixed an issue where barn food and water containers would reset their fill levels after loading a save file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🌽 Fixed an issue where animals would not sleep when loading a save file from inside the barn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "🌽 The indicator arrow in the booking collection minigame will now disappear if players leave without completing the task.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🌽 Barn animals will no longer display petting needs while sleeping.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Thank You for Your Feedback!",
     "items": [
      {
       "text": "A big thank you to everyone who has taken the time to share bug reports and feedback with us! Your continued support helps us improve Farming Camp and make the experience even better for everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy farming! 🌾",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
