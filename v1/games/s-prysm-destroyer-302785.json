  {
   "id": "s-prysm-destroyer-302785@1.2.0",
   "gameId": "s-prysm-destroyer-302785",
   "displayName": "Update 1.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-16T16:11:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi! I hope you guys enjoyed the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I had to do an update to solve some bugs and small things I got feedback on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the update patches",
     "items": [
      {
       "text": "-Added french, german and russian languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added controller rumble",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added option to deactivate eletric effect of the guitar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added christmas event",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed small bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Changed Marisa's costume to generic witch due to copyright issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
