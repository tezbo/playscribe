  {
   "id": "s-prysm-destroyer-302785@1.0.3",
   "gameId": "s-prysm-destroyer-302785",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-03T18:28:22.000Z",
   "notes": [
    {
     "title": "Update 1.0.3",
     "items": [
      {
       "text": "-Fixed sliding for the most part",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Changed the requirements to unlock Biker from finishing level 16 to level 12",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added keyboard and controller rebinding",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Made the firesword hitbox bigger",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After this I'll add an option to deactivate the post processing that some people don't like.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I don't plan on any updates after that (if no more bugs are found), at best I'll add one or two collab characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
