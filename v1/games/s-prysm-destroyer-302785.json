  {
   "id": "s-prysm-destroyer-302785@1.1",
   "gameId": "s-prysm-destroyer-302785",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-05T22:55:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "For some reason I added score but not a leaderboard nor achievements based on scores...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update 1.1",
     "items": [
      {
       "text": "-Hopefully fixed sliding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added option to deactivate the CC Post Processing (the one that makes the game \"blurry\")",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added score leaderboard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To upload your score, open the game and it should do it. You can see your score in a gameover screen. Keep in mind there might be hacked scores in the future. If you are one of them, please don't. Enjoy the game!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
