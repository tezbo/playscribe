  {
   "id": "s-prysm-destroyer-302785@1.0.2",
   "gameId": "s-prysm-destroyer-302785",
   "displayName": "Update 1.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-31T21:09:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In this new small update I just wanted to fix some essential bugs and problems:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added the collision at the end of level 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed some translation errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added highscore at the start, in the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Player no longer sticks to the wall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed some UI bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Im working on controller binding too, its going to take a while so I decided to launch this update before I launch the controller binding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
