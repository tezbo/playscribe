  {
   "id": "long-live-the-queen-9722@major-2017-02-25",
   "gameId": "long-live-the-queen-9722",
   "displayName": "Technical update (February 2017) Mac Sierra support + Bundles",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2017-02-25T18:11:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've pushed out a version of the game built against a newer engine for Mac users. This should solve problems people were having with no sound on the latest MacOS. As it is a large change, please report any issues you encounter on the forum thread here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Currently, the new engine is only available for Windows/Linux users who opt into the beta. Feel free to check it out with the instructions above and let us know how it works for you.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We have also recently released a Hanako Games Collection bundle, where you can buy all the products published by Hanako Games at a discount. So, if you haven't already, check out some of our other titles:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
