  {
   "id": "long-live-the-queen-9722@major-2026-02-04",
   "gameId": "long-live-the-queen-9722",
   "displayName": "Base Engine Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-04T17:00:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It's moving, it's shaking! We are pushing forward with updating the version of the game engine that Long Live The Queen runs on in order to improve compatibility with modern machines. We're also implementing cloud save and a few other Steam-based features. We've been testing this for a while but it's a BIG change and big changes can cause a little bit of chaos - please check in on the discussion thread here if you run into any problems so we can get right into fixing it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The old version IS still available if needed but it's important to report problems so we can fix them first.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please keep bug feedback in the discussion thread and not a reply to this event (which is harder for Spiky to see and reply to!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
