  {
   "id": "long-live-the-queen-9722@major-2026-03-17",
   "gameId": "long-live-the-queen-9722",
   "displayName": "Bugfix update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-17T01:39:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This release focuses on translation and text-to-speech bugfixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes since 1.5.13",
     "items": [
      {
       "text": "A little code cleanup",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial text works a bit better in self-voicing mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Self-voicing during studying now truncates trailing zeros when reading decimal numbers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bubbles (\"+1 Pressured\", \"Test: Horses → Failed\") will now be read off in the correct order and only get read once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Self-voicing will no longer get confused by lines starting with a - (\"-1 Afraid\") on Linux.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A bug, introduced in the engine upgrade, where translations of lines containing double spaces wouldn't usually work right has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some text that wouldn't translate is now translated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New strings added to the translation template, mostly for text-to-speech. We also added some previously-missing strings. You can get the updated translation file or see the diffs at: https://spikycaterpillar.com/long_live_the_queen/translation/: The above is now in the main/default branch. Fixes for a couple of graphical bugs are currently on the beta branch for testing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
