  {
   "id": "long-live-the-queen-9722@major-2022-12-20",
   "gameId": "long-live-the-queen-9722",
   "displayName": "Compatibility update for Steam Deck and other OSes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-20T17:22:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've put out a small update addressing some compatibility issues related to recent Steam DLL changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This should only affect Linux, Mac, and Steam Deck users. Windows users build numbers will not update.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "See this thread for more information: https://steamcommunity.com/app/251990/discussions/0/6682809959402975006/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you were having crash problems earlier, please try this build and see if it's fixed. If you're having any other difficulties with the game please let us know!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In other news, the console version of LLTQ is currently discounted on most stores for the Christmas sale, so if you haven't already picked that up, now is a great time to score a bargain! As for the Steam sales, well, hold tight, that's coming soon...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
