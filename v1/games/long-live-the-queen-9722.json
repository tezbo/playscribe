  {
   "id": "long-live-the-queen-9722@major-2026-03-09",
   "gameId": "long-live-the-queen-9722",
   "displayName": "Accessibility update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-09T23:05:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Multiple adjustments to automatic self-voicing (triggered by pressing 'V' during the game). This is an accessibility feature which, while not perfect, should hopefully be more usable than it was before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Self-voicing indicator now more readable, telling you how to turn it off in case you triggered it by accident.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Main menu (and some others) have voice options added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Week labels no longer constantly voiced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Studying should now voice results correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Class selection screen a little more understandable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moods screen summarises results in voice",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many sections reworked to use screen language so that the above would be possible, so please let us know if you encounter strange errors anywhere in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other changes",
     "items": [
      {
       "text": "Candidate fix for a crash translating strings with {tag=} in them. Appears to have only affected translations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Work around a crash syncing Steam stats if the API failed to get the death count.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Currently working on further translation-related issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
