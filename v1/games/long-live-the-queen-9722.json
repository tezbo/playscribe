  {
   "id": "long-live-the-queen-9722@1.3",
   "gameId": "long-live-the-queen-9722",
   "displayName": "Update 1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2015-01-30T15:39:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A lot of new options and some new character portraits are being added to the game (currently in beta-testing). The beta version is available to all Steam users, and more information on opting-in plus a quick list of what's in store can be found in this discussion topic: http://steamcommunity.com/app/251990/discussions/0/620703493333077987/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have the time, please come have a look and report your thoughts and any problems you encounter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There will be a new achievement added to the game but not until this patch leaves beta.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hope you enjoy the new storylines!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
