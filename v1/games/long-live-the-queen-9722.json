  {
   "id": "long-live-the-queen-9722@major-2014-02-15",
   "gameId": "long-live-the-queen-9722",
   "displayName": "Feature Update (Feb 8 2014)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2014-02-15T02:26:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've pushed out a small update which adds some new features and fixes a handful of typos. This is not a content update, no new plot has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "More details",
     "items": [
      {
       "text": "Skills screen clearly lists what skills are affected by current mood",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Skip button appears on dialogue you've seen before (hide/show button toggled in preferences)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Failed study attempts (when your penalties meant you gained less than ten points and therefore got no skilltext) should now display a message explaining that you were too moody to learn properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version number visible on preferences screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "'Save Story' at an ending renamed to 'Show Log'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please let us know if you run into any problems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
