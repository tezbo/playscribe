   "kindBasis": "studio",
   "announcedAt": "2025-06-27T16:53:38.000Z",
   "notes": [
    {
     "title": "Update 1.0.4",
     "items": [
      {
       "text": "Weapon attack power has been adjusted for the “Blast Haze”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weapon attack power has been adjusted for the “Seeker Glow”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weapon attack power has been adjusted for the “Grim Whisper XR3”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Photon Strike” laser hit count now scales depending on the weapon’s stats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Muzzle misalignment issue after portal use has been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "ver1.0.4アップデート",
     "items": [
      {
       "text": "ブラストヘイズの威力を調整",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "シーカーグローの威力を調整",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "グリムウィスパーXR3の威力を調整",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "フォトンストライクの弾数を改造値によって変動するように修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ポータル利用時、銃口の向きが照準枠に向かないときがある不具合を修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
