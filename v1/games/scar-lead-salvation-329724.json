  {
   "id": "scar-lead-salvation-329724@1.0.3",
   "gameId": "scar-lead-salvation-329724",
   "displayName": "Patch 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-18T01:07:23.000Z",
   "notes": [
    {
     "title": "Update 1.0.3",
     "items": [
      {
       "text": "Weapon stat increases gained per level from Weapon Enhance Device β have been modified",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Amount of Exo Force gained from a successful parry has been increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Amount of Exo Force lost when damage is taken has been decreased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The number of rooms on a given floor during the second half of the game has been modified",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pick up range for Elm Chips has been increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Miscellaneous bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "ver1.0.3アップデート",
     "items": [
      {
       "text": "「武器強化装置β」の強化値を向上しました",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "「パリィ」が成功した際のエクソフォース増加量を増やしました",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "被ダメージ時のエクソフォース減少量を減らしました",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "後半ステージのメインルート以外の部屋数を少なくしました",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ウィロがエルムチップを取得できる範囲を拡大しました",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "その他不具合修正を行いました",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
