  {
   "id": "custom-mech-wars-263983@major-2023-12-22",
   "gameId": "custom-mech-wars-263983",
   "displayName": "Update Information Dec 22, 2023",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-22T11:34:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing \"CUSTOM MECH WARS\". The following updates have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update Information Dec 22, 2023",
     "items": [
      {
       "text": "・Improved the following points",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When building units in the \"Reserch Department\", missing parts are now grayed out on the parts list.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that prevented some sounds from playing under certain conditions during multiplayer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused some enemies to stop attacking when decoys or turrets were activated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a problem in which button guides and other information were not displayed correctly when using the Nintendo Switch Pro Controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the method of judging gamepad input when \"Seam input\" is enabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed other minor problems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
