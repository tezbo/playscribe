  {
   "id": "custom-mech-wars-263983@major-2023-12-15",
   "gameId": "custom-mech-wars-263983",
   "displayName": "Plans for Bug Fix Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-15T09:52:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing \"CUSTOM MECH WARS\". The following updates have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update Information Dec 14, 2023",
     "items": [
      {
       "text": "・Improved the following points",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The \"Variable Perspective speed\" setting for camera and aiming has been improved so that it can be set to \"OFF\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the game settings in the online lobby to allow chat settings.: ・The following problems have been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug with the Abby voice in the DLC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a problem in which the room list for online multiplayer was only partially displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in the search string judgment when searching for rooms in online multiplayer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused friend-only rooms and password-only rooms to be canceled after a mission was completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused invitations to be sent to friends when creating friends-only rooms on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed other minor problems.: We look forward to your continued support of \"CUSTOM MECH WARS\".: Team CMW: *↓The \"Variable Perspective speed\" setting for camera and aiming has been improved so that it can be set to \"OFF\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
