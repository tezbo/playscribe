   "gameId": "custom-mech-wars-263983",
   "displayName": "Update Information Dec 27, 2023",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-27T12:53:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing \"CUSTOM MECH WARS\". The following updates have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update Information Dec 27, 2023",
     "items": [
      {
       "text": "・Improved the following points",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved synchronization of mission progression between campaign and online play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug that prevented vehicle-based legs from climbing above a certain altitude.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that could cause inoperability under certain conditions during online multiplayer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved keyboard settings to change keys for player movement and camera control",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed other minor problems: We look forward to your continued support of \"CUSTOM MECH WARS\".: Team CMW",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
