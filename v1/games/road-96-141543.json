  {
   "id": "road-96-141543@1.02",
   "gameId": "road-96-141543",
   "displayName": "Patch 1.02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-19T15:08:06.000Z",
   "notes": [
    {
     "title": "5 major bugs have been fixed",
     "items": [
      {
       "text": "The player should no longer get stuck in the scene \"Blame it on the rain\" when discussing with John.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The AirHockey's puck should no longer disappear in the scene \"Let's get serious\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The player should no longer be stuck during the offshore exam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Taxis's ticket can now be scratched and the player should no longer be stuck when inspecting it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The player should no longer be locked in the secret room in the scene \"Let's get serious\": Enjoy :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
