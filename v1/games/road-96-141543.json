  {
   "id": "road-96-141543@1.03",
   "gameId": "road-96-141543",
   "displayName": "Patch 1.03",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-23T15:42:06.000Z",
   "notes": [
    {
     "title": "4 major bugs have been fixed",
     "items": [
      {
       "text": "Players that were experiencing video problems should now have videos played correctly and therefore be able to progress throughout the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The player should now spawn at the correct position in the scene \"Let's get serious\" after the meeting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The scene \"Short circuit\" was not loading properly for some players and should now be displayed correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some players were still getting stuck in the scene \"Nobody's supposed to be here\" they should not be anymore: Enjoy :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
