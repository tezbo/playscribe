  {
   "id": "bossgame-the-final-boss-is-my-heart-142558@1.1.6",
   "gameId": "bossgame-the-final-boss-is-my-heart-142558",
   "displayName": "Patch 1.1.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-23T05:00:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "BOSSGAME has been updated to version 1.1.6! This mostly fixes bugs related to unlocking achievements and in-game lore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PATCH NOTES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "----------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug preventing players from earning His Pathetic Evil achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug preventing players from earning Ladykiller achievement, and updated requirements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug preventing players from earning The Secret is No Secret achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated icon for The Secret is No Secret Achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that prevented Wiki Lore from being unlocked during a Boss Rush",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that occasionally prevented Wiki Lore from being unlocked during the final boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some incorrectly imported audio files",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made minor changes to UI and game flow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "I am looking into the following issues for a future patch",
     "items": [
      {
       "text": "Look into issues with Nintendo Pro Controller when remapping input",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Make Mac controller support more robust: Thank you to everyone who has sent in a bug report, it helps me a lot!: Enjoy your stay in Mammon City,: Lily",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
