   "announcedAt": "2026-06-15T08:44:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Generals,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We have just pushed a new update. Key content is as follows",
     "items": [
      {
       "text": "1. Added exploration progress display within game chapters;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "2. Added controller support for an improved gamepad experience;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "3. Updated and adapted controls for Steam Deck;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "4. Fixed various text issues and optimized related gameplay experience, along with some other bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you for your support! We look forward to your continued feedback as we polish the game together.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "\\[Tencent Docs] The Three Kingdoms: Rebirth Launch Bug Report Form",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "——The Three Kingdoms: Rebirth Dev Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
