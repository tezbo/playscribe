       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "\\[Tencent Docs] The Three Kingdoms: Rebirth Launch Bug Report Form",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "——The Three Kingdoms: Rebirth Dev Team",
       "ps5ProOnly": false,
       "pcOnly": false,
