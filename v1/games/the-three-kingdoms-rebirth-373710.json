  {
   "id": "the-three-kingdoms-rebirth-373710@0429",
   "gameId": "the-three-kingdoms-rebirth-373710",
   "displayName": "Update 0429",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-29T10:09:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Generals,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just pushed a new update. This patch focuses on fixing a number of detail issues, while also refining multi-language subtitles, leaderboard displays, and the credits list.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Detailed update notes are as follows",
     "items": [
      {
       "text": "1. Fixed parts of the Traditional Chinese, English, Russian, Japanese, and Korean subtitles;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Fixed an issue where flower counts on the leaderboard displayed as negative numbers;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Fixed a display issue with flower-sending prompts on the leaderboard;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Fixed other known bugs to improve the gameplay experience;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Updated the player credits list.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues while playing, please feel free to contact us with your feedback. We will continue to follow up and resolve issues as quickly as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Tencent Docs] The Three Kingdoms: Rebirth Launch Bug Report Form",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "——The Three Kingdoms: Rebirth Dev Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
