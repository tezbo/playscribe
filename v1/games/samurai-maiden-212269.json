  {
   "id": "samurai-maiden-212269@major-2022-12-23",
   "gameId": "samurai-maiden-212269",
   "displayName": "Update Information Dec. 23, 2022",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-23T14:12:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The following updates have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update Information",
     "items": [
      {
       "text": "●Game balance Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Enemy placement has been adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The number of times you can start over at the restart point has been increased to three times when playing in Normal Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Combat evaluation criteria have been adjusted. The criteria for \"Enemies Felled\" and \"Inga Acquired\" have been revised downward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Tutorial Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-New tutorial on \"Ninja Skill\" has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-New tutorial on \"Enhancing Weapons\" has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Addition of \"Enhancing Weapons\" notification function",
