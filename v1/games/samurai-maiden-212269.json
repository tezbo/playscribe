  {
   "id": "samurai-maiden-212269@major-2024-02-20",
   "gameId": "samurai-maiden-212269",
   "displayName": "Update Information Feb. 20, 2024",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-20T03:52:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The following updates have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update Information",
     "items": [
      {
       "text": "Tsumugi's movement speed has been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tsumugi's attack speed and range have been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Characters are no longer damaged by bombs and time bombs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The damage caused by falling has been eliminated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The camera distance now changes depending on the scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The camera angle changes during lock-on are now smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor bugs have been fixed.: We look forward to your continued support of \"SAMURAI MAIDEN\".: Thanks!: Team Samurai Maiden",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
