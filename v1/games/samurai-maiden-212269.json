  {
   "id": "samurai-maiden-212269@major-2022-12-28",
   "gameId": "samurai-maiden-212269",
   "displayName": "Update Information Dec. 28, 2022",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-28T10:14:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The following updates have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update Information",
     "items": [
      {
       "text": "-The power of Hagane's Ninja Skill has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Enemy placement in some stages has been adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Result criteria have been revised.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition, a bug has been fixed in which the result evaluation already earned changed due to the revised result criteria.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The actions of the Karakuri General have been adjusted. They no longer keep falling back.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We look forward to your continued support of \"SAMURAI MAIDEN\".",
