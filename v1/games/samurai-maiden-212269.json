  {
   "id": "samurai-maiden-212269@major-2023-01-12",
   "gameId": "samurai-maiden-212269",
   "displayName": "Update Information Jan. 12, 2023",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-01-12T04:14:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The following updates have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update Information",
     "items": [
      {
       "text": "-Added the ability to hide the help bar on the \"Memory Fragments\" viewing screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The mouse cursor is now always fixed to the center of the primary monitor when the mouse cursor is not displayed during battle.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "With this improvement, the mouse cursor no longer moves out of range of the primary screen when the camera is operated with the mouse during battle.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-When selecting a difficulty level, the initial position of the difficulty level selection cursor now automatically selects the difficulty level selected in the previous sortie.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We look forward to your continued support of \"SAMURAI MAIDEN\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Team Samurai Maiden",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
