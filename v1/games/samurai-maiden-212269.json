  {
   "id": "samurai-maiden-212269@major-2025-02-19",
   "gameId": "samurai-maiden-212269",
   "displayName": "Re-announcement of past update information",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-19T01:37:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Since its release in December 2022, this game has undergone many updates based on your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As part of the updates, the costumes \"Durable Bath Towel\" and free DLC“Tsumugi's Costume: Uniform (In Water and Dream)”, which were not available at the time of release, have now been implemented.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have not yet obtained these costumes, please take this opportunity to enjoy them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We look forward to your continued support of \"SAMURAI MAIDEN\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Team Samurai Maiden",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
