  {
   "id": "samurai-maiden-212269@major-2024-04-26",
   "gameId": "samurai-maiden-212269",
   "displayName": "Update Information Apr. 26, 2024",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-26T03:01:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing \"SAMURAI MAIDEN\". The following updates have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Update Information",
     "items": [
      {
       "text": "New costume \"Durable Bath Towel\" has been added.: *It can be purchased using in-game currency.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Underworld Hot Spring\" to the camp background.: *It can be changed in the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted the AI of enemy characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Steam trading cards are now supported.: We look forward to your continued support of \"SAMURAI MAIDEN\".: Thanks!: Team Samurai Maiden",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
