  {
   "id": "pipistrello-and-the-cursed-yoyo-292157@2.0",
   "gameId": "pipistrello-and-the-cursed-yoyo-292157",
   "displayName": "Update 2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-08-18T14:12:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, everyone! Thanks to all of your support, we've reached the milestone of 500 reviews, achieving the title of \"Overwhelmingly Positive\" with a 98% approval ratio!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To commemorate, we're releasing v2.0 of the game! The most important update is the new support for high refresh-rates, so you can now enjoy doing your favorite yoyo tricks at 120 Hz and higher!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's the complete list of changes",
     "items": [
      {
       "text": "Adds support for high refresh-rate monitors, together with a new setting to display the current frame-rate as an overlay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adds functionality to the oracle to reveal diamonds, and also adds a screen making it clear when you've sold them all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Makes it so enemies will continue to drop money when retrying a room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Implements several gameplay improvements to many rooms and bosses, including a new checkpoint during the final boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes the completion percentage when playing in New Game+.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
