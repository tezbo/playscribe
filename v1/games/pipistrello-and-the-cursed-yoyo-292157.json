  {
   "id": "pipistrello-and-the-cursed-yoyo-292157@1.4",
   "gameId": "pipistrello-and-the-cursed-yoyo-292157",
   "displayName": "Update 1.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-03T19:04:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Adds a new option to oracle Mnelia to reveal unvisited rooms (after beating the game's story). Visiting these rooms is important to reach 100% game completion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixes oracle Mnelia failing to reveal missing Badges/Containers under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improves the interaction between pigeons and popcorn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Makes it so the timer in some timed challenges will respect the Game Speed accessibility setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improves Wall-Ride's grip on wall corners when using the Badge that increases its speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Includes minor gameplay improvements to various rooms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
