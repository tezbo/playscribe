     "items": [
      {
       "text": "Fixes \"Solo\" commands while holding items (configurable via Command Mapping settings). For example, executing a \"Solo\" Offstring Throw while holding an item now works as intended and launches the item with the yoyo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Includes minor gameplay improvements to various rooms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
