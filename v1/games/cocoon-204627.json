  {
   "id": "cocoon-204627@1",
   "gameId": "cocoon-204627",
   "displayName": "Hotfix 1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-10-04T21:12:50.000Z",
   "notes": [
    {
     "title": "Full Patch Notes",
     "items": [
      {
       "text": "An improved system for checking and unlocking achievements has been implemented. We weren't able to find a bug with how this was functioning previously, but the game will now check for achievement unlocks more robustly on startup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game's resolution now defaults to the max 16:9 supported resolution by the user's display.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We made sure that there is always at least one 16:9 resolution option with max height in the UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with 144 Hz monitors not being able to run the game higher than 48 fps. We recommend the locked 72 fps option for users with these displays.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the ability to run the game at higher than 60 fps for displays above 60 Hz.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a non-vsynced 60 fps option for screens that don't support vsynced 60 fps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed target FPS values displayed in the UI,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed two small bugs related to orb bots getting suck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a small hint for the last password puzzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "While it's not part of this update, we just wanted to mention here that the game has officially been Verified for Steam Deck. Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We're planning to continue addressing issues that players report, so please let us know in the forums if you encounter any!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "steam://openurl/https://store.steampowered.com/app/1497440/COCOON/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
