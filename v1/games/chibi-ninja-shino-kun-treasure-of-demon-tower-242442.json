 "releases": [
  {
   "id": "chibi-ninja-shino-kun-treasure-of-demon-tower-242442@1.0.2",
   "gameId": "chibi-ninja-shino-kun-treasure-of-demon-tower-242442",
   "displayName": "Update 1.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-08T15:53:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Yo! Since the game is hitting consoles this year, I took the opportunity to dive back into the code base and fix up some things. Here's the changelog:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The boss cutscene is now skipped on respawn, so you can try again quicker",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added animated background elements to all levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new animation when Shino-kun jumps out of a slide at high speed, because why not",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made menu navigation a bit more consistent",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where Shino-kun would be stuck in his falling animation after hitting the ceiling after a kick (yeah, it's specific)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the dive kick wouldn't come out if triggered on the same frame as landing from a jump (yeah, speedrunners found this one)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added particles when wading through deep snow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Maybe something else I forgot, or as companies call it: \"various fixes and improvements\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In case any of these changes breaks something else, let me know in the comments or hop into my Discord and tell me there. Thanks for the support, and a kickass 2024 to all of you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Ando",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
