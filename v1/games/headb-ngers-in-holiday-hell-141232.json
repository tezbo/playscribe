  {
   "id": "headb-ngers-in-holiday-hell-141232@1.10",
   "gameId": "headb-ngers-in-holiday-hell-141232",
   "displayName": "Update 1.10",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-12-07T13:13:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Happy 1st birthday, Banger Dude!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been a long year since Headbangers in Holiday Hell was first released, but we're not quite done yet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this anniversary update we've concentred on backstory. Every good game needs a damsel in distress, so we've added members of Reign of Fury as NPCs and it's players job to save their gig that Santa is trying to sabotage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added first level story animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added enemies straight at the start to get player straight into the action",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added final boss fight story animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Completely overhauled final boss level design and props to fit with story",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted final boss Santa hitbox size",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Explosions like car wrecks, bomber, fireworks and flamethrower now spawn burning and smoking animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Exploded vehicles are now permanent and will still block player and enemy movement, but can be shot over",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated water gun projectile graphics to be more distinguishable from enemy projectiles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated water gun particle effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bomber inventory dropped bombs now always angle depending on where the smoke signal was thrown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated enemy blood particle effect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added blood particles when player is hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added blood, impact and sound effects to enemy corpses bouncing off the floor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Christmas lights prop to residential levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Various smaller behind the scenes changes and fixes to get game code ready for next set of gameplay improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
