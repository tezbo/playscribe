  {
   "id": "headb-ngers-in-holiday-hell-141232@1.9",
   "gameId": "headb-ngers-in-holiday-hell-141232",
   "displayName": "Update 1.9",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-05-10T09:09:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "For this release, the inventory system has had substantial overhaul. Most notably player now has ability to throw active items, effectively turning explosive items into grenades. This is one of many planned substantial behind the scenes changes laying pathway for additional content and items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Implemented throwable inventory items (L1 / LB / E)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Implemented drop / place inventory (hold DPAD Down / hold G)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Inventory is now automatically picked up, unless dropped / placed by player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Picking up new items won't automatically change active item anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new bomber inventory item found on residential levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added particle effects for burning elves, blown up items and enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed water gun particle effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Mall level parking lot to single level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Mall level camera sometimes prematurely moving to the next room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed burning elves leaving duplicate corpses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
