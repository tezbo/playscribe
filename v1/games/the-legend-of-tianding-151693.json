  {
   "id": "the-legend-of-tianding-151693@1.1.67",
   "gameId": "the-legend-of-tianding-151693",
   "displayName": "Update 1.1.67",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-11-23T07:59:13.000Z",
   "notes": [
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed a modeling issue on the towel after casting “Towel” on enemies and immediately quitting to the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where A-Guai’s ransom would mistakenly charg 10 Yuan instead of the 100 Yuan shown on dialogue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a soft lock when players quit in the middle of some sidequests forcibly. Players who triggered this bug can go to the Menu, System page, and punch “Restore Archive” to fix this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Achievements collected offline are added to your Steam achievements automatically when you get back online.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Players can now choose specific section of a level in Relive Memory, with the collection indicator now showing the progress of different sections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added timer in Relive Memory. You can activate this function in the System page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
