  {
   "id": "the-legend-of-tianding-151693@patch-2021-12-16",
   "gameId": "the-legend-of-tianding-151693",
   "displayName": "New Patch + MAC Build!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-12-16T07:22:13.000Z",
   "notes": [
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Added MacOS system support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Corrected some typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crackling sound bug in Relive Memory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where combo points and gold appear on the main interface",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the combo counter would be reset after kicking forward and then kicking upward",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Flying Kick cannot be used and Tian-ding falls straight after using Spiderwire and then Double Jump",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the game screen gets stuck on specific rooms after jumping to the Title page and reading the save file at the end of a battle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the rope links the lock hook when using Spiderwire and reading the save file",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Mr. Wang’s death animation and the following cutscene cannot proceed if Mr. Wang is defeated during a rickshaw sprint.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the Stamina interface appears on the screen when entering a Boss Battle cutscene and needing to reload the save file is if the Stamina value is zero.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Ground Stomp cannot break the ground if Liao Tian-ding is too close to the ground.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Liao Tian-ding will kick on the spot if he keeps using Flying Kick",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an abnormal display of Chen Liang-jiou’s cloth",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Liao Tian-ding’s jacket would disappear occasionally",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where buns eaten by Liao Tian-ding’s shadow are pink",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the prompt for Shimada’s dodge would disappear occasionally",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a visual bug on Wu Lutian’s nameplate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Liao Tian-ding’s paragliding would tilt occasionally",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the start timing and death reset timing of the Memories Timer at the final Boss Battle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
