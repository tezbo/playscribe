  {
   "id": "the-legend-of-tianding-151693@1.1.51",
   "gameId": "the-legend-of-tianding-151693",
   "displayName": "Patch 1.1.51",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-11-12T09:56:41.000Z",
   "notes": [
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Added the Archive Repairment function: The early version before patch 1.1 has encountered a problem of “a soft lock when players quit in the middle of the story plot forcibly”, now you can simply punch the “Archive Restore” button to fix the problem. “Archive Restore” appears only when the system detected a glitch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Load the archive from the demo version will automatically grant “Hero Arrives” and “Eat the Rich” achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where pressing the attack button could suspend Yang Xiuqing’s ballad performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the faulty display on the “Controls” chart when plugged in with some controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the NPCs (Uncle and Auntie Niu) missing when players quit in the middle of the “Threaten Li Hong” plot forcibly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the faulty dialogue display in some plots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where Matsumoto Yuitsu carries abnormal light effect along with the “Lucky Charm” equipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several faulty displays for the character’s name.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players can customize the keyboard setting normally now.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the localization issues within different languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug where there is a chance to carry the stolen weapon from Boss to the street.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the SFX anomalies in Boss fight with Courtesan.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Increased the rate of stealing omamori after equipping with the “Lucky Charm”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "After equipping the \"Lucky Charm\", an enemy who carries collectibles or omamori will light up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted the spells order of Shimada Yunoshin in the third phase battle (only for Wanted Outlaw).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Delayed the first attack of Shimada Yunoshin at the beginning of the battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted the hitfeel of the weapon “Sabre”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted the attack range of the homeless person with an axe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
