  {
   "id": "little-nightmares-iii-262529@dayone-2025-10-09",
   "gameId": "little-nightmares-iii-262529",
   "displayName": "Day one patch",
   "kind": "dayOne",
   "kindBasis": "studio",
   "announcedAt": "2025-10-09T12:50:19.000Z",
   "notes": [
    {
     "title": "This update improves stability, gameplay flow, visuals, and audio for a smoother, more immersive experience.",
     "items": [
      {
       "text": "Download the update to ensure the best possible experience in the Nowhere.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hello Little Ones,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Supermassive Games & Bandai Namco Entertainment have been working hard to continue improving the game and provide an even better experience for players at launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A Day 1 Patch is available to download, featuring the following improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved stability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved synchronization between players in multiplayer mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enhancements to AI companion behavior & animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improvements to AI enemy behavior",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes for vibration and controller bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes & improvements for graphics & UI issues, including asset streaming and clipping reduction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Audio (SFX and music) fixes and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Localization & menu improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you are playing a physical copy of the game, or pre-downloaded a digital version of the game, make sure to connect your console to the internet to receive the day 1 patch update when it’s live.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We recommend downloading this patch to ensure the best possible experience in the Spiral.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
