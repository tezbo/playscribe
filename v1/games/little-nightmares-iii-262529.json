  {
   "id": "little-nightmares-iii-262529@major-2025-10-23",
   "gameId": "little-nightmares-iii-262529",
   "displayName": "October Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-23T12:55:54.000Z",
   "notes": [
    {
     "title": "Since the launch of the game, it has been a pleasure to watch you return to the Nowhere and explore the Spiral. We also appreciate your many comments & feedback, and we’re working hard at Supermassive Games & Bandai Namco Entertainment to continue improving the game and enhance your experience.",
     "items": [
      {
       "text": "A new October Update will be released, featuring the following improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Enhancements to AI companion behavior & animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved player-environment interactions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Online",
     "items": [
      {
       "text": "Improved synchronization between host & client",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Graphics",
     "items": [
      {
       "text": "Post-processing updates to improve brightness & readability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "UI & UX",
     "items": [
      {
       "text": "Localization & menu improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes for vibration and controller bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We recommend downloading this patch to ensure the best possible experience in the Spiral.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We thank you for your support and encourage you to continue sharing your comments & feedback on the official Discord Server or through our consumer support channels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
