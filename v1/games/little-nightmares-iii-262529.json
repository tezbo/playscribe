  {
   "id": "little-nightmares-iii-262529@post-2025-09-23",
   "gameId": "little-nightmares-iii-262529",
   "displayName": "Reporting Bugs and Sharing Feedback for the Little Nightmares III Demo",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-23T14:07:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We really appreciate all the feedback and reports you’ve been posting here about the demo. Thank you for being so involved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To make sure every issue related to the demo is properly tracked and passed to the right teams, we kindly ask that you use the following channels:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Customer Support",
     "items": [
      {
       "text": "Official Discord (for bug reports and live discussions about the demo):",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will still monitor the Steam forums, but the two channels above are the most direct paths to QA.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
