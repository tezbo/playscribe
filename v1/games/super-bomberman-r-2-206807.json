  {
   "id": "super-bomberman-r-2-206807@1.3.0",
   "gameId": "super-bomberman-r-2-206807",
   "displayName": "Update 1.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-19T05:16:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are pleased to inform you that we have updated to [Ver1.3.0].",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Summary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Addition of new character \"Luca Bright Bomber\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"Room Lobby\" function added to Private Match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted Private Match so that users can enter a room during a battle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the maximum number of \"Round number\" for Standard Battle Mode in Private Match/Battle Offline to 99",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added the ability to continue playing with the same settings on the results screen of Private Match/Battle Offline",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added setting to omit waiting time when all players have completed character selection in Private Match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted matching logic for Graded Match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjustment to prevent continuous Stun in battles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted speed in Power Zone from 2 to 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the Bean Bomber's skill \"Jump\" to prevent it from crossing the Goal Shutter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the Gimmicks \"Exploding Floor\" to prevent it from crossing the Goal Shutter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed other bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The latest update data is required to play online elements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Appreciate your continued support for Super Bomberman R 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please check the official website for latest information and details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
