  {
   "id": "super-bomberman-r-2-206807@1.3.1",
   "gameId": "super-bomberman-r-2-206807",
   "displayName": "Update 1.3.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-02T06:16:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are pleased to inform you that we have updated to [Ver1.3.1].",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Summary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the \"Play Again\" button to the initial cursor position in room match/offline battle results",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added \"Refresh\" button on the room lobby screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added \"Friends\" item to \"Sort By\" in the Room Lobby",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Merged \"Basic Bomber\" and \"Crystals\" grades in Grade Match as \"Grand Prix\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Re-adjusted matching logic in Grade Match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that prevented some achievements from being unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that prevented the number of achievements for some \"Challenge\" from being counted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in which parts placed in the \"Level Editor\" sometimes disappeared when loading",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several other bugs fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The latest update data is required to play online elements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Appreciate your continued support for Super Bomberman R 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please check the official website for latest information and details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
