  {
   "id": "super-bomberman-r-2-206807@1.2.2",
   "gameId": "super-bomberman-r-2-206807",
   "displayName": "Patch 1.2.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-13T07:54:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have modified some specs, like choosing battle rules in Graded Match and changing defaults in Castle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted to allow selection of battle rules in Graded Match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed draw decision in online battles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted \"Select Side\" in Graded Match Castle so that it does not keep missing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Change default Select Side to Attack Side in Graded Match \"Castle\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted matching bands in Graded Match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a bug that caused grade icons to fail to load",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Raised the number of Gems earned in Battle Offline from 50 to 100",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed some communication errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed other bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Support for Steam's \"Remote Play Together\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Support for Steam's \"Cloud Saves\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5000 Gems can be earned by updating to Ver. 1.2.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The latest update data is required to play online elements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Appreciate your continued support for Super Bomberman R 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please check the official website for latest information and details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
