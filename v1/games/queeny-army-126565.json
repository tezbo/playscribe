  {
   "id": "queeny-army-126565@1.4.2v",
   "gameId": "queeny-army-126565",
   "displayName": "Update 1.4.2v",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-03-04T04:12:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings recruits!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tonight there was a small update of the game Queeny Army that contains the fix of a bug that had long time without fixing. It is the ghost bullet that consisted in that when firing automatic bullets an extra bullet was fired that did not count as such, but affected the gameplay especially in the exclusive weapon of Marcela which left her a good time without shooting because a ghost bullet came out that did not allow her to give another shot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's all for now, remember to report any bug that appears in the game to fix it as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
