   "kindBasis": "studio",
   "announcedAt": "2020-10-15T05:30:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings Recruits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is a hotfix with very small changes, by the way, I have uploaded a new compilation of the Linux version, I don't know if it works, in any case I would like you to let me know to continue investigating the problem.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
