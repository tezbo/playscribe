   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Now player can proceed the game with Space bar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Input Field issue fix: The \"OK\" button will be selected if player inputted the letter \"S\" in input field (such as name) because of the primary Unity ADWS setting. This has been fixed now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
