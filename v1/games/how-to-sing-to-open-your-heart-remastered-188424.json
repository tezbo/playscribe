   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The game is updated to settle the opening-video-not-play issue on Linux OS.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Windows version and Mac version are also updated to match the Linux files, but the change is only within the opening video codec.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The demo version is also getting the similar update, but besides the issue above, it will also settle the weirdly appear \"trial version\" mark on the right down side of the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
