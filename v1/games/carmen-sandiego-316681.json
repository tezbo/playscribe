  {
   "id": "carmen-sandiego-316681@major-2025-02-11",
   "gameId": "carmen-sandiego-316681",
   "displayName": "Community Challenge Update: 25K Wishlists & 500 Discord Members!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-11T13:30:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Gumshoes, you’ve done it again! Thanks to your incredible support, we’ve hit 25,000 Wishlists AND achieved our first Discord community milestone of 500 members!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Unlocked Rewards 🎉",
     "items": [
      {
       "text": "✅ Steam Avatars – A set of Carmen Sandiego-themed avatars will be available for the community!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Discord Emotes – Our first batch of emotes is live in the server, with more on the way!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep the Chase Going!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Avatars",
     "items": [
      {
       "text": "[table noborder=1]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Community Challenge",
     "items": [
      {
       "text": "We’ve introduced a brand-new Discord Community Challenge, where more milestones mean more exclusive rewards for early members:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔓 1.5K Members: Team Red Wallpaper",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔓 2K Members: Animated Emotes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔓 5K Members: Game Team Q&A Video",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And on the wishlist front, we’re getting closer to the next big reward:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎉 65K Wishlists: In-game global festivals 🌸 will be introduced in future updates + a 15% Deluxe Edition discount on launch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎉100k Wishlists: Unlock a new Casual Carmen skin + a 20% Deluxe Edition discount on launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "How to Participate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📌 Wishlist Carmen Sandiego on Steam to help us reach our next milestone.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "📌 Spread the word! Every wishlist and new member helps unlock more rewards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is just the beginning, let’s keep the momentum going! 🕵️‍♀️🔎",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For more information and updates, visit Carmen Sandiego Official Website and follow us on:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Instagram: @theofficialcarmensandiego",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Twitter: @carmensandiego",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Facebook: Carmen Sandiego",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Til Next Crime.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
