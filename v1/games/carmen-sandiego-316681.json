  {
   "id": "carmen-sandiego-316681@major-2025-01-07",
   "gameId": "carmen-sandiego-316681",
   "displayName": "Community Challenge Update: 10K Achieved!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-07T08:40:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We hit 10K Wishlists! Thanks to your support, the Team VILE Device Wallpaper is now available for download.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get them below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Desktop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mobile",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep going, gumshoes! Let’s hit the next milestone! 🕵️‍♀️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "HOW IT WORKS",
     "items": [
      {
       "text": "We’ve set wishlist milestones for Carmen Sandiego. Each milestone comes with exclusive rewards for the community, adding even more excitement to the journey ahead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "MILESTONE GOALS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "10,000 Wishlists: Unlock official Carmen Sandiego wallpapers for the community! ✅",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "100,000 Wishlists: Unlock a new Casual Carmen skin + a 20% deluxe edition discount on launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Important Notes",
     "items": [
      {
       "text": "Festivals Update: Global festivals will be introduced in timed future updates, adding vibrant cultural events to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bonus Carmen Skin: This in game cosmetic will be unlocked for all players during the first major game update—no extra steps required!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "HOW TO PARTICIPATE",
     "items": [
      {
       "text": "Add Carmen Sandiego to your Steam wishlist.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spread the word! Share the news with friends and fellow fans to help us hit those milestones.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep an eye on our social channels for updates on our progress and new announcements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For more information and updates, visit Carmen Sandiego Official Website and follow us on:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
