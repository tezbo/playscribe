 "releases": [
  {
   "id": "stellar-wanderer-dx-283577@1.0.17",
   "gameId": "stellar-wanderer-dx-283577",
   "displayName": "Update 1.0.17",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-24T13:34:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear pilots,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to announce that we have a new update for game - version 1.0.17!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Highlights",
     "items": [
      {
       "text": "This is one of our biggest updates yet! In this one we added the possibility to defer story missions, fixed various issues related to equipped items, we reworked the Mining Silencer, fixed some HUD and Interface issues, added more info and status messages for the repair function and class abilities, fixed the per-joystick axis calibration settings, and many, many more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Story Progression Warnings",
     "items": [
      {
       "text": "Added a Story Progression Warnings toggle in the settings list. It is off by default, and a popup explains the new state each time you toggle it. When it is on, and a jump gate or a docking would move the story mission forward, a confirmation popup appears:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "\"Your story mission continues in . Continue the story now?\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"Your story mission continues on the station. Continue the story now?\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Choose NO to jump or dock in SANDBOX mode, or YES to continue with the STORY. You will be asked again the next time you arrive there.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: A story mission can have several parts, you can only defer the beginning of the mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Class Abilities & Repair Unit",
     "items": [
      {
       "text": "Abilities show status messages: *Locked*, *Active*, *Recharging*, *Activated*, and *No Class Selected Yet*.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The repair unit shows status messages: *Hull Repaired*, *No Repair Unit*, *Repair Unit Recharging*, and *Hull Integrity Full*.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The HUD shows ghost icons for abilities and the repair tool when you try to use them without being unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Repair no longer triggers on a full hull, and Taunt no longer triggers with no enemies in range. Neither spends its cooldown in those cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ability names and more stats are now displayed in the PILOT page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The hangar shows a REPAIR UNIT installed/not installed stat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Mining Silencer",
     "items": [
      {
       "text": "An active silencer jams random-encounter pirate forces so they can no longer track you. Jammed hostiles get a green reticle and a JAMMED tag.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New corresponding HUD messages for the Mining Silencer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Attacking a ship, including with missiles or torpedoes, breaks the silencers` cover.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Turrets respect silencer jamming when they pick targets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Advanced tractor beam/teleporter",
     "items": [
      {
       "text": "If a Smuggler's Den is installed together with an advanced tractor beam or multi-teleporter, illegal cargo is collected automatically.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Turrets",
     "items": [
      {
       "text": "Fixed an incorrect bullet range when engaging.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Phase Turret now fires the correct bullet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where turrets would engage invisible targets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with energy consumption.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Equipment",
     "items": [
      {
       "text": "Fixed some energy consumption discrepancies between reported value and gameplay value for various equipment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with scanners range.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "HUD",
     "items": [
      {
       "text": "Energy display now shows the absolute energy value instead of a percentage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The energy gizmo turns red at the \"Energy Low\" level, then fades back once energy recovers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The ability timer (e.g. Aegis) no longer shows a stray extra decimal digit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The lock \"red dot\" now also works for torpedoes and the silencer, showing when they are loaded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Interface",
     "items": [
      {
       "text": "Negative energy values in hangar are shown in red, and launch is not allowed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hangar PRI FIRE / SEC FIRE stats:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some issues with the estimations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Show *not installed* when no weapon is equipped, and *no energy* when the loadout leaves no battery energy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "They are shown in yellow when sustained fire lasts less than 10 seconds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Turret details were revamped. New fields are Time, Range, Guns and Mode (Burst/Cont). DPS now includes gun count, fire mode and delay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a few display issues for the Items compare table.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Upgrade badges:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The upgrade icon is now cyan.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some equipment upgrade badges not showing when better equipment is available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A badge on the HANGAR button shows when something can be upgraded at the current base.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The contraband label is no longer missing in the CARGO section.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The battery extender bonus and the MINING stat now display correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dialogue:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The PREV/NEXT/CLOSE buttons are centered and closer together, so mashing through dialogue while docked no longer launches the ship by accident.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A missing menu texture (mission icon) was fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Joystick",
     "items": [
      {
       "text": "Fixed Joystick axis settings per device (invert, dead zone and sensitivity for each axis).: ##: Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash when leaving the Titan base.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some dialogues being played twice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where closing a dialogue would redirect to main menu instead of hangar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where after a jump or undock, a gate or station did not have collision.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Localization",
     "items": [
      {
       "text": "Various localization fixes and updates.: If you have any feedback or encounter any issues let us know on the game's Community Hub page.: Happy exploration,: Stellar Wanderer DX team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
