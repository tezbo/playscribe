  {
   "id": "stellar-wanderer-dx-283577@1.0.9",
   "gameId": "stellar-wanderer-dx-283577",
   "displayName": "Update 1.0.9",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-18T11:44:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, pilots!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to announce that we have implemented support for multi-device HOTAS and HOSAS!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The changes include",
     "items": [
      {
       "text": "added support for up to 4 connected devices",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fixed stuck on binding issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "improved axes and buttons detection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added support for up to 40 buttons per device",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "detect device connected/disconnected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed some incorrectly configured bindings: Additionally, the patch includes some other fixes and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed an issue with incorrect cargo being dropped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed several issues regarding upgrade of pilot abilities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed some missing or incorrect item descriptions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed some missing translations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed display of credits over 1 million: If you have any questions or encounter any issue, please use our [Joystick and HOTAS Discussion Thread]: Happy exploration,: The Stellar Wanderer Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
