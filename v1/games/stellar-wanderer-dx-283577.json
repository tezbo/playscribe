  {
   "id": "stellar-wanderer-dx-283577@major-2024-09-23",
   "gameId": "stellar-wanderer-dx-283577",
   "displayName": "Big update for the Stellar Wanderer DX demo!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-23T08:52:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear explorers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are pleased to announce that the Stellar Wanderer DX demo has been updated to version 0.6! This update brings a slew of visual, sound, UX, and localization improvements to the demo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Check the patch notes below",
     "items": [
      {
       "text": "updated environments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "updated capital ships and installations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "updated fighter ships and cockpits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "updated space stations (interior and exterior)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "new jumpgate and dock animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new sounds and fxs for engines and weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new explosions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new localizations. The full list now includes German, Portuguese, Russian, Spanish, Japanese, Simplified/Traditional Chinese. This is still in a work in progress, some texts might still show up not translated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "UI fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "many other under-the-hood fixes and improvements: Please don't hesitate to share with us your feedback and any issues you may encounter in the demo on the game's Community Hub page.: Stellar Wanderer DX team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
