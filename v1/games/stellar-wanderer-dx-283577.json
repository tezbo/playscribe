  {
   "id": "stellar-wanderer-dx-283577@1.0.15",
   "gameId": "stellar-wanderer-dx-283577",
   "displayName": "Patch 1.0.15",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-07-15T22:33:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, explorers! Patch 1.0.15 squashes a couple of pesky bugs and adds a small quality-of-life improvement to control bindings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue in the Dysons system where a duplicate lost cargo pickup would register as collected without awarding the actual shard, potentially leaving some players one shard short of the Hellcat Ship/Archaeologist achievement. All 22 shards can now be properly collected. Huge thanks to Shadwen for helping us track this one down!: If you were affected: no action needed - the achievement will unlock automatically the next time you land at a base.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a mouse hover issue that prevented the info button (for opening equipment descriptions) from being displayed. Thanks to WiseHart for the report!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "You can now delete a selected binding with right click in the keyboard/joystick control bindings menu.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Various minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Stellar Wanderer Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
