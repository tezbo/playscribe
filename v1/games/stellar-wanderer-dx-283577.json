  {
   "id": "stellar-wanderer-dx-283577@1.0.16",
   "gameId": "stellar-wanderer-dx-283577",
   "displayName": "Patch 1.0.16",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-07-31T12:04:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, pilots! This update brings quality-of-life improvements across the board.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Multiple connected gamepad controllers are now supported simultaneously",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a \"Sell All\" button to the cargo section, allowing bulk sale of items by type",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Selected target's off-screen indicator now displays a distance label next to the directional arrow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Secondary mission markers updated with a more distinct color for better visibility",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tutorial popups display input command binding glyphs for the current control scheme",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Splash screen logos can now be skipped with Escape, Space, or controller A/B buttons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue with binding Mouse Right Click to some actions",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Stellar Wanderer Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
