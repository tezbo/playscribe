  {
   "id": "stellar-wanderer-dx-283577@1.0.14",
   "gameId": "stellar-wanderer-dx-283577",
   "displayName": "Update 1.0.14",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-05T09:23:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear pilots,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to announce that we have a new update for game - version 1.0.14!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The list of changes includes",
     "items": [
      {
       "text": "implemented the option to fast-forward the dock and jump-gate cutscenes. To do this, just press again the in-game dock/jump key after the dock/jump has started (the default key is 'F')",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "for the Archeologist achievement, the number of available and collected shards can now be found in the MAP > MARKET table for every system. For each system, the info becomes available after it is visited.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "various other stability, UI and localization fixes: If you have any feedback or encounter any issues let us know on the game's Community Hub page.: Happy exploration,: Stellar Wanderer DX team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
