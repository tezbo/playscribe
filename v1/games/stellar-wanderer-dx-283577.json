     "title": "Changes",
     "items": [
      {
       "text": "Hello pilots!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛠️ Hotfix 1.0.3: Time Multiplier Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this patch we improved the Time Multiplier experience. If using afterburner when multiplier is active, it will not drain out, thus making this mode similar to a 'cruise mode'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally we fixed mouse and keyboard pitch axis not responding to the invert pitch axis setting.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Stellar Wanderer Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
