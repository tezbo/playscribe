  {
   "id": "stellar-wanderer-dx-283577@1.0.12",
   "gameId": "stellar-wanderer-dx-283577",
   "displayName": "Update 1.0.12",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-07T07:13:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear pilots,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to announce that we have a new update for the demo and full game - version 1.0.12!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The list of changes includes",
     "items": [
      {
       "text": "added French and Italian localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "many fixes and improvements for the Japanese localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "localization fixes for all languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added a counter for the number of shards collected in each system to help with the Archeologist achievement. The counter can be found when landed on a station in the Market > Cargo section",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added the option to invert the slide X and Y axes separately, and fixed setting persistence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fixed some space structures that were mineable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed display names of certain asteroids: If you have any feedback or encounter any issues let us know on the game's Community Hub page.: Happy exploration,: Stellar Wanderer DX team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
