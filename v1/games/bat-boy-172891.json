  {
   "id": "bat-boy-172891@1.0.5",
   "gameId": "bat-boy-172891",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-06-06T10:42:24.000Z",
   "notes": [
    {
     "title": "Content",
     "items": [
      {
       "text": "Fixed issue where a healing item in level 9 that would appear only once. Now it is set to respawn if the player dies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue where using the bat to bounce on an enemy or a projectile during the same frame Bat Boy starts climbing a ladder would cause the ladder to not work properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue where the last boss sometimes would not perform some attacks after the player has died at least once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed overlapping icons in the Japanese version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed sprite layering issue in level 12.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Other minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
   "digest": {
