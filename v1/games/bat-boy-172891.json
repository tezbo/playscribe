   "id": "bat-boy-172891@1.0.4",
   "gameId": "bat-boy-172891",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-06-02T13:22:20.000Z",
   "notes": [
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed issue where Pigzy ninjas would not make any sound when appearing and disappearing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue in level 7 where the boss could clip through the floor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue in level 9 where an area with spikes would not damage the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where for some players, physics on ladders and with certain projectiles would acted differently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue in the training area after clearing level 10 where it was possible to trigger a screen transition to a room where the player is not present.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where it was possible to use the \"Bouncing Basketball\" skill in the last stage at a point where it should not be allowed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
