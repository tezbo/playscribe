  {
   "id": "bat-boy-172891@1.0.3",
   "gameId": "bat-boy-172891",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-05-30T11:17:50.000Z",
   "notes": [
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed issue in level 8 where entering the wrong door with a key could cause the player to lose that key.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where under certain circumstances, one of the enemies in the tutorial area of level 8 would become invincible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where it was possible to go out of bounds in level 10 using an enemy to push you against the wall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the bull rush skill would stop immediately after starting if the player was very close to a block.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where bombs from Moonstar (boss) would damage the player even with the bubble shield: was active.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue in level 11 where it was possible to go out of bounds using a ladder with a block on top.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where boss of level 2 could go out of screen while dashing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved camera movement and a platform length in the minecart section of level 5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where falling crates in level 7 could get out of sync.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed error in Japanese dialogue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
