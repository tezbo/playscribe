  {
   "id": "bat-boy-172891@major-2022-09-20",
   "gameId": "bat-boy-172891",
   "displayName": "A Tiny Update for TGS 2022",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-20T06:51:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We made a tiny update to the build for TGS 2022. And decided to share it with everyone on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Below are the patch notes",
     "items": [
      {
       "text": "Patch 0.6.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New pet system. One pet included in the demo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New batspin jump animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New song in Groovy House.",
       "ps5ProOnly": false,
       "pcOnly": false,
