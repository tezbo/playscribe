  {
   "id": "bat-boy-172891@1.0.6",
   "gameId": "bat-boy-172891",
   "displayName": "Patch 1.0.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-06-14T06:57:48.000Z",
   "notes": [
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed issue in level 11 where using the grappling ribbon in a specific spot of the level could cause a softlock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where Bat Boy sometimes would get stuck when running on destructible blocks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed flickering effect from the ghosts in the background of level 8.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where it was possible to change the screen scaling from the button remapping option in the pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a couple of issues when remapping keys for keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issue where, right after finishing the game, going back and fighting the last boss again would cause projectiles not to spawn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved control over the batspin. Now, when calling back the bat while in batspin by pressing the attack button, it is easier to bounce on it as it comes back.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
