  {
   "id": "alien-rogue-incursion-evolved-edition-342923@1.0.2",
   "gameId": "alien-rogue-incursion-evolved-edition-342923",
   "displayName": "Hotfix 1.0.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-10-02T02:16:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Community!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our latest Hotfix 1.0.2 is now live.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The following fixes apply to the PC version of the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where player movement could break on ladders in certain cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved a bug that sometimes caused players to lose weapon functionality after interacting with Fuel Rods or throwing grenades.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected subtitles being cut off during specific dialogue sequences.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved camera transitions when exiting terminals, power boxes, and ladders.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Lastly, if you’re experiencing any issues or have feedback, please check out our FAQ first. If you still can’t find a solution, feel free to reach out to us at support@survios.com, and we’ll assist you directly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
