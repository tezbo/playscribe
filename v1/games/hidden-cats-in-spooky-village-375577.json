  {
   "id": "hidden-cats-in-spooky-village-375577@post-2025-11-10",
   "gameId": "hidden-cats-in-spooky-village-375577",
   "displayName": "Mac Save File Fix and Restoration",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-10T19:23:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are aware there were some issues with the Mac save files, which was starting the game out completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this update this issue should no longer be occuring, however there's a slight possibility of the game's current save being lost.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If that happens on your end, please contact us to receive a personalized save data, as a way to not lose your progress! Our support email is:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "support@nukearts.com.br",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let us know if everything works now in your end!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
