  {
   "id": "hidden-cats-in-spooky-village-375577@post-2025-10-30",
   "gameId": "hidden-cats-in-spooky-village-375577",
   "displayName": "Small Bugs Fixing:",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-30T19:23:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! We have news regarding some bugs reported in the community tab, we took a look at them and have fixed the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Main Level's number of found cats displayed is incorrect;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Crypt level would freeze and crash the game;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Crypt level pause button would vanish from the screen when pressing tab twice;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the cat's meow sound settings issue not playing it;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected some text regarding translation Portuguese translation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We are still looking at some other issues as well, but we hope these fixes improve your overall gameplay experience in these spooky times, with that said, happy finding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
