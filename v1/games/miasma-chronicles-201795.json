  {
   "id": "miasma-chronicles-201795@1.1.16",
   "gameId": "miasma-chronicles-201795",
   "displayName": "Update 1.1.16",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-29T15:54:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I’m delighted to share with you some further updates to Miasma Chronicles across all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update will fix all Achievement/Trophy issues that have been reported by the community. Again, we want to thank everyone for bearing with us as we know there were a few players looking forward to popping that 100%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It goes without saying, but we want to thank everyone who has picked up Miasma Chronicles and exploring the world that we’ve built. Without you, we wouldn’t be doing what we do.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Just a reminder, if you see a bug in the game, let us know here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "505.games/MiasmaChroniclesBugSubmission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please follow our official social media channels to keep up to date with the latest news.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Miasma Chronicles: Steam (version no: 1.1.16) Patch Notes – June 28th",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BALANCING FIXES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved handling of sprint controls. No longer cancelled when jumping down.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "STABILITY / BUG FIXES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for possible missing Mayor Mason after recruit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for possible issue with Joseph Conway NPC broken after combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for 'Bookworm' Achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for 'Attenborough' Achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for 'Hold the Line' Achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for AI breaking when absorbing Miasma under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for cooldown issues with save game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for magazine upgrade not registering ammo increase for certain weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for range chips not working with some Miasma types.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for cancelled dialogues when opening inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for Codex always showing things as 'new'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for particles staying on characters under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
