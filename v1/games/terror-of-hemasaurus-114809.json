  {
   "id": "terror-of-hemasaurus-114809@major-2021-10-26",
   "gameId": "terror-of-hemasaurus-114809",
   "displayName": "Demo Update: Skippable custscenes, stage select, longer stages + Bug fixes!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-10-26T14:23:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Based on the feedback I received from the first version of the demo, I have added skippable cutscenes, a stage select menu as well as made two of the stages longer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun and I appreciate all feedback :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
