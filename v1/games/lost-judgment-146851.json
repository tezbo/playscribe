      },
      {
       "text": "Thank you for playing Lost Judgment! This hotfix addresses a memory leak issue that some players have encountered when running the game on Nvidia GTX 1000 and older graphics cards.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We appreciate your continued support and wish you the best of luck on your next case!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
