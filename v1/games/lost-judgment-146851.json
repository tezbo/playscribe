   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Lost Judgment players! We are rolling out patch 1.01 today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for reporting your issues. This update addresses various fixes and adds a graphic setting. Here is a comprehensive list of fixes made:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a crash issue when booting the game while E-Core on Intel 12th generation Core series is set to OFF.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a freeze issue of the main character in battle mode when playing during high frame rates (120 FPS and up).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "AMD FSR 2.1 adoption and improvement of drawing quality.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please continue to post issues you encounter here for us to investigate and have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
