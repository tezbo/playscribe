  {
   "id": "lost-judgment-146851@post-2022-12-20",
   "gameId": "lost-judgment-146851",
   "displayName": "New Graphics Options and Bug Fixes!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-12-20T03:40:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Lost Judgment fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've got some great updates and several fixes with this patch, please take a look at our patch notes. Please continue to post any issues you encounter here and thank you for playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DLSS support is now fully supported for Lost Judgment!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• NVIDIA DLSS , NVIDIA DLSS Sharpness are now available under Graphic Settings > Detailed Settings",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• NVIDIA DLAA been added under Graphic Settings > Detailed Settings",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The following settings have been changed for first boot on SteamDeck:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• FSR is now off and FSR2.1 is now active",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• FPS is now 60",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other fixes",
     "items": [
      {
       "text": "• An issue that prevented players from clearing Hikawa’s Scoop Mission when the screen angle is in a different position.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Addresses an issue that occurred with the destruction effect of the meter shifting unexpectedly when playing the moped race in an aspect ratio other than 16:9.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• When playing darts outside of a 16:9 aspect ratio, the mini-screen in the bottom left no longer changes unexpectedly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
