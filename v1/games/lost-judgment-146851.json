  {
   "id": "lost-judgment-146851@522.25",
   "gameId": "lost-judgment-146851",
   "displayName": "Update 522.25",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-26T18:41:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have received reports of some players having issues booting the game. This issue is being investigated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have an Nvidia GPU and have recently updated your Nvidia driver to 522.25 and are experiencing problems launching the game, please try the following workaround:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Go to Windows Settings > System > Display > Graphics Settings, then try toggling the Hardware-accelerated GPU Scheduling option to ON or OFF, depending on your current settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
