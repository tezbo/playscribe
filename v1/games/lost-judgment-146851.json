  {
   "id": "lost-judgment-146851@1.02",
   "gameId": "lost-judgment-146851",
   "displayName": "Patch 1.02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-04T03:04:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Lost Judgment players! Today we’re rolling out patch 1.02!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thank you for reporting your issues. Here’s a list of fixes in this update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Support added for Intel XeSS.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "FSR2.1 setting added to apply only anti-aliasing effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where a black screen would display when playing Virtua Fighter 5 Final Showdown.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with VSync set to ON that caused instability with higher frame rates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved boot-up stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Patch version description on title screen and smart phone menu have been updated to reflect the correct version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Miscellaneous additional fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to post any issues you encounter here for us to investigate and have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
