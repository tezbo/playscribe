  {
   "id": "frog-detective-1-the-haunted-island-111117@major-2025-05-10",
   "gameId": "frog-detective-1-the-haunted-island-111117",
   "displayName": "Frog Detective Language Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-10T13:28:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello frog fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I’m very pleased to announce today that Frog Detective is now available in Japanese! We’ve been working hard with 8-4 to make the translation as true to the original as possible so more people worldwide can solve the mystery too. I’m super proud of the work the team has done and though I can’t speak or read the language myself, I saw all the symbols and thought to myself “I bet that would be funny if I could understand it!”. Luckily for me the game is also available in English which I understand pretty well. Whichever language you choose to play in, I hope you enjoy our silly little series and maybe even figure out whether crime is real!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All the best,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Grace Bruxner",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
