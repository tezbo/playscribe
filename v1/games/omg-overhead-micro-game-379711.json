  {
   "id": "omg-overhead-micro-game-379711@1.0.2",
   "gameId": "omg-overhead-micro-game-379711",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-25T15:43:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "First patch! Oh man, it brings a tear to my eye. My baby is all grown up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our first patch for a bug sent in by one of my devoted fans. You know who you are. It turns out that the very first achievement that I ever tested is broken. Who would have thought!? It's the achievement you get for beating the first level. If you've already beaten the first level, the achievement should unlock when you launch the game. It should also be fixed for people first playing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any further issues, please reach out to me at support@freddicusgames.com - thanks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
