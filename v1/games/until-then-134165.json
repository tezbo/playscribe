  {
   "id": "until-then-134165@1.3",
   "gameId": "until-then-134165",
   "displayName": "Patch 1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-11T16:36:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today, we're excited to release Patch 1.3, which adds new content, such as a bonus post-credits scene, and includes a bevy of bug fixes and improvements. Learn about this latest update in the below patch notes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch 1.3",
     "items": [
      {
       "text": "NEW!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bonus post-credits scene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Interactive content warning screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Skip text” feature, available after finishing the entire game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Global offset calibrator for rhythm minigames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lane speed setting for Mania-like rhythm minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New videoke minigame song: Leron Leron Sinta",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More graphics settings (reflections, SSAO, and an Off option for almost every setting)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Credits now accessible from the main menu at any time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes and improvements",
     "items": [
      {
       "text": "Fixed audio crackling in Windows",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved general behavior of controller icons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed gamepad icons appearing even though keyboard is in use",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed inconsistent timings in the jeepney minigame (but still as hard)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed mouse clicks not registering in the League of Mashers minigame",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Various visual improvements in the League of Mashers minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various soft-locks, especially those that occur under low framerates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed FPS HUD not letting mouse clicks through",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed certain music tracks not looping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some English typographical errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the “Fishballer” achievement not unlocking if player skewers more than one fishball in a single turn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some SFX and music tracks not respecting volume settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Mark’s rare moonwalking/moonrunning in certain scenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved intro music track",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved gamepad navigation in scene selector",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Mark’s chat messages possibly being sent more than once",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved physics and feel of the web browser dinosaur minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Spoilers ahead! Fixes continued",
     "items": [
      {
       "text": "Fixed Mark’s arms in front of Nicole during their prom dance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed erroneous physics when removing a certain pushpin in Part 1, Chapter 4 “Real Part”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the game not pausing after finishing a practice piece in Part 1, Chapter 5 “Last Practice”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the metronome setting of “100 Progressive Studies” in Part 1, Chapter 5 “Last Practice”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed more than one Cathy appearing at the same time in Part 2, Chapter 5 “Audition Day”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the arrow icon getting stuck in Part 2, Chapter 5 “Save Me, Please”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Mark unnecessarily standing up in Part 3, Chapter 5 “Until Then”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed visual artifacts of trees and branches in Part 3, Chapter 5 “Until Then”: Thanks for playing! We appreciate your dedication and continual support for Until Then!: Follow the Until Then X account for all the latest updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
