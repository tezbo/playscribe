     "title": "Patch 1.1",
     "items": [
      {
       "text": "Fixed crash when migrating demo save data on Windows",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Demo save data migration now unlocks the first scene of Chapter 2 if the demo was completed",
       "ps5ProOnly": false,
