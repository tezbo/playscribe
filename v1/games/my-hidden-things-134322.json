  {
   "id": "my-hidden-things-134322@patch-2020-06-09",
   "gameId": "my-hidden-things-134322",
   "displayName": "The work on the new patch is in full swing!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-06-09T13:24:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello! Ophelia Level 2 sometimes behaves strangely. I don’t understand why it contains bugs, it was created just like everyone else ... If you experience difficulties with it, then reboot it, and I will try to find the reason for this behavior ...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We want to share the adventure of Ksari and you with the whole world. The main task of our team now is to make the game accessible to a large number of players and fix bugs. At the moment, we are working on translations into Portuguese and Chinese. But if you know someone who can help us with translation into other languages, we will be happy. Our contact sixdotsstudio@gmail.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
