  {
   "id": "shadow-gangs-133056@4.0",
   "gameId": "shadow-gangs-133056",
   "displayName": "Update 4.0",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-01-05T00:58:48.000Z",
   "notes": [
    {
     "title": "Many fixes and tweaks",
     "items": [
      {
       "text": "-16 credits on Easy and Normal difficulty. (Rising Ninja and Ninja)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Prone gunman removed from level 1 in easy and normal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bigger collision box for the prone gunman, so making contact with him is easier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "No more dying falling from the ships in the bridge level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Art assets enhancements for pickups in both game and hud.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Checkpoint position change in the forest level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added one checkpoint in the temple level, just before the two Collins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Honcho Dragon no more dying inside the mountain in the Bamboo level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Killing a boss will automatically switch the game to the end mission credits, instead of waiting for the exit pickup to drop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "No more waiting for the pickups to stabilize on the ground to pick them, now they can be picked as soon as they hit the ground the first time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased the fall height a bit, no more dying when falling from small heights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Code is more optimized.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Very rare crash when starting the game fixed.: And a lot more fixes and enhancements, any issues please let me know.: This will probably be the final gameplay and art update, any new update will be for hardware issues, compatibility etc...: Don't forget the back the Dreamcast version please if you are interested, there is physical versions available, and also a stretch goal for Shadow Gangs II.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
