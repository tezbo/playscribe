  {
   "id": "shadow-gangs-133056@post-2026-10-24",
   "gameId": "shadow-gangs-133056",
   "displayName": "60 FPS Gameplay and Steam Input Improvements",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-24T23:50:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update addresses two issues reported by players: gameplay timing on different monitor refresh rates and controller compatibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "60 FPS gameplay across monitor refresh rates",
     "items": [
      {
       "text": "Gameplay now runs at its intended 60 FPS timing independently of your monitor's refresh rate. This fixes refresh-rate-related game speed and timing issues, including on high refresh rate displays.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Steam Input controller support",
     "items": [
      {
       "text": "Shadow Gangs now uses Steam Input, improving controller detection and compatibility. Default layouts are included for Xbox, PlayStation (including the PS5 DualSense), Nintendo Switch Pro, Steam Deck and other supported controllers.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can customize your controls through Steam's controller settings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you still encounter an issue, please leave a comment with your monitor's refresh rate or your controller model.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
