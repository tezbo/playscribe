  {
   "id": "shadow-gangs-133056@post-2026-10-25",
   "gameId": "shadow-gangs-133056",
   "displayName": "Controller Pause and Steam Overlay Fixes",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-25T16:36:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue where pressing Pause or the PS5 touchpad to resume would immediately reopen the pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Improved Pause and Back handling for controllers and keyboards. B/Circle goes back in menus without pausing gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The game now pauses when the Steam overlay opens or the active controller disconnects.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Closing the Steam overlay leaves the game paused until you choose to resume.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
