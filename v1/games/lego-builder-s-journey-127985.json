  {
   "id": "lego-builder-s-journey-127985@major-2023-03-16",
   "gameId": "lego-builder-s-journey-127985",
   "displayName": "Steam Deck Update Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-16T15:59:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "LEGO Builder's Journey now support touch input on Steam Deck and Intel Arc series 7 graphics cards.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Light Brick Studio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "— Patch Notes —",
     "items": [
      {
       "text": "Optimized Graphics Settings - Low, Medium, High settings now use adjusted settings, for improved performance and image quality.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustments for ray traced reflections and ambient occlusion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Support for Intel A770 graphics cards. (Ray traced reflections use slightly different settings on A770)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Touch input for Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Minor material adjustments on a few levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
