  {
   "id": "lego-builder-s-journey-127985@major-2025-05-27",
   "gameId": "lego-builder-s-journey-127985",
   "displayName": "The robot’s adventure update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-27T10:27:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This new update to LEGO® Builder’s Journey answers many of your burning questions. What happened to the robot? Why was it abandoned in the cave? Who is it, really?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Join the robot on its incredible journey and discover what happened to it before, during, and after the events of LEGO Builder’s Journey. Discover new locations and a new way of playing as you get a glimpse inside its head. Literally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Go explore with your new robot friend!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
