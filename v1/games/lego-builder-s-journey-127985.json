  {
   "id": "lego-builder-s-journey-127985@major-2021-11-25",
   "gameId": "lego-builder-s-journey-127985",
   "displayName": "Update Notes for November 25",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-11-25T12:21:10.000Z",
   "notes": [
    {
     "title": "New in this release",
     "items": [
      {
       "text": "Added support for AMD FidelityFX™ Super Resolution (FSR) that uses cutting-edge upscaling technologies to help boost the framerate and deliver high-quality, high-resolution rendering, without having to upgrade to a new graphics card.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added graphics options to enable/disable: Sub-Surface Scattering, Film Grain, Chromatic Abberation, and Panini Projection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Performance improvements for all graphics and ray tracing settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Performance improvements for reflections and lighting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Minor adjustments to some levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
