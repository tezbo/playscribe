  {
   "id": "minecraft-dungeons-ii-395525@major-2026-11-16",
   "gameId": "minecraft-dungeons-ii-395525",
   "displayName": "November 2026 Balance Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-11-16T09:31:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[p align=\"start\"]Greetings, Heroes! We've published a game balance update to all platforms, introducing changes based on player feedback. No game update is required, and the changes will take effect the next time you login to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balance Changes",
     "items": [
      {
       "text": "Increased Echo Shard cap from 100 → 999",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased Emerald cap from 99,999 → 999,999",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Buffed the Corrupted Beacon artifact",
     "items": [
      {
       "text": "Increased damage 9 → 18",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Decreased time between hits 0.8 seconds → 0.3 seconds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased movement speed 0.05 → 0.15",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased rotation speed 0.01 → 0.03",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated soul cost to be more constant during item usage 20 souls every 1 second → 6 souls every 0.3 seconds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced Poison damage over time to players 15 seconds (1/2 full health) → 10 second (1/3 full health)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced Soul Corrupted Witch boss health 1200 → 1000",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased Emerald caps for maximum damage bonuses of Thrifty Pendant talisman from 7K/8K/9K to 50K/200K/500K",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "[p align=\"start\"]We're currently focused on additional improvements based on your feedback, as well as the first DLC: The Humblers Awaken!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]Please keep your feedback coming at aka.ms/Dungeons2Feedback or discord.gg/minecraftfeedback, and report any bugs to aka.ms/Dungeons2Bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
