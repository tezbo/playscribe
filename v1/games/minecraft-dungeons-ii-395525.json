  {
   "id": "minecraft-dungeons-ii-395525@major-2026-10-01",
   "gameId": "minecraft-dungeons-ii-395525",
   "displayName": "New Update: Steam Deck Playable",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-01T16:25:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new Minecraft Dungeons II update is available on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The game should now be playable on Steam Deck. Some issues may occur such as missing on-screen keyboard functionality, but more improvements will be coming in a future update to bring full Steam Deck verification.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Additionally, we've pushed a game balance update to all platforms, increasing the emerald cap increased from 9,999 to 99,999. No game update is required and the change will take affect the next time to login to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please keep your feedback coming at aka.ms/Dungeons2Feedback and report any bugs to aka.ms/Dungeons2Bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
