  {
   "id": "minecraft-dungeons-ii-395525@1.1.3.0",
   "gameId": "minecraft-dungeons-ii-395525",
   "displayName": "Hotfix 1.1.3.0",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-10-22T07:59:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new Minecraft Dungeons II update is available on all platforms, bringing stability improvements and other top blocking issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Stability and Performance",
     "items": [
      {
       "text": "Fixed several crashes that could occur during gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a hard lock that would occur when a couch co-op party returned to the main menu from the Overworld and the second player was kicked from the party when the attempting to create or select a Hero",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved login stability around error code \"CH1\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Items",
     "items": [
      {
       "text": "Fixed artifact slots becoming unusable after being used in rapid succession (MCD2-135)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Quests",
     "items": [
      {
       "text": "Fixed the Prime Enchanter arena remaining lowered and preventing progression after leaving and rejoining a session (MCD2-67)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the quest marker not pointing to the correct locations during the \"Wrath of the Sculkers\" quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the quest marker not pointing to the correct location during the \"Training with the Enchantsmith\" quest (MCD2-23)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the quest journal displaying too many player icons during online sessions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The team is focused on additional fixes and improvements based on your reports. Please keep your feedback coming at aka.ms/Dungeons2Feedback or discord.gg/minecraftfeedback, and report any bugs to aka.ms/Dungeons2Bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
