  {
   "id": "minecraft-dungeons-ii-395525@1.1.2.0",
   "gameId": "minecraft-dungeons-ii-395525",
   "displayName": "Hotfix 1.1.2.0",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-10-08T16:56:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[p align=\"start\"]A new Minecraft Dungeons II update is available!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a variety of client and server crashes that could occur during gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash that could occur when the Prime Enchanter hit the floor with Lightning Slam ability in the same moment as a TNT explosion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash that could occur when exiting an online game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed blurry visuals when the game was launched with Ultra graphics quality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]The team is focused on additional fixes and improvements based on your reports. Please keep your feedback coming at aka.ms/Dungeons2Feedback and report any bugs to aka.ms/Dungeons2Bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
