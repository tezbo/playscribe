  {
   "id": "whiskey-zombies-117253@major-2021-08-17",
   "gameId": "whiskey-zombies-117253",
   "displayName": "August Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-08-17T15:47:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have gone in a tinkered under-the-hood and hopefully the leaderboards are now fully operational.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Thanks for everyone that pointed this out). Erroneous entries on the boards will be amended. If you are adversely effected and you feel this is where I'm gonna plant my flag -- drop us a line at support@whiskeyandzombies.com and we will make it up to you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy drunk gaming the apocalypse! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "/Team McCreary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
