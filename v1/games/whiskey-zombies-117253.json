  {
   "id": "whiskey-zombies-117253@major-2021-10-28",
   "gameId": "whiskey-zombies-117253",
   "displayName": "Major Halloween Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-10-28T15:10:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Big ghoulish update with a brand new game mode and a Halloween-inspired level — Maze Runner! (also available in the demo!!)There are also exploding pumpkins, new power-ups, plus a lot of quality of life/UI improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AND to celebrate this most horrific of holidays, we're also launching a big competition around the new level. Be the first one to beat it, or have a top-10 finish — and you can win some really killer stuff, from Funko POP!s to Game Bundles (worth up to $75) plus a lot more! Competition starts at 9am PST on October 28!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New game mode: Maze Runner",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New map/level: The Great Halloween Maze Escape",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New leaderboards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Exploding pumpkins",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Power-ups: Insta-heal and Insta-drunk",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boss Zombies with seasonal head-attire",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tons of bugs fixed and UI improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Check www.whiskeyandzombies.com for more info, rules, and schedule for the competition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(We are also just giving away a bunch of stuff on social media, if you're into free stuff :))",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "/Team McCreary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
