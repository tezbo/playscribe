  {
   "id": "smelter-119191@post-2021-04-22",
   "gameId": "smelter-119191",
   "displayName": "And we're back!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-04-22T13:27:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey folks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As you might have heard, we ran into a super big issue earlier that was preventing players from proceeding in Smelter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The team has found the issue and the updates have been made!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Again, we're really sorry about the inconvenience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With that said, here are the short and (hopefully) sweet patch notes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "###Platformer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(fix)Fixed a critical issue that was causing Eve to fall through the stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
