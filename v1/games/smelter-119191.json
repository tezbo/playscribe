  {
   "id": "smelter-119191@1.0",
   "gameId": "smelter-119191",
   "displayName": "Hotfix 1.0",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-05-01T05:08:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While not everyone playing has experienced them, we've needed to do another round of hot fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Please check them out below",
     "items": [
      {
       "text": "### Platformer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Fix) Spikes in one of Nutoro Sky Reach's challenges weren't working: ### Strategy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Fix) Auto save when entering the last level wasn't working properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Fix) Loading a save game during tutorial after clearing Gumboor would soft lock the tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Fix) The \"Last chance to save\" pop up couldn't get closed anymore in some situations: ### Others",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Fix) Continuing the game after clearing it and going straight to the last stage again would soft: lock the game in the cutscene after the first fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
