  {
   "id": "smelter-119191@1.0.6",
   "gameId": "smelter-119191",
   "displayName": "Patch 1.0.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-04-28T14:53:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Since we are based in Osaka, Japan, we are going to enter the Golden Week holidays from tomorrow and therefor we were crunching today for you guys to push this new update for you before we are going to take a small rest. We hope you guys enjoy this one:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "### Platformer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(fix) Laser turret audio bug: ### Strategy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(fix) Potential soft-lock issue happened for some in the first Eremagu quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(fix) Position of Zirm soldiers was incorrect causing them to look like floating",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(fix) Blur effect wasn't visible while the Obelisk Trials UI was open",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(update) Added some occupation indicator for Blessings and Spires",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(update) Volcanoes in Gurabi quest 3 now always show the HP bar during the quest while they are not destroyed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(update) Hellium cost for Heart upgrades removed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(update) Zirm soldiers amount information added to the resources bar: ### Others",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(fix) Some localization related visuals fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(update) Selection visuals in menus updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(update) In the control settings menu tabs can be switched by using controller bumper buttons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(update) Smelter's Heart upgrades + HP-Up added to Glossary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
