  {
   "id": "smelter-119191@hotfix-2021-04-22",
   "gameId": "smelter-119191",
   "displayName": "Super Hot Fixes 4/22/2021!",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-04-22T07:51:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We already have some hot fixes right off the press!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Please check them out below",
     "items": [
      {
       "text": "### Platformer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(fix) Several soft-locking issues during cut scenes fixed: ### Strategy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(fix) One of the volcanoes in the last Gurabi quest wasn't showing up properly: ### Others",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
