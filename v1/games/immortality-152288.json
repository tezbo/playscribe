  {
   "id": "immortality-152288@major-2022-09-02",
   "gameId": "immortality-152288",
   "displayName": "Update Notes for Sept 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-02T00:56:15.000Z",
   "notes": [
    {
     "title": "This patch has these fixes",
     "items": [
      {
       "text": "For players who have seen the endgame but had the game freeze before the credits, this will unlock the achievement for finishing the game. If you have previously passed the conditions for this achievement, it will unlock on loading into the menu. NB: We have been unable to reproduce this issue on Steam, but are including it here as a failsafe.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A fix for the issue where players were not triggering the Another Reality achievement. If you have previously passed the conditions for this, the achievement will unlock on entering the grid.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A fix for the issue where players who force quit the game, or in some cases use a cloud save, when loading the game fail to regenerate thumbnails (the game will tell you it is ‘reloading save data’. This should now be fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A fix for the issue where players who enter and exit Image Mode without teleporting during the tutorial will lose subtitles until they return to the grid.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
