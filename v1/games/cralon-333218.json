  {
   "id": "cralon-333218@major-2026-04-24",
   "gameId": "cralon-333218",
   "displayName": "First Cralon Update brings Fixes and Improvements!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-24T20:56:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everybody!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just released our first update after the launch of Cralon! Thanks to all of you for following Cralon into the pit!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
