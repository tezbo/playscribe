 "releases": [
  {
   "id": "leila-258420@1.0.3",
   "gameId": "leila-258420",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-15T00:31:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! Thanks for playing our game and reporting bugs! Here is our second patch of the full release. Just some teeny-tiny fixes and improvements. Nothin' fancy here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "- FIX: Mancave JigsawPiece dragging bug",
     "items": [
      {
       "text": "I Receive: No more cursor-loving-sticky-object bug;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You Receive: No more rotating while dragging",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "- UPD: Hold button behaviours improved",
     "items": [
      {
       "text": "We noticed that hold interaction feedbacks on New Game button in Main Menu and Quit Game button in Pause Menu are unclear. To improve readability and interactability, we increased the reset times after button release and allowed buttons to be filled by either holding or pressing multiple times in succession.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "These apply to all hold buttons in Main Menu and Pause Menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "- UPD: Mancave GridLight puzzle UX improved",
     "items": [
      {
       "text": "We realized that getting the connection between puzzle components can be challenging, so we disable some elements once they are no longer needed to solve the next puzzles. To clarify: Darts and Cassettes interactions are disabled after Cassettes are placed in correct order.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
