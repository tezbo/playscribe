  {
   "id": "venus-vacation-prism-dead-or-alive-xtreme-318023@1.04",
   "gameId": "venus-vacation-prism-dead-or-alive-xtreme-318023",
   "displayName": "Update 1.04",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-17T06:04:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Additional Functions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added ☆ symbols for photo evaluations to the camera screen during photography.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a function to retain the position and color of the point light during game play.: Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted the positioning of the copyright notation displayed on photos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made it possible to choose JPG as the format when saving photos to the device's storage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a controls guide to the screen when skipping scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made it easier to get higher scores for photo evaluations.: Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that sometimes prevented photos from saving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that sometimes caused photos to be saved in the wrong location.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that sometimes prevented photos from saving properly if taken with HDR enabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We have fixed the bug that caused the camera to move even when the controls were not in use by adjusting the controller stick sensitivity to stabilize camera movements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made other minor bug fixes and adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
