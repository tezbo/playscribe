  {
   "id": "hidden-cats-in-santa-s-realm-279125@post-2024-01-17",
   "gameId": "hidden-cats-in-santa-s-realm-279125",
   "displayName": "Recent Updates",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-01-17T11:17:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello friends, we have been working on all games from Hidden Cats Series to fix reported issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here are the last updates for Santa's Realm.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FIXED - Typing errors;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Invert Zoom option;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - UI issues;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Objects not getting colored;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Camera keyboard (WASD) controls;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "FIXED - Chopper speed was too fast;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - Sometimes a level doesn't call the end-game animation;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enhancements to avoid game break.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "NOTE",
     "items": [
      {
       "text": "Due to the technical nature of the game, sometimes updates can be quite big compared to the game size already installed, even when the update itself is a small thing. But, make note that this won't increase too much of your install files as it is already.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
