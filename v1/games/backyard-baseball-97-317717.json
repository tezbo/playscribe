  {
   "id": "backyard-baseball-97-317717@major-2024-11-07",
   "gameId": "backyard-baseball-97-317717",
   "displayName": "UPDATE: Crowd Control is Here! Add Real-Time Effects in Backyard Baseball ’97! ⚾",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-07T17:33:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re thrilled to announce the latest update for Backyard Baseball ‘97, featuring Crowd Control Integration! Now, viewers on streaming platforms can impact the game in real-time by donating to various gameplay effects, adding a new layer of fun for both streamers and fans.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s how it works",
     "items": [
      {
       "text": "Through Crowd Control, fans can donate to trigger special effects during live streams, keeping the game exciting with each play. Streamers can now experience hilarious and challenging twists courtesy of their audience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are some of the effects viewers can apply",
     "items": [
      {
       "text": "Arm Injury",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Trade away the pitcher for a randomly chosen backyard kid",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crazy Throw",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The next time the ball is thrown, it will have the \"Crazy Bunt\" effect, making it hard for fielders to catch it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crosshairless",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hide the Strike Zone indicator for the rest of the at-bat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Force Blunt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The batter is forced to bunt for the rest of the at-bat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Force Walk",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The pitcher is forced to pitch intentional walks for the rest of the at-bat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Framerate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Make the game run at a crazy fast speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Max Power",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Make the fielders throw the ball at ludicrous speed for one play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pinch Hitter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Trade away the batter for a randomly chosen backyard kid.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pitches Be Crazy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Give the pitcher a random POWERUP pitch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Puny FIelders",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Make all fielders tiny and weak.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Randomize Fielders",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Make the fielders start at random positions in the field.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restless Batter Syndrome",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rapidly causes the batter to alternate their batting stance!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Second-String Hitter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Trade away the batter for a randomly chosen generic kid.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Second-String Pitcher",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Trade away the pitcher for a randomly chosen generic kid.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sloppy Fielder",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increases occurrences of errors for the current fielders.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Snow Globe",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disables home runs by preventing the ball from going above the walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sonic Boom",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Causes all fielder to fall over.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Substitute Bleacher",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Swap out the entire team for 9 copies of the same kid",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Swing King",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Give the batter a random POWERUP swing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With Crowd Control, your favorite streamers can now rely on their communities to throw curveballs into every match, making each game of Backyard Baseball ’97 a unique experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get ready to experience baseball like never before – bring on the chaos and cheer on your favorite streamers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This integration brings fans closer to the action, making Backyard Baseball ’97 even more interactive and fun to watch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
