  {
   "id": "backyard-baseball-97-317717@major-2024-10-16",
   "gameId": "backyard-baseball-97-317717",
   "displayName": "Backyard Baseball ’97 Update Alert 🚨",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-16T14:24:58.000Z",
   "notes": [
    {
     "title": "Hi-ho! We’ve rolled out yet another patch to further improve your experience",
     "items": [
      {
       "text": "⚾Patch 1.0.3: An additional fix for the glitchy cursor issue that continued to persist for certain DPI settings after the previous patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To make sure you’re playing the latest version, follow these steps to download the Steam update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Open the Steam application.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Click Library at the top.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Right-click on Backyard Baseball ’97.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select Properties from the drop-down menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Head to the Updates tab.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Choose how you’d like to update the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam will begin updating the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚠️ Note: While this patch continues to address some current issues, please remember that certain bugs from the original game may still exist. Without access to the original source code, some legacy problems remain beyond our control. But rest assured, we’re doing our best to make your experience as smooth as possible!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any problems, we’d love to hear from you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👉 Report a bug here",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for your continued support, and let’s keep the fun going! 🙌⚾",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
