  {
   "id": "the-transference-273790@0.3.010",
   "gameId": "the-transference-273790",
   "displayName": "Patch 0.3.010",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-10T17:50:18.000Z",
   "notes": [
    {
     "title": "Bugs fixed",
     "items": [
      {
       "text": "There were some walls that the character could walk through and go out of the stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The interactable area with one of the items has been extended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If the player died and did not get the letter document, it could now be get never.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The textures of the basement monitors had disappeared with the last update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If the player died, the state of the clock puzzle was reset and did not maintain the state the player configured it in.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Improved the compression of the documentation for one of the puzzles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed the picture in the corridor, because Sofia appeared with black hair, instead of grey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new decoration details in the basement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Prevented one of the game's dynamic puzzle solutions from generating too easy solution.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A new objective has been created, in the list of objectives to do in the game, which better clarifies what to do at that point in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some texts have been added and changed to improve the expression and/or explain some parts of the story better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some players were not clicking the continue button, to continue reading some texts. An animation has been added to highlight the button to press.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The first furniture to interact with, now stands out much more than the others, to improve FTUE.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The sound of moving between menus has been avoided, if you reach the limits of the menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
