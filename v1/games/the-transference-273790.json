  {
   "id": "the-transference-273790@0.3.011",
   "gameId": "the-transference-273790",
   "displayName": "Patch 0.3.011",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-25T21:23:18.000Z",
   "notes": [
    {
     "title": "Bugs fixed",
     "items": [
      {
       "text": "Fixed a bug that could leave an interaction indicator on a door, even if you weren't looking at it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some texts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some lines of dialogue in English have been re-recorded to be more similar to the Spanish audio (the original).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the volume of the voices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed the sound of the main character's footsteps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some sound effects have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added some text to areas you interact with.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enemy AI has been improved. Now it will listen when you open and close doors and if it sees you hiding somewhere, it will take you out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
