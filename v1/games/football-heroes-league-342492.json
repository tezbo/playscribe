  {
   "id": "football-heroes-league-342492@patch-2025-05-06",
   "gameId": "football-heroes-league-342492",
   "displayName": "May 6th Patch - Networking Improvements & Bug Fixes",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-06T07:21:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added more regions and improved region detection. This should help reduce network latency for some players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed matchmaking bug where players would have uneven teams.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced Bun-E's Defender Bot size by 20%, and increased its cooldown by 40%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed Frostine skinning bug.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
