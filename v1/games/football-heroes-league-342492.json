  {
   "id": "football-heroes-league-342492@major-2025-05-23",
   "gameId": "football-heroes-league-342492",
   "displayName": "May 23 Update: Game Flow, Chat, and Shop",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-23T18:09:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re incredibly grateful for your support during Early Access! Every match you play and every bit of feedback helps shape the future of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚽ Game Flow and Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the AI match startup to a Yes/No that can be declined instead of automatically starting an AI bot match.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced Mercy Rule from a 7 to a 5 score difference, added UI that shows your victory through mercy ruling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Decreased Game time to 3 minutes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced the velocity of Bunbot's kick by 50%, making them less likely to score.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "💬 Chat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed chat filtration. Common words should be protected now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added chat spam prevention in the chat box by adding a timer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug causing chatbox to disable button inputs on the post game screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🛍️ Shop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated Shop with better user experience for purchases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New items featured in the Shop, get them while they're here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🐛 Game Play Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bugs that make the ability SFX and VFX loop during gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that let you use abilities during game start cinematic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that made the sprinting camera shake getting stuck on your camera.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed emote wheel not selecting correct emotes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other bug fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More updates and new features are already in the works. Stay tuned and keep playing—we’re building this together!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "— The Football Heroes League Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
