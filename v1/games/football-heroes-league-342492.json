  {
   "id": "football-heroes-league-342492@major-2025-05-15",
   "gameId": "football-heroes-league-342492",
   "displayName": "May 14 Update: Connectivity, Chat, and Leaderboard Fixes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-15T00:19:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Message of the Day",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A rotating notice to keep you up to date on events, challenges, and more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI Fill for Solo Lobbies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If no one joins your match within 1 minute, you’ll see a pop-up announcing AI players will be added in 90 seconds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Timer resets if real players join.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI-filled matches don’t affect rank—but you can still complete Quests and earn EXP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chat Disable Setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Turn in-game chat on or off at any time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔗 Account & Progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Linked Accounts now properly receive ranked points.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Daily Free Heroes will reliably reset at your local 6 AM time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🌐 Matchmaking & Connectivity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Expanded Regional Matchmaking: Broader search to nearby regions for faster matchmaking and more matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Better Ping Determination: Smarter algorithms to pair you with servers offering the best connection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Relaxed Host-Migration Requirements: Reduced disconnects by easing criteria for when migrations occur.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Connectivity Pop-up Moved: Issue notifications now appear neatly in the top-right corner.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📊 Leaderboards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dynamic Positioning: Always see 10 players above and 10 below you—no matter where you rank.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All Categories Visible: No more missing leaderboards; every stat and category shows up correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🌍 Localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added full support for Turkish and Spanish (Latin America).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🐞 Bug Fixes & Quality of Life",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed over-zealous chat filter that was blocking valid messages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Weekly quests now correctly display hero names.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved issue where daily free-hero icons could grey out on rank changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Camera inversion settings now save and apply correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bun-E Defend Bot dome reticle size corrected for proper targeting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chromatic aberration graphics setting now persists between sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "VFX have been optimized for performance and stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
