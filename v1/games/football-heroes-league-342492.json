  {
   "id": "football-heroes-league-342492@major-2025-06-10",
   "gameId": "football-heroes-league-342492",
   "displayName": "Jun 10 Update: Gameplay, Game Flow, and Leaderboard",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-10T18:43:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Your feedback as Early Access players is crucial for improving the game. Your input guides development, refines features, and helps us exceed expectations. We value your contribution to shaping the game's future. 💙",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚽ Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Leo's got a new jump mechanic! Tapping the button does a standard jump, while holding it down gives a boosted jump.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the game start time after the last player joins to 35 seconds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Emote wheel navigation fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "‘Fingerguns’ emote is unlocked by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🎮 Game Flow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new gameplay option to expand the game mode search between 2v2 and 3v3, allowing searching for other game modes than the one you have selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated quests to grant Hero Coins for daily and weekly quest completion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changes in the lobby with friends, where players cannot properly start a game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixing the account linking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug where linked accounts are sometimes stuck in the lobby loading loop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "📊 Leaderboard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased leaderboard entries above and below the player rank.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated leaderboard to show the bottom 50 entries if the player is not found in the first 1000 entries.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More updates and new features are already in the works. Stay tuned and keep playing—we’re building this together!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "— The Football Heroes League Dev Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
