   "announcedAt": "2023-08-29T06:34:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Happy Tuesday Scrappers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update is now available to download for PixelJunk Scrappers Deluxe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been listening to community feedback and working away behind the scenes of Junktown to prepare an assortment of changes to share with you. Here's a quick overview of the latest update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay changes to reduce difficulty whilst playing solo, including:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced enemy HP and frequency for solo play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Re-balanced challenge completion requirements for solo play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "S.C.R.A.P will now deposit trash directly into your truck more frequently in solo play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changes to the network multiplayer UI to make it more convenient when playing online (Adding confirms on quit, remembering party codes etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for audio being too loud on start up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The settings menu is now available before the tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Timeout extended for multiplayer character selection: Thank you as always for your continued support, it really means a lot!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
