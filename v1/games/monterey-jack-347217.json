   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all you cheesy gamers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The following changes have been made",
     "items": [
      {
       "text": "Increased the Balloon Blitz prize to 100 tickets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added more tickets throughout the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Run key can now be remapped in the keymapping menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Side note: For those on Xbox, achievements are now working properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Also, if you see a thick white fog while playing, set your graphics to Low and it should go away. This is caused by Volumetric Fog and your system settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
