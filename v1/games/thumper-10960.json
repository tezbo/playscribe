  {
   "id": "thumper-10960@post-2020-01-19",
   "gameId": "thumper-10960",
   "displayName": "Thumper Soundtrack Updated for New Steam Experience",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2020-01-19T05:52:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've updated Thumper's Original Soundtrack to take advantage of some new Steam features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First, you can now browse, manage, and filter the soundtrack from your Steam library.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "You can also play it directly from the Steam library",
     "items": [
      {
       "text": "Finally, high-quality FLAC audio is optionally available for the soundtrack. To get it, make sure you've checked the \"Download high-quality audio files\" in your Settings > Music dialog. The FLAC files will be installed into a \"flac\" folder in your soundtrack installation directory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
