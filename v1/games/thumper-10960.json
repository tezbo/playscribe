  {
   "id": "thumper-10960@major-2022-02-15",
   "gameId": "thumper-10960",
   "displayName": "Steam Deck and Controller Compatibility Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-02-15T10:44:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Here's an update to ensure the game will work well on Steam Deck. It also improves how the game works with different controller types. It should also let Linux users play the game via Proton (though we don't officially support that).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Here's what's changed",
     "items": [
      {
       "text": "Fixed issues Steam Deck compatibility issues",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added support for PS5 and Nintendo Switch controllers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Adjusted trigger vibrations to feel better on Xbox Series S/X controllers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Fixed single frame glitch of whiteness when game starts up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
