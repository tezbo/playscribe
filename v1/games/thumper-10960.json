  {
   "id": "thumper-10960@major-2019-07-01",
   "gameId": "thumper-10960",
   "displayName": "Thumper Update Out Now",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-07-01T02:39:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A maintenance update with the following fixes and changes is out now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various stability and performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues playing in VR mode with multiple video cards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed vibration issues with Xbox One controller and added support for trigger vibration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Allow Start/ESC press + hold to recenter VR tracking origin on title screen (as well as after)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added \"pre Windows 10\" launch options for legacy support",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Updated FMOD to fix audio device initialization issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated Polish text (thanks Marek!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated Dutch text (thanks Jordy!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated Oculus VR SDK to fix compatibility issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Dutch language setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Disabled Razer Chroma support by default (to enable add “-chroma” option under Library > Thumper > Properties > GENERAL > SET LAUNCH OPTIONS...)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you're having trouble running the game with this update, see this post on diagnostic information and how to send it to us for support. Thanks!",
