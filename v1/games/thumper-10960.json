  {
   "id": "thumper-10960@major-2019-11-26",
   "gameId": "thumper-10960",
   "displayName": "Thumper Maintenance Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-11-26T12:00:38.000Z",
   "notes": [
    {
     "title": "A few small fixes are in the latest update",
     "items": [
      {
       "text": "Fixed case where game will run in slow motion in Oculus VR mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Windows 10 exe is only auto-launched when using Windows 10 build 15063 or later. This avoids potential compatibility issues with older Windows 10 releases.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Re-deprecated Razor Chroma support. If it was working for you and you want to keep using it, you can add \"-chroma\" to your launch options (Library > Thumper > Properties > GENERAL > SET LAUNCH OPTIONS...)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
