  {
   "id": "thumper-10960@hotfix-2019-10-03",
   "gameId": "thumper-10960",
   "displayName": "Thumper (Final??) Hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2019-10-03T09:03:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Of course our \"final\" update has to be followed by a \"final\" hotfix!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Limit update rate of Xbox One controller vibration in Windows 10 exe to 30Hz to fix trigger vibration issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "Allow alternate key for menu “select” to be remapped on keyboard controls screen",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issue with some keys not working when mapped to gameplay actions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor input issues on keyboard controls screen",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Prevent boss bonus thumps from unlocking shields when pounded. This prevents bugs that happen when a shield is prematurely unlocked before a boss phrase begins (thanks Hannes!).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed minor issues with DualShock 4 controller in Windows 10 exe",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Disable vibration on previous controller when hot swapping to a new controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This should address all known issues we plan to fix. Of course, we'll still be looking out for any new major issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
