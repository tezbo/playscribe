  {
   "id": "thumper-10960@major-2019-10-01",
   "gameId": "thumper-10960",
   "displayName": "Thumper (Final?) Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-10-01T07:56:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Our latest update includes many small usability improvements and fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're not planning further updates at this time, but we'll respond to any new major issues. A special thanks to all the players who've helped us find and fix everything!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added controller/keyboard hot swapping support",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved button/key remapping on controls screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added stereo vibration effects for Oculus Touch (Oculus VR Mode)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed the three “Win10” launch options. Windows 10 is now detected by the default executable and the Windows 10 compatible executable is automatically launched. If you want to use the Windows 7/8 exe on Windows 10, use the \"-force_win8\" launch option.",
       "ps5ProOnly": false,
