   "announcedAt": "2020-02-15T06:07:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The latest update fixes a few issues related to VR mode (both Steam VR and Oculus)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed re-centering VR position and orientation (hold ESC key OR start/pause button)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed pausing via keyboard (ESC key) in VR mode",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Playing in VR mode no longer requires the Thumper desktop window to be focused. This was causing issues where the game appeared to hang when launching into VR mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
