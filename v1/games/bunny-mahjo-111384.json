  {
   "id": "bunny-mahjo-111384@4",
   "gameId": "bunny-mahjo-111384",
   "displayName": "Update 4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-02-05T12:56:56.000Z",
   "notes": [
    {
     "title": "We localized the game to the following languages",
     "items": [
      {
       "text": "russian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "french: If your operating system is in one of these languages than the game will start in your language automatically: If not (or you want to change language) go to your steam library, right click Bunny Mahjo, select Properties. On the tab General there is a button \"Set launch options\". Press it and in the window type: \"culture=\"your language\"\": culture=\"en\" (for english): culture=\"ru\" (for russian): culture=\"fr\" (for french): If you find any mistakes in translation feel free to let us know in the steam discussians or e-mail and we'll fix it ASAP: P.S.: more languages coming soon: P.P.S.: achievements and the game page are localized too",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
