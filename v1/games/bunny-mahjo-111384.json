  {
   "id": "bunny-mahjo-111384@1",
   "gameId": "bunny-mahjo-111384",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-11-12T10:37:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "added options to join friends. Now you can see if any friends are playing Bunny Mahjo and you can join them if they play alone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added the number of the left matching pairs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added the name of the player to the hall of fame (players sees their own hall of fames with their own achievements)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "fixed the leaderboard showed the last puzzle best result after completing the custom puzzle. Now there is no result.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed the achievements with no hints don't open when the last tile was pressed by the client-bunny",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed the issue with the loading best results at the end of the match from the save in some puzzles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
