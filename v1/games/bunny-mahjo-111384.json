  {
   "id": "bunny-mahjo-111384@5",
   "gameId": "bunny-mahjo-111384",
   "displayName": "Update 5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-02-19T08:59:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The game is translated to german now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If your operating system is in one of the supported languages then the game will start in your language automatically",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If not (or you want to change language) go to your steam library, right click Bunny Mahjo, select Properties. On the tab General there is a button \"Set launch options\". Press it and in the window type: \"culture=\"your language\"\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "culture=\"en\" (for english)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "culture=\"ru\" (for russian)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "culture=\"fr\" (for french)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "culture=\"de\" (for german)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "fixed some localized text didn't fit the screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed the problem with shuffle menu when host and client both had it opened and after the host shuffled the tile the client menu remained on screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
