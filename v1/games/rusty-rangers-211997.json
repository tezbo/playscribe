     "items": [
      {
       "text": "For Steam Next Fest, we’ve dropped a demo update. Here’s what’s new:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Controls: Fixed keyboard support + added full mouse support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Gamepad: Added a loading screen hint: «Use your gamepad, Ranger!»",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level Design: Added a signpost to elevator rooms in the hub; polished tricky spots in some areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balance: Tweaked stats for certain items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugs: What bugs? Squashed a bunch of small issues!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Final Sprint: All hands on deck for Next Fest and our launch later this year. We’ll post more often—share your thoughts and questions! Talking with you matters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your turn: Jump into the new demo and test it out! We need your feedback to make Rusty Rangers even better!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
