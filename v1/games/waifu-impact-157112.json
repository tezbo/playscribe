  {
   "id": "waifu-impact-157112@major-2021-06-24",
   "gameId": "waifu-impact-157112",
   "displayName": "ARENA UPDATE!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-06-24T16:42:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ver 1.0.4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ARENA UPDATE!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Are you ready for a new challenge? The ARENA is now open!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new portal has appeared in Waifu Island, it will only activate once you unlocked all playable waifus (except Rika).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The ARENA is a difficult challenge for the most advanced players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Can you defeat 20 waves of WAIFUS? If you can you will have the honor to meet the ARENA queen Kagura.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can also play on the arena map to unlock gallery pictures faster!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "-Added new area, the ARENA.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added new game mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added new boss Waifu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added new playable character.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added new character's gallery.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
