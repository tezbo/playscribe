  {
   "id": "wand-order-tidy-up-the-magic-shop-411997@major-2026-09-23",
   "gameId": "wand-order-tidy-up-the-magic-shop-411997",
   "displayName": "📢 DELAY ON GAME LAUNCH - NEW UPDATE✨",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-23T09:17:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "\"Your app is currently in the review queue, and our review team will process it as soon as possible.\"",
     "items": [
      {
       "text": "This is the first time that Steam has sent a message like this instead of simply accepting or rejecting the review. We will update you ASAP for any new developments, so keep an eye on our store page or Discord server:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "CLICK HERE TO JOIN !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Keep your radars open for new updates, cause we are often updating the game's store page and our social channels!",
     "items": [
      {
       "text": "Until then, thank you for being so nice and supportive throughout all this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We really appreciate that, very much!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "OnSkull Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
