  {
   "id": "wand-order-tidy-up-the-magic-shop-411997@major-2026-08-28",
   "gameId": "wand-order-tidy-up-the-magic-shop-411997",
   "displayName": "📅 Launch Date Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-28T07:35:19.000Z",
   "notes": [
    {
     "title": "Hello again!",
     "items": [
      {
       "text": "We are working hard on polishing mechanics and making sure everything feels as satisfying as possible. Testing and debugging, especially for multiplayer, has proven to be more time-consuming than expected, so we have",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "moved the release date to September 18th.",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/46239512/5a7f963bcedf070d0a8315631dd43a6de2b511f7.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will soon be updating the store page with new content showcasing the rest of the mechanics available in the game. We hope you're as excited about that as we are!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "OnSkull Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
