   "id": "wand-order-tidy-up-the-magic-shop-411997@1.2",
   "gameId": "wand-order-tidy-up-the-magic-shop-411997",
   "displayName": "Hotfix 1.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-09-25T10:36:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just pushed an update with a ton of fixes that you have suggested and bugs you have found. These include:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Invisible Items Fix (settings option for integrated graphics users)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Larger crosshair option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Powers no longer recharge while game is paused",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Watering can refill indications",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A bunch of misspells, typos and naming fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep in mind that Steam Reviews are very important to us, so don't forget to write one!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, if you find anything or need help, let us know here or on discord! (JOIN HERE)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "OnSkull Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
