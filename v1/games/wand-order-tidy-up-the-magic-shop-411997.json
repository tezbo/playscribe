  {
   "id": "wand-order-tidy-up-the-magic-shop-411997@major-2026-09-18",
   "gameId": "wand-order-tidy-up-the-magic-shop-411997",
   "displayName": "📢 DELAY ON GAME LAUNCH - NEW UPDATE✨",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-18T23:06:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we're deeply sorry to inform you that you will have to wait a couple more days for the launch of Wand & Order.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sadly, we haven't heard from Steam yet and we also want to avoid launching on a weekend, it's not recommended to do so since Steam support is not active during that period.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please try to find it in your hearts to forgive us 🫶 we are as bummed about this as you are.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep an eye on our store page for new announcements, or join our discord server:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you don't see any news just assume that we are doing our best to try and bring this game to all of you and that we will let you know as soon as we got an update! 😊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Apologies again and thank you for the words of encouragement,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "OnSkull Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
