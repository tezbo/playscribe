   "displayName": "New Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-08-01T18:11:59.000Z",
   "notes": [
    {
     "title": "⯈ Changes",
     "items": [
      {
       "text": "• New capsule artwork (Steam Page)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• New menu logo art",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• New font, now supports letters with accents",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• New mechanic (in the last level)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Player cannot move during transitions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "⯈ Last Level",
     "items": [
      {
       "text": "The last level [=] has been redesigned with a new mechanic. This mechanic introduces clocks to collect, which extend the timer's duration before dying.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "⯈ Appreciation",
     "items": [
      {
       "text": "I'd like to express my gratitude to everyone who has supported my game by purchasing it; it's been almost 2 years since \"10 Seconds to Win\" was released. I promise there will be more game related news in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
