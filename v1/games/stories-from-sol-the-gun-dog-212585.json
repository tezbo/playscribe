  {
   "id": "stories-from-sol-the-gun-dog-212585@1.1.0",
   "gameId": "stories-from-sol-the-gun-dog-212585",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-29T06:51:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It has now been two full months since the launch of Stories from Sol: The Gun-Dog, and across all platforms and communities, we've received an outpouring of love and support for the game and we are grateful for all the suggestions, critiques, and expectations you've shared. It's been some time since our last update, and today we’re rolling out a new patch to address some of the concerns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this patch, we are adding a new screen scaling option, delivering the special rewards to beta players who participated in the survey, and taking the opportunity to fix some bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "- Add \"Scaling mode\" option",
     "items": [
      {
       "text": "\"Stretch\" is the existing display mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"Sharp\" will show the pixels perfectly, adding black bars around the edge of the screen if necessary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "- Add cosmetic bonus content for players who completed the survey at the end of the Steam demo",
     "items": [
      {
       "text": "Cassie Jacket: Can be enabled in the Options to show Cassie wearing the jacket you placed over her when she was unconscious at the end of the demo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bonus photos: Go to Cassie's quarters to see some extra photos of you and Cassie",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "*If you've completed the survey but can't see the bonus content, please let us know in the pinned discussion thread on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fix not being able to re-enter Cassie's quarters before the O'Brien",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix choosing to confront Vanessa sometimes playing the Hansen capture sequence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix datapad unlock task not updating when the password is auto-completed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Update the scrollbar in the narrative map to make it more visible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix visual issue with Cassie Down Graphic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix visual issue with Gun-Dog Shooting animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix visual issue in CM Foam animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix visual issue when viewing the history screen during the ending",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix scanlines not showing in the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix some typos in Spanish localisation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix typos in early game Fire Control",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix ITEM button not flashing in the Central Computer in part 16",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
