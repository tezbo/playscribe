  {
   "id": "stories-from-sol-the-gun-dog-212585@major-2023-06-20",
   "gameId": "stories-from-sol-the-gun-dog-212585",
   "displayName": "Demo Update Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-20T11:49:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Crew Members of Gun-Dog,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Based on the feedback we have collected from the community, we have made a few adjustments to ensure a smoother game play experience for players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Controller support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Controller support has been significantly upgraded. It should now feel a lot more natural.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Display a bar/icon next to the focused item in menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The right analog stick now performs the same action as mouse scrolling up/down",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "This includes opening and closing the new history menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All menus should now open with the first item focused",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The B button consistently backs out of the current menu or action",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The top button (Xbox: Y, PS: triangle, Nintendo: X) now opens the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Quality of life",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cancel the selected action (MOVE, LOOK etc) when pressing escape/right click",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "WASD keys now function the same as the arrow keys",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Open Save menu when pressing \"Q\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Open Load menu when pressing \"Z\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Open the Map when pressing \"M\" or \"F\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"M\" is expected for English-speaking players, but \"F\" can be reached with the left hand",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "History screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "History screen has been reworked to fit more naturally into the game flow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Scrolling up or pressing T now opens the dialogue history screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Scrolling down, pressing escape or B on a controller will close it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "History menu item has been removed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduce line height for the Japanese font to fit 4 lines of dialogue on screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition, we fixed some tiny known bugs and optimized several displays and functions. As always, we actively listen to the voices of our player base and optimize our game accordingly. Please do not hesitate to reach out to us with your comments, suggestions, or concerns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Until Next Time,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Development Team & Astrolabe Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "June 20, 2023",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
