  {
   "id": "the-legend-of-heroes-trails-from-zero-23322@1.4.6",
   "gameId": "the-legend-of-heroes-trails-from-zero-23322",
   "displayName": "Patch 1.4.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-28T20:50:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "in today's update there are a variety of smaller fixes and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where window content could be offset from the actual window position on startup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "No longer confine the cursor while applying changed display settings, preventing a specific issue when reducing the resolution.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed various 3D map geometry issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved the water effect on some maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tweaked the battle UI HP/EP/CP number placement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Back-ported some book text layout improvements from Azure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note that you can always revert to earlier versions of the game by selecting them in the Steam \"Beta\" menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
