  {
   "id": "the-legend-of-heroes-trails-from-zero-23322@1.4.12",
   "gameId": "the-legend-of-heroes-trails-from-zero-23322",
   "displayName": "Patch 1.4.12",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-28T19:29:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "it's been a while! A number of changes have accumulated since the last patch, although most of them are either non-critical or only only apply in very rare circumstances. Here's the full log:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimize text rendering, particularly reducing frametime spikes when rendering new text at high FPS and with the fast text speed option enabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Allow the use of multiple controllers simultaneously",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various Japanese text fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix a legacy issue with a wrongly colored chest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several fixes to map collision geometry, either to make it impossible to get stuck or to prevent leaving bounds at specific FPS/turbo combinations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the handling of input rebinding reset",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix a minor potential memory leak related to the video player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix rare potential soft-locks when closing shops",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix minor text issue in Crossbell Times issue 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improve the description of some game options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note that you can always revert to earlier versions of the game by selecting them in the Steam \"Beta\" menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
