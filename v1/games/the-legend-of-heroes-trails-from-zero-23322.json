  {
   "id": "the-legend-of-heroes-trails-from-zero-23322@1.4.5",
   "gameId": "the-legend-of-heroes-trails-from-zero-23322",
   "displayName": "Patch 1.4.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-16T11:49:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "in today's update there are some further improvements to the auto text advance feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add a visual indicator when auto text advance is enabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add a bindable action to toggle auto text advance.: (Defaults to \"R\" on the keyboard and \"X\" on the controller [Xbox layout])",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "Tweak the minimum wait time for non-voiced text boxes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This brings the feature up to par with the release state of Trails to Azure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note that you can always revert to earlier versions of the game by selecting them in the Steam \"Beta\" menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
