   "id": "the-legend-of-heroes-trails-from-zero-23322@1.4.3",
   "gameId": "the-legend-of-heroes-trails-from-zero-23322",
   "displayName": "Patch 1.4.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-01-05T17:56:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "version 1.4.3 is a minor update which primarily aims to resolve some issues with the recently introduced auto text advance feature.",
       "ps5ProOnly": false,
