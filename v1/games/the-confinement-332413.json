   "id": "the-confinement-332413@major-2026-07-02",
   "gameId": "the-confinement-332413",
   "displayName": "Update Patch: Steam Deck Optimization and Options Menu Fixes! 🛠️",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-02T17:47:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Survivors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just deployed a new update for The Confinement focusing on quality-of-life improvements, menu fixes, and better compatibility for handheld players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here is the complete breakdown of what has been fixed and updated in this patch:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "⚙️ Options & Menu Fixes",
     "items": [
      {
       "text": "Settings Saving Properly: Fixed an issue where customized game options would reset. Your settings will now save and load correctly between sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Anti-Aliasing Working Correctly: The Anti-Aliasing toggle is now fully functional, allowing you to properly adjust the game's visual smoothness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "\"Restore to Defaults\" Fix: The option to reset all configurations back to their original default values is now working as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🎮 Steam Deck & Performance",
     "items": [
      {
       "text": "Steam Deck Resolution Support: We have adjusted and optimized the game's resolution settings specifically for the Steam Deck, ensuring a much cleaner and properly scaled portable experience.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Bug Squashing: Squashed various minor bugs and performance glitches across the game to improve overall stability.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you for your ongoing support and for helping us improve the game by reporting these issues. Keep sharing your feedback in the community hub!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "— QUByte Team",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
