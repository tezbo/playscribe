  {
   "id": "the-caligula-effect-2-143623@1.0.1",
   "gameId": "the-caligula-effect-2-143623",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-07-08T09:07:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released a patch that implements the following fixes and adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We apologize for causing an inconvenience, but we would appreciate it if you could download the patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・\"3840x2160\" has been added to the preset resolution choices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ DualSense Wireless Controller (PS5 Wireless Controller) compatibility has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "・ The default resolution has been changed from 1280x720 to 1920x1080.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ Fixed an issue where the UI during battles would remain hidden",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ Fixed an issue where the game would crash upon start up on full screen mode, under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ Fixed an issue where the game would crash when closing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
