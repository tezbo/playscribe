 "releases": [
  {
   "id": "x-force-genesis-165652@major-2026-10-21",
   "gameId": "x-force-genesis-165652",
   "displayName": "X-Force Genesis returns: a major free update is out now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-21T22:54:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, pilots!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The first step in the new era of X-Force is here! X-Force Genesis has received a major free update, bringing revamped gameplay, additional stages, improvements and fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We revisited the game to align it with the new direction we are building for the franchise. This update incorporates much of the gameplay developed for X-Force Under Attack, with adjustments and additional content that renew the adventure in Genesis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Get ready to return to battle",
     "items": [
      {
       "text": "Choose your ship and take on a 12-stage campaign filled with enemy waves, bullet storms and gigantic bosses. Strengthen your arsenal, make the most of power-ups and find the best strategy to survive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Highlights include",
     "items": [
      {
       "text": "Extensively revamped gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A 12-stage campaign, including additional stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Different ships, permanent upgrades and power-ups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Intense boss battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixes across different parts of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "22 achievements for the new campaign and Steam Cloud support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Already own X-Force Genesis? The update is free: simply update the game through your Steam library.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "About progress and achievements",
     "items": [
      {
       "text": "The revamped version uses a new save file; progress from the old campaign does not transfer to the new one. The old achievements have been archived to preserve those you have already earned. The new campaign has its own set of 22 achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The future of the X-Force franchise",
     "items": [
      {
       "text": "As previously announced, X-Force Under Attack will be removed from the Steam store on October 30, 2026. Existing owners will still be able to download, install and play it normally through their library.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update featured in this announcement is for X-Force Genesis, a separate game from X-Force Under Attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This renewal is part of the franchise's reorganization, with a new official timeline that will continue in X-Force Genesis 2. We will share more news about the next chapter soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ready your ship and return to Genesis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Cube Games Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
