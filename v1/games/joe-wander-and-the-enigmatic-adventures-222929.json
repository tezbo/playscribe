   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are excited to announce the latest patch for Joe Wander, which brings a host of new improvements and bug fixes to enhance your gaming experience. This update is a bit bigger than previous ones, and we're confident you'll love what it has to offer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, if you encounter any issues while playing, please don't hesitate to report them in the discussion section of the community hub. Your feedback is essential to help us make the game even better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Best regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Frozen Pixel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "World 3 Bonus level",
     "items": [
