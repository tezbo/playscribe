  {
   "id": "joe-wander-and-the-enigmatic-adventures-222929@01",
   "gameId": "joe-wander-and-the-enigmatic-adventures-222929",
   "displayName": "Patch 01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-02-05T19:41:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "here is a small patch \"01\" that's bringing some bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "-Portal not opening sometimes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Armadillo stuck in the stunned animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Boss fight 3, \"game breaking\" sequence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Too many logs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Large patch that will resolve certain visual and audio glitches can be expected sometimes this week.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you happen to stumble upon any serious bugs, or any bugs at all, you can report them in the discussion section of the community hub.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
