 "releases": [
  {
   "id": "joe-wander-and-the-enigmatic-adventures-222929@patch-2023-03-22",
   "gameId": "joe-wander-and-the-enigmatic-adventures-222929",
   "displayName": "Big Patch - 02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-22T22:26:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Attention Joe Wander players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're excited to announce the latest patch release. This update includes a new feature that will enhance your gaming experience - allowing you to continue from the last checkpoint even after you exit the game. The next time you enter a portal, you'll be prompted whether you'd like to continue from your last saved progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition to this new feature, we've made numerous improvements to all the levels, including enhancements to the graphics and gameplay. Our aim is to create an even more immersive and enjoyable experience for our players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We always appreciate your feedback and are committed to making Joe Wander the best game it can be.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your continued support, and we hope you enjoy these latest changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of the most important changes",
     "items": [
      {
       "text": "This list does not include most of the changes done to models and textures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Global updates and features",
     "items": [
      {
       "text": "Added an option to continue a level from the last checkpoint",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Graphics settings menu will now select the enabled option, insted of showing the first elemet of the list",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Major fix in audio, were some sounds wouldn't stop playing after exiting the level; And would play forever.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rope rendering bug: There was a bug with rope rendering where rope would be invisible if close to the edge of the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fuse sound effect fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Frame drop when first encountering a body of water (On cirten machines)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Buttons bugfix, where button would behave in a strange way when play is on the edge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixing a bug where closed portals would hide some effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The ice sliding sound makes sound at lower player velocities now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a splash sound to boxes and other stuff that can float in water",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ninja Shurikens now disappear after a certain time, instead of a distance based disappearance. This should fix a sound bug.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Bears will no longer start attacking each other if one of them accidentally damages the other one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Sumo Fighter recieved an animation update and sound update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Mummy will now collider with the Sarcophagus after leaving it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added dust particles when the player moves on Dirt and Sand",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added sound effects to Time Attack (start, time to beat elapsing, elapsed)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed how Time Attack Time To Beat is displayed and now if the player beats the Gold Time the next Time To Beat is the best leaderboard time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Time Attack clock will now hide after a few seconds if not picked up (you can jump to your demise to make it reappear)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "When starting Time Attack the checkpoints are now hidden until the Player dies or completes the level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Disabled IK on the Jaguars legs, was a bit broken",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed the gesture action which was left in unintentionally, the action map should be removed as soon as input configuration is loaded and you should be able to map to the E key on the Keyboard",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added new Idle animations to the Player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Update the Player animation transitions to be a bit smoother from/to certain states",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Update the Player will now instantly die if the Sumo Fighter lands on top of the Player when it jumps back to its starting position",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a visual bug where the root of the whip separated from the whip handle when throwing the whip",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the Ninja smoke bomb sound effect not playing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the Player being stuck in certain animation states or not transitioning into certain animation states",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed whip connect sound effect being played when it shouldn't (eg. hitting NPC's)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a null ref exception that would rarely occur with the Bears",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Ninja throwing a shuriken after he threw a smoke bomb (this was not intended)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an error that would rarelly occur with the Players facial animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed various Player sound effects not playing as intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Player skin breaking after loading into a level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some Player skins rendering incorrectly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Player being able to move in certain states in which he shouldn't have been, and generaly input being active when it shouldn't be",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Player head IK will stop tracking points of interest when entering an Idle animation state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Player will no longer have a higher jump when trying to jump as soon as Joe \"lands\" on the ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Player will now dive into water from great heights correctly and some other dive fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Player will rotate somewhat quicker to the desired movement direction when the direction is in the opposite direction of the current direction the Player is facing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Player will now be impacted slightly more by horizontal wind turbines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
