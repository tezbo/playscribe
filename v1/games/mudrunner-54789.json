  {
   "id": "mudrunner-54789@major-2018-12-27",
   "gameId": "mudrunner-54789",
   "displayName": "American Wilds Update 27/12/2018",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-12-27T13:29:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we’re happy to launch a patch on PC, featuring bug fixes and gameplay improvements. As usual, please don’t hesitate to leave your feedback or ask us any questions you may have with regards to the changes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "You can find the full changelist below",
     "items": [
      {
       "text": "Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Conflict between controller and mouse in fullscreen fixed.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Multiple mesh/texture issues corrected (new trucks, houses, addons)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor fixes to some of the truck attributes (suspension, mass properties)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Behaviour of 4x4 scout vehicles in the mud improved: smaller vehicles are more off-road capable now and more stable in mud",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visual improvements to USA maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor improvements to some of the addons (platform with loader is now longer)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some visual improvements: \"birch\" trees have now brown bark",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Modifications to new USA maps : additional routes added, and only 1 instead of 2 fuel stations are now available per map, making them more challenging and requiring more strategic thinking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The MudRunner Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
