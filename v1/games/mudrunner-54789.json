  {
   "id": "mudrunner-54789@major-2021-04-07",
   "gameId": "mudrunner-54789",
   "displayName": "Update - mod multiplayer improvements",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-04-07T09:26:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello MudRunners!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're excited to bring you an update with a number of fixes and the introduction of mods across both PC platforms!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To play mods across platforms, please check this guide we've prepared: https://bit.ly/3mmgmD0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you run into any issues, don't hesitate to report them to us. Thank you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Multiplayer matches with mods now available for both versions of the game on PC. Cross-platform multiplayer matches with mods are also available now.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed an issue that caused the selected trucks in the lobby to reset to the default ones after opening and closing the friends list",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where accepting invitations didn't open the lobby at once if the player's game wasn't running",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the messages sent in the lobby chat to be received with a significant delay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the client name to be displayed incorrectly after inviting a third player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused players' nicknames to be displayed as 'null' for hosts with different connection methods",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with voice chat unstable behavior in the lobby",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused Steam players to be unable to be invited again in the lobby they once left",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
