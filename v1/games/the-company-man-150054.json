    {
     "title": "IMPORTANT NEWS",
     "items": [
      {
       "text": "Playstation 4 and Xbox 360 controller support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "We heard you and we have updated the game to support these controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The key inputs should reset to our defaults automatically. So if you have already bound the controls to your preferences do rebind them again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
