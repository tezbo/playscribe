  {
   "id": "the-company-man-150054@1.01",
   "gameId": "the-company-man-150054",
   "displayName": "PATCH 1.01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-06-02T11:42:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Our first official patch is here! Update your game this will resolve major game-breaking bugs in our previous build and improve some features based on feedback we have received since launch. We read every comment and work on it with our team-so keep it coming! We love hearing from you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "RESOLVED GAME-BREAKERS",
     "items": [
      {
       "text": "1. Looping Cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "2. Witch Scientist going through floors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "3. Francesca not spawning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "4. Restart level no longer goes to a black screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "5. Barret not respawning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "1. Screen Tearing is resolved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "2. Elevator Menu now receives keyboard input",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "3. Rotating Wheel Platform no longer pushes players off",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "4. Deer Warrior no longer stuck on moving platform corner",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "5. No more double animation on Rotating Door while moving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "6. No more delay in Boba’s Animation when she gets hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "7. Fixed the last health beans not showing invulnerability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "8. Fart Enemy VFX is now looping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "9. UI Scaling and anchoring with resolution",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "10. Thought Bars now show 2nd line of text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "11. Notebook Setting’s menu back button is now working",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "12. Twins mini-boss give Vampire Sword health only after death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "13. VFX of Yoga Shooter improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "14. Added SFX to Final Boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "15. Added SFX to Boss Door",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "16. Visual menu resolution tick button readjusted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "17. Can now unlock the first Notebook page after defeating Craig",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "18. Notebook Menu helper ui no longer overlaps back button",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "19. Player no longer does Dash when pressing O to exit the Coffee Shop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "20. Vampire Sword Upgrade no longer allows you to recover hp when destroying ice blocks and attacking switches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "POLISHED",
     "items": [
      {
       "text": "1. Elevator Mini-Game timing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Elevator Mini-Game lights resetting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Stun Lock William now has a cooldown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Reduced Invulnerability upgrade from 10 seconds to 5 seconds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "COMING UP",
     "items": [
      {
       "text": "PS4 controller support! We noticed our community loves the dual shock controller. We are working on that feature and will release it by the end of next week.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
