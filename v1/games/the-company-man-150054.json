    {
     "title": "LOCALIZATION",
     "items": [
      {
       "text": "The Company Man now supports Japanese, Traditional Chinese, Simplified Chinese, Korean, French, Italian, German, and Spanish languages!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "UPDATES",
     "items": [
      {
       "text": "We noticed some of you have an intense passion for gauntlet rooms and so we added them into the game! Have fun finding them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Coin currency now replaces our old coupon system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can find these coins around the game world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Coffee Shop has been rebalanced to match this new currency.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new Impossible Mode for those of you who like the office grind.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Level 1",
     "items": [
      {
       "text": "Random Up bottom prompt appearing for some users at the twin mini-boss room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Level 2",
     "items": [
      {
       "text": "Jim moved during the cutscene after defeating Evan in Human Resources.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Level 5",
     "items": [
      {
       "text": "Jim is teleported to the top of the tree.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Level 6",
     "items": [
      {
       "text": "Flickering lighting on the Sales and Legal Floor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
