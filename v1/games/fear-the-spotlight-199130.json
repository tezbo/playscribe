  {
   "id": "fear-the-spotlight-199130@post-2024-10-25",
   "gameId": "fear-the-spotlight-199130",
   "displayName": "Quick Fix - Save files in Amy's House",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-25T20:06:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're busy working on a larger patch, but for now here's a quick fix for one major bug.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save files now work in Amy's house when your PC is German, Portuguese, & French (previously loading a save file would spawn you in the black void)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
