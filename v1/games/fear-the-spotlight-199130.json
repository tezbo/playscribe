  {
   "id": "fear-the-spotlight-199130@major-2023-09-18",
   "gameId": "fear-the-spotlight-199130",
   "displayName": "Update Notes - September 18 2023",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-18T20:47:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all! Thank you so much for sharing your love for Fear the Spotlight so far.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All of the video and written feedback has helped us create our first update patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Some of the changes made include",
     "items": [
      {
       "text": "Skip showdown cutscene when you die/retry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added some extra inhalers when the difficulty ramps up near the end",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed file save bug that would sometimes set/reset puzzles incorrectly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed library collision some players got stuck in.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed pool audio ignoring volume settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor enemy AI bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thanks again for the feedback. you are really helping improve the play experience for other players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
