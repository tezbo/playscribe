  {
   "id": "they-came-from-the-sky-2-212917@major-2022-12-23",
   "gameId": "they-came-from-the-sky-2-212917",
   "displayName": "Update Patch Notes - December 23, 2022",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-23T11:42:15.000Z",
   "notes": [
    {
     "title": "The following updates have been implemented",
     "items": [
      {
       "text": "Added: New unlockable area - Fun Park!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: New unlockable area - Chinatown!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: A lot of new buildings like Ferris wheel, carousel, tearoom and much more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: A lot of new destroyable decorations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: New \"enemy\" unit - Clown (Who likes clowns? ...me no)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: New \"enemy\" unit - Man in straw hat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: New deadly \"weapon\" Chinese lantern (Yes, you can use it as a deadly fire trap.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: Some new nice sound FX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed: Falling enemies or birds can now kill pedestrians or infantry down on the street. Hell yes! It's really fun! :D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Enemy projectiles sometimes disappeared and was invisible if enemy was near the end of the left or right side of the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "@FobTi",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
