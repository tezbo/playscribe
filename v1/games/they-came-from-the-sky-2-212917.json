  {
   "id": "they-came-from-the-sky-2-212917@major-2023-01-05",
   "gameId": "they-came-from-the-sky-2-212917",
   "displayName": "Update Patch Notes - January 5, 2023",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-01-05T14:03:13.000Z",
   "notes": [
    {
     "title": "They Came From The Sky 2 is getting Out of Early Access next week!",
     "items": [
      {
       "text": "I feel the game is completed, but I will continue to gather your suggestions to improve the game. If anyone has good ideas about what they'd like to see, I'd love to hear them. :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The following updates have been implemented",
     "items": [
      {
       "text": "Added two NEW unlockable upgrades into the Tech Lab",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Lucky Sticker \"42\" - 10% chance to critical hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Personal Transporter - Teleport yourself to the middle of the city where you started.: (You can't use it during a boss fight)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added some info about controls in the Main menu - Help section",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed and improved crosshair movement on Xbox360 controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some small isues with falling lanterns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed player homing missile. Missiles was destroyed near the end of the left or right side of the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Have fun, folks! Wishing you all the best for 2023!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "@FobTi",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
