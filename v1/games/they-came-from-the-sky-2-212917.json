      {
       "text": "Added: Sound fx for critical hit (you need to have Lucky Sticker on your robot)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: Red flashing effect for crosshair if you make a critical hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: Option to reset your Hi-Score to the Settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed: Player health from 10HP to 25HP (The health bar appears only if your shield is depleted - it's behind the shield)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Police car sirene bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Happy gaming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
