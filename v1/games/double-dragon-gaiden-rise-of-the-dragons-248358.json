  {
   "id": "double-dragon-gaiden-rise-of-the-dragons-248358@major-2026-02-19",
   "gameId": "double-dragon-gaiden-rise-of-the-dragons-248358",
   "displayName": "Bimmy and Friends are Here! Download the Latest Update Now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-19T17:00:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Dragon Warriors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we are releasing our biggest update yet! Four new fighters are joining Double Dragon Gaiden in a free content drop available right now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Each fighter brings a new face, new personality, and new fighting style to the streets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Armored Okada",
     "items": [
      {
       "text": "Despite being the Oyabun of the Okada clan, Lady Okada faces constant discrimination from the elders. When a powerful threat emerged, the elders presented her with the sacred clan armor - a challenge disguised as support. If she triumphs, she earns their respect. If she fails, she proves them right.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Jackson",
     "items": [
      {
       "text": "A heavyweight boxer known for his lightning-fast jabs and devastating uppercuts. Once too strong for the ring, he grew bored of rules and regulations. seeking greater thrills, he turned to the streets, where his power and skill made him a prized asset for every gang.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Jim Mackey",
     "items": [
      {
       "text": "The younger brother of M.G. Willy, Jim respects his brother but refuses to live in his shadow. Determined to become his own man, he dreams of leading his own gang. To set himself apart, he wields a shotgun - the opposite of Willy’s machine gun.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bimmy Lee",
     "items": [
      {
       "text": "Legends speak of a secret within.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Sōsetsuken - a form that can only be mastered by two. The tale has been passed down for so long that few believe it, dismissing it as myth or joke. But could this be the proof…?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
