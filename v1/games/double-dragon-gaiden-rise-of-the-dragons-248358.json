  {
   "id": "double-dragon-gaiden-rise-of-the-dragons-248358@hotfix-2026-04-21",
   "gameId": "double-dragon-gaiden-rise-of-the-dragons-248358",
   "displayName": "A New Hot Fix is Now Available!",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-04-21T16:00:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Dragon Warriors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just pushed a quick hotfix to clear out some of the lingering junk and keep the combat fluid. Here’s the breakdown of what’s hitting the streets in today’s patch:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visual Cleanup: We did some under-the-hood optimization on the level textures. This should kill those annoying glitches where sprites were disappearing or turning weird colors (looking at you, Red/White Okada).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Move List Tuning: We’ve disabled the Running Roll (Run + Action) for Armor Okada and Jackson.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Anti-Gravity Bug: Fixed an issue where Jim and Jackson would get stuck in mid-air if you tried to pull off an Up/Down Special before landing a jump attack. You should now return to Earth as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
