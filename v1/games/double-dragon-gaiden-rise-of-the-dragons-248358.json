   "id": "double-dragon-gaiden-rise-of-the-dragons-248358@hotfix-2026-02-24",
   "gameId": "double-dragon-gaiden-rise-of-the-dragons-248358",
   "displayName": "New Hotfix Available: February 24, 2026",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-02-24T17:20:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Dragon Warriors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have a quick fix update to squash a couple of bugs that last week's update introduced. Here's what we fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where a character would get stuck mid-air when switching characters while jumping near the side walls, while the lift is going down in 'Killer's Fortress'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Jackson would become invisible after picking up a weapon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Characters will no longer clip into the building in Royals Level 2 Sector 2 on jumping and switching characters near the first closed door.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
