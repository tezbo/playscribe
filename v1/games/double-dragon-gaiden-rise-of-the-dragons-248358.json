  {
   "id": "double-dragon-gaiden-rise-of-the-dragons-248358@patch-2023-08-24",
   "gameId": "double-dragon-gaiden-rise-of-the-dragons-248358",
   "displayName": "The First Patch is Now Live!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-24T20:06:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Dragon Warriors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you to everyone who has played Double Dragon Gaiden: Rise of the Dragons! It’s been great watching you all fight against the clans and seeing you enjoy our passion project. Today, we released a patch that allows you to turn on/off Crowd Control notifications and fixes bugs such as leaderboard data errors. You can find the full list of patch notes below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can turn on/off Crowd Control notification in the option menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When you respawn, all enemies on screen will be knocked down to provide you a safe entry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed and reduced softlock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed leaderboard data error",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved achievements detecting and tracking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved controller recognition on supporting two controllers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed lag issue with V-Sync and G-Sync",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you have any feedback or run into any bugs, please reach out on the Discord server or the Steam forums!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Until next time,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your Secret Base and Modus teams",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
