  {
   "id": "double-dragon-gaiden-rise-of-the-dragons-248358@patch-2024-05-08",
   "gameId": "double-dragon-gaiden-rise-of-the-dragons-248358",
   "displayName": "Minor Bug Fixes Patch (5/8/2024)",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-08T19:20:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dragon Warriors,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've got a minor update addressing quality of life changes and a few bug fixes! Check below for the full details. 🐉🐉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Leaderboard has been fixed for Survival Mode users with over 250+ Tokens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Special characters are now displayed properly in Sonny Lee’s character description",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Characters and upgrades chosen for Survival Mode will no longer overwrite characters and upgrades in Story Mode saves",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "‘Double Tap to Run’ setting now retained when loading into new stages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the ability to kick users from multiplayer lobby (behave!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added latency/ping icon to search results UI for online multiplayer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added ability for the user to cash out early in Survival Mode instead of quitting to Main Menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated Sonny Lee’s action display picture",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a phenomenon where enemies get trapped at the top of the screen in Survival Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Exchange rate in Survival Mode has been updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased difficulty of enemies (stats and overall quantity) past Wave 15 in Survival Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Let us know how this patch is in the comments!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fight On,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your Secret Base and Maximum Entertainment Teams",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
