  {
   "id": "double-dragon-gaiden-rise-of-the-dragons-248358@major-2026-03-10",
   "gameId": "double-dragon-gaiden-rise-of-the-dragons-248358",
   "displayName": "Update Now Live: Combat Polishing & Controls Fix",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-10T16:18:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Dragon Fighters!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just pushed a small update to Double Dragon Gaiden: Rise of the Dragons to smooth out some rough edges in combat and get your controls back in fighting shape. This patch focuses on specific character interactions and input issues reported by the community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Highlights",
     "items": [
      {
       "text": "Armor Okada: Fixed an issue where the character would become stuck after chaining a neutral special into an aerial side special mid-air.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Super Anubis: Resolved a bug that caused the character to freeze after canceling an air-to-ground attack into a neutral special.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Online Play: Fixed a bug where WASD movement was forced and overlapped with custom user bindings during online sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Jim Mackey: Corrected a button mapping error where the Homerun swing and Grenade throw were assigned to the wrong special slots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a typo for \"Minions\" in the Token Shop Art.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you for your continued feedback and for helping us keep the streets of New York clean!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
