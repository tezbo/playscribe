  {
   "id": "best-served-cold-318952@post-2025-05-09",
   "gameId": "best-served-cold-318952",
   "displayName": "Patch Notes - May 9 2025",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-05-09T10:08:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Minor language improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the delay when switching between windows.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated mood sound effects to be less cartoony.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where some tutorial prompts weren’t cleared correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several controller-related issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a Steam Cloud sync issue; progress will now carry over to other devices.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug on the pinboard screen when using a controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue preventing achievements from unlocking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in Chapter 1 where two male customers at a table disappeared.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with autoplay not functioning as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
