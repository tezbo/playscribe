  {
   "id": "inscryption-139090@0.32",
   "gameId": "inscryption-139090",
   "displayName": "Update 0.32",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-03-15T02:38:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The official release is close at hand! Let's make sure those achievements are working...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Did you know the crew of The Limoncello was supposed to mutinee as the ship is being attacked? I don't know how you would because it was bugged. But now it works!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for \"Skull Storm\" achievement not unlocking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Check the Challenge Level achievements every time the Kaycee's Mod menu is opened. This should unlock them for those who have passed the required Challenge Level but didn't get the achievement. This also applies to \"Start // Finish\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Another issue with the GetFairHand algorithm. Cards with a cost of 1 bone are not counted as free.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Localization bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For more information on Kaycee's Mod, check out this post!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch's fan art is by @ninten_draw",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
