  {
   "id": "inscryption-139090@0.28",
   "gameId": "inscryption-139090",
   "displayName": "Update 0.28",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-02-03T17:17:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Kaycee's Mod Beta V0.28",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The final Rare card has been added to Kaycee's Mod! It is only available via a unique starter deck unlocked in the late challenge levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Starter deck rejiggering: Bones deck is changed to be more canine-centric, a new (somewhat boring but necessary) bird-themed starter deck is added, and the unlock order is rearranged a bit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remastered 3D model of Leshy's camera with a light-up sigil when you snap a pic of him (thanks @lumoize10!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New sound effects for the Wiseclock and Magickal Bleach items (thanks Jonah!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Extra attacks from Trifurcated / Bifurcated / Double Strike now stack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Long Elk buff: It discards its hideous Vertebrae as it shambles across the board.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kaycee has decided to nerf the Fecundity Sigil, making it so that the copied card does not have the sigil. This only applies to Kaycee's Mod.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Trader has run out of patience for your lousy pelts. She refuses to trade for your pelts if they are infested with Pelt Lice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Bugs related to reviewing deck during a Cave Trial.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "For more information on Kaycee's Mod, check out this post!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch's fan art is by @limited29940408",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
