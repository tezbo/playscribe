  {
   "id": "inscryption-139090@0.27",
   "gameId": "inscryption-139090",
   "displayName": "Update 0.27",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-01-27T19:21:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Kaycee's Mod Beta V0.27",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Trapper was concerned that you didn't always want to buy his pelts with your hard-earned teeth. He is now offering his Skinning Knife for the low, low cost of 7 teeth to passing Challengers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Succeeding at a cave trial now awards more powerful creatures: they have 2 random additional sigils instead of 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Difficulty nerf to the 3 most failed encounters according to analytics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Difficulty nerf: The challenge points requirements for the first 2 Challenge Levels are lowered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Card tweaks: Alpha -1 Bones Cost, Daus joins the Hooved tribe, Pelt Lice has Double Strike.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Multiple copies of some sigils appearing on Mycologist fused cards.",
       "ps5ProOnly": false,
       "pcOnly": false,
