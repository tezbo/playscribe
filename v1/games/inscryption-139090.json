  {
   "id": "inscryption-139090@0.30",
   "gameId": "inscryption-139090",
   "displayName": "Update 0.30",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-03-07T19:17:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This is the last major patch! Thank you so much to everyone who playtested this expansion and offered feedback, bug reports and ideas. The final thing will launch soon but we need to make sure all the bugs and balance issues are sorted out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Heave, ho...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Heave... ho... heave... ho...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localization complete for Kaycee's Mod! All languages supported. Expect a few localization related bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Non-sacrificable cards can be sacrificed if they have the Triple Blood sigil.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Bell Squid also gains power from the Daus Chimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mycologist issue with 3x+ of same card: The pairs are selected to result in a card with the most sigils when combined.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pelt Lice can gain a totem ability when leaping out from your deck or hand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Kraken's tentacles gain sigils that were placed on the Kraken.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cards with the Bees Within and Rabbit Hole sigils now transfer their additional sigils to the Bees and Rabbits they create.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For more information on Kaycee's Mod, check out this post!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch's fan art is by @Crispy_Parsnips",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
