      {
       "text": "Just fixin' those achievements...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The achievements for clearing Challenge Level 8 and 12 should work now. Also fixed the Challenge Level achievements unlocking 1 level too soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For more information on Kaycee's Mod, check out this post!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
