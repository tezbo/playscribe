   "id": "inscryption-139090@0.33",
   "gameId": "inscryption-139090",
   "displayName": "Update 0.33",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-03-16T05:03:28.000Z",
   "notes": [
    {
