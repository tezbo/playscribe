  {
   "id": "inscryption-139090@0.31",
   "gameId": "inscryption-139090",
   "displayName": "Update 0.31",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-03-10T18:24:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Yar! Another patch so soon?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Narrowing in on that release build...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Achievements (should be) live! They are hard to test so we're about to find out if they work.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Slight nerfs for Ants and Birds encounters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Allow skipping Kaycee's Mod credits with Esc key.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localization edits / fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: The infamous \"GetFairHand\" bug. It is a bit surreal to have players point out the exact line of code that is causing a bug that has been in the game for years...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Blank stats page after returning from Kaycee's Mod credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Annoying sigil not working on giant cards (The Limoncello, The Moon)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "For more information on Kaycee's Mod, check out this post!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch's fan art is by @Yazawa_Akio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
