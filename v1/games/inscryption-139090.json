  {
   "id": "inscryption-139090@0.26",
   "gameId": "inscryption-139090",
   "displayName": "Update 0.26",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-01-19T18:56:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Kaycee's Mod Beta V0.26",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch is more focused on player feedback (submitted on Discord) than the prior ones. There are too many good suggestions to feasibly act on, but I tried to pick some of my favorites.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Rare card (a late unlock) based on a player suggestion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "3rd and final new item (unlocked via oil painting) based on a player suggestion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed the Weak Starters challenge - it had no effect when picked alongside certain starter decks (Mantis God, etc.) It has been replaced with a player suggestion: Annoying Starters. Your starter deck cards come with the Annoying sigil!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an Aquasquirrel figurine to sit beside the Squirrel pile when the Squirrel Fish challenge is active. Thanks Cody!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "BEAVER BUFF. +1 health and Dams now inherit the extra sigils on the Beaver.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed Raccoon cost from 3 Bones to 1 Blood.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Amorphous sigil sometimes not working due to randomly picking a sigil that was already on the card.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Several rare soft-lock bugs, some of which were caused by the Scavenger sigil.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Being able to sometimes play cards during the combat phase or during Leshy's turn in rare cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "For more information on Kaycee's Mod, check out this post!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch's fan art is by @hanghul",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
