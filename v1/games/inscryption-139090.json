   "id": "inscryption-139090@0.34",
   "gameId": "inscryption-139090",
   "displayName": "Update 0.34",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-03-17T01:49:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It's close!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Daus' Chimes also inherit sigils from The Daus, just like the Beaver.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Multiple of certain sigils appearing on cards (Bonedigger, Fecundity).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Royal victory not counting towards Bosses Defeated stat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Totems with the Fledgling sigil re-triggering when cards are moved by certain sigils.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "For more information on Kaycee's Mod, check out this post!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch's fan art is by @GladSeal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
