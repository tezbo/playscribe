  {
   "id": "inscryption-139090@0.29",
   "gameId": "inscryption-139090",
   "displayName": "Update 0.29",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-02-16T19:05:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're getting close to the end! There's still one last fun surprise to be added before Kaycee's Mod is complete, but this patch ain't it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Replaced the Otter in the Waterborne starter deck with a Kraken.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Random Starter option in the starter deck selection screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Card modifications to the Curious Egg will apply to the Hydra.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Amalgam counts as an Ant.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Long Elk's Vertebrae can be sacrificed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More encounter difficulty nerfs. Yes, Ants was still one of the most failed encounters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: The Annoying sigil is now applied to starter deck cards with more than 1 sigil (Kingfisher, Tadpole) for the Annoying Starters challenge. How annoying! But for all you modders out there: you can now show 3 default sigils on a Part 1 card.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Curious Egg portrait not changing after hatching.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Fecundity nerf not working when the sigil is given via totem.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "For more information on Kaycee's Mod, check out this post!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch's fan art is by @Noho_Thum",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
