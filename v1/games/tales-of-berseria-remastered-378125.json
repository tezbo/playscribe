  {
   "id": "tales-of-berseria-remastered-378125@major-2026-05-29",
   "gameId": "tales-of-berseria-remastered-378125",
   "displayName": "Notice of Update Distibution",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-29T08:02:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "On Wednesday, May 20, we released an update to address the following issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where blurring occurred during event scenes when set to 120fps and “Vertical Sync: ON”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a graphical issue with certain elements when set to 120fps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with certain sound effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed other issues that hindered gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We appreciate your continued support of Tales of Berseria Remastered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
