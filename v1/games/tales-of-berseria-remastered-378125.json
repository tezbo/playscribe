   "id": "tales-of-berseria-remastered-378125@patch-2026-06-10",
   "gameId": "tales-of-berseria-remastered-378125",
   "displayName": "Patch Distribution Announcement",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-10T00:03:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch Distribution Announcement: German Language Bug Fixes Complete for “Tales of Berseria Remastered”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◆ Regarding the Release of Update Data",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you very much for playing “Tales of Berseria Remastered.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To address the issue announced on Friday, May 29, we have released an update for the STEAM® version today.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◆ Update Details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the game would not launch properly when version 1.0.5 was installed and the in-game language was set to “German.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "◆ Version Information",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v.1.0.5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◆ Build ID",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Before update: 22938863",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After update: 23466023",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*There are no changes to the version number since the previous update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*You can confirm the update status by going to the game’s Properties > Updates > Build ID.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*An internet connection is required to apply the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your continued support of “Tales of Berseria Remastered.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
