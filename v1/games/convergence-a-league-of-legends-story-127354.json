 "releases": [
  {
   "id": "convergence-a-league-of-legends-story-127354@post-2023-07-12",
   "gameId": "convergence-a-league-of-legends-story-127354",
   "displayName": "Patch Notes - 07/12/2023",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-07-12T19:16:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, Zaunites!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It’s been a little while since we released Convergence: A League of Legends Story to the world, and we’ve been super thankful for the fantastic PC-related feedback that has come out of the community since then!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our main takeaway from your sentiments has been that while PC users have been happy with the game itself, there were a few places where the PC experience could be improved, specifically with regards to keyboard and mouse controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "In response to this feedback, we’re happy to share an update that should make playing the game with a keyboard and mouse a much more enjoyable experience. Take a look at the changes below, and let us know what you think in the comments!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Gameplay Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added mouse aiming for all ranged abilities: Timewinder, Parallel Convergence, and Phase Dive can now all be freely aimed and activated via mouse aiming on PC",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed keyboard inputs sometimes being dropped when switching between zip-lining and grinding on rails",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some level checkpoints being invalid and preventing reloads. This also retroactively fixes existing save files that were previously stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Menu Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added full mouse navigation for all menus: All menu footer buttons are now clickable so you can complete the entire game without ever taking your hand off the mouse",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed inconsistent and/or slow mouse scrolling in the Codex menus",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed many keyboard/mouse-specific issues in the control remapper:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed inputs sometimes being double-assigned",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed being unable to enter control remapping with the mouse",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some keyboard keys not registering for assignment",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed being sometimes unable to reset remapped controls to default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed being sometimes unable to exit the control remapper with the mouse",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed multiple gadgets sometimes being selected simultaneously when changing menu tabs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
