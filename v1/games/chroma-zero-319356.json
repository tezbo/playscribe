  {
   "id": "chroma-zero-319356@post-2025-11-16",
   "gameId": "chroma-zero-319356",
   "displayName": "20251116 Patch Notes",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-16T18:13:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update required some medium-sized work to the Reminder Wall, so please report anything if you have trouble with it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fine-tuned some translation spacing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated the Reminder Wall with flashing alerts for #3 and #6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Flashing alerts become strike-throughs afterwards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A few geometry updates to prevent z-fighting, in places",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
