  {
   "id": "chroma-zero-319356@post-2025-09-10",
   "gameId": "chroma-zero-319356",
   "displayName": "Russian + Italian",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-10T01:40:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Chroma Zero is now playable in Russian and Italian!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's probably the last localization coming online for a while, though if anyone is interested in helping with a LATAM Spanish version I think that would still be great to include. Otherwise that makes 13 total languages available! Thank you so much to everyone involved in the localizations. :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other fixes are also in this build",
     "items": [
      {
       "text": "FOV change adjusts on-screen even when you're paused",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "One particular Zero is available post-credits if you hadn't found it before then",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
