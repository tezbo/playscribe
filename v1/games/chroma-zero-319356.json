  {
   "id": "chroma-zero-319356@post-2025-08-12",
   "gameId": "chroma-zero-319356",
   "displayName": "20250804 Patch Notes - small geometry & lighting updates",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-08-12T21:07:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Nothing crazy, it's just tiny stuff that makes me like the game that much more :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Zero fades out a little more cleanly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Zero's sfx fade out a little bit more",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Temple geometry overlaps less in places",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another object got the same treatment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(those things make a certain effect look more clean)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lighting/shadows for some objects was popping in/out at some angles & distances, I think that's all better now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
