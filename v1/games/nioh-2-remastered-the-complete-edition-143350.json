   "id": "nioh-2-remastered-the-complete-edition-143350@1.27.1",
   "gameId": "nioh-2-remastered-the-complete-edition-143350",
   "displayName": "Patch 1.27.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-03-29T08:15:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The game was updated to the 1.27.1 version, you can find the changes of this version below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that caused the game to crash when opening the Character Directory with DLSS enabled.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue that could cause a crash when raising to level 750 when using a mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue that caused the game to crash in certain environments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could stop text from appearing on the screen in certain environments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the game to crash when using a Gaki Soul Core Yokai Ability in “The Alluring Ancient” sub-mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue when playing in 120fps where Burst Counters did not work correctly against certain enemies' Burst Attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue when playing in 120fps Game Mode where certain enemies would behave differently than expected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
