  {
   "id": "nioh-2-remastered-the-complete-edition-143350@1.27",
   "gameId": "nioh-2-remastered-the-complete-edition-143350",
   "displayName": "Patch 1.27",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-03-02T07:57:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "■Additional Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added support for keyboard & mouse input icons",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "This setting can be switched via “System” ⇒ “Keyboard & Mouse Settings” ⇒ “Control Icons”",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "■Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue which prevented Burst Counters from being used against certain enemies’ Burst Attacks when “Frame Rate Cap” was set to 120",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Further improvements have been made to address the issue of frame rate degradation when “Effect Quality” is set to “High” in “Graphics Settings”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Shadows are now enabled in cutscenes even when the \"Shadows\" setting in \"Graphics Settings\" is set to \"OFF\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue that sometimes caused the fog in stages to appear brighter than expected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The screen resolution of 1366x768 can now be selected when the desktop resolution is 1360x768",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Changed the settings in “Keyboard & Mouse Settings” ⇒ “Key Configuration” for camera operation via mouse in “Photo mode”",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Fixed an issue where some effects would not display in the cutscene, “A Summons to War”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue that occurred with facial expressions while using the “Dragon Ninja” Transformation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The window menu is no longer included in the image data copied to the clipboard when posting character creation settings on Twitter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Other minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
