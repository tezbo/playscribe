  {
   "id": "nioh-2-remastered-the-complete-edition-143350@1.28",
   "gameId": "nioh-2-remastered-the-complete-edition-143350",
   "displayName": "Patch 1.28",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-09-09T15:31:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The game was updated to the 1.28 version, you can find the changes of this version below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Added features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Implemented cross-play with the Epic Games Store version",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Crossplay settings can be changed from System Menu - Online Settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: To enable Crossplay, an Epic Games account is required.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Note: If you enable Crossplay with the Epic Games Store version, you will no longer be able to be matched with users for which Crossplay is not enabled.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Note: If you enable Crossplay, when attempting to match with a friend, your Epic Games account will be referenced.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・You can issue Character Creation codes for use with the Epic Games Store version.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "■Corrected issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected an issue in which the batch check filter for a Soul Core at a Storehouse at a Starting Point would not behave correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected an issue in which, if an item set as a Favorite Item from a Storehouse at a Starting Point was moved to an item box, the item would no longer be a Favorite Item.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected an issued in which, when controlling the game using a keyboard and mouse, if a specific button was held down while attempting a Yokai Shift, it could not be performed.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Corrected an issue in which, when playing movies from, for example, the Skill Customization menu, shadows in stages would display incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected an issue in which some of the Amrita Crystals placed in stages were not displayed correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected an issue in which, for the character Minamoto no Yoshitsune, the effects of a specific attack would not be displayed correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected an issue in which, after joining the Underworld as a visitor, the game could sometimes no longer be advanced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected an issue in which, even if Kashin Koji, a boss that appears in a Picture Scroll Mission, was defeated, the defeat would not be counted for \"Bosses defeated\" in the player's gameplay record.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Other minor issues were corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
