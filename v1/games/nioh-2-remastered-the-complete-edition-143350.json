   "id": "nioh-2-remastered-the-complete-edition-143350@1.28.7",
   "gameId": "nioh-2-remastered-the-complete-edition-143350",
   "displayName": "Patch 1.28.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-09-01T05:24:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "■ Function addition",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added support for Epic Online Services (EOS).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue with keyboard/mouse operation where an attack would be launched if the Ki Pulse button was pressed and released while the attack button was held down.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Adjusted the “Hideyoshi” achievement that can now be earned when the Tale of Nioh is opened if the conditions are met, if it was not earned offline.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed other minor issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
