      },
      {
       "text": "Added the option to reset individual key settings for items blank by default in “Keyboard and Mouse Settings”.: ■ Adjustments",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Adjusted the size and position of some key icons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed some icons displayed when changing multiple button assignments in the \"Keyboard and Mouse Settings\". Only \"Shift\", \"Ctrl\", \"Alt\", and \"Space\" will now have unique icons.: ■ Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue in which the position of the light in Photo Mode could not be controlled with the keyboard or mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue that caused unintended actions after certain key assignments were made in “Keyboard and Mouse Settings”.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where some actions could not be performed after certain key assignments were made in “Keyboard and Mouse Settings”.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where the wrong key guides were displayed on some screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused errors when displaying user names on Benevolent and Bloody Graves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused a crash when selecting “Random Settings” under “Appearance Settings” while “DLSS” was enabled.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue that prevented some graphics settings from being reflected at launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where audio volume settings were not reflected in movies immediately after launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed other minor bugs and issues.: Thank you for your continuous support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
