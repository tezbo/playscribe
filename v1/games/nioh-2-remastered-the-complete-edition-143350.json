  {
   "id": "nioh-2-remastered-the-complete-edition-143350@1.28.6",
   "gameId": "nioh-2-remastered-the-complete-edition-143350",
   "displayName": "Patch 1.28.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-12-15T02:15:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The game was updated to the 1.28.6 version, you can find the changes of this version below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Corrected issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected an issue in which lock-on targets would be inadvertently switched when using the keys assigned to \"Move Camera Up\" and \"Move Camera Down\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected an issue in which, when using keyboard and mouse controls, if specific keys were pressed simultaneously, the game would crash.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Corrected an issue in which, when the Frame Rate Cap was set to 120, the Auto-adjust Camera would sometimes behave incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
