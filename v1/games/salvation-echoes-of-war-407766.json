  {
   "id": "salvation-echoes-of-war-407766@1",
   "gameId": "salvation-echoes-of-war-407766",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-03T13:41:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have fixed few minor issues that people experienced in their playthrough:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue that after solving the head puzzle, if player falls and dies, after spawning from checkpoint if he goes back towards the first gate rather than going to the head, it could trigger the starting cutscene and with heads turning, it may end up in a bad state and have to solve the puzzle again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in the sewer section that allowed players to drop soil bags away from where they were supposed to be placed. While it would let the player progress, it looked visually wrong.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in the final gates that allowed players to fly above the gates without going through them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
