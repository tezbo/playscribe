  {
   "id": "salvation-echoes-of-war-407766@2",
   "gameId": "salvation-echoes-of-war-407766",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-23T13:55:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have fixed few minor issues that people experienced in their playthrough:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue in Paris Church that on some machines the dead body wasn’t showing up on the top floor, unless the player triggered the breaking of the floor sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a tutorial hint to the final plane level to remind players that they can still fire souls in that level to break the obstacles, since some players seem to forget the capability from the first plane level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug with triggering in-game menu during opening cutscene that would cause audio to stop playing on resume for the rest of opening cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several minor collision issues in different levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
