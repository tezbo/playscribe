  {
   "id": "flightpath-adventures-in-venaris-294233@1.16",
   "gameId": "flightpath-adventures-in-venaris-294233",
   "displayName": "Patch 1.16",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-02T08:22:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "After going to a few expos and conventions, we got some nice feedback we used to do some minor fixes and improvements. Here's the bulletpoints",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted some UI text for clarity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted Health / Shields UI for better readability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Generator load text in shop adjusted for readability on small screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Defend VIP missions now come with a distance counter to know how long there is left on the mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changes to the tutorial to explain shields and generators.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved gamepad-based control of UI menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug that would lock weapons to be constantly shooting in Endless mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug on the control remapping UI that would show the wrong buttons if the gamepad was disconnected after remapping.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
