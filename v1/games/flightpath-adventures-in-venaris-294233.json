  {
   "id": "flightpath-adventures-in-venaris-294233@major-2023-03-24",
   "gameId": "flightpath-adventures-in-venaris-294233",
   "displayName": "Endless Mode Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-24T02:27:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're thrilled to announce a major update to our game, featuring the all-new Endless Mode! Thanks to Flightpath's procedural stage creation, this mode offers a unique experience every time you play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In Endless Mode, your skills will be put to the test as you attempt to stay afloat for as long as possible. Be prepared for tougher enemies as you progress further. Luckily, we've added a host of new booster items to help extend your basic upgrades.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Making choices is crucial to your success in Endless Mode. At the start of each new stage, you'll be presented with a choice of boosts or debuffs. Choose wisely, as taking too many boosts early on may leave you vulnerable to debuffs when the game gets harder!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To make this mode even more exciting, we've also included a range of achievements for you to unlock. Brag to your friends by flying the furthest, destroying the most buildings, or rescuing the most VIP ships.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We can't wait for you to try out the new Endless Mode and see how far you can fly!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "v 1.10b",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Endless mode added!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated to Unity 2021.3.21f1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New player gauges UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new stage opening for bonus stages, so you know you're free to destroy everything!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Various weapon / enemy damage balances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved UI navigation to better support keyboard only (non-mouse) configurations.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved control remapping to avoid double-selecting the same button for two actions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug that made it that primary weapons wouldn't preview on Micah's workshop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a display bug on the Pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Worked around a Unity bug that failed to load the previous control mapping config properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a control remapping configuration problem for cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
