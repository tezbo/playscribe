   "announcedAt": "2024-02-23T05:17:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In preparation for the upcoming console ports, we've introduced a few optimizations. Primarily",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed an issue that would cause frame rate drops on older hardware",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Automatic system language detection and switch (if supported)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Better stage loading. Should hiccup less in older hardware",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimizations to Sky Fire",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor fixes and improvements (mostly for consoles)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
