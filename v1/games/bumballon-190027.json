  {
   "id": "bumballon-190027@post-2022-02-04",
   "gameId": "bumballon-190027",
   "displayName": "Bug fixes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-02-04T15:01:57.000Z",
   "notes": [
    {
     "title": "In this update, minor fixes were made such as",
     "items": [
      {
       "text": "The language of the Portuguese - Brazil has been inserted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Correction in the zoom system of the opening cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix on unlocking the \"Brave explorer\" achievement. Now you can unlock without having to collect all 5 secret gems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Automatic save game now takes place at two points in the game.: When leveling up the game is automatically saved to the level selection map. And when returning also to the world map the game is saved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The save game icon has been changed. Every time you view a floppy will mean that the game has been saved.: I will always seek to do my best to bring you a better experience. Have fun!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
