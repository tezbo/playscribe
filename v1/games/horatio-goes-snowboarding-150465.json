  {
   "id": "horatio-goes-snowboarding-150465@major-2021-04-19",
   "gameId": "horatio-goes-snowboarding-150465",
   "displayName": "Big ol' update to the scoring system now live!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-04-19T11:24:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've made some changes to the way the scoring system works in Horatio!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to all the amazing feedback we've had over in our Discord, we realised the way the multiplier worked was causing some RAGE QUIT issues. We listened, we acted. Here's what's new.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now, your multiplier is set per day. Plus you get a perfect bonus for a no miss boarding run. And we've also removed the pressure from the crossing the road sequence. We're having to wipe the leaderboards too, but it's Early Access so get used to that :D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Oh! And now lovely score numbers fly off all over the shop. An ISG staple!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let us know what you think!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Love Team ISG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "x",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
