  {
   "id": "horatio-goes-snowboarding-150465@major-2021-09-05",
   "gameId": "horatio-goes-snowboarding-150465",
   "displayName": "The Disco Biscuit Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-05T16:26:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "So we never really banged on that much about it when we first dropped it, but Endless mode has some reactive music that builds as you play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update to the game gives that music some extra visual accompaniment in the form of beat synced and choreographed disco lights that slowly appear, then kick right off when the beat drops.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Its not something you can describe easily, so go play it and let us know what you think!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Love Team ISG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
