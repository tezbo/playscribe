  {
   "id": "horatio-goes-snowboarding-150465@0.92",
   "gameId": "horatio-goes-snowboarding-150465",
   "displayName": "Update 0.92",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-07-24T20:41:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Big shout out to everyone who noticed the cheevo stat tracking was bust!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Where we'd deleted some, the stat/cheevo tables got out of sync. The affected achievements were",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Wrecked - get run over by 10 cars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Sorry, Officer - hit by 5 police cars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Chairman of the Board - go snowboarding 100 times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Whoopsie - collide with 10 snowmen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This version 0.92 fixes the tracking and you can now get these achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Team ISG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
