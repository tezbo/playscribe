  {
   "id": "horatio-goes-snowboarding-150465@0.7",
   "gameId": "horatio-goes-snowboarding-150465",
   "displayName": "Update 0.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-06-14T15:47:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We just pushed live a big update to Horatio Goes Snowboarding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bunch of new stuff, here's the highlights...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many more tunes. There's now 10 boarding and 10 city tunes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New powder snow kicking up for satisfying carving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Grandstanding bonuses for grazing lethal objects. Get close enough to something to shower out stars for extra points.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Better menus, leaderboards and UI tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Credits sequence: Have fun, let us know what you think, and see you on the leaderboards!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
