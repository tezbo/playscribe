  {
   "id": "horatio-goes-snowboarding-150465@post-2021-07-22",
   "gameId": "horatio-goes-snowboarding-150465",
   "displayName": "WE MADE THE YETI WAY BETTER",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-07-22T13:42:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "That's right folks! We always wanted to make the yeti strike fear into the hearts of players... BUT NOT THIS MUCH!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So yeah, turns out we made a waaaaaaay to brutal Yeti.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What we've done to fix this is ... well why don't you find out for yourself! But there's a lot more opportunity to avoid the beast now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
