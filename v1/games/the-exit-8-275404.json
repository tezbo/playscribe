  {
   "id": "the-exit-8-275404@1.0.5",
   "gameId": "the-exit-8-275404",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-04-09T00:58:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "▪ Changed the specification where the exit count does not advance in the first week passage, such as when starting the game or after Game Over.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The bug where an uncle would walk through the passage even if you didn't go through it after clearing the game has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The state in which the anomaly does not occur at the first startup (no guide) was not saved before the game was cleared, so this has been corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
