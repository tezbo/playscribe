  {
   "id": "machine-gun-fury-211331@major-2022-11-29",
   "gameId": "machine-gun-fury-211331",
   "displayName": "Update Notes for Nov 29",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-29T15:24:32.000Z",
   "notes": [
    {
     "title": "Christmas 2022 Update",
     "items": [
      {
       "text": "Let’s get into the festive zone and shoot lots of stuff to the soothing sounds of Christmas!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This free update transforms MGF into a winter wonderland. Just update the game and select ‘Christmas Mode’ to get into the festive spirit:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New wintery Christmas-themed visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated ice-encrusted level tilesets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New music soundtrack, with ten different SID festive music tracks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New destructible scenery, including Christmas trees, snowmen & presents",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We hope you enjoy the update, and from all of us at Reset Games, have a wonderful Christmas!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
