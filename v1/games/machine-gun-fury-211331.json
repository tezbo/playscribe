  {
   "id": "machine-gun-fury-211331@major-2026-02-27",
   "gameId": "machine-gun-fury-211331",
   "displayName": "Machine Gun Fury | New Update is Live!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-27T13:42:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, soldiers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just rolled out another patch! This update focuses on improving controls, adding quality-of-life features, and fixing various issues to make your experience smoother and more comfortable. Thanks for your continued feedback — it helps us keep refining the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay & Controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved controls: adjusted shooting and jump button placement for better comfort and responsiveness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Quality of Life",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Settings menu is now accessible directly during gameplay — no need to return to the main menu, you can now change any time game settings during your walkthrough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Ultra Widescreen toggle in Options — can be enabled or disabled at any time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Content",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restored the intro cinematic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed various minor bugs and stability issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for all your feedback and support — it truly helps us keep improving the game. And a special thanks to everyone who has purchased and continues to play Machine Gun Fury. We appreciate every one of you! Let us know what you think about the game by writing a review here on Steam, posting it in the Discussions, or chat with us on the official ESDigital social media accounts. We'll keep working to improve this game and provide you with a better game experience in near future! And happy holidays! Thank you for your support, and enjoy the game!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
