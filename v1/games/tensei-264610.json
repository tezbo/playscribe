  {
   "id": "tensei-264610@major-2024-05-24",
   "gameId": "tensei-264610",
   "displayName": "Update is now available.",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-24T08:09:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released an update today.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "- Additional Achievements",
     "items": [
      {
       "text": "New achievements, including hidden achievements, have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "- Improved environmental visuals and added direction",
     "items": [
      {
       "text": "Various placements were added in the field and reactions were implemented when interacted with.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In addition, minor improvements have been made to the existing placement and presentation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Visitors can enjoy an even more immersive experience while leisurely flying around in the tranquil space.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "- Adjusted stage configuration from certain heights and above.",
     "items": [
      {
       "text": "Modifications were made to landscape changes after 30,000 m altitude.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "- Defects addressed",
     "items": [
      {
       "text": "Several display and behavior issues were fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We look forward to your continued support of TENSEI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Project Pegasus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
