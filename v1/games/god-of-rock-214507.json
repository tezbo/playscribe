 "releases": [
  {
   "id": "god-of-rock-214507@patch-2023-05-08",
   "gameId": "god-of-rock-214507",
   "displayName": "God of Rock Champion Edition Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-05-08T11:00:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The first content update for God of Rock is here! We've been gathering all your feedback to shape our efforts in this first patch. Check out all of the updates below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Content",
     "items": [
      {
       "text": "11 new songs have been added!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Quality of Life",
     "items": [
      {
       "text": "Added key mapping options (console only, this already existed on PC)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added 'arrows' as a button prompt option (console only, this already existed on PC)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Additional notification in the level editor to remind people that both the \"Simple\" and the \"Default\" beatmaps must be filled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a photosensitivity message at the start of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Blocking the God of Rock's special move now prevents the inversion effect from occurring.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Damage from the God of Rock's ultra move has been reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lyn's AI in arcade mode has been adjusted to reduce the difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balance Changes",
     "items": [
      {
       "text": "Blocking Edith's ultra now prevents the inversion effect from occurring.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The duration of the buff from Lyn's level 3 special move has been reduced to 2.5s.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The duration of Lyn's ultra effect has been reduced to 2.5s.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Rosetta's meter gain rate has been increased - however, using a special move now reduces meter gain for a time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Ziggy's base stun duration has been increased - however, each successive hit now stuns the opponent for less time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Miscellaneous",
     "items": [
      {
       "text": "When a difficulty downgrade occurs, the penalty for the player who caused the downgrade has been increased. This is to discourage players from deliberately playing poorly in early parts of the song.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
