   "id": "chronicles-of-the-wolf-258184@major-2026-03-17",
   "gameId": "chronicles-of-the-wolf-258184",
   "displayName": "New PC Update Now Live for Chronicles of the Wolf - March 2026",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-17T10:23:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The latest Chronicles of the Wolf PC update is now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update focuses on improving the overall gameplay experience with new audio controls, expanded display settings, controller support improvements and Steam Cloud save support. We’ve also refined several gameplay systems and fixed a number of issues to make exploring the world smoother than ever.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Take a look at what’s included below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44359263/0d083832896a4355116f078defc2937bd904d501.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy hunting and let us know how your adventure unfolds!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PQube and Migami",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
