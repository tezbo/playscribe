  {
   "id": "garden-simulator-215944@1.0.6.1",
   "gameId": "garden-simulator-215944",
   "displayName": "Update 1.0.6.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-04T13:00:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello gardening friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A bunch of additions were added to game! See the additions below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy your garden!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Added",
     "items": [
      {
       "text": "Added a gameplay hint when a composter is filled. It explains that fertilizer will be ready the next day.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a gameplay hint when players find a gold nugget. It explains that they can be disposed in the garbage container for in-game currency.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "It is now possible to fixate objects when hovering them. Fixated objects cannot be picked up by accident, the fixation has to be undone first. Also fixated objects that are locked into position and will not be affected by collisions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The garbage container can now be painted in different colors with the paint brush.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Weed outlines are now visible for several seconds when the player selects the hand tool or is picking up weeds. This will make finding weeds easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Updated",
     "items": [
      {
       "text": "All localizations are updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
