  {
   "id": "garden-simulator-215944@1.0.3.0",
   "gameId": "garden-simulator-215944",
   "displayName": "Update 1.0.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-09T18:01:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A small update for the Garden Simulator!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "ADDED",
     "items": [
      {
       "text": "Added a setting in 'Controls' tab to invert input from Y-Axis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted all UI elements to add support for ultrawide displays.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Add outlines to tool storage slots, to highlight the slot, where it can be stored.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "FIXED",
     "items": [
      {
       "text": "Corrected typos in quest description: replaced 'chilies' with 'eggplants' and removed mention of 'artemisia'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Objects that glitched through floor will be thrown back into the garden.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The button to pin an unlock condition in the shop UI would overflow in Japanese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Plants could not be planted close to the walls of the house.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Unlock condition for lawn mowing robot would incorrectly require owning 'paths' instead of 'stones'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UPDATED",
     "items": [
      {
       "text": "Increase cost of lawn mowing robot from 100 to 1000 garden coins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
