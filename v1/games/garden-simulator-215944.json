  {
   "id": "garden-simulator-215944@1.0.5.1",
   "gameId": "garden-simulator-215944",
   "displayName": "Update 1.0.5.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-20T13:00:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello gardening friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have another small update adding a few items to the game as well fixing and updating some things.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy your garden!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Added",
     "items": [
      {
       "text": "Add an option to the pause menu to end the day. This can be used by the player to unstick their character (for instance from the garden shed if the door is blocked by an object).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Show pointer in world space after 3 seconds for tool-types that have never been used to clarify how they can be stored for new players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Game can now be played in Italian language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added localized versions of recently updated texts for all languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a second water-tap on the other side of the house.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixed",
     "items": [
      {
       "text": "It is no longer possible to have multiple magnifying glasses in the hotbar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Text of the skill book sign was overflowing in Dutch language version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Weed no longer spawns on the ground, when the ground is covered by a wooden floor or any building object.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Controls UI was not showing, when switching between two watering cans or shovels in hotbar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Weeds could not be sold in additionally purchased garbage containers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lawn mowing robot will no longer spawn grass sacks when coming close to plants without mowing them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Prevent weed from spawning inside the house.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "It was possible to display a decoration in an invalid state when switching between active hotbar slots very fast.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the credit screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Steam statistics would not work in rare cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Opening the steam overlay while any dialog was open would freeze the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added a missing translation in quest from mayor: 'Harvest leek (good quality).'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fences no longer overlap when trying to place them with grid enabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Achievements for unlocking garden extensions will now also be granted when loading a save game that fulfils the conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the unlock condition of 'plants in beds' to accumulate all ever-grown plants in pots, instead of checking the current number of grown plants.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Placed decorations will no longer be slightly displaced when switching to the next day.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Updated",
     "items": [
      {
       "text": "Disabled grid placement when placing plants in plant pots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The number of butterflies in the garden now scales with the amount of unlocked garden extensions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Activating the grid while holding a plant has been significantly optimized and should no longer cause frame drops.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Using multi-threading to update steam stats when starting a new day, this significantly improves the performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved performance of sprinklers, plants, world-space UI elements, butterflies, and planter sticks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
   "digest": {
    "new": 6,
    "fixed": 15,
    "balance": 0,
    "other": 8,
    "ps5": 0
   },
