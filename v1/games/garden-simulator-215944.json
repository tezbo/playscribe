  {
   "id": "garden-simulator-215944@1.0.4.0",
   "gameId": "garden-simulator-215944",
   "displayName": "Update 1.0.4.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-11T10:48:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here we go with another small update for the Garden Simulator!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "ADDED",
     "items": [
      {
       "text": "Add setting to change the field of view of the camera (can be found in \"General\" tab: \"FOV\").",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Add setting to disable the control hints (can be found in \"Controls\" tab).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Add support for displays that use resolutions with an aspect ratio of 42:9.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "FIXED",
     "items": [
      {
       "text": "Achievements \"Expand\" and \"Go big\" were not unlockable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The game is now saved automatically when the player switches to a new day.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UPDATED",
     "items": [
      {
       "text": "Settings menu now adjusts scrollbar position when using a controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Set initial money to 40 instead of 30.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
