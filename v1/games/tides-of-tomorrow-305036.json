  {
   "id": "tides-of-tomorrow-305036@post-2025-10-03",
   "gameId": "tides-of-tomorrow-305036",
   "displayName": "Patch Note 1 - Tides of Tomorrow Demo",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-03T14:17:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you so much for playing the Tides of Tomorrow demo and for all your feedback, bug reports, and kind messages!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve been carefully reviewing everything you’ve shared, and this new patch brings a round of fixes and improvements based directly on your input.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔧 Bug Fixes",
     "items": [
      {
       "text": "Fixed a low reproduction soft lock during the first dialogue with Nahe",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in the secondary docking sequence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved look-at behavior when characters interact with guards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a eye alignment issue with Eyla",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected the completion percentage, which now properly reaches 100% when all objectives are completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🎵 Quality Updates",
     "items": [
      {
       "text": "Improved the minimum mouse sensitivity bounds and reduced the default sensitivity for smoother control.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Introduced the Featured Follows system when selecting a followee.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new security-themed music during docking in Marketland.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Replaced Eyla’s recap image with an updated version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Validate button in the emote wheel is now centered for better accessibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re continuing to work on the full game and will keep updating the demo based on your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Build version:4880-36931",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
