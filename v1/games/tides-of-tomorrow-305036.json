  {
   "id": "tides-of-tomorrow-305036@post-2025-10-10",
   "gameId": "tides-of-tomorrow-305036",
   "displayName": "Patch Note 2 - Tides of Tomorrow Demo",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-10T16:00:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Tidewalkers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you again for playing the Tides of Tomorrow demo and for all the amazing feedback you’ve been sending our way!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve been listening closely, and this latest patch brings a fresh round of improvements and fixes based directly on your input.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s what’s new in this version",
     "items": [
      {
       "text": "🔧 Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Resolved most issues related to ultra-wide screen support. A few sequences still display in 16:9, but we’re working on full compatibility.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "😍 Quality Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced facial animations for Eyla, Kass, Taj, and guards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Highlighted the Seed feature more clearly — don’t hesitate to share your seed codes so your friends can follow your unique path through the demo! You can find your seed in the pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved pacing: we’ve tweaked several dialogues and removed the second stealth sequence involving the lockers to streamline the experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added more life and ambient activity to the Market area to make it feel more immersive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We’re continuing to refine the experience and build toward the full game. Your feedback is invaluable, so keep it coming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks for being part of this journey with us! 🌊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Build version: 2-37343",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
