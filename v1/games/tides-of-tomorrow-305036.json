  {
   "id": "tides-of-tomorrow-305036@post-2026-05-12",
   "gameId": "tides-of-tomorrow-305036",
   "displayName": "Patch Note 4 - DLSS, FSR and Duck Hunter achievement!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-05-12T12:08:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Tidewalkers! 🌊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again for all the feedback you've been sharing since launch. With 4 patches released in a month, your reports help us identify issues quickly and continue improving the experience across the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today’s patch brings a mix of fixes and improvements, including support for DLSS and FSR, as well as several gameplay, localization and stability fixes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "⚓Gameplay & Progression",
     "items": [
      {
       "text": "Fixed an issue where the major choice between Obin & Nyx could be triggered multiple times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect end-of-level recap when the sample was not given to Eyla",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added an additional dialogue line to clarify the \"stop collecting eggs\" choice",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Divinity issues occurring in the Catacombs after reloading a checkpoint",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved several cases where players could go out of bounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🏆Achievements",
     "items": [
      {
       "text": "Fixed an issue preventing the Duck achievement from unlocking correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🌍Localization & UI",
     "items": [
      {
       "text": "Fixed several localization typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where non‑Latin alphabet characters would not display correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🎮Performance & Technical",
     "items": [
      {
       "text": "Added DLSS and FSR support",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed camera shaking that could occur when the framerate was uncapped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "May the Tides guide you! 🌊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Build version: 1687-44915",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
