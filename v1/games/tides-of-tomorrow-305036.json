  {
   "id": "tides-of-tomorrow-305036@post-2025-10-17",
   "gameId": "tides-of-tomorrow-305036",
   "displayName": "Patch Note 4 - Tides of Tomorrow Demo",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-17T14:23:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Tidewalkers! 🌊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As we sail into the final days of NextFest, we’ve made a few last-minute tweaks to make your Tides of Tomorrow demo experience even smoother!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛠️ Improvements & Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🧭 Improved guidance in the market — it’s now easier to find your way and spot key interactions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🏠 New UI element in the hideout — added to help you navigate and understand your objectives more clearly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "💬 Dialogue tweaks — we’ve polished a few lines and timing to improve clarity and flow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you haven’t tried the demo yet, now’s the perfect time to dive in and explore!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📣 Build version: 5067-37795",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’d love to hear what you think — drop your feedback, screenshots, or questions on our Discord!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again for all your support — and enjoy the rest of NextFest! 🌊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
