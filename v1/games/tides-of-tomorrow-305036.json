  {
   "id": "tides-of-tomorrow-305036@post-2026-04-28",
   "gameId": "tides-of-tomorrow-305036",
   "displayName": "Patch Note 3 - Set of fixes and improvements",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-04-28T13:18:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Tidewalkers! 🌊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Almost a week after the game's release, we wanted to thank you for your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You are more than 89% of you are enjoying Tides of Tomorrow, so from the entire team: THANK YOU! 🙏",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We spent three and half years developing this game and truly pourred our hearts into it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Because of your feedback, we’re releasing a major patch bringing a large set of fixes and improvements focused on game stability, progression, cinematics, and Steam Deck performance! ✨",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "⚓Gameplay & Progression",
     "items": [
      {
       "text": "Fixed multiple progression blockers, including objectives not validating, incorrect objectives displayed after checkpoint reloads, missing follow-up conditions and Delta Shipwreck blocker",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved several cases where players could go out of bounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed exploits and inconsistent behaviors related to scrap, Ozen and egg economy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🎧Audio",
     "items": [
      {
       "text": "Fixed several audio dropouts, stutters, and missing music issues in combat or cinematics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We are still actively working on reducing audio stuttering.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🎬Cinematics & Camera",
     "items": [
      {
       "text": "Fixed numerous camera glitches, animation timing issues and incorrect character orientations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved transitions during key cinematics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Resolved looping animations, incorrect character poses or misplaces NPCs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "💬Dialogue & Narrative",
     "items": [
      {
       "text": "Fixed dialogues that did not end proprely",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed dialogues that restarted instead of resuming when re-approchaing an NPC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed misgendering dialogue lines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes dialogues triggering from unintended distances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🌍Localization & UI",
     "items": [
      {
       "text": "Fixed multiple localization issues in all languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved UI consistency",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue on Delta Lab where Russian, Traditional Chinese, Simplified Chinese, Japanese fonts were not displaying correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "💾Saves & Stability",
     "items": [
      {
       "text": "Adding more offline save variations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues caused by checkpoint reloads leading to inconsistent states or incorrect notifications.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🎨Visuals & Environment",
     "items": [
      {
       "text": "Fixed various graphical issues (incorrect water rendering, floating objects, missing visual effects)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "🎮Steam Deck & Performance",
     "items": [
      {
       "text": "Adjusted text sizes across menus, objectives and pop-ups for Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Optimized graphic profiles for Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Optimized NPCs and visual elements for Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Overall performance improvements and stutter reduction",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please continue reporting any issues you encounter, it really helps us improve the game and refine your experience.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "May the Tides guide you! 🌊",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Build version: 1559-44836",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
