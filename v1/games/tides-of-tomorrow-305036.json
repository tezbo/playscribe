  {
   "id": "tides-of-tomorrow-305036@post-2025-10-13",
   "gameId": "tides-of-tomorrow-305036",
   "displayName": "Patch Note 3 - Tides of Tomorrow Demo",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-13T16:37:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "🌊 Hey Tidewalkers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Just in time for NextFest, we’ve rolled out a quick but important fix based on your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛠️ Bug Fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve resolved the issue where you’d get the message “You are faster than the other player” — now you can follow anyone: featured players, friends, or complete strangers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope this makes exploring the demo even smoother and more fun during the event.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again for all your support — and enjoy your NextFest! 🌊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Build version: 8-37419",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📸 Huge thanks to ALEXX on Discord for sharing the screenshot of this patch note!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Drop your screenshots, impressions, or questions on our Discord — we’d love to hear from you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
