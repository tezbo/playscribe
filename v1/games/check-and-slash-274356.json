  {
   "id": "check-and-slash-274356@1.1.0",
   "gameId": "check-and-slash-274356",
   "displayName": "UPDATE 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-30T19:52:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I just released a new update for the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Main changes",
     "items": [
      {
       "text": "adjusted -> boss summoning time reduced from 5 to 3 seconds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "changed -> the colors of cards, statues, and rooms in the maze change with each boss defeated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added -> room numbers/order are now displayed to aid navigation through the maze.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "changed -> the colors of the squares no longer change to indicate the range of enemy pieces.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "changed -> when dying, instead of returning to the first room, the player now respawns in the room where the previous boss was defeated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "adjusted -> the attack delay of white pieces has been increased, making it more noticeable where an attack will come from and giving the player more time to dodge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "added -> new tutorial messages have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added -> full health recovery is now guaranteed before starting a new boss fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "adjusted -> enemies and bosses rebalancing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "changed -> \"options menu\" added to centralize settings like language, music and SFX.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "adjusted -> minor UI adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "added -> now both the demo and full version have LINUX and STEAMDECK support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
