  {
   "id": "check-and-slash-274356@1.0.3",
   "gameId": "check-and-slash-274356",
   "displayName": "UPDATE 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-02T22:29:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I just released a new update for the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Main changes",
     "items": [
      {
       "text": "changed -> as \"ghosts\" doesn't have a physical body, ghosts will not block the movement of living pieces anymore, so now the Black King or any White Piece can stand in the same square of a ghost (including other Ghosts).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "changed -> the color of the squares that show the range of a ghost now have a different color of the ones showing the range of living pieces.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "changed -> ghosts will disappear of a room when a boss fight starts in that room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
