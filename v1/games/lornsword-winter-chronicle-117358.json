  {
   "id": "lornsword-winter-chronicle-117358@major-2019-07-02",
   "gameId": "lornsword-winter-chronicle-117358",
   "displayName": "Lornsword's Second Early Access update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-07-02T14:44:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear defenders of the Empire !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our second Early Access update is now live on steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "For this update we’ve improved Corun and Eshee skills and the battle dynamics while re-balancing the economy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improved swordplay",
     "items": [
      {
       "text": "Combo: 3rd attack deals additional damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New charged attack added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Targets can now be staggered when being hit",
