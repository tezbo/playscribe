  {
   "id": "lornsword-winter-chronicle-117358@major-2019-06-14",
   "gameId": "lornsword-winter-chronicle-117358",
   "displayName": "Lornsword's First Early Access update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-06-14T09:56:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Our very first Early Access update is now live on steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We’ve made quality of life improvements, visual upgrades and better keyboard bindings!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Here’s the main list of changes",
     "items": [
      {
       "text": "Campaign chapter selection added (you liked the Nil Roga battle? You can now play it again!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New music tracks added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Difficulty balancing improved (easy, normal and hard levels have been adjusted)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Alert icons made clearer (you shouldn’t miss them any more)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shadows buildings visual improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shadows units visual improvements (if you think a unit is new, it’s not, it’s just better looking!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Artifact Shines are now unique (they glow in the dark!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Music system improvement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keyboard binding improvement (a highly demanded change)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Summoning is now a direct action (previously you had to hold the button to make it work)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Outpost visibility improved (grass, could potentially hide it before, not any more!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shadows headquarters now self destruct (in chapter 2 only - careful with your units, they can be caught in that explosion!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Do let us know what you think of this patch on our Social Media channels:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
