       "text": "Fixed incorrect fade-in of levels after loading in rare cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect mana usage when player is sprinting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Shorter loading times for levels",
       "ps5ProOnly": false,
