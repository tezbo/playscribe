   "id": "island-farmer-178806@major-2025-07-16",
   "gameId": "island-farmer-178806",
   "displayName": "🎉 The Music Festival DLC is Out Now! 🎶Plus a Mini Words Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-16T18:23:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're thrilled to announce that the Meow Moments: Music Festival DLC is now available on Steam! 🐾",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "🎸 Step into a vibrant open-air celebration where cats and friends gather to enjoy pop, rock, folk, and electronic music. Explore themed stages, cozy camping spots, a dazzling Ferris wheel, and much more — all illustrated by Katia Numakura and set to a chill, festive soundtrack by Tatyana Jacques.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👉 Add it to your game and keep the celebration going!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🎮 Mini Words Gets an Update Too!",
     "items": [
      {
       "text": "That’s not all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just released a new update for our word puzzle game, Mini Words 🎉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🕹️ Now with Gamepad Support – play comfortably with a controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "☁️ Steam Cloud Enabled – keep your progress across devices",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you enjoy relaxed logic word games, it’s a great time to check it out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for supporting our cozy games! We hope you enjoy this new DLC and the updates across our catalog.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
