  {
   "id": "broken-pieces-137286@1.2",
   "gameId": "broken-pieces-137286",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-09-26T15:25:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate all the feedback yall have been sending to us. We've been listening to that feedback and have another patch for you all. Please keep the feedback coming. If you find any bugs or anything, please report them in our Discord through our ticketing system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added a progression board when you go to sleep with new documents.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added ending tape played during credits to add more context to the ending.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "updated ps5 icons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "added asset to indicate miss boismet house door (atop of it)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added post it to first electrical box to help players look up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fixed dreamlike entrance from church that should now properly disappear when the level is completed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
