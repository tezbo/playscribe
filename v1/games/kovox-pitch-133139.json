  {
   "id": "kovox-pitch-133139@1",
   "gameId": "kovox-pitch-133139",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-01-26T16:51:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone! A short note about the first patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs fixed",
     "items": [
      {
       "text": "Early Perfect hold balls no longer give more score than precise Perfect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Visuals on the last story location are tweaked (it's much more brighter now)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The game will be loaded even if some of your custom tracks are corrupted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Global scores always show up (sometimes there was 0 instead of proper Global score)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Disabled Save and Edit buttons in Editor when track is played",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chosen language is now saved after you close the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Cooldown window size after miss now depends on BPM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Editor Hotkeys were translated to Russian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Editor Tutorial Youtube link to the game (it's in Hotkeys tab)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Added all difficulties for",
     "items": [
      {
       "text": "Herlights - She",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "ANAIT - Pustota",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "ANAIT - Ne po zebre",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Also I made a Spotify OST with most of the tracks (some of them are not available there). I won't do a Youtube playlist until I add all songs that I want to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Playlist: https://open.spotify.com/playlist/1neKONFTai37Hv81tJbDPM?si=edbbc1b9568948ba",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Editor tutorial: https://youtu.be/xUr7K2gc6YY",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
