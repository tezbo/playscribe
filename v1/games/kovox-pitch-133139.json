  {
   "id": "kovox-pitch-133139@1.2.0",
   "gameId": "kovox-pitch-133139",
   "displayName": "Update 1.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-06T12:38:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This time I tried to tweak balance to make it easier to play on a Hard difficulty and to make the gameplay as fun and challenging as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balance Changes",
     "items": [
      {
       "text": "Overall speed of the balls is decreased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Hitbox is now 50% smaller (visually it stayed the same, but physically it's now smaller)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed can't-hit-after-miss cooldown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Hitting empty hitbox is now the same as missing the ball",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "HP loss after missing the ball became smaller and HP gain after hitting the ball became higher",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bug Fix",
     "items": [
      {
       "text": "Fixed boy animation bug, when he could be frozen at one frame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "It's a very important update for me, because I'm not very strong at gamedesign and tweaking all those numbers. I hope the game will be better with those changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Feel free to share your opinion on these changes here on Steam or on our Discord server.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Have a nice day!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
