  {
   "id": "kovox-pitch-133139@major-2021-09-12",
   "gameId": "kovox-pitch-133139",
   "displayName": "Demo Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-12T10:06:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello people!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I decided to update current Demo build, let's see what we've got here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Main Menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Beginning of a Story",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2 languages are available (English and Russian)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fixes + new bugs (just a little bit)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Try it out right now and tell me how you feel about it! You can do it here on Steam or on the Discord server HERE",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "And please don't forget to WISHLIST the game, it helps a lot!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I hope you are all doing good, stay safe!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
