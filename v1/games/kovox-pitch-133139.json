     "title": "Changes",
     "items": [
      {
       "text": "Hello everybody!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quick note that I've added multiple new languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Those are Spanish (both ESP and LatAm), Turkish, Portugese (BR), Vietnamese and Italian.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Current font doesn't fully support Vietnamese and Turikish, so some characters were taken from different font. I'll fix that later.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
