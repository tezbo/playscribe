  {
   "id": "kovox-pitch-133139@1.3.0",
   "gameId": "kovox-pitch-133139",
   "displayName": "Update 1.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-20T20:12:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Visual Changes",
     "items": [
      {
       "text": "Seafront lighting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Better graphic versions of all locations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Quality Settings in Settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Anime Lines effect on some parts of most of the tracks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed FPS setting not being set on the launch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed localization of Back to menu button in Calibration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "About than Anime Lines effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "At first I wanted to add a full Boost effect making everything on screen become white-black-yellow-pink colors. But I didn't figure out how to handle balance with this kind of effect, especially when there are red and blue balls on the screen. I decided to keep this feature for the future when or if I have an idea of how to handle it properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
