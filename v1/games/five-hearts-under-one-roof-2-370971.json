  {
   "id": "five-hearts-under-one-roof-2-370971@major-2026-01-12",
   "gameId": "five-hearts-under-one-roof-2-370971",
   "displayName": "[Update] Five Hearts Under One Roof 2 – 1/12 Patch Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-12T01:46:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, this is the Five Hearts Under One Roof 2 development team. 💌",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🌸 How are you enjoying Five Hearts Under One Roof 2?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this update, we have now added subtitles in two highly-demanded languages: German🇩🇪 and French🇫🇷!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🌎 We sincerely thank you for your endless love for Five Hearts Under One Roof 2 from wherever you are in the world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the future, please continue to support Five Hearts Under One Roof 2 by sharing your valuable feedback with us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will always strive to give you the best time with our beloved heroines, so please look forward to future updates as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you. 🙇‍♀️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
