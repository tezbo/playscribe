  {
   "id": "five-hearts-under-one-roof-2-370971@major-2025-11-20",
   "gameId": "five-hearts-under-one-roof-2-370971",
   "displayName": "[Update] Five Hearts Under One Roof 2 – 11/20 Patch Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-20T06:55:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, this is the Five Hearts Under One Roof 2 development team. 💌",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing the Five Hearts Under One Roof 2 and for sharing your valuable feedback across Social Medias, Steam, and other platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update focuses on improving overall stability, adding Mac OS support, and addressing several issues that may have affected the gameplay experience. Please kindly see the details below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🖥 Mac OS Support Added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game is now available on Mac OS.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "💬 Subtitle Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Issues such as missing subtitles in certain languages were fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced overall readability to ensure smoother story progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "🐞 Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Missing Album Reward in Demo version: Album rewards that were received in the Demo version can now be retrieved in the full version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ending Credit Skip Button: The problem causing the skip button to not display properly in the ending credits has been resolved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Text Corrections: Various lines and UI text were updated to correct typos and enhance consistency.: Thank you for your continued support of Five Hearts Under One Roof 2. 🌸: Your feedback is incredibly valuable and helps us improve the game.: We will continue working to deliver a more stable and enjoyable experience.: Thank you. 🙇‍♀️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
