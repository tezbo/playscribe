  {
   "id": "marfusha-sentinel-girls-143638@1.2.0",
   "gameId": "marfusha-sentinel-girls-143638",
   "displayName": "Update 1.2.0",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-11-14T15:58:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Medium updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the problem of not being able to proceed from the warning screen due to save data corruption.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the balance of Challenge Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Slightly improved the status of Alibina and Strelka at Lv.3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the playable abilities of Alibina and Bion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the effect of the card \"I want money\" from 10 to 15.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed the problem that the appearance rate of the electric gun/cerberus card is abnormally low.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the problem that the achievements of friends and guns are released.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved security measures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed other minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a dog to the DLC art book as an extra material.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Translated with www.DeepL.com/Translator (free version)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Original text-",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・セーブデータ破損により注意書き画面から進まなくなる問題を修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・チャレンジモードのバランスを調整",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・アリビナ/ストレルカLv3時のステータスを微強化",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・アリビナ/ビオンのプレイアブル時の能力を変更",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・カード”お金が欲しい”の効果を10から15に調整",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・電熱砲/ケルベロスカードの出現率が異常に低い問題を修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・仲間/銃の実績が解放されてしまう不具合を修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・セキュリティ対策の強化",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・その他、軽微な不具合の修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・DLCアートブックのおまけ素材に犬を追加",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
