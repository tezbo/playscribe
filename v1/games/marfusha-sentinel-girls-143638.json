  {
   "id": "marfusha-sentinel-girls-143638@1.0.0.4",
   "gameId": "marfusha-sentinel-girls-143638",
   "displayName": "Update 1.0.0.4",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-09-05T18:49:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Specification changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Decreased the rate at which rationing machines fail, and increased the rate at which Attack UP & Rapid Fire UP appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a problem where the EN version of paid leave was being displayed in place of the electric heat gun.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Belka Bion's additional installations will now remain in place beyond the next day.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that prevented medium-sized aircraft from attacking anti-aircraft turrets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Localization fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a typo in the buttons on the collection screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the EN version of Laika's greeting was in Japanese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
