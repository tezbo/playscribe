  {
   "id": "castlevania-belmont-s-curse-389434@1.1.3",
   "gameId": "castlevania-belmont-s-curse-389434",
   "displayName": "Update 1.1.3",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-16T11:50:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released an update to address an issue where the game may fail to launch and a black screen shows for High Refresh Rate Monitors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While we expect this update to improve the issue, it may still occur in certain environments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are continuing to work towards a full resolution as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We sincerely apologize for the continued inconvenience caused to players who have been waiting to play the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If the game still does not launch after the update, please contact Customer Support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will provide further information regarding future updates as soon as they are ready.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
