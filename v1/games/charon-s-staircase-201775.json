  {
   "id": "charon-s-staircase-201775@post-2023-05-16",
   "gameId": "charon-s-staircase-201775",
   "displayName": "Digital Deluxe Edition and Patch notes!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-05-16T13:20:36.000Z",
   "notes": [
    {
     "title": "Hey everyone,",
     "items": [
      {
       "text": "Today, we'll be releasing a 'Digital Deluxe Edition' of Charon's Staircase, this will include the base game, the soundtrack, and an art book.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The patch will include the following fixes/features",
     "items": [
      {
       "text": "-Fixed a save/load issue that caused the 'Continue' button to stop working correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fixed the selected mouse sensitivity setting not saving.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Fixed some collectibles not showing up in the gallery.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fixed a scenario in which the goggles wouldn't respawn after dying in a certain section of the hospital.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fixed the missing lantern puzzle shadows on low and medium settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fixed a bug that caused the flashlight to be permanent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Added an option to remove the black bars at the top and bottom of the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Added an option to adjust the text size for reading documents.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Added an option to turn off motion blur.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Added button mapping.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Added chapter select.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Updated tarot puzzle localization. (Some languages had incorrect words/ spelling).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Updated piano puzzle localization. (Some languages had incorrect words/ spelling).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please let us know if there are still problems!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Robert & Indigo Studios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
