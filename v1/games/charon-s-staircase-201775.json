  {
   "id": "charon-s-staircase-201775@1.5.9",
   "gameId": "charon-s-staircase-201775",
   "displayName": "Patch 1.5.9",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-21T08:35:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're so excited to announce that the new Charon's Staircase update, Patch 1.5.9, is now live on Steam! This update tackles several long-standing issues, including fixes for achievement unlocking problems and bugs that caused players to get stuck due to missing boundaries.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We’ve also made various other improvements to enhance your experience. Be sure to update your game and let us know what you think! Check out the Patch Notes below for more details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Arabic Text: Resolved display issues in Item Information UI for better readability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In-Game Portraits: Added a \"Read\" option for portraits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Localization: Fixed missing translations in the localization file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Achievements: Corrected missing achievements, incorrect unlocks, and fixed \"A Lonely Death\" achievement unlocking issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Text Display: Fixed issue with inner monologue text staying on screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Flickering Lights: Addressed screen flickering caused by in-game lights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Player Stuck Bug: Resolved issue with players getting stuck due to missing boundaries.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Key Dismiss Option: Added a dismiss option for in-game keys.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Checkpoint Restart: Fixed flashlight appearing unnecessarily after restarting in the mansion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-SOEDESCO",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
