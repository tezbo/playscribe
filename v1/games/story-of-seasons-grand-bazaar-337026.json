  {
   "id": "story-of-seasons-grand-bazaar-337026@1.2",
   "gameId": "story-of-seasons-grand-bazaar-337026",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-13T18:12:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The latest update for STORY OF SEASONS: Grand Bazaar doesn’t just bring in some new fresh fixes, it’s also bringing some fresh fashion! Included in the patch out today is a new volume of “Happy Bingo” that introduces several new cosmetic items you won’t want to miss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Three new cards offer some great rewards, but the stars of the show are the new Sushi Chef Cap, Sushi Chef Apron, and the two new Sushi Gliders: Tuna and Shrimp. What a catch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The full list of bug fixes available in this update is available below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added Deluxe Cards Vol. 2 to Happy Bingo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Balancing adjustments for some fishing rods",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added recipes for processing tea leaves at the Yellow Windmill",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed issue where warping home with the Travel Stone while triggering the initial Happy Bingo event would result in a progress blocker",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed issue where picking up items would occasionally result in a progress blocker",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed issue preventing bazaar donations and rank ups from functioning properly under select conditions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Other minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
