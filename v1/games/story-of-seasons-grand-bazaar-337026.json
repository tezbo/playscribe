  {
   "id": "story-of-seasons-grand-bazaar-337026@1.1.0",
   "gameId": "story-of-seasons-grand-bazaar-337026",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-08T05:02:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The STORY OF SEASONS: Grand Bazaar 1.1.0 update is now available and includes some bug fixes along with introducing the all-new “Happy Bingo.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Once you’ve updated the game and reached “City Bazaar Rank,” the Nature Sprites will visit during an event cut scene introducing “Happy Bingo.” Each spot on the card features an everyday activity like fishing or petting animals. Players complete these activities to fill spots on their card until they’ve completed a Happy Bingo! Players then turn in completed cards at the Nature Sprites’ stall, Happy Shoppe, on bazaar days to earn a variety of useful items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45558636/5271cb1f6c3592b34276ba2bfaf09ce288bcedff.png\"]There is even a Deluxe Bingo card that offers greater rewards, including unique outfits and gliders, which you can get a sneak preview of below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45558636/2875ee5b23268760fd7e5d01e378ef886d652fb3.png\"]Get collecting today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The full list of fixes in this update is available below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bingo features added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue resulting in a rare game crash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where dismounting from horse would reset bag color to default outfit settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where pet food bowl would stop functioning properly after rehoming a pet",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted select BGM and sound effect volume",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Other minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Addressed Unity security vulnerability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
