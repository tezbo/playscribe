  {
   "id": "story-of-seasons-grand-bazaar-337026@1.4",
   "gameId": "story-of-seasons-grand-bazaar-337026",
   "displayName": "Patch 1.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-02-10T18:05:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The 1.4 update will introduce new cards to Happy Bingo, which will help you earn the Ceremonial Glider and the Cherry Blossom Glider, as well as offer 10 new hair and eye color options to further customize your farmers. Plus, you’ll now be able to check the status of items in production at the windmills from the map screen!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The full list of all the fixes in the 1.4 update is available below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added Deluxe Cards Vol. 4 to Happy Bingo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added 10 new hair color options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added 10 new eye color options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added ability to check windmill production status from general map screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed issue resulting in rare game crashes with some cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Other minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
