  {
   "id": "wytchwood-75341@post-2021-12-11",
   "gameId": "wytchwood-75341",
   "displayName": "Dec 10th Fixes - Humble Pie, Feedback",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-12-11T02:01:03.000Z",
   "notes": [
    {
     "title": "Hey everyone! FIxed a few issues that came up after launch",
     "items": [
      {
       "text": "'Humble Pie' Quest bug fixed. This happened to a few players where they had to keep giving Humble Pie to the bandit boss. This should be fixed on loading that saved game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed 'Feedback' not working in Main Menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes for running out of memory on low memory machines when moving between scenes (mostly for Nintendo Switch): Let us know any issues or thoughts on the forums or our Discord! Thanks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lee",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
