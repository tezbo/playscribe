  {
   "id": "wytchwood-75341@major-2022-01-08",
   "gameId": "wytchwood-75341",
   "displayName": "January update! Some small fixes + new language: Chinese Traditional",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-01-08T22:06:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We updated with some small fixes, and added 'Chinese Traditional' as a language option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wytchwood has a total of 60k words, so we weren't able to get a lot of languages in before release. We are hoping to add more languages this month though. If you'd like to help, please let us know! Contact us by email at contact@alientrap.org - and let us know what language you'd want to help with. We're looking for help with French + German + Russian especially",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Some fixes / changes",
     "items": [
      {
       "text": "Absolutely fixed Humble Pie bug :) - last update still had some players hit it then only pass on reloading game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some issues with getting struck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hearthseed can now be crafted even without ingredients (only for 1 of them): thanks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lee",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
