  {
   "id": "resident-evil-3-115115@major-2022-06-10",
   "gameId": "resident-evil-3-115115",
   "displayName": "(Text updated)Update on system requirements",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-10T10:13:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "An upgrade patch will be releasing soon and system requirements will also be updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "【Update on system requirements】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The system requirements will change with the arrival of the upgrade patch. The new minimum requirements are listed below alongside the previous specifications no longer supported under this upgrade patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Minimum requirements",
     "items": [
      {
       "text": "■OS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Before：WINDOWS® 7, 8.1, 10 (64-BIT Required)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After：WINDOWS® 10 (64-BIT Required)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■DirectX",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Before：Version 11",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After：Version 12",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Graphics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Before：",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NVIDIA® GeForce® GeForce GTX 760",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "or AMD Radeon™ R7 260x",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "After：",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NVIDIA® GeForce® GeForce GTX 960",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "or AMD Radeon™ RX 460",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "【How to toggle automatic updates OFF】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Follow the following steps before the patch goes live.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Right-click the title under your Library, and select \"Properties...\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. In the \"UPDATES\" tab, change Automatic Updates to \"Update only when I launch it\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Press \"Steam\" in your steam client, and select \"Go Offline\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Press \"Play\" to start the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※Please switch to \"Go Offline\" every time you play this title.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※Please be aware that once the upgrade patch has been applied, the game cannot be restored to the previous version even if the game is uninstalled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
