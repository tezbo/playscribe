  {
   "id": "resident-evil-3-115115@major-2020-10-01",
   "gameId": "resident-evil-3-115115",
   "displayName": "New Resident Evil Resistance Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-10-01T02:33:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today's update includes 2 weapon types for Survivors, a new creature (NE-α), and new skill cards. It also includes specific cards based on Mastermind personality types that can only be used in certain areas. Plus, 35 Survivor skin color variations, 10 creature variations, and much more have been added. A balance update will also be available in the near future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Survivor Weapon KASHIMA (available in Area 1 and onwards)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Survivor Weapon RAI-DEN (available in Area 2 and onwards)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Creature NE-α",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-15 Skill Cards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Equipment Rank cap raised from 20 to 25",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Mastermind now unlocks all skills card at rank 20",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
