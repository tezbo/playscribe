  {
   "id": "donuts-n-justice-25932@major-2018-05-17",
   "gameId": "donuts-n-justice-25932",
   "displayName": "Update Patch Notes - May 17, 2018",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-05-17T19:01:32.000Z",
   "notes": [
    {
     "title": "The following updates have been implemented",
     "items": [
      {
       "text": "Added: \"Civilian Killed\" to the Stats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: Special abilities to some of the hats in the shop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "From now, your hat will be not only the ordinary fashion accessory :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added: Description text for the hats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fireman Helmet: You can walk through flames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Top Hat: Enemies drop more money",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Police Cap: You start with bullet proof vest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Robocop: Enable Burst mode for your default weapon (pistol)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Holy Pope Hat: Civilians will be imunne against your fire",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chef's Hat: Chance to drop Big Donut (restore 3 HP)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cowboy Hat: You can fire 2x faster with your default weapon (pistol)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Batman Mask: The little bat will be your new brother in arms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Frankenstein: Enables BlackWhite retro mode like in old movies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pumpkinhead: Unlock Halloween mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added (fixed) F12 key to take Screenshots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enjoy the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ps. And don't forget, I'm working on a new game called \"Gunman Tales\" !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
