  {
   "id": "a-building-full-of-cats-199237@post-2022-07-09",
   "gameId": "a-building-full-of-cats-199237",
   "displayName": "Patch Notes and more",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-07-09T18:25:50.000Z",
   "notes": [
    {
     "title": "Hello, humans!",
     "items": [
      {
       "text": "We can't be grateful enough to you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A Building Full of Cats got 80 reviews in 2 days!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thus, we can also help other cats in need! ♥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've made several small patchs in the last 2 days.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's a list of what has changed",
     "items": [
      {
       "text": "Changed some render properties to make the game less demanding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Fofiño fading animation bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed sometimes ESC not working on 5th and 6th floor after fiding Fofiño",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor visual glitches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed japanese and simplified chinese pointing to the wrong language",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Coming soon",
     "items": [
      {
       "text": "We've just received the Traditional Chinese localization and we're working on it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are also hiring localization for more languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Above, Fofiño sends his best regards (specially for those humans who decided to go \"yes\" in you-know-when)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you again, soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Love & Purrs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Devcats ฅ^•ﻌ•^ฅ",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
