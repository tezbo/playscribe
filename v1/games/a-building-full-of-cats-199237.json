  {
   "id": "a-building-full-of-cats-199237@major-2023-06-10",
   "gameId": "a-building-full-of-cats-199237",
   "displayName": "Soundtrack update and great news!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-10T19:48:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi humans! ːfofinoː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A Building Full of Cats Soundtrack has been updated and now displays the names and images of the tracks on the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sorry for taking this long to update this, but this has been a year of work non-stop and we hope that shows on the second semester. ːawkwardsmileː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also, the game was updated to show the new music credits. Now you'll see the credits for the currently selected soundtrack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "DEVCATS NEWS",
     "items": [
      {
       "text": "We are happy to inform you that we now have a Discord channel!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The purrfect place to see cute cats and discuss with other kind-hearted humans about our species.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enter for news, Devcats pictures, giveaways, and more. ːlovecatː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Your cat can be an NPC on A Tower Full of Cats!",
     "items": [
      {
       "text": "We'll have a contest on our Discord where your cat can win a spot on our next game, in the same art style from the cats on A Castle Full of Cats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bonus",
     "items": [
      {
       "text": "Meet Pietra & Vivi, new characters from A Tower Full of Cats!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have rescued them last December and have been fostering them ever since (Pietra already found her forever home, but Vivi is still waiting for hers ːcathspawː )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A Tower Full of Cats will be released next semester, stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Love & Purrs,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Devcats ฅ^•ﻌ•^ฅ",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
