   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello detective,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 2 is now available on Steam, you can find all details below.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "🗒️Patch note",
     "items": [
      {
       "text": "Holding the button will now fast forward dialog. It works right from the start but a message about it was added to the resolution screen that appears after the credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Intro scene, Hotel(going to bed) scene, and Mindcop spinning scene are now skippable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that makes the game crash if you do the mindsurf training with linda, then open the search warrant menu with emilia, and then exit the game and load",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed achievements not triggering correctly sometimes (pleasant partner, nosy and smooth operator)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the time cost warning not disappearing if you exit the woods menu while you mouse-over on one of the options",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the timecost for questionings. It was always taking 15 even if it showed 7/8",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The arrest menu offered by emilia on day 5 now allows aresting everyone you know about, instead of just everyone you met",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the free retry for mindsurfs not triggering when your time is at 0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
