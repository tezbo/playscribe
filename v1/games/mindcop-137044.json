  {
   "id": "mindcop-137044@1",
   "gameId": "mindcop-137044",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-21T15:59:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "📝Dev Notes📝",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you haven't encountered an issue similar to the unspoiled section of the patch note, avoid clicking on anything marked as a spoiler.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch note",
     "items": [
      {
       "text": "Fixed a minor english localization typo on murder time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with Benji giving you the overlook path even if you already have it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with Sean when discussing the topic \"Blackmail\" where Mindcop says the Note should still be in Rebecca's trash even though he took it and gave it to Marry.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug happening if you fail on a Impossible or Hard Mindsurf and then do the Linda Training that would give you the Achievements for completing them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug about Mindcop sometimes saying he can't look through stuff in the giftshop while people are there even when he's alone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a graphic glitch in Alex's Truth door.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a text overflow in Eliot's Truth door.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
