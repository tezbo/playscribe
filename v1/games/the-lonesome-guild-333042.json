  {
   "id": "the-lonesome-guild-333042@hotfix-2026-03-25",
   "gameId": "the-lonesome-guild-333042",
   "displayName": "The Lonesome Guild - Hotfix Patch",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-03-25T09:41:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45513057/efe9b22a400352d92fe5839211185ea3920bee88.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello Guildies!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you're having a great time exploring the lands of Etere.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As a team we're incredibly proud to see your theories and fan art, and love reading your feedback about The Lonesome Guild.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're still working hard to ensure a smoother experience for those who'll come and for those who are currently enjoying the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Fixes",
     "items": [
      {
       "text": "Fixed a problem with Ghost Light Altars in Espiritu Ori with Ghost Light Altars. Players who got stuck in there should now be able to proceed through the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a slide movement that could happen when interacting with a block at high FPS.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a problem with some saves that could be corrupted or could erase a recently acquired precious item.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a problem that allowed the user to proceed in Espiritu Ori withouth doing the intended activities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash issue when interacting with a specific bumblebun in the Tallyoh refuge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed numerous issues that caused the characters to fall of the ground.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The quest sorting in the quest menu has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various audio and UI issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Happy adventuring in The Lonesome Guild, we wish you an awesome journey!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
