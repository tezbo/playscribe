  {
   "id": "the-lonesome-guild-333042@patch-2025-11-24",
   "gameId": "the-lonesome-guild-333042",
   "displayName": "The Lonesome Guild - Month 1 Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-24T15:50:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45513057/ad248588c8724df4d16afc40081334e1c955b5ae.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello Travellers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you all for playing The Lonesome Guild. We're very glad to see how many of you have enjoyed the experience we crafted, and we appreciate your patience and support as we focus on making the game more stable and enjoyable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this new patch, we've taken the time needed to tackle deeper issues and enhance the gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Highlights & Fixes",
     "items": [
      {
       "text": "Addressed multiple causes of unexpected game crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some soft blocks related to character movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Many character abilities, enemy damage, and boss mechanics have been tuned and bugfixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various small environment glitches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Relocated a quest NPC in Nunuit Town to a more accessible spot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected an interaction bug during backtracking with already interacted objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added new quest markers to better guide in the main storyline.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some lighting and camera issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved focus problems during multiple-choice dialogues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected a quest soft blocks that could happen with the quest Stop the Presses in Primaeval Parish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Polished numerous cutscenes and fixed minor animation issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Implemented dozens of additional other minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We continue to actively monitor your feedback and are committed to polish the experience even further.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you once again for being part of this adventure. Enjoy your time in The Lonesome Guild!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
