  {
   "id": "the-lonesome-guild-333042@1",
   "gameId": "the-lonesome-guild-333042",
   "displayName": "Hotfix 1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-10-30T15:32:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45513057/efe9b22a400352d92fe5839211185ea3920bee88.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello Champions,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A huge thank you from everyone at Don't Nod Entertainment and Tiny Bull Studios for your incredible support and passion for The Lonesome Guild. We've been thrilled to see so many of you embarking on this journey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been closely reading your reports and are now deploying our first hotfix to address the most critical issues and progression blockers reported by players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Below are the fixes included in this update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Highlights & Fixes",
     "items": [
      {
       "text": "Falling Character Safety Net: We've added a safety check to prevent characters from getting permanently stuck in a falling state. While restarting the game may still be necessary if this occurs, you should no longer be trapped in an endless fall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a softlock with the first Ilbe encounter that occured to players while backtracking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed potential softlocks with certain encounters in the Sootpipes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the Eunimonya guards before the arena becoming non-interactable after telling them you \"needed more time\" and then traveling to another zone via the world map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug causing the Trummelporta doors to close unexpectedly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that prevented Espiritu Ori door before the second altar from opening correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where characters could fall off a bridge or stairs during \"Crisis in Crinklewood\" main quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that would cause Davinci to fall through the ground after a cutscene in Ilbe during Sarangalyn's quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We are continuously monitoring your reports and are ready to address any new issues that may arise. The Tiny Bull Studios team is constantly at work to improve your game experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you once again for your support. May your journey to fight Loneliness be a memorable one!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
