  {
   "id": "roller-drama-143895@patch-2023-01-31",
   "gameId": "roller-drama-143895",
   "displayName": "First patch after release",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-01-31T09:04:01.000Z",
   "notes": [
    {
     "title": "This patch fixes the following",
     "items": [
      {
       "text": "Your team name was not saved - sorry for that!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Labels for controller bumpers/triggers in the blockers' controls when switching in real-time (\"B\" on the controller) were swapped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you quickly opened/closed the inventory you could break controller focus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
