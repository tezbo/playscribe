  {
   "id": "roller-drama-143895@major-2023-03-07",
   "gameId": "roller-drama-143895",
   "displayName": "Roller Drama Officially Steam Deck Verified! Plus Clear Texts Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-07T07:38:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "For this update, we worked on optimizing readability and font quality rendering, which was sub-optimal for Chinese and Japanese fonts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now the latter don't rely on fallbacks for missing characters so the overall experience should be better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Plus, Roller Drama got a \"Steam Deck verified\" check! Playing matches on a Steam Deck should be even better.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Also, a host of little fixes and improvements",
     "items": [
      {
       "text": "Little fix when opening and closing meta panels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Clearer icons for selecting and deselecting special actions in matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed order of card selection in matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug when opening the Mental State panel and then attempting to close it with \"B\" on the controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Last but not least, a sale is now running, and the Spring one is not far too...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
