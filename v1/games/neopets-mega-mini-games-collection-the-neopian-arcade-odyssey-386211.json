  {
   "id": "neopets-mega-mini-games-collection-the-neopian-arcade-odyssey-386211@post-2026-04-09",
   "gameId": "neopets-mega-mini-games-collection-the-neopian-arcade-odyssey-386211",
   "displayName": "Devlog #2",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-04-09T19:40:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Neopians,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve been hard at work behind the scenes improving stability, security, and overall flow ✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today’s update focuses on refining the login experience and strengthening core systems to make everything smoother and more reliable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-QR Login Changes",
     "items": [
      {
       "text": "Added an expiration timer to QR Codes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "When you reopen the login page it will reuse the same QR code, as long as it hasn't expired of course!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Login Changes - Codes are now automatically formatted in ALL CAPS and the continue button will be disabled until the full code is entered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-Login Changes",
     "items": [
      {
       "text": "Codes are now automatically formatted in ALL CAPS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The \"continue\" button is disabled until the full code is entered!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "-Time Changes",
     "items": [
      {
       "text": "Timestamps are now fetched from a reliable UTC source, your local time wherever you are located is only used as a fallback now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update is all about tightening up the experience and making things more consistent behind the scenes — with more improvements on the way!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
