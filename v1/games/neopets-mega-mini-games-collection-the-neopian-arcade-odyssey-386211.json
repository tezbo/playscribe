  {
   "id": "neopets-mega-mini-games-collection-the-neopian-arcade-odyssey-386211@post-2026-03-30",
   "gameId": "neopets-mega-mini-games-collection-the-neopian-arcade-odyssey-386211",
   "displayName": "Devlog #1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-03-30T16:38:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Neopians,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve been hard at work behind the scenes making Neopets Mega Mini Game Collection: The Neopian Arcade Odyssey even smoother and more enjoyable ✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we’re rolling out our first batch of fixes and improvements, to fix a variety of bugs across mini-games and the world map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s what’s been updated",
     "items": [
      {
       "text": "Gadgads – Fixed game speed when restarting without returning to the menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jubble Bubble – Fixed lingering screams after the game ends",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kass Basher – Restored missing music on the difficulty selection screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kass Basher – Removed debug distance counter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sutek’s Tomb – Fixed issue where button spamming during reshuffle could freeze movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hasee Bounce – Fixed letter collecting logic (Turns out Hasees were feeling very generous and grabbing letters that weren’t their color… )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sutek’s Tomb – Fixed overlapping icons that made matches hard to see",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gallery – Fixed “Kreludor” typo on the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Snowmuncher & Faerie Bubbles – Fixed missing music",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is just the first batch of improvements, and we’ve got more updates on the way!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
