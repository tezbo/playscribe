  {
   "id": "neopets-mega-mini-games-collection-the-neopian-arcade-odyssey-386211@post-2026-06-18",
   "gameId": "neopets-mega-mini-games-collection-the-neopian-arcade-odyssey-386211",
   "displayName": "Devlog #4",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-06-18T20:41:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Neopians,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We wanted to share some small updates that have been made to the overall game experience and some specific mini games!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Game wide changes",
     "items": [
      {
       "text": "D-pad support has been added for all mini-games that use stick input!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Audio changes",
     "items": [
      {
       "text": "We've fixed some audio issues that were present in Nova Defender, Kass Basher , Turmac Roll, Meerca Chase",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Mini game specific changes",
     "items": [
      {
       "text": "-Jumpin' Gem Heist: rock drop now applies damage without delay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Spellseeker: fixed unintended transition triggering the danger message be visible on next level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Snowmuncher: fixed collision issue causing certain tiles to render incorrectly (invisible/visible state mismatch)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Snowmuncher: score now resets correctly on new game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Action mini-games: added input delay on results screen to prevent accidental continue via repeated 'A' button presses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
