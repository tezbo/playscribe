  {
   "id": "terminal-81-251976@post-2023-08-08",
   "gameId": "terminal-81-251976",
   "displayName": "Note about the Steam Achievements",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-08-08T22:55:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I just uploaded a revision of the 1.2.2 patch in which the problem that makes some people not unlock some of the steam achievements should be fixed.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "However, this problem that caused some people not to unlock some steam achievements has been very challenging and difficult to fix due to the rarity of the problems itself and the logs of the players that had that problem.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
