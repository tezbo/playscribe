  {
   "id": "terminal-81-251976@1.3.0",
   "gameId": "terminal-81-251976",
   "displayName": "Update 1.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-17T15:31:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "-International translations have been completely redone from scratch. Now, translations to Portuguese, Italian, French, German, Russian, Simplified Chinese, Japanese, and Korean should contain significantly fewer grammatical errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added a small tutorial explaining how to navigate the inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The game can now check from the start if any Steam achievements are missing. In case you unlock an achievement in the game but not on Steam, restarting the game should resolve this.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "(Redoing the translations was a challenging task that accidentally broke some codes. Nevertheless, I made a significant effort to test and fix all the bugs caused by the improvement of the translations. However, as previously mentioned, this was a tough job for a single person. So, if you encounter any bugs or errors after updating to this version, please report them on the Discord server).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord Server: https://discord.gg/93ba38DdhF",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
