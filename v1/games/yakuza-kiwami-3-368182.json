  {
   "id": "yakuza-kiwami-3-368182@1.11",
   "gameId": "yakuza-kiwami-3-368182",
   "displayName": "Patch 1.11",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-02-11T15:15:08.000Z",
   "notes": [
    {
     "title": "STEAM DECK VERIFIED",
     "items": [
      {
       "text": "The wait is over. Jump into the two-in-one experience of Yakuza Kiwami 3 & Dark Ties now!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "1.11 & 1.12 PATCH NOTES",
     "items": [
      {
       "text": "PATCH 1.11",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added New Game+",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved water surface rendering and lighting issues around the Kubochi River area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Brushed up overall visuals and presentation of Downtown Ryukyu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed various localization issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various bug fixes aimed at improving stability and overall gameplay quality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where color shifting occurred when FSR3 Frame Generation was enabled: PATCH 1.12",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Visual and expression polish throughout Kamurocho and certain mini-games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other fixes to improve stability and overall quality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "GET YAKUZA KIWAMI 3 & DARK TIES NOW",
     "items": [
      {
       "text": "A legend is reborn and a new legacy begins in the extreme remake of Yakuza 3, evolving every aspect of the game and adding Dark Ties, a brand-new tale of Yoshitaka Mine included as a separate experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep an eye on our social channels for more Like a Dragon & Yakuza series content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The Ryu Ga Gotoku Studio Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Twitter TikTok Facebook Instagram",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
