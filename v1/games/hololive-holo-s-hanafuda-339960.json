   "gameId": "hololive-holo-s-hanafuda-339960",
   "displayName": "Update 2025.12.25",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-12-25T03:02:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "・The following add-on has been activated: Holo's Hanafuda DLC: Usada Pekora & Houshou Marine Set",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a feature that allows players to check the effects of talent skills during a match.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added unique characteristics to each CPU hololive talent, giving them distinctive playstyles during Koi-Koi and Holo Awase matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "・Adjusted the CPU's \"Master\" difficulty setting as follows",
