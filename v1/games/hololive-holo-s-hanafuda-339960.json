   "id": "hololive-holo-s-hanafuda-339960@patch-2025-08-28",
   "gameId": "hololive-holo-s-hanafuda-339960",
   "displayName": "Improvement Patch Released! & Reviews exceed 100!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-08-28T11:23:01.000Z",
   "notes": [
    {
     "title": "■Improvement patch now available. Thank you for over 100 reviews!",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45451542/c92bd9f807cad3b8d838c07772e920a5c8b1470b.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Since release, we've been incredibly grateful to see so many people playing the game and receiving your supportive messages and suggestions for improvement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Your reviews, community hub posts, livestreams, and social media shares have been a tremendous encouragement to the entire development team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "We have now released the following improvement patch",
     "items": [
      {
       "text": "・Added an option to skip a losing match in Adventure Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Added an option to adjust the text display speed in Adventure Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Added penalty functionality when disconnecting in the middle of an online match.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
