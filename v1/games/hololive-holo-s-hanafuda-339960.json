       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "・Adjusted the effects of the talent skill \"Gleaming Star.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "7+ Cards: 10% → 10%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "5-6 Cards: 15% → 15%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "3-4 Cards: 25% → 30%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "2 Cards: 40% → 60%",
