  {
   "id": "klang-2-131563@post-2022-03-08",
   "gameId": "klang-2-131563",
   "displayName": "Further enhancements for cloud save functionality!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-03-08T20:43:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue where the save file would increase in size over time, causing potential problems with cloud saving size limits (Engine bug, I swear!).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The save file system has now been reworked to make a custom file designed for cloud saving. Detected legacy save files will automatically be converted into the new format. The transition to the new version should be seamless. Don't hesitate to reach out if you encounter further problems regarding saving files!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tinimations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
