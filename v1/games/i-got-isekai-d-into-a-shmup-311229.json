  {
   "id": "i-got-isekai-d-into-a-shmup-311229@1.4.2",
   "gameId": "i-got-isekai-d-into-a-shmup-311229",
   "displayName": "Patch 1.4.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-03-21T15:15:55.000Z",
   "notes": [
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Completing the game in 1CC on Manic difficulty now also unlocks achievements for lower difficulty modes (Hard/Normal).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Completing the game in 1CC on Hard difficulty now also unlocks achievements for lower difficulty modes (Normal).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Defeating the game with the \"Ultimate Boss\" now correctly adds it to the Bestiary and unlocks the Bestiary completion achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash occurring on one of Lee's choices (when the choices have been unlocked).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Restarting from the Training Mode menu now correctly resets the player's remaining lives.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The texts in the unlocked scenes are now correctly aligned.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "New Feature",
     "items": [
      {
       "text": "The \"Pause On Hit\" option selected from the Extra Menu is now saved for future play sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
