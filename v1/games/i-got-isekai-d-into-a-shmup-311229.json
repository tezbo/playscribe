  {
   "id": "i-got-isekai-d-into-a-shmup-311229@1.4.0",
   "gameId": "i-got-isekai-d-into-a-shmup-311229",
   "displayName": "Update 1.4.0",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-12-02T21:53:02.000Z",
   "notes": [
    {
     "title": "- Scores displayed at the end of stages",
     "items": [
      {
       "text": "The scores of eliminated players are now shown on the Stage Clear screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(unless a replacement/Pilot change has occurred in the meantime).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "- Collision improvements",
     "items": [
      {
       "text": "Fixed an issue where certain grounded enemies incorrectly collided with players. These collisions have now been disabled, ensuring smoother and more intuitive gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "- Camera speed adjustments",
     "items": [
      {
       "text": "The camera's movement has been slightly optimized for a better experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
