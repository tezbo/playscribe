  {
   "id": "i-got-isekai-d-into-a-shmup-311229@1.3.0",
   "gameId": "i-got-isekai-d-into-a-shmup-311229",
   "displayName": "Update 1.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-24T07:56:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re excited to announce that update 1.3.0 is now live! You can now dive into the all-new Training Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Training Mode in \"I Got Isekai'd into a Shmup\"",
     "items": [
      {
       "text": "Select any of the 8 stages and sharpen your skills.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can restart the level at any point during your training session to perfect your performance. Track down all the silver stars, and get ready to unleash your best run in Story Mode or Arcade Mode!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
