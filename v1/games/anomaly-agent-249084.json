   "id": "anomaly-agent-249084@1.0.0.22",
   "gameId": "anomaly-agent-249084",
   "displayName": "Hotfix 1.0.0.22",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-01-26T13:55:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Due to an issue after the launch, we noticed that the \"Treasure Hunter\" achievement is not progressing as it should be for some players. After installing this update, when you open the game and reach the Main Menu, the achievement should be correctly updated on the Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There are a total of 28 chests in the game. If you haven't deleted your game progress after opening all the chests, the achievement should unlock when you enter the game after the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
