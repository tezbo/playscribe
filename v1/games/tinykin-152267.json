 "releases": [
  {
   "id": "tinykin-152267@major-2022-12-20",
   "gameId": "tinykin-152267",
   "displayName": "FREE CHALLENGE UPDATE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-20T16:08:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, brave adventurers and tiny explorers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you've been having a great time playing Tinykin so far!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have great news for those who have finished the game and are eager for more (unless you’re afraid of hornets, that is).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jokes aside, you know how competitive hornets can get, and they'd like to challenge you to race in the Swiftornet!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Look for the friendly hornets Mach and Dash with your augmented reality glasses, talk to them and get ready to join the tiny racing buzz!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Time Attack Challenges",
     "items": [
      {
       "text": "Time Attack Challenges can be unlocked when completing the main quest in each room: Transidor, Sanctar, Foliana, Balnea, Ambrose and Celerion. There are two challenges per room, one shorter than the other, and several medals to earn for each of them!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You will need to get at least a Bronze Medal on Dash’s short track to unlock Mach’s longer one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The race consists of reaching each arrow bubble as fast as possible until you cross the finish-line bubble. In the end, you will teleport back to the corresponding hornet, who'll keep you updated on your progress and rewards!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You will also find a new hornet in Chrysal Workshop called Legarfaldwho's waiting to tell you how cool you look in your new outfits. Oh, right, we almost “forgot” to tell you about those! 😉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Outfits for Milo",
     "items": [
      {
       "text": "For those who have already finished the game, you will find a special gift outfit in Chrysal already waiting for you! In addition, winning two gold medals in each of the six rooms will unlock more exclusive outfits for Milo!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "There are a couple of secret outfits as well that you will have to discover by completing the challenges and reaching 100% game completion!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You will be able to collect each outfit reward in Chrysal and switch to them in the special Costume tab in the Game Menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Remember, you gotta go fast, adventurers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If you want to learn more about this update, read the patch notes below! 👇",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "v1.1.0 PATCH NOTES",
     "items": [
      {
       "text": "Two time attack challenges have been added in six rooms: Transidor, Sanctar, Foliana, Balnea, Ambrose, Celerion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "These challenges become available once the main quest has been completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The long track is available once you obtain at least the Bronze medal on the short track.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Scoreboards have been added to the Game Menu, under Objectives.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now switch between Quests display mode and Challenges display mode by pressing a button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The challenges’ screen of each room now displays your personal best time and the standard reference times for each medal.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Two new hornet NPCs have been added to guide you through the challenges. They can be seen in Chrysal Workshop or in any of the previous rooms once the main quest has been completed. Mach is in charge of the long tracks and Dash is in charge of the short ones.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New outfits for Milo have been added to the game and to the Outfits tab in the menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "They can be earned by winning 2 gold medals in a room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
