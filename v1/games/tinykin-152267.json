  {
   "id": "tinykin-152267@1.2.2",
   "gameId": "tinykin-152267",
   "displayName": "Patch 1.2.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-02-24T17:57:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Tinykin Demo got updated to 1.2.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of changes",
     "items": [
      {
       "text": "Bugfix - Spamming menu's buttons was causing freezes and/or blackscreens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfix - Was unable to skip intro video after going back to main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfix - Sanctar's vent door (leading to Chrysal Workshop) sometimes pushing Milo of level bounds after opening animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfix - Removed video player for Windows 7 (might fix blackscreen at startup on some devices)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfix - Fix attempt for the bubble gauge sometimes decreasing instead of increasing (also added more infos in player.log to help fixing the bug if it happens again)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added missing text/translations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Wishlist button now opens within Steam's overlay instead of web browser: Please update your game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
