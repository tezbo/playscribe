  {
   "id": "promise-mascot-agency-299593@1.1.2",
   "gameId": "promise-mascot-agency-299593",
   "displayName": "Patch 1.1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-17T16:32:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fix occasional crash when winning multiple items in the Crane Game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix rare issue were some vehicle based achievements were not being awarded correctly. Players who have been affected should be able to load the game and drive / boost / glide for a few moments to unlock the achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix rare issue which caused the auto-save system to become blocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix the \"Hey Boss\" popping from not fully dismissing in some rare cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix the election rally crowd SFX from leaking into the rest of the game once the rally has completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for the collection progress tracker incorrectly limiting the display to 99%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added map markers to help 100% collecting litter, billboards and katashiro. Markers appear when reaching 97%, 97% and 96% respectively.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix typos in credits and some localisations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix to help limit the pop in effect of the tunnel post-process after exiting dialogue whilst in the tunnel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for one of the kittens remaining in the world after collection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for some currency buffs not working as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased the area of detection for the custom map marker so it dismisses earlier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fix for duplicated items in Captain Signs shop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for missing collision around Fuku-Kata's house.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
