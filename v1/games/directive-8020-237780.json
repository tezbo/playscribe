  {
   "id": "directive-8020-237780@post-2026-06-15",
   "gameId": "directive-8020-237780",
   "displayName": "Patch Notes – Bug Fixes to Improve Player Experience",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-06-15T15:28:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It’s been a month since Directive 8020 launched and it’s been great seeing all of you play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve got another patch for you, this time across all platforms to fix multiple issues and bug reports that you have reported to us including the infamous ‘Missing Legs’ issue on console.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate everyone that has reported an issue. If you have any that you’d like to report after this update please head over to our Zendesk Support Portal:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Regarding online multiplayer, it’s definitely coming and the team is hard at work. We’ll update you on this as soon as we can.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "Fixed an issue where the rewind button occasionally does not appear in the Turning Points menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where different difficulty settings when playing multiplayer did not function correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the ‘reply’ prompt did not appear in some languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the freeze that would occur when accessing the ‘O Death’ in Bonus Features Menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where an infinite loading screen would occur when resuming a game save after an interaction with specific sequences and rewinding with Turning Point.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Steam",
     "items": [
      {
       "text": "Fixed an issue where the FPS would drop when switching screen aspect ratio with Frame Generation ‘On’.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the ‘Fatal Error’ crash when returning to Main Menu from exploration areas of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where there would be an infinite loading screen occurring when rewinding ‘The Rogue’ Turning point.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the instance where the Twitch poll vote would fail on the ‘Wish’ choice in Episode 08.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some key bind setting changes would revert back to default when resuming the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "PS5 and Xbox",
     "items": [
      {
       "text": "Fixed turning points not unlocking for players 2,3,4 and 5 after completing multiplayer on ‘Survivor’.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where specific messenger conversations fail in Episode 05.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple character model issues for Anders in Episode 03 occurring due to PlayGo/FastStart.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue where some characters were missing body parts due to the PlayGo/FastStart feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "PS5",
     "items": [
      {
       "text": "Fixed a save corruption issue that occurred from the PlayGo install feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixed a save corruption occurring when interacting with secrets if you use the DualSense controller’s Touch Pad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixed where the keypad fails to open in Episode 05 causing a progression block.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "From the Supermassive Games Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    }
   ],
