  {
   "id": "directive-8020-237780@post-2026-05-26",
   "gameId": "directive-8020-237780",
   "displayName": "Patch Notes – Ray Tracing, DLSS, UI Fixes and Steam Deck Improvements",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-05-26T14:03:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing Directive 8020 and we’re glad to see so many of you come aboard the Cassiopeia. Thank you for sending in your reports regarding Ray Tracing, DLSS, bugs, and performance issues so today we are addressing some of these.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Our team has been actively working to improve your overall experience, and we hope that today’s patch will be the first step to resolving your issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If your issue has not been addressed in this patch, rest assured that the team are looking into these for you. If any of your issues persist, make sure to create a ticket in our Zendesk Support Portal and we will be more than happy to help.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ray Tracing and Path Tracing",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Performance optimisation when using Ray Tracing and Path Tracing.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved Depth of Field quality when using Ray Tracing with DLSS Ray Reconstruction.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Reduced noise caused by Depth of Field during gameplay exploration when using Path Tracing and DLSS Ray Reconstruction.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "DLSS Ray Reconstruction is no longer enabled automatically when using Ray Tracing.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "DLSS Ray Reconstruction can now support DLAA and Ultra Performance modes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue for not being able to scroll past HDR settings with certain input methods.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In multiplayer mode, we have fixed the issue where turning points appear locked for the 2nd, 3rd, 4th, and 5th player slots after finishing the game in Survivor mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Turning Points Episode Select",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased Episode Description Font Size",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Collectable Number Font Size Increase",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added black background to thread description",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Episode Number and Name Font Size increase",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Overflow will be clipped",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Turning Points Episode Thread Screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased font size for both headers in the Details Panel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased font size for Details Panel node description and Hint",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Key is hidden",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Turning Points Help Screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Key scaled 50%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Help text font size increase",
       "ps5ProOnly": false,
