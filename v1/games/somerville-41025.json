  {
   "id": "somerville-41025@1",
   "gameId": "somerville-41025",
   "displayName": "Hotfix 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-11-17T15:07:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks for all the bug reports and love that you’ve been sending our way, it’s much appreciated. We’ve been hard at work since the launch of Somerville fixing as many issues as we can, and we’re pleased to release Patch 01 with the following technical and performance improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Performance",
     "items": [
      {
       "text": "Adds additional options to allow finer control of optimisations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improves performance on both high and low end systems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes bug preventing low quality graphics setting from working",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes most stalls that were occurring on low end systems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Adds full screen option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixes various vibration controller issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes various conditional gameplay blockers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various quality of life and play-experience improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re moving onto Patch 02 next.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
