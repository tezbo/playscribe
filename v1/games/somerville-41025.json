 "releases": [
  {
   "id": "somerville-41025@4",
   "gameId": "somerville-41025",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-31T16:03:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey friends,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for the continued support of Somerville and all of your recent reviews. We've been working hard over the last few months on fixing a few bugs and adding additional language support so that more of you around the world can experience Somerville in your native language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're very happy to now support a total of 24 different languages in our game! This update adds support for 11 additional languages!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Arabic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Turkish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Russian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hungarian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Czech",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Danish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dutch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Finnish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Norwegian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Swedish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ukrainian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also recognised that a lot of you were experiencing problems playing Somerville on foreign keyboards. We worked with a few very helpful people in the community to identify what was happening and have included a change in this patch that will allow all keyboards to work with our game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes & Changes",
     "items": [
      {
       "text": "Fixed various audio issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed and improved a number of issues with controller vibration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various foreign keyboard support changes & improvements",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Support for 11 additional languages (Thanks again for all of the love and support!All the best and stay healthy!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "In other news... Somerville is on Playstation 4 & 5",
     "items": [
      {
       "text": "We are extremely happy to be releasing Somerville on PlayStation 4 & 5. It's got the same features and support the current Steam version has, and for those wondering, we've done a bit of work to make the Dual Sense controllers feel right on Playstation 5 too!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "The Somerville Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    }
   ],
