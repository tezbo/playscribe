  {
   "id": "somerville-41025@2",
   "gameId": "somerville-41025",
   "displayName": "Patch 2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-12-16T13:47:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks for all the online review comments and further bug reports. We’ve been working to improve the player experience in time for the upcoming holidays. Your continued love and support means a lot to us and we’re pleased to release Patch 02 with the following fixes, improvements and a new feature:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixes various player character getting stuck and falling out of the world bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes worse offending character animation pops and glitches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes some localisation string bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes many other smaller visual bugs and flaws",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Tweaks to radius and angle parameters to improve various interaction reliability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved environment collision throughout the game to fix and improve snagging and unnatural movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusting lighting across the game to improve readability of the player path and interactions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved visual consistency of interactable objects and removed/subdued non-interactable ones that looked misleading across the game to improve interaction readability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Continued performance improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Feature",
     "items": [
      {
       "text": "Petting the dog at key moments when the dog is standing or sat still",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We’re ensuring the team gets some well deserved rest over the coming holidays. We'll be back in the New Year to continue our support of Somerville.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
