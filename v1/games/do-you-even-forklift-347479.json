   "id": "do-you-even-forklift-347479@major-2025-06-03",
   "gameId": "do-you-even-forklift-347479",
   "displayName": "Devlog 2 - DEMO update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-03T18:53:57.000Z",
   "notes": [
    {
     "title": "In this update you will found",
     "items": [
      {
       "text": "Fixed birds sounds and view audio settings,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "1 more demo level,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Demo endscreen,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Parking slot doesn't trigger while there is other wrong object in trigger,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Parking slot doesn't trigger when forklift lifting something.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More levels has birds and they spawn faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now you can stack car on car!: And finally!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Birds now can land on your forklift if you doesnt move!: Have a nice day!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
