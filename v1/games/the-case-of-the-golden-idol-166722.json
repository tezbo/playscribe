  {
   "id": "the-case-of-the-golden-idol-166722@major-2023-06-06",
   "gameId": "the-case-of-the-golden-idol-166722",
   "displayName": "DLC support added for macOS users!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-06T08:00:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey detectives,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The latest patch adds DLC support for macOS players! We're happy to announce that Mac players can now enjoy solving the three new cases in Golden Idol Mysteries: The Spider of Lanka.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Notice for macOS users",
     "items": [
      {
       "text": "Due to revisions we made on the Mac version, old save files from before the update will need to be copied over manually. Please follow these recovery instructions for MacOS:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Locate the following folder: ~/Library/Application Support/Godot/app_userdata/The Case of The Golden Idol/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Find file local_savegame.save and a file with your steamid (long string of numbers) followed by savegame.save (example: 76562187998383791_savegame.save)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Open local_savegame.save in any text editor and copy its contents over everything in the savegame starting with your steam id.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save this file and you should now have a functioning savegame that the game will read.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: We're aware of achievement and performance issues related to MacBook models with the Apple M1 processor and are investigating the matter. We appreciate your patience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please feel free to let us know your feedback in the discussions or in our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
