  {
   "id": "the-case-of-the-golden-idol-166722@2022.12.05",
   "gameId": "the-case-of-the-golden-idol-166722",
   "displayName": "Update 2022.12.05",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-06T13:59:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey detectives,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The following issues are addressed in this second patch based on player feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed visual inconsistencies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A number of visual glitches were removed and some legacy visuals were updated to improve the clarity of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More typos fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A number of typos and grammar mistakes were corrected in the texts of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugs fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where in scenario 10 one could input repeated phrases in the virtue solver and receive the correct evaluation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where in scenario 9 the incorrect phrases were given to the players in two phrase-gathering spots (although not game-breaking, the correct phrases were already given elsewhere).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
