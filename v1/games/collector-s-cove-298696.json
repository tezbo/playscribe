  {
   "id": "collector-s-cove-298696@1.0.6",
   "gameId": "collector-s-cove-298696",
   "displayName": "Patch 1.0.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-22T09:09:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ahoy Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been a while, but here is another small patch that addresses a few more major and some minor issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Adjusted map generation so the merchant island is placed closer to the player starting position",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed movement input not working after breaking a fence with the axe",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed garbage collection related crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed overlapping spawn points for some points of interest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a few instances of invisible walls blocking camera collision",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, if you have more feedback or find new bugs for us to fix, please join our Discord to send them our way! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "See you out there, Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44983255/e4b7dbaf1065ec012cea9ac634af6e00154d31da.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
