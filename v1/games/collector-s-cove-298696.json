  {
   "id": "collector-s-cove-298696@1.0.5",
   "gameId": "collector-s-cove-298696",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-28T13:38:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hiya Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just rolled an extra update to bring some Quality-of-Life improvements and bug-fixing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fish caught by rank 25 fishing perk do not count towards island freshwater spawn limit anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The chance for a meteor shower night is now increased for every night it does not happen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a UI indicator that shows up during a meteor shower",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased text sizes for quest tasks and item descriptions to make them more readable on smaller screens",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed crashes occuring related to fabled crops with conditions that require specific decoration to be on the boat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed merchant bell not being usable when loading into game after finishing all shop introductions but before dismissing merchant",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed The Collector's Cove achievement not being unlocked for some players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed gramophone not working for Fabled Beetroot condition",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Cosmic Light decoration not counting as a light source",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed selecting a customization item color variant not being applied when selecting an empty slot first",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed large auto fisher only catching medium fish. Auto fishers now ignore daytime and weather restrictions when catching fish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Bait Maker and Compost sometimes refunding excellent (star) quality items instead of normal ones",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you have anymore feedback or find extra bugs for us to fix, please join our Discord to send them our way! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "See you at sea, Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
