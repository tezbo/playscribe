   "announcedAt": "2025-06-12T14:57:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here is our first patch for the demo with several critical fixes and adjustments!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed an issue that could softlock the game in an infinite loading screen when going inside the boat while an island was being generated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could softlock the game when opening the compendium through the discovery popup during certain activities (fishing, building, flotsam)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed flickering water on certain GPUs: If you still experience issues with the water, please let us know!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bridge not being walkable on one specific island in a very specific configuration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some drag drop operations working even when used on disabled inventory slots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed fish spawn times not being displayed correctly when cycling through fish in compendium",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated French translation for Fabled Clownfish special condition to more accurately reflect the condition",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Changed treasure puzzle runes to glow by default and stop glowing when activated in an attempt to improve readability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed tiki statue rune for resources to improve readability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
