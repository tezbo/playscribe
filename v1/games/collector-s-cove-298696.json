  {
   "id": "collector-s-cove-298696@4576.822",
   "gameId": "collector-s-cove-298696",
   "displayName": "Patch 4576.822",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-13T20:56:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Heya Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have another smaller patch ready for you all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed an issue that would cause island save data to not be completely deleted when starting a new trip while an island was active",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "This issue led to some objects being placed in wrong spots on affected islands (e.g. Rune Stones)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed special conditions for Fabled Clownfish and Fabled Butterflyfish not considering decorations placed in the boat interior",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed gamepad navigation in chest menu not navigating to player inventory under certain circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed player companion missing sleep vfx on islands",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Player Guide Secret Seller page translations for German, Spanish and Japanese to more accurately reflect how it works",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
