  {
   "id": "collector-s-cove-298696@post-2026-05-13",
   "gameId": "collector-s-cove-298696",
   "displayName": "Collect Anywhere: Collector's Cove Now SteamDeck Verified!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-05-13T11:52:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ahoi Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Exciting news! While it has always been playable, with this newest minor update Collector's Cove is now officially SteamDeck verified! Take your floating farm with you wherever you go and give your favorite Fablefin a big hug!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you have anymore feedback or find extra bugs for us to fix, please join our Discord to send them our way! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you out there, Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44983255/e4b7dbaf1065ec012cea9ac634af6e00154d31da.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
