  {
   "id": "collector-s-cove-298696@1.0.4",
   "gameId": "collector-s-cove-298696",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-25T15:07:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ahoy Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today comes another small update to bring some Quality-of-Life improvements and bug-fixing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed more random crashes related to garbage collection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed game freezing up when executing a trade with too many items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Fabled Wheat conditions not working consistently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Swim Speed perks not working after loading the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed getting stuck when hitting flotsam with plunger at the same time as flotsam helpers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed 3rd inventory upgrade costing 0 gold ingots (should be 2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed companion not wearing correct customization color variants on islands",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed screen flicker when catching a fish due to camera collision testing being enabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed falling trees blocking camera collision, leading to camera quickly repositioning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some translation issues in Simplified Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Adjusted lighting in Tropical Trove and Haunted Harbor regions to make them less bright/dark respectively",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "When a fish is too far away, instead of just escaping the fishing line now snaps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Appropriate input glyphs are now shown when playing with a DualShock4 controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have anymore feedback or find extra bugs for us to fix, please join our Discord where we are everyday!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you out there Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
