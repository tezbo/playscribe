  {
   "id": "collector-s-cove-298696@1.0.3",
   "gameId": "collector-s-cove-298696",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-17T15:15:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hiya Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just rolled a small update to fix some of the bugs you let us know about!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed a bunch of random crashes caused by garbage collection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some crashes occuring when an island was being loaded and the player transitioning into customization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash when using strong pull ability right before catching a fish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Fabled Koi not being discovered when exchanging it for another fish in the fish tank",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Compendium being able to be opened through unlock popup during dialogue transitions, potentially breaking input when exiting menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed vine bridge blocking collisions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some rocks blocking points of interest on islands",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Until next time, Collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
