  {
   "id": "ww2-bunker-simulator-123889@2",
   "gameId": "ww2-bunker-simulator-123889",
   "displayName": "Patch 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-23T11:47:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "SOLDATEN!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have deployed the second patch for the WW2: Bunker Simulator - Origins DLC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We added a friendly soldiers counter on the top of the screen when pressing TAB",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balanced amount of enemy soldiers attacking a bit more",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added bed-teleporters out-of-bounds of bunker walls (it will return you to bed, so you don't have to restart the game when)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Happy shooting!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bunker Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
