  {
   "id": "ww2-bunker-simulator-123889@1",
   "gameId": "ww2-bunker-simulator-123889",
   "displayName": "Patch 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-22T08:45:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "SOLDATEN!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have deployed the first patch for the WW2: Bunker Simulator - Origins DLC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We heard your opinions on how many US soldiers attack the bunker, especially in non-defend bunker missions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We made the loot system a bit more rewarding to help you handle the DLC challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the MG bug with dying soldiers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Remember that the Origins DLC is meant for the WW2: Bunker Simulator veterans so the difficulty was meant to be pumped up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy shooting!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bunker Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
