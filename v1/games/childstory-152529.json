   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The long-awaited update of ChildStory, where I fixed minor unpleasant bugs and made a \"Streamer Mode\" that replaces all copyrighted tracks with their covers, which YouTube does not swear at.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I really wanted to leave the original soundtrack unchanged, even though the \"Bike to Tokyo\" never rewrote them. Julia Isakova took over the covers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
