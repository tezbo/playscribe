   "id": "childstory-152529@27.04.24",
   "gameId": "childstory-152529",
   "displayName": "Hotfix 27.04.24",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-04-26T22:46:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your patience! I had a lot of work this month :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I fixed the bugs that crashed the game and returned the old controls, without the mouse, as it spoiled the very atmosphere that I wanted to convey, as well as broke the complexity of the game!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Translation fixes, rebalancing and new endings are ahead!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
