  {
   "id": "god-damn-the-garden-185915@2",
   "gameId": "god-damn-the-garden-185915",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-12-30T13:52:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "hey,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added achievements lol. there's 16 of them for u to do now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "originally i wanted to have these implemented before release, but didn't have time for it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "next on the agenda is adding localization and controller support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "for localization, i'll only add norwegian for now, cus i don't have the budget to add other langs lol.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "for controller support, i'll only add controller support for now, cus i don't have the budget to add other controller uspport.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Regards, computer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
