  {
   "id": "god-damn-the-garden-185915@post-2022-01-24",
   "gameId": "god-damn-the-garden-185915",
   "displayName": "Langs added: Russian & Norwegian",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-01-24T12:24:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "hellohello!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "new langs are in, russ and norw!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "only norw was planned, but got a good guy named kodsleep that helped out with russ, he's a cool one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "if any of u wanna help out adding more langs, let me kno lol. since the dialogue is really dumb, it can almost get away with pure Google Translate, so will mostly need someone to look over it to make sure it makes proper sense",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "here's my mail if u wanna look into it",
     "items": [
      {
       "text": "agelvik.contact@gmail.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "also wops, in previous update i accidently disabled occulusion culling, which greatly helps with getting good FPS.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "it's back online and game should perform better now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
