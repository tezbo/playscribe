 "releases": [
  {
   "id": "cyber-shadow-116650@major-2021-02-06",
   "gameId": "cyber-shadow-116650",
   "displayName": "Update Notes for February 5th, 2021",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-02-06T01:09:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "v1.03",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some updates to address the more frequently communicated issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement: Apparitor now drops more Essence depending on your Essence level. This should help assist players needing to purchase items at nearby checkpoints to aid your adventure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement: Overall HP/SP rates have been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement: Bullets now get destroyed if they pass through Shadow while in i-frames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement: Adjustments in difficulty for Rust Fly Elevator in Chapter 2 and Chapter 7 areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement: Added flickering effect for items that expire",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement: You can now Dash after Airstriking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement: Allow parry when in i-frames",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Collecting a health item immediately before falling into a pit will keep you from dying",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Performing a Dash immediately after a no-SP Dash would result in a slow movement speed but Dash animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Dying on the same frame as Laserbrain makes the tri-key upgrade unobtainable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Incorrect syntax for “Press X to Start” in Spanish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Swag Blade was causing lanterns to get destroyed in the monkey race challenge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Special items could activate triggers in CyberDrive sequences",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: A cosmetic effect where Airstrike would appear to penetrate through a door",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: General level design improvements where you could sometimes move outside of the camera boundary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Apparitor’s name not translated during EXO encounter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: instances where the player could Dash-slash enemies that just transitioned into solids, allowing Shadow to pass through solids in some rare instances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Shadow could move out of bounds during the boat sequence after having destroyed the corrupted core",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Orbiter fixes to prevent orbiting orbs from getting stuck at expanded sizes (phew)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Issue with CRT filter where white values weren’t being clamped correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Content Build ID: 6198008",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
