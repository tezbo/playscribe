   "id": "ed-edda-grand-prix-racing-champions-346020@patch-2026-04-13",
   "gameId": "ed-edda-grand-prix-racing-champions-346020",
   "displayName": "The latest patch for Ed & Edda: GRAND PRIX – Racing Champions is here",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-13T08:28:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re excited to present the newest patch for Ed & Edda: GRAND PRIX – Racing Champions today.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update focuses on new vehicle designs for all eight main characters, along with additional vehicle colors that can be unlocked through new achievements. The drivers themselves also get new customization options: in the Accessories section, you’ll find new hats that are also tied to new achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition, the update expands the game’s music options. A number of brand-new music tracks, specially commissioned by Europa-Park, have been added. During race setup, you can now choose between individual tracks, the default music, or a special preset. In Grand Prix mode, the available options are Default and Special.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update is rounded out with various bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes at a glance",
     "items": [
      {
       "text": "New vehicle designs for the 8 main characters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New vehicle colors, unlockable through new achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New hats for drivers under Accessories, unlockable through new achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New music tracks added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "During race setup, you can now choose different music tracks, the Default music, or a Special preset (in Grand Prix mode, only Default and Special are available)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
