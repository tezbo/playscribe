   "id": "file-destined-235446@major-2023-03-04",
   "gameId": "file-destined-235446",
   "displayName": "Update Notes for March 5, 2023",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-04T22:12:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Widescreen monitors were causing the players to not be able to see the sticky note and stuck on the login page of main menu. We're now restricting the aspect ratio to 16:9 with black paddings only for the main menu to solve this problem. In-game viewport will not be affected by this change.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
