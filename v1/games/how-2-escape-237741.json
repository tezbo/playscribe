  {
   "id": "how-2-escape-237741@post-2025-03-11",
   "gameId": "how-2-escape-237741",
   "displayName": "New APK is live!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-11T12:27:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello escapers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is a small news related to our .apk file for the How 2 Escape Companion App. We've seen several comments mentioning that they had an issue with the .apk link, so we're glad to announce that everything is back to normal!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can get the \"How 2 Escape Free Companion App\" on our website through the .apk file or use the Google Play Store, App Store or Steam directly!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sorry for the inconvenience and see you soon in How 2 Escape!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PS: Stay tuned...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
