  {
   "id": "how-2-escape-237741@hotfix-2023-09-01",
   "gameId": "how-2-escape-237741",
   "displayName": "Hotfix 01/09/23",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-09-01T08:41:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're beyond happy to see your comments and feedback on the game !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our dev team has worked all night long (oops!) to fix your first feedbacks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Chinese localization has been updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Files has been re-organized to host Companion & Main Game on the paid version, so you can choose your role when you have purchased the game and you launch the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some bug fixes: Enjoy !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
