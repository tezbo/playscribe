  {
   "id": "how-2-escape-237741@post-2023-10-23",
   "gameId": "how-2-escape-237741",
   "displayName": "Patch Notes - 10/23/23",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-23T15:30:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello escapers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're working a lot to improve the game day after day!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As the rework of the chinese version is our biggest work for now, we have improved a few stuff. Don't forget to update your companion app and your main game to still get the right information!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Note",
     "items": [
      {
       "text": "Added version warning panel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added information about current version",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Machines Mendeleiev : machine failures are not random anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Machines Wires : fixed a bug that wrongly triggered success on the riddle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kitchen Nonograms : changed the riddle's setup so that it cannot be bruteforced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kitchen Recipes : in Chinese version, changed the riddle so that it does not involve French words",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Desk : lower music when focusing the radio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BF & JFG teams",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
