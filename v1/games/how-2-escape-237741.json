  {
   "id": "how-2-escape-237741@post-2023-09-11",
   "gameId": "how-2-escape-237741",
   "displayName": "Patch Notes - 09/12/23",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-09-11T15:40:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're working actively to fix all the latest feedbacks that you all have.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't hesitate to let a positive review to the game if you liked it, it helps us a lot ♥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Note - 09/12/23",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the bug that sometimes prevented accessing Locomotive's final riddle after entering the correct code when you played Locomotive for the 2nd time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a setting to disable visual distortions (when reaching the end of the room's timer)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved Desk's globe maneuverability when the globe is upside down",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Just For Games & Breakfirst teams",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
