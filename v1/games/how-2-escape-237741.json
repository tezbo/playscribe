   "id": "how-2-escape-237741@major-2025-08-08",
   "gameId": "how-2-escape-237741",
   "displayName": "Check out How 2 Escape: Lost Submarine’s Summer Update 🌊",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-08-08T16:00:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our new game, How 2 Escape: Lost Submarine, just got its first big patch — the Summer & Feedback Update! It’s packed with bug fixes, gameplay improvements, and new feedback systems to make your co-op escape smoother than ever.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "To celebrate",
     "items": [
      {
       "text": "If you haven’t tried Lost Submarine yet, now’s the perfect time to team up with a friend and see if you can escape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👉 Check out all the update details on the Lost Submarine page!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/3530680/How_2_Escape_Lost_Submarine/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
