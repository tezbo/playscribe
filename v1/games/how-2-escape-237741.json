  {
   "id": "how-2-escape-237741@major-2025-07-30",
   "gameId": "how-2-escape-237741",
   "displayName": "New Update – Improved Clue System",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-30T13:56:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just rolled out a small update to improve the clue system in How 2 Escape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Previously, players had to send keywords to their companion—but many mistook those keywords as the clues themselves, which led to confusion. To make things clearer, we’ve replaced the keywords with password-style codes (e.g., 785rkb).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This change should make it much easier to distinguish between the input and the actual clue, helping you focus on solving puzzles and enjoying the escape experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
