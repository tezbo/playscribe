 "releases": [
  {
   "id": "the-nameless-city-303312@1.2.0",
   "gameId": "the-nameless-city-303312",
   "displayName": "Update 1.2.0",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-12-16T12:51:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "When we started developing The Nameless City some years ago, gen AI images were a novelty. The generated images were a twisted amalgam of shapes that barely resembled what you prompted. That's why we had decided to use them in our game: to convey things that were outside the human comprehension.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, gen AI has made everything worse for (almost) everyone. Because of that (and many, many other problems), we feel it's kind of hypocritical to keep having those generated images in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's the reason why we are removing all the AI generated images from the game. They are similar to the old ones: an amalgam of different shapes, like the inhabitants of the original Lovecraft's story, but they are hand-drawn and they look much, much better! (They were drawn by Moisés, you can check his Instagram).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are also replacing the 'vision' videos, so there's 0% of gen AI in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
