  {
   "id": "love-too-easily-237569@major-2023-09-01",
   "gameId": "love-too-easily-237569",
   "displayName": "Update Regarding Streaming of ｢Love Too Easily｣",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-01T10:13:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, this is the Monster Guide Team!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would like to thank you all for streaming 「Love Too Easily」this past week!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As we've received feedback that the previously requested limit of 2 endings is too short, we've decided to revise our guidelines to allow up to 4 endings for a more enjoyable gaming experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are working hard to implement changes to the game based on the feedback we’ve received so far.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your continued support - thank you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "MonsterGuide Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
