    },
    {
     "title": "🌟New Features",
     "items": [
      {
       "text": "Added the ability to skip minigames: Each minigame requires a minimum of one playthrough, after which you can use the skip feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🌟Content Updates",
     "items": [
      {
       "text": "Modified the requirements for successfully presenting evidence: Previously, you needed to present 4 pieces of evidence, but with this update, you only need to present 3 pieces of evidence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Escape Room timeout duration: The timeout for Escape Room games has been adjusted to 10 minutes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🛠Bug Fixes",
     "items": [
      {
       "text": "Other minor bug fixes: We've fixed a number of minor bugs in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Monster Guide Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
