  {
   "id": "love-too-easily-237569@1",
   "gameId": "love-too-easily-237569",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-04T10:34:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, this is the Monster Guide Team!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Not only have we fixed the regional setting bug that results in a black start-up screen, we’ve also added in the skip function that had been requested!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🌟Added Features",
     "items": [
      {
       "text": "With the new update, you can return to your previous choices at any time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "After viewing at least one ending, you can skip the scene by pressing Tab.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Previously unskippable scenes, such as those involving evidence or branching of the story, are now skippable after watching for some time by pressing Tab.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🛠Bug Fixes",
     "items": [
      {
       "text": "An issue where specific regional settings prevented the game from launching.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Monster Guide Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
