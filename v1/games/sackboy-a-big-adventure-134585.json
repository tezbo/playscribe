  {
   "id": "sackboy-a-big-adventure-134585@patch-2023-01-11",
   "gameId": "sackboy-a-big-adventure-134585",
   "displayName": "Sackboy: A Big Adventure - January 11th Patch is Now Available",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-01-11T15:02:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are back from the winter holidays and have a new update for you all today that includes fixes for the Steam Keyboard on Steam Deck and the Off-Screen Indicator, along with some other minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "And in case you missed them... We even released a couple of special costumes over the holidays!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Year's Costume",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Monkey King Costume",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Both costumes are available for FREE download for Sackboy: A Big Adventure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So be sure to add them both to your collection!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Steven",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "The Steam Keyboard Can Now be Used to Rename Costumes on Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an Issue with the Off-Screen Indicator Not Always Disappearing in Online Games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "General Bug Fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
