  {
   "id": "sackboy-a-big-adventure-134585@patch-2022-11-09",
   "gameId": "sackboy-a-big-adventure-134585",
   "displayName": "Sackboy: A Big Adventure - November 9th Patch is Now Available",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-11-09T16:48:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are absolutely thrilled to see so many new faces joining Sackboy and the rest of the community on Craftworld!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Releasing Sackboy: A Big Adventure on PC is a big leap for us and we just wanted to say that we are sincerely grateful for all of your reviews, feedback and reports that you have posted so far.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Our team have been monitoring your feedback since launch and we are continuing to work on patch updates that will look to address reported issues and bring exciting new Costume & Emote content to Sackboy: A Big Adventure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Below you will find a short summary of the main updates included in the November 9th patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you again for all of your feedback so far and we cannot wait to see your Sackfolk dressing up as Kratos, Atreus and Freya on Craftworld!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Steven",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Added God of War: Ragnarök Costume & Emote DLC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Stutters Relating to Shader Compilation",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "General Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
