  {
   "id": "sackboy-a-big-adventure-134585@patch-2022-12-02",
   "gameId": "sackboy-a-big-adventure-134585",
   "displayName": "Sackboy: A Big Adventure - December 2nd Patch is Now Available",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-12-02T11:01:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another set of patch notes! And another introductory blurb that you're going to skip straight by to find out what we actually changed in this update! How are you though? Are you having a nice week?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Back to the business of patch noting though... This update includes some additional performance and functionality fixes for issues reported by the community, alongside some other general bug fixes to improve your overall Sackboy PC experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Steven",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Fixed An Issue Where Particle Effects Would Stopped Appearing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Performance Icon in the Pause Menu Now Updates Accurately",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an Issue Where FPS Options Would Revert Incorrectly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved Functionality on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Other General Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
