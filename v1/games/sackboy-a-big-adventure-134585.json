  {
   "id": "sackboy-a-big-adventure-134585@patch-2023-03-22",
   "gameId": "sackboy-a-big-adventure-134585",
   "displayName": "Sackboy: A Big Adventure - March 22nd Patch is Now Available!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-22T15:21:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since our previous update at the end of last week, we have become aware of a number of players encountering performance issues from a couple of new graphical additions to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To help resolve this issue, we have added some new toggles within the Graphics settings that will allow you to further customise your experience by enabling or disabling these graphics options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upon installing this update, these new settings will be disabled by default, so if you have been running into performance issues since the previous update, then installing this new update should automatically resolve those issues for you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We apologise for any issues that you may have encountered since last Thursday's update and appreciate you all taking the time to comment with your issues and feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update should hopefully address those issues and we will continue to monitor the discussion forums for any further feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steven: PATCH NOTES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Two New Options Within Graphics Settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "DLSS Frame Generation",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "NVIDIA Reflex: Note: DLSS Frame Generation is Only Available While in Single Player: Enabling 'DLSS Frame Generation' will disable 'NVIDIA Reflex', 'VSync' and 'Framerate Limit'.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
