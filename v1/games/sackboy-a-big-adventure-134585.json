  {
   "id": "sackboy-a-big-adventure-134585@patch-2022-11-25",
   "gameId": "sackboy-a-big-adventure-134585",
   "displayName": "Sackboy: A Big Adventure - November 25th Patch is Now Available",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-11-25T10:05:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another update? Already?! What is this madness awesomeness!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's right! We have another update for you today that looks to further reduce the stutter that some of you have been experiencing when playing Sackboy: A Big Adventure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update also introduces Improved FPS Cap Options and includes some more general bug fixes to improve the overall performance and stability of your big adventure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Steven",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Further Stutter Reduction from Shader Compilation",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved FPS Cap Options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
