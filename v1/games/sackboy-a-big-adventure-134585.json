  {
   "id": "sackboy-a-big-adventure-134585@patch-2023-01-19",
   "gameId": "sackboy-a-big-adventure-134585",
   "displayName": "Sackboy: A Big Adventure - January 19th Patch is Now Available",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-01-19T15:12:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have a new update today that looks to address the issue of the DualSense haptics not working for secondary players and this update also includes an additional UI fix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And be sure to keep a look out this weekend for our new Chinese New Year Costume releasing for Sackboy: A Big Adventure on January 22nd - It's the return of an old favourite that some of you may even recognise!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steven",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Fixed Issue with DualSense Haptics Not Working for Secondary Players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Issue with Parts of the UI Remaining Visible When Entering the Licence Screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
