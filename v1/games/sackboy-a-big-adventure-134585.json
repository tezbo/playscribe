  {
   "id": "sackboy-a-big-adventure-134585@patch-2023-03-16",
   "gameId": "sackboy-a-big-adventure-134585",
   "displayName": "Sackboy: A Big Adventure - March 16th Patch is Now Available!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-16T15:01:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We bring a new update to you today to add support for DLSS 3 and Shader Execution Reordering for NVIDIA 40 Series Graphics Cards - If you have a supported graphic card and would like to enable this feature, we have included some instructions below on how to do this.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "This update also includes some fixes for Sackboy rolling animations, Travel Pod usage and a fix for UI pop-ups showing up when in the loading screen. Those pesky pop ups huh?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Last week we also released the Casual Clothing Pack, the first of our brand-new mixed clothing packs coming to Craftworld.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This pack is a free download and contains an assortment of jackets, jumpers, jeans, boots, piercings, and more... So download it today and give yourself a fabulous makeover to show off to your friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steven: PATCH NOTES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added in Support for DLSS3 and Shader Execution Reordering for NVIDIA 40 Series Graphics Cards",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Sackboy Rolling Animation Getting Stuck in Certain Places",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Sackboy Getting Stuck in the Travel Pod if a Secondary Player Leaves the Game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed UI Pop-ups Showing Up When in the Loading Screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "HOW TO ENABLE NVIDIA DLSS 3",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Windows 11",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Enabled by Default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Windows 10",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "On the desktop, pressed the Windows Key or go to Start.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Type 'Graphics settings'.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select the Graphics setting option when it pops up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Toggle \"Hardware-accelerated GPU scheduling\" to \"On\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restart your PC to enable changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
