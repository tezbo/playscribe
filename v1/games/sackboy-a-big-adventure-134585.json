  {
   "id": "sackboy-a-big-adventure-134585@patch-2023-03-30",
   "gameId": "sackboy-a-big-adventure-134585",
   "displayName": "Sackboy: A Big Adventure - March 30th Patch is Now Available!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-30T09:33:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have another update today that includes further improvements to the NVIDIA Reflex and DLSS Frame Generation settings that were added in last two updates.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "This update also includes a couple of additional fixings for a known crash issue and to prevent Sackboy being all spooky and turning invisible in the costume select screen... Scarlet would say that it's very unbecoming for a Knitted Knight to pretend to be a ghost!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steven: PATCH NOTES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Further Improvements to the NVIDIA Reflex and DLSS Frame Generation UI",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Default Sackboy Remaining Invisible in the Costume Select Screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a Crash When Swapping Controller and Entering the Graphics Settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
