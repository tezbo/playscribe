  {
   "id": "sackboy-a-big-adventure-134585@patch-2022-11-21",
   "gameId": "sackboy-a-big-adventure-134585",
   "displayName": "Sackboy: A Big Adventure - November 21st Patch is Now Available",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-11-21T15:02:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hot on the heels of our last update, we have another update today with a number of new fixes and improvements based on your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for all of the feedback that you have shared with us so far, we really appreciate everyone that has taken the time to post their experiences with Sackboy: A Big Adventure in your reviews and discussion threads.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are also pleased to release the new Sackboy Football Costume & Emote today, which can now be downloaded for FREE from our Steam DLC Page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our team will continue to monitor your feedback and we look forward to seeing all of your Sackfolk wearing their new Football Costume in your favourite team colours!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Steven",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Added Football Costume & Emote DLC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved Experience on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Prevent Game from Launching Unused Oculus VR Software",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
