   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-09-09T08:42:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Riders, today we've released a patch to the game on Steam which includes some perfomance updates, and a range of different issues found by the community. Thank you for your continued support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "GFX",
     "items": [
      {
       "text": "Tracks: improvements and polishing on lighting, evolving track, tarmac, kerbs, terrain, crowd and sponsors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bikes: multiple fixes and polishing updates on components, bikes, bikes cockpit and liveries.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Raised the quality of Screen Space Reflection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "UI",
     "items": [
      {
       "text": "Updated map icons colours for better readability on: Player, AI, Ghost Player, Ghost downloaded from Online Leaderboard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tuning fix for condition % colour of components consumption.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "AUDIO",
     "items": [
      {
       "text": "Control bar updates: sound fixes and new actions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "DLC",
     "items": [
      {
       "text": "Multiple fixes on DLC content and behaviour.: ##: GENERAL FIXES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General performance improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved game stability due to some crash fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New yellow key for MBM for components that must be mounted before race.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "AI mass center optimization.",
       "ps5ProOnly": false,
       "pcOnly": false,
