      {
       "text": "Fixed several achievements descriptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improvements and fixes on controls configuration:",
       "ps5ProOnly": false,
