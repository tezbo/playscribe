  {
   "id": "rims-racing-135668@patch-2021-10-15",
   "gameId": "rims-racing-135668",
   "displayName": "Major Patch - Free Game Upgrade",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-10-15T14:06:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Riders, we've been very busy attacking this next update for you. So busy, we did not even have time to think of a name. So here's your 'Free Game Upgrade'. As well as all the previous hotfixes and patches we've brought you, we've also been working on this extra content - as requested by the community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope this shows our commitment and dedication to the game and our lovely fans. Have a look below and let us know what you think.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "FEATURES",
     "items": [
      {
       "text": "Motorbikes career customization now available in Single Race, Online Custom Events, Private Testing and Offline Duel (only Player1).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Multiplayer spectator mode update: now featuring new pages with MSC and a Map to follow Riders.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a test mode in career to try new mounted components.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Night mode for all road tracks now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Online Leaderboards in Private Testing now based on: Track, Asphalt Condition (Dry/Wet) and Physics Simulation Level (Beginner, Intermediate, Realistic)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "IMPROVEMENTS",
     "items": [
      {
       "text": "AI behaviours, including obstacle avoidance, improved. AI perfomance in Career improved, now more challenging and engaging.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Audio for custom exhausts has been enhanced, several new UI audio effects added, bugfixes and mix improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "It is now possible to Restart a Calendar Event on any Difficulty Level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "EXTRA",
     "items": [
      {
       "text": "PC Crossplay has been enabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
