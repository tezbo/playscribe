  {
   "id": "rims-racing-135668@496.76",
   "gameId": "rims-racing-135668",
   "displayName": "Update 496.76",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-11-17T11:30:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "For the last month we've been having intermittent issues with Nvidia Drivers. We've been working directly with Nvidia, and released a manual hot fix for the problem.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We are happy to announce that with the most recent 'game ready' driver - released 16/11/2021 - automatically includes this fix. So we'd like to encourage you all to update your Nvidia drivers and jump back into the game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We'd like to take a moment to thank members of the community who alerted us to this issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The timing of this issue fell right into a pre-arranged demo period - resulting and a wave of negative reviews on Steam. We're dedicated to answering these complaints, and hope the actions taken with Nvidia will restore some faith. AND we're working with our publishing team to arrange another free demo period for all those that missed out.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We apologise for this and hope we can see you back in RiMS Racing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
