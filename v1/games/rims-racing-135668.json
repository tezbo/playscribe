  {
   "id": "rims-racing-135668@major-2022-03-18",
   "gameId": "rims-racing-135668",
   "displayName": "Esports Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-03-18T11:16:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new round of our Esports competition 'The Worlds Fastest Motorcycle Gamer' in partnership with Init Esports has seen some fierce times at the top of the leaderboard.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's the standings after 2 rounds",
     "items": [
      {
       "text": "We head to the infamous Million Dollar Highway for round 3, and it's at night!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Set a time and see where you finish racing against the best - Multiplayer - Online Challenges",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can find more information about the Init Esports Competition here: https://initesports.gg/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
