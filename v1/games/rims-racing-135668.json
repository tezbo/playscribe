  {
   "id": "rims-racing-135668@1.3",
   "gameId": "rims-racing-135668",
   "displayName": "Patch 1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-09-21T09:34:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Welcome back riders to another quick patch and update for RiMS Racing! We're continuing to improve the game where possible, and with your fantastic feedback. We have some bigger, more exciting changes coming soon. But for now we're here with some more improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "UPDATES",
     "items": [
      {
       "text": "\"Hide\" function added in order to improved Inventory/Shop readability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI performances optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved icon readability in the Motorbike Mechanics section",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved HUD minimap colours",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved discount manager perk efficiency",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "BUG FIXES",
     "items": [
      {
       "text": "Autosaves logic has been reorganized in order to prevent save corruption issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "R&D Management objectives are now reset correctly after a Career restart",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed icon on Private Testing leaderboards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Audio memory usage optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed \"The Star\" description and unlock logic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Custom joypad presets are now working as intended after booting the game",
