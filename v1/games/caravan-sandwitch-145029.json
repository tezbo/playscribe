    {
     "title": "Additions/Improvements",
     "items": [
      {
       "text": "Added controller symbol selection setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved clarity of objectives for all \"Receptacle quests.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced level art around the jammer in the Croaking Forest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Major Fixes",
     "items": [
      {
       "text": "Fixed save restoration issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed game freeze when opening the pause menu after making the final choice in the end sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed \"Baie quest\" not marked as completed when loading a save file if vehicle parts were collected before starting the quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed \"Lamarr quest\" not triggering properly if the robots in the Refuge are met in the last chapter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed \"Curry quest\" becoming unfinishable if the Nomad Door sequence isn't completed first.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where loading a save during the game's ending would revert progress to the point of no return.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bridge button to access the wind turbine transformer top being non-interactive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Medium Fixes",
     "items": [
      {
       "text": "Fixed relays in Nefle Hub.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed interaction conditions with relay levers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed \"Lamarr quest\" not closing properly if missed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the final quest thread before the ending not pointing to talking with Rose.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Minor Fixes",
     "items": [
      {
       "text": "Fixed oversized text in the Station.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed an unintended gray wall in the first room of the Station.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed invisible collision on a container in the Docks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed all archived quest threads showing as time-limited.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the color of scrap objective text to black for better readability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated Receptacle toaster quest images to match the new relay appearance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you have any ideas or suggestions, don't hesitate to share them with us on the Steam Community Hub or the official Caravan SandWitch Discord!",
