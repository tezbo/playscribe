       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix infinite loading screen if game was exited during zipline tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix energy relays beams not spawned when far away from source",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix could go back to last receptacle after completion",
