   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Villagers of Cigalo,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your support all along the way. We've been collecting your feedback and bug reports on Steam & Discord, and we're doing our best to investigate and fix them!",
       "ps5ProOnly": false,
