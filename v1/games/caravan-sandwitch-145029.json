       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Make relays levers interactable only when the linked receptacle quest is started",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Make Turing repeat where to put consciousness if user has forgotten",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Update credits to disable pause menu, it can now be closed by holding the skip button",
