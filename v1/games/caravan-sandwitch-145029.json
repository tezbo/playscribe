  {
   "id": "caravan-sandwitch-145029@3",
   "gameId": "caravan-sandwitch-145029",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-27T15:03:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello vagabond friends,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Watch the trailer to discover the many inspirations that brought this vibrant world to life, and let it spark your creativity for those perfect shots. Grab your cameras and let’s hit the Van! ☀️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We greatly appreciate your continued support. We've been gathering your feedback and bug reports from Steam and Discord, and we're working hard to investigate and resolve them!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Additions/Improvements",
     "items": [
      {
       "text": "Added Photo Mode to unleash your inner photographer!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Major Fixes",
     "items": [
      {
       "text": "Fixed a crash occurring when starting the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Cepe's quest taxi spline not being visible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Medium Fixes",
     "items": [
      {
       "text": "Fixed the community service achievement not unlocking for some users.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Minor Fixes",
     "items": [
      {
       "text": "Fixed issues with French text translation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the word \"Quoi?\" not being translated when speaking to Nefle during the Aqueduct setup sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed translation of the Nomad Seeds item name.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the tomb door in Lamarr's quest disappearing after changing chapters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some door names not being translated when using the antenna scanner.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you have any ideas or suggestions, don't hesitate to share them with us on the Steam Community Hub or the official Caravan SandWitch Discord!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
