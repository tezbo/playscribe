  {
   "id": "kingdom-shell-122713@1.010",
   "gameId": "kingdom-shell-122713",
   "displayName": "Update 1.010",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-13T10:11:36.000Z",
   "notes": [
    {
     "title": "This is not a small update",
     "items": [
      {
       "text": "Spanish language added. It was a challenging task as there were queries to the translators. Apologies for the delay in localization; I hope the translation is of high quality (players will provide feedback:)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the ability to toggle V-Sync in the settings. I hope this helps players who have experienced FPS drop issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Minor fixes and visual changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
