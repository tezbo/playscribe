  {
   "id": "kingdom-shell-122713@1.013",
   "gameId": "kingdom-shell-122713",
   "displayName": "Update 1.013",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-28T15:14:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello to all residents of the Kingdom.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this update, I've added the option to skip the shoot'em up section. After a few unsuccessful attempts, Hermes will suggest the player dispel the illusion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I initially introduced the shoot'em up section to diversify gameplay and provide players with a break from platforming. However, I've noticed that some players are having difficulties with this level, and others simply don't enjoy this genre. Therefore, I've added the option to choose. After all, Kingdom Shell is a metroidvania.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
