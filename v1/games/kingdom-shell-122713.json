  {
   "id": "kingdom-shell-122713@major-2024-03-03",
   "gameId": "kingdom-shell-122713",
   "displayName": "Graphics update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-03T17:44:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I've prepared a huge graphics update for Metroidvania Fusion event. As promised earlier, I completely redesigned the White Rocks location. I hope the White Rocks can tell more about their story now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For those who are already playing Kingdom Shell, please don't be alarmed by such a visual update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
