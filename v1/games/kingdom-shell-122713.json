  {
   "id": "kingdom-shell-122713@1.007",
   "gameId": "kingdom-shell-122713",
   "displayName": "Update 1.007",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-14T09:12:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Increased the time between the attack warning and the actual attack for the Lurker boss (Bulldozer in the Caves).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made Top City and Royal Palace more player-friendly, thus balancing the difficulty curve.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the duration of negative status effects, such as blindness and dizziness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The \"Sustainability\" inspiration now decreases damage from many traps, not just pits and spikes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
