  {
   "id": "anime-vs-evil-apocalypse-238081@4.1",
   "gameId": "anime-vs-evil-apocalypse-238081",
   "displayName": "Update 4.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-16T18:02:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "I just uploaded the update with the following fixes",
     "items": [
      {
       "text": "Fixed sniper zoom when switching weapons/triggering an action window",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved zombies AI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved dragon bosses AI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Now you can start shooting/attack right from the sprint (this is mostly helping with the melee weapons)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Level task highlight color is matching the minimap icon color",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bonus spawn chance increased to 60%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed fire mage hit detection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed playback of zombie sounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed reaper speed in easy mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The duration of the explosive ammo bonus has been increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
