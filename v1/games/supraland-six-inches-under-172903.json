  {
   "id": "supraland-six-inches-under-172903@1.1.5485",
   "gameId": "supraland-six-inches-under-172903",
   "displayName": "Update 1.1.5485",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-01-31T23:38:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "There's a lot of new stuff in here by request from players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added text speed option (speech bubbles can now be quicker or slower) 💬",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added difficulty setting (besides the normal setting, you can make enemies not damage you at all, damage you very little or damage you twice as much) 👾",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added skip option to credits scene if you've seen it before (Jump) ⏩",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added dual-input-support option to key bindings options (allows you to use keyboard and controller at the same time) 🕹️",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added new puzzle and cave to endgame area ➕",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added two new major upgrades to the endgame area (one in a previously out of bounds area where you couldn't find anything, one in the new cave) 🌟",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added hint speaker to 3-purple-rings puzzle and improved puzzle geometry 🟣",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed the way the elastic beam works (not requiring stomp anymore; holding crouch button while landing on it prevents bouncing)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some invisible wall situations in endgame area 🪟 🧱",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed hot metal ball damaging enemies properly ⚪:hot:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bunch of softlocks 🔒",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed color rings to work properly with low FPS 👍🏻",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed upgrade pickups to no longer tank FPS when they are on screen 🎞️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed 'TAB' button disabling your movement controls ⌨️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed two achievements not always triggering (Battery and Play With Fire) 🔋 🔥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Detectors will now be less confusing (people thought they had the chest detector but didn't really: + A whole lot of other little fixes and improvements everywhere ❤️: This is the last planned major update for Six Inches Under.: We'll still be doing hot-fixes if/when important bugs show up.: Supra development is switching over to Supraworld today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
