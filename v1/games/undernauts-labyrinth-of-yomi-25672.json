  {
   "id": "undernauts-labyrinth-of-yomi-25672@patch-2022-02-09",
   "gameId": "undernauts-labyrinth-of-yomi-25672",
   "displayName": "Feb 9th Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-02-09T16:43:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Changes in EN/JP Builds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected text alignment in logs and help menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various controller and keyboard glyph corrections.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "While Windows 7 is not an officially supported platform (see Minimum Requirements on the Store Page), we fixed an issue where end of credits would freeze for Windows 7 users. In essence, Windows 7 can't handle h264 encoding, so the solution was to use vp8 encoding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changes in EN Build",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quest Logs now detail full history of quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope our Windows 7 users are able to enjoy the game without further issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
