  {
   "id": "naruto-x-boruto-ultimate-ninja-storm-connections-239385@1.11",
   "gameId": "naruto-x-boruto-ultimate-ninja-storm-connections-239385",
   "displayName": "Patch 1.11",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-01-24T08:36:19.000Z",
   "notes": [
    {
     "title": "Thank you for playing NARUTO X BORUTO Ultimate Ninja STORM CONNECTIONS.",
     "items": [
      {
       "text": "A patch has been released, please see the following for the details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "DLC Pack 1",
     "items": [
      {
       "text": "Playable Character \"Hagoromo Otsutsuki\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Combination Secret Technique \"Source of Ninshu\" (Hagoromo Otsutsuki x Indra Otsutsuki x Ashura Otsutsuki)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Matching Voice x12",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ninja Info Card Image x5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*The content above is available for players who have purchased DLC Pack 1 or the Season Pass, which includes of DLC Packs 1 - 5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*DLC Pack 1 is planned to be released on January 25, 2024. Release date/time may differ depending on region.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Custom Matchmaking",
     "items": [
      {
       "text": "Custom matchmaking has been implemented and allows a user to create a room for up to 8 designated players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Users can now participate in the following modes for custom matches:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "VS Battle (2 players)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "League (4 players)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tournament (4-8 players)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Others",
     "items": [
      {
       "text": "Other bug fixes and adjustments have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Future patch updates are planned to include the \"Ninja Battle\" in-game event, balance adjustments, and DLC Packs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
