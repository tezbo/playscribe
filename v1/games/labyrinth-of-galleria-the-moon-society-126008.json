  {
   "id": "labyrinth-of-galleria-the-moon-society-126008@major-2023-03-03",
   "gameId": "labyrinth-of-galleria-the-moon-society-126008",
   "displayName": "Update - 2023-03-03",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-03T23:01:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we have a new minor update to address stability issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's what we've addressed since launch",
     "items": [
      {
       "text": "Fix for no audio for some players. Game should properly use xaudio2_9redist.dll on systems on older Windows 10/11 releases.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for the game selecting an unexpected GPU by default for some players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "On Windows 10 1803 and later, the game should select the GPU in this order:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "external GPUs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "discrete GPUs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "internal GPUs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For older versions, the game should select the GPU by the one with the highest amount of dedicated RAM.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In any other case, it will fall back to the original method, based on default initialization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes for crashes related to Alt+Tab and other scenarios in or related to Full Screen mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please report any issues in our Troubleshooting forum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
