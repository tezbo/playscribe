   "id": "redacted-292844@1.0.0.5",
   "gameId": "redacted-292844",
   "displayName": "Patch 1.0.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-19T18:14:22.000Z",
   "notes": [
    {
     "title": "NEW FEATURES",
     "items": [
      {
       "text": "Added support for PlayStation gamepad icons on PC & Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "ps5",
        "pc"
       ]
      }
     ]
    },
    {
     "title": "GAMEPLAY",
     "items": [
      {
       "text": "Fixed an issue where some combinations of items would cause healing to damage the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where weapon upgrades were not applying when equipping from the kiosk.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where a rival could be damaged before an intro sequence was completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue with the last corpse failing to spawn in a specific room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue at the end of the Watcher Run where the guard wasn’t wearing the correct suit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue for unexpected game closures during the Watcher Run, allowing players to resume progress without resetting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted camera behavior to prevent continuing a run when a rival escapes if a door is entered at the end of the timer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted arrow color, size, and positioning for gas pipe indicators to improve visibility, especially on Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue that made the ATOM fire when aiming and pressing the melee attack button on a controller while using the alternative control scheme.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with Lights Out Experiment (RoF) showing incorrect values.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed certain experiment descriptions displaying at level 0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various crash fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "GENERAL",
     "items": [
      {
       "text": "Improved camera smoothness during dashing and aiming at 30 FPS to prevent camera jumps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ensured rival subtitles appear over the death screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Addressed an issue where music would incorrectly play if no corpse spawned in the room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where Steam Deck users would see incorrect tooltips when hovering items in the Pause Menu.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed visual issues with ground decals rendering on top of geometry for specific attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved issue where rivals could appear squished on the 2D full-body character art.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "PC",
     "items": [
      {
       "text": "Corrected behavior of the escape key in kiosks to prevent unintended pauses on PC.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "EXPERIMENT TUNING",
     "items": [
      {
       "text": "Adjusted multiple experiment abilities across Physical, Combustion, Cryo, Energy, Biotech, Gravity, and Science categories, enhancing damage, effect durations, area of effect, and status effect chances to improve overall gameplay balance and effectiveness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
