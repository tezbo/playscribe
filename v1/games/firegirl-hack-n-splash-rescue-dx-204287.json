  {
   "id": "firegirl-hack-n-splash-rescue-dx-204287@major-2022-01-04",
   "gameId": "firegirl-hack-n-splash-rescue-dx-204287",
   "displayName": "Fourth Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-01-04T14:08:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New year, new updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "For this particular update I decided to focus on making the whole income system more predictable, less arcane and also more rewarding for all players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Tweaks and bug fixes",
     "items": [
      {
       "text": "Tweaked hose water collision to prevent unwanted collisions with debris",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that made a few exits spawn closed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Water now refills faster when running out of pressure and the auto refill upgrade has been purchased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Medals 10 and 12 have been fixed and are now accessible to all players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a fire tome spawning bug in the apartments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed certain sounds not being affected by audio settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Income update",
     "items": [
      {
       "text": "Fan donation isn’t random anymore. It is now double the fan count (before upgrades).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vinny’s upgrade for city fund negotiation is now way more effective (+25% per level instead of +5%)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kareem’s infirmary upgrade is now more effective (+10% per level instead of +5%)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Price scaling of several upgrades has been revised",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added more detail to the mission report screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We have more updates and new content coming soon, keep the feedback coming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Julien",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
