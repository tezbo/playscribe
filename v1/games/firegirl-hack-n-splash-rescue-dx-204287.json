  {
   "id": "firegirl-hack-n-splash-rescue-dx-204287@major-2021-12-16",
   "gameId": "firegirl-hack-n-splash-rescue-dx-204287",
   "displayName": "First Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-12-16T09:34:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Julien here, I'm the game's programmer and half of Dejima.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been reading your comments and reviews, we're listening to your feedback and we're determined to keep improving the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Based on the feedback we received, we've already started making changes which brings us to this first update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Version 1.021 Patch notes",
     "items": [
      {
       "text": "Reworked mouse aiming from the ground up. We added a reticle and made the controls one to one for snappier and smoother mouse aiming.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed several issues concerning settings not saving properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Modified some enemies to improve their visibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made several enemy death animations faster. It is now more apparent when a fire has been put out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various stability fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'd love to hear what you think of the new mouse controls. Let us know in the comments below or on the game's community hub!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you for playing, stay tuned for more updates and new features!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Julien",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
