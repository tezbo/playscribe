  {
   "id": "firegirl-hack-n-splash-rescue-dx-204287@major-2021-12-21",
   "gameId": "firegirl-hack-n-splash-rescue-dx-204287",
   "displayName": "Third Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-12-21T08:11:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Julien here, time for an update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve got more fixes, tweaks and improvements thanks to your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This time I tried to break down the patch notes in categories to improve readability:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features and Improvements",
     "items": [
      {
       "text": "Rewrote the fire tome placement code. Fire tomes will appear sooner in the levels. We will add a UI notification when a fire tome is in proximity at a later date (when the localization company we work with comes back from holiday break)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rewrote the level exit spawning code from the ground up. Exits won’t be available from the start anymore and way more exits will be spawned once all the survivors have been rescued.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved enemy spawning in the run-down apartments and the train levels. Certain encounters have been rebuilt from the ground up to facilitate platforming in some sections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed the hose automatically shooting to the left when no direction is pushed on the stick (controller only)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a firechief sprite talking animation where his eyepatch had mysteriously disappeared",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare bug that prevented extinguished enemies or clocks to give time under some very specific circumstances",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where items behind rubble disappeared when the rubble got destroyed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that made walking enemies spawn behind doors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Toned down the upward force of the knockback when getting hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed confusing background flames in the forest level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Please let us know what you think of those changes in the comments below or on the game's community hub!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "We have more updates coming based on your feedback and fresh (hot?) new content is also on the way!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Julien",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
