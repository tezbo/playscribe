  {
   "id": "firegirl-hack-n-splash-rescue-dx-204287@major-2022-06-22",
   "gameId": "firegirl-hack-n-splash-rescue-dx-204287",
   "displayName": "DX update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-22T15:03:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we are launching the DX version of Firegirl! The good news is that you already own it if you purchased Firegirl before!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's how we are updating the current build to the DX build:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed enemy placement issues in the forest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a certain big enemy's collisions in its second encounter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed spelling mistakes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Improved performance. We worked on and updated parts of our rendering pipeline. There should be performance improvements but this is highly dependent on hardware.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved stability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New features",
     "items": [
      {
       "text": "Steam Deck compatibility. Firegirl is now playable on Steam Deck! Please let us know how it plays in the community hub!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Steam achievements. We added 21 Steam achievements. Almost all of them are retroactive so they should unlock as you load your previous save!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please let us know what you think of the \"DeluXe\" edition of the game and have a nice achievement hunt!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "As always, thanks for playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Julien",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
