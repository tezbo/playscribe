  {
   "id": "firegirl-hack-n-splash-rescue-dx-204287@major-2021-10-03",
   "gameId": "firegirl-hack-n-splash-rescue-dx-204287",
   "displayName": "Steam Next demo: fire hose update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-10-03T22:02:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks to community feedback, several bugs were found concerning the mouse aiming in the Steam Next demo. I also added a new hose feature that should also solve a few issues.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Here's what I've updated in the demo",
     "items": [
      {
       "text": "mouse aiming should more precise and stable",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "no more game freezes when playing with mouse and keyboard",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "hose water will now push debris. Fire monsters won't be able to hide behind planks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, all feedback is welcome!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
