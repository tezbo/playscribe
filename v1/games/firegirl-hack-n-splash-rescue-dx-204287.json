  {
   "id": "firegirl-hack-n-splash-rescue-dx-204287@major-2021-12-17",
   "gameId": "firegirl-hack-n-splash-rescue-dx-204287",
   "displayName": "Second Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-12-17T17:34:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone, it’s Julien again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve been listening to more of your feedback and are back with another update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The tweaks and fixes in question are mostly about gameplay this time!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Version 1.022 Patch notes",
     "items": [
      {
       "text": "Train cars move much slower when separating",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Debris from piles disappear after getting hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the axe collision to increase the reach and make the jump attacks more effective",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made shooting with the hose snappier (controller only)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaked water refill spawn code",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Water refills refill more water",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the bug where the hose water stream would start shooting up when colliding with nearby debris",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaked enemy collisions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the HP of several flying enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Extinguishing enemies is generally slightly faster",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Certain enemies now give 2 or 3 seconds when extinguished instead of 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reworked the difficulty progression from the ground up. The game will now unlock missions with more survivors to rescue only if you have been successful at that particular type of mission. For that reason, players that are already far into the game will encounter a few easy one survivor missions before getting back to missions more suited to them. Story and upgrade progressions won’t be affected at all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Please let us know what you think of those changes in the comments below or on the game's community hub!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again for playing, next update will be about level generation tweaks and enemy spawning improvements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Julien",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
