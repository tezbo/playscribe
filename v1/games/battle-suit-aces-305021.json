  {
   "id": "battle-suit-aces-305021@2025.10.17",
   "gameId": "battle-suit-aces-305021",
   "displayName": "Patch 2025.10.17",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-17T20:41:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Aces! We just pushed another patch to keep the Battle Suits flying and the playthroughs flowing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now change your playthrough's Difficulty after starting it. Please note that the easiest difficulty you've played on is what's used for end-of-game achievement unlocks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug with achievements that cannot be completed in a single playthrough: You've Got a Friend in Me, We're Going To Need a Bigger Boat, and Personal Projects. These will now unlock automatically upon opening the game if you've already completed their conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Grant game-completion unlocks for lower difficulties than the one you beat it on. These will be re-evaluated upon opening the game for players who already beat it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a a Bounty issue that resulted in the same Faction always being the first/easier option until players meet a third Faction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dialogue Skip will now speed up or jump past more cutscene segments, like establishing shots and fades.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hold Dialogue Skip's button down to zoom through all dialogue. It will stop when there's a choice to make.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Drafting's Redraw and Skip buttons now have hotkeys.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made the in-game bug reporting process a little easier by placing screenshots alongside the log and linking to that folder.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Onward we go! If you'd like to suggest more fixes or changes, join us on Discord!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45050909/c8a9da6b3a94cc746ccd0f0aed6e730f813550ac.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
