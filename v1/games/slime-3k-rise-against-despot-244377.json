  {
   "id": "slime-3k-rise-against-despot-244377@patch-2023-11-06",
   "gameId": "slime-3k-rise-against-despot-244377",
   "displayName": "Patch: A New Starter Slime: Financial 💵 New Meta Upgrades, More XP for Runs",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-11-06T19:54:59.000Z",
   "notes": [
    {
     "title": "PATCH 0.5.7",
     "items": [
      {
       "text": "Adjusted how experience points are awarded for unlocking new ability cards. More experience is issued for failed runs. Example: If previously killing a late-stage monster (like Killer Tomato, for instance) used to give you 50 times more points than taking down a basic swordsman, now this discrepancy has been significantly decreased. Additionally, experience points are now individually adjusted for each level, with more challenging levels giving more experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added 2 seconds of invulnerability after picking up a Gumball Machine (the explosive pick-up.) It should now be more useful on the latter levels of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A new starter Slime condition: \"Financial.\" Starts with 20 tokens and Coin Launcher.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2 new meta-upgrades that can be purchased with DNA points: bonus starting tokens (store currency) and a store upgrade discount.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buffed all starter Slime conditions except \"Default\" and \"Ocular.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Made minor balance adjustments to some levels. For instance, the start of Level 10 became harder.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Currently working on 🎮 gamepad support as the highest priority task!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Planning less frequent updates, approximately once a month, with more significant features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep your feedback coming—we're actively listening and working on improving the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "HAIL SLIME.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
