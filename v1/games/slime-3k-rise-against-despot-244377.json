  {
   "id": "slime-3k-rise-against-despot-244377@1.0.5",
   "gameId": "slime-3k-rise-against-despot-244377",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-08T17:21:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Level 6 has been nerfed. If it’s still too challenging for you, try experimenting with different ability cards, meta upgrades, and play styles. It’s difficult but definitely beatable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the number of arachnids summoned by other arachnids. But you probably won’t notice much difference.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added two key shortcuts for the shop: now, double-clicking the left mouse button buys the hovered ability card, and right-clicking a card locks it.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added an option in the settings to enable/disable dead bodies of enemies. If you're experiencing performance issues, try turning this off. It's on by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made some minor changes that should also improve performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
