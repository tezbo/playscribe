   "id": "hotline-miami-2-wrong-number-2126@post-2016-06-22",
   "gameId": "hotline-miami-2-wrong-number-2126",
   "displayName": "Hotline Miami 2 Level Editor Leaves Beta, Now Live",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2016-06-22T13:02:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today's update includes the Hotline Miami 2 level editor as well as a number of other minor fixes and changes. Please see the Patch Notes in the Level Editor forum for the full changelist.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you experience any issues with this latest update, please report them in the pinned Bug Report Thread in the Level Editor forum. Additionally; should the latest update cause serious new issues on your machine, we have also set the previous build (v1.05) live on the 'no_editor' branch. Use that to opt-out of the editor update while we look for a solution to the problem.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you so much for your patience and help over the extended development of the level editor. Without your passion, help, and feedback this would not have been possible. Now please go make Hotline Miami 3!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
