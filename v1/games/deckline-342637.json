  {
   "id": "deckline-342637@hotfix-2025-05-08",
   "gameId": "deckline-342637",
   "displayName": "May 8, 2025 - Hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-05-08T11:47:30.000Z",
   "notes": [
    {
     "title": "Introduction",
     "items": [
      {
       "text": "Thank you all for playing the game and sharing your feedback! It means the world to us. We are monitoring your suggestions, comments, feedback 24/7 to see what can be done to improve the general gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Please note that we have seen your multiplayer requests! This is a feature that we are ready to implement, however, we will be looking at the game's current performance to see whether creating multiplayer mode will be viable for us or not. Thank you for your understanding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Hotfix",
     "items": [
      {
       "text": "Direct artillery hit chance reduced to 20%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "AI turn and card placement speed set to minimum delay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved performance issues on some AMD devices.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved overall performance across all hardware configurations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Don't forget to leave your reviews on Steam! If you are experiencing any technical issues, please, reach out to us via Discord or any other format you prefer.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
