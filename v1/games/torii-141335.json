  {
   "id": "torii-141335@1.9.6.6",
   "gameId": "torii-141335",
   "displayName": "Update 1.9.6.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-06T23:38:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Puzzles/Exploration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Now players will know exactly when they finished a puzzle. Puzzle items disappear, prisms are disabled and a statue of Astrum appears.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Some puzzles have been reworked with their difficulty adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added new effects to make exploration and puzzle solving more intuitive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug in the memory storm puzzle that caused players to not be able to re-enter the Astral.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixed a bug in the menu that did not allow the player to change the vsync option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Others",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Text corrections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Added more Moswig dialogues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thanks for your support and feedback! And thanks for helping indie devs! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
