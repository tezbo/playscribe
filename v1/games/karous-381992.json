  {
   "id": "karous-381992@1.0.5",
   "gameId": "karous-381992",
   "displayName": "Update 1.0.5",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-03-06T15:03:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update 1.0.5 - Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a tutorial before starting the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a mail feature to review in-game messages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added an option to invert vertical (TATE) mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added a rapid-fire option to the button configuration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Improved accuracy to the original arcade version in certain areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added resolution and V-Sync settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・D.F.S. can now also be activated with the C key",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Updated controller configuration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please apply the latest official layout through \"Steam Overlay > Controller Settings > Official Layout\"",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
