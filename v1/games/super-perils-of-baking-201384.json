  {
   "id": "super-perils-of-baking-201384@01.016",
   "gameId": "super-perils-of-baking-201384",
   "displayName": "Update 01.016",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-29T13:55:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "With this latest update for the Steam version of Super Perils of Baking (01.016) we have shifted to a 64 bit requirement. This is due to our engine GameMaker making this change to their export capabilities. If you want to play the game in 32 bit you can still do so by accessing the 32 bit branch. You can do this by right clicking the game within Steam, selecting properties, then the Betas tab. The 32 bit branch will be listed in a drop down menu that you can select there. No password is required.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Live today in update 01.016 are a number of small bug fixes, as well as the implementation of the Steam/Community screenshot function. We look forward to seeing the screenshots you guys will share with the community going forward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
