 "releases": [
  {
   "id": "steamworld-heist-ii-298315@1.5",
   "gameId": "steamworld-heist-ii-298315",
   "displayName": "Patch 1.5",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-03T09:04:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ahoy, steam-mates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch v1.5 has just anchored, bringing new features and plenty of fixes to keep your voyage through SteamWorld Heist II on course. The headliner? You can now buy back rare items you’ve sold from the new Used Goods section at Argent’s Articles! Plus, we’ve added options to improve ship firing angle visibility and adjust dialogue text speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Buy back previously sold rare items from Argent’s Articles in the new Used Goods section.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Option for enhanced ship firing angle visibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Option to adjust dialogue text speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes & Improvements",
     "items": [
      {
       "text": "Cooler Unit stacking is now working as it should.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Swag in Advanced Immortality is no longer lost at sea.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Repair items now correctly benefit from the Always Prepared ability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Feel the Burn description has been corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Droid spawners in Locked Up are no longer invulnerable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Inconsistent dialogue at the Lighthouse after visiting the frozen vessel is fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected navy enemy spawns in Ritual Crashers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various lingering visual effects have been swabbed from the deck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bonus objectives in House of Pain and Frozen Solid are now consistent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Weapon Charger now only applies to primary weapons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Aura-boosting items now stack correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the mouse cursor sometimes appearing while using a controller on PC.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Big Spender and Never Gonna Let You Down progress now updates correctly on PS5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Music in the final cutscene plays correctly on Xbox Series X.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Neutral and combat music tracks stay in sync on PS5 & PS4.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "UI improvements for selling items, making it clearer which item is being sold.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Rattler door’s yellow warning light is now more distinct from the green safe light.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Achievements now properly update on the Epic Games Launcher.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "As always, thank you for your support & happy heisting!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Your SteamWorld Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
