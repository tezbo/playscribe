  {
   "id": "steamworld-heist-ii-298315@1.4",
   "gameId": "steamworld-heist-ii-298315",
   "displayName": "Patch 1.4",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-08-16T12:05:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ahoy, steam-mates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you’ve all been enjoying your time in SteamWorld Heist II so far!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your unwavering support has been incredible, and we’ve been hard at work ensuring your journey through the Great Sea Shard is as smooth as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As such, we're excited to announce that Patch v1.4 is now live on PC and will be rolling out to consoles in the coming days! Here’s what’s on the horizon:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch v1.4 Notes",
     "items": [
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved soft lock issues in certain missions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed conversation with Edna before the final boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed ice block spawning for frozen units on certain tiles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ensured 4 rare hats now spawn correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed load-out UI not appearing before missions. (Switch)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated Switch Pro Controller button prompts to display correctly. (PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Power Shot now functions properly with explosive sniper rifles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visual and UI Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Pretty Bow inventory icon now matches its in-game appearance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor animation and VFX adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Miscellaneous",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various spelling and text corrections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We truly appreciate your continued support—whether it’s leaving reviews (yes, we read them all!), sharing your fan art and creations (we love seeing them!), or reporting bugs and issues (we log everything!).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your SteamWorld Heist II Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
