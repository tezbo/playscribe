  {
   "id": "melobot-a-last-song-199252@major-2022-06-17",
   "gameId": "melobot-a-last-song-199252",
   "displayName": "Demo update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-17T13:10:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi 🌱",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are launching our last demo with the Steam Next Fest, feel free to test it out and give us feedback on our discord https://discord.com/invite/rwGAbNYYvR",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the demo you’ll find 2 biomes: the ionian biome which is the tutorial & the dorian biome where the adventure kicks in!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The demo will not be up indefinitely so don’t miss your chance to try our game out for free!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here is a brief patch notes for the changes in the latest demo version:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Vespod Harvester dark matter signal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed the limitation of 1 region validation per expedition",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Region validation now gives musical energy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Meloplant destabilisation can now be used in a validated region",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lots of bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are excited to share with you what we’ve been working on!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bye 🤖",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
