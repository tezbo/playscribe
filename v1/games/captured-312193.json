     "title": "Changes",
     "items": [
      {
       "text": "Camera Tilt Option: You can now turn off camera tilting in Gameplay Settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mr. Blue Collision Fix: Improved Mr. Blue's collision box, which was previously allowing him to catch players through the door if they were standing against it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
