  {
   "id": "captured-312193@major-2024-12-18",
   "gameId": "captured-312193",
   "displayName": "CAPTURED Winter Seasonal Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-18T17:31:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For a limited time, some anomalies are getting a festive makeover! Winter has covered some rooms with snow, ice, gifts, and holiday decorations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I’m incredibly grateful for all the love and support you’ve shown for CAPTURED. It truly means the world to me, and I hope this update brings a little extra magic to your experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I’m excited to share in early 2025 what I’ve been working on, but until then, I wish you a warm and wonderful holiday season! 🎁❄️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Puck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
