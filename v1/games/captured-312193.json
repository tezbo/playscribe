  {
   "id": "captured-312193@1.0.12",
   "gameId": "captured-312193",
   "displayName": "Patch 1.0.12",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-25T13:39:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Progress Tracking: You can now track your captured anomalies! You can view how many unique anomalies you've captured when selecting a difficulty. Please note: anomalies captured before this update will not be included, as tracking wasn't available prior to version 1.0.12. This feature is purely informational and not tied to any achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial Tips: Small adjustments have been made to the tutorial to better explain the \"ANOM\" counter and indicate where to find the Motion Sickness Accessibility settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
