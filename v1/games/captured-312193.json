   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-16T11:52:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Anomaly Type Information: You can now view information for each anomaly type by hovering over its button in the anomaly type selection menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Demon Nerf: The demon will no longer eliminate you immediately, allowing more time to escape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
