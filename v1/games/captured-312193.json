   "announcedAt": "2024-10-28T19:33:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For a limited time, some anomalies are getting a spooky makeover for the Halloween season! Take a peaceful walk through the forest anomaly and keep an eye out for a special Halloween item.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NEW LIMITED ITEM",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A new pumpkin item is waiting to be found in the Forest anomaly. It can protect you against Hornhead!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "SPOOKY DECORATIONS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some anomalies have been updated with skeletons, pumpkins, and Halloween decorations.",
       "ps5ProOnly": false,
