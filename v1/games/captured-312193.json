  {
   "id": "captured-312193@1.0.4",
   "gameId": "captured-312193",
   "displayName": "Update 1.0.4",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-18T20:55:03.000Z",
   "notes": [
    {
     "title": "New Features",
     "items": [
      {
       "text": "Second Chance Deal: If you miss or incorrectly select an anomaly while only 1 anomaly away from reaching the required amount to escape, the Demon offer you a second chance deal.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Key Remapping: You can now customize your keybinds in the CONTROLS tab in the settings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Players will no longer be able to trap themselves behind the chair during the toilet murder scene anomaly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cabinets in the Laundry Room will no longer open during the Kitchen Poltergeist anomaly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the Demon’s voice line near the end of the game to avoid confusing players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "The demon will warn you upon entering the dead zone in the hospital.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Once you've captured the required number of anomalies, you'll receive a notification instructing you to leave the loop to escape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
