  {
   "id": "gunhead-76062@1.35",
   "gameId": "gunhead-76062",
   "displayName": "Update 1.35",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-11-13T20:35:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi again,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes for 1.35",
     "items": [
      {
       "text": "Fixed tractor beam when used on Sawblade",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue if ingame menu was used after finishing level, and controls tried to rebind",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed teleporting away Python issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added 120 target FPS option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "So some things we're considering for next update",
     "items": [
      {
       "text": "A way to repair health while on the ship. Would be a station in the hanger to pay $ for health repair.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A option to refill ammo of a weapon at license station. Would cost $, but not as much as buying weapon. Empty weapons would stay in inventory.: thanks,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lee",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
