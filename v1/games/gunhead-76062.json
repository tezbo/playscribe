  {
   "id": "gunhead-76062@1.22",
   "gameId": "gunhead-76062",
   "displayName": "Update 1.22",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-11-10T20:35:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We wanted to do a quick update to fix a few small things, and make a tweak to the in air movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're going to do another update focused on fixes/bugs this weekend - then after that focus on the first content update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Increased In Air move speed slightly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed issue with keys being in locked Core room in some generated Wreck levels (forum post)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Core room generation fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added 'In Space Blur' option to Game options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Chinese language updates - should be a better translation: thanks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lee",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
