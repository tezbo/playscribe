  {
   "id": "gunhead-76062@1.44",
   "gameId": "gunhead-76062",
   "displayName": "Update 1.44",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-25T20:24:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've updated to 1.44 - focused on better Steam Deck support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Will default to 130% UI scale for Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Better scaling of the UI for different UI scales",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Larger fonts (inventory, license station): Let us know any thoughts or issues in the Steam forums or our Discord!: thanks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lee",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
