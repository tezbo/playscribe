  {
   "id": "gunhead-76062@1.3",
   "gameId": "gunhead-76062",
   "displayName": "Update 1.3",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-11-11T19:07:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another day another update with fixes. We fixed all known bugs on our list - but definitely let us know of any issues in the forums. We're also looking at feedback on our forums to decide on changes for the next content update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "1.3 fixes",
     "items": [
      {
       "text": "Fixed rare generation issue with section with no doors to a section - forum post",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with the star map (ship selection) displaying wrong bonus reward amount",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Default FOV now 90. Can now set FOV in 5 increments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated Steam Cloud to not sync the settings, just profile/stats",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed systems starting in the lava in Network - pipes section: thanks,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lee",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
