 "releases": [
  {
   "id": "midnight-murder-club-312282@2.0.008",
   "gameId": "midnight-murder-club-312282",
   "displayName": "Update 2.0.008",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-18T14:12:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "To our dearest guests,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we're rolling out update 2.0.008 for Midnight Murder Club, which fixes a bug for some Steam PC players that affected controller rumble functionality.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "This is our last planned update for the game. The manor’s doors will stay open for both new guests and seasoned players alike. Whether you prefer private games or public matches, you can continue to host friends-only lobbies and connect with other players through in-game matchmaking or room codes. (If you’re not in our Discord, there’s a dedicated #room-codes channel you can use to find other players!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "At Velan, we feel strongly about game preservation (See also: Knockout City Private Server Edition), so we'll come back to patch Midnight Murder Club again if anything in the future prevents people from playing the way they can today.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here’s to countless more nights of murder at Wormwood Manor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Velan Studios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
