  {
   "id": "midnight-murder-club-312282@2.000.003",
   "gameId": "midnight-murder-club-312282",
   "displayName": "Patch 2.000.003",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-08-22T14:03:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Improved the experience of adding and removing bots to groups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Cleaned up team select behavior.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the word \"co-op\" to the Graveyard Shift description in the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved the voice scrambler menu to avoid accidentally scrambling the whole room instead of one person.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where Graveyard Shift was showing incomplete text in the UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various game crashes and compatibility issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
