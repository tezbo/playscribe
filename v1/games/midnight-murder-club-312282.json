  {
   "id": "midnight-murder-club-312282@1.2",
   "gameId": "midnight-murder-club-312282",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-23T14:05:55.000Z",
   "notes": [
    {
     "title": "Features",
     "items": [
      {
       "text": "New Wildcards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Falling Chandelier – attach a chandelier to the ceiling that will fall on your enemies when they walk underneath it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Flaming Skull – transform into a flaming, flying skull and hunt your enemies from the skies!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Growing Glow Trail –We’ve updated Glowing Glow Trails so now they get longer with every kill",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Party Room – there ain’t no party like a Midnight Murder Party because the Midnight Murder Party don’t stop! Until everyone is dead. Then... Then it stops...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Knives Only – by popular request, you gotta slash your enemies to bits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sound Blast: Jazz Club – every time you fire your gun it sounds like a high school band rehearsing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Pinged to Death! – on a player’s death, a pinger goes off revealing the locations of everyone in the mansion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Shrink Shot – get shot, get shrunk, get revenge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Gift from the Grave – when you die, you’ll get a little present that will give you a chance to catch up and seek revenge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "All in the Chamber – all your bullets fire at once. More bullets = More good!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Players can now play a Wildcards match with bots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Voice Scrambler: if you’re matched with someone who is being a bit of a jerk, you can now scramble their voice, so you can’t tell what they’re saying, but you can still tell where they are",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bots",
     "items": [
      {
       "text": "Bots will now be better teammates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bots are now available in Wildcard matches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "Mansion Compass – helps you navigate when your flashlight is on",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Death Pin Drops – players will now see a ping that shows them the location of where they last died in the mansion, helping them find their way back",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Other",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "UI / UX flow updates to improve rematch capabilities and optimize grouping up with friends",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Known Issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Players using a controller on PC will not be able to navigate to the right-side menu after pressing “Play Game.” The current workaround if players need to access that menu is to use mouse and keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
