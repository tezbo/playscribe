  {
   "id": "midnight-murder-club-312282@2.000.006",
   "gameId": "midnight-murder-club-312282",
   "displayName": "Patch 2.000.006",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-17T14:26:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "To all of our guests in Wormwood Manor,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for all of your feedback, commentary, and participation in our Discord community contests. We have a hotfix patch that will fingers crossed solve some of the roadblocks you’ve been facing in Midnight Murder Club.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, we invite you to keep us updated on your experience and hope to see you and your groups take advantage of this patch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Network",
     "items": [
      {
       "text": "PSPC update to address the sign-in issues that have been ongoing on PC",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Grouping",
     "items": [
      {
       "text": "Fixed an issue that prevented the 'Keep Party Grouped' option from working in some cases. Now you can keep the party grouped!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
