  {
   "id": "midnight-murder-club-312282@2.000.007",
   "gameId": "midnight-murder-club-312282",
   "displayName": "Patch 2.000.007",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-23T15:33:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "To all of our guests in Wormwood Manor,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re one week removed from our previous patch, and we present another to ensure your stay in the mansion is as enjoyable and stress-free as possible. This is a small fix that only affects Steam users.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your commitment, communication, and love for Midnight Murder Club. As always, keep an eye out on our various channels for other updates or notes of interest. (And if anything breaks, please let us know.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "…And if anything breaks, please let us know!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor PSN UI bugs that affected specific machine configurations (Maybe it’s your machine!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Mask on, have fun, and good luck!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
