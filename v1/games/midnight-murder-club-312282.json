  {
   "id": "midnight-murder-club-312282@1.1.1",
   "gameId": "midnight-murder-club-312282",
   "displayName": "Patch 1.1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-02T14:01:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This patch arrives alongside the Midnight Murder Club Open House Weekend, allowing Guest Pass Edition members to play without restrictions all weekend!* It also comes with our first shot at a PvE mode, giving up to two players the ability to play a variant of Headhunters against various numbers of bots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enables Open House Weekend functionality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adds the new Headhunters vs Bots mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue that prevented PC players from inviting some PC players through the Steam Friends List",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "*Account for PlayStation™Network and internet connection required. Paid for PlayStation®Plus membership (sold separately) required on PS5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    }
   ],
