  {
   "id": "death-elevator-255717@major-2024-11-28",
   "gameId": "death-elevator-255717",
   "displayName": "Big Update & New Platforms!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-28T14:15:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi people! 🚪⬆️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have exciting news for you! Death Elevator has just received a major update on Steam! Alongside this, the game is now officially available on Nintendo Switch, PlayStation 4/5, Xbox One, and Series X|S for just $9.99.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "But that’s not all—Steam players get an exclusive deal! To thank you for your support, we’re keeping the price at $7.99 with a 10% launch discount for a limited time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What’s New in the Update?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👉 Global Leaderboard: Compete with players worldwide to claim the top spot!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👉 Input remapping and performance optimization!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👉 New Platforms: Take the Death Elevator challenge wherever you go.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you’re already playing, don’t forget to update your game, try out the new features, and leave us a Steam review! Your feedback makes all the difference.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Key Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚡ Fast Movement: Dash through randomized floors at breakneck speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🕒 Slow Motion: Survive deadly moments with precision as time slows down.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🏢 Randomized Rooms & Weapons: Every run feels fresh and exciting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📈 Score System: Challenge your friends and climb the leaderboard!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🕵️ Interpretative Plot: Uncover the mysteries of the elevator.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New to Death Elevator? Now is the perfect time to experience this skill-based roguelike where every bullet is lethal, and survival is the ultimate prize.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "💬 Join the conversation: Connect with fellow players on our Discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👍 Leave a review: Click here to help us improve and grow!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
