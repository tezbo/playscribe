 "releases": [
  {
   "id": "nba-bounce-358532@major-2026-10-14",
   "gameId": "nba-bounce-358532",
   "displayName": "NBA BOUNCE is getting ready for the 2026-27 NBA season with a new update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-14T14:03:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Originally launched in September 2025, NBA BOUNCE is an accessible, inclusive, and family-friendly take on basketball, blending competitive action with party-style gameplay and playful customization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The new season update keeps the game up to date with the latest NBA team identities, giving players an authentic way to hit the court.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Whether players are lifelong NBA fans or new to the party, the 2026-27 Season Update brings some exciting new looks to NBA BOUNCE:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45731281/0535db762e8d7db90a9ceaa71b2b3074702ba837.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● The Chicago Bulls’ iconic mascot Benny the Bull hits the court in his new #99 jersey, ready for the new season.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45731281/8cfee4514a8095a7af6036b5c9fc1675b19a0d62.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● The Minnesota Timberwolves step onto the court with their brand-new visual identity, bringing their latest colors, logos and team branding to NBA BOUNCE.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45731281/b47b9c2e8e663ac404f57a6ab14a1fb1161fda3e.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● The Houston Rockets also get a complete visual refresh, bringing their latest team colors, logos and branding to the court in NBA BOUNCE.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update will be available Wednesday 14th October, 2026!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
