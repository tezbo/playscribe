  {
   "id": "edge-of-sanity-214504@1.1.10",
   "gameId": "edge-of-sanity-214504",
   "displayName": "Update 1.1.10",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-26T15:00:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, fans of darkness and insanity!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your amazing support since the launch of Edge of Sanity, we keep looking at your feedback and we've prepared a new patch to further smooth out your experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General (from 1.1.8 hotfix)",
     "items": [
      {
       "text": "Fixed an issue with custom keybindings not being saved.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue with “Description” language being visible and enabled as default language, messing up with text and voice overs in some cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Achievements",
     "items": [
      {
       "text": "Fixed the “You Cannot Pet The Worm” achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the “Sane To The Hideous End” achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the “Between A Lock And A Hard Place” achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "The Camp",
     "items": [
      {
       "text": "After finishing the “Depot near mine” expedition if the player didn’t find or lose a “Spark Plug” or “Brake Fluid” item and hasn’t finished fixing the truck yet, these items will spawn in the camp near the storage station.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Expeditions",
     "items": [
      {
       "text": "Added italics that were missing in PRIMS Laboratory texts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The security desk dialogue avatar changed from a radio to a computer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed spelling in Polish translation in the first dream sequence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the tag in “Back to camp” message in Spanish translation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the radio station sound staying in the background",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UI",
     "items": [
      {
       "text": "Fixed small maggot journal entry not showing up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Remember that you can leave feedback either here on Steam forums or by joining our Discord!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Good luck with your Alaskan adventure!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
