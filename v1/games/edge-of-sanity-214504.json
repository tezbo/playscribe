 "releases": [
  {
   "id": "edge-of-sanity-214504@1.1.12",
   "gameId": "edge-of-sanity-214504",
   "displayName": "Hotfix 1.1.12",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-11-13T16:00:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, fans of darkness and insanity!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the last week, since our newest update update, some of you encountered bugs surrounding the autosave mechanism which in severe cases lead to losing progress. We since then circled out the culprits and prepared a hotfix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today's hotfix fixes the autosave. Unfortunately, even though we are sure we erased this issue, we can't promise the restoration of your progress. We are sorry for any inconveniences but want to reassure you that we have reworked our internal processes to (at least try to) guarantee that this doesn't happen again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog - 1.1.12",
     "items": [
      {
       "text": "Fixed issues with the auto save feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Remember that you can leave feedback either here on Steam forums or by joining our Discord!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Good luck with your Alaskan adventure!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
