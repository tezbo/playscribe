  {
   "id": "cryptical-path-270542@major-2024-01-29",
   "gameId": "cryptical-path-270542",
   "displayName": "Demo Update: Take the Tour",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-29T18:49:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Architects,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As we prepare for the Steam Next Fest period, we are releasing a new demo with several improvements. These include a brand new weapon to help you navigate the dungeon, balancing fixes, and an enhanced onboarding experience for newcomers. Take a look at the complete list below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Main Changes",
     "items": [
      {
       "text": "New weapon: the Dice. The Architect is now carrying a brand new weapon that replaces the old one: the dice. Roll it and meet your destiny. 10 New items comes with the dice, creating new possibilities for synergy and massive destructions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "By popular demand, we added invincibility frames on dash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve worked on an improved onboarding experience to allow newcomers to start their journey in the dungeon more easily",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Progression",
     "items": [
      {
       "text": "You can now collect frozen souls during your run to spend in your hub",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now access the Hub and meet Bernardo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can purchase new items to find in your future runs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can unlock new rooms to use on the board",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes and polish to increase overhaul immersion and correct multiple issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Board",
     "items": [
      {
       "text": "Art and FX have been reworked to make board more clear & readable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When the board is locked (-10 controls) path is now created leading to the boss and raising the difficulty to its maximum instead of giving the ability to teleport to the boss room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "Difficulty of visited rooms increases overtime",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed the price of rooms you can place",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "You start the game with 5 hearts (was 3)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "You start the game with 10 control (was 5)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Boss has New attack patterns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Boss attacks order patterns is now random",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Have a suggestion for more improvements? Join the Cryptical Path Community on Discord and share your ideas in the server.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
