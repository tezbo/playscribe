  {
   "id": "cryptical-path-270542@1.0.1",
   "gameId": "cryptical-path-270542",
   "displayName": "PATCH 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-11T13:20:07.000Z",
   "notes": [
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Reduced enemies' health in Biomes 2 & 3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Combo now lasts 2.5s and fades for 1s",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Effects for the following items have been adjusted:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Real Estate Expert → Entering a hostile room generates 5/10/20/35 10/20/30/50 shards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Certified pyrotechnician → Hitting an enemy with a bomb generates 1/2/3/5 3/5/7/10 explosive shards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Auric Obsession → Grant 1 1/2/3/5 gold every 30/25/20/10 20 combo points",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Drinkable Gunpowder → Weapon becomes a bomb every 35/30/25/15 30/25/20/10 combo points",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Static Electricity → Remain at 40/35/25/10 20/15/10/5 combo points, weapon attacks generate electric arcs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Weaponsmith Expert → As long as you remain at 10+ combo points, generate 2 5 shards every 1s 3/2.5/2/1s",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Shattered heart → Weapon generates shard every 0.25s 0.2s",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Echo dice effects now trigger directly when interacting with “heart” items such as Infernal Heart.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New icons added for the patterns to make them easier to understand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Various improvements and fixes for some of the Experiences.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Patterns can no longer be farmed indefinitely.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bomb Room description no longer claims to grant control.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Doors in the 2nd Biome no longer unexpectedly lock players behind them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the Doppelganger unlock sequence dialog triggered too early.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed lag caused by Echo Device + Electricity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Potion \"Hazardous Duplicator\" no longer grants common versions of items that were unintended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Boss achievements unlock correctly if defeated without taking any hits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue preventing the Bo-Love-Aro achievement from unlocking correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Addressed problem where the quality control item appeared incorrectly in Act 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed card VFX not displaying properly during ACT unlocking sequences.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rotten Egg gives the correct amount of empty hearts for each curse.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bernardo's Codex entry has been restored in English.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Codex entries are no longer cut off in Spanish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Character names are correctly translated in certain languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various localization fixes in all languages.: 1.0.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
