  {
   "id": "cryptical-path-270542@1.0.2",
   "gameId": "cryptical-path-270542",
   "displayName": "PATCH 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-14T15:41:52.000Z",
   "notes": [
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Procedural challenge layouts no longer repeat the same object placement each time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Steam Deck resolution list now excludes unintended low-resolution options when using Borderless mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "“The Architect’s Knowledge” achievement can now be completed. It no longer requires the golden gem that was previously locked behind the achievement itself.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The “Soda Star” item no longer reduces its own critical bonus damage due to a hidden modifier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bol-Love-Aro achievement now properly tracks item purchases made during challenges.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Restored the missing text in Bernardo’s dialogue after losing to the Doppelganger.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various localization fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
