       "category": "other"
      }
     ]
    },
    {
     "title": "Performance & Stability ⚡",
     "items": [
      {
       "text": "Improved performance in large stores",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Smoother camera movement across all framerates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enhanced customer pathfinding (customers will less frequently stand around when unable to find items)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Bug Fixes 🛠️",
     "items": [
      {
       "text": "Playtime is now correctly displayed in save slots (including over 24 hours)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game properly pauses in the pause menu (time no longer continues)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Quest progress is maintained when returning from main menu",
       "ps5ProOnly": false,
