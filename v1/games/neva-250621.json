   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-22T16:13:46.000Z",
   "notes": [
    {
     "title": "Hello everyone, here is another patch addressing some bugs!",
     "items": [
      {
       "text": "Fixed physics and animation issues when playing at very high framerates due to vsync being ignored.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the resolution selection menu not changing resolution, or showing all available resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed tree chase sequence at the end of Fall Part 1 that caused the player to climb in the air and prevented the sequence from being completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
