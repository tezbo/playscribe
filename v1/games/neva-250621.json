   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-17T14:48:11.000Z",
   "notes": [
    {
     "title": "Hello everyone! This is just a small patch to resolve the controller issue some players encountered.",
     "items": [
      {
       "text": "Fixed an issue where controllers would not work if the player swapped between bluetooth and wire connection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the game did not respond to controller inputs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Big thank you from the whole team for playing Neva, and all the feedback we got!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug squashing and fixing continues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
