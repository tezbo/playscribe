  {
   "id": "driving-is-hard-315385@major-2025-02-16",
   "gameId": "driving-is-hard-315385",
   "displayName": "Driving Is Hard – Driving is Easy Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-16T12:03:00.000Z",
   "notes": [
    {
     "title": "Driving Is Hard – Driving is Easy Update!",
     "items": [
      {
       "text": "We’ve been busy under the hood, and we’re excited to bring you an update packed with new features, improvements, and fixes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Driving Is Easy Mode",
     "items": [
      {
       "text": "A new, more forgiving game mode for those who want less pain and more fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Set checkpoints by toggling lanterns and respawn after crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Perfect for players who want to enjoy the wild ride without the brutal challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Quality-of-Life Settings",
     "items": [
      {
       "text": "Auto Rotation – Toggle automatic camera rotation to keep your cam aligned.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Speedlines – Turn speed lines on or off based on your style.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dynamic FOV – Toggle dynamic field-of-view whenever you like.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restart Button – Add a restart button for quicker resets—great for speedrunners!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Improved Credits Screen - Added Respawn Counter and Grandpa Race Track statistics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Performance Boost - Potato settings now deliver even better performance for low-end machines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Speedrun Areas - Patched a few sneaky shortcuts in the Treehouse and City Rooftops.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Linux Glitches - Visual glitches on Potato settings have been resolved.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Tree Flickering - Trees no longer flicker—enjoy a glitch-free view of nature!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": ":fire: Update your game and try out the new Driving Is Easy mode! And don’t worry—Driving Is Hard is still as punishing as ever for those who seek the challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
