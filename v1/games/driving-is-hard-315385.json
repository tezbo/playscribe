  {
   "id": "driving-is-hard-315385@5.0",
   "gameId": "driving-is-hard-315385",
   "displayName": "Update 5.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-05T12:26:20.000Z",
   "notes": [
    {
     "title": "Driving Is Hard – Driving Is Insane Update! V5.0",
     "items": [
      {
       "text": "We went full throttle with this one. A brand new hard mode, slick skins, and big under-the-hood improvements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Insane Mode – new no parachute gamemode with a few checkpoints. Driving Is Hard must be completed to play this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Skins – Unlockable lootbox and completion achievement skins.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Discord Button – Found a bug? Smash that button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Fully rewritten loading system – loads a bit slower, but uses way less memory and makes future updates tiny.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Better & more unstuck points (though getting stuck should be close to impossible).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed all Father voice lines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "~10% FPS boost",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Localization polish – improved localization texts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Community Spotlight 🐐",
     "items": [
      {
       "text": "A huge thank you to the organizers and players who put together a chill Driving Is Hard showmatch featuring 4 GOATs of the game! Pitrau, Warryan, Miztix, Lockness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pulling off a clean run isn’t easy—mad respect to the drivers. 💪 Thanks for showing the game some love!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
    "new": 8,
