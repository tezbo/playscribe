  {
   "id": "driving-is-hard-315385@4.0",
   "gameId": "driving-is-hard-315385",
   "displayName": "Update 4.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-08T17:16:39.000Z",
   "notes": [
    {
     "title": "Driving Is Hard - Skin Update! v4.0",
     "items": [
      {
       "text": "Jeff is getting a makeover! This update introduces bath and character customization, letting you collect and equip cool new skins while tackling the toughest roads.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Feature - Collectible Skins!",
     "items": [
      {
       "text": "Customize Jeff with unique outfits and accessories.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Explore the world to find hidden collectibles scattered across different levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Show off your style as you struggle and succeed through brutal driving challenges!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Reflections - Improved reflection quality and made the metals look better",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sounds - Improve sounds all over the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ragdoll - Make Jeff react to external forces more",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Steam Deck - made the UI larger and default visual settings Potato for better first-hand experience",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Ghost Flip - Fixed the ghost flip which used to happen at the apex of the jump.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolve Stucks - We had two locations where people stucked. Now we don’t.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Flickering Trees - Fix a few trees that caused visual flickers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Update your game and start hunting for skins! Whether you drive in style or chaos, the challenge remains the same - Driving Is Hard.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🚗💨 Happy driving!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
