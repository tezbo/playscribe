  {
   "id": "annie-last-hope-134743@major-2025-06-11",
   "gameId": "annie-last-hope-134743",
   "displayName": "Annie: Last Hope – Re-release & Update Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-11T03:23:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Following a round of optimization and adjustments, Annie: Last Hope will soon be available for purchase again. The latest update includes the following improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Japanese language support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New aiming guide feature, which can be enabled in the game settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Performance optimizations, including reduced memory usage and improved frame rates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We sincerely thank all players who have supported Annie: Last Hope. We will continue to update and improve the game to bring you an even better gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
