  },
  {
   "id": "welcome-to-empyreum-189240@1.0.9",
   "gameId": "welcome-to-empyreum-189240",
   "displayName": "Patch 1.0.9",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-07T14:34:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for supporting Welcome to Empyreum. We have just released an update to address a few bugs that were reported during these past two weeks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here's a list of all the changes",
     "items": [
      {
       "text": "Fixed a bug in the Nursery levels where babies created invisible puddles below the floor that could not be cleaned, and therefore it was not possible to obtain a 100% score.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Bakery's wooden pallet getting stuck in some walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed asleep players not being able to move after being woken up with a slap in Castle levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in the Castle's gear pedestals that allowed players to place more than one gear on them, but only one gear could be removed. This meant that all other gears that had been placed in the same pedestal couldn't be recovered and the level couldn't be finished. Now, pedestals only take one gear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Shadows quality level not being applied nor saved in the Graphics Settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced the amount of dust you need to vacuum in order to unlock achievement \"No more dust\" to 1000 specks. Players that have already vacuumed more than that should obtain the achievement automatically shortly after starting the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "We have also created a form where you can submit any other bugs you might find from now on: https://forms.gle/d4cwCTUKGKgMDctP7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
