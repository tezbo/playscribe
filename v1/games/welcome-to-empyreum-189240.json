 "releases": [
  {
   "id": "welcome-to-empyreum-189240@1.0.10",
   "gameId": "welcome-to-empyreum-189240",
   "displayName": "Patch 1.0.10",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-16T19:00:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is just a small update to fix achievement \"Bon Voyage! (Leave the entire hotel 100% clean)\", which wasn't unlocking for some players after they had cleaned 100% of every level. We believe this happened if the last level where you got a 100% score was the \"top floor\" of the hotel (if you know, you know...).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For those affected: The achievement should know unlock as soon as you get 100% again in any level. If it still doesn't unlock for you, please, let us know!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'd also like to remind you that you can report any bug or issue you find through this form: https://forms.gle/d4cwCTUKGKgMDctP7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We apologize for any inconvenience, and thank you for your help!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
