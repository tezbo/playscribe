  {
   "id": "stellatum-55573@1.4.5",
   "gameId": "stellatum-55573",
   "displayName": "Update 1.4.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-08-25T08:47:58.000Z",
   "notes": [
    {
     "title": "We are happy to announce the next major update of Stellatum!",
     "items": [
      {
       "text": "Arena mode is added to the game. This is an endless game of survival.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You begin your battle to survive with the base ship. After successful completion of each generated level, you will receive random ship details with random characteristics. For the destruction of opponents and completing levels you will get score points that will be displayed in the leaderboard.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When your ship is destroyed your points will reset, but your best record and 25% of the received parts remain. Starting your battle again, you will not start from scratch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get new sensations from Stellatum and get the leadership in the ranking of players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also added a new kind of loot in campaign mode - materia. This resource falls out of the destroyed enemies in large numbers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now you do not need to replay levels to get the component you need. We also made secondary levels really useful.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now you can create components yourself! With the help of materia, you can create the components that you need at the moment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To do this, go to the hangar and click on the \"create\" button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A menu will appears with the selection of the components. Just click on the button to create the component you need.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "To finalize the update in the 1.4.5 update",
     "items": [
      {
       "text": "The balance of the player's guns has been changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The balance of damage and hitpoints of opponents has been reworked, especially in the first race.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved game performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed balance for the receiving of components.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The duration of many levels has been shortened.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved multiplayer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved synchronization of players in multiplayer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed the balance of bosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the number of opponents at the levels of the second race.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The design of some levels has been changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved sound effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed the balance in the cooperative game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Most visual effects are optimized.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed many minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
