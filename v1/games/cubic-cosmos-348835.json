  {
   "id": "cubic-cosmos-348835@1.1.2",
   "gameId": "cubic-cosmos-348835",
   "displayName": "Patch 1.1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-07-25T04:05:02.000Z",
   "notes": [
    {
     "title": "Hail, Cosmonauts! See below for details on update v1.1.2",
     "items": [
      {
       "text": "Version Number: v1.1.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Time: 2026/7/24 10:00 UTC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "When creating a battle code, you can now include your current enemy buff multiplier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You will now only draw your starting cards after all enemies have entered the battlefield. This prevents pawns with the Auto trait from attacking empty spaces.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed interaction issues between Amber and pawns with the Consume trait.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some pawn model zoom effects could not be skipped when using the Skip feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where information would be retained when switching between Codex pages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where cards would cease to be displayed after checking creatables when selling cards in the Shop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with skill text for Tier II Golden Dragon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We'll keep on fixing any bugs you find!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
