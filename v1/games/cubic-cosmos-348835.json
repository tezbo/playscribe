  {
   "id": "cubic-cosmos-348835@1.0.6",
   "gameId": "cubic-cosmos-348835",
   "displayName": "Patch 1.0.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-13T02:26:15.000Z",
   "notes": [
    {
     "title": "Hail, Cosmonauts! See below for details on update v1.0.6",
     "items": [
      {
       "text": "Version Number: v1.0.6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Time: 2026/6/12 16:00 UTC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Added new Variant Relics Traveling Crab and Heartlight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added confirmation prompts to certain buttons, with an option to disable reminders for the rest of the session.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fell Infusion will be removed from random sorcery pools for cards such as Dreaming Dragon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized several interaction details for Steam Deck and fixed some freezing and focus loss issues.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved button prompts on Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where you could repeatedly purchase Doll cards by flipping through pages in the Shop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with remaining MP display after playing cards and reloading repeatedly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where multiple Golden Dragons gaining the Resonance trait could lead to crashes. For the time being, the Resonance trait cannot be given to Golden Dragon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed UI interaction detail issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed UI buttons having no sound or erratic sound effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We'll keep on fixing any bugs you find!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
