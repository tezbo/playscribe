  {
   "id": "cubic-cosmos-348835@1.0.3",
   "gameId": "cubic-cosmos-348835",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-13T12:50:19.000Z",
   "notes": [
    {
     "title": "Hail, Cosmonauts! See below for details on update v1.0.3",
     "items": [
      {
       "text": "Version Number: v1.0.3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Time: 2026/5/13 14:00 UTC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Fixed an issue where Vanguard Attendant could not recognize hero skills obtained via Shapeshift.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with Amplifier's buff tracking in interactions between Astral Summons, Mr. Puff, Esquire, and Amplifier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed attribute calculation issues for cards like Amplifier when tracking percentage-based attribute buffs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where interactions between Surge and Mirrored Pool would cause cards in hand to display overlapped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed display issues when viewing hero skills gained by Shapeshifting into Shadow of the Goddess.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Pureblood Hunter now has a maximum per-turn skill trigger limit (up to 30 times) to prevent skill loops leading to crashes for certain Auto archetypes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Targets affected by Moment of Truth are now more clearly indicated with visual markers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an \"MP Cost\" heading to the Help screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved notifications regarding unlocking hero Shadow of the Goddess to make them clearer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We'll keep on working to improve the game. Thanks for your support and suggestions!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
