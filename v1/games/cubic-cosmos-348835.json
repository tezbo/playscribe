   "id": "cubic-cosmos-348835@1.0.2",
   "gameId": "cubic-cosmos-348835",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-08T13:49:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hail, Cosmonauts!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]See below for details on update v1.0.2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Version: v1.0.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Time: 2026/5/8 14:00 UTC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Fixed interaction issues with the hero skill selection screen for gamepads and Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed skipping issues when hiding event selection screen for gamepads and Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where two types of card model would remain displayed in your hand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where hero models could unexpectedly disappear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect text for extra XP rewarded at the end of runs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In Level 2 Falsefruit events, the choice to reduce Fatigue damage now also increases hero Might.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Text description of the Potent trait has been changed to reflect the fact that it does not affect percentage-based attribute buffs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Potent trait was intended to be able to stack, but this was not displayed due to a bug. It now functions as intended with a 2 stack maximum and the text description has been changed to reflect this. (Other traits added via events cannot stack).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the Potent trait was not included in Doll scoring.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cards like Dreaming Dragon will no longer pull Refinement from their random sorcery pools.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the event option \"Choose 1 ≤2 MP pawn to gain Potent\" could select pawns with cost > 2 MP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved UI color scheme for better distinguishability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks for your feedback. We'll keep on fixing any bugs you find!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
