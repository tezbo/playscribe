  {
   "id": "cubic-cosmos-348835@1.0.7",
   "gameId": "cubic-cosmos-348835",
   "displayName": "Patch 1.0.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-18T14:13:59.000Z",
   "notes": [
    {
     "title": "Hail, Cosmonauts! See below for details on update v1.0.7",
     "items": [
      {
       "text": "Version Number: v1.0.7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Time: 2026/6/19 13:00 UTC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "When a Relic card gains a Lasting attribute buff, it will now be retained after the end of the battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pierce damage dealt by the player to their own hero is capped at 1 point of damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimized interactions on Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved sound effects in some screens, and added some missing sound effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue with notification layering in some screens on Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where some creatable cards could not be viewed in some screens on Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We are immensely grateful for your incredible support. This is just the beginning! Your feedback will directly shape the future of Cubic Cosmos as we continue to optimize and deliver amazing new experiences.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
