  {
   "id": "cubic-cosmos-348835@1.0.5",
   "gameId": "cubic-cosmos-348835",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-29T13:29:59.000Z",
   "notes": [
    {
     "title": "Hail, Cosmonauts!See below for details on update v1.0.5",
     "items": [
      {
       "text": "Version Number: v1.0.5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Time: 2026/5/29 13:00 UTC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Adjusted the effect of the Variant Relic Dynamax: attribute increase reduced from 40% to 30%, but this bonus is no longer removed when the card is destroyed or returns to hand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Optimized several interaction details for Steam Deck and fixed some freezing and focus loss issues.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Optimized tutorial flow details for Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue on Steam Deck where the menu could still be opened during hidden events.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where cards copied by Mirage to your hand when interacting with Furious Giant would retain the buff from Raging Giant.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where cards copied by Clone Mirage to your hand would retain the cost increase effect from Boss Midnight Augur.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where MP cost reductions provided by Falsefruit events failed to stack properly and wasn't counted in Doll scoring, and added a Buff icon display for this effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Select button would appear in the ascension interface even when only 3 cards of the same name were available for ascension.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where unsold cards in the Shop did not display Creatable icon in their initial state.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where card tips remained displayed after closing certain interfaces.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We'll keep on fixing any bugs you find!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
