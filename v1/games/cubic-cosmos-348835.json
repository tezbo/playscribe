  {
   "id": "cubic-cosmos-348835@1.1.4",
   "gameId": "cubic-cosmos-348835",
   "displayName": "Patch 1.1.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-08-13T06:05:05.000Z",
   "notes": [
    {
     "title": "Hail, Cosmonauts! See below for details on update v1.1.4",
     "items": [
      {
       "text": "Version Number: v1.1.4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Time: 2026/8/13 06:00 UTC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "The Doll Pidge no longer has a trigger limit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The random pool for the Relic Auto-Magus now excludes cards that initially have the Auto trait.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where immediately triggered skills could cause incorrect skill targeting in long skill chains.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the card-draw effect of the hero skill Overclock was triggered incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where card display in the Codex was abnormal after enabling and then disabling the Temp Unlock All Items feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with abnormal Relic trigger counts in battle code.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Next Level button displayed abnormally when performing specific operations after opening the Settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where certain buff icons were not displaying.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you discover any bugs or other issues that affect your experience during gameplay, please be sure to contact us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'll keep on fixing any bugs you find!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
