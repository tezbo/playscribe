  {
   "id": "cubic-cosmos-348835@1.0.4",
   "gameId": "cubic-cosmos-348835",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-21T13:36:00.000Z",
   "notes": [
    {
     "title": "Hail, Cosmonauts! See below for details on update v1.0.4",
     "items": [
      {
       "text": "Version Number: v1.0.4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Time: 2026/5/21 12:00 UTC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Added a new \"Gradual Effect Speedup\" feature, available from the Settings page. When enabled, triggering multiple consecutive effects will gradually speed up animations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Marionette now has a unique creatable pawn. This fixes an issue where interactions between Marionette and Witch's Bond would cause enemy Thralls to erroneously launch attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When Evil Within and Candle Canon trigger their own skills or obtain temporary skills, icon flicker effects will be merged together to speed up effect animations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved Mega Snowball's skill mechanism to prevent an issue where the skill would be erroneously triggered for unknown reasons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved card surface and typesetting, slightly increasing space for descriptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved card interaction experience on Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Steam Deck UI interaction issues.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where adding multiple \"+1 targets\" effects to a card via events would cause the effects not to stack properly and not be factored into card score calculation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed UI flickering and out-of-bounds issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed placeholder achievements from bottom-left corner of Challenge Achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'll keep on fixing any bugs you find!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
