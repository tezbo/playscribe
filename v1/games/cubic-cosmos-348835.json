  {
   "id": "cubic-cosmos-348835@1.1.6",
   "gameId": "cubic-cosmos-348835",
   "displayName": "Patch 1.1.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-09-30T02:28:36.000Z",
   "notes": [
    {
     "title": "Hail, Cosmonauts! See below for details on update v1.1.6",
     "items": [
      {
       "text": "Version Number: v1.1.6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update Time: 2026/9/30",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Added card Amazing Chest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted MP reset logic when starting battle. It will take place after drawing your starting card, avoiding situations where MP gained after drawing and playing an Auto card is reset.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where skill trigger counter achievements could overlook data.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the Splash effect where some cards could destroy bosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed effect stacking issues when obtaining two Fido or Quackary Dolls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed boss error issues when entering Duel Mode 6 or 7 via the purple button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues when ordering heroes to attack using the gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We'll keep on fixing any bugs you find!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
