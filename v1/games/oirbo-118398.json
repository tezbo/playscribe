  {
   "id": "oirbo-118398@0.9.28",
   "gameId": "oirbo-118398",
   "displayName": "Update 0.9.28",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-10T15:48:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone \\o",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been a while since the last update, we decided to stop the weekly updates and push to wrap the Control Bay area, still, we will be making smaller updates and fixing some issues you guys report to us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are aiming for a June/July release but it will depend a lot on the boss of the control bay area (we have wacky plans xD).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Until then, keep that feedback coming, we will try to at least do an update a month until the release date!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again for playing!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "0.9.28 changelog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue with Dark Tiles not aligning correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple decoration pop-in issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed background multiple-layer issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue on Nature Bay where the player would spawn in a dark area without it being dark",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed N dash bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed dash-jump bug from the ground (sorry xDDD)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Configured Natured Bay thermostat to a nice 5ºC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
