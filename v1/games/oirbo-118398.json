  {
   "id": "oirbo-118398@major-2025-02-25",
   "gameId": "oirbo-118398",
   "displayName": "Oirbo new update is live!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-25T16:02:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just launched a new update fixing some reported issues!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you are having trouble with the boss keys in the Nature bay or Control Bay area reach out to us directly to contact@imaginationoverflow.com or our Discord Server we will help you out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We had a bug that used more than one key to unlock only one door, thus making it impossible to reach the Nature and Final boss. Fortunately, the bug wasn't that easy to trigger thus not many players were affected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We already started the console ports so expect news about them soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.2.0 changelog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed camera issues on Astral sections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue that allowed the camera to focus places where Oirbo wasn't visible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed boss keys issue on the Naturel and Control Bay areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "SFX and MX improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Performance enhancements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
