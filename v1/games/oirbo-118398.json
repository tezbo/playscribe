  {
   "id": "oirbo-118398@0.9.25",
   "gameId": "oirbo-118398",
   "displayName": "Update 0.9.25",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-07T17:20:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another update is coming to you guys, almost clearing all outstanding issues, only a \"\"couple\"\" more to go, hope you guys enjoy it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The biggest change in this update was making Oirbo movement adaptative to the analog sticks, we are working on a new animation to smooth things up, but until then tell us what you think!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again for the feedback, and do let us know your thoughts on the changes we made!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "0.9.25 changelog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Oirbo movement speed is now sensible to the analog stick (walking animation incoming)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed zoom in/out buttons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue that allowed the \"exchange\" of damage between Oirbo and enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Cargo Bay boss attack patterns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with Nature Bay boss hitboxes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
