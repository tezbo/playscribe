  {
   "id": "the-crew-2@major-2023-07-05",
   "gameId": "the-crew-2",
   "displayName": "TC2 Season 9 Patch Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-07-05T08:00:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "American Legends is back! Introduced in Season 5, we're bringing it back in style with a fresh new batch of stories. Kicking off American Legends, is an introduction to our Motorfest host herself, Malu! Delve deep into her memories and discover information about her life.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Coming up in Season 9 is an update we've all long anticipated, the Race Creator! With the addition of the Race Creator into The Crew 2, it's going to allow players to create races never before seen in The Crew franchise. Players will be able to create, share, and celebrate each other's content opening a world of possibilities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For a more detailed breakdown of the content released with The Crew 2 Season 9 Episode 1: American Legends, please refer to the Content Overview. Please follow our official channels for any additional updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
