  {
   "id": "double-dragon-revive-308051@1.3.0",
   "gameId": "double-dragon-revive-308051",
   "displayName": "Update 1.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-17T06:41:37.000Z",
   "notes": [
    {
     "title": "▼ Patch Notes",
     "items": [
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved Controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted inputs for attacking downed enemies. Previously, attempting a follow-up attack on a downed enemy often resulted in a grab. We have adjusted the sensitivity to ensure attacks on downed enemies are easier to execute.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Hint Message Updates",
     "items": [
      {
       "text": "Updated the hint messages displayed when defeated in a boss battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Addressed several other minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
