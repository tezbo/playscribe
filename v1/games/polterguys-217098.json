  {
   "id": "polterguys-217098@post-2025-05-02",
   "gameId": "polterguys-217098",
   "displayName": "Patch Notes – Shuffle Play, Fixes & More!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-05-02T14:10:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Polterguys Update Now Live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new patch is out for Polterguys. This one focuses on bug fixes and gameplay improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New! - Level Shuffle option added to Custom Games - as suggested by our community",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Holiday Hoarders - improved AI pathing so the monster is less likely to land on your head",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More fixes to level exploits -- keep those reports coming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvements to Custom Game settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several Costumes have rediscovered their Special Abilities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localization fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera behavior on Big Possessable Objects (like the Furnace and Dancing Knight Armor) has been improved for a smoother experience",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed carbonation issues with soda cans",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Revamped the Networking Information overlay — Dom wants your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for playing and for all the feedback — more updates coming soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
