  {
   "id": "polterguys-217098@major-2025-10-01",
   "gameId": "polterguys-217098",
   "displayName": "🎃 Halloween Update: Ghoul Scouts and Haunted Trails",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-01T11:16:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spooky season is here and so is our biggest update yet. We’ve added a brand new level, costumes with special powers, themed emotes, fresh avatars, and a new quest path to unlock it all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What’s inside",
     "items": [
      {
       "text": "New Level: Ghoul Scouts – explore the haunted woods for the first time. Don’t get lost out there.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Costumes with abilities – Backpack, Bug Zapper, Shroomfrog - all with special abilities!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Customisation – 3 new emotes, 3 themed profile avatars, and 3 trophy avatars for leaderboards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42918594/4af63836fa9a92c594f5b8e8b1bf2cbda917bac7.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "How to unlock",
     "items": [
      {
       "text": "Everything is tied to a new limited-time path called Haunted Trails Quest. You’ll find it in the shiny new Story Quests tab on the main menu. Eight quests in total, each marked in a special colour so they stand out. Complete the path to earn costumes, emotes, and avatars. When spooky season wraps up, all rewards move onto the regular Spooky Trail, so nothing disappears forever.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update your game, head into Story Quests, pick Haunted Trails, and dive into the Ghoul Scouts level with your friends. Start possessing, sabotaging, and trying out the SPOOKY new looks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for playing, sharing clips, and sending feedback. We’re having a blast making these updates and can’t wait to see you all have fun with them!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– The Polterguys team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
