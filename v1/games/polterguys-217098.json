  {
   "id": "polterguys-217098@1.0.9",
   "gameId": "polterguys-217098",
   "displayName": "Patch 1.0.9",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-09-10T15:08:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey ghouls,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.0.9 is live today with a mix of new features, balance tweaks, and bug fixes. Here is what you can expect:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay changes",
     "items": [
      {
       "text": "Respawn game mode. Come back to life by moving your goo into the yellow circle. Available in Quickplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Witch’s Hat grow ability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved critter zone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Inactive player detection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dialog skipping in the tutorial.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug fixes and quality of life",
     "items": [
      {
       "text": "Countdown text thickness fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Trophy material fixed in Riptide Reef.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Persistent ice block after Midas Touch removed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved error, disconnect, and wait tracking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various analytics improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42918594/1f4fb2552a0166713495eddc949c15c1854035c6.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We appreciate all the feedback. Keep it coming and we’ll keep making Polterguys the best way to annoy your friends.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "– The Polterguys Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
