   "id": "polterguys-217098@major-2026-02-13",
   "gameId": "polterguys-217098",
   "displayName": "Balance Update Now Live!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-13T14:52:19.000Z",
   "notes": [
    {
     "title": "This update is now live. Here are the patch notes",
     "items": [
      {
       "text": "Jester hats (costume ability charge ups) have been turned off",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Major mobility tuning: lower jump height/speeds, reduced hiding spot ejection force, softer knockback across abilities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Force zones & bouncers rebalanced for cleaner movement and fewer cheese escapes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Costume abilities nerfed: removed invincibility/invisibility, reduced flight time, height, and jumps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cloud Hopper now auto-deploys with 2 jumps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Multiple level fixes to block easy skips, fence hops, and unintended safe spots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thanks for playing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Polterguys team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
