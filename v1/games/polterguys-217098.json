   "announcedAt": "2025-08-19T13:50:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.08 is now live. If you’ve been gunning for the top spot on the leaderboard, there’s now something to show for it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New in this patch",
     "items": [
      {
       "text": "• Weekly leaderboard winners now wear the Trophy costume… for one week only",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• News UI rework for cleaner layout",
