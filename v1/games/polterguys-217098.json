       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Fixed gamepad double scrolling in News UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Increased shadow resolution",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42918594/d70cff0790c6730fc1eeb43c723b9a1042c56132.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
