   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "● Changed quality of textures for inputs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Added a marker to better guide players towards the caves with Probes on Day 14.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Damages received by Moon are reduced in the bunker of Sector C.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fix a bug making the guitar achievement too difficult to obtain",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fix an issue with some UI elements keeping their chromatic aberration even if the option was disabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Some fixes have been made in texts and credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Improve streaming logic to fix some crashes related to level transitions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
