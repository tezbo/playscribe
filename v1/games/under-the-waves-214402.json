  {
   "id": "under-the-waves-214402@1.02",
   "gameId": "under-the-waves-214402",
   "displayName": "Patch 1.02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-06T08:00:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello divers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Under the Waves has been out for a bit more than a week now and we are very grateful for the all the positive feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's amazing to see so many people enjoying Stan's journey in the North Sea. Thanks everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are aware that some of you are experiencing bugs and we are truly sorry for that. The team is focusing on fixing them and will continue to update the game in the coming weeks to ensure a smooth experience for everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Today, we release the first main patch for Under the Waves",
     "items": [
      {
       "text": "● Fixed music being abruptly cut.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed unlimited oxygen during Day 14.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed a misplaced objective marker during drill activation objective.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed some interactions not being enabled after finishing the game (bed, jellyfish at the window).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed galleon trophy being not obtainable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed containers mission not being started after reloading the game during Day 03.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed Stan being unable to enter in Moon during containers mission during Day 03.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed Moon being stuck in an explosion loop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed a crash when using a mine on a grid at Transit Street",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed screen tearing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For all players experiencing issues with the game, please do not hesitate to reach out to our dedicated customer support page so we can assist you: https://support.quanticdream.com/hc/en-us/categories/18545512054036-UNDER-THE-WAVES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
