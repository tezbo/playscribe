  {
   "id": "under-the-waves-214402@1.0.5",
   "gameId": "under-the-waves-214402",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-06T08:25:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greeting divers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new patch is available for Under the Waves! This one introduces widescreen support and bug fixes as well as stability improvements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch note",
     "items": [
      {
       "text": "● Wide screens are now supported.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed some visual glitches in the Life Module.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed dialogs and markers related to objective “Decontaminate the Whale”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed blocker in crafting mission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed a crash related to AIs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Fixed crashes related to particles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Improved feedback for the Dispatcher puzzles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Updated some facial animations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "● Platinum achievement will be correctly unlocked for players being stuck due to previous issues with achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
