   "id": "adventure-bar-story-279048@1.0.1",
   "gameId": "adventure-bar-story-279048",
   "displayName": "Update 1.0.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-06-06T02:46:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have added and fixed the following three features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "①Implemented autosave",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have decided to perform an autosave when you \"open\" a store.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have added an autosave slot to the top of the loading screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "②Added \"Custom\" to keyboard controls",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can select this in Option → System → Keyboard \"Configurations\".",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can go to the customization screen from the menu button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "③Changed the default setting of \"Vsync\" to OFF",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is a change to the default settings, so there will be no changes for users who have already played the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you find that your cursor or character movement is too fast, try turning off the \"Vsync\" setting, which can be set in Option → System.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
