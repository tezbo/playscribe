   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we released an update for Cladun X3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It primarily includes bug fixes and quality of life improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes in this patch have changed the game's Steam Deck verification to Verified.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "In the \"Download Cladun X2 & This Is Sengoku Edit Data\" menu, password input now supports pasting from clipboard (Ctrl + V).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the game could freeze in dungeons such as Bird Cage 1F under specific circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue on Steam Deck where the game would not exit immediately when closing the game from the title screen.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where menu scrolling using a laptop trackpad would continue indefinitely under specific device configurations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted birthday entry text and UI to clarify that birthday information is never sent to the game server. (See this post for further information)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where specific text was displayed with the incorrect font.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor text fixes. (English, French)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues with this patch, please post to the troubleshooting forums or contact us at gamesupport@nisamerica.com .",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
