  {
   "id": "horripilant-342102@post-2026-06-07",
   "gameId": "horripilant-342102",
   "displayName": "DirectX12 now available!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-06-07T19:19:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I've updated the launch options on windows to include a new launch option: DirectX12.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We've had a handful of reports of people lagging after long play sessions in the base game, and we believe it was probably caused by Vulkan implicit layers breaking from faulty software like recording software, eg: old versions of OBS, Steam Recording, clipping software like SteelSeriesGG, Medal, etc..",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you are playing on Windows and are experiencing lags after long play sessions, give this new launch option a try! If you lag a bit at the start - it's probably shaders compiling, give it a minute.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A new small patch is coming soon as well!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Alex",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
