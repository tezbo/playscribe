  {
   "id": "lushfoil-photography-sim-189934@post-2025-12-11",
   "gameId": "lushfoil-photography-sim-189934",
   "displayName": "10/12 changenotes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-12-11T06:34:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Desktop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added 'center dot' option to controls menu, to help with motion sickness",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fixed controller navigation in the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "added glisten effect to snow",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "VR",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed spectator screen display. press space to toggle between VR view, last photo taken, or both side by side",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "extended view distance cap from 2.0 to 5.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added TAA option to anti-aliasing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "increased overall sharpness",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "improved reflections in lago di braies, castle rock beach sunset, and iceland",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Heard loud and clear that I'll need to bump up the VR visual quality! Expect more improvements in the coming days/weeks 👍",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
