  {
   "id": "lushfoil-photography-sim-189934@patch-2025-05-01",
   "gameId": "lushfoil-photography-sim-189934",
   "displayName": "1st May Patch Changenotes",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-01T07:47:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "added 'unlock all' command to locations menu, press \" \" while the menu is open",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "made environment unlock requirements slightly lower",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed cropping on long exposure + lens fixed focal length",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "added B&W filter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "\"G\" godmode toggle hotkey (only used while godmode is already active)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed ambient sound cutting out on some environments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "essential mardi himal progression fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed resolution selection issue on some setups",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed output resolution being stuck on 1080p",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed 'save to disk' accidentally being switched off",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed digital camera zoom",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed kite behaviour on high framerates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed camera smoothing incorrect menu selection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "prevented fish from flying (hopefully) 🙄🙄",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed 'upscaling' selection with controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "decreased time it takes to unlock 'enthusiast' achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "fixed line through fushimi inari sky",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "prevented duplicate tips from appearing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "prevented photo browser next/prev keys from switching music",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed yamadera photo board not de-spawning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "added subtle wave position influence to SUP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "prevented fast travel from SUP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed item wheel not appearing when GPS is unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "smaller per-level fixes, like glitches, falling out of bounds etc: thanks for your patience, working alone so just tackling everything one at a time, to make sure it's done right. It's still likely some problems have slipped through, If you find anything, please let me know via our bug posting channels on discord: https://discord.com/invite/Kv2NEynADy: Cheers!: -Matt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
