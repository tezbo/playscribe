  {
   "id": "lushfoil-photography-sim-189934@post-2025-07-11",
   "gameId": "lushfoil-photography-sim-189934",
   "displayName": "7/11 changenotes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-11T06:20:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "sorry for the wait, had a lot of compilation issues this month, but we made it through 😓",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "updated to unreal engine 5.6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "changed engine from a source build to native build (should be more stable, to help with compatibility issues and crashes)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed lago di braies sky not appearing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed black loading screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "added cancel to long exposure photo when camera is put down",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "prevented photo archive animation from playing in fullscreen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed yamadera softlock when using \"unlock all\" cheat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "other small fixes/tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "re-added multiplayer (hidden behind cheat code- check discord for this): hope you all are well, been really great to see so many people enjoying the game: -Matt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
