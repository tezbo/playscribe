      {
       "text": "Some initial bug fixes, thank you all for reporting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed Vesper Mines map where it could get one player stuck when playing coop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed player getting stuck when dying while falling in a pit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed allowing the player to get themselves stuck with certain carryable objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fix falling in a certain pit in Dreadmoor Palace not respawing at the right location",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed Controls screen getting stuck in some cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed setting Heal on the same button as \"Back\" would result in using a flask after closing a screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "some other bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
