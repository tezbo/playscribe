   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "diagonal lovers rejoice! due to advancements in technology you can now attack with swords in the bottom-right corner",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "buffed stamina regeneration: every 5 stamina levels it regenerates faster",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "nerfed the falling rocks in the mines, they only do damage when on the ground, when they are in the air (shadow visible) they no longer hurt the player; also reduced their number in some rooms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "fixed a bug while playing coop where one player could revive due to a specific Token",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "very small adjustments to the map and minimap",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed calculating wrong reset position after falling in a specific room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "better telegraph the map change during a certain boss fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "small performance optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
