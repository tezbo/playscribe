 "releases": [
  {
   "id": "super-woden-rally-edge-350456@1.030",
   "gameId": "super-woden-rally-edge-350456",
   "displayName": "Update 1.030",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-05T12:14:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "You can now create custom car skins for the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This system is simple and does not require mods or special in-game tools.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Go to the game installation folder and open",
     "items": [
      {
       "text": "(Game folder)\\\\Super Woden Rally Edge_Data\\\\StreamingAssets\\\\CAR_SKINS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Inside this folder you will find",
     "items": [
      {
       "text": "Subfolders for each car manufacturer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Inside each one, a subfolder for each car model",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Example",
     "items": [
      {
       "text": "CAR_SKINS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "└─ Soop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "└─ Spencer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Inside each car model folder there is a file called",
     "items": [
      {
       "text": "template.png",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This image contains",
     "items": [
      {
       "text": "The basic elements of the car",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The outline of the model",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It is meant to be used only as a visual guide to know where each part of the car is mapped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "3. Creating your own livery",
     "items": [
      {
       "text": "Open your preferred image editing software",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(for example Photoshop, Paint.NET — free —, GIMP, etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The software must support layers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Open template.png",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Arrange your layers as follows",
     "items": [
      {
       "text": "Top layer: template.png",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bottom layer: your custom skin (this is where you paint)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Design your skin using the template as reference.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "When you finish",
     "items": [
      {
       "text": "Hide or delete the template layer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save only the skin layer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The file must",
     "items": [
      {
       "text": "Be saved in the same car folder",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Use PNG format",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Be named with a number, starting from 0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Examples",
     "items": [
      {
       "text": "0.png → first custom skin",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.png → second custom skin",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2.png → third custom skin",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "5. Example liveries",
     "items": [
      {
       "text": "In the same folder you will find images with the default game liveries.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "These files are for reference only",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Editing them will not change the in-game textures",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "They are provided to help you understand how the original skins are made",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Simply delete the custom skin file you created",
     "items": [
      {
       "text": "0.png, 1.png, etc.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game will automatically use the default skin again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "To see your skin in the game",
     "items": [
      {
       "text": "Launch the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reselect the livery in the menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The texture will update immediately. Restarting the game is not required.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy creating and sharing your custom car liveries!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
