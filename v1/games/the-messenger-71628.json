   "notes": [
    {
     "title": "New Game+ mode",
     "items": [
      {
       "text": "-NG+ is additive, where each subsequent cycle increases difficulty, but also lets you lock in an item to have from the start, making the quest shorter every time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Tread carefully; in NG+, you need to pay Quarble upfront, or it’s GAME OVER",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Can you beat the dev’s high score of New Game+7??",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Controls remapping",
     "items": [
      {
       "text": "-Accessible through the pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Dialogue turbo speed",
     "items": [
      {
       "text": "-Hold right trigger (default) and jump to skip text as fast as possible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Underwater labyrinth accessibility",
     "items": [
      {
       "text": "-A visual effect (bubbles) will be there for adventurers who carry the Magic Seashell",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Prophet hints now accessible directly in the map",
     "items": [
      {
       "text": "--Can be toggled on and off",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Jukebox",
     "items": [
      {
       "text": "-Accessible in the Shop after finding your first Music Note",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Accessible through the pause menu after first discovering it in the Shop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Updated Windmill Shuriken",
     "items": [
      {
       "text": "-Accessible from the start in NG+",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Charges now based on a cooldown timer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Hitting targets with it also gives a cloudstep",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Miscellaneous bug fixing, none of which affecting speedrunning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
