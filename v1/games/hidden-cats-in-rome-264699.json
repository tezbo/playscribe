  {
   "id": "hidden-cats-in-rome-264699@post-2026-09-16",
   "gameId": "hidden-cats-in-rome-264699",
   "displayName": "General Bug Fixing",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-09-16T20:06:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to say that we've fixed the following issues in this latest update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Steam Cloud not working",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Duplicated characters on isometric no longer occur",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Castle of Holy Angel not activating",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Main level doesn’t fill in the color for the sidewalk",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Hint shows cat that isn't related to bottom message",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope these fixes improve your overall experience of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let us now if everything works as intended for y'all now, happy Finding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
