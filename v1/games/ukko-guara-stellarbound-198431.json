  {
   "id": "ukko-guara-stellarbound-198431@1.0.0.0",
   "gameId": "ukko-guara-stellarbound-198431",
   "displayName": "Patch 1.0.0.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-08-15T17:33:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re excited to announce a new major update! With the launch of Ukko & Guará: Stellarbound on consoles, we’ve made several improvements across all platforms. To reflect these enhancements, the game version has been updated to v1.0.0.0 (2025).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s what’s new",
     "items": [
      {
       "text": "Added a Best Time Leaderboard to track your fastest playthroughs of the main game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Introduced a Three-Star Scoring System to reward level perfection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Numerous visual and effects enhancements for a more immersive experience",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved gamepad support and responsiveness",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Game design refinements for better flow and challenge balance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General bug fixes and stability improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
