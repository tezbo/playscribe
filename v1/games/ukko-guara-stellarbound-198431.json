       "text": "Save game algorithm improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement: smoother aiming with the gamepad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement: button to facilitate gameplay for young children",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement: scroll down the level selection screen when navigating with controls",
       "ps5ProOnly": false,
