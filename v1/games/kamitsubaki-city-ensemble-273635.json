  {
   "id": "kamitsubaki-city-ensemble-273635@1.6.0",
   "gameId": "kamitsubaki-city-ensemble-273635",
   "displayName": "Update 1.6.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-26T15:23:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[Adjustment Details]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of \"Extension Pack No.9 feat. V.W.P\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of \"Extra Pack feat. ASU\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the colors of the notes color type \"TYPE-OLD\" were not displayed correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where certain song vocal names were cut off after \"feat.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where some key guides blended into the background when opening game settings after song selection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where blinds did not function properly with the new lane model",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the scrollbar position was not reset in the dialog that appears when adding songs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where only Simplified Chinese song titles had inconsistent font sizes in the song addition dialog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the effect of tapping light blue notes was misaligned when using the \"PATTERN-PC\" lane type",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the \"OK\" button sound effect did not play when using keyboard controls in the \"Customize\" screen of each section",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Other minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are continuously addressing and fixing other issues as they are discovered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We sincerely apologize for any inconvenience caused and kindly ask for your continued support of \"KAMITSUBAKI CITY ENSEMBLE.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
