   "id": "kamitsubaki-city-ensemble-273635@major-2025-01-29",
   "gameId": "kamitsubaki-city-ensemble-273635",
   "displayName": "Major Update! & Season Pass Vol.2 Now Available!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-29T18:56:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[Adjustment Details]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of \"Season Pass Vol. 2\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of \"Season Pass Benefits Pack 2\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of \"Extension Pack No.8 feat. V.I.P\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of two free songs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Implementation of Simplified Chinese and Traditional Chinese translations for song titles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjustment of the layout in the settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of a feature to configure detailed settings before starting the rhythm game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of a new notes color type",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of \"PATTERN-PC\" as a lane type",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of a display for \"FAST\" and \"LATE\" counts on the result screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of an ON/OFF toggle for lane increase/decrease animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the set sorting order was not saved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Other minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[\"Season Pass Vol. 2 \" is now available]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can play all 8 additional song packs scheduled to be released by the end of May 2025, as well as 5 exclusive songs!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The exclusive songs include tracks from the newly added artist \"Albemuth\" (ASU & ARU).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that items that have not yet been released cannot be played until they are distributed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[\"Extension Pack No.8 feat. V.I.P \" is now available]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Includes songs by the five members of V.I.P!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hum along to some brand-new melodies!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*This product is included in another item, \"Season Pass Vol. 2\". Please be careful not to purchase duplicates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are continuously addressing and fixing other issues as they are discovered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We sincerely apologize for any inconvenience caused and kindly ask for your continued support of \"KAMITSUBAKI CITY ENSEMBLE.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
