   "id": "lifeless-moon-27933@1.42",
   "gameId": "lifeless-moon-27933",
   "displayName": "Update 1.42",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-22T19:35:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! Finally posted a new update to the game, mostly fixing a bunch of smaller issues at this point. However, as part of the console porting process, I updated the game to a new version of Unity. This broke a ton of assets and took extra time to fix things. I think it's looking pretty good now and maybe even looks and plays a little better than on the old version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I also added a feature for users with disabilities. Additional notes in the readme file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
