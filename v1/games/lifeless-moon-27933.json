   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi folks, pretty minor update this time. Will probably wait a couple weeks or so for the next more substantial update. Here's the rundown on this new build:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed sky city buildings moving into position too fast during cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed cave elevator pushing player into ground if they stand under it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Disabled player re-entering cabin after puzzle solved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Misc small bug fixes with gameplay and minor visual issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
