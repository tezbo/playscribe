   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Announcement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released patch Ver.1.0.8, which fixes the following issues.: Fix Details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where the achievement \"Reverse Numazu Master\" could not be obtained.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where ending the game under certain conditions prevented the acquisition of \"Power Style\".: Additional Information",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We will continue to address other reported bugs and issues as we move forward.: Thank you.",
       "ps5ProOnly": false,
