   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-08-21T05:03:07.000Z",
   "notes": [
    {
     "title": "Announcement",
     "items": [
      {
       "text": "We have released patch Ver.1.0.14, which fixes the following issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fix Details",
     "items": [
      {
       "text": "Fixed an issue where characters appearing randomly under certain conditions in the \"Fortune-Telling Shack\" could unintentionally be biased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in some events that randomly upgrade cards where already upgraded cards could be selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some mistakes in translation text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
