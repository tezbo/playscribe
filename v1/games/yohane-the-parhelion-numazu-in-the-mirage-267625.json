   "gameId": "yohane-the-parhelion-numazu-in-the-mirage-267625",
   "displayName": "Patch 1.0.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-14T08:04:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Announcement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released patch Ver.1.0.7, which fixes the following issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix Details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the effect of a charm that increases maximum HP under specific conditions would reset.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where charms that were once obtained and then lost could not be purchased when they appeared in the shop again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made additional fixes for a bug that prevented the acquisition of certain achievements.: * Adjustments have been made so that those who have already met the conditions for achievement can now obtain them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some text errors.: Additional Information: We will continue to address other reported bugs and issues as we move forward.: Thank you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
