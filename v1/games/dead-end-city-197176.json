   "id": "dead-end-city-197176@1.1.08",
   "gameId": "dead-end-city-197176",
   "displayName": "Update 1.1.08",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-03T15:30:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "(Bug) The Score Attack select screen was displaying incorrect high score data.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) In some cases, the game data array was being accessed before it was created. It is now created earlier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Steam was being initialized before game data was initialized. It is now done in the correct order.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
