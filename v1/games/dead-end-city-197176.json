  {
   "id": "dead-end-city-197176@1.0.06",
   "gameId": "dead-end-city-197176",
   "displayName": "Update 1.0.06",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-21T19:17:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "(Bug) Player ammo icons were sometimes wrongly positioned at the start of a new area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Rockset's special shot was not properly generating medals on bosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a small speed increase over time to Hettie's special shot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "(Bug) Hettie's hairball special shot would sometimes overshoot the target and not lock on. Every step is now checked for distance.: Also, I have begun work on a new mode to be added to the game in the near future (whenever I finish). :) It will be a free addition and hopefully adds to your enjoyment of the game. --Pixel Licker",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
