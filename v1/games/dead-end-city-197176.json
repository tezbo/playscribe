  {
   "id": "dead-end-city-197176@1.0.03",
   "gameId": "dead-end-city-197176",
   "displayName": "Update 1.0.03",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-15T20:40:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "(Bug) Gampad confirm button was not recognized in the Score Attack select screen after an initial play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Some Score Attack Steam leaderboard calls were misnamed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a Friends sort option to the High Score Tables. It currently only sorts the top 5 scores, but the plan is to add scrolling in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "(Bug) Enemies with no point value still granted a multiplier score bonus when killed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boss grunt enemies no longer spawn item drops indefinitely. Only the first round of grunts will spawn item drops.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Leaderboard numebring displayed a \"9\" in both fonts in certain cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) The x9 icon would appear on enemies worth no points. It now only spawns when points are awarded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Gamepad up/down inputs were not working on the Gallery screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
