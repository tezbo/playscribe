  {
   "id": "dead-end-city-197176@1.1.07",
   "gameId": "dead-end-city-197176",
   "displayName": "Update 1.1.07",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-09-25T17:33:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added more thorough update check for data changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reset the difficulty variable when entering Highway Mode.: This update is mostly to fix issues with older versions of the game not updating to the more recent data changes. This will fix crashes that people were seeing on startup. I am not sure if this will play nice with steam cloud files, so if you are still seeing a crash on startup, let me know in the discussion.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
