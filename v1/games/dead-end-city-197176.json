  {
   "id": "dead-end-city-197176@1.0.07",
   "gameId": "dead-end-city-197176",
   "displayName": "Update 1.0.07",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-25T17:43:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "(Bug) Medal counters were not reset if a Rival fight was activated, causing the final game Results screen to display incorrect information.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Medal counters were not reset properly if Restart Run was used, causing the final game Results screen to display incorrect information.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Airstrike strafe bullets were not using the enemy bullet color defined in the game options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Landmine, ammo gain, desert boss door open, many final boss sounds and Topoff sound fx were not affected by the sfx volume.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Ending bgm was not affected by the bgm volume.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added 14 new achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added preliminary Steam cloud saving.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
