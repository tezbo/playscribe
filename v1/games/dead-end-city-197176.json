  {
   "id": "dead-end-city-197176@1.1.02",
   "gameId": "dead-end-city-197176",
   "displayName": "Update 1.1.02",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-08-24T14:05:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "(Bug) There was a small bug in the default data regarding Highway mode. The default highway scores were populated with high values (instead of 0). This made it seem like leaderboards were not working. The new default data set corrects this problem.: NOTE: Pressing \"L\" on the boot screen should correct this issue. The new data will be used in any fresh install of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
