  {
   "id": "dead-end-city-197176@1.0.08",
   "gameId": "dead-end-city-197176",
   "displayName": "Update 1.0.08",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-27T19:40:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "(Bug) Sound Test was accessible even when it wasn't purchased in the Shop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Upon leaving the Sound Test, the Title bgm was not restored.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Scanlines caused the game to rescale incorrectly on displays with different resolutions. The screen size is now handled a little differently when calculating the final scanline output.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) Switching between fullscreen and windowed mode with scanlines active sometimes caused the screen to be resized incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "(Bug) Starting the game with scanlines active sometimes caused the screen to be resized incorrectly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) The gallery numbering began with 0. It now begins with 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Bug) The gallery's final image was not displaying.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
