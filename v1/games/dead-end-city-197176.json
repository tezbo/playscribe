  {
   "id": "dead-end-city-197176@1.1.00",
   "gameId": "dead-end-city-197176",
   "displayName": "Update 1.1.00",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-02-14T20:37:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Highway Mode - a caravan stage unique to each driver that uses a modified rule set.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Lot of minor fixes and adjustments",
     "items": [
      {
       "text": "Adjusted the Boot screen to only display \"Press Z to Continue\" when input is allowed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(Bug) Shiro's Napalm shot was not scoping enemies properly. This caused some boss parts to spawn medals when they shouldn't.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(Bug) Items that are attracted to the player after death would not be collected. They are now destroyed on contact with the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the point value indicator onscreen to the Rival's death sequence. This is similar to the boss death sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rivals now release small medals on each item spawn if the score multiplier is at max (x9).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added the ability to speed up the Shop Point tally with a button press.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(Bug) End of Boss Tally bonus points for medals was not properly added to the player's score.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the sound and visual fx on the wooden barricade props.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the Unicorn Buggy shooting live area to be smaller (80 to 100px from the screen bottom).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added 1000pt bonus to enemies that are destroyed by a landmine blast.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Windows cursor is now hidden when the game is running.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Shiro Napalm damage and lifespan were adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Shiro Napalm now does more damage on initial impact. Bosses take additional damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Decreased Desert Convoy live Y area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Shiro Napalm cooldown increased from 30 to 60 frames.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Decreased Mountain Drone live Y area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Rival Shiro Napalm sorting with enemy bullets.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "All special shots (except Hettie) can now hit the bonus balloons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased Hettie's car speed from 2 to 2.25.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased Crankcase's car speed from 2.5 to 2.65.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Split the How To Play menu into Arcade and Highway sections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(Bug) Quick Restart was not loading the proper area in Highway Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated the laser art for Crankcase's special shot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added an Achievements menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added 2 new achievements for Highway mode. (Get A Rank, Get S Rank)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a Rival Appear sfx to the Tally menu after a boss fight. This required an additional pause in the Tally sequence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added new strings for Achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(Bug) Car skins were not reset between play sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(Bug) Black market achievement \"ach_buy_all_items\" was misspelled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
