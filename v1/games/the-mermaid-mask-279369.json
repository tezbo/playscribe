 "releases": [
  {
   "id": "the-mermaid-mask-279369@major-2026-07-19",
   "gameId": "the-mermaid-mask-279369",
   "displayName": "Update Notes 19th July",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-19T00:40:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another update for you today, focussing on helping folks find their way through the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added icons to indicate when a clue in your casefile might need reading, using or otherwise interacting in order to progress the story",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added button to take you from one clue to another, when it's relevant",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added check for game complete achievement on title screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed disappearing hint boxes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed hint box options resetting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted some clue page interactions to make it easier to look through",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adam and I still have a list of issues we want to tackle ASAP, mostly thanks to your reports, so thanks again, and we'll get the rest out as soon as the two of us are able!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'll also soon be able to start on a few small features that didn't quite make it to launch, so we'll share a roadmap for those soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tom-",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
