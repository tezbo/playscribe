  {
   "id": "the-mermaid-mask-279369@major-2026-07-18",
   "gameId": "the-mermaid-mask-279369",
   "displayName": "Update Notes 18th July",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-18T00:05:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adam and I have fixed some issues that folks have reported, and a few we noticed after watching others play!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue with puzzles where the game got stuck between asking for a clue, then asking for a specific part of the clue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed voice slider on title screen options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where a suspicion topic could start without the needed clue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some instances of quiet dialogue audio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an instance of missing dialogue audio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed layering in Sinthia puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thanks to everyone who's been so kind and helpful reporting issues in the Steam forum, it's made tracking these down much easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More fixes to come, see you soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tom-",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
