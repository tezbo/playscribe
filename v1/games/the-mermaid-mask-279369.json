  {
   "id": "the-mermaid-mask-279369@major-2026-03-23",
   "gameId": "the-mermaid-mask-279369",
   "displayName": "Language Update for The Mermaid Mask",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-23T20:57:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re happy to announce that The Mermaid Mask will launch with support for the following languages:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• French",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• German",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• European Spanish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Latin American Spanish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Brazilian Portuguese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Italian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Korean",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Simplified Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Traditional Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Russian",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game’s voice acting will be in English, but the full interface and subtitles will be available in all of the languages listed above.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you to our friends at Local Heroes and Kakehashi Games for their hard work localising such a wordy game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What about other languages?",
     "items": [
      {
       "text": "We know our community is wonderfully international, and we’d love to support every language possible. Sadly, there are 7,000+ languages in the world, and game development (like submarine travel) has practical constraints.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So, we’ve prioritized the languages to reach as many of our players as possible, and we’re always listening to feedback from the community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Questions?",
     "items": [
      {
       "text": "If you have any questions, feel free to leave a comment below, and we’ll do our best to help.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Otherwise, we can’t wait for you to dive into The Mermaid Mask!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
