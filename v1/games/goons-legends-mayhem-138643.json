  {
   "id": "goons-legends-mayhem-138643@1.0.2",
   "gameId": "goons-legends-mayhem-138643",
   "displayName": "Update 1.0.2",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-05-02T14:40:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "G:L&M v1.0.2.7 PC PATCH NOTES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hey everyone, we're happy to go forward with some bug fixing and new features additions like the bots/goaltenders difficulties. Hard mode soon? 👀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay updated to learn more about our roadmap for new features, for the Mayhem is only beginning!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Local/Remote Play P2 controls P1 in online matches once a goal is scored",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Shorter Power slapshot/pass range in matches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mayhem stuck when spawned right in front of the Spindle Lady goaltender",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fishmonger and Spindle goaltenders holding pucks when using abilities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Playable bots feature is broken once in Overtime mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Faceoff always performed by the lowest number Player in a team (P1, P4, etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "L-stick/L3 button performs Emote instead of X-Square button only",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased contrast on unselected menu options in Pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "New “Bots difficulty” option in match creation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New “Wave” features showing how many enemies are left in fort minigames, as well as their placement in the area",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Match faceoff reduce to a single Rock Paper Scissors minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
