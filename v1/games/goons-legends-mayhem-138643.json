  {
   "id": "goons-legends-mayhem-138643@1.0.1.3",
   "gameId": "goons-legends-mayhem-138643",
   "displayName": "Update 1.0.1.3",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-04-17T02:54:21.000Z",
   "notes": [
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Private rooms turning into public lobbies as soon as someone is invited in;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In the post-game results, players quitting are being replaced by generic bots;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Positioning of the winged puck targets in the Drake Vessel minigame makes targeting difficult in some instances;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Drake Vessel multiplayer stage not staying available in multiplayer matches when the application is closed;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "New Story beacon now made only available once you completed the story mode. \"NG+\" baby!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Completing the Oily's Garage match encounter respawning you in the overworld next to the Eastern Fort;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Golden medal icon showing in minigame post activity panel when no medal is acquired by the player;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tutorial can't be skipped without entering it, can't skip tutorial directly from the Overworld;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hold Skip button is a tad too slow;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In the Spindle Minigame, pausing the intro cinematic doesn't actually stop the cinematic;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Back from the tutorial, the lesson song is stopped after the 2nd lesson in a row;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lack of feedback on the iceberg that need to be hit in the Jarl Minigame;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Wrong texture on Morris' cardboard model texture.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
