   "announcedAt": "2024-07-04T14:10:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Nothing like a good update! There’s a lot to unpack here, so let’s cut to the chase:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fort rewards not correctly saving upon completion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Morris dash ability not working properly on certain surfaces",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Handegg dash ability not stopping correctly on certain walls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cosmo going through Handegg’s wall ability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweak on pass mechanic distance/target prioritization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Audio stutter while slowdown during replay segment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mayhem mechanic glitch on Spindle stage platform",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Spindle audio feedback stuck in specific cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Skip match intro cinematics prompt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rename region to Rondella (we don’t talk about this -_- )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rework end of match scoreboard with multiple statistics added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Kazxi stickers (GG!)",
       "ps5ProOnly": false,
