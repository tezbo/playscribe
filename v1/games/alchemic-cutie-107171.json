  {
   "id": "alchemic-cutie-107171@1.3.2",
   "gameId": "alchemic-cutie-107171",
   "displayName": "Update 1.3.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-20T19:22:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey there Cutie Club,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We small update with some fixes and an update on the Nintendo Switch and PlayStation shipping dates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Nintendo Switch & PlayStation Shipping Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "The shipping dates for both platforms slipped a little bit as we had a few bumps in the road going through final platform certification 😅",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Switch has been fully certified and has gone to manufacturing and shipping now. We’re hoping for PlayStation to finish certification this week (1 annoying bug has been hard to squash) and it will go straight to manufacturing and shipping.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Update 1.3.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We skipped 1.3.1 to combined everything into a 1.3.2 update. The update is mainly focused on bug fixes and performance improvements based on completing the Nintendo Switch and PlayStation versions of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A lot of performance improvements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hidden Power achievement now just requires a total level of 75",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shiny Shaver now just requires 10,000 crystals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Caught Them All not unlocking through item effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed wild jellies unlocking the Hidden Power achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Jelly getting stuck transforming when trait decreases relic meter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed hover texture issue on bottom HUD buttons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed JellyQuickInfo not clearing on unfocus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed birds getting stuck while landing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
