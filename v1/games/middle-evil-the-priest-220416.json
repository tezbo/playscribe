  {
   "id": "middle-evil-the-priest-220416@1.01",
   "gameId": "middle-evil-the-priest-220416",
   "displayName": "Update 1.01",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-27T18:26:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It's been a week since the game was released.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I analyzed the reviews and comments on the store page and made a small update to the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the ability to navigate in the main menu and pause menu using the mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Due to numerous requests, improved the readability of letters in the book - now they have a white background.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made some optimizations, as the game was running slower than it should on high-resolution monitors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the ability to switch to windowed mode with the \"F\" key in the main menu.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Adjusted the ghost's hitbox; now it is positioned lower than before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the depth of mushrooms relative to the character.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed some words in the control localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
