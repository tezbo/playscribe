  {
   "id": "trails-in-the-sky-1st-chapter-314936@1.06",
   "gameId": "trails-in-the-sky-1st-chapter-314936",
   "displayName": "Update 1.06",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-01T01:01:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 1.06 has been released. This patch contains the following fixes and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue in which if the \"Saved Games\" folder could not be retrieved, save data would instead be created in the drive root (e.g. C:/) of the game's installation folder rather than the game's installation folder itself. Also fixed an issue in which save data sometimes could not be loaded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "*If the \"Saved Games\" folder cannot be retrieved, save data will now be created in the game's installation folder.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "**This update does not contain fixes for Steam Cloud synchronization. If you are experiencing Steam Cloud issues, the configuration for the \"Saved Games\" folder may be corrupted, so we recommend repairing it.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Replaced some visual effects with lighter versions to improve performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue in which the game could load indefinitely for certain maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash that could occur when performing a Brave Attack with Tita as the lead party member.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in which the player could not proceed if a Brave Attack was triggered during the tutorial boss battle in the Rolent Sewers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the how the game detects completion of the \"Activate All Arts\" in-game achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected various text errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed other miscellaneous bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In addition, we have added new beta branch that contains the previous version of the game (Ver. 1.05). Please use this branch if the update causes issues. It can be accessed via the following steps:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Navigating to the game in your library",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Click the gear icon and select \"Properties\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Within the \"Properties\" menu, select \"Betas\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select the the correct branch from the \"Beta Participation\" menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the event you want to return to the latest patch, please set \"Beta Participation\" back to \"None\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
