  {
   "id": "trails-in-the-sky-1st-chapter-314936@1.06.3",
   "gameId": "trails-in-the-sky-1st-chapter-314936",
   "displayName": "Update 1.06.3",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-07-10T01:16:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 1.06.3 has been released. This patch contains the following fixes and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
