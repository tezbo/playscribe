  {
   "id": "trails-in-the-sky-1st-chapter-314936@1.06.1",
   "gameId": "trails-in-the-sky-1st-chapter-314936",
   "displayName": "Update 1.06.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-14T00:04:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Version 1.06.1 has been released. This is an update mainly addressing issues regarding Steam Family Sharing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where users were unable to load their save data if they did not have all DLC from when the save was created (such as when utilizing Family Sharing).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "An issue where certain cosmetic DLC could not be shared via Steam Family Sharing should now also be resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your patience and understanding during this process.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
