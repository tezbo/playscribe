  {
   "id": "goodnight-universe-299774@1.0.3",
   "gameId": "goodnight-universe-299774",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-24T20:36:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just released a small patch to the game, v1.0.3. It addresses some rare soft locks, some issues with subtitles in various languages, and a few other bugs (see full patch notes down below).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also wanted to use this opportunity to ask anyone who has played the game to please leave a review! We’re getting very close to the magic number (500!) and to those of you who have already written reviews, thank you so much! We truly love hearing about your experiences, even if they're very short and sweet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Fixed various rare progression blocking bugs in a few chapters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various subtitle localization issues across various chapters in the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare bug that silenced VO at a specific point in chapter 15.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that prevented the “hold eyes closed” completion sound from triggering in chapter 19.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the skip scene feature causing music to continue playing when it shouldn’t in chapter 27.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an incorrect 2D animation option based on career choice path in chapter 35.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where a loud noise could occur when using telepathic geolocation ability in later chapters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
