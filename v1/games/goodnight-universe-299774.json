  {
   "id": "goodnight-universe-299774@1.0.2",
   "gameId": "goodnight-universe-299774",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-14T23:14:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First off, thank you SO MUCH for playing and supporting the game, the reception has blown us away.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just released a small patch to the game that addresses some rare soft locks and an issue that made certain webcam setups (namely Iriun Webcam users) run very poorly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "Refactored some webcam code to fix Iriun fps drops and (hopefully) improve performance across the board",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a German translation in chapter 20",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare blocker in chapter 22",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a minor issue where a text choice could be selected unintentionally in chapter 40",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed loud noise at the leftmost geolocation boundary in chapter 42",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44999082/6938b75450eafcf92ba033339d64a36d84f7f365.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
