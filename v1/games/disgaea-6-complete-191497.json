  {
   "id": "disgaea-6-complete-191497@patch-2022-07-05",
   "gameId": "disgaea-6-complete-191497",
   "displayName": "Bugfix Patch - 2022-07-05",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-07-05T19:19:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello doods,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have an update for you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue where certain controller-like hardware was being taken as the first controller over the expected controller. Now it'll try to choose the Steam-connected controller first.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players could not save if they have certain non-ASCII characters in their Windows username.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a configuration setting to produce a crash dump on crashes. If you are experiencing crashes, go to C:\\Users\\\\AppData\\Roaming\\Nippon Ichi Software, Inc\\Disgaea 6 Complete\\, open the ID folder inside, and find the Setting.ini file, and add the following text: CrashDumpLevel = 2 The game will then produce crash dumps in the game local files.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Happy dungeoning!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
