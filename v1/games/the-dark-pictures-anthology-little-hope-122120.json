  {
   "id": "the-dark-pictures-anthology-little-hope-122120@patch-2020-12-18",
   "gameId": "the-dark-pictures-anthology-little-hope-122120",
   "displayName": "New Patch is Live!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-12-18T15:00:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We want you to enjoy this horror experience to the fullest, so we’re committed to addressing bugs and performance issues that may arise. Thank you so much for your patience as we work towards fixing them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we’re pleased to announce that we're finally releasing the first official patch for Little Hope on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Patch 1.04 implements the following",
     "items": [
      {
       "text": "General improvements to character-object interaction",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General improvements to character controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General multiplayer stability fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional missing audio in localized voice-over",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players with a save data for Man of Medan will be welcomed differently by the Curator",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes issues where the player appears to fall out of the world",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A big thank you to everyone who submitted reports, they’ve helped us immensely! We’ll continue to monitor any further issues and publish patches where necessary.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please don’t hesitate to contact our support teams if you spot any more bugs:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "EU: https://bnent.eu/TDP_Support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "US: https://fcld.ly/lh_support_us",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
