 "releases": [
  {
   "id": "bloodshore-177056@post-2025-03-03",
   "gameId": "bloodshore-177056",
   "displayName": "Dive into a deadly FMV battle royale where choices matter!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-03T16:29:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update brings minor bug fixes and optimisations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This follows a deadly televised battle royale between high-profile streamers, entertainers, and death row inmates. You control the fate of Nick, a washed-up actor who fights for a life-changing cash prize.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All is not what it seems in this latest season of Kill/Stream, the hottest reality TV show on the planet. Can Nick uncover the truth about Bloodshore Island before his time runs out?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Each playthrough changes dramatically depending on player choices and the relationships built, some will bring deadly consequences for Nick and his fellow contestants.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Published by Wales Interactive, Bloodshore is co-developed by Wayout Pictures, Good Gate Media, Posterity Entertainment and Wales Interactive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FEATURES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· 8 hours of total FMV footage, the most amount of FMV footage in any game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Decisions matter, with visual feedback on what effect they have",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Relationships are tracked and can influence the story",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· One story, several different paths and outcomes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· From the producers of The Complex and Five dates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
