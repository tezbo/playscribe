  {
   "id": "lost-ember-rekindled-edition-314439@1.0.6.1",
   "gameId": "lost-ember-rekindled-edition-314439",
   "displayName": "Patch 1.0.6.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-12-04T16:15:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another very small patch fixes some issues with detecting whether DLSS/FSR is supported in the current system. Those checks would sometimes fail even though they shouldn't have and are now more robust!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "And that's it, nothing too exciting happening :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your moonies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
