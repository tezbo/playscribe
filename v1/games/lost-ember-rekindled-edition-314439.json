  {
   "id": "lost-ember-rekindled-edition-314439@major-2025-12-01",
   "gameId": "lost-ember-rekindled-edition-314439",
   "displayName": "A small update to Legendary Souls",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-01T19:04:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "After some of you mentioned difficulties finding your way in the Legendary Souls map, we slightly changed how the map and embers work and add tutorials for the map and legendary animals, since those likely were often overlooked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update also includes various smaller fixes for bugs reported in our discord.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're gonna think about more ways of making your life a little easier without ruinging exploration, so if you have any specific issues, feel free to reach out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your moonies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
