  {
   "id": "lost-ember-rekindled-edition-314439@post-2025-11-28",
   "gameId": "lost-ember-rekindled-edition-314439",
   "displayName": "Improved DLSS & FSR options",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-28T21:17:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As previously announced we added several DLSS options and included FSR for Non-NVIDIA cards!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can now choose your upscaling method - if any - and toggle frame generation on or off.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please do report back if these new settings help improve your experience or if you wish more options were included!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For now, have a nice weekend and enjoy the game! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your moonies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
