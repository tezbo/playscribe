  {
   "id": "lost-ember-rekindled-edition-314439@patch-2025-11-27",
   "gameId": "lost-ember-rekindled-edition-314439",
   "displayName": "DLSS & Performance Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-27T21:01:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since some of you reported performance issues we went ahead with some enhancements we have been preparing and fast-tracked the patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This new patch adds not only NVIDIA DLSS support and enhancements - which should be automatically activated for NVIDIA cards - but also adds a new \"Performance Mode\" to the video settings that swaps some internal settings for those of you who prefer 60fps over all little details.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please do let us know if you experience more issues (and ideally what kind of setup you have), so we can address as many of those as possible!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will keep working on performance and stability and some little polish and likely release more patches in the coming days! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your moonies!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
