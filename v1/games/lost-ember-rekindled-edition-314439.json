  {
   "id": "lost-ember-rekindled-edition-314439@major-2025-11-27",
   "gameId": "lost-ember-rekindled-edition-314439",
   "displayName": "DLC Issue + Performance Patch",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-27T20:02:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Heyo everybody!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lost Ember: Rekindled and Lost Ember: Legendary Souls is finally here!Unfortunately it was a bit of a messy start with some technical issues where several people are currently not able to buy the DLC.We’ve already reported the issue to Valve and hope they’ll be able to resolve it as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "At the moment it’s out of our hands, but we sincerely apologize for the inconvenience and appreciate your patience while this gets sorted out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "On a brighter note",
     "items": [
      {
       "text": "We’re already working on a performance patch to address the issues some players are experiencing. The update is in progress and should be available soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With much love,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your moonies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
