  {
   "id": "plot-of-the-druid-126533@4.9.1",
   "gameId": "plot-of-the-druid-126533",
   "displayName": "Patch 4.9.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-15T09:28:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone! 👋",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After the last patch, some players experienced a bug related to the potion-stirring minigame when using the mouse. Thanks to Jon O'Brien, we were able to identify the source of the problem and fix it in this patch.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "This patch mainly includes the following fixes",
     "items": [
      {
       "text": "Mouse input now properly affects the potion-stirring minigame.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Prevented the ESC key from being used while the stirring minigame is running.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the recipe could appear outside the screen area on ultra-wide resolutions (3440×1440).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue in the Prologue where the beads were not shown in the chest close-up (this fix was already included in version 4.9.0).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "⚠️Reporting Issues",
     "items": [
      {
       "text": "If you encounter any issues with the new version, please feel free to report them:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In our Discord Technical Support channel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Or in our Community Forum, in the bug report thread",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will do our best to respond to and address any issues as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "To play the prologue & chapter 1",
     "items": [
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/1108170/Plot_of_the_Druid/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]~ Adventure4Life Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
