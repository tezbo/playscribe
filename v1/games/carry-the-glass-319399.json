 "releases": [
  {
   "id": "carry-the-glass-319399@3.0",
   "gameId": "carry-the-glass-319399",
   "displayName": "Update 3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-11-04T17:55:26.000Z",
   "notes": [
    {
     "title": "Carry The Glass 3.0 is Out Now!",
     "items": [
      {
       "text": "This is the biggest update Carry The Glass has ever had. We rebuilt the whole game from the ground up, added a brand new Snowy Level and a 2v2 Race Game Mode, filled the Wardrobe With New Items and made carrying the glass with a friend smoother than ever. Grab your partner and a very steady pair of hands!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is everything new in this massive update",
     "items": [
      {
       "text": "New Level: Frosty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A snowy third level joins Skyscraper and Lighthouse! Collect three golden keys to open the arctic base, hop across sinking lily pads, ride the ski lift, survive the 9 Color game and melt the giant Snowball Boss and many more…",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45245666/0a187a393cb9fd71a4f00c3c7e20bfef2004d496.png\"][img src=\"{STEAM_CLAN_IMAGE}/45245666/22c11fa8fe0d3e1f4561ca5d632ee4dafa926332.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "We had over 300+ submissions in our latest post to select the next level and this is the final result from the concept art!",
     "items": [
      {
       "text": "Option A got the most of the votes and we liked that theme a lot too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45245666/73d556ec6da86f390938e8864fa045840b90f82c.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45245666/997a04c9ec9bacaf94afaeda5ad553ff65ffab8d.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45245666/f8541da98bdec9a36417c6b2cb13b34e09c032db.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Mode: 2v2 Glass Race",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Two pairs, one course, one winner! Team up with a friend and race another pair to the finish. The rival pair runs beside you as a ghost, so nobody can knock your glass, they can only beat your time. Frosty can be raced too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45245666/f0fcfc23481b66694cf0b8c0738320ef2c938928.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "33 New Cosmetic Items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "14 new hats, 6 new glasses and 13 new back items join the Wardrobe, bringing it to 61 items in total. Try them on in the main menu and show them off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45245666/b1542660465b596b1e03238d5774d51db0c6b037.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "7 New Achievements and Frosty Leaderboards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Finish Frosty, beat it on Hard or Impossible, finish it in under 30 minutes, find all six hidden eggs, beat the Snowball Boss, win the 9 Color game... and yes, there is one for falling into the icy water. Frosty also gets its own leaderboards for Normal, Hard and Impossible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A Brand New UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New menus, a lobby on the beach, a clean HUD with a route bar of your checkpoints, a speedrun timer with splits against your best, a new results screen and settings that fit any screen from 4:3 to ultrawide.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45245666/7af95e4b27fe269321889a465bc8ec2f130b3007.png\"][img src=\"{STEAM_CLAN_IMAGE}/45245666/02f641292f9c847caefac8098868e05395621d13.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "28 lost obstacle behaviors restored, every Lighthouse checkpoint reachable again, no more black grass in Lighthouse, no more broken first frame after loading, hands that keep their grip on the glass in every jump and roll, and many, many more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Netcode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Your carrier now moves instantly with no rubber banding, the glass sits in both players' hands on both screens and every obstacle moves exactly the same for both of you. A laggy moment no longer kicks you out, and if your connection drops you can rejoin your match within 90 seconds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Also on Console",
     "items": [
      {
       "text": "Carry The Glass is out on PlayStation 5, Xbox Series X|S and Xbox One, and this big update is on its way to consoles too. Stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45245666/ef100c10f01193193d4dc0516e9a6539e83aba11.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for carrying, dropping, shattering and carrying again with us. See you on the ice!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Join Discord channel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
