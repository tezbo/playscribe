   "id": "carry-the-glass-319399@major-2024-10-30",
   "gameId": "carry-the-glass-319399",
   "displayName": "Save/Load System Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-30T23:22:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have fixed problems with the game saves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you played our game after the October 30 update, your save files may not work. We are really sorry about this. Good news - if you haven't played after the update, your saves are okay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "If your game saves are not working, you can reach me on",
     "items": [
      {
       "text": "Steam",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord (eneskp)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Email (carrytheglass.help@gmail.com): Thanks for understanding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
