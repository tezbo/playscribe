  {
   "id": "carry-the-glass-319399@hotfix-2024-10-24",
   "gameId": "carry-the-glass-319399",
   "displayName": "Hotfix - New Settings & Character Movement Polish",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-10-24T08:09:15.000Z",
   "notes": [
    {
     "title": "Update Notes",
     "items": [
      {
       "text": "We're excited to bring you a new update packed with enhancements based on your valuable feedback! Here’s what’s new:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mouse Invert Option: Responding to community requests, we've added an invert option for mouse controls, allowing for a more personalized gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Settings Overhaul: We've revamped the settings menu for a more intuitive user experience, making it easier to customize your gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Character Movement: The sliding degrees and friction values for character movement have been adjusted to improve gameplay fluidity and responsiveness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Server Name Fix: We’ve resolved an issue where server names could exceed the player count limit, ensuring a cleaner and more organized multiplayer experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Local CO-OP Difficulty Bug Fix: Fixed the bug preventing players from selecting a difficulty level for local co-op modes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your continued support and feedback! We’re committed to making the game even better, so stay tuned for more updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
