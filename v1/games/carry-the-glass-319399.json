  {
   "id": "carry-the-glass-319399@major-2024-12-08",
   "gameId": "carry-the-glass-319399",
   "displayName": "Update: Immortal Buddy Achievement and Leaderboards!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-08T13:09:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In the latest update, we made several improvements and fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Immortal Buddy Achievement can now be used not only in Impossible Mode, but also for finishing the game in Hard Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the Immortal Buddy Achievement was not being given out properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the timer was not displaying correctly after 24 hours.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the game incorrectly displayed the mode you completed the game in.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Leaderboard Announcement",
     "items": [
      {
       "text": "We'd like to announce that we've added the first player to finish the game in Impossible Mode as a statue!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also, the statue of the Top 2 Players who completed the game in Impossible Mode and sent us their videos will be added to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Golden Statue (KG/MOLLY & Jest)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Silver Statue (?)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bronze Statue (?)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A big congratulations to the first finishers: Check out the KG/MOLLY and Jest! gameplay videos here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
