  {
   "id": "united-assault-battle-of-the-bulge-195231@1.3.2",
   "gameId": "united-assault-battle-of-the-bulge-195231",
   "displayName": "Hotfix 1.3.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-02-21T19:21:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "fixed vehicle reveres gear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed several smaller rendering issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "updated vehicle acceleration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bonus Campaign Achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are aware of the issue some Achievements of the Bonus Campaign might not unlock. Internal logs show the correct activities and everything should work. However, for some reason these achievements are very unreliable. We have made some changes, but it is not a final solution to the problem.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have opend a developer support ticket to Valve and hope to find the cause of the issue and hope to fully solve it in short time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
