  {
   "id": "united-assault-battle-of-the-bulge-195231@1.4.0",
   "gameId": "united-assault-battle-of-the-bulge-195231",
   "displayName": "Update 1.4.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-13T13:41:35.000Z",
   "notes": [
    {
     "title": "Update Notes",
     "items": [
      {
       "text": "We're thrilled to present the latest update for United Assault - Battle of the Bulge! Get ready to experience enhanced gameplay, exciting new weapons, and a fresh rank system. Here's what's in store:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Weapons: Equip yourself with five powerful new weapons to dominate the battlefield:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "P38: A classic German pistol known for its precision and reliability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "MP34: A submachine gun perfect for close-quarters combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Volkssturmgewehr: A versatile rifle ideal for a variety of situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "G43: A semi-automatic rifle with pinpoint accuracy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FG42: A fearsome light machine gun that delivers devastating firepower.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Tool: Introducing the Flare Pistol, a handy device that lets you illuminate dark areas and create strategic advantages on the battlefield.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Performance Improvements: We've optimized the game to ensure smoother gameplay, reduced lag, and an overall improved gaming experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added 5 new Weapons (P38, MP34, Volkssturmgewehr, G43, FG42)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added new tool (Flare Pistol)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added climbable ladders",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added new rank system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fixed performance issues with larger AI groups",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed legacy UI references",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed several minor issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "updated max Rank to 60",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "updated to Unreal Engine 5.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "updated and optimized source code",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Facebook",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
