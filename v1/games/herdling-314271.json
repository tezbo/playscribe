  {
   "id": "herdling-314271@1.2.1",
   "gameId": "herdling-314271",
   "displayName": "Patch 1.2.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-08-25T14:03:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Birch Forest: Fixed flickering trees when loading directly into the Birch Forest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Canyon Temple: Fixed a save/load bug that hindered you from walking across the pushable in a canyon temple puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Traindepot: Optimized bridge model LOD for medium quality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed small issues in German & Swiss German localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Achievements: Achievements unlocked in the demo will no longer be blocked from being unlocked in the main game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Flowers: Fixed a bug where painting flowers were spawned already and collecting them would not reveal the painting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
