  {
   "id": "herdling-314271@1.2.3",
   "gameId": "herdling-314271",
   "displayName": "Patch 1.2.3",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-08-28T12:41:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Resting Spots: Fixed animals sometimes not coming nicely to a resting spot. This was visible especially at the train yard fireplace when reloading a save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mountain Top Resting Spot: Fix checkpoint loading after you get out of quarry. Fixed bridge collision and also the herd now joins you if you lost them on the other side of the bridge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphics: Fix game having to high FPS when in menu or tabbed out with VSync enabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achievements: Fix achievements for tamed animals sometimes not including all animals and thus unlocking too late or not at all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
