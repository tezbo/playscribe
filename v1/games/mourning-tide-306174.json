  {
   "id": "mourning-tide-306174@major-2026-11-13",
   "gameId": "mourning-tide-306174",
   "displayName": "Development Update + Release Date Trailer",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-11-13T17:06:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey there,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been a while! We've been hard at work on Mourning Tide, and we're pleased to say that the game is now content complete. However, our internal playtests revealed a few rough edges we didn't anticipate, and it will take a little more time than we expected to work in the necessary polish to really make the experience shine.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's not all bad news, though: we've got a new trailer to announce our release date! Check it out below for a preview of what to expect from the full game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're looking forward to getting Mourning Tide in your hands on December 11th, 2026. We'll see you then!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get ready to fish,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Liquid Squid",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
