  {
   "id": "never-grave-the-witch-and-the-curse-250291@0.1.2920",
   "gameId": "never-grave-the-witch-and-the-curse-250291",
   "displayName": "Update 0.1.2920",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-29T11:26:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're pleased to announce some updates that have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v0.1.2920",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Set the movement distance of the Neutral combo regular attack to 0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made the hitstop for regular attacks more lenient.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The hitstop during regular attacks now also affects other enemy characters, not just the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected an issue where Ice Circle wouldn't disappear when hitting objects like pots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where breaking walls in a room with a second layer of water would still show the wall graphics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where you could drop the witch's body in the witch's cauldron.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Even if the witch's body is not present, made it so that summoning it from hat form is possible.: (We expect this will allow to summon the witch even when loading from data which was saved in hat form.): We hope you continue to enjoy playing the Never Grave demo. Thanks for your support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
