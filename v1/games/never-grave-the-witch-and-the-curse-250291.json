  {
   "id": "never-grave-the-witch-and-the-curse-250291@1.3.5",
   "gameId": "never-grave-the-witch-and-the-curse-250291",
   "displayName": "Update 1.3.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-27T02:19:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you very much for playing Never Grave: The Witch and The Curse. In this update, we have focused on enhancing the early-game experience to make your journey smoother from the start.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "System Adjustments & New Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Earlier Equipment System Unlock：",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The Jeweler's Shop first appearance has been moved up from \"Gardens - Area 1\" to \"Ruins - Area 2\". You can now access the equipment system much earlier than before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "▼Equipment Capacity Alerts",
     "items": [
      {
       "text": "・A notification will now appear when your equipment inventory reaches its maximum capacity (255 items).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: You cannot give gifts to NPCs if your inventory is full. Please clear space by Forge, Convert, or Discard items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "▼Save Data Security (Steam only)",
     "items": [
      {
       "text": "・Added an Automatic Save Backup feature. Every time you save, the system will automatically create a Save_Backup folder and back up your previous save file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes & Optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "▼Clipping Fixes",
     "items": [
      {
       "text": "・Fixed a rare issue where players could fall through the map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "▼Stability Maintenance",
     "items": [
      {
       "text": "・Fixed various minor bugs and several critical errors that could cause the game to crash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "▼Memory Optimization",
     "items": [
      {
       "text": "・Fixed a memory leak issue that could occur when dismantling a large number of buildings at once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues during gameplay, please contact our support team:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "( https://www.pocketpair.jp/contact/ ).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
