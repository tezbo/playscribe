 "releases": [
  {
   "id": "never-grave-the-witch-and-the-curse-250291@1.4",
   "gameId": "never-grave-the-witch-and-the-curse-250291",
   "displayName": "Update 1.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-20T02:27:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you very much for playing Never Grave: The Witch and The Curse. This update focuses on significantly improving the overall \"feel\" of character controls and fixing several critical bugs related to save data.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Two New Spells Added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・One new spell has been added to each of the passages connecting Ruins Area 1 and Ruins Area 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Critical Save Data Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Village & Progression Fix: Fixed a bug where village building status and game progression would fail to save if a player attempted to matchmake as a \"Guest,\" failed, and then immediately continued in Single Player mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Guest Blueprint Fix: Fixed an issue where Blueprints obtained by a guest in a dungeon were not saved if the player left the match after a loading transition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: Blueprints you pick up will *not* be saved if you leave the game before a level transition (loading screen) happens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Gameplay Feel & Control Optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Movement Speed: Slightly increased base movement speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Basic Attacks: Expanded the attack range by approximately 1.2x.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Potion Usage: Shortened the recovery time after using a potion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Animation Canceling: You can now cancel the potion drinking animation by moving. (The effect will be the same)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Tracking & Locating \"Blueprints\" and \"Divine Weight\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added new functionality to the Legendary and Mythic tiers of the \"Amulet of the Explorer.\" It can now display the remaining quantity and specific locations of Blueprints and Divine Weights within a dungeon. Check the in-game equipment descriptions for details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Production & Balancing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Crafting Times: Significantly reduced the production time for most craft items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Spell Buffs: Improved the performance parameters of several spells.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Adjusted the balance of the Final Boss to favor a faster-paced, \"high-risk, high-reward\" encounter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・HP: Reduced to approximately 0.5x.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Attack Power: Increased to approximately 2.0x.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues during gameplay, please contact our support team:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
