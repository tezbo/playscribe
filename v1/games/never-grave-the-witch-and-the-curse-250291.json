  {
   "id": "never-grave-the-witch-and-the-curse-250291@1.2c",
   "gameId": "never-grave-the-witch-and-the-curse-250291",
   "displayName": "Update 1.2c",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-06T10:00:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you very much for playing Never Grave: The Witch and The Curse. We truly value all the feedback we have been receiving from our players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released a patch today to implement the following balance adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Difficulty Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted enemy Attack Power and Max HP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Reduced the overall difficulty across all difficulty settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: Difficulty can be changed at any time in the in-game settings without any penalties or negative impact on your progress!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Skill Tree Material Reduction",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Reduced the amount of materials required to unlock nodes in the Skill Tree.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Axe Minion Dash Attack Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased the wind-up time before the attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Reduced the number of consecutive attacks from 4 to 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Shipping Bin Processing Time Adjustment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Cut the time required to sell items via the Shipping Bin in half.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Tutorial Boss Souvenir Price Adjustment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Lowered the sale price of the souvenir obtained by defeating the tutorial boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are reading every single one of your suggestions, and Never Grave will continue to update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The development team is working hard through the weekend to further optimize the game. While we cannot promise to fix everything instantly, we are committed to pushing forward with every feasible improvement. We hope you will continue to support us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your patience. We will release the next patch as soon as possible, so please stay tuned for future updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
