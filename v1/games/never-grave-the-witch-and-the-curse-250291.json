  {
   "id": "never-grave-the-witch-and-the-curse-250291@0.1.2703",
   "gameId": "never-grave-the-witch-and-the-curse-250291",
   "displayName": "Update 0.1.2703",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-28T16:28:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're pleased to announce some updates that have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v0.1.2703",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now you can advance dialogue using the up key.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In hat state, you can also attack with the R1 button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Frost Breath has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The boss's attack hitbox has been adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After using a portal, an invincibility period is granted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a stick control bug in the settings screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various other minor bugs have been addressed.: We hope you continue to enjoy playing the Never Grave demo. Thanks for your support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
