  {
   "id": "never-grave-the-witch-and-the-curse-250291@0.1b",
   "gameId": "never-grave-the-witch-and-the-curse-250291",
   "displayName": "Update 0.1b",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-01T11:52:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're pleased to announce some updates that have been made.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v0.1b.0119",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added potion-replenishing facilities at the terminus of the 1st & 2nd layers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Significantly improved rendering performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced the settings menu to support mouse usage.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug where, after switching applications using the keyboard and returning to the game,: the controller icons remained in keyboard mode even when using a gamepad.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fine-tuned several aspects related to the player character's movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made the transition from evasive action to running more smooth.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a tutorial about underwater jumping.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where the boss's slamming attack would not track the player character when on the outer side.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made significant adjustments to ensure that boss battles conclude in a shorter time.: We hope you continue to enjoy playing the Never Grave demo. Thanks for your support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
