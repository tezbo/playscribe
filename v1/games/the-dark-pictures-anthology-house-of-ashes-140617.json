   "id": "the-dark-pictures-anthology-house-of-ashes-140617@major-2022-10-12",
   "gameId": "the-dark-pictures-anthology-house-of-ashes-140617",
   "displayName": "Update – Revoked Game Keys",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-12T12:52:20.000Z",
   "notes": [
    {
     "title": "If you have encountered a problem with your House of Ashes Steam key being revoked, please contact the reseller who sold you the key. We have provided all official resellers with replacement keys for this purpose.",
     "items": [
      {
       "text": "If you have already contacted your reseller and they were not able to send a replacement key, please contact the Bandai Namco Support Team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will ask you to send the key that has been revoked plus a copy of your purchase invoice from the reseller (most digital resellers will send an email invoice after purchase). With this information, our team will be able to issue a replacement key.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our sincere apologies for this inconvenience. We thank you for your patience and hope that after this issue is resolved, you will continue to enjoy The Dark Pictures: House of Ashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
