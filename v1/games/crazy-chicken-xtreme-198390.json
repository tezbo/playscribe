   "displayName": "Difficulty Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-21T17:52:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Crackshots!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this update we followed a suggestion from the community to make unlocking the levels easier. This should now be possible for all players with a little practice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This does not change the overall game difficulty or the Highscore list.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelist",
     "items": [
      {
       "text": "Difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To unlock the Castle and Village levels you now need 500 points",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have implemented a light aim assist for controllers - it should now be easier to aim with those (Aiming with the mouse remains unchanged): UI",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Awarded points in the Multiplayer and Hot-Seat modes are now shown in the players' color",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Small animations in the main menu: Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Duplicated entries could occur in the highscore list - this should now be fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Small fixes: Your Korion-Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
