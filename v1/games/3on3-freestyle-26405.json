  {
   "id": "3on3-freestyle-26405@major-2017-11-09",
   "gameId": "3on3-freestyle-26405",
   "displayName": "Mouse Control Update and Modified Key (~)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2017-11-09T07:24:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings Ballers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please download the game’s latest patch and enjoy the new feature that has been added to the game today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "A.Mouse control is now available in-game!",
     "items": [
      {
       "text": "As want we mentioned before, adding mouse control needs a lot of work thus, this update still needs enhancement but rest assured that we will improve the mouse control option from time to time until it gets better.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "B.~ key has been changed to 0 key",
     "items": [
      {
       "text": "-The (~) key for Request timeout and apply as a team functions was changed to 0 key.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are still working for the betterment of the game and we always appreciate and read all your feedback and suggestions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-3on3 Freestyle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
