  {
   "id": "the-bunker-24017@post-2018-04-09",
   "gameId": "the-bunker-24017",
   "displayName": "Supporting New Languages & FMV Bundle!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2018-04-09T14:51:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Wales Interactive are proud to bring you brand new language support for the award-winning FMV horror The Bunker!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The Bunker now supports the following languages",
     "items": [
