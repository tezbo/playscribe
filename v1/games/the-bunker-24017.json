    },
    {
     "title": "FMV SALE",
     "items": [
      {
       "text": "We are reducing the price of The Bunker on Steam with a 50% discount which goes live today at 6pm BST / 10am PDT.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "FMV BUNDLE",
     "items": [
      {
       "text": "Not only that, we have bundled The Bunker with the hit FMV crime thriller Late Shift in the Wales Interactive FMV Bundle. Get it now with an additional 20% off. If you already own one game, you will still receive a discount on the other!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Head over to to the forums to reminisce about your favourite FMV from the 90s!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you enjoy the game and please do let us know your thoughts in the comments section! Thank you all for reading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don’t forget you can follow Wales Interactive on our Twitter and Facebook page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wales Interactive",
