  {
   "id": "escape-from-ever-after-211624@5",
   "gameId": "escape-from-ever-after-211624",
   "displayName": "Hotfix 5",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-01-30T17:35:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've released another update based on your feedback. Here's what's new:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Made wisp colors more clear and distinct in the Enchanted Woods (if you still need additional support, a colorblind fix with extra visual cues will be added in a future update)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added elevator access to teleport back to the final level's entrance after the final boss is completed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Equipping the \"Dragon Skin\" trinket now allows you to perform melee attacks on fiery enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Balance Changes",
     "items": [
      {
       "text": "Chapter 2 Boss is now immune to poison",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "On Easy and Normal mode, Duxter now summons fewer shielded enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Be sure to leave your feedback if you haven't done so yet—we read every comment and use it to make the game better! More updates are coming soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
