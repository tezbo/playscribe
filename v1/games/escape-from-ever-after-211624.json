  {
   "id": "escape-from-ever-after-211624@6",
   "gameId": "escape-from-ever-after-211624",
   "displayName": "Hotfix 6",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-02-03T13:36:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've just released a hotfix addressing several bugs and adding some quality-of-life improvements based on your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42649549/c4a438f892c03b7810930465266845881abd16f2.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "After Chapter 4, the Telepager menu now shows remaining sun gem and ink bottle counts for each storybook, making it easier to hunt down those last few collectibles!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "To make the \"gnome trapped in cubicle\" quest easier in the late-game, the cafeteria will no longer stop selling coffee cake",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The boss at the end of the Stairs of Success will now appear in the file bin in your office if you forget to research it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Fixed Steam Deck resolution bug",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed bug where you could run away from the Chapter 4 Boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed ability to use items from menu in Boss Rush mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed being able to pause during boss transitions in Boss Rush mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the game unpausing when the \"can't use item\" warning displays",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed potential sequence break in Chapter 2 that could impede progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted battlefield foreground in Tower that would obscure certain attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, thank you for your reports and continued support! Keep the feedback coming—we're listening to everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
