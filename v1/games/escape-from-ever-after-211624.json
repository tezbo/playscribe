   "id": "escape-from-ever-after-211624@12",
   "gameId": "escape-from-ever-after-211624",
   "displayName": "Hotfix 12",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-04-10T18:23:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Just a quick update with some small bugfixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed progression bug where the crab cage in Port Cutlass doesn’t despawn properly after the Unicorn’s quest is completed, and thus blocks the way forward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rare issue where the Glacian Slug enemy crashes the game on its tongue attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed French translation issue where in certain spots, Patches’ name was translated differently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hope you all are continuing to enjoy the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
