  {
   "id": "escape-from-ever-after-211624@2",
   "gameId": "escape-from-ever-after-211624",
   "displayName": "Hotfix 2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-01-26T09:19:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We continue to be overwhelmed by all your feedback—and yes, we're reading EVERYTHING! You've all been amazing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're working on some bigger Patches (heh) coming soon, but we're being extra cautious with those larger fixes to make sure we don't break anything in the process. In the meantime, here's another round of improvements and fixes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Dialogue sound levels can now be adjusted individually in the options menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Shops now display the Trinket Point cost of any Trinkets for sale",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Fixed bug in Construction Site where blowing up rocks doesn't make bridge fall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where boat position doesn't save in Ghost Ship",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Polished some collision throughout Chapter 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for your support, feedback, and critique—it's been absolutely crazy (in the best way)! Keep it coming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hope you continue to enjoy playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
