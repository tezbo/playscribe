  {
   "id": "escape-from-ever-after-211624@10",
   "gameId": "escape-from-ever-after-211624",
   "displayName": "Hotfix 10",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-02-27T07:16:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Guten Tag, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're excited to announce that the long-awaited German localization is now live! Thank you so much for your patience while we worked to bring Escape from Ever After to our German-speaking players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simply select your preferred language in the game's settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42649549/838d4fdb59c8945a8d4f31cce2594e727affeeb3.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's New",
     "items": [
      {
       "text": "German localization added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Coming Soon: French localization is still in the works and will be available next month. We appreciate your continued patience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you again for your support and feedback. We're thrilled to make the game accessible to more players around the world!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
