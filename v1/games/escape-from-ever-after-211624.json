   "announcedAt": "2026-02-06T12:04:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've just released an important update that adds a highly requested accessibility feature along with various bug fixes and balance adjustments.",
