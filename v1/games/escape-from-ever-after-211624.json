  {
   "id": "escape-from-ever-after-211624@9",
   "gameId": "escape-from-ever-after-211624",
   "displayName": "Hotfix 9",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-02-18T23:35:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are rolling back the change we made to “Restoration” in the previous update. Now, Synergy Charms and Restoration will work just as it did before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re reading all of your feedback and comments, and it’s clear this change was incredibly unpopular. We are so fortunate that players have spent time establishing metas and forming strategies for clearing some of the harder challenges in the game, but we didn’t realize the extent to which people were invested in those metas. While we do believe Restoration is far more powerful than we originally intended it to be, now that the game has been out for a few weeks, it’s taken on a life of its own and we have to be more mindful of that in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again for your passion and dedication towards our game, and we appreciate your patience with us as we made this stumble. Your feedback is ALWAYS appreciated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All the best,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Escape from Ever After Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
    "new": 0,
    "fixed": 0,
    "balance": 0,
    "other": 6,
    "ps5": 0
   },
