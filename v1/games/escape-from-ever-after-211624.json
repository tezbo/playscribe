  {
   "id": "escape-from-ever-after-211624@4",
   "gameId": "escape-from-ever-after-211624",
   "displayName": "Hotfix 4",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-01-29T12:42:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been listening to your requests, and we're excited to announce that French and German localizations are currently in the works! These translations will be added in February/March 2026, so please stay tuned and follow our updates for the exact release dates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the meantime, we've been hard at work squashing bugs and improving your experience:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Updated localization texts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Fixed rock in construction site exploding but not knocking down bridge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed potential progress blocker in space station if you leave and come back before boarding ship",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed potential progress blocker in ghost ship boat puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed softlock caused by stalagmite falling on Ch3 boss while unarmed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed player turn order reversing at the start of Ch3 boss 2nd phase",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed softlock when hitting Rooted Wanderer through wall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed battlefield collision in final chapter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed parrot attack causing issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Stabilized Wolfgang's overworld ability to prevent rare softlock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed redundant resolution init on game startup, hopefully fixing startup issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "And one more exciting update: Escape from Ever After has received its Metacritic score! We're incredibly grateful for all the reviews and support from the community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42649549/92b2b0220cfafaff0ebe5805f8b63bfcd1e61827.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you again for your continued support and patience as we make Escape from Ever After the best experience possible!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
