   "id": "nightmare-shift-321774@1.0.1",
   "gameId": "nightmare-shift-321774",
   "displayName": "Update 1.0.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-08-22T11:25:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45197195/852545c8420e90b678213c4be8831954e2a93bf8.png\"]Thanks for your awesome feedback to help bringing the game to the perfect shape, all reported bugs have been fixed in addition some game optimizations:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We optimized the game in hope that fixed the random crashing at the end of each night won't happen anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the bug in Night 1 Motel where you can get stuck in Room 1 after you give the key to Garry.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug in Night 2 motel where the roaming car won't spawn after giving the key to Ms. Smith.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the missing colliders on some game objects in the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the bug in Night 4 after work where you can bring the elevator down after the cop goes up with you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "various minor fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you faced any further bugs or any problem don't hesitate to report that to the following e-mail:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "binarylunar@gmail.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
