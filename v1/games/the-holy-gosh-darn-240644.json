  {
   "id": "the-holy-gosh-darn-240644@patch-2024-10-03",
   "gameId": "the-holy-gosh-darn-240644",
   "displayName": "The *genius* patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-03T10:37:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a bug where the player would be stuck on the fast forward screen while waiting for Elder 7 inside the vault. This was caused by some terrible logic surrounding whether or not the player had witnessed Elder 7 falling asleep. If the player had never witnessed this, the game believed it should cancel the fast forward at 15:00, when he falls asleep. So... two things could happen if the player never witnessed this: 1. The player could try to trigger fast forward before 15, the fast forward would then look normal and stop at 15.: 2. The player could try to trigger fast forward after 15, causing the game to try and fast forward a negative time value. Like... 15-18 = -3 I mean... this is just stupid. No one should let me near this code again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added safety check to fast forward, so it is no longer possible to fast forward to the past.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed \"on\" button hitbox on God's coffee machine, forgot about that one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cassiel should no longer say \"There he is\", when Sam Sr. is obviously not there.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Joar Renolen's name in the credits. I swear to god... I think we've messed up his name a million times by now. We're so sorry!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
