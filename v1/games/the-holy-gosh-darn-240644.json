  {
   "id": "the-holy-gosh-darn-240644@major-2024-10-25",
   "gameId": "the-holy-gosh-darn-240644",
   "displayName": "Spooky Season update and Patch Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-25T13:36:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Spooky season is upon us! And Christmas, and even Easter isn't that far away either. Connected to that we might have put some stuff in the game that you should definitely check out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Big question is: Can you figure out how?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've also fixed some issues!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Fixed a case where the player could get stuck after speaking to Pesto and Bjoharn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a case where Puriel would not be visible in the beginning of act 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made the \"..of Sensibility\" achievement less sensitive, it should now count a memory as \"watched\" when the player has seen more than 90%. Some players manually aborted playback before the video ended by itself, causing the achievement not to pop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The sidequest \"For Inner Peace\" should now complete as expected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a case where timewarped items could appear as permanent inside the wardrobe module, preventing players from removing them from the timewarp slots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some minor translation issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a new UI font for Northern Sami translation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added improved inventory filtering for some interactions where a bunch of cosmetics would get in the way.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Set up a temporary hotline for Holiday John's Holiday Line.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
