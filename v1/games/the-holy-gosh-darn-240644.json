  {
   "id": "the-holy-gosh-darn-240644@patch-2024-11-07",
   "gameId": "the-holy-gosh-darn-240644",
   "displayName": "Minor patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-07T13:28:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added option to disable any vomiting in the game. This should mute any gagging audio and the actual vomiting visuals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Cassiel annoyance level on some dialogs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Cassiel thinking she has more money in her apartment after she picked up and spent all her money from the apartment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Froze time when unlocking teleport to Metatrons house and Server room, to make sure players learn they can do this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed music not always looping as it should in act 3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed minigame button prompts while opening inventory or watch to not confuse players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gave Cassiel the opportunity to react if rewinding to her and Gabriel walking to the HornHub machine, after learning he owes her money.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
