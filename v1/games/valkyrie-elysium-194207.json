   "announcedAt": "2023-03-30T10:10:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "If Divine Art/Einherjar and a shortcut key for an item have the same key assigned, Divine Art/Einherjar will now take priority over that shortcut key.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mouse wheel is now available for key assign.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Tab key is now available for key assign.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Separate from the Soul Chain key assign option, there is now an individual key assign option for Actions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players can now also control the cursor with the mouse wheel or arrow keys.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Players can now also perform Confirm action with Enter key, Cancel action with Esc/Backspace key.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed key assigns for some of the functionalities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The changes that have been made to the default setting for the options in the Customize have no effect on players who are already playing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
