  {
   "id": "chocolate-factory-simulator-293131@1.0.16",
   "gameId": "chocolate-factory-simulator-293131",
   "displayName": "Hotfix 1.0.16",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-01-21T19:46:56.000Z",
   "notes": [
    {
     "title": "A small (but important) correction to the German translations.",
     "items": [
      {
       "text": "While correcting the German language translations, a previously unnoticed old bug with the incorrect chocolate tempering temperature reappeared in one of the first tutorial missions – instead of 42°C in the mission text, it shows 32°C.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The incorrect tempering temperature in the German language version has been fixed – it is now 42℃ instead of 32℃.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* -> changes apply to all versions of the game (Full, Demo and Prologue)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
