  {
   "id": "chocolate-factory-simulator-293131@1.07.1",
   "gameId": "chocolate-factory-simulator-293131",
   "displayName": "Hotfix 1.07.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-02-27T18:19:21.000Z",
   "notes": [
    {
     "title": "Hotfix 1.07.1",
     "items": [
      {
       "text": "Fixed a rare issue where the filling amount in the press was not correctly calculated during the chocolate filling process, causing it to be interrupted. This resulted in liquid mass remaining in the molds instead of forming into solid chocolate bars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where saving the game while the airship carrying an order or reward was on its way to the player resulted in an unresponsive state upon loading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
