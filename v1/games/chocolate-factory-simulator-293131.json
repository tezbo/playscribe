  {
   "id": "chocolate-factory-simulator-293131@1.07",
   "gameId": "chocolate-factory-simulator-293131",
   "displayName": "UPDATE 1.07",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-26T13:53:47.000Z",
   "notes": [
    {
     "title": "Hey Chocolatiers! 🍫✨",
     "items": [
      {
       "text": "The Valentine's event has officially come to an end! We hope you had a great time spreading the love and maybe even brightening up Nougat’s mood. But now, it's time to get back to regular chocolate-making business! This update brings a few adjustments and bug fixes to keep things running smoothly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔧 Patch Notes",
     "items": [
      {
       "text": "Valentine's Event has ended – Decorations are gone, seasonal ingredients removed, and all love-filled orders are now history. Back to business as usual!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Melanger Bowl info update – The temperature of its content will now display as \"--- °C\" while the machine is running.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🐞 Bug Fixes",
     "items": [
      {
       "text": "Recipe icon fix – The icon for attached recipes now properly disappears or updates when a container is stored in the inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Keep those chocolate creations coming, and as always, let us know if you have any feedback! 🍫🔥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
