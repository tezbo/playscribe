  {
   "id": "build-lands-201239@major-2024-08-16",
   "gameId": "build-lands-201239",
   "displayName": "Survivor Cells Update is Here!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-16T17:51:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Survivor Cells has just received a fantastic update! Get ready to explore all the new features and take your gaming experience to the next level!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Game Mode: Endless: Now you can test your limits in the new Endless mode! Survive as long as possible against endless waves of enemies in a never-ending gameplay experience. Start the mode already at Year 100 with upgrades purchased in the laboratory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Alchemy Improvements: The Alchemy system has been refined, making strategy creation even more dynamic. Adjusting your build during gameplay is now more intuitive and effective!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Laboratory Enhancements: The Laboratory has been updated to make managing your cells and resources easier, making your decisions more strategic and practical.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various Fixes and Gameplay & Navigation Improvements: We’ve implemented numerous fixes and improvements that make gameplay and navigation smoother and more engaging, ensuring a more enjoyable experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New SFX: To further enhance your immersion, we've added new sound effects that will make your battles even more exciting!: Update your game now and enjoy all these improvements!: Get ready to face new challenges and take your survival to the next level!: https://store.steampowered.com/app/1976100/Survivor_Cells/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
