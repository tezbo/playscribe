  {
   "id": "build-lands-201239@major-2024-01-29",
   "gameId": "build-lands-201239",
   "displayName": "Next Update! - News and Information!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-29T03:10:43.000Z",
   "notes": [
    {
     "title": "Hello, Everyone!",
     "items": [
      {
       "text": "We are incredibly excited to announce that Survivor Cells is about to receive its first major update, scheduled for January 30th. Get ready for a true feast of improvements, adjustments, and innovations that will take your gaming experience to a whole new level!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In our constant quest for perfection, we will be resetting the ranks to implement crucial fixes and enhance the ranking system. This will ensure an even fairer and more balanced competitive environment for all players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Mark your calendars",
     "items": [
      {
       "text": "-> January 30th!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't miss out on these exciting updates that will elevate your Survivor Cells experience to a new level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remember that we highly value your feedback; it's invaluable to us. We appreciate you being part of the Survivor Cells community. Be ready for an exciting journey, and we'll see you in the cells! 🦠🔬",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "***The DLC will be free only during the Early Access period of the game, so be sure to download it to register it in your Steam account. After the official launch, it will be a paid DLC!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
