  {
   "id": "bombanana-404342@1.0.1",
   "gameId": "bombanana-404342",
   "displayName": "Hotfix 1.0.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-09-03T16:14:55.000Z",
   "notes": [
    {
     "title": "HELLO MONKEYS!",
     "items": [
      {
       "text": "We've prepared a quick hotfix to solve some current issues in the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📒v1.0.1 UPDATE",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🔥HOTFIX",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed cracking and distorted sounds in Voice Chat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some players could not hear or speak through Voice Chat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect placement of the Yes/No text in Spanish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Voice Chat could still be heard in 3D on the Report panel after returning to the lobby from a run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "⚠️KNOWN ISSUES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some players may experience random game crashes. We are still investigating and working on a fix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also wanted to take a quick moment to say a massive THANK YOU to you all for the support you have shown us so far! It's been great to see everyone jumping in and enjoying themselves!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you can, please take a moment to review the game honestly and send us feedback. This helps us massively so we can make the game what you monkeys want! 🐵",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
