  {
   "id": "ultra-mission-159376@post-2023-09-08",
   "gameId": "ultra-mission-159376",
   "displayName": "DualShock 4 and DualSense gamepads are now supported in Ultra Mission™!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-09-08T02:14:45.000Z",
   "notes": [
    {
     "title": "Expanded Gamepad Support",
     "items": [
      {
       "text": "There has never been a better time to blast than right now! Ultra Mission™ has been updated to better support various gamepads, including Sony's DualShock 4 and DualSense controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The following gamepads are now supported by the Steam version of Ultra Mission™:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Xbox One Controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Xbox Series X|S Controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Other XInput Gamepads",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DualSense",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DualShock 4*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Does not support vibration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
