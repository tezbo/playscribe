   "id": "the-elder-scrolls-v-skyrim-special-edition-19457@1.1.51",
   "gameId": "the-elder-scrolls-v-skyrim-special-edition-19457",
   "displayName": "Update 1.1.51",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2016-11-03T18:14:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The 1.1.51 Update is available on Steam Beta. Please provide feedback in our Bethesda.net Steam Beta forums: https://beta-community.bethesda.net/category/135/steam-beta",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Skyrim Special Edition 1.1.51 Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "General performance and optimization improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed rare issue with NPCs not appearing in proper locations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with saves erroneously being marked as Modded, even though no mods are active",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated some sound files to not use compression",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "How to access the Steam Beta",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Log into Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Right Click on The Elder Scrolls V: Skyrim Special Edition in your Library.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select Settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select Betas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A drop down menu will appear. Select Beta.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Select OK.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wait a few minutes and Skyrim Special Edition should update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When done, The Elder Scrolls V: Skyrim Special Edition should appear as The Elder Scrolls V: Skyrim Special Edition in your Library.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
