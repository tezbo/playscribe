 "releases": [
  {
   "id": "the-elder-scrolls-v-skyrim-special-edition-19457@1.7.99",
   "gameId": "the-elder-scrolls-v-skyrim-special-edition-19457",
   "displayName": "Update 1.7.99",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-20T14:55:37.000Z",
   "notes": [
    {
     "title": "Additional Hotfix — August 27",
     "items": [
      {
       "text": "Crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a crash when opening the on-screen keyboard and submitting text on the game main menu on PlayStation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5",
        "pc"
       ]
      },
      {
       "text": "Fixed a crash when opening the map multiple times on Xbox.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Installing the game in certain regions no longer shows the 14 out of 15 GB Creations storage space is used on PlayStation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Today's update to The Elder Scrolls V: Skyrim Special Edition increases console mod storage limits and brings more Creations improvements and fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Game",
     "items": [
      {
       "text": "Increased mod storage to 15 GB for both PlayStation 5 and Xbox.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "Due to differences in platform storage systems, PlayStation 4 Creation storage is changed in the following ways: Creations storage expanded to approximately 16 GB, but download size may not match space used because of technical details of the PlayStation 4 console hardware; This may cause download size vs. installed size discrepancies. Storage usage may appear larger than expected when managing Creations; Due to the storage system partitions, PS4 users may experience a practical limit on the number of large Creations installed at once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Added localized strings fixes for UI and platform terminology.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A Creation’s Details page now includes instructions on how to report abusive or problematic mods.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added bundling of Creations in the Skyrim Creations Menu to bring it to parity with Fallout and Starfield.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed storefront UI to support Creations box art at 3640 x 900 and 900 x 506 to be consistent with Starfield and Fallout 4. Older image sizes will still be supported and do not require immediate resubmission.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added support to sort Creation categories by \"Most Popular\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Creations flagged as WIP can now be viewed when bookmarked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Creation Kit",
     "items": [
      {
       "text": "Added Localization export support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated \"Search and Replace\" to align with Starfield, adding buttons for \"Select Form in Object Window\" and \"Open Form Editor\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Creation Kit will now allow multiple master loads by default. This can be configured as normal.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Skyrim Creations released through the Verified Creators program will have the option to be Achievement-Friendly (Xbox) and Trophy-Friendly (PlayStation). This means that certain Creations will no longer block achievements, but it requires starting a new game for this functionality to work on updated Creations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "Bink files can now be added to Creation uploads via an Extra Files browser.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Expanding beyond scripts, archives are now supported on PlayStation. New file types are available (.nif, .dds, .bink, .wav, and .fuz (with embedded .wav)) for PlayStation Creations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    },
    {
     "title": "Game",
     "items": [
      {
       "text": "Fixed a crash when the player opens the Virtual Keyboard on a Steam Deck device.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a crash when the player ‘selects’ an empty search result in the Creations menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash when the player transforms into a new race.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Creation Kit",
     "items": [
      {
       "text": "Fixed a crash when the player closes the dialogue for a Sound Descriptor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash when analyzing loot in a new encounter zone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash when clicking the Make Use Info button on some menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash that can occur when reloading a mod without an associated Masterfile.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Game",
     "items": [
      {
       "text": "Free Creations from Verified Creators now correctly appear in the Verified Creators category within the store.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Exiting out of Search when viewing a specific Creation now properly returns the player to the Details page of that Creation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where installed Creations would sometimes display the incorrect version number while on the pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Creations titles should now display with fewer misformatted characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved an issue where the Creations store would not always update visual pricing when Creations were placed on sale when a player had not changed menus.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved an issue where Anniversary Edition Creations failed to auto-download on PlayStation 5.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Search strings will no longer clip through text when searching for Creations,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Verified Creator category should now correctly sort by latest and not alphabetical order.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enabling an item in Load Order should now more consistently stick when selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Deleting all Creations now only clears mods downloaded from the Store and not those loaded via other means.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Uploading or restoring a Load Order containing a mod or Creation no longer available on the Marketplace should no longer fail.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Uploading or restoring a Load Order containing many mods should no longer fail.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Creations store should now load more efficiently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Creation Kit",
     "items": [
      {
       "text": "Creation Kit now forces consistent capitalization of platform-specific .bsa binaries to avoid runtime errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Archiving new forms in a plugin which relies on pre-existing assets will no longer cause the pre-existing form to duplicate within the plugin.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where Creation submission can improperly tag a file as a Masterfile causing infinite data reload.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cell forms should now populate correctly across all tabs when accessed via the Cell View window.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Altered forms will no longer count as new forms when creating a plugin.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Using the Create Archives or Upload process should more consistently apply correct compression to meshes/miscellaneous archives.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Browsing ids in the World Spaces window should no longer alter the forms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved error message pop-up when attempting to open the Creation Kit while Bethesda.net services were offline.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Miscellaneous",
     "items": [
      {
       "text": "Updated the game credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
