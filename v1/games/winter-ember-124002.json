  {
   "id": "winter-ember-124002@major-2022-07-07",
   "gameId": "winter-ember-124002",
   "displayName": "Major Patch Update - End of Community Test Branch",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-07-07T05:36:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "After two weeks of testing and positive feedback from the loyal Winter Ember community, the Community Beta Branch is getting pushed LIVE on the Main branch! As a result of this change, we will be disabling the Community Beta Branch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please head to this announcement to see the patch notes here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would like to express our deepest gratitude to those that stuck by us and gave us crucial feedback during the updating process. We hope you continue to voice your concerns and without any more fluff… ENJOY!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
