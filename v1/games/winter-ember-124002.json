  {
   "id": "winter-ember-124002@1.5.7",
   "gameId": "winter-ember-124002",
   "displayName": "Patch 1.5.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-20T04:02:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This patch is an experimental build intended for the Community Beta Branch. It may be unstable or contain many new bugs. If you would like to learn more about our experimental process or how to opt in to our Community Beta Branch to access the experimental build, please see this post.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have spent a lot of time collecting feedback from you since Winter Ember’s launch. Much of the past several weeks was spent rebalancing and addressing the many concerns raised by the community. We hope that in this new experimental build, you will find many of those concerns dealt with.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With that said, here are the patch notes! Brace yourselves, it’s going to be a long one :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
