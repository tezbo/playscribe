 "releases": [
  {
   "id": "in-celebration-of-violence-31885@1.2",
   "gameId": "in-celebration-of-violence-31885",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-06-01T22:46:12.000Z",
   "notes": [
    {
     "title": "Additions",
     "items": [
      {
       "text": "Added local co-op. Up to four controllers may be used to play as various player-controlled NPCs. It's something!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option in the controls menu to explicitly use a gamepad. When unchecked, the player will be mostly limited to keyboard/mouse and any controllers will be dedicated to co-op.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Captain of the Guard collects the bodies of killed civilians.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Adjustments",
     "items": [
      {
       "text": "NPCs will make a stronger effort to jump away from spike traps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Flies are smaller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Small particle system adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Fixed a bug that could reduce performance when not connected to Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please be aware that this update will reset your controls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "****** Also! ******",
     "items": [
      {
       "text": "I'm working on a new game called Jousting Off. It's free right now and coming to Steam soon so try it out and let me know what you think :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
