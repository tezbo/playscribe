  {
   "id": "in-celebration-of-violence-31885@1.1",
   "gameId": "in-celebration-of-violence-31885",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2018-03-26T02:45:46.000Z",
   "notes": [
    {
     "title": "Adjustments",
     "items": [
      {
       "text": "Most enemies now have a maximum number of experience they can drop. It's still absurdly high.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The player can no longer pick up surges on the ground if they are both surging and at maximum surges.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Destroying a wall will correctly remove the fog above it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The player's resistances are no longer reset after taking the clock at the end of a run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Experience will no longer be added to a player's total if any spells still need recharging.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The cost of a spell when The Quill memento is in effect will now correctly adjust for a player's Intelligence.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Spells will spawn with the appropriate sound effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could cause The Daughter of Sow to disappear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some rogue old font.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
