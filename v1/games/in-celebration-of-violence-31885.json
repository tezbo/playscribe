  {
   "id": "in-celebration-of-violence-31885@0.9.12",
   "gameId": "in-celebration-of-violence-31885",
   "displayName": "Update 0.9.12",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-02-07T21:21:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "One more week!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Adjustments",
     "items": [
      {
       "text": "Some small performance improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Minor AI improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Fixed a bug that would cause an infinite loading screen when continuing a run when bald.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The sound when gaining a surge will now properly adjust for your volume setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some skewed text in the Sanctuary.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The achievement announcement uses the correct font.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The cutlass' secondary attack deals slashing damage instead of piercing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
