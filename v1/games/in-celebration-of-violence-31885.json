  {
   "id": "in-celebration-of-violence-31885@0.9.11",
   "gameId": "in-celebration-of-violence-31885",
   "displayName": "Update 0.9.11",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-01-25T20:14:26.000Z",
   "notes": [
    {
     "title": "Additions",
     "items": [
      {
       "text": "Additions to the thank you screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Adjustments",
     "items": [
      {
       "text": "Damage dealt during the Thousandfold boss fight scales with the player's health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved the names of controller buttons in the controls menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Enemies with no corpses will spray experience in a staggered manner on death instead of dropping it all at once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The History Book memento increases experience additively instead of multiplicatively.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Spiders spawned with the Hundred Spider Eggs memento will immediately become allies if close enough to the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Minor adjustments to the positioning of some Sanctuary objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased the maximum amount of banked experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Potentially maybe probably fixed a bug that could cause the player's sprite to appear blurry when continuing a run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Suspended run saves are properly removed after using a hole of death.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A stunned enemy will correctly end their parry stance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Controllers can properly navigate the character stats pause menu screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dodging an humanoid's attack will play the little sweat animation again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the edges of some areas opening into an empty void.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
