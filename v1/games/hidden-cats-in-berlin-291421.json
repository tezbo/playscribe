  {
   "id": "hidden-cats-in-berlin-291421@post-2025-02-26",
   "gameId": "hidden-cats-in-berlin-291421",
   "displayName": "Underground Party Bug fixed",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-02-26T14:34:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to say that we have fixed the underground party issue which was staying locked despite having completed all other bonuses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have also fixed another issue which was preventing players from clicking on cats (https://steamcommunity.com/app/2736480/discussions/0/4630358389444112891/)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You may now enjoy the game's complete experience! Let us know if it works on your end!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
