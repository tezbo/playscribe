  {
   "id": "hidden-cats-in-berlin-291421@major-2024-10-29",
   "gameId": "hidden-cats-in-berlin-291421",
   "displayName": "Bug Fixing Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-29T16:42:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! We are happy to announce we've fixed a couple of issues in the game! You many now enjoy the experience as intended. The fixed issues were as follows:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Metzgerei and Tiergarten freezing on restart.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Metzgerei and Tiergarten not registering as complete.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Lack of Congratulations image after completing a level:https://steamcommunity.com/app/2736480/discussions/0/4353373056332280259/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When the completing Tiergarten, the completed icon appears on a locked Underground level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achievements not registering on hidden kittens levels(Mac):https://steamcommunity.com/app/2736480/discussions/0/6171701201027368880/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you continue to enjoy the game! Let us know if things now work on your end!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
