  {
   "id": "orphans-280206@major-2024-10-31",
   "gameId": "orphans-280206",
   "displayName": "Halloween update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-31T16:07:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this special Halloween update, Animal City's alleys have been covered, for a limited time, with the dark atmosphere of the holidays.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you haven't played the Orphans demo yet, now is the time to immerse yourself in the terror of this dystopian city.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Orphans demo update 1.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Aesthetic and gameplay improvements",
     "items": [
      {
       "text": "Halloween decorations for the demo for a limited time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Design improvements in some sections of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New voices for Victoria",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Children appear in the main menu, after being saved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added vibration to some actions taking control.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed visual errors with some particle effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bugs with some translations.: Happy Halloween!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
