  {
   "id": "far-away-train-150527@post-2021-06-04",
   "gameId": "far-away-train-150527",
   "displayName": "バグ修正アップデートのお知らせ",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-06-04T22:54:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "バグ修正アップデートのお知らせ",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "せっかく初日にご購入いただいたのに各種不具合に遭遇された方、大変申し訳ございません。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "頂いていた不具合報告の中から特に重要と思われる",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "セーブ・ロード周りのバグ修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "車両連結器周りの不安定な当たり判定の改善",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "まれにアイテムが反応しないことがある原因の修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "その他細かいバグ修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "を行ったアップデートを配信しました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "それ以外の不具合につきましても引き続き継続的に修正し、よりゲーム本来の遊びに集中して楽しんでいただけるよういたしますので何卒よろしくお願いいたします。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
