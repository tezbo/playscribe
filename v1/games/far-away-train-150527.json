  {
   "id": "far-away-train-150527@post-2021-06-08",
   "gameId": "far-away-train-150527",
   "displayName": "バグ修正アップデートのお知らせ　6/8",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-06-08T14:16:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "バグ修正アップデートのお知らせ 6/8",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "先ほど、不具合を修正するアップデートを実施いたしました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "主な変更点は以下の通りです。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "特定の条件・操作のもとでプレイを継続すると車両の座標にずれが生じてくる問題の修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "上記に起因する、プレイヤースポーン時の問題の修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "同じく上記に起因する、車両間の移動に不具合が生じていた問題の修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "その他、文章表現など細かいバグの修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "上記の不具合が発生してご迷惑をおかけしておりましたプレイヤー様には、こちらのアップデートで以前より快適に遊んでいただけるものと考えております。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
