  {
   "id": "far-away-train-150527@major-2025-07-02",
   "gameId": "far-away-train-150527",
   "displayName": "Bug Fix Update Announcement July 2, 2025",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-02T07:28:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have recently implemented an update to correct several bugs. The main changes are as follows",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Fixed a bug in which if a player stood motionless in the train for an extended period of time, the train vibration would cause the player's coordinates to gradually shift, causing the player to become stuck in a placed object, which interfered with progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Fixed unintended expressions related to weather settings, especially those related to falling objects such as rain and snow, as intended by the development team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are confident that you will enjoy a more pleasant gaming experience with this update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
