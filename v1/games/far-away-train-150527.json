   "id": "far-away-train-150527@major-2025-10-29",
   "gameId": "far-away-train-150527",
   "displayName": "Bug Fix Update Notice October 29, 2025",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-29T05:05:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have updated FARAWAY TRAIN and fixed the following issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Main Fixes/Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where controller buttons would become unresponsive when performing specific actions while reading letters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where performing specific actions in the settings menu would cause display abnormalities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the player's footsteps would play during the ending",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to feel free to share any feedback, requests, or bug reports you may have.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
