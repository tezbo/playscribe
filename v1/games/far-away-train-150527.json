  {
   "id": "far-away-train-150527@post-2021-06-05",
   "gameId": "far-away-train-150527",
   "displayName": "バグ修正アップデートのお知らせ　6/6",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-06-05T22:35:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "本日も各種不具合修正、安定化を含むアップデートを実施いたしました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "修正内容は",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "プレイヤーの当たり判定の改善",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UI周りの挙動の改善",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "一部、非常に分かりにくかった鍵の位置の微調整",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "その他種々のバグ修正",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "となっております。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "貴重な不具合ご報告、ご意見ありがとうございます。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "引き続き継続的にアップデートしてまいりますので、何卒よろしくお願いいたします。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
