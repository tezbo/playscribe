  {
   "id": "far-away-train-150527@major-2025-09-04",
   "gameId": "far-away-train-150527",
   "displayName": "Bug Fix Update Notice September 4, 2025",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-04T09:10:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have just implemented an update to fix bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The main changes are as follows.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the display would not return to normal when reading letters while using camera focus or fast walking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where input would become invalid if certain actions were performed immediately after closing text displayed in specific locations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where in-game displays would persist if returning to the title screen at specific timing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We deeply regret the trouble.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to feel free to share any feedback, requests, or bug reports you may have.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
