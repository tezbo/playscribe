     "items": [
      {
       "text": "-Fixed a couple of issues where the character could get locked after a quick turn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added more hints about the mechanism that needs to be destroyed to move from the mansion, to outdoors, to the lab",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is hopefully the latest hotfix/quick patch. I still have some bugs pending to fix but I will try to gather them up and add some more content to be released together in a bigger patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
