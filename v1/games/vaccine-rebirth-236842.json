  {
   "id": "vaccine-rebirth-236842@1.11",
   "gameId": "vaccine-rebirth-236842",
   "displayName": "Patch 1.11",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-06-07T13:54:57.000Z",
   "notes": [
    {
     "title": "This is what the new update brings",
     "items": [
      {
       "text": "Support for mouse rebinding",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Localized into Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Minimal functionality added to the front end and menus with the mouse (scroll wheel – up and down, left click – confirms, Right click - cancels). Might need to restore default mapping in the Controls menu for it to work.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Linux build available",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "FIXES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fixed a race condition when quickturning and trying to pick up an item, could leave the item unattainable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "several changes to animations to prevent some cases where the animation could get stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fixed a problem with the Plant where it would not attack back anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Stats were switched in the front end",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "different fixes and modifications in the rooms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
