  {
   "id": "vaccine-rebirth-236842@patch-2023-05-26",
   "gameId": "vaccine-rebirth-236842",
   "displayName": "Small patch is up!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-05-26T07:37:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "FIXES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Second player in coop could not interact properly with the menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Certain puzzles weren’t activating properly for the player that didn’t solve them in coop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Audio was not set in the front end according to the preferences",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NEW FEATURES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Weapon stats now have color codes to indicate whether the selected weapon is better or worse than the equipped one (Green = better, Red = worse, Black = equal)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
