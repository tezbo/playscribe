  {
   "id": "urban-myth-dissolution-center-216784@1.3.0",
   "gameId": "urban-myth-dissolution-center-216784",
   "displayName": "Update 1.3.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-19T09:04:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today, we’ve released Version 1.3.0 for the Steam version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Select Chapter",
     "items": [
      {
       "text": "You can now start the game from any chapter via the Select Chapter option on the title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* The Chapter Select feature becomes available after clearing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* If you cleared the game before updating to Ver. 1.3.0, you can access this feature by selecting “SET COMPLETION FLAG” from the options menu on the title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Adjust Character Movement Speed",
     "items": [
      {
       "text": "You can now increase the character’s movement speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Adjust Text Display Speed",
     "items": [
      {
       "text": "You can freely adjust the speed at which text is displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Auto Text Display",
     "items": [
      {
       "text": "Text can now advance automatically without needing to click a button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fast Forward Dialogue (Unlocked Post-Clear)",
     "items": [
      {
       "text": "After completing the game, you can now skip dialogue at any time during subsequent playthroughs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Carry Over Discovered Urban Myth & Database Entries",
     "items": [
      {
       "text": "When starting a second playthrough, you can carry over the urban myths and database entries collected in your first run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "● Minor bug fixes and text corrections",
     "items": [
      {
       "text": "Once again, thank you all for playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The development team is working hard to make Urban Myth Dissolution Center even more enjoyable. We truly appreciate your continued support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
