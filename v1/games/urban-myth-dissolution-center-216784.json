  {
   "id": "urban-myth-dissolution-center-216784@1.0.3",
   "gameId": "urban-myth-dissolution-center-216784",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-14T09:05:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "On April 15, 2025, at 1:00 PST we plan to release version 1.0.3 on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We appreciate your patience, and with this update, Steam Deck users will now be able to use cloud saves.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "However, if you usually play on a Steam Deck, please launch the game on your Steam Deck at least once after 1:00 PST on April 15 and trigger an auto-save before playing on another device.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you start the game on another device before doing so, the save data on that device may overwrite the Steam Deck's save data. Please proceed with caution.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Changes in Ver 1.0.3",
     "items": [
      {
       "text": "・Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Typo corrections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where uncollected information was displayed in the notebook prematurely",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Once again, we appreciate the love and support from everyone who has played the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our development team is working hard to make Urban Myth Dissolution Center even more enjoyable. Thank you for your continued support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
