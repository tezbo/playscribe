  {
   "id": "urban-myth-dissolution-center-216784@post-2025-03-24",
   "gameId": "urban-myth-dissolution-center-216784",
   "displayName": "\"Urban Myth Dissolution Center\" Future Improvement Plans",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-24T03:09:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "It has been a month since the release of *Urban Myth Dissolution Center*,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "and we are truly surprised by the overwhelming response—far beyond our expectations!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will be releasing detailed patch notes soon, but first, we would like to share our upcoming update plans.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are some of the currently identified bugs",
     "items": [
      {
       "text": "In SNS investigations, the investigation cannot be completed even after collecting all necessary evidence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some sound effects (SE) may be excessively loud",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some sound effects (SE) may continue playing indefinitely",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "②Fixing Typographical Errors",
     "items": [
      {
       "text": "③Fixing an Issue Where Unobtained Information Appears in the Notebook Early",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "① Chapter Select Feature",
     "items": [
      {
       "text": "② Adjustable Text Display Speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "③ Auto-Play Feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "④ Skip Read Text in Subsequent Playthroughs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "⑤ Carry Over Obtained Urban Myths in Subsequent Playthroughs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Please note that these improvements are subject to change.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Once again, thank you to everyone who has played this game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Our development team is working hard to make *Urban Myth Dissolution Center* even better,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "and we truly appreciate your continued support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
