  {
   "id": "ys-x-nordics-229176@1.0.2",
   "gameId": "ys-x-nordics-229176",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-10-16T09:35:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "today we are releasing a minor patch for the Ys X: Nordics Demo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The primary goal is to fix a specific type of startup crash that could happen on some systems with a slightly outdated Visual C++ Redistributable package. This issue could be solved by manually updating the package, but we were also able to work around it at the game level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is the full list of changes",
     "items": [
      {
       "text": "Fix a potential crash on startup on systems with slightly outdated Visual C++ redistributables",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a packaging issue which caused the demo to show Japanese text in one event in chapter 3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor updates to some dynamic button prompt placements in tutorial screenshots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Correctly save the \"additional footholds\" choice selected at the start of a game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix an afterimage effect with Mana Seed Divination",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
