  {
   "id": "ys-x-nordics-229176@1.0.9",
   "gameId": "ys-x-nordics-229176",
   "displayName": "Update 1.0.9",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-19T15:43:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "today we are releasing an update for Ys X: Nordics with variety of small new features, general improvements, and mostly minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Add Steam Timeline markers when a new BGM track is played",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Offer the choice to have Steam verify the game's integrity upon crashes while running with Steam enabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Improve UI texture and font rendering sampling on low-res screens (e.g. Steam Deck)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improve PCSS shadow sampling quality in some situations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improve out-of-the-box performance on some specific configurations (specifically, \"auto\" extra_host_write_buffering now enabled by default on Intel dGPUs, and disabled by default on AMD iGPUs)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improve SDL input compatibility (change SDL hints to only use XInput and HID API)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fix recapture drill menu list button repeat handling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix Windows 11 24H2 dropping raw input randomly when alt-tabbing",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Ignore extra user folders in the save location",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some text fixes in the French localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Add missing Japanese translation for a setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, if you want to revert to the previous version for any reason, you can do so using the Steam \"Beta\" feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
