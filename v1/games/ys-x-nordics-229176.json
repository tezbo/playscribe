  {
   "id": "ys-x-nordics-229176@1.0.8",
   "gameId": "ys-x-nordics-229176",
   "displayName": "Update 1.0.8",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-11T09:30:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "today we are releasing a minor patch for Ys X: Nordics, which addresses the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved a crash which could occur in the ship loadout menu when using the mouse to change the selected slot.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed dialog message and selection window placement for very narrow or wide aspect ratios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Eliminated graphical shadow artifacts which could occur temporarily after changing the aspect ratio or field of view, before loading a new map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved some text in the French and English localizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "As always, if you want to revert to the previous version for any reason, you can do so using the Steam \"Beta\" feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Peter \"Durante\" Thoman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
