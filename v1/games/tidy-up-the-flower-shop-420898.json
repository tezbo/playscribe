  {
   "id": "tidy-up-the-flower-shop-420898@2",
   "gameId": "tidy-up-the-flower-shop-420898",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-04T03:22:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you to everyone who played this weekend, and especially to everyone who wrote a review or posted in the discussions. I read all of it, and this update covers the things that came up most.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Lighting",
     "items": [
      {
       "text": "The sunlight by the front window no longer hides the flowers. The window still glows, but the picture now adjusts when you step into the light, so you can tell the flowers apart there.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed flowers and basket tags looking dark and colourless on the Balanced and Performant quality settings. They were missing part of their lighting, which was a bug.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Sorting",
     "items": [
      {
       "text": "The flower in your hand now shows its name next to its icon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A basket holding the wrong flower now stays lit red until the flower comes out, instead of flashing once. You can change this under Options > Controls > Wrong Basket Alerts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Getting stuck",
     "items": [
      {
       "text": "Added an Unstuck button to the pause menu. It puts you back at the front door with your flowers still in hand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Flowers that get pushed out behind a wall or through the floor are now put back in the open. This works on existing saves too: load your save and a missing flower should reappear within a few seconds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Options",
     "items": [
      {
       "text": "Added a Motion Blur toggle under Options > Display.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If you run into anything else, please post in the discussions. And if you're enjoying the game, a review helps more than you'd think.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "John",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
