  {
   "id": "tidy-up-the-flower-shop-420898@post-2026-11-03",
   "gameId": "tidy-up-the-flower-shop-420898",
   "displayName": "A little tidying behind the scenes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-11-03T21:41:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update brings a few fixes to keep your time in the flower shop running smoothly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved autosave efficiency, reducing unnecessary processing and memory allocations. Existing saves remain compatible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a confirmation before deleting a save, to help prevent accidental loss of progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the main menu extending off-screen on ultrawide displays. The logo and buttons now scale together to fit while preserving the familiar layout at 16:9.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
