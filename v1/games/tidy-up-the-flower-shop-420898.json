  {
   "id": "tidy-up-the-flower-shop-420898@1.11",
   "gameId": "tidy-up-the-flower-shop-420898",
   "displayName": "Update 1.11",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-07T03:57:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks for the feedback! This update includes a few improvements to make tidying a little smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hold to place flowers — Hold the placement button for half a second to keep placing matching flowers into a basket.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fewer accidental pickups — When you're holding the right flower, aiming at a matching flower already in the basket now places yours instead of picking that one up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clearer basket tags — Larger text, with extra attention to Chinese, Japanese, and Korean. Longer names adjust to fit the cards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Held flower count — A counter beside the carousel's little heart now shows how many flowers you're carrying and your capacity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Controller menu fix — Fixed losing controller selection when returning to the main menu after changing language in Options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing, sharing feedback, and helping us improve the flower shop. Happy tidying!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
