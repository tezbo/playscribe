  {
   "id": "tidy-up-the-flower-shop-420898@1.14",
   "gameId": "tidy-up-the-flower-shop-420898",
   "displayName": "Update 1.14",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-27T17:57:58.000Z",
   "notes": [
    {
     "title": "Update 1.14",
     "items": [
      {
       "text": "A small update to make sorting a little more comfortable!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a Reduce Sunlight option under Display settings, for players who prefer gentler lighting. Also brightened the far corner in the main room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted reset volumes under tables to help prevent flowers getting stuck out of reach.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Improved pause and options menu scaling to keep them readable and on screen at wider aspect ratios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sorry to everyone who ran into a stuck flower, and thank you for the reports!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you're still unable to finish because of a missing or unreachable flower, please email john@overthemoongames.com with your save data so I can investigate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
