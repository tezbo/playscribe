  {
   "id": "shantae-and-the-pirate-s-curse-8430@1.01",
   "gameId": "shantae-and-the-pirate-s-curse-8430",
   "displayName": "Patch 1.01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2015-05-22T19:58:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing Shantae and the Pirate's Curse! This new update includes the following:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed crashes with an error relating to \"Bad Allocation\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash that prompted a \"ProfileBar.cpp\" error.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a low repro random crash that could occur when moving when transitioning between rooms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted resolution saving settings (now if you ALT+ENT to swap between fullscreen or windowed, the setting will save).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Avast would detect the title as malware and delete the EXE.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Known Issues",
     "items": [
      {
       "text": "There is a performance issue when allowing a user to view your broadcast through Steam. This issue should be resolved by Valve in an upcoming Steam Client update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
