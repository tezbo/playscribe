  {
   "id": "super-sami-roll-158582@1.1.2",
   "gameId": "super-sami-roll-158582",
   "displayName": "Patch 1.1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-02T01:05:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Some more fixes added to the game",
     "items": [
      {
       "text": "Fixed bug where using the grappling tongue just one frame before clearing a stage would cause the wrong animation to play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where, right after using the stomp skill, the grappling tongue and stomp would not work until restarting the stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where using the grappling tongue just before entering a vertical pipe would cause Sami to lose speed within the pipe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the stomp skill would not work properly if the jump button was pressed at the same time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where Sami would keep moving during the stage clear animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the fast-forward functionality on the stage intro would not work right after changing difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a couple of typos in the English localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where some enemies rotation would appear to be wrong while the game is paused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where Vera glide skill would be triggered with the LB button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Moved enemy position in stage 4-13 to make it a bit easier to pass through it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you know about any other issues let us know!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
