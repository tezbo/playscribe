  {
   "id": "super-sami-roll-158582@1.1.1",
   "gameId": "super-sami-roll-158582",
   "displayName": "Update 1.1.1",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-07-26T05:17:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone! We hope you're enjoying the game so far.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we have a few tweaks, adjustments and fixes for you. If there are any changes you like to see or bugs that you have noticed, feel free to leave comments here or join our Discord discord.gg/PGqtuvr",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the list of fixes",
     "items": [
      {
       "text": "Fixed bug where you could potentially get stuck in the damage state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Small improvements in the geometry of stages 1-6, 1-13, 2-1 and 2-3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enemy placement improvement in stage 3-4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced attack rate of Jarsilisk (Snake enemy in world 2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Slightly slowed down rotating pinball bumpers near the end of stage 2_8",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Readjusted lava colliders in Tower of Chaos levels to better match the visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added second tutorial tongue-jump signpost in 1_14",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hangbats and poles now are easier to target with grappling tongue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
