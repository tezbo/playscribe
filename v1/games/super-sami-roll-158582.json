  {
   "id": "super-sami-roll-158582@1.1.3",
   "gameId": "super-sami-roll-158582",
   "displayName": "Patch 1.1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-12T10:46:58.000Z",
   "notes": [
    {
     "title": "List of changes",
     "items": [
      {
       "text": "New difficulty mode \"Relaxed\". The time limit in levels has been removed to allow for more stress-free gameplay sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix on stage 4-13 where a jump bumper would not work in some cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added missing collider in stage 1-4.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed animation issue when using grappling tongue the same frame Sami transitions back to its Idle animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where Sami would not hug a wall if the jump button is being held down.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In stage 3-7, changed rotating bumpers so they reset to the same position on stage restart.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where pressing the jump button the same frame the tongue starts grappling could cause a jump bigger than usual.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a couple of wrong interactions when entering a pipe using the grappling tongue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed collider issue in stage 2-s1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue when pressing the stomp button the same frame that Sami hugs a wall would cause the stomp to stop working.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a couple of issues related to Speedrun mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed achievement unlock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enemy position change in stage 4-11.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
