  {
   "id": "super-sami-roll-158582@1.1.6",
   "gameId": "super-sami-roll-158582",
   "displayName": "Patch 1.1.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-09-15T05:07:18.000Z",
   "notes": [
    {
     "title": "Content",
     "items": [
      {
       "text": "Moving platforms in stage 3-7 now reset to a fixed position when the stage gets restarted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed text label in options menu that would show a wrong value when the language is changed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where zooming in and out constantly would cause the skybox to show glitched graphics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue where the player could get an undesired push force if they restarted the stage at the same frame they interacted with certain objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue in stage 2-4 where colliding with spikes could cause the player to be pushed upwards at double the speed it should",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue where using the grappling tongue while falling straight down could cause the tongue to target the wrong spot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue where repeteadly restart any of the tower levels during the animation intro could cause a particle effect to duplicate several times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed visual glitch where one of the panels of the UI when entering a stage would be shown at quite low resolution",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimized lava shader for some levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed visual glitch on animated small plants in stage 1-14",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
