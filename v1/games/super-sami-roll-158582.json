  {
   "id": "super-sami-roll-158582@1.1.5",
   "gameId": "super-sami-roll-158582",
   "displayName": "Patch 1.1.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-24T07:03:30.000Z",
   "notes": [
    {
     "title": "Content",
     "items": [
      {
       "text": "Fixed issue where Speedrun mode would not spawn checkpoints when it should",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug where playing Speedrun mode and then entering Vera's Quest mode would make it so the player controls Sami instead of Vera.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug in Speedrun mode where Yukiko would sometimes not appear when restarting from a checkpoint.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug where stomp would stop working if pressed the same frame the ledge climbing animation is triggered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed odd collision in a collider on stage 1-11.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug where the controls on stage 1-5 when using mouse and keyboard would behave like if the camera is locked.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed bug where the chips spawned after hitting a tree would still be granted to the player even if the stage is restarted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed visual glitch when pressing stomp and restarting the stage immediately.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug where the timer of a stage would not stop immediately as soon as the goal is reached.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug where jumping would get double the force if the button is the pressed the same frame the tongue starts grappling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug where jumping would get double the force if pressing the jump button 2 consecutive frames.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug where 2 chip coins in stage 1-15 were invisible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Performance improvements in several stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed fog distance in stage 3-4.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
