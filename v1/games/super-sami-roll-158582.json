  {
   "id": "super-sami-roll-158582@1.2.1",
   "gameId": "super-sami-roll-158582",
   "displayName": "Patch 1.2.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-01-05T10:20:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed bug where the boss in World 3 would sometimes play the wrong animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the player would collide with an invisible wall near the second tree of stage 1-3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where grappling into \"hangpoles\" or \"hangbats\" very quickly twice in a row would make Sami get frozen in the air.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed small visual glitch on a shadow on stage 1-6 when playing on low quality settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made sure that all rotating objects in stage 5-5 get reset to their original rotation every time the stage is restarted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug where Sami would go inside the wall at the very end of stage 5-2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed wrong shadow at the start of stage 1-8 when playing as Sami.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Slightly moved jump bumper on stage 4-S1 to facilitate a very tricky jump.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
