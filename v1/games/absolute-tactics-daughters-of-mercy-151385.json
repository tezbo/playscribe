  {
   "id": "absolute-tactics-daughters-of-mercy-151385@patch-2022-10-19",
   "gameId": "absolute-tactics-daughters-of-mercy-151385",
   "displayName": "Hotkeys and Expanded Audio Settings Patch!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-19T22:05:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, adventurers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I’ve got more news for Absolute Tactics: Daughters of Mercy. We heard you, and Patch 1.28 is now live which includes hotkeys and expanded audio settings!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the patch notes",
     "items": [
      {
       "text": "Hot Keys! Hero actions are now mapped to 1, 2, 3, 4, 5 for Move, Attack, Skills, Items, Wait. They can be rebounded to other keys.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More Audio Options! You can now adjust Music, Sound Effects, Voice and UI volumes independently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some issues with Hordes of Mercy mode Kill Counts and Rewards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusting the way the \"Blood of Mercy\" achievement is awarded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusting presentation of hero pathing arrows for easier visibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixing bugs where enemy movement range wouldn't display properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where Valentine could be invulnerable on the optional Bone River level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lots of miscellaneous small bug fixes and some situational crash fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Riv Otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
