  {
   "id": "absolute-tactics-daughters-of-mercy-151385@patch-2022-09-20",
   "gameId": "absolute-tactics-daughters-of-mercy-151385",
   "displayName": "Graphical Setting Patch!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-09-20T23:05:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello adventurers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks all for your support of Absolute Tactics: Daughters of Mercy. I’m happy to announce, with the feedback you have given us, a patch that adds graphical settings! This patch is live right now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here is a patch log of the changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Frame Rate Cap Options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Windowed and Fullscreen Options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Screen Resolution Options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Vsync Option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue in Optional Needlehorn Village where Bow of Mercy unit was inactive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other small bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re still hard at work with Absolute Tactics and coming soon we are implementing action hotkeys!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Riv Otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
