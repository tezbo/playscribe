   "gameId": "absolute-tactics-daughters-of-mercy-151385",
   "displayName": "Patch Notes #3: Additional Camera Settings",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-01-02T20:05:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey, adventurers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released a new patch that adds additional camera settings as well as other improvements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the patch notes",
     "items": [
      {
       "text": "Additional \"Camera Zoom Distance\" options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Any progress-based Steam Achievements missed (such as \"Blood of Mercy\") will be retroactively applied.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issue where Valentine could be invulnerable on some optional levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hot Keys improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Video Options improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localization updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hordes of Mercy UI updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Misc bug fixes and stability improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Riv Otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
