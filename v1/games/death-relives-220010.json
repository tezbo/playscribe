  {
   "id": "death-relives-220010@major-2025-08-04",
   "gameId": "death-relives-220010",
   "displayName": "Death Relives – Second Update Now Live",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-08-04T14:56:45.000Z",
   "notes": [
    {
     "title": "🔧 Death Relives – Second Patch Notes",
     "items": [
      {
       "text": "Based on community feedback, this second patch brings several improvements aimed at making the gameplay experience smoother and more balanced:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🌱 Gameplay Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• 🧭 The difficulty of the attic seer encounter has been reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• 🫣 Inventory can now be accessed while hiding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• 🧠 Enemy AI behavior has been improved; it now puts less pressure on the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• 🔊 Sounds triggered during puzzle solving now alert Xipe Totec less frequently.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• ✨ Collectible items are now more visible and easier to spot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• 🩸 When injecting blood into the seed, Xipe Totec now spawns farther away from the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• ⏱️ Xipe Totec’s arrival to upper floors has been delayed, giving players more breathing room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛠️ Technical Fixes & Stability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• 🕳️ Screen tearing issues on consoles have been resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• 🪟 Visual glitches on glass-like surfaces have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• 🗡️ A bug related to the attic seer’s kill animation has been addressed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Death Relives continues to grow with your support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "— Nyctophile Studios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
