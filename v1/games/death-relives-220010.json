  {
   "id": "death-relives-220010@major-2025-07-29",
   "gameId": "death-relives-220010",
   "displayName": "A Major Update Is Coming to Death Relives",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-29T19:44:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We would like to extend our heartfelt thanks to all players for the tremendous interest shown in Death Relives, as well as for your valuable feedback and comments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are closely following the constructive criticism shared by our community and continue working diligently to improve the overall game experience. In particular, we’ve taken note of your insights regarding performance, balancing, and certain gameplay elements — and have begun work on a comprehensive update accordingly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this major update, which we plan to release soon, many key improvements and fixes will be delivered to enhance your experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Death Relives continues to evolve thanks to your support. We sincerely appreciate the patience and dedication of every player who stands with us on this journey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned for new content and upcoming improvements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
