  {
   "id": "death-relives-220010@post-2024-02-10",
   "gameId": "death-relives-220010",
   "displayName": "Quick Time Event and Sounds - Some announcements",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-02-10T13:09:33.000Z",
   "notes": [
    {
     "title": "Hello Gamers,",
     "items": [
      {
       "text": "We are taking into consideration all the feedback you've provided us with. Additionally, by watching gameplay videos from various streamers, we've taken note of the deficiencies related to the game. Particularly, you've brought awareness to us regarding Quick Time Events.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the full version, we will introduce an accessibility feature for Quick Time Events, allowing those who don't enjoy them to progress through alternative gameplay. For now, we've reduced the Quick Time Events for the priests to one for a smoother gameplay experience. Furthermore, we've added sound to some death animations. We are considering making the sounds even more impactful in the full version of the game. Many people believe that the voice of God is created with an effect, but it is actually the ancient Nahuatl language used by the Aztecs. We collaborated with linguists to revive the Nahuatl language specifically for this game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bahtiyar Ardin",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Creative Director",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
