   "id": "romance-of-the-three-kingdoms-8-remake-266723@major-2026-02-13",
   "gameId": "romance-of-the-three-kingdoms-8-remake-266723",
   "displayName": "March Update Details",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-02-13T02:02:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing \"ROMANCE OF THE THREE KINGDOMS 8 REMAKE.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would like to announce the details of some of the updates scheduled for March, 2026.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an editor tool enabling you to create simple events.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a function under initial settings enabling you to adjust the strength of Turning Point effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a function under initial settings enabling you to turn Turning Point occurrences on or off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a function under initial settings enabling you to turn in-game editing on or off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a function enabling you to return all selected Gem types to their locked state and reacquire some of your Mettle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made it possible to turn on lifespans in hypothetical scenarios based on historical accounts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a button enabling you to invite officers to banquets multiple times in a row.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
