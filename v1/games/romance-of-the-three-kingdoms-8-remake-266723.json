  {
   "id": "romance-of-the-three-kingdoms-8-remake-266723@1.0.1",
   "gameId": "romance-of-the-three-kingdoms-8-remake-266723",
   "displayName": "Update 1.0.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-01T06:57:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug making it impossible to advance the game when a viceroy was employed by another force.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug making it impossible to advance the game when Gao Shun or Chen Gong was chosen as Lu Bu's successor in the Tale \"Lu Bu's Final Moments.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug making it impossible to advance the game after loading corrupted save data under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug making it impossible to advance the game when the player canceled a save or load and then quickly pressed the Delete Data button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that prevented the editing of some officers in Historical Officer Editing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where pressing the Relationship Chart button in the Officer Details screen and then immediately canceling and returning to the Officer Details screen would prevent the Relationship Chart from being displayed again when pressing the appropriate button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where moving the cursor on the Map while holding the OK button would cause the cursor to become stuck in place after the button was released.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that caused enemy units to be moved to placement locations of the player's own force on the War Council screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
