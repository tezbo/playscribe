  {
   "id": "tour-de-france-2026-396261@post-2026-07-02",
   "gameId": "tour-de-france-2026-396261",
   "displayName": "Patch Notes 2.",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-07-02T08:09:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're happy to bring you a new update for Tour de France 2026, featuring a range of gameplay improvements, bug fixes, and visual additions. This patch focuses on improving race realism, AI behavior, and overall stability, while adding new official equipment and special jerseys.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any new bugs, please do not hesitate to report them on Discord in the \"report bug\" channel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Race",
     "items": [
      {
       "text": "NEW: Added the special Tour de France jersey for Visma | Lease a Bike and Caja Rural.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "NEW: Added the special Giro d'Italia red helmet for Soudal Quick Step.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "NEW: Added the special Nogodi jersey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "NEW: Added a safeguard to prevent up to 40 riders from abandoning due to crashes in a single stage (maximum is now 5).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "IMPROVEMENT: Improved AI effort management on climbs.",
