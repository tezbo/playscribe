  {
   "id": "tour-de-france-2026-396261@post-2026-06-11",
   "gameId": "tour-de-france-2026-396261",
   "displayName": "Patch Notes 1.",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-06-11T12:37:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First of all, thank you for your support since launch day on June 4. Many of you have been playing Tour de France 2026, sharing your content, and providing us with valuable feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, a first update is available and fixes a number of issues, including custom databases, the Australian Champion jersey, the final climb of Montjuïc (Stages 1 and 2 of the Tour de France), and some incorrect jerseys worn by AI riders in Pro Team and Leader modes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any new bugs, please do not hesitate to report them on Discord in the \"report bug\" channel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full changelog",
     "items": [
      {
       "text": "My Tour",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where opponent selection was not respected when using a custom database.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Editor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the missing Australian Champion jersey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Pro Team / Pro Leader",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where AI opponents could use the same jersey as the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Critérium",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the option to enable/disable bots not working correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an incorrect leader jersey displayed in the Race Info menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed overlapping settings on the My Critérium page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "User Interface",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added jersey holders and breakaway riders to the stage results page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added visual feedback for the selected rating in the Editor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed incorrectly positioned icons on some stage profiles during Fast Forward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing abbreviations such as \"km\" and \"pts\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed stage profiles not being properly centered in certain situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the \"Feed\" command being unavailable when multiple riders are selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed random text appearing instead of points on the results page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed accented characters sometimes being replaced by \"*\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed incorrect jerseys displayed in save files.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Audio",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed missing rider names during podium ceremonies (van der Poel, van den Berg, Gee-West, van Baarle, O'Connor, Van Aert).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Stages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the final Montjuïc climb (Stages 1 & 2 of Tour de France mode) to improve AI cornering.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed Muscat Classic arches appearing on unrelated stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed vehicles partially embedded in the ground on Paris-Roubaix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed spectators occasionally floating above the ground.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "AI Behavior",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed situations where teams could allow breakaways to gain more than one hour of advantage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Miscellaneous",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a crash when using a custom database with 25 registered teams.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed options not returning to default values after a reset.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the \"Baptism of Fire\" achievement not unlocking on Xbox Series consoles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Various crash fixes and stability improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thank you for your feedback and support! 🙏",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/46056819/06a1278b802c070edda0b4a4229154dd4cfc9784.png\"]",
