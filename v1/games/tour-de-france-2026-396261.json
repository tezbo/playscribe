  {
   "id": "tour-de-france-2026-396261@post-2026-09-21",
   "gameId": "tour-de-france-2026-396261",
   "displayName": "[Open Beta] Patch notes 6.",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-09-21T12:42:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new Open Beta patch is now available in version 1.9.1.1380, only for Steam for now. You can now test it in advance via the Open Beta branch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔧 How to join the Open Beta",
     "items": [
      {
       "text": "Open Steam > Go to your Library",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Right-click on Tour de France 2026 > Click Properties",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Go to the Betas tab and select open-beta from the dropdown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can report bugs or share suggestions on the game Discord server: https://discord.gg/bKz7CU2gWu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any bugs or want to share feedback, please add \\[OPEN BETA] in your message title so we can track it more easily!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your continued feedback and support! 💬🚴",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay",
     "items": [
      {
       "text": "Fixed: inconsistent opponent acceleration on climbs located far from the finish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: leaders participating in intermediate sprints despite not being ranked in the Points classification.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: cyclists taking up the entire width of the road when preparing for intermediate sprints.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Mountain classification points not being doubled on certain Paris-Nice stages in Pro Team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: screenshots not being possible during Replay because the camera moves automatically.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: times displaying 0 seconds in Descent of the Moment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: incorrect Team classification when the race starts with two flat stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: cyclists taking up the entire width of the road when taking turns in the paceline.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Col du Haag and the Gavarnie-Gèdres finish being incorrectly classified as Category 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: Stage 2 of the Tour de France being categorized as Hilly instead of Flat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: the TurboGel parameter not working in Criterium.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: missing trajectories on certain time trial stages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: incorrect handling of tied times in team time trials.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Interface",
     "items": [
      {
       "text": "Fixed: credits scrolling speed being locked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: the results summary being able to move outside the screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: visual glitch on the order wheel in Criterium.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: pressing Back while editing the team name in Pro Team returning to the game's main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: the group name sometimes not being displayed in the TeamCom menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: incorrect TeamCom menu behavior when a cyclist abandons the race.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: an icon remaining displayed on the in-race profile after using Fast Forward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: medals not updating in the Editor when changing a rating.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: the timer disappearing during time trials.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: incorrect cyclist name being displayed on the cycling card during audio commentary.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: the gap disappearing when the General Classification leader abandons the race.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: missing icon and distance information in the Fast Forward menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: missing road texture on certain warm-up sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: incorrect mini jerseys on the Criterium results screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Visuals",
     "items": [
      {
       "text": "Fixed: vegetation issues on the Muscat Classic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: cyclists being covered in mud when it rains during the Champs-Élysées stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: incorrect city name on the Paris-Tours podium.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: bots using the same jersey as the player in Criterium.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: yellow leader helmets for the Team classification appearing in My Tour Vuelta or Supergiro.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: incorrect jerseys on certain Pro Team stages for teams using a race-specific jersey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Miscellaneous",
     "items": [
      {
       "text": "Optimized the calculation of ratings and medals in the Editor to speed up rating changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed crashes and improved overall stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/46056819/06a1278b802c070edda0b4a4229154dd4cfc9784.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TikTok X (Twitter) Facebook BlueSky Instagram Discord",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
