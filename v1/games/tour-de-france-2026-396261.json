   "id": "tour-de-france-2026-396261@post-2026-10-22",
   "gameId": "tour-de-france-2026-396261",
   "displayName": "Patch Notes 7",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-22T14:26:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear riders,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update for Tour de France 2026 is now available on Steam and consoles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch includes adjustments to the feeding mechanic, updated starting lineups, and jersey fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "changelog",
     "items": [
      {
       "text": "Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IMPROVEMENT: Rebalanced the feeding mechanic. Repeated feeding actions performed too close together increasingly reduce the rider's maximum power.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UPDATED: Starting riders for Giro di Como and Paris-Tours.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UPDATED: European Champion jersey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIX: European Champion jersey appearing multiple times during races.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "NEW: Added World Champion jersey trim for T. Pogacar.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "FIX: Sponsor issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "As always, thank you for your feedback and support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
