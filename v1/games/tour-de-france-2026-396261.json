       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIX: Incorrect leader jersey assignment for Unibet Rose Rocket.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIX: In U25 races, all riders were incorrectly marked as eligible for the U23 White Jersey.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIX: Incorrect weather displayed after rest days.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIX: My Tour weather settings also affected Pro Team and Pro Leader modes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIX: Missing race logo in My Tour when using the Vuelta or Supergiro Kit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIX: Incorrect jersey counter for UAE Team Emirates when the DLC is installed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIX: Navigation arrows could disappear in the My Tour settings menu when switching between custom databases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
