   "announcedAt": "2026-05-18T17:57:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "💥 Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a softlock when dying to the Chasing Bot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed camera issues on death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ultrawide UI now properly displayed",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "⚖️ Balance Enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🤖 Chasing Bot v2 now destroys weak ground in 3 hits instead of 6 (good luck)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "❄️ Assault Bot Unit nerfed: increased delay after Snow Ray attack",
