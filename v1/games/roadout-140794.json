  {
   "id": "roadout-140794@major-2026-05-17",
   "gameId": "roadout-140794",
   "displayName": "Gameplay Adjustments Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-17T12:21:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone! 👋",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve made a first round of adjustments to RoadOut, mainly focused on improving the early game experience. We took your feedback into account to make the beginning a bit more accessible and less punishing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the changes",
     "items": [
      {
       "text": "📦 Improved early-game crate drops",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve adjusted the drop rates to make early progression smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🧪 Droid Factory Dungeon crates can now drop Deactivated Miasma",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Used in the car healing recipe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "❤️ Recovery after death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When you die, the car is fully restored, while Claire recovers partially.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⏱️ Healing cooldown reduced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cooldown reduced from 3s to 2s (for both Claire and the car).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
