  {
   "id": "roadout-140794@1.2.22.0",
   "gameId": "roadout-140794",
   "displayName": "Patch 1.2.22.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-21T18:06:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "### Fixes & Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a softlock reported by players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues in **Aghata’s quest**",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Standardized NPC name as **“Aghata”** across the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where faction reputation could be lost on the world map without hitting the car",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed reputation loss when escaping battle encounters with other factions on the world map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Bison behavior: ---: ### Combat Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced Claire’s attack input buffer timing: This change improves combat responsiveness. Previously, pressing the attack button during ongoing animations could queue inputs for too long, making it feel like Claire was attacking automatically.: Now, the input buffer is limited to **20 frames**, giving players more precise control over attack timing.: ---: We appreciate all the feedback and reports — keep them coming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
