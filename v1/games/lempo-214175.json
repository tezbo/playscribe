  {
   "id": "lempo-214175@1.0.1",
   "gameId": "lempo-214175",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-12T14:08:35.000Z",
   "notes": [
    {
     "title": "Major fix",
     "items": [
      {
       "text": "We think we have found out the reason why saving the game in the first level would prevent the game from starting for a small number of players. This issue should be fixed in this patch, but please don't hesitate to contact us either through Steam discussions or our official Discord if you still encounter crashes relating to this. As it only happened on some machines, it was difficult to test reliably.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Other fixes",
     "items": [
      {
       "text": "Maze guard should spawn correctly after player dies in the room it's in",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Maze guard music should not start if the guard is not present",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a couple of places players could get stuck (between meshes etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a small light to guide players out of the maze better",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Modified the textures of a certain letter to better indicate there might be something more to it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Get to the Church objective could reactivate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a few blocking volumes to prevent OOB",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaked the frequency of some hints",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Glowing crystal screen effect now a bit more visible: Also I'd like to take this chance to THANK YOU from the bottom of my heart. It has been so great watching all of your streams and videos and reading all the messages.: Link to Discord: https://discord.gg/aKJhx5Zty2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
