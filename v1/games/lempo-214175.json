  {
   "id": "lempo-214175@1.0.2",
   "gameId": "lempo-214175",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-16T13:04:23.000Z",
   "notes": [
    {
     "title": "Here are the recent changes & fixes",
     "items": [
      {
       "text": "Added some more landmarks to the first map, should make navigating a bit easier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Green keycard not working after death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed drawer key not working after death",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed not being able to use Lempo's altar after second hunt in some situations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where mouse sensitivity could affect vertical movement on controllers",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Prevented using a ladder through a glass panel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made a couple of ladder collisions better",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed one candle that was supposed to be infinite but was not",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Animal cabinet objective text staying after completing the objective",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Moved a certain plank in the underground tunnel that was a bit annoying",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaked a frequency of one looping sound",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Also we would like to thank you all for the feedback and we are working hard on making the game experience even better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Support the Indie game dev by spreading the word about the game but no spoilers :P",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Link to Discord: https://discord.gg/aKJhx5Zty2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
