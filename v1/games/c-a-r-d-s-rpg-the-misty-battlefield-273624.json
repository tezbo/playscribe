  {
   "id": "c-a-r-d-s-rpg-the-misty-battlefield-273624@post-2025-01-08",
   "gameId": "c-a-r-d-s-rpg-the-misty-battlefield-273624",
   "displayName": "We have fixed a bug where English voice-overs would not play.",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-01-08T04:17:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We addressed the issue in which, even when the voice language was set to English in the settings, Japanese voice-overs were played instead of English.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you discover any other issues, please contact us at the following:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord: https://discord.com/invite/ajawXaQqnK",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Community: https://steamcommunity.com/app/2539880/discussions/1/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We apologize for any inconvenience caused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
