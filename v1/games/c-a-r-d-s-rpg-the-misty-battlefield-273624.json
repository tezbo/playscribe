  {
   "id": "c-a-r-d-s-rpg-the-misty-battlefield-273624@post-2024-05-28",
   "gameId": "c-a-r-d-s-rpg-the-misty-battlefield-273624",
   "displayName": "Addition of Voltage Tutorial and Bug Fixes",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-05-28T08:05:06.000Z",
   "notes": [
    {
     "title": "We have made the following updates",
     "items": [
      {
       "text": "▼ Addition of Voltage Tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A tutorial related to voltage has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The tutorial can be accessed from Settings > Help.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼ Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the phase could not be ended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ultra-wide monitors are now supported.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you have any questions or requests, please feel free to post them on Discord or Steam Community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Discord: https://discord.gg/ajawXaQqnK",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Community: https://steamcommunity.com/app/2539880/discussions/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your continued support of \"C.A.R.D.S. RPG: The Misty Battlefield\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
