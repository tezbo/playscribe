   "id": "c-a-r-d-s-rpg-the-misty-battlefield-273624@post-2024-06-03",
   "gameId": "c-a-r-d-s-rpg-the-misty-battlefield-273624",
   "displayName": "You can now change the text size!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-06-03T07:17:39.000Z",
   "notes": [
    {
     "title": "We have made the following updates",
     "items": [
      {
       "text": "▶ Added Text Size Option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Go to Settings > Text Size to change the value.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5 is the largest size. Adjust to your preferred size.: * The default value is 2 (same size as before).: * Not all text areas will change size.: If you have any questions or requests, please feel free to post them on Discord or Steam Community.: Discord: https://discord.gg/ajawXaQqnK: Steam Community: https://steamcommunity.com/app/2539880/discussions/: Thank you for your continued support of \"C.A.R.D.S. RPG: The Misty Battlefield\": https://store.steampowered.com/app/2539880/_CARDS_RPG/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
