  {
   "id": "c-a-r-d-s-rpg-the-misty-battlefield-273624@post-2024-05-24",
   "gameId": "c-a-r-d-s-rpg-the-misty-battlefield-273624",
   "displayName": "Addressing Game Crashes Due to PC Environment",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-05-24T05:40:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have addressed an issue where the game would crash mid-stage depending on the player's PC environment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "If you are experiencing crashes, please try the following",
     "items": [
      {
       "text": "1) Go to Options > Set V-Sync to OFF.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "2) Set the monitor refresh rate to 60Hz.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you encounter any other issues or have feedback, please post them in the technical support section below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for your continued support of \"C.A.R.D.S. RPG: The Misty Battlefield.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
