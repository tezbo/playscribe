   "announcedAt": "2026-05-12T10:42:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45201757/691054c0068fcf44a5b601973b6555f3bf947c71.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hi friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A little over a month after the launch of Go! Go! Mister Chickums, we’ve just released Update V1.0.144!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to your feedback, this patch fixes a bunch of bugs and improves the overall gameplay experience. 💛",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay & Progression",
     "items": [
      {
       "text": "Fixed an issue where achievements might not unlock or sync correctly with Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved the achievement system overall. The game will now also automatically check for and unlock any missing achievements when starting the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a rare issue that could block object spawns in special cases, preventing certain items (such as the Giant Donut) from being collectable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Defeated players no longer trigger damage feedback effects when being touched by enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In co-op mode, defeated players are now revived after completing a level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a rare issue where parts of the final boss were not properly reset after a game over.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a potential softlock that could occur if a co-op player was defeated at the exact moment the final boss was destroyed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players could get stuck in the ground during the final boss fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Audio Fixes",
     "items": [
      {
       "text": "Fixed an echo/reverb sound issue in one of the boss levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected the background music in the first bonus stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the master volume setting could reset after loading a new level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Miscellaneous",
     "items": [
      {
       "text": "Adjusted enemy layering for improved visual clarity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added support for resizing the game window in windowed mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "To resize the game window: Press Alt+Enter to switch to windowed mode, then right-click the title bar, select “Size”, and adjust the window using the arrow keys or mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "As always, we’d love to hear your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy score hunting! 🐥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The com8com1 Team: [img src=\"{STEAM_CLAN_IMAGE}/45201757/2a1a92e4d32db368c7f3589dc10df023285a222f.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
