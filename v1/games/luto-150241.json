  {
   "id": "luto-150241@post-2025-10-15",
   "gameId": "luto-150241",
   "displayName": "Luto - Patch Notes [15/10/25]",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-15T11:57:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re bringing you the first update for Luto, focused on improving the gameplay experience based on your feedback. Below you can find the full list of changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added support for ultrawide monitors.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added controller vibration, which can be toggled on or off in the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fully revised Korean localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor fixes to English and Spanish localizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added visual support to a puzzle that previously relied solely on sound.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added brightness (gamma) adjustment in the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new accessibility option to make the \"Resist\" action easier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the \"COLLECTOR OF...\" achievements so it’s no longer necessary to collect all items in a single playthrough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where subtitles could extend beyond the screen when set to large size.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Broken Bird Games Team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
