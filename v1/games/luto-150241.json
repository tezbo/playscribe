  {
   "id": "luto-150241@major-2026-07-16",
   "gameId": "luto-150241",
   "displayName": "Luto - Anniversary Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-16T15:02:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Luto is celebrating its anniversary!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'd like to take this opportunity to thank you for all the support you've given us since launch. Thanks to you, we can keep making video games. To celebrate, we've prepared an update with a few changes and new additions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Below you can find the full list of changes",
     "items": [
      {
       "text": "Added Spanish voice-over.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Italian, Polish, and Turkish localizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Completely revised the Simplified Chinese, Traditional Chinese, Korean, and Japanese localizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor corrections to the English and Spanish localizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And that's not all: Steam Trading Cards are finally here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The collection includes 7 cards (the whole family), as well as a badge, profile backgrounds, and emoticons. Will you collect them all?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Broken Bird Games Team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
