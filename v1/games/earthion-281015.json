  {
   "id": "earthion-281015@post-2025-09-10",
   "gameId": "earthion-281015",
   "displayName": "2025/09/10 Patch Notes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-10T09:21:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In preparation of our console release and due to a major score change in the latest ROM. We are going to reset all Leaderboards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "2025/09/10 Patch Notes",
     "items": [
      {
       "text": "Localization fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Audio fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed \"Press Start Button\" in Title screen in the ROMS to have a button overlay for Start Button instead of the word Start.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a version number in Extra. Representing the Frontends version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix where Names in the leaderboard were not displaying correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added ROMS version number in uploaded Scores.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Limiting uploaded Scores to be only from Latest Patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix to Subtitles not working after view the Prologue twice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix to Subtitles getting stuck if they are skipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added Leaderboards for Challenge 1-6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated ROMS to be version 3.3.0",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Earthion Version 3.3.0 Patch Notes",
     "items": [
      {
       "text": "Stage 7 - The collision position for the boss's beam attack has been adjusted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stage 8 - The hit collision for the first boss's (Neurocrawler) head has been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The prologue text has been adjusted: YK-IIA has been changed to YK-ⅡA (English and Portuguese versions)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A 1 million point bonus has been added when clearing the game without missing a shot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed display error in which NOVA's damage was not shown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Stage 4 - Fixed unexpected glitch occurring during boss battle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed incorrect stage designation in title demo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a typo (Japanese version) (戦積 → 戦績)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed display issues in the ending (Portuguese version)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the random playback frame count in the Music Player to the correct value",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed the final boss wreckage bonus so it cannot be obtained after the player dies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the countdown sequence to be easier to skip",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
