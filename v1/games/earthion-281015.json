  {
   "id": "earthion-281015@post-2025-08-04",
   "gameId": "earthion-281015",
   "displayName": "Earthion Patch Notes (August 4 2025)",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-08-04T13:04:31.000Z",
   "notes": [
    {
     "title": "2025/8/4 Patch Notes",
     "items": [
      {
       "text": "Updated Earthion game to Version 2.0.1 (which fixes in-game bugs)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Windows icon on program",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Steam Language detection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash when using integer screen scale and reducing window size below 100%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Input system selection (Steam Input/Raw Input) setting is now preserved",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Keyboard configuration has been refined",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Difficulty Achievements not being triggered",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed numerous audio issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Earthion Version 2.0.1 Patch Notes",
     "items": [
      {
       "text": "Fixed issue of subweapons becoming unusable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue of subweapons occasionally not displaying correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue of game freezing after inputting password",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue of sound effects not playing after selecting Continue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted enemy bullets to be more easily visible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted three pixels in the second half of Stage 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Start can now be pressed when selecting Continue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Can skip Countdown by pressing Start (Only in Automatic Mode)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added 2 more Challenge Modes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
