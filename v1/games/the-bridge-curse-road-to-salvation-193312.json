   "id": "the-bridge-curse-road-to-salvation-193312@1.6.0",
   "gameId": "the-bridge-curse-road-to-salvation-193312",
   "displayName": "Update 1.6.0",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-09-30T04:07:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello players, we appreciate all your love and support for The Bridge Curse Road to Salvation! Our dev team will keep polishing the project toward a better place. Also, we would like to share some recent optimization and adjustment to the project, hoping these patches will boost your gaming experience at the Kimodameshi Camp.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Optimized the localization system for Demo Version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Resolved the control problem for the Option and Staff page in Demo Version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Adjusted the language switching function for Demo Version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Resolved the control problem for the Staff page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Optimized the performance for the environments and scene props.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed the overflow texts and misspellings for multiple languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed the remaining known issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any questions or suggestions during gameplay, please feel free to share the problem at any time. We wish you a happy time in our game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
