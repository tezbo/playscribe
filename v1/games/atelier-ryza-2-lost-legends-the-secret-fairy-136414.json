      {
       "text": "Fixed an issue that prevented the Research List from being updated correctly when you open treasure chests in the high-difficulty area \"Flame Sun Island\" and the \"Keldorah Castle\" DLC area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added DLC support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed display issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor adjustments and fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
