  {
   "id": "atelier-ryza-2-lost-legends-the-secret-fairy-136414@major-2024-09-20",
   "gameId": "atelier-ryza-2-lost-legends-the-secret-fairy-136414",
   "displayName": "Atelier Ryza 5th Anniversary! \"Secret\" series optimization update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-20T09:14:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "To celebrate five years since the release of Atelier Ryza: Ever Darkness & the Secret Hideout, we have released various optimization updates for the “Secret” series!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Atelier Ryza: Ever Darkness & the Secret Hideout",
     "items": [
      {
       "text": "Note: \"Ver. 1.09\" will be displayed on the SteamⓇ version's title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed specific issues when played on Steam Deck™.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Changed the keyboard and mouse control settings in the SteamⓇ version.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added an auto-save feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option to fast forward Fatal Drive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option to fast forward event scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option to auto-play text during event scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added graphics settings to the Options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made other minor adjustments.: Update on September 20th (FRI) 8 PM JST: *The title screen of the SteamⓇ version will display Ver. 1.10.: Fixed a bug where some option settings were not saved after applying update Ver. 1.09.: *After applying updates from Ver. 1.09, all option settings will be reset only during the first launch of the game: https://store.steampowered.com/app/1121560/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Atelier Ryza 2: Lost Legends & the Secret Fairy",
     "items": [
      {
       "text": "Note: \"Ver. 1.07\" will be displayed on the SteamⓇ version's title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed specific issues when played on Steam Deck™.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Changed the keyboard and mouse control settings in the SteamⓇ version.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added the difficulty \"Very Easy\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option to fast forward Fatal Drive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option to fast forward event scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted the auto-play speed of text during event scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added graphics settings to the Options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made other minor adjustments.: https://store.steampowered.com/app/1257290/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Atelier Ryza 3: Alchemist of the End & the Secret Key",
     "items": [
      {
       "text": "Ver.1.7.0.0 (SteamⓇ)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: This will be displayed as Ver. 1.07 on the title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed specific issues when played on Steam Deck™.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added the difficulty \"Very Easy\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an option to fast forward Fatal Drive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new landmark: Kala's Tent: Note: Kala's Tent will be added as a landmark after visiting it once this update has been applied.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed the completion requirements for Klaudia's \"Three Medicines\" character quest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor adjustments and bug fixes.: https://store.steampowered.com/app/1999770/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
