  {
   "id": "the-guise-123960@3",
   "gameId": "the-guise-123960",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-09-26T11:59:48.000Z",
   "notes": [
    {
     "title": "Hello there!",
     "items": [
      {
       "text": "In this weekly progress update, we'd like to share with you the latest news of the game development.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First of all, we are happy to announce the release date of The Guise, and it is October 20!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For this event, we have prepared for you the final Gameplay Trailer of the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A free updated demo version is now available on Steam, providing you with ~30 amazing levels of the game – about 30 minutes of pure joy.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "What's new in the updated demo version",
     "items": [
      {
       "text": "Numerous gameplay improvements and bugfixes;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New mechanics - familiars, your loyal companions, and helpers;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New amulets;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New side quests;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A working shop for upgrades and leveling up your abilities;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Balance edits;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Professional English translation;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the Russian language;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added all missing sounds and music.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Currently, only Russian and English languages are available in the demo. Other languages are under development and will be available in the full version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Yours,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Guise Dev. Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
