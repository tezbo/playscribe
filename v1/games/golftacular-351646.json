    {
     "title": "Changes",
     "items": [
      {
       "text": "To ensure a better experience for all you golfers out there, we’re dropping a quick hotfix. It mostly includes minor bug fixes and polishing our courses. If any of you run into any issues at all, please let us know either through this community page or our discord!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Both Good Team :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug related to scoring without shooting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated UVs on \"Sketch\" style maps",
       "ps5ProOnly": false,
       "pcOnly": false,
