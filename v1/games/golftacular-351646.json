  {
   "id": "golftacular-351646@post-2025-10-09",
   "gameId": "golftacular-351646",
   "displayName": "Demo Patch Notes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-09T21:51:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It’s been amazing to see all of you playing our demo! With it well under way, we think its time we started squashing some bugs and improving upon our gameplay. Today, we’re happy to release our first mini patch! It includes an all new “Solo Tour” mode that allows you to play through tours in single player. Let us know what’s the best score you can get!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Once again, we’d like to thank each and every one of you who’ve spent time checking our demo out and giving us invaluable feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New “Solo Tour” mode. Play full tours in single player!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added mouse sensitivity settings",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Map Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed ghost collisions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added missing geometry",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated preview images",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Polished intro animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugfixes & Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent issue where double-selecting items locked animation in place",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rephrase “Run n’ Jump” item description for increased clarity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent issue where exiting to main menu with certain abilities active would cause the game to crash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
