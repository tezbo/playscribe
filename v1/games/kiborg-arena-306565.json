     "items": [
      {
       "text": "Added a setting for the voice volume.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a potential scenario where the arena could become too narrow on the late floors.",
