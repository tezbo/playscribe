     "title": "Changes",
     "items": [
      {
       "text": "CHANGES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaked firearms to be less powerful.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Significantly lowered the difficulty curve that grows with each floor.: IMPROTANT NOTE: The game is technically infinite, but at this moment, it is implied that if you've beaten the 15th floor, then you've beaten the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
