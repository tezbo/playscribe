   "id": "kiborg-arena-306565@post-2024-11-25",
   "gameId": "kiborg-arena-306565",
   "displayName": "GPU optimization",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-25T17:11:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch is entirely dedicated to graphical optimization. We have significantly reduced the load on the GPU which will increase the FPS by up to 20% depending on your PC configuration. It should be especially noticeable on systems with less modern GPUs and Steam Decks, in some of our internal tests the performance increased from 45 FPS to stable 60 FPS.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope this makes your runs in KIBORG: Arena even more comfortable, please let us know if you encounter any issues or bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
