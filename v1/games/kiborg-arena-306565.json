  {
   "id": "kiborg-arena-306565@post-2024-09-06",
   "gameId": "kiborg-arena-306565",
   "displayName": "Balance tunning",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-09-06T13:19:52.000Z",
   "notes": [
