  {
   "id": "classic-racers-elite-146787@major-2026-01-15",
   "gameId": "classic-racers-elite-146787",
   "displayName": "2026 January Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-01-15T09:19:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "2026 January Update - To welcome this new year, we have updated Classic Racers with graphical improvements :",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New road and ground shaders/textures: The road looks cleaner and more detailled at the same time. The road sides are more integrated and colors more natural.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New brake lights for cars: Each car has it own brake lights and is coherent with the lamp shape.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Image Effects: Post processes have been tuned to be less dark. I assume that the overall picture quality was too dark. I have enlighten it and it feels more \"natural\" while keeping the Classic Racers aesthetics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I wish you the best for 20206 !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
