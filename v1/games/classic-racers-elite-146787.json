  {
   "id": "classic-racers-elite-146787@post-2024-10-01",
   "gameId": "classic-racers-elite-146787",
   "displayName": "Please, switched the lights on ! (Lyon by Night lighting fix).",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-10-01T17:00:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The track \"Lyon by night\" is illuminated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can feel the warm light heating your heart.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You're in confidence and your drive faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your sight is no more blinded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As the road is clean, you're driving very hard",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "But warning, you could go in the grave quicker.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Marole Jonathan",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Anthems to the fearless night pilots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "October 2024.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
