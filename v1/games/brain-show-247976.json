  {
   "id": "brain-show-247976@major-2024-01-16",
   "gameId": "brain-show-247976",
   "displayName": "🕹️ Important Update for Brain Show - New Online Multiplayer Mode!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-16T09:02:30.000Z",
   "notes": [
    {
     "title": "🚀 We have great news for you!",
     "items": [
      {
       "text": "You can now enjoy an entirely new multiplayer online mode in our game. Thanks to this update, you'll experience the thrill of friendly competition with friends and players from around the world!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "👥👥👥👥👥👥👥👥👥👥👥👥👥👥👥👥👥👥👥",
     "items": [
      {
       "text": "Now you can compete online, testing who is the smartest in various quiz categories. Invite friends to private or public games, and even add bots to fully customize your experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "👥👥👥👥👥👥👥👥👥👥👥👥👥👥👥👥👥👥👥",
     "items": [
      {
       "text": "We are currently working on a small update that will soon bring fresh questions to existing categories.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Get ready for new challenges!",
     "items": [
      {
       "text": "Thank you for your support and for being with us on this exciting journey. We hope you'll enjoy the new features! 🎉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🧠 Thanks for your passion!🎮",
     "items": [
      {
       "text": "~Simplicity Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
