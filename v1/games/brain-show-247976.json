  {
   "id": "brain-show-247976@1.3.1",
   "gameId": "brain-show-247976",
   "displayName": "Update 1.3.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-08-14T13:29:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi, Brain Show players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We come to you with another patch update. Many of you have asked us to skip cutscenes - well here you go, download the latest update and enjoy this feature!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of changes",
     "items": [
      {
       "text": "Added option to skip parts of cutscenes when approved by all players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The panel informing about controller disconnection now only displays when the disconnected controller was involved in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The controller disconnection panel now disappears only when all controllers that participated in the game are connected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players' names are now displayed in the lobby",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The appearance of the lobby has been redesigned for better readability of adding bots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "The end-of-game panel now scales correctly (the one with the rematch option).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Podium now shows players correctly in all cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed setting of players on the approval panel when we have more than 4 controllers connected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where the game could incorrectly assign a controller to a player when multiple controllers were disconnected and reconnected during the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Input of controllers is now correctly assigned when we started the game without a controller plugged in",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug causing the Steam Link help panel not to close when the back button was pressed while the panel was loading",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Minor graphical fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed many other minor bugs in the operation of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We encourage you to let us know in the comments here or in the community center about your opinions on Brain Show. This way you can influence the further development of our production. Thanks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Team Simplicity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
   "digest": {
    "new": 11,
