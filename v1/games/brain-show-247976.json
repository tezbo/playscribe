  {
   "id": "brain-show-247976@1.5.1",
   "gameId": "brain-show-247976",
   "displayName": "Update 1.5.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-15T14:28:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "UI enhancements providing even better visual experiences during gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Switching the keyboard response scheme from Shift to Enter.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Changing the color scheme of responses - swapping left with right (red with blue).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ability to change lobby type from the menu - private or public.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the lobby, we'll notice when someone has joined before the player selects a character.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visibility of the game version in the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fixes in questions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other fixes for reported gameplay bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Introduced a pool of new questions to existing categories.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed the protocol in multiplayer mode from TCP to UDP, contributing to better stability and smoother gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the ability to join online gameplay from a different region (may result in higher ping).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Introduced time limits for category selection and aiming to increase gameplay fluidity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Now, in 1vs1 matches, a target will be automatically chosen to facilitate dynamic competition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the number of lifeline questions in the final round, with the last available one restoring 50% health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Balanced the dynamite competition to not last too long.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay improvements to eliminate issues with players leaving matches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved bot behavior, resulting in a more realistic gaming experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Extended the time for searching public lobbies to provide more opportunities to join games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "For your support and suggestions!",
     "items": [
      {
       "text": "We look forward to further feedback from you to make our game even better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wishing you a fantastic time! 🎮✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~ Team Simplicity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
