  {
   "id": "brain-show-247976@1.4.2",
   "gameId": "brain-show-247976",
   "displayName": "Update 1.4.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-20T15:14:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Brainiacs! An update has just been released for BrainShow, with language corrections for questions from English categories, and now you can enjoy the game with your friends in local mode! An additional piece of information that I will give you is that the time until the update for multiplayer version is getting closer and closer, in which new categories will also appear! We plan for you to be able to face knowledge and/or hate each other during the holidays with your family :D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Change Logs",
     "items": [
      {
       "text": "Added V-Sync, which is responsible for the frame rate limit in the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Linguistic corrections in the English version: reading of the narrator, content of questions, verification of answers and questions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera position in the scene - there will no longer be railings in the foreground when the camera moves in the scene.: ~ Team Simplicity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
