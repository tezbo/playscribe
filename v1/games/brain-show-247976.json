   "announcedAt": "2023-09-15T10:30:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi, Brain Show players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After rechecking the translation, we come with corrections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Corrections",
     "items": [
      {
       "text": "corrected translation of the game interface in Spanish and Portuguese (br)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "That would be it, enjoy playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "~ Team Simplicity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
