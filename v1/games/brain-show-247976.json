  {
   "id": "brain-show-247976@1.4",
   "gameId": "brain-show-247976",
   "displayName": "UPDATE 1.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-13T13:03:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Brain Show community!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As promised, we come to you with 2 new language versions. From now on you can also play Brain Show in Spanish and in Portuguese (Brazilian).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Implementation of Spanish and Portuguese (Brazilian) languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Language selection panel is now scrollable to display more languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rebalanced in-game category selection with bots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Redesigned the Steam Link help panel to more closely match the game's graphical style.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed bug with music fading out when skipping scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed text scaling to make the UI look better with long texts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed animation in the intro, where the presenter was taking steps unnaturally when entering the stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrections in questions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The French version is still under testing, as we want to bring you the best possible translation. We will keep you updated once we know its publication date.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "~Team Simplicity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
