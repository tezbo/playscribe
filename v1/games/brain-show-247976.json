  {
   "id": "brain-show-247976@1.2",
   "gameId": "brain-show-247976",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-07-12T13:17:17.000Z",
   "notes": [
    {
     "title": "Hi, Brain Show fans!",
     "items": [
      {
       "text": "As announced, today we released update 1.2!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of changes",
     "items": [
      {
       "text": "Improved the options menu - added volume control, easier language change, resolution change, fps control and more",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rebalanced in the final the power of weapons and the regeneration of life after the rescue question",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added interfaces to the finale to inform about the current weapon power and health regeneration for the rescue question",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added dynamic control prompts depending on the controller selected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Graphically improved the submission interface",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected errors in questions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Look forward to the August 2 update 1.3, which will introduce the feature of adding AI-controlled players to the game. If you have any questions, feel free to contact us here in the comments or in the Community Center.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Team Simplicity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
