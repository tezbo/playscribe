  {
   "id": "brain-show-247976@1.3",
   "gameId": "brain-show-247976",
   "displayName": "Update 1.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-08-02T11:39:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi, Brain Show community!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As promised, today we are delivering in an update the option to fill the lobby with bots. There is even the possibility to launch the game without a single player. Who wouldn't want to bet with their friends about which bot will win, right? This is just how we suggest such an idea.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of changes",
     "items": [
      {
       "text": "Added the option to play with bots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a panel containing a tutorial on how to control the game with a phone using the SteamLink app",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced the life taken by weapons in the finale",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the amount of life points received at the rescue question",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Shortened the duration of the round with dynamite",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "The volume sliders in the options menu can now be held down to change their value faster",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Corrected the font on some of the panels to match the rest of the panels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Pausing the game no longer interrupts background music",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improvements to the operation of the options menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug that caused the lobby to stutter when a player canceled readiness at the last minute",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added button click animation in the menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bugs related to volume settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Corrections in questions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Other changes and fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "That would be enough. We encourage you to share your opinion and ideas, because every feedback is important to us, and it is an opportunity for you to influence the further development of Brain Show! Enjoy the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Team Simplicity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
