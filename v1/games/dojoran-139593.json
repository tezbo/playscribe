  {
   "id": "dojoran-139593@2.0.1.0",
   "gameId": "dojoran-139593",
   "displayName": "Update 2.0.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-02-12T18:07:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We updated a few more things that were missing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of changes",
     "items": [
      {
       "text": "Added another tutorial board.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We made extremely small changes to the Stage 4 platforms to help beginners.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We added 3 new achievements, which give some purpose to achieve all the objectives of the game (besides the current one). If you have already completed the game, they will probably be activated automatically.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We made a small change to the animation of the Temple to improve the attack forecast.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Some slugs were moving in a single block.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mayha Murasaki",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
