  {
   "id": "dojoran-139593@1.0.1.1",
   "gameId": "dojoran-139593",
   "displayName": "Patch 1.0.1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2020-11-12T14:36:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This version contains some changes regarding the feedbacks received in the Beta version, which remained in the Live version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increase in analogic control deadzone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added two new achievments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "SPOILER - Stage 28: Boss's health decreased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a small bug in the stage selection, where you could move the cursor after selecting the stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Attempted to fix a bug that caused Sprite to not follow the player at the beginning of the stage (probably on low performance computers). Still in test.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We do not intend to make any more significant changes in level design, this being a special situation. Still, we will pay attention to bugs that significantly affect gameplay, and we will add new languages according to the donations we have received from the community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate all the support and suggestions we received from the players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mayha Murasaki",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
