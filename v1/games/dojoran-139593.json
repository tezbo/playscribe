  {
   "id": "dojoran-139593@2.0.0.9",
   "gameId": "dojoran-139593",
   "displayName": "Update 2.0.0.9",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2021-02-02T08:19:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dojoran hasn't received any updates in a while, which means the bugs are running out! (at least the ones we've discovered so far)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of changes",
     "items": [
      {
       "text": "Changed the location of the first bird in stage 10. He got the wrong timing according to the player's arrival, after the 2.0.0.0 update (I'm sorry for WR, I wish I had done this before!).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor changes in credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It is now specified that some translations were done by the community (Please contact us on Twitter if you want to include a different translation <3).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "The animation when spitting the apple now does not reset when picking up another apple.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The stage 24 HUD was invisible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mayha Murasaki",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
