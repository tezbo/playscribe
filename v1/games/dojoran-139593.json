  {
   "id": "dojoran-139593@2.0.0.8",
   "gameId": "dojoran-139593",
   "displayName": "Update 2.0.0.8",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-12-21T02:14:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some minor corrections were made to the timer, and improvements to the game's level design in favor of a fairer game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of changes",
     "items": [
      {
       "text": "Now, you only need to activate the color change in one Save Slot, and you can enjoy the feature in any other new Slot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minimal changes were made to the level design of stages 5, 17 and 20. We are changing some places that were \"wrong\" after several changes in the game after launch, and made the game look unfair rather than difficult.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed the game timer in the final cutscene, and credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Now the timer also updates correctly when killing the boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We are constantly monitoring how the game is being played. Possible changes of this type can still occur in the level design.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We appreciate all the feedback from the players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mayha Murasaki",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
