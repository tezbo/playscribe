  {
   "id": "rounds-145341@1.05",
   "gameId": "rounds-145341",
   "displayName": "Update 1.05",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-04-11T13:30:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Decreased time to trigger abyssal countdown and increased its duration",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Cold bullets now stack past just the first 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dazzle: Increased duration by 25%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Life stealer: Decreased steal amount from 8 to 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Leech: Changed phrasing from \"bullet life steal\" to just \"life steal\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Phrasing: Changed \"Loads more\" to \"A bunch more\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Careful planning: Now reduces attack speed by 150% instead of 100%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Poison: Now reduces your ammo by 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Poison: Damage increased from +60% to +70%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Parasite: Hp bonus reduced from 30% to 25%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Toxic cloud: Removed the -25% dmg stat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Healing field: Reduced time to activate from 2s to 1.5s",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where shield charge would have longer range based on the players health.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Grow: Increased distance to reach full damage from 30m to 40m and reduced max damage from +180% to +160%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
