 "releases": [
  {
   "id": "rounds-145341@post-2024-11-26",
   "gameId": "rounds-145341",
   "displayName": "Bug fixes, more achievements and PS port!",
   "kind": "dayOne",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-26T14:01:06.000Z",
   "notes": [
    {
     "title": "Hello everyone! We have a small patch fixing some quality-of-life stuff and adding more achievements!",
     "items": [
      {
       "text": "We're also releasing the game on PlayStation today, meaning there will be more players to crossplay with! You can get the PlayStation version here: https://store.playstation.com/en-us/concept/10009990",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Made it possible to have crossplay with Playstation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Added options menu to in-game pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed various localization issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bullets not growing correctly from some card effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue when players press join at the same time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Better readability in some menus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added option to mute chat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New achievements!",
     "items": [
      {
       "text": "Accidental Winner: Win 10 rounds by your opponent falling out",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Winner: Win 20 matches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Frosty: Use Frost Slam 20 times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Champion: Win 50 Matches",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Demon: Use Demonic Pact 3 times in a single match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In Control: Use Remote 3 times in a single match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Teleporter: Use Teleport 3 times in a single match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Star: Use Supernova 3 times in a single match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Joker: Lose 0-5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Radiant: Use Radiance 3 times in a single match",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Phoenix: Use Phoenix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Shield Up: Trigger a block with Shields Up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sharp: Use Saw",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Mods",
     "items": [
      {
       "text": "We know a lot of people play ROUNDS with mods and that some mods may not work with this new version, here's how you can still access the mods:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you want to play ROUNDS with mods we have made the beta branch available for the old pre-Xbox patch version of the game - this seems to be the most compatible version with most major mods. You can access it by: Right-clicking on Rounds in your Steam Library > Properties > Betas > In the drop-down menu, select \"Old ROUNDS for mods\" for the pre-2023 version of the game or version_1.1.1 for the version before this update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    }
   ],
