  {
   "id": "rounds-145341@1",
   "gameId": "rounds-145341",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-23T12:51:10.000Z",
   "notes": [
    {
     "title": "Hello everyone! Thank you all for alerting us to the bugs in the last update, we're looking into them all but to start we have a patch to fix some of them.",
     "items": [
      {
       "text": "If you have more bugs to report or crashes please email us at support@landfall.se with crash logs and as much detail as you can - it helps us figure out what's wrong.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Fixed issues with objects blending into the background and other visual issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rematch issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Hypersonic Achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where both sets of cards would spawn in at once",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue where you could no longer press shift to change the map theme",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the L in \"Glass Cannon\" was invisible: If you play with a friend on Xbox some of these issues may persist as it takes a while to patch console platforms - but a fix is on the way there too!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    }
   ],
