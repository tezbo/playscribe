  {
   "id": "rounds-145341@1.1.1",
   "gameId": "rounds-145341",
   "displayName": "Patch 1.1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-15T17:32:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone! Thank you for being patient as we sort out some bugs from the latest update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We know some of you are sad about the fan-made mods no longer working since the update - we've spoken with the modding community and they're working to fix their mods. In the meantime please check out the modder-run discord modding server for updates: https://discord.gg/rounds-modding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(We as developers do not moderate this server but we thought it would be good to link it for those of you who are having issues with your mods or that want to know more about mods in general)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remember that these modders are making mods in their free time and because they love the game, please be patient while they work on fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes 1.1.1",
     "items": [
      {
       "text": "Hide map border in the main menu (Only affects ultra-wide screen)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Confine cursor to monitor when in exclusive fullscreen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wrecking ball and moving platforms now render correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bullets now correctly scale based on damage from cards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't count EMP for Beekeeper achievement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't allow chat to open with a gamepad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Remember to verify the integrity of the game files to ensure you're on the right update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
