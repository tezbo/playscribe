  {
   "id": "re-village@major-2023-09-15",
   "gameId": "re-village",
   "displayName": "The RE4 DLC \"Separate Ways\" launches 9/21! A free update is also coming!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-15T03:00:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fan-favorite Resident Evil 4 additional scenario “Separate Ways” returns as new story DLC on 9/21!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Separate Ways—the missing link in the main story—is a thrilling, survival-horror adventure starring Ada Wong.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, on the same day an update arrives for the free DLC \"The Mercenaries\", adding new playable characters. If you haven't experienced Resident Evil 4 yet, the base game is currently discounted for a limited time!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "https://store.steampowered.com/app/2050650/Resident_Evil_4/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "https://store.steampowered.com/app/2109315/Resident_Evil_4__The_Mercenaries/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■The mission requires secrecy. Failure is not an option.",
     "items": [
      {
       "text": "Play as Ada Wong in this additional scenario and experience the events of Resident Evil 4 from her perspective, filling in unanswered questions posed in the main story. See the other side of the story from her eyes as her mission, and fate, intertwines with Leon Kennedy's a second time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Ada Wong and Albert Wesker are now available in a free update for “The Mercenaries!”",
     "items": [
      {
       "text": "A new update adds Ada Wong and Albert Wesker as playable characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"The Mercenaries\" is a free DLC available to owners of Resident Evil 4, which offers another type of survival experience to players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Other popular Capcom titles including the Resident Evil franchise are currently discounted as part of the Capcom Tokyo Game Show sale!",
     "items": [
      {
       "text": "https://store.steampowered.com/bundle/34737/MONSTER_HUNTER_FRANCHISE_PACK/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "https://store.steampowered.com/bundle/34738/FIGHTING_TGS_PACK/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "https://store.steampowered.com/app/367500/Dragons_Dogma_Dark_Arisen/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "https://store.steampowered.com/sub/692569/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
