  {
   "id": "re-village@patch-2022-10-17",
   "gameId": "re-village",
   "displayName": "Notice and apology regarding the latest patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-17T09:05:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "After installing the latest patch, the following has been observed:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・A message appears that mentions the need to restart the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Game crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We apologize for any inconveniences this may have caused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are currently working hard to fix this issue, please give us some time to have the issue is resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Once again, we apologize for the inconvenience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Resident Evil Village Dev Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
