  {
   "id": "lemon-cake-137111@2",
   "gameId": "lemon-cake-137111",
   "displayName": "Patch 2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-02-27T22:31:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! Here’s another quick patch for Lemon Cake. With this update I’ve increased the value of early pastries to help with the player progression and added the mouse clicks as additional controls to interact and sprint around the bakery. I’ve also fixed some bugs that have been reported in the last week.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added left mouse click to interact.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added right mouse click to sprint.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug where not all keyboard inputs could be rebinded.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Increased the value of some early pastries.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a bug where the Sweet Pretzel wasn’t displayed as vegan.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bonus tip percentage can now go over 100%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pastries placed in the display windows now sell for their full value.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prevent the player from getting stuck petting a cat at the end of the day.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Highlight purchasable upgrades in the skill tree.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I’m making some really good progress on our first content update which will include a new minigame to catch bugs and earn some extra money and a new character! I think this update will be a nice addition to Lemon Cake and I expect to release it in the next few weeks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Éloïse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
