  {
   "id": "lemon-cake-137111@1",
   "gameId": "lemon-cake-137111",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-02-19T17:56:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! Thank you all so much for playing Lemon Cake and giving me your feedback on the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I just released a patch for Lemon Cake that focuses on balancing the cost of some upgrades and reducing the frequency of a few tasks (like sweeping spills and adding firewood). I realized it took a bit too long to progress in the skill tree, so I hope this update will improve the flow of the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s a quick list of the changes made",
     "items": [
      {
       "text": "Fixed a bug where the game sometimes froze after leveling up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased the character’s collision size to make it easier to reach items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased how long the firewood lasts (both before and after upgrading it).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced the kitchen spills spawn frequency.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased the tip percentage gained from menu bonuses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced the cost of some upgrades in the skill tree.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added the possibility to open the store by interacting with the front doors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Let me know what you think about these changes and I hope you will all enjoy running your bakery! :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
