  {
   "id": "raccoin-coin-pusher-roguelike-360748@1.0.23",
   "gameId": "raccoin-coin-pusher-roguelike-360748",
   "displayName": "Patch 1.0.23",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-14T05:40:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Balance Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Percentoin adjustments",
     "items": [
      {
       "text": "Base value increased: 5%→10%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "However, its effect value now decreases as rounds progress, down to a minimum of 2%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Berserker Badge nerf",
     "items": [
      {
       "text": "Triggering the negative effect will strengthen the next negative effect.: Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed using the Mirror Badge after loading a save would not copy modifiers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed missing sound feedback on some buttons in the settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an occasional display issue with the description of Golden modifier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
