  {
   "id": "raccoin-coin-pusher-roguelike-360748@1.1.1",
   "gameId": "raccoin-coin-pusher-roguelike-360748",
   "displayName": "Patch 1.1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-07-09T13:06:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new \"Auto-Insert\" option under Gameplay Settings. (You can now choose which Modifiers and Rarities should be auto-inserted.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "\"Return\" coins that are auto-sold due to the full Coin Clip will now display a popup notification.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a Menu button to the bottom-right corner of the Classic Cabinet, ensuring the menu can always be accessed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Clicking an empty area of the scoreboard now toggles the text outline on and off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UFOs now knock over Coin Towers when they collide with them, preventing clipping issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All coins with area of effects now display their effective range while hovering over them.: Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Tanghuluoins would not spawn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Steam Rich Presence not updating correctly while playing the Classic or Lab Cabinet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed clipping issues involving the Frogoins, Trash Can Lids, and UFO Caller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed asymmetrical decorations on the Tempura skin and missing serrated edges on the Crab Claw.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed game audio would still be suspended when the game window lost focus, even if \"Pause in Background\" was disabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the game's volume could not be adjusted through the Windows Volume Mixer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Additionally, an earlier issue where muting the game through the Windows Volume Mixer would permanently mute the game was already fixed in v1.0.22.: Text Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed singular/plural inconsistencies in the descriptions of some Chips across multiple languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Renamed the Lab Cabinet setting \"Transparency\" to \"Opacity\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated the name and icon of the Score Rate increase buff (\"Mars\" → \"Score Rate\").",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved Spanish - Spain localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
