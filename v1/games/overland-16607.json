  {
   "id": "overland-16607@post-2019-10-16",
   "gameId": "overland-16607",
   "displayName": "Build 639",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2019-10-16T03:25:16.000Z",
   "notes": [
    {
     "title": "Hey folks! More maintenance goodies coming your way",
     "items": [
      {
       "text": "Fixed shy dumpsters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rebalanced mountains and desert to fix tripwire placements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Daisy-chaining out-of-gas scenarios will consume fuel now (sorry, time travelers)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tents are searchable now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed crash from SUVs offroading into anomalies during escapes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rare \"walkouts trapped forever in tiny tree prisons\" issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Husks won't get knocked back by explosions anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added \"level restart off required\" icon to Badges interface",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed \"level restart off\" requirement on a bunch of achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed \"restart level\" button being enabled during campfires",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some map placement issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Camera adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Expect another patch before end of week to address some issues that have come up with the new \"stun\" feature, and hopefully some small camera improvements too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
