  {
   "id": "overland-16607@post-2020-01-15",
   "gameId": "overland-16607",
   "displayName": "Build 713 Available Now",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2020-01-15T19:23:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey folks! Thanks for bearing with us over this holiday break, and giving us a bit of time to work on the vinyl release. Build 713 is live now with a bunch of little features and fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dogs can pull people into cars now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Organize view available in more situations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new cold-weather idle animation in snowy levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Stealing cars and gas will count as burglary again",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed missing Steam Overlay / Achievements on Mac OS 10.15",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a level generator issue with searchable barrels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rare issues with the quicksand and falling objects events",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed organize view rendering issue with certain trades",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed animation issue with lit flares and the relax poses",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with beach campfire showing up in the organize view",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted some introduction pacing stuff",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Texture maintenance stuff",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Feels good to be catching up on QA. We've got a few more patches coming in the next week or two, and then there probably will be a bit of a gap while we work on a couple of bigger additions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
