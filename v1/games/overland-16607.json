  {
   "id": "overland-16607@post-2019-09-24",
   "gameId": "overland-16607",
   "displayName": "Build 612",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2019-09-24T22:43:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey folks - Build 612 will be live in just a few minutes. Here's what you can expect:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Teleport loops should be proper fixed finally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The in the Basin have a stronger attack now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Invert X/Y Axis option now applies to mouse controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Vehicle headlights stay on at night even while the car engine is off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the creator of the Open Dyslexic font to the credits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Low-content campfire conversations will get skipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ground items will get outlined just from cursor hover.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Extinguishers can be used to rescue generators now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fuel scavenger NPCs are a bit smarter and more efficient now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated some of the game over dialog logic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Likely another patch coming tomorrow and thursday as we continue to isolate little bits and pieces that aren't having quite the effect that we hoped. Thanks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
