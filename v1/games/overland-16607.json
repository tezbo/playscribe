  {
   "id": "overland-16607@post-2020-10-07",
   "gameId": "overland-16607",
   "displayName": "Build 840",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2020-10-07T15:53:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Howdy folks! Just summarizing a bunch of small quality of life changes that have come through in the last few patches:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed a rare issue with music in the second intro level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed an issue with save file upgrades",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "\"relaxing\" characters get access to basic Organize and Inspect abilities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed a Steam Achievement issue with the pickups badge",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "some pugs were Too Large, it Wasn't Healthy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed an issue where the \"relax\" action sometimes wasn't available when it should have been",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a terrain offset",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a campfire offset",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a AI issue where they sometimes would just... leave the level for no reason",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "I think that should do it! Hope everyone's enjoying 1.2 otherwise <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
