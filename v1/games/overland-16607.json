  {
   "id": "overland-16607@post-2020-02-07",
   "gameId": "overland-16607",
   "displayName": "Build 733",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2020-02-07T21:58:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This week was all about refinement - lots of little UI, level generation, audio, and graphics improvements in this patch:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Re-skinned the Inspect view to match the Organize view!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Re-did some of the trading site logic so that traders usually start out next to tables (seems small but feels so nice)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new end-of-level audio cues that change depending on failure/victory/etc",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased survivor movement speed by almost 10%. Feels nice!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed some long-standing bugs with audio and lighting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various balance + difficulty changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've got one more small, mostly-audio patch coming early next week and then we'll be focusing on the big final content drop!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
