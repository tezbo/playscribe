  {
   "id": "overland-16607@post-2019-10-10",
   "gameId": "overland-16607",
   "displayName": "Build 632",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2019-10-10T00:16:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey folks! Sorry for the delay - we wanted to get a little extra QA in and also got sidetracked doing some weird code signing stuff that may or may not have actually worked. ANYWAYS:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed accidental roadblocks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dogs can push stuff now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rebalanced out-of-gas scenarios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Minor rebalance on pickups",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated wood shield and stick assets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Y'all won't be able to tell hopefully but we also rebuilt our deployment automation, which will help us keep the PC stores sync'd up more easily, and comply with some weird new security stuff too. Basically, future patches are even easier to upload.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
