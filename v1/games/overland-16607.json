   "id": "overland-16607@post-2019-09-30",
   "gameId": "overland-16607",
   "displayName": "Build 624",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2019-09-30T18:37:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey folks - today's patch is a small one, but fixes some important stuff:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Woodlands and grasslands pharmacies have been rebalanced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug with negative-HP shields in certain rare scenarios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with telefragging yourself without actually teleporting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with backpacks at camps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with fidgety traders.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We're also continuing to look at other learning curve issues and will have more updates about those things soon. Thanks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
