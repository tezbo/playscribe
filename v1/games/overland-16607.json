   "id": "overland-16607@post-2019-09-27",
   "gameId": "overland-16607",
   "displayName": "Build 622",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2019-09-27T21:53:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey folks! Thanks for your patience. Super happy with today's patch:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the issue with attachment detachment. Detach away, detachers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Driving or walking out with abandons will trigger a confirmation popup now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "INSPECT includes ground items now, and show's more item status.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated full bottle's 3D model to differentiate from empty bottle more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Built-in screenshot function should take the post-processing into account now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Turning off the car engine is faster now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various other bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Audio adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Streaming fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have some more PC-specific quality-of-life stuff coming but hopefully we can go into a slightly less frantic maintenance cadence for the next little bit here!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
