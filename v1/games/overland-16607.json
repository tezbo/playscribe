   "id": "overland-16607@post-2019-10-18",
   "gameId": "overland-16607",
   "displayName": "Build 644",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2019-10-18T01:03:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey folks, tonight we've got a bunch of good bug fixes to smooth out some of the new Stun gameplay plus a grab-bag of other minor improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Radios and dog barks won't create diplomatic incidents at camps anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More range and reactiveness for the level camera gamepad controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shadow-banned popular Twitch bots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disabled the camera zoom-cuts during level action",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced camera angle resets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Stunned creatures can block burrows now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Most stunned creatures cannot be shoved anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slime won't stun creatures anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various other stun fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slime will devour creature corpses now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vehicle headlight cutscene fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Particle and animation adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mac OS 10.15 compatibility",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
