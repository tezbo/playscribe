  {
   "id": "saga-emerald-beyond-266681@major-2024-05-10",
   "gameId": "saga-emerald-beyond-266681",
   "displayName": "SaGa Emerald Beyond Update Content",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-10T09:03:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Spell targets will now be displayed while a spell is chanting as long as the original target is still alive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Animations during some main menu operations have been shortened and response speed increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Tips screen now clarifies that scanning requires the player to press and hold the button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the issue wherein monster abilities could not be absorbed from the Cordycep fiend Lord of the Earth.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue wherein a technique with the Delay effect causing a United Attack to be broken would not properly take into account the number of units participating in the United Attack when recalculating the combo rate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue wherein poison damage did not occur at the proper timing during an Overdrive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue related to additional United Attacks when an Overdrive occurs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue wherein monster abilities would not be absorbed when a Glimmer occurs during an Overkill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue wherein an Overdrive occurring during an Unleash ability would cause the Unleashing creature to not participate in the Overdrive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed abilities that cannot be absorbed from the Monster tech list.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted a misleading description in the Mr. S Trial It's Showtime.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed the issue with the Mr. S Trial Unleash and Absorb wherein the trial would not be considered completed if an Unleash and Absorb occurred during a single Showstopper.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Increased the amount of combo rate increase provided by Chain attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the types of techs chosen for Overdrives.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue with conditional techs glimmered from Chain attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved the issue wherein a Showstopper could erroneously lead into a United Attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue wherein a character equipped with two different weapon types performing a Showstopper would have role effects specific to one type of weapon erroneously apply to techs performed by the other type of weapon.: (Ex. Dreadblayde Nobunaga applying instant death-level damage to non-two handed sword techs.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue wherein The Final Trial during Tsunanori Mido's journey would erroneously occur immediately before the final boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various minor graphical issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various minor text issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted various UI display elements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added further support for keyboard and mouse controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Shift + Mouse and the number pad may now be used to control the camera in areas where camera control is enabled.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed other minor issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
