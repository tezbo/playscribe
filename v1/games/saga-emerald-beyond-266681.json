  {
   "id": "saga-emerald-beyond-266681@major-2024-06-14",
   "gameId": "saga-emerald-beyond-266681",
   "displayName": "SaGa Emerald Beyond Update Content",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-14T09:11:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue wherein certain battles would not end if the player engaged in an endless loop of overdrives.: Adjusted the combo rate for when a player enters their fourth consecutive overdrive and beyond.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several issues related to trading specific items in multiples.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the trade menu hierarchy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added functionality to toggle between items on the Item Enhancement screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added descriptions stating that damage taken will be also increased when under the effect of certain damage-increasing effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue related to which doors are chosen in the junction when only two doors are available in Tsunanori Mido’s story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple minor graphic display issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple minor text issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted various UI display elements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed other minor issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
