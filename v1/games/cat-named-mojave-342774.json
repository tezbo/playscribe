 "releases": [
  {
   "id": "cat-named-mojave-342774@major-2026-03-16",
   "gameId": "cat-named-mojave-342774",
   "displayName": "Update Notes 3/16/26",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-16T16:08:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Small Content Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45579060/4c94fbdea396a41ca796519d86bd69518f35d95b.png\"]??????????????????",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam deck verified!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Cat Named Mojave is now Steam Deck Verified! ✔",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Russian, Japanese, and Simplified Chinese now have official language support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have worked extensively with translators to provide improved Russian, Japanese, and Simplified Chinese localizations. Russian and Ukrainian also now use an updated font that better matches the original game font.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many grammar and spelling issues across the game have been corrected, which should improve readability in several languages. Oversized characters in some languages have also been adjusted so that text appears more consistent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you so much to everyone who has supported Cat Named Mojave. Your support has meant a lot to us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We especially love seeing the characters through the many talented artists who have created fan works, and we hope to see even more in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "While we will continue fixing bugs, content updates for Cat Named Mojave have officially concluded. Development will now begin on our next project.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Follow us here and on our social media for updates on what comes next.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Follow development updates",
     "items": [
      {
       "text": "X (Studio): https://x.com/StargazersLLC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "X (Mike): https://x.com/MikeGemi1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Instagram (Studio): https://instagram.com/stargazersstudios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Instagram (Mike): https://instagram.com/mikegemi1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "YouTube: https://youtube.com/@stargazersstudiosLLC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "TikTok: https://tiktok.com/@stargazersstudios",
       "ps5ProOnly": false,
