     "items": [
      {
       "text": "Hello Adventurers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PC Settings Improvements",
     "items": [
      {
       "text": "Expanded support for additional screen resolutions (21:9 ultrawide, 16:10)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Windowed mode now available",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Addition of individual graphics settings to replace the former Quality/Performance modes",
     "items": [
      {
       "text": "Shadow Quality (Low, Medium, High)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Texture Quality (Low, Medium, High)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
