  {
   "id": "ninja-gaiden-ii-black-329132@1.0.7.0",
   "gameId": "ninja-gaiden-ii-black-329132",
   "displayName": "Update 1.0.7.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-12T03:24:09.000Z",
   "notes": [
    {
     "title": "• Additional Content",
     "items": [
      {
       "text": "New Game+: Added the ability to begin a new game on a difficulty level you have previously cleared with the weapons and Ninpo you obtained in your previous playthrough already unlocked. When starting a new game this way, your weapons and Ninpo will be reverted to level 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Photo Mode: Added Photo Mode to the in-game Options Menu. You can move the camera around within a set limit to take screenshots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ability to Hide Projectile Weapon: Added a \"Show Projectile Weapon\" option under \"Game Settings\" in the Options Menu, which allows you to hide your projectile weapon while it is carried on your back.: • Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Lowered the HP of enemies in Ch. 8, \"City of the Fallen Goddess\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Lowered the HP of enemies in Ch. 11, \"Night in the City of Water\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Raised the number of enemies in Ch. 13, \"The Temple of Sacrifice\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Raised the number of enemies in Ch. 14, \"A Tempered Gravestone\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Raised the damage dealt by some of Ayane's attacks.: • Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed control issues that occurred when playing at over 120 FPS or while under high computing load.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where controllers would not vibrate based on computing load or FPS settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bugs that caused the player to go out of bounds during certain chapters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bugs that made it impossible to progress during certain chapters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug which caused the game to crash during long play sessions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Other minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
