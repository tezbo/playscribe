  {
   "id": "spectrolite-176361@3",
   "gameId": "spectrolite-176361",
   "displayName": "UPDATE 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-05-16T17:06:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello there everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UPDATE 3 of Spectrolite is coming in hot, featuring full gamepad support with force feedback, a more forgiving Wall Slide and several bugfixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you are a veteran player looking for a new way to experience the game, or just someone who is more comfortable with a gamepad than the keyboard and mouse, this update is for you!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Good luck and have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "See the detailed changelog of UPDATE 3 here",
     "items": [
      {
       "text": "GAMEPAD SUPPORT",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spectrolite can now be fully controlled by your gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Force feedback on ability uses (can be turned off in the Game options).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4 different control schemes to choose from.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "OTHER FEATURES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the Wall Slide mechanic to be more forgiving when connecting to a wall at low speeds (Wall Slides will accelerate you to a minimum speed after you connect if your speed would be extremely low).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "UI can be navigated using the keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can accept/decline popup messages using the keyboard (no need for mouse click)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added an option to invert the camera X and Y axis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added sound effect when you fall into water on Moonstone",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "FIXES AND ADJUSTMENTS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with being able to clip out of the starting train on Spectrolite.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a camera fade-in when you arrive to the first area of Spectrolite.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the issue with some objects not being properly unloaded on Spectrolite.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted some slide connections on Spectrolite.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a too large hitbox near the beginning of Moonstone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a few parts where you could get stuck on Serpentine.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed floating jump pads on Aquamarine",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
