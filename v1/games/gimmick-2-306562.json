   "id": "gimmick-2-306562@patch-2024-09-24",
   "gameId": "gimmick-2-306562",
   "displayName": "The first major Gimmick! 2 patch is here",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-09-24T14:16:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! Gimmick! 2 released two weeks ago and today we're launching our first major patch on Steam that will fix reported issues, as well as adding some extra polishing.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "IMPROVEMENTS",
     "items": [
      {
       "text": "Spear Ohagi spear hitbox reduced from 3 to 2.5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated death animations for multiple enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Hoho celebration animation updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Flying Ohagi dive animation updated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Add Flying Ohagi alert state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated Yumetaro walk and jump particles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated Warp Door animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated Barûntaro idle animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated faded out sticker when taken",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated beam/rail visuals for moving platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added more freedom to use Yumetaro's original horn with other horns unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Hoho will now wave a pink flag if all chests and stickers from it to the next Hoho location has been taken",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "BUG FIXES",
     "items": [
      {
       "text": "Fixed multiple cameras throughout all levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enemies pushed into slopes should no longer visually turn back",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated rendering order so that the star always render behind pipes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated rendering order for roof bomb explosions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed screen going permanently black if going to level select when dying and then opening a level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where Ohagi with headgear does not take damage after first hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Crash if returning to level select through menu when dying",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
