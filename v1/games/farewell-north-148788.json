  {
   "id": "farewell-north-148788@major-2022-01-29",
   "gameId": "farewell-north-148788",
   "displayName": "Canoe and Accessibility Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-01-29T08:59:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In this devlog you'll see how community feedback is being directly incorporated into the canoeing mechanic, making for a much more polished experience, and new accessibility options to help you enjoy Farewell North the way you'd like to experience it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On the canoe side, the animations have been greatly improved, though they're still not quite final. The colouring mechanic, where optimally timed paddle strokes bring colour rushing temporarily out of the canoe and increasing movement speed, has been overhauled to be much more visually interesting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New accessibility options have been added, including the ability to disable all visual aids for those who want a more explorative experience, and the ability to disable the canoe paddle timing requirement for those with motor impairments or who just prefer a more relaxed canoe gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
