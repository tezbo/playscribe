  {
   "id": "farewell-north-148788@post-2024-08-19",
   "gameId": "farewell-north-148788",
   "displayName": "Patch Notes for August 19th",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-08-19T15:21:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hiya folks! Just a few fixes and quality of life improvements based on your feedback. In this patch we have:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Gaelic Subtitle modal when starting a new game now shows a preview of the subtitles based on your current On/Off selection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a Simplified Chinese translation mistake on the Gaelic Subtitle modal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a floating power cable at the Uair farmhouse going to nowhere depending on the time state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a strange animation when Cailey gets off her bike while off-screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with Cailey petting the air and not moving after a certain cutscene: Please keep the feedback coming, it's been an absolute joy to read all of the reviews!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
