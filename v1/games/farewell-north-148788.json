  {
   "id": "farewell-north-148788@post-2024-08-22",
   "gameId": "farewell-north-148788",
   "displayName": "Patch Notes for August 22nd",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2024-08-22T08:41:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hiya folks! I've just published another patch, v1.0.23, with several more fixes and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved one of the munro paths on Uair that previously acted as an invisible wall, preventing Chesley from smoothly navigating the trail",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Shifted some rocks on Sealladh that had the potential to trap Chesley",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a character encoding issue causing Japanese characters to appear in Simplified Chinese text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a typo in one of the subtitles on Bròn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare issue causing one of the cutscenes near Northray Skerry to lock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for labels in the photomode window that would overlap in some languages the first time photo mode was activated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please keep writing and sharing your reviews, I thoroughly enjoy reading them and they help us out tremendously. Happy adventuring!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
