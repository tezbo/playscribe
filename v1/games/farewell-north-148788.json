  {
   "id": "farewell-north-148788@1.0.19",
   "gameId": "farewell-north-148788",
   "displayName": "Patch 1.0.19",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-08-17T15:08:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone, we're absolutely thrilled with the response to Farewell North so far, and hope you're enjoying running around the Scottish isles with Chesley and Cailey!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This first patch addresses some minor issues that have been raised, and we'll continue to keep an eye out for any issues you're facing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelist",
     "items": [
      {
       "text": "Adds the Gaelic translations for the \"My Heart's in the Highlands\" lyrics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adds a missing collider on the lighthouse doors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixes a rare soft-lock issue in the final island",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you again for the wonderful feedback, your reviews have been a real joy to read! If you haven't left a review yet, please consider writing one as it's a tremendous help for us <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
