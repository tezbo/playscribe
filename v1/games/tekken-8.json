  {
   "id": "tekken-8@1.11",
   "gameId": "tekken-8",
   "displayName": "Patch 1.11",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-01-17T16:49:21.000Z",
   "notes": [
    {
     "title": "TEKKEN 8 - Patch 1.11",
     "items": [
      {
       "text": "The update data for TEKKEN 8 will be distributed with the following details:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Version",
     "items": [
      {
       "text": "Ver.1.11.00",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Application Date and Time",
     "items": [
      {
       "text": "[] From around 11:00 on Wednesday, January 15th, applied sequentially",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[] From around 3:00 on Wednesday, January 15th, applied sequentially",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "From around 18:00 on Tuesday, January 14th, applied sequentially",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Maintenance Date and Time",
     "items": [
      {
       "text": "[] Wednesday, January 15th, 10:30 – 14:00",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[] Wednesday, January 15th, 2:30 – 6:00",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tuesday, January 14th, 17:30 – 21:00",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Note",
     "items": [
      {
       "text": "Please note that the date and time may change without prior notice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All online content will be unavailable during maintenance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Impact of the Update",
     "items": [
      {
       "text": "The application of the update data will affect the following modes and features:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[]DOWNLOADED REPLAYS / MY REPLAY & TIPS: Replay data from before the update will no longer be playable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[]ONLINE REPLAY: All replay data from before the update will be deleted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "SUPER GHOST BATTLE / GHOST MATCH: The behavior and performance of characters after the update will be reflected in ghost data. There will be no loss of data.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "TEKKEN SHOP",
     "items": [
      {
       "text": "“Flamboyant Pack” Added: Flamboyant Hair (Hair): Flamboyant Haori & Hakama (Upper Body): Flamboyant Geta (Shoes): Flamboyant Peacock Feathers (Accessory)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Sublime Pack” Added: Sublime Hair (Hair): Sublime Long-Sleeve Kimono (Upper Body): Sublime Geta (Shoes): Sublime Fan (Accessory)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“TEKKEN SPECIAL DEAL” Available: Selected items available at special prices during the event period.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "MAIN MENU",
     "items": [
      {
       "text": "[]Characters can now be selected from Customized Slots: Added the ability to select main menu characters from slots other than “PRESET” via OPTIONS > Screen Settings > Main Menu Character Display Settings > Costume.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[]Added UI Hide Function: Press [R3/R Stick/N] to hide the UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "CHARACTER CUSTOMIZE",
     "items": [
      {
       "text": "“Shared Customize Slot” Added: 20 customization slots shared across all playable characters.: Access the shared tab from each character’s dedicated slot screen.: []“Add to Favorites” Function: Press [□/X button/U] in the customization slot list to add/remove favorites.: []“Replace” Function: Rearrange customization slots by pressing [△/Y button/I].",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "QUICK MATCH / GROUP MATCH / TEKKEN BALL (ONLINE)",
     "items": [
      {
       "text": "Added Rematch Function: Players can rematch from the result screen after a best-of-3 match without returning to the matchmaking standby screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "PRACTICE",
     "items": [
      {
       "text": "[]Improved “Punishment Settings” Display: Configured CPU behavior settings now displayed in the “Punishment Settings” list.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[]Improved Photo Mode Controls: Mouse wheel can now be used for zoom in/out operations (Steam version only).",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ],
       "pcOnly": true,
       "category": "other"
      }
     ]
    },
    {
     "title": "OPTIONS",
     "items": [
      {
       "text": "Hide Other Player Information: Configure via Screen Settings > Hide Other Player Names / Hide Friends/Following/Rivals.: Opponent player names in various modes will appear as “-”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hide Friends/Following/Rivals Displays: Configurable in lounges, profiles, and match result screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "REPLAY",
     "items": [
      {
       "text": "Access Replay List from Profile Screen: Players can now navigate to a replay list directly from a profile.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "PLAYABLE CHARACTERS",
     "items": [
      {
       "text": "Adjusted Behavior and Performance: Behavior fixes and performance adjustments have been applied to Heihachi and Clive.: Heihachi received minor adjustments to address unintended phenomena.: Clive underwent significant balance changes, suppressing the performance of certain overpowered moves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Sound and Visual Improvements: Enhancements were made to sound effects (SE), voice, and visual effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "BUG FIXES",
     "items": [
      {
       "text": "Win Streak Display Fixed: The win streak display in “PLAYER MATCH” session screens now accurately reflects consecutive wins within the same session.: Win streaks in “PLAYER MATCH” will be reset after the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
