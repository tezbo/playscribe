  {
   "id": "tekken-8@2.0",
   "gameId": "tekken-8",
   "displayName": "Patch 2.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-02T12:45:07.000Z",
   "notes": [
    {
     "title": "The higher your opponent’s rank, the more points you earn for a win",
     "items": [
      {
       "text": "The lower your opponent’s rank, the more points you lose for a defeat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Examples)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "You: “Fujin” (Rank 21) vs Opponent: “Battle Ruler” (Rank 20)",
     "items": [
      {
       "text": "> Win: +720pt / Loss: -1280pt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "You: “Fujin” (Rank 21) vs Opponent: “Fujin” (Rank 21)",
     "items": [
      {
       "text": "> Win: +1000pt / Loss: -1000pt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "You: “Fujin” (Rank 21) vs Opponent: “Raijin” (Rank 22)",
     "items": [
      {
       "text": "> Win: +1280pt / Loss: -720pt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Promotion bonus points are now only awarded once upon reaching a new highest rank",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The system that caused a significant point drop after 3 consecutive losses has been removed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The win streak bonus system has been adjusted",
     "items": [
      {
       "text": "Bonus points for win streaks are now only available up to “Tenryu” (Rank 17)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For ranks “Tenryu” and below, bonus points start applying after 3 consecutive wins",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For ranks “Tenryu” and below, the more wins in a row, the greater the additional points earned",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Now possible to choose from",
     "items": [
      {
       "text": "”Same Rank Only” / “±1 or lower” / “±2 or lower” / “±3 or lower” / “No Restriction”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Now displays combo count and combo damage in actual battles, just like in “Practice” mode",
     "items": [
      {
       "text": "To turn the display OFF, go to OPTIONS > “Screen Settings” > “In-Battle Status Settings” > toggle ON/OFF",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In “PRACTICE” and “MY REPLAY & TIPS”, you can toggle it from the “Display Settings” in the pause menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "A practice-only stage with a wall distance of approximately 500m is now available",
     "items": [
      {
       "text": "Select “Practice Stage” under “Restart Settings” and press [Touchpad/View button/V] + [×/A/J] (normal restart method) to switch to the practice stage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can also switch to the practice stage by pressing [Touchpad/View button/V] + [↑]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To return to the original stage after switching with [Touchpad/View button/V] + [↑], press [Touchpad/View button/V] + [×/A/J]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The following CPU actions can now be set",
     "items": [
      {
       "text": "Heat Burst / Heat Burst (Cancel) / Standing Block / Crouching Block /",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Low Parry / Dash / Back Dash / Sidestep (Into Background) /",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Side Walk (Into Background) / Sidestep (Into Foreground) / Side Walk (Into Foreground)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "“V-Sync” settings are now available on PS5 and Xbox Series X|S",
     "items": [
      {
       "text": "Can be toggled ON/OFF via Options > Graphics Settings > V-Sync",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Season 1 leaderboards have been reset",
     "items": [
      {
       "text": "Online ranking data from Season 2 is now viewable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Season 1 stats have been reset in the following categories",
     "items": [
      {
       "text": "BATTLE (ONLINE), OTHER (ONLINE section only), PLAYSTATS, CHARACTER DATA (ONLINE)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Newly accumulated stats from Season 2 are now displayed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "YouTube : Link",
     "items": [
      {
       "text": "Thank you for your continued support of “TEKKEN 8”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
