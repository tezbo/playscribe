  {
   "id": "metal-eden-331214@0.2",
   "gameId": "metal-eden-331214",
   "displayName": "Patch 0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-17T15:00:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hyper Units,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We really appreciate the feedback you gave during the event and as a thank you we have a little surprise for you – we’re releasing patch 0.2 today!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update addresses several of the most frequently reported issues based on your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PATCH 0.2 SUMMARY",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Performance boost",
     "items": [
      {
       "text": "Reduced memory usage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Faster loading",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Smoother streaming",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Combat rebalanced",
     "items": [
      {
       "text": "Adjusted weapon damage and ammunition counters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Rebalanced enemy health and damage values",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Modified upgrade pricing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved enemy aiming behavior",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated the 'Armor Opening' mechanic to feature extended duration and increased damage output",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Overhauled health restoration functionality at checkpoints",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New mission objective system",
     "items": [
      {
       "text": "Clearer HUD tracking with primary and secondary goal display",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "UI & controls overhaul",
     "items": [
      {
       "text": "Better keybinding support",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Upgrade stat previews",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved menu navigation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Zipline issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FULL PATCH NOTES – BUILD 114404",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "⚡ Performance & Technical Optimizations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced texture sizes and improved compression (memory savings)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Decreased VFX intensity and decal lifetimes (especially explosions and smoke)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cut down on shader compilation times and deferred heavy sequences",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Navmesh, collision, and geometry fixes across multiple zones",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Disabled ray tracing and heavy post-processing effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🧭 New Gameplay Systems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mission Objective Hierarchy Overhaul",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "UI upgrade: Primary and secondary mission objectives now display as a clear hierarchy on the HUD and summary screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved clarity for players tracking complex missions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reworked Controls & Input Mapping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added support for unassigned actions with new warning prompts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "⚖️ Gameplay Balance & Mechanics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Global Combat Tuning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Checkpoint Health Restoration: Health recovery at checkpoints has been overhauled to scale with difficulty level. For example, on EASY, players receive full health restoration, while on BRUTAL, no health is restored.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Armor-Opening Mechanic: The duration of the armor-opening state has been increased, and weapons now deal significantly more damage during this window.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Difficulty-Based Balance Pass: A comprehensive balance update has been applied across all difficulty levels, including adjustments to weapon and enemy damage, ammunition counters, resource values, PigShop upgrade prices, improved enemy aiming behavior, and various other gameplay parameters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Pistol SmartMod Update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
