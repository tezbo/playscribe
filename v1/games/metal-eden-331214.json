  {
   "id": "metal-eden-331214@major-2025-04-17",
   "gameId": "metal-eden-331214",
   "displayName": "Release Date Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-17T13:13:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve decided to move the release of METAL EDEN to Summer 2025.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After going through the feedback from the demo, we saw some clear areas where we can improve. We’re taking a bit more time to refine the game and make sure it delivers the experience we’re aiming for. Your input has been a big part of that process, and we appreciate it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We know delays aren’t ideal, and we really appreciate your patience. We’ll share the new date as soon as we can—and we’re confident it’ll be worth the wait.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The METAL EDEN Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
