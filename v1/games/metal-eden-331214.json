  {
   "id": "metal-eden-331214@hotfix-2025-11-04",
   "gameId": "metal-eden-331214",
   "displayName": "New Game + Hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-11-04T16:00:32.000Z",
   "notes": [
    {
     "title": "The latest hotfix addressing previous issues with save files being wiped when starting NG+ is now live. Please make sure to update your game to the latest version.",
     "items": [
      {
       "text": "Once your game is updated you should see your previous game save files. When starting a New Game + playthrough a new save file will be created and no previous save files will be overwritten or removed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[UPDATE 13.Nov.2025] When Starting an NG+ playthrough your original game save will become your core NG+ save. This means that you will not be able to get back to the pre-NG+ game state unless you had other game saves you have not started NG+ playthrough on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your support and patience while we were working on triaging and solving this bug! We will continue closely monitoring for any post-hotfix feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-METAL EDEN Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
