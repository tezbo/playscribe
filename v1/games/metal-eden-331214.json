  {
   "id": "metal-eden-331214@patch-2025-10-17",
   "gameId": "metal-eden-331214",
   "displayName": "NG+ Patch Rollback",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-17T18:53:42.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're aware of the issues you experienced with NG+ and the loss of your save files.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've reverted to the previous version of the game on Steam and are investigating the issue on all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We'll let you know once the issue is solved. We apologize for any convenience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-METAL EDEN Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
