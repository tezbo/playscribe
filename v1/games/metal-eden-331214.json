  {
   "id": "metal-eden-331214@0.3",
   "gameId": "metal-eden-331214",
   "displayName": "Patch 0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-09-05T15:05:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Your feedback helped us tune performance, fix audio issues, improve localization — and overall get the game into better shape for launch. We’ve updated it with new improvements like refined controller settings, sound volume controls (now adjustable by 1%), improved performance and the option to change difficulty during gameplay. We’re incredibly grateful for the support — and we hope to see you in the full game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– Reikon Games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Demo Patch Notes (PC)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Overall performance optimizations for smoother gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collision issues resolved across multiple areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Demo now ends in prologue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Audio fixes implemented for better sound quality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Polish translation improved with more accurate localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced controller settings for better input customization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Sound volume adjustment refined — now adjustable in 1% increments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New feature: Difficulty level can now be changed during gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/990380/METAL_EDEN/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
