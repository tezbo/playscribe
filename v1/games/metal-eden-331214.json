  {
   "id": "metal-eden-331214@1.1",
   "gameId": "metal-eden-331214",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-02T15:00:30.000Z",
   "notes": [
    {
     "title": "Patch 1.1 is now live. Please make sure to update your game to the latest version.",
     "items": [
      {
       "text": "VISUALS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have made a few improvements to the visual quality of the game fixing the following:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved previously reported collision Issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Misplaced decals have now been added appropriately",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved various streaming issues causing some objects to suddenly appear and disappear from players surroundings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaked zfight to eliminate undesirable flickering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various improvements to open geometry of certain objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "GAMEPLAY & BALANCING",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A full re-balancing for Lightning Gun bringing it more in-line with similar weapons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Miscellaneous tweaks to balancing on Hard / Brutal game difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Switching between weapons now feels more responsive due to a shorter cycle delay animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
