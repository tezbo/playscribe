   "displayName": "Update 1.4.0.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-22T07:35:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue where quest details and objectives would not be displayed correctly on the quest screen when more than a certain number of quests were accepted, as well as quest indicators not working properly on the map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where it was impossible to complete the \"Where Did That Energy Go\" quest under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in the \"Follow the Leading Bird\" quest that caused the game to stop responding in some cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the game to stop responding when a specific operation was performed on a specific screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where it was impossible to synthesize the Iridescent High-Purity Mucus under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where it was impossible to transfer a Super Trait to the Waking Emerald.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some of the adventure effects applied to the Secret Key did not work properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved compatibility with the new DLC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed display issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
