      {
       "text": "Fixed an issue where Klaudia's \"Klaudia, the Artist\" quest failed to occur under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where it was sometimes impossible to continue the \"The Underworld Forest\" quest after being defeated in a battle against the Deranged King.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where, regardless of the gathering level or tools equipped, a “key” symbol is displayed on gathering points signifying that gathering requirements are not met.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved compatibility with the new DLC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Other minor adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
