  {
   "id": "atelier-ryza-3-alchemist-of-the-end-the-secret-key-217558@1.5.0.0",
   "gameId": "atelier-ryza-3-alchemist-of-the-end-the-secret-key-217558",
   "displayName": "Update 1.5.0.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-22T07:36:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Improved the Graphics Settings option so that the depth of field can be set to High, Normal, Low, or Off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved readability of English texts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where mouse and keyboard controls did not respond under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue that caused the game to stop responding when using Dian's Fatal Drive under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the game to crash right before transitioning to the Battle Results screen under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the \"Creating Prototypes\" quest failed to occur under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in the \"A Special Gift from Hometown\" quest that made it impossible to deliver the requested item to the client under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in which the descriptions of some skills, item effects, and traits differed from their actual specifications.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where certain items could not properly receive the effects displayed on the Guide.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where it was impossible to exit the Item Rebuilding screen under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the music to not play correctly during certain battles in some cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved compatibility with the new DLC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed display issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other minor adjustments and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
