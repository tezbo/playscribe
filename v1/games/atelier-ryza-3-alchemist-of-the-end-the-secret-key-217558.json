   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Additional Maximum Difficulty Patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an option to change in-game BGM.: This function can be accessed through the Diary in any atelier and allows the player to change the BGM that plays at specific scenes during the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue that prevented players from unlocking the \"Your own answer\" achievement after completing Patricia's quest in a specific order.",
