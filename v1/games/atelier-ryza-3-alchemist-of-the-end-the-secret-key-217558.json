   "id": "atelier-ryza-3-alchemist-of-the-end-the-secret-key-217558@1.6.0.0",
   "gameId": "atelier-ryza-3-alchemist-of-the-end-the-secret-key-217558",
   "displayName": "Update 1.6.0.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-08-24T02:03:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue in the DLC expansion \"Rosca Island\" where the target monsters in the \"Dian's Fighting Spirit\" quest did not appear in some cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in the DLC expansion \"Rosca Island\" where it was sometimes impossible to complete the \"Collecting Texts 3\" quest even after reading all of the texts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that caused the item's quality to drop through Item Rebuilding or Duplication under certain circumstances after applying the DLC expansion \"Rosca Island\" and learning the Max Efficiency skill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some English translations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
