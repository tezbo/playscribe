  {
   "id": "paper-cut-mansion-86512@post-2022-11-01",
   "gameId": "paper-cut-mansion-86512",
   "displayName": "Fix for Visual C++ Runtime Error",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-01T10:12:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are really sorry that some of you have experienced an error on launch preventing you from playing. Good news, we worked really hard to get to the bottom of it. A big shout out to hech363 for helping out with the testing, thanks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It should be solved now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please update the game and let us know. We are here to help.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
