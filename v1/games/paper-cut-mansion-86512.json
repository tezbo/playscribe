  {
   "id": "paper-cut-mansion-86512@post-2022-10-31",
   "gameId": "paper-cut-mansion-86512",
   "displayName": "Bugs fix",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-10-31T13:56:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are listening! We have improved the MOUSE CONTROLS as suggested and working on more improvements as we speak. Happy Halloween.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved mouse controls;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug related to changing language during a run;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
