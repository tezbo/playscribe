  {
   "id": "paper-cut-mansion-86512@post-2022-11-04",
   "gameId": "paper-cut-mansion-86512",
   "displayName": "Floor 6 fix",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-04T15:34:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some of you reported a problem with floor 6, a big thanks to markoh00 for sending us a video. We realized that the problem was not related to the GPU but to an error in the positioning of the boss on spawn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We were not able to reproduce it on our PCs but we changed some of the code related to that functionality and we hope it will work correctly now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue being awesome in sharing with us any issue you find while playing so that we can fix all those pesky bugs lurking in there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(GOG update coming soon too)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
