  {
   "id": "paper-cut-mansion-86512@1.6",
   "gameId": "paper-cut-mansion-86512",
   "displayName": "Update 1.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-11-24T12:47:20.000Z",
   "notes": [
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "Achievements (kill enemies, lock count, evidence and equip count) should now work correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ghost won't lose track of the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an extra set of portals near the end of the level, reducing the amount of backtracking during a run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fix a crash in offline mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cinematic can be skipped after the first time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dexterity will now slightly increase the player movement speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dodge roll should now work correctly even when in aiming mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduce the amount of deaths needed to unlock some evidence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix a potential problem with the Brute in case the player teleported to a special room while the enemy was on a wall and about to jump",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Nerfed the boss damage and reduced punch speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fix a rare bug that was causing the player to unlock the same card twice",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The input should now work correctly while in afk mode in the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Coins should now work fine in hard and very hard mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug with the talking door, if you were to change dimension while the door was opening",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
