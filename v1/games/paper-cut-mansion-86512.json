  {
   "id": "paper-cut-mansion-86512@post-2022-11-16",
   "gameId": "paper-cut-mansion-86512",
   "displayName": "Steam deck improvements",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-16T13:44:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are trying our best to make the game run smoothly on the Deck without the need for any workaround. This patch should allow you to play Paper Cut Mansion on the latest version of Proton.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We will start the process to get the official Steam Deck validation on the store page.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
