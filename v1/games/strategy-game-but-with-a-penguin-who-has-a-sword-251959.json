  {
   "id": "strategy-game-but-with-a-penguin-who-has-a-sword-251959@major-2023-12-07",
   "gameId": "strategy-game-but-with-a-penguin-who-has-a-sword-251959",
   "displayName": "Development update December 2023",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-07T09:57:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The development of the game has advanced and the game is now about 80% finished.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New enemy type",
     "items": [
      {
       "text": "There is a new type of enemy. It's a tree? It moves like the knight in chess.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "50 hand-designed levels finished",
     "items": [
      {
       "text": "Now there are 50 hand-designed levels in total. I don't plan to add any more before release, so now I'm focusing mostly on the randomly generated levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New cutscene images made and story finished",
     "items": [
      {
       "text": "The story is now complete. I made many pixel art images for the cutscenes. Here is a small part of a cutscene image:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "What is the penguin destroying? You would have to play the game to find out. :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Improved random generation of levels",
     "items": [
      {
       "text": "The randomly generated levels are now more interesting. I also fixed many bugs related to them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
