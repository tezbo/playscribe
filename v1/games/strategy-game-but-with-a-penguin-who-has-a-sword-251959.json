  {
   "id": "strategy-game-but-with-a-penguin-who-has-a-sword-251959@1.0.1",
   "gameId": "strategy-game-but-with-a-penguin-who-has-a-sword-251959",
   "displayName": "Update 1.0.1",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-04-05T21:18:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This is a quick update with some bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "These bugs were fixed",
     "items": [
      {
       "text": "Sometimes, stairs to the next floor keep spawning inside a wall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "In the last cutscene, there's a sentence that keeps repeating itself.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some achievements aren't unlocking correctly (e.g. coins, deaths and kills)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you buy skins for your prenguin and restart the whole game, the skins aren't unlocked and you have to buy them again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "It was not possible to proceed past level 100",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Edit: Also fixed a game breaking bug that appeared after fixing achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
