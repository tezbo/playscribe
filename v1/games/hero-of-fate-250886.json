  {
   "id": "hero-of-fate-250886@3.0.4.11",
   "gameId": "hero-of-fate-250886",
   "displayName": "Patch 3.0.4.11",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-29T03:08:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "3.0.4.11 Small patch update instructions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
