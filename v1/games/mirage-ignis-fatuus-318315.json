  {
   "id": "mirage-ignis-fatuus-318315@1.0.5",
   "gameId": "mirage-ignis-fatuus-318315",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-20T03:53:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Before we dive into the patch notes, we’re thrilled to share that we’re in the running for SQOOL GAME AWARD 2025 SUMMER! We couldn’t have come this far without your amazing support! 🎉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Manafield levels just got a stylish makeover in this patch — we hope you love the new look! 😊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This patch also includes the following bug fixes",
     "items": [
      {
       "text": "Entering the Settings screen from the Pause menu no longer cause the game state to become unpaused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing colliders in the levels \"River Crossing\" and \"The Three\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an odd issue where the Pause menu items look smaller than the rest of the UI.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The following issue is known, with a planned fix in the near future:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Render flickering in specific platforms of select levels in certain GPUs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you enjoy playing Mirage: Ignis Fatuus thus far, please help us leave a positive review on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
