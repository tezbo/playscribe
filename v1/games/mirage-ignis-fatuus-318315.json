  {
   "id": "mirage-ignis-fatuus-318315@1.0.6",
   "gameId": "mirage-ignis-fatuus-318315",
   "displayName": "Patch 1.0.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-27T03:50:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In this update, we blacked out the out-of-bound areas of the Mt. Ignifer levels. Hopefully this will reduce confusion!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also, render flickering on Intel GPUs has finally been fixed!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you enjoy playing Mirage: Ignis Fatuus thus far, please help us leave a positive review on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
