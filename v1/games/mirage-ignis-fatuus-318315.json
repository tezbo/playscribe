  {
   "id": "mirage-ignis-fatuus-318315@1.0.4",
   "gameId": "mirage-ignis-fatuus-318315",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-29T03:14:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In this patch, arrow keys are now functional in the menus and during gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This patch also includes the following bug fixes",
     "items": [
      {
       "text": "Fixed irregular rendering layers in the levels \"Mt. Ignifer\", \"A Warm Welcome\", \"Hot Potato\", and \"The Escape\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed level failing when colliding with Cocky Kube.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The following issues are known, with a planned fix in the near future:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Render flickering in specific platforms of select levels in certain GPUs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Entering Settings screen in the Pause menu causes the game state to become unpaused.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you enjoy playing Mirage: Ignis Fatuus thus far, please help us leave a positive review on Steam!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
