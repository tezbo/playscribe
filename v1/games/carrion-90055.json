  {
   "id": "carrion-90055@major-2021-06-13",
   "gameId": "carrion-90055",
   "displayName": "Quality-of-life Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-06-13T09:53:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Apex Predators!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update is out! The patch focuses on quality-of-life improvements and some level design tweaks and fixes. We have some further enhancements in mind though, so stay tuned for future updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version: 1.0.5-RELEASE-589-g7236f57f",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "New Controller Setting: Smoothing - smoothes out the motion of the crosshairs/prehensile tentacle while aiming with an analog stick (Options -> Controls -> General Settings -> Smoothing)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhancement: you can now exit mechs by pressing the \"Use/Activate\" button - breaking parasitism is no longer required to leave the mech",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhancement: the status of the level is now displayed in the \"Squeeze In\" tooltip",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix: improper fire resistance HUD order",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Level Design",
     "items": [
      {
       "text": "Enhancement: Frontier/Military Junkyard - additional clues leading the player to the Hazardous Waste Landfill after obtaining the required skill*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhancement: Frontier/Leviathan Reef Base - additional clues leading the player to the Leviathan Reef Base - Bridge after obtaining the required skill*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhancement: Botanical Gardens - clearer order of the puzzles leading up to the chamber containing the Biomass Sample*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix: Leviathan Reef Base - out of place splashing sound",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Bunker - cocoons getting stuck in the pipes in the Caverns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: Bunker - a minor tunneling glitch in the Caverns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix: GTOY mech softlock no longer occurs now that the player can exit mechs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "*old saves might remain unaffected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
