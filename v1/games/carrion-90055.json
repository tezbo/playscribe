  {
   "id": "carrion-90055@post-2020-10-23",
   "gameId": "carrion-90055",
   "displayName": "Minor Workshop Updates",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2020-10-23T21:08:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some of you might have noticed that we have published several updates in a row over the last few days. They are mostly related to the Workshop, as we still occasionally stumble upon some minor issues and missing features that need to get fixed or implemented.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full changelog",
     "items": [
      {
       "text": "Added: new Lua wrappers to expose sound and music API;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added: missing property setters in some types exposed to Lua;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed: inconsequential asset paths in the mods;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: hot reload not working with user levels;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed: hard crashes happening in Lua wrappers not logging any meaningful error messages;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Upgraded: SDL 2.0.10 to 2.0.12.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's all for now. Happy modding!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
