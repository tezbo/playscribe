  {
   "id": "forspoken-134583@1.22",
   "gameId": "forspoken-134583",
   "displayName": "Update 1.22",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-29T08:32:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Graphic Updates",
     "items": [
      {
       "text": "・Implemented the needed updates required to have the game compatible to AMD's FidelityFX™ Super Resolution 3.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "*FidelityFX™ Super Resolution 3 combines temporal upscaling and frame generation to deliver significantly higher performance.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "*Frame generation is enabled separately from upscaling and is available when using AMD Radeon™ RX 5000 Series and higher, NVIDIA GeForce RTX™ 20 Series and higher, and Intel® Arc™ 7 Series and higher GPUs. (Upscaling is still available to use on GPUs lower that the products mentioned.)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Added a new NativeAA quality mode option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Native AA mode does not apply upscaling but applies high-quality anti-aliasing and sharpening.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Miscellaneous",
     "items": [
      {
       "text": "・Added Frame Generation entry to the Graphics section of the menu.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Technical Issues",
     "items": [
      {
       "text": "・Fixed an issue where the main game save data appears in the DLC's save data slot and the DLC save data appears in the main game's save data slot. (Steam version)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*This fix only applies to newly created save data.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Known Issues",
     "items": [
      {
       "text": "・Low frame rates can be experienced on some 240Hz and higher refresh rate monitors, when FSR3 Frame Generation is set to ON and VSync is set to ON.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "*To remediate this issue, make sure you are using the latest drivers from your video card manufacturer. You can also set VSync to OFF, or set your monitor refresh rate to less than 240Hz.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
