       "category": "balance"
      },
      {
       "text": "・Improved the glare filter quality.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "・Updated the menu to display the required memory usage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "・Updated the opening sequence to go through the Brightness Settings before starting the game for the first time.",
