  {
   "id": "forspoken-134583@1.12",
   "gameId": "forspoken-134583",
   "displayName": "Update 1.12",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-04T06:02:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Feature Updates",
     "items": [
      {
       "text": "・Adjusted the visual effects for Frey's Shot spell.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Changed the default Sprint button from \"L3\" to \"L3 or 〇\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "*Existing save files will not be affected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Frey can now run in certain locations, such as Pilgrim's Refuges, the Archives, and the Mausoleum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "*Running will remain disabled during certain event scenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Miscellaneous",
     "items": [
      {
       "text": "・The touchpad controls for DualSense™ Wireless Controller (PlayStation®5) can now be used when the controller is paired by Bluetooth.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "*Certain DualSense™ Wireless Controller features, such as the intergraded speaker or haptic feedbacks cannot be used by Bluetooth pairing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Updated the Intel XeSS version to 1.1.0 which can be used for Intel ARC and Iris Xe.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "*The driver must be updated to 31.0.101.4148 or a later version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Technical Issues",
     "items": [
      {
       "text": "・Various minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
