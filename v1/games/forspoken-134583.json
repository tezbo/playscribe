  {
   "id": "forspoken-134583@1.10",
   "gameId": "forspoken-134583",
   "displayName": "Update 1.10",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-10T06:02:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Technical Issues",
     "items": [
      {
       "text": "・Fixed an issue where the screen unintentionally flickers when AMD's Radeon RX570 or RX580 is used. (PC version)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Various minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Feature Updates",
     "items": [
      {
       "text": "・Adjusted the explanatory text and default camera position for the tutorial of the Magic Parkour skill Zip.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Added an option where the players can choose to automatically switch to the last-viewed section when accessing a menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Added an option where the players can choose to automatically point the camera to the targeted enemy when locking on an enemy during charging spells.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Added an option where the players can choose to automatically switch the lock-on target to a nearby enemy after defeating a locked-on enemy.",
