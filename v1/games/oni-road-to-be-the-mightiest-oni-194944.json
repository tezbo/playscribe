  {
   "id": "oni-road-to-be-the-mightiest-oni-194944@1.02",
   "gameId": "oni-road-to-be-the-mightiest-oni-194944",
   "displayName": "Update 1.02",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-03-24T10:00:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Please see below for information regarding changes/updates to be made in the latest patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed bug that sometimes caused Kuuta to fall through the ground.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed bug that sometimes caused the background music to loop endlessly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed bug where the camera angle locked if Kuron appeared just as the player is handing a spirit over to Jizo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed bug that prevented Zenisuke from being affected by the Time Stop special move during trials.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Other minor bugs fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・FPS Limit setting added that allows the frame rate limit to be set at 30FPS, 60FPS, 120FPS, or Unlimited.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Other minor bugs fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Gameplay Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Reduced Kuron’s spawn rate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased Kuuta’s mushroom-picking speed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted sorcerer spawn time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Balance adjustment of puppet demon/spinning enemy attacks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted timing of when character names appear onscreen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added icon indicator for phantoms located far away",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted difficulty level of “Protect Zenisuke!” trials",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted Kazemaru’s onscreen dialogue display to more easily locate spirits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Opening video and event scenes can now be skipped from the very first time the game is played.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "【Upcoming Features】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjustments for visibility, such as camera distance in trials viewed from above",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Add option to view in full screen mode when launching the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(*Until version 1.02, full screen display could be toggled by pressing alt + Enter)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Add option to change screen display size to Options menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
