  {
   "id": "oni-road-to-be-the-mightiest-oni-194944@1.06",
   "gameId": "oni-road-to-be-the-mightiest-oni-194944",
   "displayName": "Update 1.06",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-04-24T07:30:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Please see below for information regarding changes/updates to be made in the latest patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Minor bugs fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Gameplay Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Camera distance and view settings in top-down view trials improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera distance adjusted: Trials 4 & 35 (Wave 3)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "after",
     "items": [
      {
       "text": "Settings changed to normal view: Trials 9, 10, 27 & 35 (Wave 4)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "after",
     "items": [
      {
       "text": "・Icon added to mark location of stone monuments from a distance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "after",
     "items": [
      {
       "text": "・The following adjustments have been made to enhance gameplay while hunting for spirits, as well as when Kuron appears:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When a spirit is nearby, Kazemaru’s dialogue bubble will appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "after",
     "items": [
      {
       "text": "Sequence when delivering a spirit to a Jizo shortened (*Jizo’s dialogue skipped after the 2nd delivery).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kuron’s spawn rate adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Icon added to show location of Jizo while holding a spirit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "after",
     "items": [
      {
       "text": "Icon added to show location of Keystone when Kuron appears.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "after",
     "items": [
      {
       "text": "・Amount of time required to activate a special move reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Amount of time for an acquired Mushroom to restore health reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Price of Kibidango reduced from 10 to 5 Mushrooms, while price of Onigiri reduced from 20 to 10 Mushrooms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Font size of text on the field and on the Diary menu screen adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "after",
     "items": [
      {
       "text": "●Adjustments/Functions Added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Switch Window function added to the OPTIONS menu, allowing players to select from Window/Full Screen/Borderless modes (*Default setting is Full Screen).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Screen Resolution selection added to the OPTIONS menu, allowing players to select from 1280 x 720 / 1920 x 1080 / 2560 x 1440 / 3840 x 2160 screen resolutions (*Default setting is 1920 x 1080).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "・In Low Resolution Mode (via OPTIONS)",
     "items": [
      {
       "text": "※Players can choose either better image quality or frame rate. (*Default setting is Prioritize Frame Rate.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prioritize Image Quality: Graphics processing load will be higher, but the game’s environments will display in richer detail.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Prioritize Frame Rate: This setting reduces the graphics processing load on your PC, so please try this setting if you are experiencing unstable gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
