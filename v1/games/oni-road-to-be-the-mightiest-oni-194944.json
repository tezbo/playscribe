  {
   "id": "oni-road-to-be-the-mightiest-oni-194944@1.01",
   "gameId": "oni-road-to-be-the-mightiest-oni-194944",
   "displayName": "Update 1.01",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-03-14T11:34:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Please see below for information regarding changes/updates to be made in the latest patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed bug where the game would hang when progressing to Mission 2 if the in-game language is set to English, French, German, or Spanish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed bug that potentially hindered progress when talking to a phantom just before the background music changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed bug that caused the game to hang if a spirit is captured before the previous one is delivered to a Jizo statue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・VSync (vertical synchronization) setting added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・FPS Limit setting added that allows the frame rate limit to be set at 30FPS, 60FPS, 120FPS, or Unlimited.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Other minor bugs fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "【Upcoming Features】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Keyboard/mouse operation guide",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Fix for bug that sometimes causes Kuuta to fall through the ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
