   "announcedAt": "2025-12-11T18:00:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you've been having fun with Hank slashing and dashing around Kakamucho.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since the launch of Samurai Academy: Paws of Fury last month, we noticed that the Shogun's invading cat army wasn't the only problem that needed to be squashed. Today, we've released a small patch to clean up a couple issues that were impacting players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This patch includes the following fixes",
     "items": [
      {
       "text": "Some houses in the first raid on Pippishore Village had missing collision that let players pull off unintended ninja shortcuts. These structures now stand firm.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A quest objective was refusing to update after completing a raid. It now behaves as expected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
