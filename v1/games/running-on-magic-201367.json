    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Little patch with several keyboard and leaderboard fixes. We have also added Turkish to the list of supported languages thanks to a kind member of the community.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A few more Endless Mode issues have been reported and we are working to fix them in the next patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's a change log with the details of the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "----------------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "[1.0.1] - 2022-08-11",
     "items": [
      {
       "text": "### Added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Turkish translation from Enes Yarıkan.: ### Fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed toggles not working on keyboard, which in turn fixes Fullscreen, Controller Vibration and Tutorial Skipping issues for keyboard players.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed audio settings not being applied from the main Settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reworked Leaderboards controls on keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Leaderboards menu displaying the wrong page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Leaderboards menu crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaked Chinese, Japanese and Korean fonts sizes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Typo in Japanese translation regarding Leaderboards.: ### Known issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sudden game freezes when playing Endless Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stage popping too late on rare occasions when playing Endless Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Newly spawned enemies with stunned VFXs on them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clipping through walls at high speeds on Endless Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Getting locked and sliding down through walls at high speeds on Endless Mode.: Thanks for playing Running on Magic! See you soon!",
