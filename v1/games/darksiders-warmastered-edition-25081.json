  {
   "id": "darksiders-warmastered-edition-25081@4",
   "gameId": "darksiders-warmastered-edition-25081",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2016-12-21T15:08:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch #4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changelog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "19th December 2016",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crash on start fix : Game displays a Message box in cases where the steam client fails to provide a save data Api. You need to update steam or reinstall steam to resolve this - or play without saving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Abyssal armor was not carried over into a new game if the new game was not started in the same session. Please note : If you *have* a save with abyssal armor already then load that game, save again and restart the application.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Screen saver should no longer kick in when playing with some game pads.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reticle was small (sometimes close to invisible) in any texture Quality other than highest. This has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "EXP between Harvester and Scythe was not correctly transferred, fixed now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PS4 controller could not be reconnected after disconnect, fixed now.: Stay tuned.: Your THQ Nordic Team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
