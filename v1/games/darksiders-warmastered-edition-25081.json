   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2016-12-05T09:52:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We know that we need to iron out a few issues asap and are working hard to deliver the best possible Darksiders experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch #1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changelog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2nd December 2016",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for AMD performance problems",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for users with Non-ANSII character based usernames that had problems to get config saved / loaded",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for users without pre-existing keyboard config could not load / save keyboard config: Note : If you had working keyboard config load / save, then please copy your keyboard configuration to the new place.: The old file was %localappdata%\\Darksiders\\controls.dcon: New location and filename is %appdata%\\kaiko\\darksiders1\\keymapping.bin: Please just copy the file and rename it.: We are looking forward for your feedback in this thread: http://steamcommunity.com/app/462780/discussions/0/154642447922267001/",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
