  {
   "id": "darksiders-warmastered-edition-25081@3",
   "gameId": "darksiders-warmastered-edition-25081",
   "displayName": "Patch 3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2016-12-13T13:33:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We know that we need to iron out a few issues asap and are working hard to deliver the best possible Darksiders experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch #3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changelog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "12th December 2016",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Video player received some cleanup, including a few leaks fixed here and there. Please report if this fixes anything",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crash when running on a system without Audio output",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It could happen that one could not assign gear, this should be fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mouse cursor is now automatically hidden after 5 sec when playing with game pad",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Game pad dead zone can now be adjusted (start game, let it save settings, then edit the settings file - gamepad_deadzone under - value is 0 to 1, default 0.35. There is a minimal deadzone built in that you can not remove)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some remaining resource leaks were fixed that could lead to crashes when on low memory or switching between modes / resizing the window often",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
