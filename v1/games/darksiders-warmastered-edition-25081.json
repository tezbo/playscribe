  {
   "id": "darksiders-warmastered-edition-25081@5",
   "gameId": "darksiders-warmastered-edition-25081",
   "displayName": "PATCH 5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2017-01-06T19:09:42.000Z",
   "notes": [
    {
     "title": "Changelog",
     "items": [
      {
       "text": "6th January 2017",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Videoplayer rewrite: Takes less CPU (up to three times), more stable synchronization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for freeze when skipping videos right away",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed application crash on startup due to virtual memory problems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Better DualShock 4 controller detectopm (newer models are working now)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Xbox One controller users see Xbox One button prompts (doesn't work in some setups with multiple controllers connected)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Added better diagnostic code to get rid of the remaining crash problems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Comic & Soundtrack: Happy new year!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
