  {
   "id": "darksiders-warmastered-edition-25081@6",
   "gameId": "darksiders-warmastered-edition-25081",
   "displayName": "Patch 6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2017-03-08T18:01:42.000Z",
   "notes": [
    {
     "title": "Changelog",
     "items": [
      {
       "text": "8th March 2017",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Simplified Chinese localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Native Steam controller support",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "D3D errors don't crash the game but show a message box with the proper error code",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Please note",
     "items": [
      {
       "text": "When you use Steam Controller, only button prompts for the actual Steam Controller will be shown, never prompts for Dual Shock 4 or other controllers supported by Steam Big Picture. You might end up not seeing button prompts at all if using Dual Shock 4 or other controller via Steam Big Picture.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
