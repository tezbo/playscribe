  {
   "id": "darksiders-warmastered-edition-25081@major-2026-05-20",
   "gameId": "darksiders-warmastered-edition-25081",
   "displayName": "War Rides Again: New Darksiders Warmastered Update Released",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-05-20T11:11:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "With the release of Warmastered on PS5 and Xbox Series we now also updated the PC version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "Requires 64bit CPU",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rendering powered by Vulkan. Vulkan graphics API requiring Vulkan 1.3",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Photo mode (access this by entering the pause menu while in-game, then take your screenshot via Steam's screenshot function or Windows' screenshot function)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved Steam Input support",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Support for motion-aiming (requires enabling Steam Input and using a controller with motion support)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed reticule on low texture resolution settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various fixes to controller glyphs of different controllers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If this version has issues please report a bug via our bugreporting form:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please make sure to include the following information in your bug reports:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Summary of the issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Detailed description including what were the last few steps you took before the issue occurred",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version number (can be found in the top left corner of the main menu)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "screenshot/video, if possible (note the max. file size of 50 MB)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "save file (this can be found under C:\\Program Files (x86)\\Steam\\userdata[your user ID]\\462780\\remote\\autocloud\\save)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "your dxdiag (press Windows key + R key and enter \"dxdiag\", let it compile, then click \"Save all information\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "your crash dump logs (the game will ask you if you wish to upload diagnostic data when it crashes--do so, then right-click game in Steam > Properties > Browse and attach the crashdump.log file that is next to your game's .exe file to the bug report)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In case you want to switch back to the old version, there is a public beta branch called warmastered2016 with the last state from 2016. You can access this by closing the game, then right-clicking the game in Steam > Properties > Game Versions & Betas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
