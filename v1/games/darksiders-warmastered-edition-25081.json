  {
   "id": "darksiders-warmastered-edition-25081@2026",
   "gameId": "darksiders-warmastered-edition-25081",
   "displayName": "Patch 2026",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-26T11:51:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In-game version number: v1.1 cs:4334",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed a cause of VK_ERROR_DEVICE_LOST that was appearing often, especially on Linux",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "fixed a problem where Camera Control was too fast or slow when using mouse or Steam Controller at high or rather low fps",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "made it so a Dialog is shown when very fundamental graphics API initialization failed and the game can not be run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "revised BFA Achievement code to more reliably trigger",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed graphics issue where the mini map was visible inside of other UI elements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed Video playback problem when running below 60 fps (e.g. fixed framerate throttle)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a potential corruption of graphics objects, like discoloroization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "various stability issues removed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "removed some log file spilling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "removed some causes of hangs or crashes when closing the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In case you wanna switch back to the old version there is a public beta branch called warmastered2016 with the last state from 2016.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
