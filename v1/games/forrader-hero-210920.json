  {
   "id": "forrader-hero-210920@2",
   "gameId": "forrader-hero-210920",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-24T17:00:32.000Z",
   "notes": [
    {
     "title": "New Content update",
     "items": [
      {
       "text": "new hero: Ranger",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new mode: Casual Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ranger is a master of a ranged fight. He relies on his bow and arrows to destroy enemies. This hero does not use attack points, instead, he uses arrows to perform special attacks on demand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Casual Mode. In this mode player progress for the current run is saved while the hero advances through the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "updated skills icons for all heroes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "“game insides” improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added new achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks for playing! Stay tuned and stay safe ːsteamthumbsupː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
