      {
       "text": "• added Japanese and Catalan localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Wizard",
     "items": [
      {
       "text": "• reduced ‘Fire spin’ skill cost = 6->5 mana pts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• reduced ‘Fire spin+’ skill cost = 8->7 mana pts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• reduced ‘All-Consuming Fire’(+) skills cost 5->4 mana pts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• ‘Fire Charge’ skill now deals = 6->7 dmg pts. and ‘Fire Charge+’ skill = 10->12 dmg pts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• increased start ‘Mana’ value = 21->23 mana pts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Rogue",
     "items": [
      {
       "text": "• ‘Backstab’ damage scaling (from attack points) is decreased = 25%->22% and for upgraded(+) skill = 33%->28%",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• ‘Keen Defense’ (+) cooldown increased = 6->7 turns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Necromancer",
     "items": [
      {
       "text": "• Hero passive: Reduced skull pts. received on enemy kill = 2->1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Japanese language support provided by Hiroshi Ashida",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Catalan language support provided by Projecte 'Ce Trencada'(cetrencada.cat)",
