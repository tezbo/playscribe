  {
   "id": "forrader-hero-210920@1",
   "gameId": "forrader-hero-210920",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-06T17:02:16.000Z",
   "notes": [
    {
     "title": "New Content Update #1",
     "items": [
      {
       "text": "new heroes: Alchemist and Necromancer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new level: Crypt of Idolaters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Necromancer can summon and subdue undead to fight against his enemies, the willingness to kill the enemies feeds him",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Alchemist can transmute things: himself, his enemies, and equipment items, but requires flasks with magical fluid to do so",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Crypt of Idolaters – a terrifying place where idolaters and cultists perform forbidden rituals. Every hero who steps there will likely receive damage to armor with every movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "small game improvements & fixed bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added brand new Steam achievements",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thanks for playing! Stay tuned and stay safe ːsteamthumbsupː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
