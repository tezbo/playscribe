  {
   "id": "forrader-hero-210920@3",
   "gameId": "forrader-hero-210920",
   "displayName": "Update 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-22T14:20:11.000Z",
   "notes": [
    {
     "title": "New Content Update #3. This update is a part of the current roadmap of updates during the Early access state.",
     "items": [
      {
       "text": "Disclaimer: This is probably the last update before leaving the early access state. Stay tuned for the news of the full release! I am hoping for a mid-January release.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Content update",
     "items": [
      {
       "text": "new mode: ‘Final Judgement’ Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "‘Final Judgement’ Mode is a special mode that will put to the test your knowledge of heroes’ strengths and enemies’ vulnerabilities.: This mode will judge your gameplay knowledge: the more you play, the more advantage you will have to complete this mode. Knowledge is power, use it well!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "improvements & bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks, everyone for your attention! Stay tuned and stay safe!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
