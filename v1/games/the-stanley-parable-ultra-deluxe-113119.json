  {
   "id": "the-stanley-parable-ultra-deluxe-113119@major-2022-07-19",
   "gameId": "the-stanley-parable-ultra-deluxe-113119",
   "displayName": "Quality of Life Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-07-19T14:51:37.000Z",
   "notes": [
    {
     "title": "New Accessibility Options",
     "items": [
      {
       "text": "On screen reticule",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Auto-walk option simplified to one key/button and keybindable",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Reduced Motion Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Low Dexterity Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Added a method to access endings that were previously only accessible once per save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Additional/Alternate Use button keybinding",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Keybindings can now bind to mouse buttons",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Remapped camera sensitivity slider to cover a higher range of sensitivities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Cosmetic updates",
     "items": [
      {
       "text": "Fixed some z-fighting issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed lighting on some smaller props and decals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed formatting issues in Italian text in the confusion ending",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added additional translators and artists in credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated post effects for some hard-to-see areas to be brighter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added toggle for permanent reticule / crosshair and customization options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Critical Fixes",
     "items": [
      {
       "text": "Softlock at start of game (language selection screen) when a controller with drift is plugged in, is now fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Softlocks occurring when pausing and unpausing fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Other Fixes",
     "items": [
      {
       "text": "Potential fix for PS5 controller on PC being detected as an Xbox controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5",
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "Keybindings no longer reset each playthrough and now load previously set keybindings",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Certain endings now have proper simplified control support whereas previously they did not",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed certain texts in game to render Cyrillic characters correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Content warnings not recording the ending as successfully completed now does so",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Certain UI elements no longer renders over the settings page",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reinstated missing UI sounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "More stable world portals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various clipping issues fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "This patch is out now for PC and will be coming ASAP to Linux and Mac. Thanks for your patience!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Coming up next is an even larger patch which will add translations for: Polish, Brazilian Portuguese, Japanese, Korean, Simplified Chinese and Ukrainian. There will also be a few extra surprises and secrets that we’ll leave for you to discover! We'll announce on our Twitter and Discord when we have a solid date for this update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
