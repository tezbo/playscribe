  },
  {
   "id": "the-stanley-parable-ultra-deluxe-113119@1.05",
   "gameId": "the-stanley-parable-ultra-deluxe-113119",
   "displayName": "Update 1.05",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-05-03T21:17:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've just launched Version 1.05 of The Stanley Parable: Ultra Deluxe, the version will be available first on Windows, with 1.06 coming later this week which will include further fixes. That will be then pushed to consoles and Mac/Linux as soon as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues relating to resolution and unusual monitor aspect ratios.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed two potential causes for the softlock just after the leaderboard section in the “Playtest Ending”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game now keeps running in the background.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a recurring softlock and various issues in “the ending where you remember things you found”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a video issue that was happening on certain computers preventing players from accessing the “Incorrect Ending”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue relating to “Apartment Ending” prompts not displaying on wide screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Disabled the developer email report tool.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed custom key bindings getting lost on application restart .",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Stanley’s eyes closing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added an apology sign for an area where there are still outstanding bugs that we’ve not fixed yet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Stanley perpetually floating when restarting in the “Dream Ending”.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some text layouts and typos.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "It’s possible that you may still experience issues in some of these endings. If the version number in Pause Screen shows as 1.05 and you’re still experiencing one of these bugs, please report this via our bug reporter with the category “Returning Bug”. Thank you and we hope you enjoy The Stanley Parable: Ultra Deluxe Version 1.05!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Stanley Parable: Ultra Deluxe Bug Report Form",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep an eye out for further updates on bug fixes / additional language support / physical edition announcements both here and on our Community Discord..",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crows Crows Crows",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
