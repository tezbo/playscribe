  {
   "id": "a-game-about-digging-a-hole-325554@major-2025-12-17",
   "gameId": "a-game-about-digging-a-hole-325554",
   "displayName": "Small QoL Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-17T09:31:31.000Z",
   "notes": [
    {
     "title": "Features and Improvements",
     "items": [
      {
       "text": "Settings: Introduce \"Look Sensitivity\" setting for both gamepad and mouse controls",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Deadzone: Tweaked and improved deadzone handling during moving and looking around input to counteract potential gamepad stick drift",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General improvements: Improved some UIs to better scale on different resolutions, hardened switching between gamepad and mouse controls",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Mine shaft chests: Fixed a bug where mineshaft chests occasionally didn't spawn when starting a new game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Rainbow ore: Fixed a bug where rainbow ores were lost after loading a save game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Autosave: Hardened auto-save handling during game shutdown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Others",
     "items": [
      {
       "text": "Credits: Adapted credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
