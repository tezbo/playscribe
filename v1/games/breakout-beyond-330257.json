  {
   "id": "breakout-beyond-330257@post-2025-06-18",
   "gameId": "breakout-beyond-330257",
   "displayName": "Breakout Beyond Patch Notes For June 18, 2025",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-18T13:51:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In addition to minor bug fixes as well as adding an option to change which input axis is read for mouse/joystick, today’s update introduces the ability to select your display orientation for some vertical brick breaking!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "To change your display orientation, navigate to OPTIONS, go to Layout, then change Screen to Vertical. Rotate your display and enjoy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You may see people calling this TATE mode! TATE (pronounced tah-tay) is a Japanese term referring to arcade games with vertically oriented screens, usually seen in vertical scrolling shoot-em-ups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
