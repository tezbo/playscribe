   "id": "grindstone-124031@major-2025-05-22",
   "gameId": "grindstone-124031",
   "displayName": "Cosmic Grind Update — A new Daily Grind mode!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-22T14:00:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new daily grind mode has burst into Jjertrude’s shrine - the Cosmic Grind! She needs your help to clear this cosmic infection! There are multiple levels with these Ooze-filled Creeps, so make sure to gear up as you survive!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Be ready to encounter…",
     "items": [
      {
       "text": "📈 Multiple levels of Ooze-filled Creeps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚔️ Gear at your disposal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🥇 Another leaderboard to conquer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Stop the cosmic infection in this free update for Grindstone NOW 💎",
