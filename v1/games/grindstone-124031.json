    },
    {
     "title": "Thanks, Stonegrinders of Steam!",
     "items": [
      {
       "text": "Thanks for helping make our recent Steam launch a success, stonegrinders! We're thrilled to bring you this free update, alongside all the other great content packed into the game. Enjoy your puzzle-battles, tell a friend, and we'll see you on the Mountain!",
       "ps5ProOnly": false,
       "pcOnly": false,
