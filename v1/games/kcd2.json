   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Welcome to Version 1.5.6, there's a handful of things waiting for you. Let's take a look!",
       "ps5ProOnly": false
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44983656/6648ff7cabac648b49e448ec63d87eae0ce03916.jpg\"]",
       "ps5ProOnly": false
      }
     ]
    },
    {
     "title": "Jester’s visit",
     "items": [
      {
       "text": "A peculiar Jester has started to appear in front of the Hangman's Halter Tavern shouting about a strange new game. A new quest awaits.",
       "ps5ProOnly": false
      },
      {
       "text": "[/*]",
       "ps5ProOnly": false
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44983656/fee6a8348625d3c7615ac77a004d4c41768e809f.jpg\"]",
       "ps5ProOnly": false
      }
     ]
    },
    {
     "title": "So it begins…",
     "items": [
      {
       "text": "Fixed an issue with Mikesh or Kozliek required to be recruited even though they were dead, if the player has visited the Mysteria Ecclesiae monastery after killing them.",
       "ps5ProOnly": false
      },
      {
       "text": "[/*]",
       "ps5ProOnly": false
      }
     ]
    },
    {
     "title": "Controls",
     "items": [
      {
       "text": "Implemented support for the Steam Controller.",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[/*]",
       "ps5ProOnly": false
      },
      {
       "text": "Fixed the game sometimes being stuck on the XBox control scheme even when playing on a handheld device with a connected mouse and keyboard.",
       "ps5ProOnly": false,
       "platforms": [
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "[/*]",
       "ps5ProOnly": false
      }
     ]
    },
    {
     "title": "Hardcore mode",
     "items": [
      {
       "text": "Fixed a UX glitch when confirming the disadvantage selection screen without the required number of perks being selected.",
       "ps5ProOnly": false
      },
      {
       "text": "[/*]",
       "ps5ProOnly": false
      },
      {
       "text": "Credits",
       "ps5ProOnly": false
      },
      {
       "text": "Updated credits.",
       "ps5ProOnly": false
      },
      {
       "text": "[/*]",
       "ps5ProOnly": false
      }
