  {
   "id": "kcd2@1.5.3",
   "gameId": "kcd2",
   "displayName": "Patch 1.5.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-05T10:20:41.000Z",
   "notes": [
    {
     "title": "We have released a technical update for Kingdom Come: Deliverance II. Patch 1.5.3 focuses on expanding hardware compatibility to ensure a smoother experience for players on the latest generation of portables and ultrabooks.",
     "items": [
      {
       "text": "This update introduces native support for Windows on ARM, specifically optimized for devices powered by the Qualcomm Snapdragon X Elite platform. By moving away from emulation, players on ARM-based Windows machines will see immediate technical benefits, including:",
       "ps5ProOnly": false
      },
      {
       "text": "Improved Performance: Better frame rate stability and resource allocation.",
       "ps5ProOnly": false
      },
      {
       "text": "Power Efficiency: Optimized battery usage for longer sessions on mobile devices.",
       "ps5ProOnly": false
      },
      {
       "text": "Thermal Management: Lower heat generation compared to running via translation layers.",
       "ps5ProOnly": false
      },
      {
       "text": "Please note that this is a purely technical architecture update. Patch 1.5.3 contains no gameplay changes, balance adjustments, or additional content.",
       "ps5ProOnly": false
      },
      {
       "text": "Thank you for your continued support.",
       "ps5ProOnly": false
      }
     ]
    },
    {
     "title": "Play Kingdom Come: Deliverance II NOW.",
     "items": [
      {
       "text": "https://store.steampowered.com/app/1771300/Kingdom_Come_Deliverance_II/",
       "ps5ProOnly": false
      }
     ]
    },
    {
