  {
   "id": "kcd2@1.9.7",
   "gameId": "kcd2",
   "displayName": "Patch 1.9.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-02-13T16:00:40.000Z",
   "notes": [
    {
     "title": "Update Highlights",
     "items": [
      {
       "text": "Deep Silver Account Integration: Link your account to receive a unique Horse Caparison. The item will be added to the player stash once the prologue has been completed.",
       "ps5ProOnly": false
      },
      {
       "text": "Critical Stability Fixes: Resolved the rare \"Siege\" quest infinite loading screen and addressed various crashes during \"Baptism of Fire\" and time-skipping.",
       "ps5ProOnly": false
      },
      {
       "text": "UI & Localisation Polish: Improvements to font rendering for Japanese and other languages, alongside fixes for overlapping text and missing icons.",
       "ps5ProOnly": false
      },
      {
       "text": "These improvements ensure a more stable experience in 15th-century Bohemia for both new players and returning veterans. The full changelog can be found on the Kingdom Come: Deliverance community hub.",
       "ps5ProOnly": false
      }
     ]
    },
    {
     "title": "Update the first Kingdom Come: Deliverance NOW.",
     "items": [
      {
       "text": "https://store.steampowered.com/app/379430/Kingdom_Come_Deliverance/",
       "ps5ProOnly": false
      }
     ]
    },
    {
