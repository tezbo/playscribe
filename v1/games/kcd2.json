  {
   "id": "kcd2@1.2.2",
   "gameId": "kcd2",
   "displayName": "Hotfix 1.2.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-03-20T16:00:56.000Z",
   "notes": [
    {
     "title": "Hotfix 1.2.2 is here!",
     "items": [
      {
       "text": "This update brings several key fixes to improve your experience in Kingdom Come: Deliverance II. Say farewell to uninvited trespassing warnings in your rented rooms, worry less about accidentally overwriting your playlines, and enjoy a more stable experience overall.",
       "ps5ProOnly": false
      }
     ]
    },
    {
     "title": "Fixes and Improvements 🔧",
     "items": [
      {
       "text": "Room Renting: No more trespassing flags in rented rooms after leaving and returning.",
       "ps5ProOnly": false
      },
      {
       "text": "UI: Removed New Game from the in-game pause menu to prevent accidental save overwrites.",
       "ps5ProOnly": false
      },
      {
       "text": "Into the Underworld Quest: Fixed Goatskin disappearing when loading saves from version 1.1.X after updating.",
       "ps5ProOnly": false
      },
      {
       "text": "Other Fixes: Resolved a bug where closing the barber overlay with a mouse would break the main menu.",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you for your patience and support—more updates are on the way!",
       "ps5ProOnly": false
      },
      {
       "text": "Read the full patch notes here.",
       "ps5ProOnly": false
      },
      {
       "text": "Get Kingdom Come: Deliverance II NOW.",
       "ps5ProOnly": false
      },
      {
       "text": "https://store.steampowered.com/app/1771300/Kingdom_Come_Deliverance_II/",
       "ps5ProOnly": false
      }
     ]
