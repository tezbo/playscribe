  {
   "id": "a-perfect-day-97271@1.3.2",
   "gameId": "a-perfect-day-97271",
   "displayName": "Update 1.3.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-03-25T06:54:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, gamers from Planet W!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As spring arrives, we have received some bug reports from the people of Planet W. We've fixed these bugs to perfect your experience. Here's a list of the fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed an issue where players could bypass constellation collection even when their main wish had been updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a display error in a tutorial text in the traditional Chinese version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you encounter any other issues or would like to talk to us, feel free to drop us an e-mail at contact@perfectdaystudio.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "W people's souls are all determined by W people's minds!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A Perfect Day Twitter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A Perfect Day Discord",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
