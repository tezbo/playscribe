  {
   "id": "el-paso-elsewhere-151788@5",
   "gameId": "el-paso-elsewhere-151788",
   "displayName": "Patch 5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-03T16:52:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello hello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're pushing another patch with more fixes and tweaks for the game. Not a lot of them here but we wanted to push this out ASAP before we started working on more fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "V5 CHANGELOG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where Draculae could turn invincible if the game got reset during her Avoidance period.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the camera could freeze in place during boss fights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where James could get stuck in his staking pose after resetting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the timing of some events in Ourobouros.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where Draculae's health bar would not display during her fight & her AI would not work as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We've got more patches coming up so feel free to post any issues or bugs you've had with the game in our Bug Reports section over at Steam's Discussion Board.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And hey- thank you for playing El Paso, Elsewhere!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
