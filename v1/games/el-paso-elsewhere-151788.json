  {
   "id": "el-paso-elsewhere-151788@16",
   "gameId": "el-paso-elsewhere-151788",
   "displayName": "Patch 16",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-03-11T20:36:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Oh hi again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're pushing a new patch for El Paso, Elsewhere. Here's today's patch changelog!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For this patch, our goal was to give you even more modifiers so that you can better tailor the game to your playstyle. Here's what we got this time!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "V16 CHANGELOG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a potential progression blocker in Game_25CastleEgypt",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where certain weapons could vanish from the level after the player's death and respawn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where ragdolls could cause performance stuttering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Modifier Preset names were being incorrectly displayed in certain situations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(Hopefully) improved controller support for non-XInput gamepads",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new modifiers:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Scarce Ammo (you'll find less ammo pickups in levels)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Max Ammo Multiplier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stake Damage Multiplier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slow-mo Consumption Rate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Painkiller Initial Heal Multiplier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Painkiller Healing Animation Rate",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Max Painkiller Count",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Max Stakes Count",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy Speed Multiplier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy Health Multiplier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And last but not least, thank you so much for playing our game! If you encounter any issues, feel free to report them on the Steam Discussion boards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
