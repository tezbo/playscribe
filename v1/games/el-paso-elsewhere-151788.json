  {
   "id": "el-paso-elsewhere-151788@8",
   "gameId": "el-paso-elsewhere-151788",
   "displayName": "Patch 8",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-24T21:07:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "MWAHAHAHello!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Welcome to the brand new El Paso, Elsewhere update changelog!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "V8 CHANGELOG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new joystick acceleration slider in the settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added gamepad rumble to some actions in the game. Brr brr!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Saving or killing a hostage will now produce an audio cue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Active modifiers are now displayed in the save selection screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Returning to the main menu no longer resets the Modifiers panel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restored the resolution & framerate pickers to the settings screen on the Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Steam Deck's default system settings have been changed. This will not replace current system settings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Steam Deck will now use a new default input template featuring a weapon selection wheel on the right pad.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Adjusted the timing of the Vampire's melee attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where hostages could still be killed moments after being rescued.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(Hopefully) fixed a tricky issue related to the FLASHBACK achievement (special thanks to Raloire, Nedly Dedly, Pig, ??? and SparksV from the Steam Discussion Boards!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you spot any bugs or glitches, please open a thread on the Steam discussion boards and send us some details so that we can look into it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you're having fun playing our game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
