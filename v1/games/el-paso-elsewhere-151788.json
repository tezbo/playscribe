  {
   "id": "el-paso-elsewhere-151788@2",
   "gameId": "el-paso-elsewhere-151788",
   "displayName": "Patch 2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-26T21:33:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello hello and welcome to El Paso, Elsewhere!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First of all, we'd like to thank you all for believing in our vision. We hope you're having as much fun playing the game as we had making it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're pushing a small update to the game to correct some issues that were reported by players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "V2 CHANGELOG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue causing the remapper to not function as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed two possible softlock locations in Game_3Motel_Shotgun",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an area where the player could get stuck in the tutorial level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We'll keep an eye out in the Steam discussion board for any new bug reports so feel free to make a thread in there should you spot any other strange phenomenom (other than, y'know, vampires and wolfmen and rituals and stuff).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
