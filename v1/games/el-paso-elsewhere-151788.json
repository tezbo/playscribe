  {
   "id": "el-paso-elsewhere-151788@9",
   "gameId": "el-paso-elsewhere-151788",
   "displayName": "Hotfix 9",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-11-07T21:50:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've submitted a hotfix for El Paso, Elsewhere! There are still some more fixes & changes coming up in the next few weeks but we're pushing this update earlier in order to correct a critical issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "V9 CHANGELOG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Modifier menu has been moved- it is no longer displayed in the Main Menu. It will now show up once a save slot has been selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Modifier Presets and three difficulty-based presets: Story, Intended and Challenging. These can be selected when loading a save slot or starting a new game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a Speed Modifier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where starting a new game from an empty save slot could cause the game to hang.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Feel free to report any issues to our Steam Discussion Board's Bug Reports section.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And once again, thank you for playing El Paso, Elsewhere!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
