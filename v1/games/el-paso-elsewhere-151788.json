  {
   "id": "el-paso-elsewhere-151788@6",
   "gameId": "el-paso-elsewhere-151788",
   "displayName": "Patch 6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-10T00:26:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's another patch for El Paso, Elsewhere. Let's jump right into it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "V6 CHANGELOG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed occlusion culling & floating interactables in Marathon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "NPC and elevator tweaks to Castles In The Air.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where certain enemies could cause Boss Health Gauges to show up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The \"Ammo Full\" tickers now also display the ammo type.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where picking up a second grenade launcher would load two rounds in the grenade launcher. No one should have that much power.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dying should now stop all voicelines and captions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Angels should no longer get stuck in Castles In The Air.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed problematic bride teleport points in Marathon, Sensorium and Mountaintop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed an old placeholder sound from Sunset.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaked some enemies in Confessional.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some effects in Central Location and Monster Club.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some colliders in Confessional.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that would cause level resetting to malfunction, possibly causing the game to halt on the death screen and/or cause certain entities to become invincible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The game's saves are now handled by Steam's Cloud Save feature! (only save files are uploaded to Steam Cloud- game settings are not! This is intentional.)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "As always, feel free to post any issues in our Bug Reporting section inside Steam's Discussion Boards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And once again, thank you for playing El Paso, Elsewhere!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
