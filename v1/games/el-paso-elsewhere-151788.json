  {
   "id": "el-paso-elsewhere-151788@7",
   "gameId": "el-paso-elsewhere-151788",
   "displayName": "Patch 7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-10-16T21:17:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We meet again!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're pushing a new patch for El Paso, Elsewhere. Here are the changes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "V7 CHANGELOG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with the Burned Man in Game_XManorEgypt.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added missing BGM to the Djedefre cutscene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a \"Use High Quality Audio\" option to the settings menu (On by default).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Checkpoints will no longer save if the player has just died, thus preventing infinite death loops.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with the FLASHBACK achievement- it should be working again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where some of the Main Menu's elements would look wrong in some resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can now roll or dive instantly after landing a stake hit on an enemy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can no longer carry infinite molotovs. Sorry! The limit's back to 8.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pausing the game with a gamepad now automatically selects the Resume button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where restarting the level right after a reset could break the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We've also submitted a Steam Deck Verified build candidate to Steam. If you've got a Steam Deck, keep an eye out for that!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
