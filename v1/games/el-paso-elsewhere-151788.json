  {
   "id": "el-paso-elsewhere-151788@14",
   "gameId": "el-paso-elsewhere-151788",
   "displayName": "Patch 14",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-01-10T20:03:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Heeeeello there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's a brand new patch for El Paso, Elsewhere and, with it, a brand new patch changelog!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our core goal with this patch was to fix two major problems: a performance issue on the game's first boss fight and an overall issue with achievements. Let's get to it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "V14 CHANGELOG",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed scripting issues in many components. This should improve overall CPU performance in some event-heavy levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in the first boss fight that could cause heavy performance degradation in this level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed another issue in the first boss fight that could cause the NPC to freeze in place.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved how achievement stats from Steam are gathered to (hopefully) fix achievements once and for all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a typo in the Main Menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved UI scaling for 21:9 and 16:10 aspect ratios.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added a 240hz option to the game's framerate selection in the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thank you for your patience and feel free to report any issues you encounter to us through the Steam Discussion boards. The more details in your reports, the faster we'll be able to get things fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We (the team at Strange Scaffold, including all of our pets) wish you all a fantastic 2024!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
