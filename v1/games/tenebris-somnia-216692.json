   "kindBasis": "studio",
   "announcedAt": "2026-10-18T03:58:22.000Z",
   "notes": [
    {
     "title": "Version 1.0.1 Changelog",
     "items": [
      {
       "text": "Thank you to everyone who provided feedback and bug reports! Keep them coming! If you encounter any problems please let us know on the Steam forums.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achievement unlocks will retry to prevent issues if two achievements are unlocked at once",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bloody slimes during the finale encounter take longer to spawn and move about the arena",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Certain boss encounters will now dynamically drop resources based on player health/inventory",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where the Hourglass in the bottle liquid puzzle could be moved by the player",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the ability to get infinite cardboard pieces during the poster puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed inventory bug related to dying during the second phase of the finale",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We appreciate all the kind comments, streams, reviews, fan art, cosplays, and support so far! We're very proud to have exceeded your expectations and made a game that so many are enjoying.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/42924291/51417ddccf014b0b58d8e1ca9c9e72809dbef033.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
