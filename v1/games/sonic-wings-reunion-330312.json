  {
   "id": "sonic-wings-reunion-330312@1.4",
   "gameId": "sonic-wings-reunion-330312",
   "displayName": "Update 1.4",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-09-18T05:02:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "・難易度 ベリーハードを追加しました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・ベリーハードのランキングに対応しました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・一部キャラクターのバランスを調整しました。※緋炎が強化されました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・一部BGM・SEの音量調整",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・あのモードに歌詞が流れるようになりました。",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update to PLAY VER1.4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added Very Hard difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Added Very Hard difficulty rankings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted balance for some characters. ※Hien has been strengthened.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted volume for some BGM and sound effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Lyrics now appear in that mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
