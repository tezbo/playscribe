    },
    {
     "title": "PATCH NOTES",
     "items": [
      {
       "text": "◈ You can now return to the Dojo during a stage, making it easier to revisit other levels or restart the current one.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◈ Added an intro music video to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◈ Added Russian language support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◈ Adjustments to some stages in Act III. We slightly nerfed them to better match the player’s skill progression and adaptation curve.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◈ Rebalanced Eiji, this boss has been nerfed a bit to make the fight fairer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "◈ General bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With love,",
       "ps5ProOnly": false,
