  {
   "id": "mcpixel-3-191576@post-2022-11-16",
   "gameId": "mcpixel-3-191576",
   "displayName": "McPixel 3 - rebalancing and small fixes",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-16T16:42:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I have a tiny batch of fixes for you! Thank you for all the bug reports!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The most important is a tiny chest that will appear whenever you don't have enough coins to go play any of the levels, but have already beaten everything. Now you don't have to replay reounds to get more coins, just grab the treasure chest and keep playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rebalanced the early game coin amounts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added a chest with extra coins appearing whenever you can't afford to access any of the rounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Portugese lagnuage detection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added forced language selector available when holding L while the game is launching",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enabled integer scaling by default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added visual feedback to Primordial Soup level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Do not hesitate to let me know if you'd like somethign changed or fixed in the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
