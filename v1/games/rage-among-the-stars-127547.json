 "releases": [
  {
   "id": "rage-among-the-stars-127547@major-2020-07-09",
   "gameId": "rage-among-the-stars-127547",
   "displayName": "Major Update to the UI!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-07-09T19:43:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Your voices have been heard!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There has been a ton of changes to the UI! Here is what has been changed:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A cool effect has been added when you are at a selection in the menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Settings option in the menu you with the following additions:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-You can now toggle sound on and off, and music on and off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-You can turn fullscreen on and off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the controls section, you can now customize your controls for both the keyboard and the gamepad!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Hooray for WASD users!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The tutorial now updates to let you know what controls you have changed!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-You can now scroll up and down in the Level Select along with being able to scroll left or right.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed a bug that causes the game to crash when you press select in the pause menu with the gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed a bug where you couldn't escape from the cutscenes using the gamepad with start.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
