  {
   "id": "object-factory-371425@2.1.4",
   "gameId": "object-factory-371425",
   "displayName": "Update 2.1.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-04-19T12:29:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Small Update Live! ⚙️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A small update is now live, bringing balance improvements, performance upgrades, and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "• District System Rebalance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved overall balance to make district choices more meaningful and consistent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Main Bus Belt Multiplier Rebalance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted scaling to better reward efficient layouts without over-amplifying early setups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "• Performance Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General optimizations for smoother gameplay, especially in larger factories.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Minor Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various small fixes and stability improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• QoL Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now the belt lineplacer and auto curve are unlocked from the beginning and dont have to be unlocked anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for playing and keep the feedback coming! 🚀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
