       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Optimized performance for handheld hardware",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Controller-friendly UI and interactions",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
