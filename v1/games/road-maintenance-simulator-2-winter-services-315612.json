    {
     "title": "Changes",
     "items": [
      {
       "text": "Improved driving physics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45147485/4d6aa1ae5ed4f022fe36c5545791d780de19c0ff.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New game mode: Free Mode – All seasons and standard tasks are available from the beginning. You can switch seasons via the Progress tab on the tablet. Road construction jobs are still only available in Standard Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45147485/a3a074d72c1886361093d78e377c316f301b782f.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New winter task and tool – Clear rest areas and sidewalks with the brand-new snow blower",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
