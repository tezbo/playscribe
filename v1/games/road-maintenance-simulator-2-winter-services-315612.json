    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update is live – featuring improved driving physics, the new Free Mode with all seasons unlocked from the start, and a snow blower for winter clearing tasks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
