   "announcedAt": "2025-03-24T10:22:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released a patch to resolve unexpected issues such as crashes that have been occurring on STEAM.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Changes and Adjustments",
     "items": [
      {
       "text": "Fixed an issue where the screen would turn red and then crash after launching the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where selecting \"FREE MATCH\" from the \"ONLINE\" mode and then transitioning to \"Back\" or \"Training Mode\" could occasionally cause a hang-up. Other minor bug fixes and optimizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where the game would start fixed on the second monitor (sub monitor) when playing on a multi-monitor setup. Also, the monitor that displayed the game screen last will now be saved as the default monitor for the next startup.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where no sound would be heard after launching the game, followed by a crash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a crash issue that would occur when certain languages were selected in the Windows regional settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
