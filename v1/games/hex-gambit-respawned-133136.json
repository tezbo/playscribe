  {
   "id": "hex-gambit-respawned-133136@major-2020-07-17",
   "gameId": "hex-gambit-respawned-133136",
   "displayName": "Demo Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-07-17T18:12:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "I've updated the HG:R demo with a new feature just added to our closed beta: Captain's Gambits! These are super moves you can use when you're losing to help catch up. Here's a rundown of each demo captain's new power:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bjorgolf: Cold Make Stop – Freeze an opponent for a turn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Grim Drake: No Mercy – Readies all cooldowns and lets moved units go again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hexpert: Glitch – Add 3 to any unit’s health, even above their usual max.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Penny Miser: Take a Penny – 1 damage to all enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Violet: Smackdown – Reduces any minion to 1HP.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can check out some video of the new Gambits in action right here.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun, and please wishlist if you like what you play!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
