  {
   "id": "hex-gambit-respawned-133136@0.1.4",
   "gameId": "hex-gambit-respawned-133136",
   "displayName": "Update 0.1.4",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-07-31T14:37:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Another update for the demo today: all maps have been tweaked, and the 4 player map is completely new! The tweaks mostly center around a new tile type called the Springboard Barrier: an indestructible, permanent crowdsurfing space. Use it for cover, then hop right over when you're ready to fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don't forget to wishlist if you like what you're playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There's also a new dev video you can watch here, showcasing some of the new maps that our beta testers just got access to.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
