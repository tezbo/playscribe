   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-01T14:27:37.000Z",
   "notes": [
    {
     "title": "[img src=\"{STEAM_CLAN_IMAGE}/45316043/d2b429e05ef1eb139c6f620d2a199ee815a07454.png\"]",
     "items": [
      {
       "text": "[p align=\"start\"]Hey everyone! We’ve just rolled out a new update with several improvements to make your experience smoother and more enjoyable. Here’s what’s new:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]✅ New Delivery System!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now hire couriers to transport orders across the city.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]✅ Red Pendant Lamp Fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sockets are now working correctly and can be used without any issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]✅ Better Worker Behaviour",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Workers now behave properly during the skip-night event, making transitions more seamless.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]✅ Improved Customer Animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Customers now feel more alive and natural in the environment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
