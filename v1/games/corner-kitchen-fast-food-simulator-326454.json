  {
   "id": "corner-kitchen-fast-food-simulator-326454@post-2025-03-25",
   "gameId": "corner-kitchen-fast-food-simulator-326454",
   "displayName": "What's Next & Small bugfix.",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-25T18:31:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "What's Next in Corner Kitchen? 🚨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🏗️ Coming Soon: Kitchen Expansion & Delivery System!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🍳 Kitchen Expansion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Running out of room back there? Get ready to expand your kitchen! You’ll soon be able to buy new space, reorganize your stations, and scale your fast food empire like never before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛵 Online Orders & Delivery",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It’s time to go digital. Customers will soon be able to place online orders, and delivery drivers will stop by your restaurant to pick up the food and deliver it. A whole new layer of management and strategy is on the way!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Live Now: Small Fixes, Big Quality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🗂️ Smarter Shelf Management",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now mark food shelves just like stations! Assign what products your runners should place where, giving you even more control over how your kitchen is stocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🍟 Fries Stats Fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve corrected the end-of-day fries display, so your stats now reflect reality — no more mysterious fry count errors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🧃 Runners Refill Fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Runners will now properly refill stations as long as ingredients are available in storage. No more standing around while orders pile up!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⌨️ Key Binding Tweaks",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added a key binding for \"Drop\"",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Removed the duplicate key binding for \"Jump\"",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Stay sharp and stay greasy,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "👨‍🍳 The Corner Kitchen Dev Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
