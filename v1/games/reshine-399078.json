  {
   "id": "reshine-399078@patch-2026-10-20",
   "gameId": "reshine-399078",
   "displayName": "A patch (ID 4690) for demo has just arrived",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-20T12:25:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been going through your feedback, and you have a lot of great ideas. Also, you've found quite a few bugs, so we've just pushed a hotfix to address some of these!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "Fixed screws' rotation direction when screwing them in",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added Traditional Chinese to the language combobox",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Gamepad no longer vibrates if you are playing using a mouse & keyboard",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added a setting for turning off gamepad vibrations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a setting for fixing laser rotation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a setting for skipping the electrolysis minigame",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Disappearing sounds fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tweaks in electrolysis minigame input (frequency changing on arrows / A, D / D-pad)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed translation of \"Choose paint color\" phrase (were always shown in English)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dust particles no longer affect reflections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor tweaks to some sound volumes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Allow resetting progress on objects that are disassembled but have no parts cleaned up yet",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial tweak: don't show \"UV light\" tutorial if making progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial tweak: don't show \"Locate fasteners hint\" tutorial if another tutorial is being shown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial tweak: hide \"Locate fasteners hint\" tutorial if fastener clicked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
