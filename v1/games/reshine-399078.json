  {
   "id": "reshine-399078@patch-2026-10-22",
   "gameId": "reshine-399078",
   "displayName": "A patch (ID 4718) for demo has just arrived",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-22T15:33:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is a small patch with one important change that we heard you asking for: it was way too easy to accidentally click on an already fully painted part and reset its color. To prevent that from happening again, the color won't reset when clicking on such a part anymore; you can just go back and continue working on the remaining parts :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "Paint color resets only when a new color is chosen, not when color selection panel appears",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed broken tool hiding animation when pressing Back during color choosing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed saving customization options when making them before starting the restoration of any object",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "No longer showing parts' 3D widgets when they're fully restored",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Implemented new accessibility setting: Reduced laser flickering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a weird yellow blink on one edge of the vinyl record",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a typo in the Polish entry message",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
