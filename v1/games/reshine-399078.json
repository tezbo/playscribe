  {
   "id": "reshine-399078@hotfix-2026-11-27",
   "gameId": "reshine-399078",
   "displayName": "Hotfix (ID 5183)",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-11-27T15:31:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've just pushed a hotfix with some of the issues you have noticed and reported to us. Thank you for all your reports, comments, reviews and feedback, keep them coming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The launch went really well, and we're blown away by your reception of Reshine - but we'll write more about this next week :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "Potential fix for the comparison mode being broken for some folks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed v-sync setting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Proper image of Blaise Pascal in Roulette Wheel's trivia",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Replaced Paint Spray with Primer in some stages of Sewing Machine (no noticeable difference in how it works, just a proper label is now displayed when using it)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a few typos in texts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the resolution at which pictures in photo mode are taken",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
