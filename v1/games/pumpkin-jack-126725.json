  {
   "id": "pumpkin-jack-126725@1.3.4",
   "gameId": "pumpkin-jack-126725",
   "displayName": "Update 1.3.4",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2020-10-23T19:36:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Spooky scary greetings everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are still going through the great feedback all of you are sending us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some of you also reported some problems with the game, which is why we worked on a first little update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.3.4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue with the timer was fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's now easier to handle the minecart",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with the vortex in level 6",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Better chances to survive the boss fight, even with low fps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "RTX low framerate during the horse section is now fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A small bug that might happen during the cinematics was fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have added a DirectX launcher to the game (You can now choose between DirectX 11 and DirectX 12)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "All the best and stay healthy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nicolas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
