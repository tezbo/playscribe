  {
   "id": "pumpkin-jack-126725@1.3.6",
   "gameId": "pumpkin-jack-126725",
   "displayName": "Update 1.3.6",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2020-10-24T22:41:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We have worked on a few things and here are the results",
     "items": [
      {
       "text": "Fixed a problem where the player was respawning on water during the boat sequences",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the player was constantly respawning on the boat if he had not properly finished the boat sequence",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where skull achievements won't unlock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Solved an issue with the Cinematic volume parameter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where some keybinding were not saved",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug where wrong key names where shown in the keybinding menu",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you all very much for your ongoing feedback and support! ❤️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All the best and stay healthy everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nicolas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
