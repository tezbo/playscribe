  {
   "id": "pumpkin-jack-126725@1.3.7",
   "gameId": "pumpkin-jack-126725",
   "displayName": "Update 1.3.7",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2020-10-27T17:05:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Spooky scary greetings, friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks to all your feedback, we managed to improve the game even further. The new version 1.3.7 for Pumpkin Jack went live a couple of hours ago. Here are the (few) changes that are part of the update:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug with Jack dying in a loop on the water during the boat sequences (again)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the player had to replay the boat sequence if dying during the second race of level 4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the input hints where showing \"Error\" while playing with a controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Folks, I am really blown away by the overwhelmingly positive feedback I received over the last days! Thank you all very very much for your ongoing feedback and support - it's really appreciated! ❤️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All the best and stay healthy everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nicolas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
