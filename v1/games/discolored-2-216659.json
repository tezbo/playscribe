  {
   "id": "discolored-2-216659@major-2024-04-27",
   "gameId": "discolored-2-216659",
   "displayName": "Demo update - some bug fixes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-04-27T21:33:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I just pushed an update to the demo with some bug fixes and reworking some logic in the menus to work better with a controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you get this update and previously had the game installed you might have to reset the controls to prevent any weird behavior. Simply go to the Pause menu and then go to Settings->Controls->Restore Defaults and say yes you want to restore the controls to the default setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "From there, feel free to remap any of the controls as you see fit. :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you notice any issues please let me know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jason",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
