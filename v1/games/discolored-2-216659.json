  {
   "id": "discolored-2-216659@major-2023-10-07",
   "gameId": "discolored-2-216659",
   "displayName": "Demo Update - multiple autosaves and bug fixes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-07T04:19:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The update for the demo today includes the option for multiple autosaves, bug fixes, and other QoL improvements around a couple of puzzles. If you run into any issues or have suggestions please let me know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also due to the way the new autosave system works some of your old saves may get overwritten if you play through the demo again. However you can still manually save the game as before without the autosaves overwriting any new manual saves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can switch back and forth between the autosaves and manual saves from the Load option in title screen and from the in-game Load menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
