  {
   "id": "discolored-2-216659@major-2024-12-28",
   "gameId": "discolored-2-216659",
   "displayName": "Demo update - Ready for launch, some bug fixes, and language updates",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-28T22:36:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The demo was just updated with some bug fixes and updates to get ready for Discolored 2's launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "One important thing to note is this update breaks the save files for previous versions of the demo. This change had to be made in order to allow future save files of the demo to work with the full version of the game. Anyone who plays the demo now will be able to continue their progress in the full game once it is released. Leaving it the way is was, everyone would have to play the demo section all over again if they bought the full game after trying out the demo. Apologies if this causes any inconvenience. Fortunately, the demo doesn't take long to get through once you know where everything is. If you notice any issues please let me know.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update to the demo also adds support for all the languages listed on the store page.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "11 days and counting until launch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wishing everyone all the best in the new year! 🎉🥂",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jason",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
