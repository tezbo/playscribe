  {
   "id": "furi-17026@1.2.58",
   "gameId": "furi-17026",
   "displayName": "Update 1.2.58",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2016-09-23T13:07:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're happy to release Furi's first major update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been listening to the feedback from the community and have added some of the most requested features as well as fixed bugs here and there to improve the experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here is the content of version 1.2.58",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Alternate gamepad control schemes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New radial mode option for mouse aiming (default)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added Steam Trading Cards (waiting for Steam validation)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tweak for Promenade mode (added more variety to the Promenade fights)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slight nerf for The Burst and The Line (in Furi difficulty story mode only - NOT in Speedrun mode)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added hint for Automove (press X to walk on paths to arena)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed most cases where The Burst walls raise below Rider",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved reticle visibility on some levels (re difficulty to see it for colorblind people)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Misc bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you enjoy this update and we'll keep listening to your feedback and bug reports.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The forum link is here: http://steamcommunity.com/app/423230/discussions/0/350542683195320704/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
