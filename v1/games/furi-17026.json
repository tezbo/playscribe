  {
   "id": "furi-17026@post-2022-06-21",
   "gameId": "furi-17026",
   "displayName": "Patch Notes - 21 june 2022",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-06-21T13:58:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you are well and that you enjoyed fighting the guardians with Onnamusha, as well as the last free update. We would like to thank you for all your support on Furi, it’s amazing to see how much you are involved with the game 6 years after its release.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just released this small update to fix some bugs, you will find the patch notes below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "------------------------------------------------------------------",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version: v1.1.224",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed a bug that permitted to skip the Edge fight in Practice mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a pattern in Furier difficulty during the Line fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing feedbacks while tweaking the audio settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the visual quality setting being reset after restarting the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the loading screen on SteamDeck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
