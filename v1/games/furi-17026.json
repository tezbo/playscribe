  {
   "id": "furi-17026@patch-2016-07-19",
   "gameId": "furi-17026",
   "displayName": "Bug reporting, known issues and patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2016-07-19T16:42:42.000Z",
   "notes": [
    {
     "title": "Just wanted to make sure you all know the following",
     "items": [
      {
       "text": "We have updated Furi on July 14th with some important bug fixes (version 1.1.49). In particular fixed R2 sensitivity, added R1 for charged shots, fixed some bugs with Burst and Scale, etc. More info here: http://steamcommunity.com/app/423230/discussions/0/366298942101758722/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have an FAQ/Known issues page on: http://www.thegamebakers.com/furi-faq-known-issues/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have seen a problem, let us know in the forum here: http://steamcommunity.com/app/423230/discussions/1/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
