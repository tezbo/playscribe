  {
   "id": "furi-17026@1.4.94",
   "gameId": "furi-17026",
   "displayName": "Update 1.4.94",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2017-10-23T13:34:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Furists!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released an update (v.1.4.94) with simplified Chinese and Polish languages support. A big thank you to Furi awesome fan Bartek that made the Polish version happen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also made sure the game was playable with the Switch Pro Controller (when you activate Steam’s assistance for controllers).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We still have a to-do list for Furi updates as well as maintenance. Next will probably be the Furier Speedrun in the main branch. Should be pretty soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are what we fight for,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Game Bakers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
