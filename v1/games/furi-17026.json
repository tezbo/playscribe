  {
   "id": "furi-17026@major-2019-04-04",
   "gameId": "furi-17026",
   "displayName": "Furi Freedom Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-04-04T14:19:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Riders,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You might have seen that Furi has been updated today across all platforms outside of Steam. As a clarification all the content in the update is already present in the Steam version. Actually some of the content had been developed following feedback from this community here on Steam that has been very helpful. So thank you for helping us fine tune it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The content made available across platforms is",
     "items": [
      {
       "text": "Invincible Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Speedrun in Furier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bonus boss Bernard from DLC One More Fight or Definitive Edition",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Alternate controls D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "HUD position adjustment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "More details about the update here: https://www.thegamebakers.com/furi-freedom-update/",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
