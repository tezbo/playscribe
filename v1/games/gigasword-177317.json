  {
   "id": "gigasword-177317@1.2.0",
   "gameId": "gigasword-177317",
   "displayName": "Patch 1.2.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-27T16:04:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Swordmasters,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We released a new patch which adds highly requested map pins as well as a couple other bug fixes.",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/41895018/e0b7c1b149c87b03bfc89d65f5bd8e9897a283a6.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
