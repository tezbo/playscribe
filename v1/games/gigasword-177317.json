       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you run into any issues please report them here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-riv otter",
       "ps5ProOnly": false,
