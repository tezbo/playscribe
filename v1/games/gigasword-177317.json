  {
   "id": "gigasword-177317@hotfix-2025-12-22",
   "gameId": "gigasword-177317",
   "displayName": "11/22 - Fast Travel and auto saves hotfix",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-12-22T23:07:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Swordmasters,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We released a hot fix which fixed an issue with Fast Travel, and moved the auto-save from after opening a Grand Key rather than defeating a boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here are the full patch notes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with Fast Travel not unlocking the regions on existing save files, even when unlocking these rooms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The game now auto-saves after opening a Grand Chest, rather than after defeating a boss",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you run into any bugs please report them here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "riv otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
