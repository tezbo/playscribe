  {
   "id": "gigasword-177317@1.2.1",
   "gameId": "gigasword-177317",
   "displayName": "Patch 1.2.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-10T18:05:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey swordmasters,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released a new patch that fixes the long freezes when loading and saving that have been reported. Unfortunately, saves affected by this issue will not be fixed by this patch. This patch only prevents future saves from being affected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have been experiencing this bug please email us at support@akuparagames.com and tell us what the farthest location was your save at and we can give you a replacement save which should be close to where you were story wise. Collectibles (feathers, scrolls, carrots, bunnies) are going to differ from your own save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you run into any other issues please report them here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-riv otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
