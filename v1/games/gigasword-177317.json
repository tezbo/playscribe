  {
   "id": "gigasword-177317@post-2025-11-21",
   "gameId": "gigasword-177317",
   "displayName": "11/21 - Patch Notes",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-21T17:58:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Swordmasters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released a new patch which fixes mana statue text box, fruit plant maxlength and more! Here are the full patch notes if you would like to read them!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed the Mana Statue textbox issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Fruit Plant maxlength issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed One Way Doors not opening on the other side exit before saving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Red/Blue Block softlock in Lunarium",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The ore chest now disappears properly if you leave room mid-animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the structure of a room in the High Wall to avoid softlock",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Bunnies can no longer be fed more than once",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The credits screen shows a max of 30 feathers, not 25",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed map percentage calculation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed multiple maps that had incorrect door colors or room sizes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We are still hard at work on fixing bugs that you have been reporting and examining feedback. If you have any bugs, please report them here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-riv otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
