  {
   "id": "gigasword-177317@post-2025-12-18",
   "gameId": "gigasword-177317",
   "displayName": "12/18 Patch Notes: Fast Travel",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-12-18T17:05:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Swordmasters,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Patch Alert! Fast Travel Unlocked!",
     "items": [
      {
       "text": "We have been taking in the feedback from you guys and Jack, the solo developer on GIGASWORD, is playing Santa by giving us fast travel this patch! There are a couple other fixes in this as well, that you can read about below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/41895018/7f41e0e1276733561eb3b8d59de9129f1db39d9d.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Fast Travel is here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue with Ollestasia's clash attack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a looping boss music issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Certain room connections have been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Can no longer use the right joystick (freecam/swordcam) to float in the air",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Certain sound effects are now correctly impacted by the set sound volume",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The same bunny cannot be fed more than one carrot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buried Depths' enemy now correctly creates a recovery chest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed \"frozen sword deletion\" issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The ice enemy's melee hitbox is now thinner",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The area title upon entering High Wall is now correct",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue on Xbox that prompted the message of “Temporary network problem” and didn’t allow users to play online",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "If you run into any bugs, please report them here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-riv otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
