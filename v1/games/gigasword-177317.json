  {
   "id": "gigasword-177317@post-2025-11-14",
   "gameId": "gigasword-177317",
   "displayName": "11/14 - Patch Notes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-14T19:09:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Swordmasters,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released a new patch notes which fixes \"press B to skip\" prompt not going away after cutscene has ended, removed visible debug numbers from the Ring Switch object and more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can read the full patch note below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Fixed a Pushblock in the Northern Spire.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing tiles in the Buried Depths.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the \"press B to skip\" prompt wasn't going away after cutscene had ended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed visible debug numbers from the Ring Switch object.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed a normal ladder in the Monastery to a kick ladder to prevent early access to the Lunarium.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you run into any issues please report them here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-riv otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
