  {
   "id": "gigasword-177317@post-2025-11-15",
   "gameId": "gigasword-177317",
   "displayName": "11/15 - Patch Notes",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-11-15T15:05:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[p align=\"start\"]Hey Swordmasters,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released new patch notes that address feedback and bugs related to the initial cutscene, along with other hotfixes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can read the complete patch notes below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes - 11/15/2025",
     "items": [
      {
       "text": "Fixed intro cutscene. Made text slower. Split the music into three parts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Re-worded part of the intro cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Combined two lines into one during intro cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug which allowed players to \"enter\" a tunnel while in the air",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a faulty doorway in the Northern Spire, which led to an untextured test room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Monastery exit in the Lunarium",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The cutscene view now correctly turns off if opening chest while holding an object",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Can no longer navigate the pause menu while the controls are being shown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed lag that was occurring when hitting spike-shell enemy with jumping-charge attack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]If you run into any issues please report them here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]-Enrique",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
