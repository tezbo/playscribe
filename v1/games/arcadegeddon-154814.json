  {
   "id": "arcadegeddon-154814@major-2025-03-18",
   "gameId": "arcadegeddon-154814",
   "displayName": "Arcadegeddon F2P Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-18T15:19:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're so excited to welcome even more players to Gilly's Arcade with our Free to Play update. Sharing this chaotic roguelike shooter with fans over the past several years has been an awesome experience and now it's easier than ever to rally the squad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve introduced new weapons, new cosmetics, meaningful gameplay adjustments, and so much more in our latest update. We hope new and returning players find plenty of excuses to chase that undeniable ‘just one more run’ feeling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To everyone joining us in the arcade - thanks so much for your support! We can’t wait for you all to share your rad looks, impressive high scores, destructive builds, and thoughtful feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Much Love,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The IllFonic Crew",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rebalanced Tickets/ArCoin gain and costs to be more consistent with item rarities and game progression",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated Daily/Weekly Challenges",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved loot drops and wave variety in Horde Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Two new weapons (Cyber Katana and Firecracker)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Cosmetics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ammo QoL changes and fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Power Token rebalance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crash Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As a token of our appreciation, all supporters who've purchased and played Arcadegeddon before 3/18 will receive an exclusive cosmetic item, the Hazard Suit, and instant starter weapon access to the two new weapons, Cyber Katana and Firecracker.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
