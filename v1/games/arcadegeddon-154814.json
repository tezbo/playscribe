  {
   "id": "arcadegeddon-154814@1.3.0",
   "gameId": "arcadegeddon-154814",
   "displayName": "Patch 1.3.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-18T16:28:35.000Z",
   "notes": [
    {
     "title": "Arcadegeddon Now On Steam!",
     "items": [
      {
       "text": "Rise To Action with Arcadegeddon On STEAM",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Base Game and Deluxe Upgrade Available Today.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Time Trials",
     "items": [
      {
       "text": "Time Trials are now playable on Arcadegeddon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the Time Trial game mode, you will have 30 minutes to beat all 4 bosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Better start practicing your speedrunning so you can get the best time and score possible!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Horde Mode Update",
     "items": [
      {
       "text": "Horde Mode has been updated with a new intro cinematic and 2 new Horde Mode arenas!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Horde Mode Aftermath",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Horde Mode Downtown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Cosmetics",
     "items": [
      {
       "text": "We have a variety of new cosmetics and updates to existing cosmetics that are now available with patch 1.3.0!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If you’re feeling like you need to make some changes to your wardrobe, this is the time to do it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "7 New Hairstyles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "6 New Outfits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "8 New Head Accessories",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Tints!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Slugger Model",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Boss Stagger Bar",
     "items": [
      {
       "text": "Bosses now have a Stagger Bar that, when filled, will cause the boss to be temporarily stunned and take additional damage for the duration.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "UI Updates",
     "items": [
      {
       "text": "With this new patch, we wanted to make some QoL UI fixes and changes to ensure that you all have the best Arcadegeddon experience possible!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Horde Mode UI has been updated with some new UI elements for information about the “waves”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Defend the Exploit will now show the Health Bar on the top of your screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Surge Abilities have been updated to show when they are fully charged",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boss Portals now have an HP bar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "Surge Energy has been rebalanced for late game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "EXP from Elemental weapon status effects have been rebalanced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Acid weapons slightly nerfed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Infernal weapons now no longer instantly apply the ignite affect. Enemies are now ignited after the initial fire explosion has occurred.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hacks now have diminishing currency returns when sold to the vendor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buffed chests loot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Chests now grant Surge Energy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Boss chests and certain chests in Horde Mode now grant Unique weapon ammo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where bosses would not use certain abilities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
