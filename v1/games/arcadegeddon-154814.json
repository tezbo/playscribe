  {
   "id": "arcadegeddon-154814@1.7.2",
   "gameId": "arcadegeddon-154814",
   "displayName": "Patch 1.7.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-28T18:19:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This is a small patch aimed primarily to allow PS4/PS5 players to enjoy Arcadegeddon without a paid online subscription.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "In addition, we've also included a few minor fixes/changes to this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There will be more news and updates coming soon for Arcadegeddon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added FSR 2.2 support for consoles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Users can purchase now ArCoins directly from the Customization Lockers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where Pandemonium was not rewarding weapon qualities based on difficulty level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where purchasing certain tints could cause the player to lose input",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where certain weapons could exceed their maximum quality level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
