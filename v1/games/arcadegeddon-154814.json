  {
   "id": "arcadegeddon-154814@1.7.4",
   "gameId": "arcadegeddon-154814",
   "displayName": "Patch 1.7.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-18T22:31:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44356106/6df11f6cddefaf2b90e9147bf16ab95087357902.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various crash fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced Horde Mode wave count to 3 and ensured every 3rd wave is a boss wave",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted maximum enemy spawn quantity in Solo Adventure Mode to ensure it didn't exceed this player count's intended limits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Changed the \"Destroy\" icon to \"Boss Fight\" to better communicate boss portal locations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed the Glitch Color Puzzle from the Adventure Mode rotation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Base shield increased from 50 to 65",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
