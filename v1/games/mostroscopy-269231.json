  {
   "id": "mostroscopy-269231@2.8",
   "gameId": "mostroscopy-269231",
   "displayName": "Update 2.8",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-11T01:57:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Good evening! Today we bring you Mostroscopy update 2.8.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update includes fixes to some unblockable combos, fixes to fonts and Japanese language handling, changes to the training mode GUI, and also an adjustment to the characters' basic movements that I hope will make the game more dynamic:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "By connecting a normal movement and canceling it into a special one, the animation is faster, and that opens up possibilities for new combos :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Any comments can be written here or on our Discord!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
