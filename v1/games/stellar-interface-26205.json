  {
   "id": "stellar-interface-26205@0.9.26",
   "gameId": "stellar-interface-26205",
   "displayName": "Update 0.9.26",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-26T18:10:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone \\o",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sorry for the 2-week break in updates. We've been spending all this time working Steam Input into our input control system and it's taking a lot more time than expected, we plan to release it soon as well as the full Steam deck compatibility, the game already works perfectly fine on it, but some glyphs aren't showing properly.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The game is also participating in the Dinos vs Robots Fest with a sale, so if you haven't got Oirbo in your library yet, this is the time for it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "0.9.26 changelog",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Performance enhancements for Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Integrated with Steam Input (still disabled for regular players)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "More changes on a bunch of enemy hitboxes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted some timings on enemies and hazards on the Mechanical bay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added fertilizer to all Nature Bay plants",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
