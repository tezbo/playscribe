  {
   "id": "little-big-adventure-twinsen-s-quest-241954@1.1.3",
   "gameId": "little-big-adventure-twinsen-s-quest-241954",
   "displayName": "Patch 1.1.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-05T08:24:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Twinsiders,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.1.3 is here! We're now self-publishing LBA - Twinsen's Quest, and this is our very first patch. We're thrilled to be back!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Level",
     "items": [
      {
       "text": "The main change in this version is the comeback of the second part of the Temple of Bù, making it 50% bigger! For those who played the original game, you might remember that the Temple of Bù had three parts. In the remake, we only included two.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The truth is, part 2 is tough. We wanted to take the time to rework it properly. We hope you'll enjoy it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/43801523/7b16ff50d678c7f5b3c36e5319f27f82dad41e23.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Other improvements",
     "items": [
      {
       "text": "TAB key now opens the inventory by default (requires input settings reset)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "GamePad D-Pad now supported for UI navigation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the wooden trap in the Temple of Bù",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Flying Bonus issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed revived characters not giving bonus when dying",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated splash screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We're planning more patches. Let us know what you'd like to see in the comments!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ben",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
