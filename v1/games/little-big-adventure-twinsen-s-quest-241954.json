  {
   "id": "little-big-adventure-twinsen-s-quest-241954@post-2024-12-04",
   "gameId": "little-big-adventure-twinsen-s-quest-241954",
   "displayName": "Little Big Adventure – Twinsen’s Quest – Patch Note – December 2024",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-12-04T17:35:50.000Z",
   "notes": [
    {
     "title": "Patch 1.1.1",
     "items": [
      {
       "text": "The patch notes are ready, and the update is just around the corner. Thanks for your support and patience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Technical changes",
     "items": [
      {
       "text": "Steam is now automatically launched if the game is started from Desktop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Add Graphics Settings panel",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix of wide screen UI Layouts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Gamefeel and systems",
     "items": [
      {
       "text": "Dodge animation is no more interrupted by hits (Damages still apply)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix of Twinsen being blocked in fall animation and/or landing after being hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix repeated jump or dodge after being hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix Saber Animations after being hit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mouse melee, aim and throw now attack in the direction of a locked target instead of the mouse cursor",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Mouse cursor is now greyed when target is locked.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Lock & Unlock are now enabled while aiming",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix rotating while throwing MagicBall",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix locked mouse cursor not cleared when unlocking by distance",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
