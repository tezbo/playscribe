   "id": "the-vig-390351@major-2026-03-25",
   "gameId": "the-vig-390351",
   "displayName": "The VIG - Steam Launch Celebration Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-25T06:11:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "🎉 A huge thank you to all players for your support! The VIG is now a \"Very Positive\" hit on Steam, and our launch celebration events have wrapped up successfully.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We’re incredibly grateful for the overwhelming love from the community, and we’ve already started arranging rewards for eligible participants.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To our global fans: Thank you for joining us on this journey! We’re hard at work on more exciting events and content for players worldwide, so stay tuned for future updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any questions, feel free to reach out to our customer service team via yiyingwh@163.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
