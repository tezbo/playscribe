  {
   "id": "shroomtopia-286092@major-2024-02-02",
   "gameId": "shroomtopia-286092",
   "displayName": "Shroomtopia Demo Update - Patch notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-02T22:23:17.000Z",
   "notes": [
    {
     "title": "Hello everyone!",
     "items": [
      {
       "text": "We would like to announce that the first update to the Shroomtopia Demo is now live, with many improvements and refinements based on your feedback. Thank you all very much for contributing to the creation of this game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Demo Update – Patch notes",
     "items": [
      {
       "text": "Lots of performance inprovements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a subtle glow to the fertilizing soil.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added subtle highlights to some UI buttons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added buttons to go back instead of having to press ESC every screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Levels 8, 12 and 15 adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Small visual bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
