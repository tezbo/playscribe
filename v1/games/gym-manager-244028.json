  {
   "id": "gym-manager-244028@major-2024-09-14",
   "gameId": "gym-manager-244028",
   "displayName": "NPC Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-14T06:58:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Now there is 10+ more NPC's more to make member of your gym. 60 NPC's was not possible because of the performance issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The next update will NOT be in 2-3 weeks. We will prepare a bigger update and combine the next 4 updates in one. Have fun playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
