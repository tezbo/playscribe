  {
   "id": "gym-manager-244028@5",
   "gameId": "gym-manager-244028",
   "displayName": "Hotfix 5",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-08-06T15:44:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Throwing boxes will no longer bug the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There was a slim to none chance that you would be able to get bugged item from lockpicking, that is fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bet prize and bet amount balanced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bet bugs fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Member forgotten item dialogue stuck bug fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stuck customers bug fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Level won't drop if you remove the old equipment but I suggest you don't remove them, because variety effects the membership fee",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Italian localization bugs fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sauna state resetting bug on save/load fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Not removable decorations/equipment etc. fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Equipment stealing quest will take into account older stolen equipment",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Guard shouldn't be stuck hitting the same customer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Members will need more resting benches and won't sit at the same bench",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Supplements are more profitable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
