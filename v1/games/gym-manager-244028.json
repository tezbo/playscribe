  {
   "id": "gym-manager-244028@major-2025-07-17",
   "gameId": "gym-manager-244028",
   "displayName": "🏋️‍♂️MAJOR UPDATE coming a bit later 🏋️‍♀️",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-07-17T08:33:27.000Z",
   "notes": [
    {
     "title": "Hey Gym Managers!",
     "items": [
      {
       "text": "We previously announced that a MAJOR UPDATE for Gym Manager would drop on July 17th. However, as we work hard to polish every last detail, we’ve decided to push the release just a little - to July 24th.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We know waiting can be tough, but we truly believe the extra time will help us deliver a much better experience. Thank you so much for your patience and support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s what you can expect in the upcoming update",
     "items": [
      {
       "text": "Fixed Level 12 requirements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rotation of classic metal closet",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with removing closet with bench",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved text placement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved ratings performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added borderless display mode",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added requirements UI to the Bazaar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Made minor localization improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted task completion logic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Various other minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added global illumination",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved lighting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added correct local lights",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added local specular reflections",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added particle effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved day/night cycle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved materials of environmental objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added environmental objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New translations will include: Bulgarian, Czech, Danish, Dutch, Norwegian, Latin American Spanish, Swedish, Thai, Ukrainian, Vietnamese, Hungarian, and Indonesian!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Thanks again for sticking with us - we can’t wait for you to try it out on July 24th! 💪",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
