  {
   "id": "gym-manager-244028@major-2025-06-13",
   "gameId": "gym-manager-244028",
   "displayName": "🏋️‍♂️ MAJOR UPDATE IS COMING 🏋️‍♀️",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-13T10:59:32.000Z",
   "notes": [
    {
     "title": "July 17 - mark your calendars!",
     "items": [
      {
       "text": "A big update is on the way, bringing major improvements to visuals, lighting, performance, and UI. You can also expect a better day/night cycle, more environment details, and a bunch of bug fixes 🛠️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✨ Plus, we're expanding language support!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New translations will include: Bulgarian, Czech, Danish, Dutch, Norwegian, Latin American Spanish, Swedish, Thai, Ukrainian, Vietnamese, Hungarian, and Indonesian!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Stay tuned - it’s going to be the biggest update yet! 💪",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you soon,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gym Manager Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
