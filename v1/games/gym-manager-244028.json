  {
   "id": "gym-manager-244028@major-2024-11-20",
   "gameId": "gym-manager-244028",
   "displayName": "🚨 MAJOR UPDATE ALERT! 🚨",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-20T17:55:20.000Z",
   "notes": [
    {
     "title": "Dear players! We are excited to announce that the latest update for Gym Manager Simulator is now live! 🎉",
     "items": [
      {
       "text": "We've been working hard to address your needs and suggestions, and we hope you'll love the new content. 💪",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "✅ Locker Room added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Solarium overhaul",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Massage Room overhaul",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Sweat Room overhaul",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Third Floor secret implemented",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ Now you can sell everything to the shady salesman",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "✅ One more level added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We encourage all players who already own the game to jump back in and explore the new features. And if you haven’t tried the game yet, now is the perfect time to give it a go! 💥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you’ll enjoy the updates and look forward to hearing your feedback! 🏋️‍♂️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you soon,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gym Manager Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
