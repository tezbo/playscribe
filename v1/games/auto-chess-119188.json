       "text": "1. Magic Mirror",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[Inner Demon]: Mirror pieces now inherit the original's current HP percentage.",
       "ps5ProOnly": false,
