    },
    {
     "title": "This update is a minor hotfix that adresses 2 bugs",
     "items": [
      {
       "text": "\"Fashion Victim\" achievement would not properly unlock after acquiring all outfits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Progress of the final cup race would not properly reset during a game session: If you already own all the outfits in a savegame and not gotten the achievement so far, simply choose to end the current day ingame. The achievement will unlock at that time.: As always, have fun playing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
