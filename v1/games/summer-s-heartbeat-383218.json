  {
   "id": "summer-s-heartbeat-383218@post-2026-07-27",
   "gameId": "summer-s-heartbeat-383218",
   "displayName": "Summer's Heartbeat - Vietnamese Subtitles Out Now",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-07-27T05:42:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, this is the Summer's Heartbeat development team! ☀️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we’re happy to announce that Vietnamese subtitles have been added to Summer’s Heartbeat! 🎉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now, even more players can enjoy the summer romance of Osan",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "with Dayeon, Fury, Ella, Chaesol, and Roring in Vietnamese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We sincerely thank all Vietnamese players who have been waiting for this update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope this new subtitle support helps you experience the story, emotions, and heart-fluttering moments of Summer’s Heartbeat even more comfortably.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to share your love and support for Summer’s Heartbeat!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "For more updates on Summer's Heartbeat",
     "items": [
      {
       "text": "▶ Instagram",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶ Discord",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▶ Twitter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
