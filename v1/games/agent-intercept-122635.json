  {
   "id": "agent-intercept-122635@4.0.2",
   "gameId": "agent-intercept-122635",
   "displayName": "Update 4.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-07-08T06:44:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Attention Agents!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fighting the battle against CLAW, the nefarious criminal organization determined to bring about your demise, requires your Sceptre to be running at maximum full-throttle performance. This is exactly why our 4.0.2 update includes some fine-tuning improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General bug-fixing and optimisation pass",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor graphics improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay balancing tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Good luck out there Agents!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
