  {
   "id": "agent-intercept-122635@4.1",
   "gameId": "agent-intercept-122635",
   "displayName": "Update 4.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-10-22T05:04:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New Mission: Undercover, Under Fire",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Double Agent Penny Black has followed CLAW Elite Tomas Uko to a secure data storage site. You’ll both need to work together in order to infiltrate the secret compound and retrieve vital information from their servers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For the first time ever, play as Penny Black.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Agent Penny Black’s intimate knowledge of CLAW’s operations will be pivotal to the success of this mission, go undercover behind enemy lines and don’t get caught!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Mission: Beneath the Surface",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Intel suggests that Squib, CLAW’s loose cannon demolitions expert, is back at it again. But be on guard, there’s no telling what he’s up to. We’re receiving reports of massive energy readings nearby, investigate that Island!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Forget Squib, these readings are off the charts! It’s a race against the clock as you will need to blast your way through CLAW agents to prevent this power source reaching critical mass! Use everything in your arsenal to navigate through an island rising from beneath the surface of the ocean. If you succeed, we may be able to study it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Best of luck Agent!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
