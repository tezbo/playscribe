   "announcedAt": "2022-01-19T20:34:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Agents!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are excited to bring a new quality of life update to Agent Intercept! This includes a new 5.1 Surround Sound audio feature update, as well as shadow improvements and various bug fixes. We want to thank players for offering their feedback, sharing their gameplay, and enjoying our game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you in the field, Agent. The world needs you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
