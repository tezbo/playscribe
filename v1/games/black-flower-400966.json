 "releases": [
  {
   "id": "black-flower-400966@major-2026-06-14",
   "gameId": "black-flower-400966",
   "displayName": "New update for the Black Flower Demo.",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-14T09:17:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/46092060/628a3fa01674efb7d6dafd1b09b61e10b4f7ca1c.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Over the past weeks, we’ve been reviewing player feedback and watching how people progress through the game. One of the main areas we wanted to improve was the pacing of resource acquisition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this update, resource generation has been rebalanced, allowing players to develop their economy faster and spend less time waiting for key actions. As a result, the overall gameplay flow has become more dynamic and responsive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our goal was not to make the game easier, but to make every session feel more rewarding and keep players focused on meaningful choices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you’re planning to try the demo during Steam Next Fest, you’ll be playing the latest version with these improvements already included.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thank you for your feedback and support. We hope you enjoy the updated experience, and we’d love to hear your thoughts after playing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you in Black Flower!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
