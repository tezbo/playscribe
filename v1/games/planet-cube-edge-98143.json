  {
   "id": "planet-cube-edge-98143@post-2023-04-14",
   "gameId": "planet-cube-edge-98143",
   "displayName": "Patch Notes:",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-04-14T17:09:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixing issue with leaderboards score not being reported properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixing issues with several achievements that were not being unlocked under certain circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixing issues with the cloud save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adding level progression percentage on the pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balancing difficulty of several sections of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixing several checkpoints problems, specially on the hard mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixing stun mechanic problem against one of the bosses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Several bug fixes related to enemies or hazards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improving level decorations, specially on levels 5,6,7 and 8.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
