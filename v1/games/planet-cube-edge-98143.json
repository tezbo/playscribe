  {
   "id": "planet-cube-edge-98143@post-2023-05-24",
   "gameId": "planet-cube-edge-98143",
   "displayName": "New Collectionist Game Mode",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-05-24T16:06:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "For all our dear collectors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have heard your requests and decided to create a new Collectable Game Mode. This mode gives you the possibility to try to get all collectables of the game in a more efficient and fun way.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Use the new room navigation map to instantly get to any room of any of the levels you have already completed. No need to replay a complete level just to find the missing collectables!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Happy Collecting Everyone!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
