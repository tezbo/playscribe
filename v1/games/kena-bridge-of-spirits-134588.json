   "id": "kena-bridge-of-spirits-134588@post-2023-01-23",
   "gameId": "kena-bridge-of-spirits-134588",
   "displayName": "Hoppy New Year!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-01-23T23:13:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "ːkenahappyːHappy 2023! ːkenahappyː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The lunar new year is just around the corner and we are honoring the year of the rabbit with a new Rot hat!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Join in on celebrating the year of the rabbit with this limited-time hat for your Rot. You may already have the original bunny hat (so cute) - go on and revisit the world of Kena to find the Lunar New Year Rabbit hat available only until February 1st.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
