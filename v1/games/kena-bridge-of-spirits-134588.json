  {
   "id": "kena-bridge-of-spirits-134588@2.0",
   "gameId": "kena-bridge-of-spirits-134588",
   "displayName": "Update 2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-09-14T17:08:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "To celebrate our upcoming Steam release, the Kena experience has been expanded with many new features including: New Game+, Spirit Guide Trials, Kena Outfits, Charmstones, Accessibility features, and more. We hope you enjoy exploring your journey in Kena’s world!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wishlist now and stay tuned for more updates as we prepare for this exciting Steam launch coming September 27th!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Anniversary Update with Steam launch includes the following new features and updates:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Game+",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Game+ will become available after completing an initial playthrough – replay the main story while keeping all collected Rot, abilities, and upgrades.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Most New Game+ combat encounters have been updated with new enemies and modified compositions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Special Green Chests with collectibles will become available in New Game+.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many bosses will include new attacks in New Game+.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spirit Guide Trials & Outfits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spirit Guide Trials offer unique challenges to test your skills and earn rewards. Interact with the carving behind the Mask Shrine to take on new Trials as they become available throughout your adventure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unique Kena Outfits with color variants can be unlocked by completing Spirit Guide Trials and Bonus Objectives.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Charmstones, Abilities, & Hats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Equipable Charmstones have been hidden throughout the world that will modify Kena’s abilities by granting unique combinations of advantages and disadvantages in combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Two new Bomb Ability upgrades have been added – Splatter Bomb and Split Bomb.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Rot Hats have been hidden throughout the world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced Photo Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Photo Mode has been enhanced with Lighting Setups, Camera Animation, and more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Brand new Poses have been added to Photo Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Apprentice Spirit Guide, a new difficulty setting, offers a balance between Story Mode and Spirit Guide settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Text localization for Polish language has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "DLSS and Dynamic Resolution support has been added. (PC Only)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Accessibility Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UI scaling.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Automatic sprint.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Subtitle size and background opacity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Toggle input functionally for multiple abilities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Deluxe Edition",
     "items": [
      {
       "text": "Kena: Bridge of Spirits Original Soundtrack has been expanded and remastered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Shadow outfit has been included as a Deluxe Edition exclusive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This patch also includes the following fixes",
     "items": [
      {
       "text": "Pre-rendered cutscenes are rendered at higher frame rate to fix frame pacing issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Difficulty balancing has been improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
