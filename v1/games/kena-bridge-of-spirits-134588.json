  {
   "id": "kena-bridge-of-spirits-134588@2.03",
   "gameId": "kena-bridge-of-spirits-134588",
   "displayName": "Patch 2.03",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-01T02:32:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Happy Friday! We hope you have been enjoying the Anniversary Update for Kena: Bridge of Spirits. Its been a fun week for us seeing all your amazing new shots captured with the updated photo mode features. We've made several stability improvements and corrected a few bugs in this patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned for additional fixes and updates. Thanks for your support and enjoy the adventure!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The 2.03 patch includes the following",
     "items": [
      {
       "text": "Fixed issues making it possible to collect more than 100 Rot when replaying the game in New Game+.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug with the Shrine Guardian Combat Reflection Trial that prevented the bonus objective \"Cleansing Strike\" from being awarded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Kena Outfit animation improvements and fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue allowing the Woodknight to attack during spawn animation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
