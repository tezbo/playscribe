  {
   "id": "kena-bridge-of-spirits-134588@2.04",
   "gameId": "kena-bridge-of-spirits-134588",
   "displayName": "Patch 2.04",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-04T22:55:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've been taking a look at improving stability and have released a small patch focusing on fixing some troublesome crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The 2.04 patch includes the following",
     "items": [
      {
       "text": "Fixed a crash on startup that occurred on Windows N and KN versions.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added a message to crashes caused by corrupt game files that instructs players to verify files and check hardware. This was by far our most common crash, so we hope to elevate this self-fix to all affected users.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If you're still experiencing crashes, we hope some of these troubleshooting steps will help you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Verify Integrity of Game Files",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ensure your Graphics driver is up to date",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Ensure Windows is up to date",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Change between DirectX 11 and 12 (You can run with -dx11 or -dx12 to force on launch)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Enable Windowed Fullscreen mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We always welcome more information on crashes or bugs via email at support@emberlab.com.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
