   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new update for The 9th Charnel is now live, bringing AI improvements, enhanced cutscenes, visual upgrades, and several bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Check out the full patch notes",
     "items": [
      {
       "text": "Fixed flashlight functionality while using controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed camera getting stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minimized door clipping with chain.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed hanging sign clipping through door.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed player getting blocked in forest area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Enhancements",
     "items": [
      {
       "text": "AI redesign: Enhanced AI reaction, Tracking and Better Hiding Reaction to Player: Now if a player hides when it's still within the AI's sight then the AI will come near the hiding spot and the pull the player out from the hiding spot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced Facial Expressions and Body Animations on Certain Cutscenes (All Jacus and Sarah Cutscenes, Sr. Head and Jacus argument meeting scene, Lady Mara Cutscenes camera angle improvement)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced lighting on Certain Cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enhanced Makeup and Texture upgradation of Lady Mara's face",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Replacement of character model of Sr. Head of Epsilon Research Lab",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Lady Face Skin Texture Improvement (Less Freckles on face to create a more child like face)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
