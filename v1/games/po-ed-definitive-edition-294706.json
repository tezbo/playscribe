   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "PO’ed: Definitive Edition has been updated across all platforms! Here are some of the bug fixes and improvements included in the patch:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New door texture in Shuttle level, making it easier to identify what is a door and what is not.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix the double bind issue in default configuration.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix Speedrunner achievement, which did not account for hours (only minutes).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix Fully Stocked achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "New quality-of-life option \"Auto-level Missile Cam\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Lost media added to /Vault in KPF.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix crash involving saves and blobs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Pass-through wall in Sponge is now transparent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
