  {
   "id": "q-u-b-e-10th-anniversary-206756@0.5.33.298",
   "gameId": "q-u-b-e-10th-anniversary-206756",
   "displayName": "Update 0.5.33.298",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-08T14:42:28.000Z",
   "notes": [
    {
     "title": "Q.U.B.E. Create",
     "items": [
      {
       "text": "Build v0.5.33.298 just deployed these changes to Steam",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NEW FEATURE: - Added Gizmo scaling options. Cycle through R to toggle. You can now scale a number of objects in the editor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "NEW FEATURE: - Added Reset button. Attach to puzzle objects to reset them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "NEW FEATURE: - Player Death option in World Settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "NEW FEATURE: - Added Kill Fence. This will instantly kill the player if Player Death option is enabled and player touches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "NEW FEATURE: - Added Turret. This will kill the player after 3 impacts if Player Death option is enabled.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added colour palette to change cable connector properties.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added elevator target display.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bugs with laser redirector, loops, and multiple input sources.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bugs when copying light panels. Their properties are now copied too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed chamber door staying open sometimes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "KNOWN ISSUES",
     "items": [
      {
       "text": "The Force Field has some performance issues right now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
