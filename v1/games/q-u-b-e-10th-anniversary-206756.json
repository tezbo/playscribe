  {
   "id": "q-u-b-e-10th-anniversary-206756@0.4.32.271",
   "gameId": "q-u-b-e-10th-anniversary-206756",
   "displayName": "Update 0.4.32.271",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-13T23:57:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update notes for Q.U.B.E. Create v0.4.32.271",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NEW FEATURE: - Added music player selection options for custom levels. Accessible from the World Properties menu. Songs will preview when clicking on them. Songs will only play during Play Mode or in Published levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated overall lighting, and updated shadows so they aren't so dark overall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Credits screen in menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated menus with consistent headers & styles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added object name text UI when an object is selected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Goal area fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moving component fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added basic chamber door that can be activated/deactivated by weight switches etc.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added actor culling distance ranging from 12000 to 20000 units to aid performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added light culling to aid performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Turned off casting of shadows by default on point lights, spot lights, and light panels. Added option to cast shadows on individual lights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added lighting options in light panels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed orange light panel to be a cracked/broken down styled panel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Weight switch attachment beam fix & optimisation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed collision issue with Lift.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added code methods to change material colours of light panels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added colour picker to geometry and modular meshes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added colour picker to lights and light panel options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added teleporter as a method to end the level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Potential fix for World/Local Space UI getting stuck when loading up a new level.: We hope you enjoy the latest updates to Q.U.B.E. Create! Keep the feedback and suggestions rolling in our Discord: https://discord.gg/ZSHz9kg9VV: Remember to share content on socials and use #qubegame to tag!: Thanks again!: The QUBE Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
