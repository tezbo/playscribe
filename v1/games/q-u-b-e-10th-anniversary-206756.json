  {
   "id": "q-u-b-e-10th-anniversary-206756@0.3.31.249",
   "gameId": "q-u-b-e-10th-anniversary-206756",
   "displayName": "Update 0.3.31.249",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-09-07T12:26:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Q.U.B.E. Create, the free level editor that is available with Q.U.B.E. 10th Anniversary has just posted the following changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Hidden Open Object List when playing published level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Magnet looping sound.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed physics objects not following magnet direction when rotated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added outer cone angle to spot light properties.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Global Illumination not saving.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed mouse sensitivity settings not saving.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed shadow detail quality setting not being able to go lower than Medium.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added more items to the geometry menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed resetting to default sky values.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed moving component reset.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed world magnet overlap check.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "NEW FEATURE: Cable Connector.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "NEW FEATURE: Dynamic Forcefield.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "NEW FEATURE: Goal Area (General Trigger).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
