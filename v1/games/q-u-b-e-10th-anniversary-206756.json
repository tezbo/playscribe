   "id": "q-u-b-e-10th-anniversary-206756@1.2.348",
   "gameId": "q-u-b-e-10th-anniversary-206756",
   "displayName": "Update 1.2.348",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-06-17T14:56:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Some minor fixes to the Q.U.B.E. Create sandbox in this update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Future updates will mostly be minor fixes, with an occasional new feature thrown in. We're happy to take requests for further features and add them to the list of to-do - join our Discord for more info!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed a load of log spam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed name of Goal Area to Trigger Box.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added option to retrigger the Trigger Box.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed old publishing preview files.: Enjoy creating!: The Q.U.B.E. Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
