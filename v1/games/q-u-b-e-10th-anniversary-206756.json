  {
   "id": "q-u-b-e-10th-anniversary-206756@0.2.30.234",
   "gameId": "q-u-b-e-10th-anniversary-206756",
   "displayName": "Update 0.2.30.234",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-07-26T14:40:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "NEW FEATURE: Camera focus on selected object with F on the keyboard.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "NEW FEATURE: Added Object List to list all objects created in the world. Selecting them in the list will select them in the world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed: Texture aligning to world location on walls and modular mesh walls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Potential fix for icons not displaying for some users.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed: Pausing makes objects not moveable after unpausing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added dedicated Lights menu. Moved Point Light there, and added Spot Light.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added options to change colour of lights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed: Light options are now copied when duplicating light objects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
