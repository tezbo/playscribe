  {
   "id": "q-u-b-e-10th-anniversary-206756@0.1.28.218",
   "gameId": "q-u-b-e-10th-anniversary-206756",
   "displayName": "Update 0.1.28.218",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-07-12T16:36:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Q.U.B.E. Create v0.1.28.218 is now live on Steam for all users that own Q.U.B.E. 10th Anniversary!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Patch notes are as follows",
     "items": [
      {
       "text": "Light panels emit more light.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed World Magnets(Classic Magnets): Activated magnets doesn't affect newly spawned physics actors. Magnet range system didn't work correctly. Physics actors now disable when out of the range. Magnets now turn off when returning to Edit mode from Play mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Prevented copying of Magnet Managers due to complications with pairings. The game now displays a failure message when attempting to copy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "NEW FEATURE: Added feature to update existing steam published levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "NEW FEATURE: Added methods to change, save and load material colours for walls via Object Properties window.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Screen being unselectable after initial creation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Elevator being unselectable after using it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Physics Actor being too \"fragile\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed new objects not getting selected when creating and cloning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Potential fix for button materials not being visible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NEW FEATURE: Added Object List menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed lift/text properties menus not toggling off from keybind and other menus being toggled on.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Various code optimizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
