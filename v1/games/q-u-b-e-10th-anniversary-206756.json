  {
   "id": "q-u-b-e-10th-anniversary-206756@1.1",
   "gameId": "q-u-b-e-10th-anniversary-206756",
   "displayName": "Patch 1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-07T16:02:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Q.U.B.E. 10th Anniversary v1.1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What an exciting 4 weeks it has been, first off we'd like to thank all of you for your feedback and support this far - we're still dedicated to making sure the game is everything you want.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "v1.1 Updates: -",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixes -",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that was causing issues in the Sector 8 end slate user interface.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug in which starting a new game in Sector 8 would not reset the collectable items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various user interface text issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Quality of Life -",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Development console key moved from Tab to the ` (backtick) key.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reset puzzle sound effect changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor level design updates and fixes in various places throughout sector 8.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased default look sensitivity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Additions -",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've added an option to enable or disable the outline around cubes that can be interacted with, when hovering over them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you again for all the feedback, both positivity and negative - it all helps us make the game the best possible and we really appreciate the reviews coming in so far!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Until next time!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rushy,: Toxic Games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
