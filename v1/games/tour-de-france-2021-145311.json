  {
   "id": "tour-de-france-2021-145311@major-2021-09-22",
   "gameId": "tour-de-france-2021-145311",
   "displayName": "Patch Notes - September Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-22T08:21:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello riders,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update for Tour de France 2021, (v.02.09.00.529) is now available to download on your Steam client. This update brings at last the official equipment, update the ratings of riders following the recent events but also fixes some issues reported by the community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please read the Patch Notes below to learn more about the content added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Update of official equipment (frames, wheels, helmets) for Lotto Soudal, Bora Hansgrohe, Bahrain Merida, Deceuninck Quick Step, Jumbo Visma and Israël Start Up Nation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update of generic equipment (frames, wheels, helmets).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update of rider ratings to reflect their performances in the Tour de France and other recent events.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update of the riders registered for the Critérium du Dauphiné.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduction in the impact of the Stamina rating on stages under 180 km.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement to sprints, with sprinters making better use of their teammates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement to maximum speed of opponents riding downhill when there is a breakaway to catch up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement in the results of individual time-trials.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement in the position of favourites inside the peloton.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The size of breakaways in the final stages of the Tour de France has been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Correction of minor bugs in the interface.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your continuous source feedback here on Steam and on our social media, our team keeps working on improving the quality of the game!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
