  {
   "id": "demon-hunter-2-new-chapter-32774@2",
   "gameId": "demon-hunter-2-new-chapter-32774",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-05-23T11:29:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Comrades!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our Leader has granted us another glorious update! If you appreciate our work for the bestest country in the world, don’t forget to write a Steam review!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The newest revolutionary update includes",
     "items": [
      {
       "text": "fixed a blocking bug that could occur when exiting MG Floor Run (For Real This Time™);",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a blocking bug that might occur on MG Switchboard;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a bug that changed the mouse cursor into MG Brick Wall cursor after saving the game;",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "fixed a blocking bug occurring on Palace Courtyard with invisible Choir Leader not allowing Evan to use the ladder;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a blocking bug that made throwing a photo into trash almost impossible;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a blocking bug that allowed Evan to use oar on the curtain in Leader's Chamber after finishing a minigame;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a blocking bug that might prevent the train at the end of the game from stopping;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed few typos in English and German language versions;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a few minor navmesh errors;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed position of a few dialogue pivots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "IMPORTANT! We are trying our best to ensure that fixes work for the games that have been already started, but you might be forced to start the game again in some cases (e.g. bug with throwing a photo into the trash or using the oar on the curtain after finishing the minigame).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For the glory of Matryoshka!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
