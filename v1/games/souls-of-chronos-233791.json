  {
   "id": "souls-of-chronos-233791@1.5.227.5",
   "gameId": "souls-of-chronos-233791",
   "displayName": "Patch 1.5.227.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-02-18T03:38:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Adventurers of Astella,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here you will find a list of fixes that address the following issues in the update 1.5.227.5:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where leaving Sewers 2-5 by a specific route won't trigger Mist's encounter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed minor issues related to the keyboard/mouse button layout diagrams.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where players could get stuck in corners on certain levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where players could not recall Torii in certain situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the lobster trap on the beach that prevented it from being used again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Torii's style can be switched more easily in the character's menu now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a Save prompt before the story branches into different endings.: We will continue to listen to our community and keep updating the game based on the feedback we collected. On a side note, we are working on a digital artbook of Souls of Chronos. Please stay tuned!: The Development Team: February 18, 2023",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
