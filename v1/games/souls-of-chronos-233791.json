  {
   "id": "souls-of-chronos-233791@1.5.237.1",
   "gameId": "souls-of-chronos-233791",
   "displayName": "Patch 1.5.237.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-06-27T04:07:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello fellow Astra adventurers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are pleased to announce the latest update, version 1.5.237.1, with exciting new features and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the details of the latest updates",
     "items": [
      {
       "text": "Introduction of the \"Time Passing\" feature: In an effort to increase convenience and streamline gameplay, we have introduced the Time Passing feature. Starting with this release, you will be able to interact with Tori in town and switch between day and night without leaving your current location.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustments to selected boss abilities: To ensure a balanced and challenging combat experience, we have tweaked the skill sets of some of the late-game bosses. These tweaks will add an extra layer of excitement and strategic consideration to combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We truly appreciate the continued support from all players, and we remain committed to updating the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Development Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "June 27, 2023",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
