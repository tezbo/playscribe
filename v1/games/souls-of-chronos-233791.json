  {
   "id": "souls-of-chronos-233791@1.5.228.1",
   "gameId": "souls-of-chronos-233791",
   "displayName": "Patch 1.5.228.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-02-28T07:11:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Adventurers of Astella,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here you will find a list of fixes that address the following issues in the update 1.5.228.1:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated the UI for Story Stats resets at the Black Market Vendor, making it easier to access and understand;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the issue where certain events were not being triggered as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where unlocking Secret Passage earlier than expected would prevent the main storyline from progressing;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Further extended the availability for certain side quests in Chapter 1;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a prompt to remind players before entering the story path that would lead to the Bad Ending.: Additionally, the road map for future updates has been announced earlier. Please check it out if you haven't got the time to do so! If you have any feedback or suggestions about the plan or the gameitself, please do not hesitate to let us know!: The Development Team: February 27, 2023",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
