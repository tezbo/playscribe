  {
   "id": "souls-of-chronos-233791@1.5.227.2",
   "gameId": "souls-of-chronos-233791",
   "displayName": "Patch 1.5.227.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-02-16T06:24:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Adventurers of Astella,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just released the first update since the game's launch, which addresses the following issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where adjusting the resolution after entering the game would lose the original resolution option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed fullscreen display issue on certain non-16:9 screens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where completing the Cassia side quest in Chapter 3 in advance would prevent progress in the main story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that could occur when taking on multiple side quests at once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Floating Leaf time-stop attack did not work on quick button spams.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the \"Stellar!\" achievement, now players can complete all achievements normally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where game saves were not being written properly when Steam cloud saves were disabled.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where players could be stuck in the Secret Passage-15.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimized overall quest configurations to reduce back-and-forth, such as allowing players to find Old Joe at the dock at the end of Chapter 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Completed the \"Special Thanks\" list.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reviewed and improved certain quest names.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Corrected some typos in the text.: Thanks for your feedback in the community - it has been tremendous help to us. We are continuing to address other reported bugs, and committed to keep updating and polishing Souls of Chronos!: The Development Team: February 16, 2023.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
