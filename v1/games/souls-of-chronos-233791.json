  {
   "id": "souls-of-chronos-233791@1.5.227.7",
   "gameId": "souls-of-chronos-233791",
   "displayName": "Patch 1.5.227.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-02-20T14:52:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Adventurers of Astella,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here you will find a list of fixes that address the following issues in the update 1.5.227.7:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the issue where the prompt for the Liz-related side quests would still appear even when all quests were completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that occasionally prevented players from looting the Moral Grass in Sewer 2-9 and 2-10.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that prevented the Story Stats from being correctly displayed on Torii's Floating Leaf style status menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the availability of quest \"Excuse Me, My Lady\" in Chapter 1 so it will stay available for a longer Optimiime.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the availability of quest \"Her Tracks\" in Chapter 3 so it will stay available for a longer period of time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Implemented some QoL improvements for Cooking and Alchemy systems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimized the sensitivity settings for Xbox controllers.: Additionally, we would like to let you know that we have planned out the roadmap for future updates. Once finalized, we will share the detail with you all here!: Please stay tuned!: The Development Team: February 20, 2023",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    }
   ],
