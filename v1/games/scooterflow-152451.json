  {
   "id": "scooterflow-152451@0.9.14",
   "gameId": "scooterflow-152451",
   "displayName": "Update 0.9.14",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-10-23T23:07:58.000Z",
   "notes": [
    {
     "title": "MULTIPLAYER",
     "items": [
      {
       "text": "Smoother online gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the amount of data being sent over network – ability to host servers with lower internet speeds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fingers now animate for connected players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Wheels rotate for connected players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolved issue causing players to disconnect after repeatedly reconnecting to the same host",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Build version checking - lobbies for players on older or newer versions no longer show in lobby list",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "GAMEPLAY OPTIONS",
     "items": [
      {
       "text": "Added auto pumping on/off switch in the game options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Turning ramp assist off now also removes pocket airing assist",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "GENERAL",
     "items": [
      {
       "text": "Trick animation speed slightly increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
