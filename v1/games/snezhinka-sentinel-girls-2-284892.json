   "announcedAt": "2024-09-01T11:16:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The following changes have been made to Abrek's abilities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Before: “When an enemy is killed, the blue gadget's cool time is reduced by 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After: “When an enemy is killed by an attack other than the blue gadget, the blue gadget's cool time is reduced by 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The increased rate of fire of Lisichka's sniper rifle has been slightly reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The pushback power of Sniper Rifle B has been adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Flamethrower flames now penetrate enemy defenses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor bugs have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
