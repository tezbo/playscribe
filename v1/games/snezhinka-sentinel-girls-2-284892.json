   "announcedAt": "2024-08-30T16:58:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a problem in which the bonus card weight tax would result in a negative amount of money in one's possession.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a problem in which some cards would have a negative value when the bonus card “Half Price Sale” was in effect and Anita was used.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the blue gadget grenade would not return to the gun in rare cases if the gadget was continuously thrown while the chance card “Blue Gadget Cool Time Reduction” was in effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the gun would automatically fire the remaining ammunition after reloading when running out of ammunition while burst firing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
