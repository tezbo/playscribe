  {
   "id": "ten-dates-217256@post-2024-05-22",
   "gameId": "ten-dates-217256",
   "displayName": "Now is the best time to find love in Ten Dates",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-05-22T13:20:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update brings minor bug fixes and optimisations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ten Dates is the sequel to the interactive rom-com, Five Dates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Misha, a millennial from London in search of that elusive in-person connection, tricks her best friend Ryan into going to a speed dating event with her. Each with their own five potential matches, Misha and Ryan must pluck up the courage and turn on the charm to date wildly different personalities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Throughout the game, your choices and interactions will either strengthen or weaken your relationship with your date. Amidst a branching, multi-directional chain of conversation topics and deep-dive questions, Misha and Ryan are faced with ice-breaker games, awkward scenarios and unexpected truths. Will either find love?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
