  {
   "id": "bad-end-theater-178264@major-2022-08-03",
   "gameId": "bad-end-theater-178264",
   "displayName": "Czech Translation + Japanese Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-08-03T02:00:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "BAD END THEATER has been translated to czech, thanks to David \"Dejw136\" Benáček!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "this update also includes a japanese re-translation by Katsuhide and Sota! they went through the whole game and edited all the lines, so it should sound a lot more natural now! i hope japanese players will take the chance to replay the game with all the improvements ^^ thank you, Katsuhide and Sota!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "v1.5.0 updates",
     "items": [
      {
       "text": "added czech translation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "updated japanese translation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "spanish (es) and basque typo fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "the scrolling text in the menus has been re-coded to not allow line breaks (a very minor issue that only appeared in certain languages)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-nami",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
