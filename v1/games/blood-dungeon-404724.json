  {
   "id": "blood-dungeon-404724@2026093002",
   "gameId": "blood-dungeon-404724",
   "displayName": "Patch 2026093002",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-10-01T17:00:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "New Content!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Nuclear Throne’s “Yung Venuz” joins the Bunkhouse Annex. Yung Venuz gets more money the more you level up, as well as a bonus brittle boost every 5 levels. He starts with an SMG that sprays bullets in the general direction of the nearest enemy. You can also unlock a crossbow which fires a high powered bolt at the enemy onscreen with the most health. Having trouble getting exploded? The latest wasteland charm Boiling Veins should be your next unlock. It totally prevents death by explosion (though you can still take damage down to your last heart). Don’t forget to spam the airhorn with the use button (for style).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "One new spell to find: Dodge gives you a chance to totally dodge damage from a hit. Upgrade it to bring that chance up. Not affected by luck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New associated quests for the new items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Check out Nuclear Throne",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
