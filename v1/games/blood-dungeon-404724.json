  {
   "id": "blood-dungeon-404724@2026090202",
   "gameId": "blood-dungeon-404724",
   "displayName": "Update 2026090202",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-09-03T04:18:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks for all the feedback on the game! From the reviews, the forum posts, and discord messages, please know that I am reading it all. It's great to get impressions from so many players. I was always planning on making updates to the game to add content and address any issues as they come up, so data like this is great! The game demands more moment-to-moment attention from you than others in the survivors genre, but with proper routing and drop site usage you can turn the tide!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/46152765/4948c2df41fe65ed56d73c278bca582877452b76.gif\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "About drop sites... this was meant to be a fun aspect of the game that you uncover, but with this update I added some more lore and tools to help everyone get there. Take a trip to the library and see for yourself! Drop sites are possible locations of special chests you can just collect. Collect one, and another one spawns at a different drop site. That said I did adjust some of the balance of late game enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full changelog below",
     "items": [
      {
       "text": "new drop site quests",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new hub npcs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new map stamps item at boneshop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "exp curve and blood drop rate balance tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "tweaked wave 10+11 enemy values",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fix with weapon rarity weights",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "changed \"coming soon\" to \"locked\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "bouncer tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "starfish tweaks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "more transparent zombies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "short period of invulnerability after upgrading or exiting warp",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "oxygen tank gives you max o2 when first obtained",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "don't target zombie enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "delay paingains effect until time resumes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "don't fling hearts when collecting two but needing one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "duplicate palette fixes on bug and leggy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "various smaller fixes: Thanks! More soon...: Mark",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
