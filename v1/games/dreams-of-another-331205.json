  {
   "id": "dreams-of-another-331205@1.1.1",
   "gameId": "dreams-of-another-331205",
   "displayName": "Update 1.1.1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-21T09:09:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "■ Achievement Conditions for Conversations with Objects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have reviewed how conversations with objects are detected and adjusted the timing for recording progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Before: When the automatic conversation with an object ended (after listening to the entire conversation)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After: When the automatic conversation with an object started (when the dialogue subtitle appears)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this change, if the conditions have already been met, you may obtain the achievement upon launching the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Specification Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the display method of the mouse cursor",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added a button guide for hiding Sentiments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ocean stage: visual adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cutscene: quality adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Other Minor Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
