  {
   "id": "super-chicken-jumper-172471@post-2021-09-26",
   "gameId": "super-chicken-jumper-172471",
   "displayName": "New Updates",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-09-26T06:04:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing Super Chicken Jumper! Please update your game before reporting any bugs!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been updating and fixing every known bug in the game. If you spot any crashes or glitches in general, please tell us about it so we can fix it as soon as possible!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Badges and cards are on their way!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes and fixes",
     "items": [
      {
       "text": "Boomerang: Bigger cooldown.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "World 1: More space between obstacles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "World 6: Planes can't shoot anymore. You can step on the big press and not die.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where you couldn't use one controller to play without entering 2 player mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where you unlocked the last cutscene without beating the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bugs in a lot of different challenges such as the portal challenge and the spike challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the game would crash by hitting the 4th boss in the face.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the radar wouldn't appear when you went in to challenges or endless mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where obstacles would be in the wrong world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the chainsaw would crash the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the game would crash if your last boss was the Wolf and you went into a challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed more minor things.: Basically any post in the discussions tab as of 25/09 has been read and dealt with (if important).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
