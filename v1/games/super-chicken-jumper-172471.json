  {
   "id": "super-chicken-jumper-172471@post-2021-09-30",
   "gameId": "super-chicken-jumper-172471",
   "displayName": "MODDABLE CONTENT",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2021-09-30T22:01:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are working on a new system for the game that will let you mod tons of content!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For now you can already have as many skins for the main character as you'd like by going to the Skins folder inside your game's folder! You can also mod the second player, all items, all weapons and some of the obstacles! In the near feature we will only be opening more and more folders for you to use!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you want to learn more about Super chicken jumper modding there will be a guide here on steam teaching you how to make new skins in the \"Guides\" section!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
