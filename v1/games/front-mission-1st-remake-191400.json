   "id": "front-mission-1st-remake-191400@major-2024-01-18",
   "gameId": "front-mission-1st-remake-191400",
   "displayName": "Free content update is coming to FRONT MISSION 1st: Remake in 2024!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-18T12:32:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have exciting news for FRONT MISSION 1st: Remake fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game is receiving a free Content Update - Mercenaries, featuring hot-seat local multiplayer, single-player scenarios, and more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This Content Update is scheduled for 2024 - stay tuned for upcoming news!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Mercenaries Content Update",
     "items": [
      {
       "text": "New Singleplayer Scenarios: An exciting array of fresh singleplayer scenarios is coming with the update, each carefully crafted to provide a diverse range of challenges and engaging narratives. These new missions bring a captivating solo gaming experience while also expanding gameplay with new types of terrain tiles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Local Multiplayer Hot-Seat Mode: Jump into action with local multiplayer mode featuring hot-seat functionality! Challenge your friends to a skirmish and prove your tactical superiority on brand-new maps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Mercenaries and a Commander Character: Meet a whole new character roster, including the commander a character, whose role is to introduce you to the new update and assemble the best possible team of mercenaries.: And more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
