  {
   "id": "front-mission-1st-remake-191400@major-2023-07-14",
   "gameId": "front-mission-1st-remake-191400",
   "displayName": "NEW UPDATE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-07-14T13:39:49.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new batch of fixes for FRONT MISSION 1st: Remake is now live on Steam - make sure your game is up to date!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "See the list of changes",
     "items": [
      {
       "text": "Improved controls on the world map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Ability to use WASD and mouse dragging for navigation.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Scroll in the setup menu should now be visible for all resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed softlocks in QuickCombat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changed the conditions for the \"WHATEVER THE COMMAND MAY BE\" achievement: (the achievement can now also be obtained by eliminating all enemies).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that allowed multiple completions of Extra Mission 2 with OCU.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a camera glitch that caused camera jumps on the map for 21:9 aspect ratio.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Other minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
