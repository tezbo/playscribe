  {
   "id": "silver-axe-the-honest-elf-195129@1.02",
   "gameId": "silver-axe-the-honest-elf-195129",
   "displayName": "Update 1.02",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-05-17T02:40:19.000Z",
   "notes": [
    {
     "title": "Bug Fix",
     "items": [
      {
       "text": "●Fixed a issue where the speed when climbing down walls was affected by FPS.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "●Fixed a issue where the UI would get stuck for some players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Control Optimization",
     "items": [
      {
       "text": "●\"Back Flip\" now has its own key, no longer requires attacking to be activated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Added a new \"Interact\" key for talking to NPC and picking up items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Adjusted the Root Summon key configuration on controllers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Confirm and Cancel keys now fixed to A and B (for Xbox Controller, or the corresponding keys on other controllers).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "※Please note, due to the update to key configuration, your custom key mapping from older versions will be reset, please set them again.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Gameplay Optimization",
     "items": [
      {
       "text": "●Added more story when defeated by the Grass Whale for the first time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Adjusted the monster placement in the Giant Tree Grove dungeon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Added a \"Tutorial\" category in the Notebook.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Reworked the Tutorial to make it easier to understand.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Adjusted the energy gain when attacking with skills.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Optimized the command input of \"Wind Shear\" and \"Over Load\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Optimized the \"Back Flip\", now with a short invincibility.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Adjusted the temperature decrease rate of \"Heat Up\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
