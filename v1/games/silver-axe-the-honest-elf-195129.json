   "announcedAt": "2023-03-15T16:26:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update mainly introduces the English version of the game. In order to allow players from around the world to experience the game more quickly, the team tried to use AI to assist in game translation. After careful proofreading, an astonishingly ideal version has been completed. Thanks all players around the world for their patience and support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
