       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Slightly increased the damage of \"Blazing\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Slightly increased the range of \"Heat Up\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Slightly decreased the hitpoints of \"Gophers\" series of monsters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Adjusted the amount of Silver Shard required by \"Silver Charge\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "●Slightly increased the energy gain by attacking with skills.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
