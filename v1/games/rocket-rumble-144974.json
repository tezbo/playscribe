   "notes": [
    {
     "title": "Rocket Rumble just got an update!",
     "items": [
      {
       "text": "We've been working hard on making changes and improvements before our full release (TBD). We've still got lots to do but you can check out the recent changes to Rocket Rumble here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Rocket Rumble Version 0.2.78 Updates",
     "items": [
      {
       "text": "New sound effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "All characters now have voices!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added additional button prompts and improved existing ones",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improvements to In race Character Icons in the HUD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Loading screen is fixed when exiting the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug with tutorial crashing the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Customization Scroll bar now works as intended",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Disconnecting from our online servers no longer softlocks the game on the Splash screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When the Player indicator is active in options, all local players will have nametags above them during gameplay at all times. Hopefully this should help players keep track of where they are",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can no longer get points for damaging yourself with your own items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Killing a player with an item now rewards 4 points instead of 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Projectiles are now effected with the Boost pads in Holo Night",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bugs with the demo version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where you could load multiple tracks at once from the Character Select",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added custom Keybind Menu back into the options.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Minor and Major internal bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "...and, wait who are those shadowy figures on the Character Select?!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Sad Updates",
     "items": [
      {
       "text": "Removed Ghost Dog Pin from last years Halloween event due to a conflict. Players who had this item will receive an in game currency reward automatically",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
