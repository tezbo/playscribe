  {
   "id": "hollow-knight-14593@1.5.68.11808",
   "gameId": "hollow-knight-14593",
   "displayName": "Update 1.5.68.11808",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-06-07T04:22:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added \"Borderless\" option to fullscreen in video options",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "64-bit is now required (For players with 32-bit computers the previous version (1.4.3.2) can still be accessed as a beta)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Vulkan is now the default graphics API for Linux",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Enabled controller rumble (only supported for certain configurations, e.g. Xbox One controller on Windows)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "Hopefully less hitching, and less memory usage on startup (enabled incremental GC, removed heap size increase method)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced screen tearing during screen shakes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed uncollected Grubfather rewards being miss-able",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Soul Tyrant battle in pantheons getting stuck after being defeated sometimes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed death loop if moving too high during Absolute Radiance phase 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Elderbug's Greenpath hint dialogue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Grimm chest reward is now left on the ground if you banish him without collecting it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issues with binding mouse buttons",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed multi damage sometimes taking too much health with lifeblood",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Absolute Radiance music change triggering too early if moving too high in phase 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Glowing Womb charm becoming inaccessible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Sideways dash is now preferred when Dashmaster is equipped (less accidental down dashing!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
