   "announcedAt": "2017-03-09T06:12:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today we’re pushing out an interim patch that addresses various issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our larger optimisation focused patch (1.0.0.8) will be hitting early next week, and we’ll be setting it live on the Steam Beta branch tomorrow afternoon. Opt in to the Beta if you’re keen to check it out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for all your support, and all the wonderful words we’ve received about the game. We really appreciate it, and we’ll keep working to make Hollow Knight even better!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1.0.0.7 Change Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced slowdown issues around Failed Tramway.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Initial optimisation improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Cornifer ambient hum and paper trail.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed Soul Vessel sometimes not displaying on first collect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for Kingdom’s Edge soft-lock.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Geo collection slow-down.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Quick Cast keyboard map not saving between play sessions.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Increased effects on colosseum Shade location.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Various small scene fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Relinked missing dialogues for Lemm & Leg Eater.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed various spelling/grammatical errors in Game Text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Restored Cloth event in Dirtmouth.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where dying in a dream with Joni’s Blessing equipped left you with 1 HP on waking up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Issue with Dash Slash effects sometimes disappearing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where defeating Shade and quickly exiting scene didn’t restore Soul Orb.",
