   "id": "mh-world@major-2025-12-08",
   "gameId": "mh-world",
   "displayName": "UPDATE - Postponed: Monster Hunter Showcase coming Dec. 8 at 10 p.m. UTC!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-08T06:23:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In light of the recent tsunami warning issued due to an earthquake off the coast of Japan, we have decided to postpone the Monster Hunter Showcase broadcast which was scheduled for today. We'll share the new broadcast date with you all as soon as it's decided.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Monster Hunter Showcase | December 2025",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Monster Hunter Showcase is a digital event featuring news about Monster Hunter Stories 3: Twisted Reflection, releasing March 13, 2026, and details on Monster Hunter Wilds Title Update 4, releasing December 16, 2025! The event will be available online starting December 8 from 2 p.m. Pacific Time or 10 p.m. UTC!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stream Date and Time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dec. 8 at 10 p.m. UTC (2 p.m. PT)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– Stream date and time are subject to change.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– The event is estimated at approximately 20 minutes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– The Monster Hunter Wilds portion does not include news about anything other than Title Update 4.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
