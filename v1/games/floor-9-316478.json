 "releases": [
  {
   "id": "floor-9-316478@major-2026-08-28",
   "gameId": "floor-9-316478",
   "displayName": "Major Update Patch Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-28T08:47:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It’s been a while, but we’re finally back with a new update for Floor9.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch adds new content, new systems, quality-of-life improvements, and overall polish across the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Content",
     "items": [
      {
       "text": "10 New Anomalies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We’ve added 10 new anomalies to the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "These new anomalies are designed to bring more variety to each run and make observation even more important. Some are subtle, some are much easier to spot, and all of them are now part of the pool you may encounter while playing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "4 New Achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We’ve also added 4 new achievements for players who want more challenges and more reasons to keep playing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "These are tied to gameplay progress and discovery, so achievement hunters now have a few more goals to chase.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"https://clan.fastly.steamstatic.com/images//45142281/6a5b34bc6e6a5eb629d35bde2048e2a2d80e77d3.png\" style=\"border-width: medium; border-style: none; border-color: currentcolor; border-image: none; -webkit-user-drag: none; max-width: 100%; position: relative; z-index: -1; pointer-events: none;\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "New Systems",
     "items": [
      {
       "text": "Leaderboard System",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A Leaderboard system has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can now compete with other players and compare your performance. This should give players another reason to jump back in and push for better runs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"https://clan.fastly.steamstatic.com/images//45142281/707644b5b770fc5d3aec83b481f14b9dceee951c.png\" style=\"border-width: medium; border-style: none; border-color: currentcolor; border-image: none; -webkit-user-drag: none; display: block; max-width: 100%; position: relative; z-index: -1;\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Anomaly Archive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A new Anomaly Archive system has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "From now on, when you correctly identify and report an anomaly, it will be recorded in the archive. This allows you to visually track:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "which anomalies you’ve already discovered",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "how many anomalies you have seen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "which ones you are still missing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This system gives players a clearer sense of progression and makes collecting anomalies much more satisfying.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"https://clan.fastly.steamstatic.com/images//45142281/10c21374ad81ff407700b4ca6f2e8c80e72d07b9.png\" style=\"border-width: medium; border-style: none; border-color: currentcolor; border-image: none; -webkit-user-drag: none; display: block; max-width: 100%; position: relative; z-index: -1;\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Gameplay Changes",
     "items": [
      {
       "text": "Adjusted Anomaly Encounter Frequency",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "We have reworked how often anomalies appear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The goal here was to improve pacing and make runs feel more balanced. Anomalies should now appear with better overall flow, making the experience feel less repetitive and more engaging.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sprint and Stamina Mechanics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The player can now run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Previously, movement was limited to walking only. With this update, we’ve added both Sprint and Stamina mechanics, giving players more control over movement while still keeping tension and decision-making intact.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"https://clan.fastly.steamstatic.com/images//45142281/47172879c80425d87beff3f45a09556cc4086ff6.gif\" style=\"border-width: medium; border-style: none; border-color: currentcolor; border-image: none; -webkit-user-drag: none; max-width: 100%; position: relative; z-index: -1; pointer-events: none;\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Quality of Life",
     "items": [
      {
       "text": "Motion Blur Toggle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We added an option to disable motion blur.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players who prefer a cleaner image or are sensitive to motion blur can now turn it off from the settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Full Controller Support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Full controller support is now available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve improved controller compatibility so the game can be played much more comfortably with a gamepad.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "macOS Steam Integration Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve fixed several issues related to Steam integration on macOS, including an issue that prevented achievements from unlocking properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Performance & Optimization",
     "items": [
      {
       "text": "Performance Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update also includes general performance improvements and optimizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve made various under-the-hood improvements to help the game run more smoothly overall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Check Out Our Bundle",
     "items": [
      {
       "text": "If you’d like to check out more of our games, you can find our bundle featuring all of our titles at the link below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/bundle/60095/Room_Games_Complete/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, we’d love to hear your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
