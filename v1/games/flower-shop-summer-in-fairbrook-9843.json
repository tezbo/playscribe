  {
   "id": "flower-shop-summer-in-fairbrook-9843@post-2022-02-26",
   "gameId": "flower-shop-summer-in-fairbrook-9843",
   "displayName": "Price reduction and new soundtrack available!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-02-26T08:54:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we decided to lower the game price from 14.99 to 9.99!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please Note: we just submitted the change to Valve so it might take a few days for the new pricing to be approved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition to that, we redid the game soundtrack to have unique custom music (this is what changed in this update, nothing else).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The music is also sold separately as official soundtrack now:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That's all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
