  {
   "id": "metal-suits-counter-attack-217505@post-2026-11-10",
   "gameId": "metal-suits-counter-attack-217505",
   "displayName": "Patch Notes – November 10, 2026",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2026-11-10T05:01:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, this is the Metal Suits development team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new patch for Metal Suits has been released.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch adds a legacy Steam save data recovery feature and a notification when approaching hidden items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We plan to keep updating the game based on player feedback,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "so if you have any feedback, please feel free to share it with us anytime.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes – November 10, 2026",
     "items": [
      {
       "text": "■ Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a legacy Steam save data recovery feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "On your first launch, a prompt will appear asking whether you want to recover your legacy save data.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This prompt appears only once and will not be shown again afterward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your legacy save data will not be deleted and will remain intact.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a notification when approaching hidden items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A notification message will appear when you approach hidden items in Elixnote and UFC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When a hidden item appears, a notification will be displayed along with a sound effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue working hard to provide a better gaming experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues while playing or have any suggestions,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "please let us know anytime through our community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
