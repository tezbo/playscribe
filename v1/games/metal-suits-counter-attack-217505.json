  {
   "id": "metal-suits-counter-attack-217505@post-2026-06-05",
   "gameId": "metal-suits-counter-attack-217505",
   "displayName": "Patch Notes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-06-05T02:00:47.000Z",
   "notes": [
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "1. Overall difficulty has been adjusted to accommodate a wider variety of playstyles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Increased the invincibility duration when the suit is unequipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. When the suit is lost, you can now acquire a new one at random spawn points.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Removed the suit energy depletion system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Removed certain instant-kill patterns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "6. Added a Character Selection option. You can now choose your preferred style in the settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
