  {
   "id": "metal-suits-counter-attack-217505@post-2026-11-04",
   "gameId": "metal-suits-counter-attack-217505",
   "displayName": "Patch Notes – November 4, 2026",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2026-11-04T05:08:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, this is the Metal Suits development team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A bug fix patch for Metal Suits has been released.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This patch fixes the Map Editor help content, an error that occurred during multiplayer,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "and an issue related to voiced dialogue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We plan to keep updating the game based on player feedback,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "so we would greatly appreciate hearing from all of you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes – November 4, 2026",
     "items": [
      {
       "text": "■ Improvements and Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Map Editor help content has been revised.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an error where suit acquisition was not processed correctly during multiplayer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where switching windows during loading left sound effects muted, causing voiced dialogue to be inaudible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We will continue working hard to provide a better gaming experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any issues while playing or have any suggestions,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "please let us know anytime through our community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
