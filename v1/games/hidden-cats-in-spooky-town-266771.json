   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! We are happy to say that we have fixed the following issues occuring in the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Game crashing at Nukeart's logo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-First time playing came with game mostly complete.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Bonus rooms appeared being locked but marked as complete.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You may now enjoy the game's proper experience, let us know if everything works on your end!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
