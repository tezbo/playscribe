  {
   "id": "hidden-cats-in-spooky-town-266771@post-2024-01-17",
   "gameId": "hidden-cats-in-spooky-town-266771",
   "displayName": "Recent Updates",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-01-17T10:04:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello friends, we have been working on all games from Hidden Cats Series to fix reported issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here are the last updates for Spooky Town.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "FIXED - Meow SFX options not working properly;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED - No cats in Normal mode bug;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Enhancements to avoid game break.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "NOTE",
     "items": [
      {
       "text": "Due to the technical nature of the game, sometimes updates can be quite big compared to the game size already installed, even when the update itself is a small thing. But, make note that this won't increase too much of your install files as it is already.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
