   "id": "hidden-cats-in-spooky-town-266771@post-2024-08-29",
   "gameId": "hidden-cats-in-spooky-town-266771",
   "displayName": "Bug Fixing + Adjustment to special cats colors",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-08-29T12:58:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, friends! In this new update we have fixed an issue related to some players not being able to find the last special cats due to them looking like they were already colored, these now starting mostly white instead of slightly colored. We also have fixed an ultrawide screen setting issue. You may now enjoy the game with these improvements! Happy Finding!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
