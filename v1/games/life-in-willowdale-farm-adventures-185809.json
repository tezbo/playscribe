  {
   "id": "life-in-willowdale-farm-adventures-185809@major-2023-12-12",
   "gameId": "life-in-willowdale-farm-adventures-185809",
   "displayName": "Life in Willowdale: Farm Adventures - Quality of Life and Content update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-12-12T16:11:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear villagers of Willowdale,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just released a new update, consisting of the frequently asked about rain feature. Now rain is no longer a bad thing, but something to celebrate!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Please find the full updates note below",
     "items": [
      {
       "text": "Four new crops added: Artichokes, Cranberries, Asparagus, and Beets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New skill added: Precision Sowing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rain now waters your plants, no need to water them during the rain!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quality of life and economy fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor text fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Four new crops have been added",
     "items": [
      {
       "text": "Artichokes, Cranberries, Asparagus, and Beets. These seeds can be purchased from Pahi Patel’s shop.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Precision Sowing",
     "items": [
      {
       "text": "This newly introduced skill allows the user to plant multiple seeds at once, similar to how tools can be charged once upgraded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Rain",
     "items": [
      {
       "text": "Rain can occur at least once a month, excluding the winter season. If your crops are planted and haven't been watered, the rain will change their state to watered giving you time to explore the other activities in Willowdale!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This free update will be released on consoles soon as well!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
