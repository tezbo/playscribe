  {
   "id": "life-in-willowdale-farm-adventures-185809@post-2022-12-01",
   "gameId": "life-in-willowdale-farm-adventures-185809",
   "displayName": "Life in Willowdale: Farm Adventures – More languages added",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-12-01T16:44:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey farmers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re happy to inform you that more languages are now added to the game. You can now play Life in Willowdale: Farm Adventures in Japanese, Simplified Chinese and Traditional Chinese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ll continue to support the game with more updates, make sure to join our Discord. You can ask us questions about the game, interact with the community and receive frequent updates about patches, news and more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
