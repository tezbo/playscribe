  {
   "id": "orbit-industries-194457@1.0.3",
   "gameId": "orbit-industries-194457",
   "displayName": "PATCH 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-27T14:29:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Space Pioneers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🛰️A new console Patch 1.0.3 is now LIVE!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📈 Expect great improvements in your orbital stations on Xbox, PlayStation, and NintendoSwitch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      }
     ]
    },
    {
     "title": "🚀 Console Patch Notes",
     "items": [
      {
       "text": "SMI / Procurement fixes and improvements: ▪️ raised the maximum digits count per system in project progress fields: ▪️ changed project button text when complete to \"Confirm\" and hide the “Delete” button to avoid accidental deletion of finished projects: ▪️ changed mission names’ displaying system in project progress fields",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed placement of attachment position of S5W connector, preventing building closed structures with it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved project provision system, aiming to make availability of new projects more complex and individual to the station progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Several ESV build menu improvements: ▪️ building menu stays open after building a module and remembering the last module that was placed: ▪️ disabling the \"Confirm\" button when the module is blocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved position, size, and text wrapping of temporary notifications decreasing save game size",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Balanced various values throughout the game: ▪️ Setup cost, upkeep cost, workforce needs, input needs, and output values for several modules/systems, making higher level resource modules and workforce modules more profitable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
