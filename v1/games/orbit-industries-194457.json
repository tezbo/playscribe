  {
   "id": "orbit-industries-194457@1.2.10714.0",
   "gameId": "orbit-industries-194457",
   "displayName": "Hotfix 1.2.10714.0",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-07-25T11:36:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Space Pioneers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we just released a small patch with a hotfix for a save game issue!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In some cases, this issue caused modules and projects not working correctly together, resulting in all projects being displayed with seemingly no information and no possibility to accept or cancel, as well as a potential crash when trying to dismantle modules that were currently used for processing a project.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This issue should be fixed with the new version, but we are afraid old save games that were created with this issue present may still not be working correctly... We apologize for the troubles!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please make sure to update your game and, as always, leave us feedback and thoughts in the Community Hub or via our other socials!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay curious,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The LAB132 dev team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
