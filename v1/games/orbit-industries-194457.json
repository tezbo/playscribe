  {
   "id": "orbit-industries-194457@1.0.2",
   "gameId": "orbit-industries-194457",
   "displayName": "PATCH 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-06-01T14:40:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, Space Engineers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🚀 Time to boost the efficiency of your stations on CONSOLES: Xbox, PlayStation, and Switch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      }
     ]
    },
    {
     "title": "We’ve prepared an extensive Patch 1.0.2, with fixes, new features, and adjusted balancing!",
     "items": [
      {
       "text": "Suit up for the new adventure!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "🗒️ PATCH NOTES 🗒️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "FIXES",
     "items": [
      {
       "text": "Fixed available projects crashing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash related to placing systems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash during production simulation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash related to moving systems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed A16M connector module attachment point not working as expected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed performance issues on very large monolithic ASL structures",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash related to wire particle effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed “Space Tourism” trophy not being unlocked when meeting the requirements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed “Social Distancing” trophy unlocking too early",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed “Multi Tasker” trophy not being unlocked when meeting the requirements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed “Architect” trophy not being unlocked when meeting the requirements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "UPDATES",
     "items": [
      {
       "text": "Added hints for next research projects inside “Procurement” view",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Highlighted flight vector of modules when in build mode if colliding with other modules",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enabled Station Reports of AI in Endless game mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Implemented wire efficiency display",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated PlayStation controller images",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Hidden station HUD input legend when SMI is open to avoid double highlights during tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed rendering issues with docking ships",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added drone spawning to DRS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Projects now display each resource progress individually in the project details",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What’s been adjusted",
     "items": [
      {
       "text": "Removed Liquid Gas resource input from EXSY (Extinguishing System) module/system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased upkeep of HCA (Habitat Capsule) module/system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Decreased workforce output of HCA (Habitat Capsule) module/system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased workforce output of CAB (Cabin) and QAT (Quarter) module/system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Decreased upkeep of CAB (Cabin) and QAT (Quarter) module/system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Removed tech dependency from BUHA (Bulkhead) module/system and raised workforce requirement by 100",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "ATTENTION",
     "items": [
      {
       "text": "Regarding PlayStation: only the bolded fixes apply.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "🌌 Thank you all, engineers, for your involvement. The upswing is always the work of both parties - the devs and the players!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
