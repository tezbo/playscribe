  {
   "id": "orbit-industries-194457@1.0.4",
   "gameId": "orbit-industries-194457",
   "displayName": "PATCH 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-11-04T14:11:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Space Pioneers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new console PATCH 1.0.4 is on the horizon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Within this newest update, expect a huge improvement, including balancing, fixes, and voice localization on your Xbox, PlayStation, and Nintendo Switch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      }
     ]
    },
    {
     "title": "Improvements",
     "items": [
      {
       "text": "Deactivateable Systems: Systems can now manually be deactivated and re-activated again (will not produce resources while deactivated, but will also cost no maintenance)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Several new resource colors for wires in ASL (Liquid Gas, Water, Temperature)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Localized AI: Spoken texts by AI voice are now available in multiple languages instead of just English (adjustable via the settings menu)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved System Placing: Players can now place multiple systems of the same kind in succession on the ASL grid",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "Adjust interest rates for banks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Decreased atmosphere needs for HCA and CAB workforce modules",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Decreased workforce requirement for unlocking LPI research project from 600 to 550",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Slightly adjusted project rewards for all 3 difficulty settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced overall error probabilities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Bugfixes",
     "items": [
      {
       "text": "Made the collider of A2B2 connector a bit smaller so they can be built next to each other",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed erroneous sorting of project research hints",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed unlocking threshold for achievement “Architect” / Fixing stat updates for when progress-based achievements get unlocked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed faulty display of required mission systems in mission project requirements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
