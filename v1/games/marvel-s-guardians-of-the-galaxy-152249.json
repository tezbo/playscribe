  {
   "id": "marvel-s-guardians-of-the-galaxy-152249@11.02.2022",
   "gameId": "marvel-s-guardians-of-the-galaxy-152249",
   "displayName": "Update 11.02.2022",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-02-11T17:26:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing Marvel's Guardians of the Galaxy! We have just released patch 2983462, which includes the following.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please make sure to use latest graphics drivers (except for Nvidia 900 series which should stick to 471.11).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Fixes and improvements",
     "items": [
      {
       "text": "Added AMD Fidelity FX Super Resolution (FSR)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Updated level of detail to reduce pop in",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Loading improvements affecting load streaming and late arrival of: elements on some systems",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed rare issue with geometry corruption on load",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix selection of monitor for exclusive full screen when monitor is: connected to a second adapter, or in the case of hybrid graphics in: some modes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes for rare crashes relating to keyboard and mouse interactions",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix for rare crash when selecting characters in Galactic Compendium",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for tutorial prompt icons being misplaced in some languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix issues relating to square aspect window play",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for a hard lock in Guardians menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix placement in some dialogs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for poorly sized icons in Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for placement of longer input icons in some languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix some cases where DLSS was causing fragmentation",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Benchmark correctly identifies Windows 11",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
