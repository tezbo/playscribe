  {
   "id": "marvel-s-guardians-of-the-galaxy-152249@post-2023-02-21",
   "gameId": "marvel-s-guardians-of-the-galaxy-152249",
   "displayName": "Removal of Square Enix Members account system",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-02-21T17:13:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have just released a small patch which removes the Square Enix Members account system from the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Essentially, this means that users cannot link a Square Enix account in-game anymore. Prior to the patch, doing this was rewarded with an early unlock of the War-Lord outfit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The outfit remains findable through normal gameplay by exploring chapter 13.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you are experiencing any issues with the game, please contact the Support Center.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
