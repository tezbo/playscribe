  {
   "id": "marvel-s-guardians-of-the-galaxy-152249@05.11.2021",
   "gameId": "marvel-s-guardians-of-the-galaxy-152249",
   "displayName": "Update 05.11.2021",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-11-05T19:31:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing Marvel's Guardians of the Galaxy! We have just released patch 2980512, which includes the following:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General Fixes",
     "items": [
      {
       "text": "Switch controller icons no longer appear when changing between input devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mouse cursor no longer remains on screen after modifying key bindings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Average CPU/GPU speeds in Benchmark has been corrected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Korean launcher text fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Confirmation on Alt+F4 window no longer affects screen behind.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Guardians menu input fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Camera zoom issue on screenshot for some aspect ratios has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some graphics memory improvements which may reduce stall issues on some setups.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Multiple improvements with Star Lord navigation across multiple maps, including improvement of world boundaries and collisions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Multiple fixes for occasional issues with Guardian navigation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the user might become stuck in Guardians ability menu after spamming interaction button.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for an issue where cancelling your action during the NG+ creation flow may lead to creating a normal New Game instead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for multiple rare issues where enemies may become stuck into walls and block combat completion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for an issue where rapidly and repeatedly invoking the Guardian Request System on the Slakebeast may require to reload checkpoint.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Chapter-specific Fixes",
     "items": [
      {
       "text": "Chapter 1: Fix for an issue where Gamora’s tutorial might be bypassed under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 2: Fix for an issue where the user might become stuck after banter selection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 3: Fix for an issue where reloading the checkpoint after backtracking through a funnel may cause the user’s progression to be blocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 3: Fix for a rare issue where the user might instantly die at one of the QTEs with Gamora.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 3: Fix for an issue where the user might become stuck in the workbench UI under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 5: Fix for an issue where the Grenadier would occasionally not spawn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 6: Fix for an issue where Star-Lord might get stuck into a shop’s counter top.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 7: Fix for an issue where a checkpoint after the Helmet room would not trigger.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 7: Fix for an issue where Drax could be ordered to pull the crane before the Centurion fight begun.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 7: Fix for the Crane puzzle in Hangar Bay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 8: Issue regarding Meredith QTE resolved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 10: Fix for an issue where a slide funnel would make acquiring one of the outfits difficult.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 10: Fixed an issue where the user might become stuck in the fog fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 12: Fix for an issue where the user might become stuck in the Workbench UI under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 13: Fix for an issue where the camera could become stuck on the Milano cockpit when landing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Chapter 13: Fix for an issue where Star-Lord may get stuck in a funnel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various other fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We will continue to monitor reports about your experiences playing our game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
