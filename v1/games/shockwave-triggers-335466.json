  {
   "id": "shockwave-triggers-335466@major-2024-11-29",
   "gameId": "shockwave-triggers-335466",
   "displayName": "REGULAR GAME UPDATE - WE CAN REDO!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-29T13:49:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there pilots!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.2.2 is here and, alongside many bug fixes, it brings a new feature: Restart.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Listening to feedback, the restart feature is mostly for 1cc players, because it restarts the game to stage 1 and deletes all progress like score, power ups and collected crystals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For people who want a stage restart option in order to practice, rest assured, the game will have a practice mode and even a boss rush mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks a lot for the continuous support and feedback! now, work on stage 5 is starting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shinu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
