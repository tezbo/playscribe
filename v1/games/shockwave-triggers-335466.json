  {
   "id": "shockwave-triggers-335466@9",
   "gameId": "shockwave-triggers-335466",
   "displayName": "Update 9",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-04T15:59:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there Sky pilots,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's been a while. I'm just busy with the game, since we are nearing a potential release.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update brings the training mode, where you can learn about the game's mechanics and how to get scores.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Tate mode (Horizontal screen) has an interactive tutorial, where you can test stuff out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sadly and due to technical issues, the Yoko mode (vertical screen) only has a picture tutorial.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I hope you like it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other than that, a few bugs were fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I guess that's all for this regular patch. See you around!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shinu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
