  {
   "id": "shockwave-triggers-335466@5",
   "gameId": "shockwave-triggers-335466",
   "displayName": "UPDATE 5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-27T14:10:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello pilots,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A major update is here. The main star of this update is the 2nd stage available for both arcade and two players modes. I hope you can now enjoy the demo much longer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Alongside to the new stage, we now have 8 achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "And of course, more bugs are fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I'm looking forward to your feedback and bug reports, so I can improve the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shinu Real Arts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
