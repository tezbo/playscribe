     "title": "Changes",
     "items": [
      {
       "text": "Hello pilots,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is a quick note letting you know that I Linux and SteamOs build was added to the launcher. But it's not tested thoughtfully yet. The goal of this build is to make game installation on mentioned OS easier without the need to manually install the game or look for the exe file location.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
