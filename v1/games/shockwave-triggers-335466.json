  {
   "id": "shockwave-triggers-335466@8",
   "gameId": "shockwave-triggers-335466",
   "displayName": "UPDATE 8",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-07T23:20:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there pilots,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Another big update comes with this new patch 1.2.7. I added all 30 achievements/trophies to the game. Although many of them aren't accessible in the demo version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition to that, we now have a world map screen, like a good old arcade beat'em up :D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I guess that's all for this update. See you soon!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shinu Real Arts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
