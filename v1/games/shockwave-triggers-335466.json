  {
   "id": "shockwave-triggers-335466@patch-2024-08-23",
   "gameId": "shockwave-triggers-335466",
   "displayName": "Small patch solving some bugs",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-08-23T18:52:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there pilots,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is just a small bug fixing some bugs reported recently. I wanted to make an announcement in case players still have an issue with the player not respawning due to old save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you still have this issue, just go into options and increase player 1 or player 2 lives back to 1, 2 or 3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shinu Real Arts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
