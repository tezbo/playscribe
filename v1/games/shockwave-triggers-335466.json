  {
   "id": "shockwave-triggers-335466@major-2024-10-11",
   "gameId": "shockwave-triggers-335466",
   "displayName": "REGULAR GAME UPDATE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-11T12:13:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there pilots,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is another regular update update fixing a few bugs, however, we have something new; I just finished an intro for the game and the composer just made a new ost for it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I hope this new addition makes the game shine, even if a little, during the upcoming Steam Next Fest.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, I'm counting on our support, feedback and wishlist.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
