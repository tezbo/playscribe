  {
   "id": "shockwave-triggers-335466@major-2024-10-21",
   "gameId": "shockwave-triggers-335466",
   "displayName": "REGULAR GAME UPDATE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-10-21T00:12:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi there pilots!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This is a regular small update, in which I worked and a few bugs and suggestions I've got lately, most notable are:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "ZXC and arrow keys are the default keyboard controls.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Stage end special attack reward is fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stage result won't get stuff if you leave the score calculating till the end.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bosses won't hide your power ups and items now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam screenshots with F12 are available now.: And more.: I'll working on the rest, and counting on your feedback, I'll be improving the game for sure.: Cheers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
