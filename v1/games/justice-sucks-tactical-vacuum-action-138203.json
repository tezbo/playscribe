  {
   "id": "justice-sucks-tactical-vacuum-action-138203@major-2023-02-14",
   "gameId": "justice-sucks-tactical-vacuum-action-138203",
   "displayName": "Vacuum of Space - Free Content Update Available Feb 16th!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-14T03:26:54.000Z",
   "notes": [
    {
     "title": "BREAKING NEWS!",
     "items": [
      {
       "text": "FamilyCorp CEO, Dale Smith, has been discovered plotting his revenge against the McClean Family.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rumour has it that he's taking the fight to astronomical new heights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get ready for...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Vacuum of Space — A free JUSTICE SUCKS content update coming to all platforms on February 16th (12pm EST)!",
     "items": [
      {
       "text": "(February 17th, 4am AEDT)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Explore an extraterrestrial battleground with an array of new tricks, traps and threats. 🛰️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Hack into the advanced space station systems to shock, pummel and burn the FamilyCorp CEO's clone army. 🔥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Use stealth and misdirection to avoid getting blasted with lasers. 🤖",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fight alongside Sexy McClean in new story & dialogue sequences. ːSexyRoomboː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "In addition to the new levels, there are also some improvements coming for the rest of the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Three new perks to maximize your combat cleaning potential. 🔧",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved footprints left behind by enemies (all the better to stalk your prey). 👣",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "An assortment of tweaks and bug-fixes. 🐞",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
