  {
   "id": "justice-sucks-tactical-vacuum-action-138203@1.0.9",
   "gameId": "justice-sucks-tactical-vacuum-action-138203",
   "displayName": "Update 1.0.9",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-27T06:54:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since releasing JUSTICE SUCKS, the team has been working hard to bring you as many quality-of-life improvements and bug fixes as possible. We’re immensely grateful for all your support so far, and we’re thrilled to be sharing this update with you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved the appearance of the security camera vision indicators",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rotated some tutorial maps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved camera sequences for “Sexy Punch” and “Sexy Slam” abilities",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved animation for blinded enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added more animations for the main menu background",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added new animations for the cat attack and cat idle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved vision indicator for the Rogue enemy to show that they can see Dusty in stealth mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General fixes/improvements for the boss fight",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved scoring for some missions: Bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed issue where repeatedly restarting a mission would cause the game to freeze/crash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where some traps weren’t correctly dealing damage to enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the “Robo-Ram” tutorial could be ended without having correctly used the ability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the “Repair” ability didn’t repair all the traps in the indicated effect radius",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed typo in one tutorial dialogue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where enemies weren’t being pulled into the shower trap completely when activated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed unintended smoke effect in the background of the “Sexy Punch” ability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where the “Smol Enemies” mutator wasn’t adjusting the enemy’s vision indicator accordingly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where spawning too many puddles caused the game to freeze/crash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where enemy path lines were showing incorrect routes: Wanna chat to the devs about the game? Join our Discord!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
