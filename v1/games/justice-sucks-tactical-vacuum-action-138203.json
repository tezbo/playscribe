   "id": "justice-sucks-tactical-vacuum-action-138203@major-2023-02-16",
   "gameId": "justice-sucks-tactical-vacuum-action-138203",
   "displayName": "Vacuum of Space Update - Patch Notes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-16T22:26:36.000Z",
   "notes": [
    {
     "title": "In space, no one can hear you suck.",
     "items": [
      {
       "text": "We're so excited to share this astronomical new adventure with you all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Vacuum of Space update brings some stellar new maps, wacky story content, and lots of sexy, sexy justice. Get ready to defeat FamilyCorp CEO Dale Smith, and his corporate clone army, once and for all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "4 new maps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "2 new cinematics",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "4 new story missions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "5 new post-story missions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "3 new perks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A bunch of new tunes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fun new accessories for Dusty that can be found in the main game levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved appearance of enemy footprints",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bonus 'RoboPal 8819 Owner’s Manual’ booklet for completing all missions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed facial expressions for burglars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the game would soft lock if Esc was pressed during a screenwipe",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed cause of death being incorrect when you fall off map in cybercruise",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved enemy path lines sometimes disappearing/popping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
