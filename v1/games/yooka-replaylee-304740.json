  {
   "id": "yooka-replaylee-304740@major-2026-06-02",
   "gameId": "yooka-replaylee-304740",
   "displayName": "Our Latest Update!!!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-02T16:00:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve been hard at work behind the scenes since Yooka-Replaylee launched, and now we’re thrilled to drop a massive wave of updates your way!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45049132/ca89a289411da3dc968e85c4b80c8da50442f1d2.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Yooka-Replaylee now runs at a buttery-smooth 60fps on Steam Deck!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45049132/9d5d8725195960fe7974970ded260ed71e7990d7.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve introduced even more display options, including FSR2 and DLSS, so you can further fine-tune your setup.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We have also improved our shader prewarming providing you much smoother gameplay across a range of devices.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On top of that, we’ve rolled out a ton of bug fixes, graphics and performance improvements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your incredible support, it means the world to us. We can’t wait for you to jump back in, explore all the improvements, and rediscover everything that makes Yooka-Replaylee special.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
