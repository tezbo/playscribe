  {
   "id": "life-of-delta-145061@patch-2023-04-06",
   "gameId": "life-of-delta-145061",
   "displayName": "Life of Delta's patch is live now",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-04-06T11:26:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear players,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "our latest BUILD 2.1.8 is up and running.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We have fixed the following",
     "items": [
      {
       "text": "FIXED Inventory closes when moving mouse over 8th item",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "FIXED Delta walks through the air when selecting the button/hook while standing on the box",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED Wires won't pop in the Chip mini-game if a certain combination is tried first",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED Magnetic crane created a steel beam copy in a certain move combination",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED Gear mini-game contains lock-on points for gears on top of existing gears",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED Sleeping pills are not collectable after getting sushi orders from the guards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED Stun gun prompt is re-enabled after returning to the elevator room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED Player gets stuck if he goes to menu straight after talking to the Mechanic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED Window cleaning animation glitch causes player to get stuck in the laser puzzle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED Music mini-game has a slight delay in visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "FIXED 'Friend in need' and 'Prison escape' steam achievements can be accidentally skipped",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "FIXED Push crate prompt in LVL-9 is still clickable after initial use: We will continue hunting for any possible bugs. If you come across any, feel free to report them on our community hub.: Airo Games Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
