  {
   "id": "moomintroll-winter-s-warmth-348272@post-2026-04-28",
   "gameId": "moomintroll-winter-s-warmth-348272",
   "displayName": "Patching a couple of issues!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-04-28T12:48:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "There has been very few issues reported, but we just pushed a fix for the 2 most urgent ones:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The issue with soft lock after clearing the snow around the camp fire (Quest \"Camping, the easy way\") is fixed. If you got stuck there, you should be able to continue again now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Users with the Scarf & Mittens DLC can now also access this setting on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We are still working on a few other minor issues, such as some achievement problems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please let us know about other issues you encounter using this form: moomintroll.game/support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
