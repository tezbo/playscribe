  {
   "id": "moomintroll-winter-s-warmth-348272@post-2026-06-01",
   "gameId": "moomintroll-winter-s-warmth-348272",
   "displayName": "Various fixes!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-06-01T11:53:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks for you patience while we have tested our fixes over the past couple of weeks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The latest build adresses several reported issues over the past few weeks:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "All quests should now be completable at the end sequence of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Issue with videos/cutscene being invalid on some computers (especially on Linux)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Users who got stuck behind crates in caves should be able to progress now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Users who were unable to continue after getting lunchbox should now be able to progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Users who were unable to deliver all herbs should be able to progress",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Users who didn't get progress in quest \"A chain of notes\" should be able to progress: Should you still experience issues with these, or anything else - please report using this form: https://moomintroll.game/support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
