  {
   "id": "moomintroll-winter-s-warmth-348272@post-2026-05-05",
   "gameId": "moomintroll-winter-s-warmth-348272",
   "displayName": "Fixing issues with achievements and large snowballs",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2026-05-05T08:54:09.000Z",
   "notes": [
    {
     "title": "This patch solves some issues reported by players",
     "items": [
      {
       "text": "Some users experienced getting blocked by large rolling snow balls. The update should make sure you are always able to despawn these if stuck. Also the large snow balls are never stored in save data any more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The issue with the final achievement not unlocking should be resolved. If you already have all the other achievements, you should be granted the last one when loading in the game. You should only need to press continue on your existing game, or start a new one.: If you have any issues, please report them using this form, and also see the list of known issue: https://www.moomintroll.game/support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
