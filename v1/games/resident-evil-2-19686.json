   "id": "resident-evil-2-19686@post-2023-04-12",
   "gameId": "resident-evil-2-19686",
   "displayName": "Notice on the End of Technical support for DirectX 11 Non-Ray Tracing Versions",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-04-12T08:46:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "On 7/12/2023, support will end for the DirectX 11 non-ray tracing versions (dx11_non-rt) of Resident Evil 7, Resident Evil 2, and Resident Evil 3.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "After technical support has ended, we cannot guarantee compatiblity or operation when using these versions of the games.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
