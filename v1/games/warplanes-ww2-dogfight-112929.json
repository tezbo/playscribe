  {
   "id": "warplanes-ww2-dogfight-112929@major-2019-09-27",
   "gameId": "warplanes-ww2-dogfight-112929",
   "displayName": "New update with Community Missions.",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-09-27T20:06:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The biggest update since Warplanes WW2: Dogfight launch is now available!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It contains a Community Missions hub with a Leaderboard, a Mission Editor and 15 new Premium Planes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Though we are happy that we can introduce some more experimental or wild machines like Haunebu II, the Community Missions hub and the Mission Editor are the new features that we are the most proud of.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In just a few simple steps, you can create your own campaigns and missions and then test it before sharing with the community. If you just want to play – we are introducing a Community Mision Leaderboard – who will be the best pilot in our community? Maybe you?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
