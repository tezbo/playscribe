  {
   "id": "mizuchi-121406@major-2026-03-05",
   "gameId": "mizuchi-121406",
   "displayName": "🔥The BIG Multi-Language Update is OUT NOW!🔥(save system updated)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-05T16:10:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/35533250/6812562f0f2c05e61a54b8c1858a38335283a753.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "1. Multi-language Update!",
     "items": [
      {
       "text": "We’re happy to announce that console multi-language exclusivity is officially over. Mizuchi is now available in the following languages on Steam:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "English",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Traditional Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Simplified Chinese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you find any bugs or glitches or have any feedback, please leave a message on the forum so we may address them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "2. How to access old saves",
     "items": [
      {
       "text": "This update uses brand new saves. If you want to continue your current playthrough, follow the instructions below to revert to the previous version to access your old saves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/35533250/1e3da6c128eb486492878c174f92cd6d2afbec11.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "3. Wishlist Red Rebellion! 😆",
     "items": [
      {
       "text": "If you haven't yet, please wishlist our next game, Red Rebellion! It will help a ton in urging Steam to show it to more players like you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/2114160\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
