  {
   "id": "mizuchi-121406@1.2",
   "gameId": "mizuchi-121406",
   "displayName": "Update 1.2",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2021-01-13T06:22:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have fixed all known typos, grammar and any other errors reported to and found by us. We have also updated the game with sound effects fixes, and a few additional new songs and variations. Next update we have planned is the Chinese version of the game (Simplified and Traditional). Translations are complete, but we need to fulfill merchandise requirements first as those are long overdue. Thank you for your patience! Latest version should have the achievements fixed too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
