  {
   "id": "ferocious-152017@1.03",
   "gameId": "ferocious-152017",
   "displayName": "Patch 1.03",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-12-10T21:21:30.000Z",
   "notes": [
    {
     "title": "BUG FIXES",
     "items": [
      {
       "text": "Fixed a missing audio bug affecting certain actions and ambient sounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a regression introduced in 1.02 where all crafting ingredients incorrectly appeared green regardless of their actual status.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the bone knife model could remain floating in mid-air near the first campfire exit after prying it open.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Addressed a responsiveness issue with buggy driving introduced in 1.02.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted flashlight reflections to reduce harsh glare.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the bone knife model could remain floating in mid-air near the first campfire exit after prying it open.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted flashlight reflections to reduce harsh glare.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "INVESTIGATING",
     "items": [
      {
       "text": "We're in the process of fixing the following issues but they're taking a bit longer than expected. We appreciate your patience. If you have some info to share regarding these issues (for example save files or player log), please contact our team on Steam forum or Discord.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The elevator in Manifesto HQ may not open or activate for certain players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A crash may be caused by the DP-12 when too many particle effects spawned simultaneously (e.g., buckshot hitting multiple surface types).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're also making good progress on other bug fixes not listed here, and working on a few highly requested features and improvements including but not limited to controller support and enemy AI. Thank you for your patience and stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks again for playing FEROCIOUS, please leave a Steam review if you have a moment, that would mean a lot to our team!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
