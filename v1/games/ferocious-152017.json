  {
   "id": "ferocious-152017@1.04",
   "gameId": "ferocious-152017",
   "displayName": "Patch 1.04",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-12-12T20:09:37.000Z",
   "notes": [
    {
     "title": "🎮CONTROLLER SUPPORT🎮",
     "items": [
      {
       "text": "The game now supports Xbox and PS controllers. Players can remap controls in settings, just like with keyboard and mouse.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "Please share feedback about your expericence with controller in the comments. We are planning to make further improvements in the future patches.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In case controller fails to reassign the buttons, please check steam input. Disabling it might resolve the issue.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "AI IMPROVEMENTS",
     "items": [
      {
       "text": "Improved enemy combat behavior and responsiveness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed cases where enemies could get stuck reloading their weapons indefinitely.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved enemy movement and positioning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Smoothed out cover behavior.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved melee combat logic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced situations where enemies remain stuck in cover instead of reacting to nearby threats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "General AI stability improvements, reducing edge cases that caused enemies to freeze, loop behaviors, or act unpredictably.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "BUG FIXES",
     "items": [
      {
       "text": "Fixed the Manifesto HQ elevator failing to open or activate, which could block campaign progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where using shotgun may cause game crash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a campaign soft-lock where the Manifesto Commander could fail to spawn if the treetop camp was cleared early.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where finding baby T. rex objective dialogue may not trigger, which blocks progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Manifesto Key was required for some doors in the Lowlands.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where music may not play as intended in cutscenes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed a misleading dialogue in Creavasse.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players are now given an MP5 in the first combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced the difficulty of early crab-heavy encounters in the first area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
