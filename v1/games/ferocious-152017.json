  {
   "id": "ferocious-152017@1.05",
   "gameId": "ferocious-152017",
   "displayName": "Patch 1.05",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-12-18T15:22:26.000Z",
   "notes": [
    {
     "title": "AI Improvements",
     "items": [
      {
       "text": "Enemies are now much better at abandoning bad or exposed cover instead of lingering too long.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where enemies could get stuck looping between repositioning and attacking, causing them to run in circles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved enemy cover behavior and awareness. Enemies now abandon exposed or invalid cover more reliably and make better use of peeking during combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved enemy combat reactions. Enemies now correctly drop weapons after losing a limb and behave more consistently when engaging the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where enemies could behave incorrectly when reacting to player visibility and positioning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Controls & Controller Support Fixes and Improvements",
     "items": [
      {
       "text": "Fixed several PlayStation controller binding issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Vehicle controls on the controller have been adjusted to better match common standards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added separate driving controls for cars and motorboats on gamepad:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a dedicated Turbo binding, fixing cases where sprinting could fail to trigger correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Attacks can now be performed while running.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Weapons can now be reloaded using the primary attack button when the magazine is empty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved controller flow: you can now resume running after weapon actions as long as you keep moving forward.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Workbench now correctly reacts to both keyboard and gamepad input.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Tutorial system improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tutorial text now updates correctly if the input device changes while the tutorial is active.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tutorials no longer force controller prompts when the player is using keyboard and mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed missing key binding prompts for tutorial messages.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "General refactoring to improve tutorial readability and stability.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Other Fixes and Improvements",
     "items": [
      {
       "text": "Fixed an issue where audio settings could not be adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the flashlight could not be turned on in certain situations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved music transitions for smoother playback between gameplay states.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
