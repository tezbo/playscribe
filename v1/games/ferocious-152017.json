  {
   "id": "ferocious-152017@1.07",
   "gameId": "ferocious-152017",
   "displayName": "Patch 1.07",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-03T14:04:06.000Z",
   "notes": [
    {
     "title": "AI Improvements",
     "items": [
      {
       "text": "Enemies now stop patrolling when the target is found",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enemies are now properly flagged injured when hit by an explosion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where AI would get stuck while trying to flush the player out of cover",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Controls & Controller Improvements",
     "items": [
      {
       "text": "Controller rumble disabled when using keyboard and mouse",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Motorised vehicles use triggers for driving on gamepad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Removed the additional delay before starting to run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "It's now possible to do more actions from the run without manually interrupting the action",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reloading",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Shooting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Healing no longer interrupts the tab selection on journal when the player is not at full health",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Journal is now disabled when starting to run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added aim assist for the controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "General Fixes",
     "items": [
