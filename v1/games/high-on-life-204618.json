  {
   "id": "high-on-life-204618@04",
   "gameId": "high-on-life-204618",
   "displayName": "Patch 04",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-02T20:24:25.000Z",
   "notes": [
    {
     "title": "General crash and progress blocker fixes including",
     "items": [
      {
       "text": "Fixed save game compatibility issue that was affecting progress on unlocking some achievements and hunter challenges.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed infinite load issue in house when warping to final mission during Final Prep.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed loading screen crash from dying during combat in Zephyr.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where player respawned and got locked outside of a warp base door during Krubis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where player was stuck when going through Human Haven portal outside Applebees.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where player couldn’t set down guns during Rescue Lizzie.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Krubis being stuck underground during Boss Fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where Lezduit was available post-game, resolving the below issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Player locked in a room in Human Haven while Lezduit was equipped.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lezduit was available in the inventory and on the couch post-game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Additional Fixes",
     "items": [
      {
       "text": "Fixed achievement “Eye scream, you scream” failing to unlock when expected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed achievement “Mods Please Ban” - can now reliably complete as 30 hunk kills are now possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed enemies not showing up. Ex: Schlooper location in the Outskirts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed low FPS issue during Xenoslaughter at 3440x1440 resolution.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing voice lines for final Ant shot callout at end of 9-Torg bounty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing voice lines for Clugg’s Suits and Sweezy during Giblets bounty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing background music in Slums tunnel during 9-Torg bounty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Ant enemies going through a ramp wall during 9-Torg bounty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved performance in Destroyed Earth during Garmantuous Bounty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Xbox Series X/S",
     "items": [
      {
       "text": "Updated default visual quality setting - now called performance mode. This is intended to run at 60 fps with dynamic resolution (up to 1440p on Series X, up to 1080p on Series S).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Added a new quality mode that features improved visual quality targeted at 30 fps. This runs with dynamic resolution up to 4k on Series X and 1440p on Series S.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    },
    {
     "title": "PC",
     "items": [
      {
       "text": "Added Native and AI Quality Improvement Modes (Nvidia DLSS, AMD FSR 2.0 and Intel XeSS options), now available in the Settings Menu.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "All platforms",
     "items": [
      {
       "text": "Added settings for disabling drift and distortion for the heads-up display (HUD) in the Settings Menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
