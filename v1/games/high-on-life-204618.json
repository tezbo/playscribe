  {
   "id": "high-on-life-204618@05",
   "gameId": "high-on-life-204618",
   "displayName": "Patch 05",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-27T19:13:04.000Z",
   "notes": [
    {
     "title": "General crash and progress blocker fixes including",
     "items": [
      {
       "text": "Fixed Motion Blur and Chromatic aberration settings on PC.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Gurgula Hints that were picked up but not tracked will now update to their proper status.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Additional fixes to prevent players from getting stuck in Space Applebee’s or if they’re already stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues where keybinding not being consistently set for certain keys. Please reset keybindings to default first before rebinding!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Content & Feature Updates",
     "items": [
      {
       "text": "Updated Gus to make his damage more consistent at range.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tightened up Sweezy’s initial firing spread.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Introduced an Accessibility Menu not previously in the game:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Full Auto Firing option allows guns to continuously be fired by holding the primary fire input instead of repeatedly pressing it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Aim Assist Max Angle option adjusts the distance from the player crosshair that an enemy must be to be considered a guaranteed hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Speaking Indicators option can now display icons over the characters speaking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Text Scaling now available by UI Text and Subtitle Text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved legibility options for Subtitles including Hyper-Legible Text.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Camera Motion setting adjusts camera motion levels to player’s preference.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "HUD Drift toggle to remove drifting upon camera turns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Color Correction modes for Deuteranope, Protanope, and Tritanope now added where severity may be adjusted to player preference.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
