  {
   "id": "castle-of-no-escape-2-30947@major-2019-10-21",
   "gameId": "castle-of-no-escape-2-30947",
   "displayName": "Serbian language update and other bugfixes",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2019-10-21T13:41:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone, we've recently updated the Serbian locale for Castle of no Escape 2, after a good deal of proofreading from Marko Josifovic and Rados Milicev!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also, after a recent fullscreen patch, language select screen was a bit off, this patch (1.702) fixes this issue as well.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
