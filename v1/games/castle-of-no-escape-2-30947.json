  {
   "id": "castle-of-no-escape-2-30947@major-2017-10-26",
   "gameId": "castle-of-no-escape-2-30947",
   "displayName": "2017 Halloween update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2017-10-26T21:55:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Starting from version 1.685, you can encounter a new enemy at certain dates around the Halloween - a skeleton from ConE1!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also, I've finally finished integrating chinese translation, though I think I will use better font in another update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "More little updates under the hood",
     "items": [
      {
       "text": "20 new enemy formations (patterns) and 20 new room tile formations (terrains) added to the level generation system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Instead of loading a game without any language if you pressed Esc at language selection (or if the language file is missing), English language is loaded from internal backup.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now enemies also move crates. Previously only the heroes could.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Message show time increased so that you can read long texts easily.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs fixed",
     "items": [
      {
       "text": "Character selection and options music doesn't stop now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Music will start to play again in options if you've disabled and re-enabled it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "You can exit FEATS (achievements) menu with Esc keyboard key now.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Now you cannot accidentally destroy an equipped armor that has no durability left while shooting it in the inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Pausing in-game with gamepad works better now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Diagonal movement with gamepads was somewhat broken for some types of gamepads, fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thanks to Steam gamer SaltySteve for taking time to test different configurations and find out what should we do to fix the X-Box gamepad problem!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
