  {
   "id": "the-legend-of-dark-witch-episode-4-313259@1.0.3",
   "gameId": "the-legend-of-dark-witch-episode-4-313259",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-08T05:12:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Legend of Dark Witch Episode 4 Demo ver.1.0.3 Released",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where hearts dropped by grounded enemies would appear in strange locations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the timing of Chilavert's Revenge Magic activation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where Bine Bine projectiles did not despawn over time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Ghosts can now be left behind after clearing a stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a hidden feature: holding L2 on the stage clear screen will display your equipped Codecs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "\\[English Text] Fixed a line that incorrectly referred to Chilavert as “his.”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
