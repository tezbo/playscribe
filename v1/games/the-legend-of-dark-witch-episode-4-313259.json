  {
   "id": "the-legend-of-dark-witch-episode-4-313259@1.0.4",
   "gameId": "the-legend-of-dark-witch-episode-4-313259",
   "displayName": "Update 1.0.4",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-10T02:53:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed an issue where the display would glitch if the game was paused during the warp to the boss area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where retrying during the warp to the boss area would cause the game to start inside the boss room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the XY coordinates display on the Stage Select screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed discrepancies between visuals and collision detection in certain stage areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed areas that were supposed to be hidden when moving the camera vertically, but were visible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the revert effect would play even when defeated in the small state.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a potential misalignment in the respawn position after falling while small.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Jizu’s size would not match properly when returning from a fall in the small state.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "(Japanese only) Unified the tone and style of the Codec descriptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
