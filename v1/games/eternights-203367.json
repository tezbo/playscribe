  {
   "id": "eternights-203367@post-2023-09-13",
   "gameId": "eternights-203367",
   "displayName": "Eternights Artbook \"How to access\" for Deluxe Edition",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-09-13T10:23:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "How to access",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Eternights: Digital Artbook will be downloaded in the folder where the game is installed in your computer typically (Program Files (X86)\\Steam\\steamapps\\common\\Eternights).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you can't still find it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please send me your screenshot of Deluxe Edition in Steam to fkkcloud@studiosai.dev, I will send you the Artbook personally. ːsteamthumbsupː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
