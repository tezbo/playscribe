  {
   "id": "eternights-203367@9.20.2023",
   "gameId": "eternights-203367",
   "displayName": "Patch 9.20.2023",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-20T19:42:11.000Z",
   "notes": [
    {
     "title": "1) Fixed - Black screen issue on startup",
     "items": [
      {
       "text": "The game won't corrupt the settings.sav anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please send me the log if you still find your self trouble in this issue - the logs can be found in: %localappdata%low\\Studio Sai\\Eternights\\Player.log",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Workaround for people who currently has the black screen on startup / corrupted settings.sav:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "2) Fixed - Black screen issue on cutscene for some graphics card",
     "items": [
      {
       "text": "In the Graphics option, turn on \"Video Playtype MP4\" for people who had issue with cutscene on June 15.: For others, turn on \"Video Playtype WEBM\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please if A) does not work, please toggle B) instead. if B) does not work, please toggle A) instead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please send me(fkkcloud@studiosai.dev) the log if the issue persists.- the logs can be found in: %localappdata%low\\Studio Sai\\Eternights\\Player.log",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "3) Polish - Save/Load UI, UX.",
     "items": [
      {
       "text": "Save and Load UI is not visually distinct to each other to help people who accidentally loaded old progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "4) Polish - Platinum achievement unlock",
     "items": [
      {
       "text": "Platinum achievement to be checked on every achievement unlock moment instead of trigging at the end of the game once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
