  {
   "id": "arena-renovation-110384@1.0.255",
   "gameId": "arena-renovation-110384",
   "displayName": "Update 1.0.255",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-05T08:08:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Renovators! 👋",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve just released update 1.0.255, focusing on improving stability and fixing several issues reported by our community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "✅ Fixes",
     "items": [
      {
       "text": "Fixed an issue with flags on Luminous Stadium.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Resolved a problem causing some elements to disappear after loading a save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that prevented completing the special quest on Small Basketball Hall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that blocked painting certain walls to completion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Implemented some optimization improvements to enhance overall performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "[p align=\"start\"]Thank you for all your bug reports and ongoing support! 💙",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Keep sharing your feedback on the Steam forum or Discord — you’re helping us make Arena Renovation better with every update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
