  {
   "id": "arena-renovation-110384@major-2025-09-15",
   "gameId": "arena-renovation-110384",
   "displayName": "Skatepark Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-15T16:02:58.000Z",
   "notes": [
    {
     "title": "To celebrate the sale of our studio, we have a great update for you!",
     "items": [
      {
       "text": "From now on, you can renovate the Skatepark! 🛹🛼🛴",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/33646252/177591bbf74f6815ea47777e7cffb8598b051cba.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A lot of extraordinary, interesting fun awaits you. So what are you waiting for? Let's get to work! 🔥🏃 This is a bonus object that we adding while waiting for Career Mode 🥳",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun and let us know what you think of the update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you haven't tried the game yet, now is the best time to do so: ⬇️⬇️⬇️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/948880/Arena_Renovation/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Arena Renovation team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
