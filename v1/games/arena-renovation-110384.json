  {
   "id": "arena-renovation-110384@major-2025-12-17",
   "gameId": "arena-renovation-110384",
   "displayName": "Ice-skating Rink Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-17T15:51:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "🎄❄️ Winter is coming to Arena Renovation! 🎄❄️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]In the current update, we’ve added an ice-skating rink — renovate it and prepare the arena for winter madness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ice, atmospheric lighting, and a winter vibe change the feel of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jump in and see the arena in its holiday edition ❄️🎁",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/33646252/c1565c985dbef88543912ef27c0e91905f2ac154.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
