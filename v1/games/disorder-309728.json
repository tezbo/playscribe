  {
   "id": "disorder-309728@patch-2025-01-23",
   "gameId": "disorder-309728",
   "displayName": "[01/23] Urgent Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-01-23T10:40:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear users,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An emergency fix patch has been updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Of the requests we received over the past day, these are the quickest fixes we could make.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Add Cutscene skips",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Give HP potions at the spawn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. You can return to the main menu after saving from the pause state",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Description [Mutant Mode -> Easy Mode]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Weaker enemies in the early game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We promise to keep updating the game as best we can to ensure everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for visiting the department store.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
