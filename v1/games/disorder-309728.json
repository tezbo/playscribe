   "announcedAt": "2025-01-31T12:50:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear users,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new patch has been updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixed: Unobtainable Trophy",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixed: Skills remaining after selling them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fixed: Settings were not saved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Leaked characters: If you've experienced it, Please think of it as a glimpse into the future. Sorry...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reduced the amount of difficulty rating increase in Easy Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added SP strong attack to Roto",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added some physical jiggling to characters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Camera Axis Invert: Thank you for visiting the department store.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
