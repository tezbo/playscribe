  {
   "id": "coastline-flight-simulator-154006@1.0.1",
   "gameId": "coastline-flight-simulator-154006",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-07-13T08:20:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "-Fixed an error in the save file. (It was not possible to unload the goods, so that the delivery was not possible.) Now the save is working correct and the goods will be unloaded, so the delivery happens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: It is possible to continue a saved game with this patch. Just follow these steps:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Download and install version 1.0.1 via Steam.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Press “Continue” in the Main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Select the save file of your choice (probably the latest).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Your character is outside the airplane and the goods are not unloaded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. Enter your airplane, start the engine, release the parking brake.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "6. Drive the airplane outside the parking position until the message appears to enter the parking position.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "7. Drive the airplane back to the parking position, hit the parking brake and stop the engine.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "8. The goods will be unloaded now and the delivery was completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "9. You can continue the game as usual.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
