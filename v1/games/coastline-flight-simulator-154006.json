  {
   "id": "coastline-flight-simulator-154006@1.0.2",
   "gameId": "coastline-flight-simulator-154006",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-08-18T12:42:50.000Z",
   "notes": [
    {
     "title": "Enhanced controller / gamepad support to handle custom input mapping for flight sticks and HOTAS.",
     "items": [
      {
       "text": "Now you can change the input mapping for more than one controller this makes flight sticks and HOTAS which uses several devices like stick, pedal and throttle usable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It is recommended to reset the input mappings, if they were changed before 1.0.2, to reduce the probability of strange input behavior after loading saved mappings of a version prior 1.0.2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed an error in input mapping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed possible spawning of two airplanes on spawn",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed special discovery mission did not trigger",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
