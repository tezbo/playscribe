  {
   "id": "warhammer-40-000-shootas-blood-teef-159703@4",
   "gameId": "warhammer-40-000-shootas-blood-teef-159703",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-11-29T12:09:00.000Z",
   "notes": [
    {
     "title": "Technical",
     "items": [
      {
       "text": "The “More Dakka!” and “More Flash!” achievements unlock consistently. If you've done the requirements for these achievements previously and it didn't unlock, the achievement will be granted retroactively on game launch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The “Find all Secrets” achievement is updated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "UI",
     "items": [
      {
       "text": "Increased readability for kick options and hat pricing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Teef count for “The wall imperturbable” has been fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, the following community items have also been added and can now be earned through playing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "6 badges",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5 trading cards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3 profile backgrounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5 emoticons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
