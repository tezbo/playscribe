  {
   "id": "warhammer-40-000-shootas-blood-teef-159703@2",
   "gameId": "warhammer-40-000-shootas-blood-teef-159703",
   "displayName": "Patch 2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-30T08:01:46.000Z",
   "notes": [
    {
     "title": "Technical",
     "items": [
      {
       "text": "Fixed an issue where some players were unable to use the mouse in menus.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue that could cause some online players to not be able to unlock a weapon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a desynced door that could occur in Goghamma Part 2 in online multiplayer.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Players can now make an online lobby for Goghamma Part 2 using the chapter select.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where some players experienced no audio.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some achievements that were unachievable in some cases can now be unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed loading screen music.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved stability of online multiplayer connections during loading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Save data is now stored in a file, meaning that cloud saves are available. (Found at C:\\Users\\\\AppData\\LocalLow\\Rogueside\\Shootas, Blood & Teef)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved game stability in several areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced loading times for some levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a number of minor issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Balance",
     "items": [
      {
       "text": "Several extra enemies will now engage you on the beaches of No Man’s Land.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
