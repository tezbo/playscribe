  {
   "id": "warhammer-40-000-shootas-blood-teef-159703@1",
   "gameId": "warhammer-40-000-shootas-blood-teef-159703",
   "displayName": "Patch 1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-10-21T17:36:11.000Z",
   "notes": [
    {
     "title": "Visuals",
     "items": [
      {
       "text": "Camera tracking improvements for the Locus Impurus level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed several layering and particle issues for Versus levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The overheat indicator in the player overhead UI has been significantly increased in size to prevent players from taking fire damage without knowing what is happening.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Technical",
     "items": [
      {
       "text": "The “Dats a Weird Lookin Deffdread” achievement should now be unlockable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The lobby “ready” and “start” can now be triggered by pressing the spacebar on a keyboard. This also provides a workaround for players who are currently unable to use their mouse in the lobby while we are still investigating the cause of said issue.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Leman Russ no longer loses its cannon when killed by fire.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Shokka Pistol damage during Waaagh now deals an appropriate amount of damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rokkit launcher sound effects no longer disappear after clearing the second level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A tentative fix for disconnects during loading screens was added, which should significantly reduce the number of disconnects players experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some potential crashes during loading.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Global",
     "items": [
      {
       "text": "We’re monitoring where players are struggling or breezing through. There won’t be many changes in this small hotfix, but for now we did notice that hard mode players seemed to desire a greater challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Damage taken in Hard mode slightly increased overall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The Bastion of Valor",
     "items": [
      {
       "text": "Many players struggled longer than expected with the second phase of the first boss on all modes, so we’re reducing its difficulty overall:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Significantly increased time between crates falling down.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Significantly increased the time between enemy spawns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moderately reduced charge damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Moderately reduced falling crate impact damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slightly reduced falling crate explosion damage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slightly reduced falling crate projectile speed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
