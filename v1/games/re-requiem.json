  {
   "id": "re-requiem@major-2026-03-27",
   "gameId": "re-requiem",
   "displayName": "Notice of Update Distribution",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-27T02:06:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released an update including the following modifications and fixes.",
       "ps5ProOnly": false
      },
      {
       "text": "Photo mode has been added. It can be accessed from the pause menu.",
       "ps5ProOnly": false
      },
      {
       "text": "Fixed a bug that caused progress to be impossible under certain conditions.",
       "ps5ProOnly": false
      },
      {
       "text": "Typographical errors in some languages have been corrected.",
       "ps5ProOnly": false
      },
      {
       "text": "Character expressions in some cutscenes have been adjusted to better convey emotion.",
       "ps5ProOnly": false
      },
      {
       "text": "A number of issues were fixed to improve gameplay.",
       "ps5ProOnly": false
      },
      {
       "text": "Fixed visual bugs that occurred with some GPU drivers.",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a bug that caused the game to crash in some circumstances.",
       "ps5ProOnly": false
      }
     ]
    }
   ],
