  {
   "id": "re-requiem@major-2026-03-06",
   "gameId": "re-requiem",
   "displayName": "Notice of Update Distribution",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-06T02:59:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released an update including the following modifications and fixes.",
       "ps5ProOnly": false
      },
      {
       "text": "・Issues which blocked player progress under specific conditions have been fixed.",
       "ps5ProOnly": false
      },
      {
       "text": "・Issues related to path tracing performance have been fixed.",
       "ps5ProOnly": false,
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Visual issues caused as a result of upscaling function use have been fixed.",
       "ps5ProOnly": false
      },
      {
       "text": "・Multiple fixes to improve overall playability have also been implemented.",
       "ps5ProOnly": false
      }
     ]
    }
