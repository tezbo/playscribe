  {
   "id": "re-requiem@post-2026-06-03",
   "gameId": "re-requiem",
   "displayName": "Resident Evil Requiem demo: replacing incorrect version",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-06-03T07:24:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "If you downloaded the demo between its initial release and May 26, 2026 9:00 PM (PDT) / May 27, 2026 5:00 AM (BST), please follow the steps below to re-download it as the Japanese version of the demo was unintentionally published globally.",
       "ps5ProOnly": false
      },
      {
       "text": "1. Uninstall the existing 'Resident Evil Requiem - Demo' from your Steam library.",
       "ps5ProOnly": false
      },
      {
       "text": "2. Download the demo again from the Steam store.",
       "ps5ProOnly": false
      },
      {
       "text": "Thank you for your co-operation!",
       "ps5ProOnly": false
      }
     ]
    }
   ],
