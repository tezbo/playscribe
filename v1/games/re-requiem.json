  {
   "id": "re-requiem@major-2026-06-25",
   "gameId": "re-requiem",
   "displayName": "Notice of Update Distribution",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-25T05:04:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released an update including the following modifications and fixes.",
       "ps5ProOnly": false
      },
      {
       "text": "・Fixed some minor issues.",
       "ps5ProOnly": false
      },
      {
       "text": "・Reduced the difficulty of Forever - Rank 1 and Forever - Rank 2 in the additional minigame, Leon Must Die Forever.",
       "ps5ProOnly": false
      },
      {
       "text": "・Enhanced some of the skills in the additional minigame, Leon Must Die Forever, to allow for a wider variety of enhancer combinations.",
       "ps5ProOnly": false
      },
      {
       "text": "Greatly increased the probability that hand grenades won’t be consumed when using the “Explosives Specialist” skill.",
       "ps5ProOnly": false
      },
      {
       "text": "Increased the percentage of attack power boosts for hand grenades and other throwable weapons when using the “Throwing+” skill.",
       "ps5ProOnly": false
      },
      {
       "text": "Extended the duration of the “Strategist” skill and increased the percentage of attack power boosts.",
       "ps5ProOnly": false
      }
     ]
    }
   ],
