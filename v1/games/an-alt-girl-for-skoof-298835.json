  {
   "id": "an-alt-girl-for-skoof-298835@dayone-2026-07-30",
   "gameId": "an-alt-girl-for-skoof-298835",
   "displayName": "Day one patch",
   "kind": "dayOne",
   "kindBasis": "studio",
   "announcedAt": "2026-07-30T19:01:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We unexpectedly ran into a number of conflicts between the different DLCs. There are three of them now, which makes things a bit more complicated—especially since one of them is free.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Today's fixes include",
     "items": [
      {
       "text": "Fixed a bug after the line \"Choose what we're going to watch\" in DLC 3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed missing audio during the replay scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Skoof's \"WHAT IS THIS?\" replay line not playing any voice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the silent click sound on the \"...but there's a catch\" menu option.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed audio issues affecting all of Anfisa's lines in the factory scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We sincerely apologize for the inconvenience and appreciate your patience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We'll continue hunting down the remaining issues tomorrow and do our best to fix those as well!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
