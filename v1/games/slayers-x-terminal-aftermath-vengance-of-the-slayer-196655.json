  {
   "id": "slayers-x-terminal-aftermath-vengance-of-the-slayer-196655@major-2023-06-13",
   "gameId": "slayers-x-terminal-aftermath-vengance-of-the-slayer-196655",
   "displayName": "🔥🔥 the first update for slayers X is here 🔥🔥",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-13T14:56:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "whats up its zane. I just wanted to come on here and tell u that your awesome for playing my game. unlike those crybaby psykos bwl…..anyway I added some cool new features to slayers and I fixed some of the bugs the psyko wusses planted in their. Ive broken it down below…. thats it for now but theres more coming to slayers so stayed tuned….",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "new feature: Level Select screen u get after beating the game, start a new game to access it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new feature: see total map secrets, enemy, & playtime on the map screen (M by default)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "new feature: frame rate controls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "improved difficulty balancing on InZane & Im Awesome difficulties",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "map 5 quicker hackblood recharge so u can get a hang of using it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed keybind bugs",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "fix to culling bugs (disappearing level) on map 7",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "added bong back under mevins desk... oops accidentally deleted it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "saving/loading fixes for boss and arena fights. (wont retro actively fix things.... u have to restart a map if you have a broken save)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "many other small fixes: were working on other fixes and graphics for ultra wide mode in the next patch.... and some other things hehehaahahahaa",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
