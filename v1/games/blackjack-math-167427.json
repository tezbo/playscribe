    {
     "title": "Changes",
     "items": [
      {
       "text": "In this update we fixed some of the issues on the previous update and also added an exciting new feature: Achievements, that's unlocked based on your progress on the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you already played the game and completed some of the levels you can just open the game and the achievements applied to your progress will be unlocked immediately.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The preferences you choose on the menu, such as fullscreen or window mode, audio on or off are now saved, we hope this can give you a smoother experience while playing this game.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
