  {
   "id": "demoniaca-everlasting-night-121311@1.1",
   "gameId": "demoniaca-everlasting-night-121311",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2019-10-12T08:51:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Grand news! Patch 1.1 just aired! We have fixed numerous issues based on a feedback we got from you guys! Thank you! Stay tuned for even more exciting updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "KEY MAPPING! Players can now configurate control scheme!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved main character's movement, controls are now more responsive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the achievement bug, players can now get 100% of achievements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Anti-cheat system improved, players can now load save data from different steam accounts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unique items had been re-balanced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved English localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved game stability and an overall performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Minor bug fixes and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
