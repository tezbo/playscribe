  {
   "id": "demoniaca-everlasting-night-121311@1.2",
   "gameId": "demoniaca-everlasting-night-121311",
   "displayName": "Patch 1.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2019-10-28T17:08:39.000Z",
   "notes": [
    {
     "title": "HALLOWEEN UPDATE",
     "items": [
      {
       "text": "Halloween has fallen on the Tower of Babel, are you ready to challenge the darkness?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are happy to announce that Demoniaca got a new and terrifying free expansion. Fabulous Pumpkin, the new boss, has returned to the tower, meaning that it's time for more fearsome bloodshed. But it won't be that easy - no one knows where Pumpkin is hiding. You will have to face trials and tests first before you finally fight her.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The expansion contains 2 hours of gameplay, 3 new explorable Halloween-themed areas, several puzzles, a special item and new scary/sexy boss!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "How to start the challenge?",
     "items": [
      {
       "text": "Three new chests have appeared on the map. You will need to find and destroy them in order to activate secret portals that lead to new areas. Solve the puzzles in each of them and use clues to locate Pumpkin’s lair!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Requirements",
     "items": [
      {
       "text": "This content will be accessible for players who have got through the first half of the game. At the end of this event a new special secret item will be gifted to those who completed the challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Good hunting!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
