   "notes": [
    {
     "title": "Merry Christmas and a Happy New Year!",
     "items": [
      {
       "text": "It's high time for yours just another Christmas gift! We just aired a patch with a brand new game mode. Think of it as a Story difficulty setting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "It's intended for players who want to to have more relaxing experience with a focus on the story and the world of Demoniaca.",
