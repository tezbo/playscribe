      },
      {
       "text": "Improved guard system;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved performance;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Minor bugfixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
