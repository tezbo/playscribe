 "releases": [
  {
   "id": "towa-and-the-guardians-of-the-sacred-tree-347657@major-2025-12-03",
   "gameId": "towa-and-the-guardians-of-the-sacred-tree-347657",
   "displayName": "Notice Regarding Release of Product Version Update Data",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-03T05:32:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing \"Towa and the Guardians of the Sacred Tree.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To enhance gameplay comfort and address certain issues, we have begun distributing an update file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We kindly ask that you apply the latest update file before continuing your enjoyment of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■Main Update Contents",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "【Game Balance Adjustments】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "♦Change Difficulty",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・When selecting Story Mode, the Divine Blessing: (player damage reduction rate) has been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The reduction rate starts at 20% on the first playthrough and is increased by 20% each time you retry a dungeon, up to a maximum of 80%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "♦ Dungeons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The number of enemies spawning per room has been partially reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The number of rooms generated per dungeon has been partially reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・We have slightly reduced the attack, action speed, and HP of enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The probability of obtaining ore coins during medium dungeon runs has been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The effects gained from Receive a Grace have been partially increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The effects gained from eating have been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The action range for Tsurugi and Kagura has been expanded.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The correction distance for Tsurugi and Kagura's attack angles has been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The reduction in attack when Tsurugi and Kagura's HP is 0 has been mitigated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the invincibility duration when Kagura Spells activate.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added invincibility frames to Kagura's Dash during auto-follow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "♦Shinju Village",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have partially reduced the amount of ore coins required to unlock Kagura Spells in the Eternal Flame Dojo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The rate of stat increases during attributes at \"Eternal Flame Dojo\" has been increased.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some items available for purchase and the required amount of ore coins for exchange at \"Shochikubai Emporium\" have been changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The amount of ore required for construction at Otherworld Carpentry has been partially reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have partially increased the effects gained from buildings at Otherworld Carpentry.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "♦ Endgame Content",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed the maximum increase rates for enemy Attack and HP in the dungeon \"Cave of Eternal Suffering\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Changed the maximum HP increase for enemies in the dungeon \"Cave of Eternal Suffering\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Additional Implementations]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "♦Dungeons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Partially modified the default controller button layout and key mapping during dungeon play.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "※To apply these settings, go to \"Options Screen > Button Settings > Restore Default Settings\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added display of cumulative damage and damage per second during Nekomushi attacks in the Character Select Room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added displays for the number of rooms remaining for the effects of meals and hot springs on the dungeon medium screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "♦Shinju Village",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a skip option to the Forge Sword tutorial event with \"Blacksmith\" during the first playthrough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a notification in \"Tokiyomi Shrine\" when there is a not seen event upon advancing the era.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a display showing Unseen Events on the Shinju Village Medium screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "・Added tips to the medium loading screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "【Event Scene Adjustments】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Shortened portions of the Tutorial event.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "【Bug Fixes】",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the sound effect issue during mouse control in the \"Blacksmith Kien\" event on the Steam version.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Fixed sound effects on the dungeon result screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other improvements include enhanced stability and usability for some features.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your continued support for \"Towa and the Guardians of the Sacred Tree\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
