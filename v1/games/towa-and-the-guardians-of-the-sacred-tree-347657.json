  {
   "id": "towa-and-the-guardians-of-the-sacred-tree-347657@major-2025-11-14",
   "gameId": "towa-and-the-guardians-of-the-sacred-tree-347657",
   "displayName": "Future Patch Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-14T09:31:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for your continued support on \"Towa and the Guardians of the Sacred Tree.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are preparing a free update with adjustments to make the game more enjoyable, based on the input we have received from the community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In this update, we are focusing specifically on the game's difficulty, and plan to make the following adjustments:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusting enemy health and spawn rates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimizing the amount of in-game currency acquired and various upgrade costs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Easing story progression by raising the initial and maximum values of protection in story mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Detailed release date will be announced later.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
