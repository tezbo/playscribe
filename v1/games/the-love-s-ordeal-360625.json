      },
      {
       "text": "July 20 Update Log",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Optimized the display of character goodwill.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
