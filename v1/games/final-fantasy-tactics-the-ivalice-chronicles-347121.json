  {
   "id": "final-fantasy-tactics-the-ivalice-chronicles-347121@1.4.0",
   "gameId": "final-fantasy-tactics-the-ivalice-chronicles-347121",
   "displayName": "Update 1.4.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-17T07:07:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The game will be updated to version 1.4.0.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "General",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The version number will now be displayed in the bottom right of the version selection screen and the enhanced version title screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Enhanced",
     "items": [
      {
       "text": "An issue affecting the Japanese voice and text for the ability Northswain's Strike has been resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue that prevented the Akademy report \"Master of All Trades\" from being completed under circumstances has been resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the event that the issue described above has prevented the completion of \"Master of All Trades,\" the check to confirm whether the conditions have been fulfilled will be performed again after loading the saved data and accessing the in-game main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor text issues have been resolved in all languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Certain sound effects have been adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Overall stability has been improved. Other minor issues have been resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue wherein the character name \"\"Helvynya\"\" was incorrectly displayed as \"\"Holy\"\" has now been resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In the event that a unit recruited under the name \"\"Holy\"\" exists in your save data, one of the following will occur:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have changed the unit's name, the newly assigned name will remain unchanged.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have not changed the unit's name, it will now be displayed as \"\"Helvynya\"\" instead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Unit names can be changed at the warriors' guild.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
