   "id": "final-fantasy-tactics-the-ivalice-chronicles-347121@1.5.2",
   "gameId": "final-fantasy-tactics-the-ivalice-chronicles-347121",
   "displayName": "Update 1.5.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-23T04:37:18.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The following issues affecting mouse controls have been addressed:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "On the Equipment and Abilities screen, clicking equipment or abilities on the second row or below would incorrectly select and equip the item at the top of the list.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The details window would not automatically update when moving the mouse cursor over equipment or abilities.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We apologize for any inconvenience these issues may have caused and thank you for your patience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
