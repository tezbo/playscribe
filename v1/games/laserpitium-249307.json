   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "What's new ?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "STEAM API support (the game pauses while the overlay is displayed).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The number of enemies has been reduced in \"Easy\" and \"Very Easy\" modes (most enemies that come from the left of the screen are no longer present).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved game colorimetry (more natural colors).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a non-exclusive full-screen mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reduced the intensity of screen shake.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Music tracks that consist of an intro and a loop now flow seamlessly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game automatically pauses when a controller is disconnected (if playing with a controller).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed text display issues that could display \"?\" instead of spaces.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Global sound volume defaulted to 50%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added the IRVING HEAT logo (music tracks).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Performance optimizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
