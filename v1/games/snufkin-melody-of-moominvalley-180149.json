  {
   "id": "snufkin-melody-of-moominvalley-180149@patch-2024-06-13",
   "gameId": "snufkin-melody-of-moominvalley-180149",
   "displayName": "✨New Patch Available Now✨",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-06-13T11:37:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear travelers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're happy to let you know that the new patch is now available! We hope that with these fixes you will continue your wholesome journey through Moominvalley without those mischievous bugs. We'd like to thank you once again for your continuous support and your dedication to restoring the valley to its natural beauty💚",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the issue with the audio not playing properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the critical issue with the Barometer scene freezing and preventing progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reworked the save system to prevent various fail states throughout the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Implemented improvements for cutscene transitions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "If you encounter other technical issues, please report them here - this is the quickest way for the dev team to have a look.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "/ Snufkin Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
