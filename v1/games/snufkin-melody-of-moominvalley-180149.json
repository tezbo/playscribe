  {
   "id": "snufkin-melody-of-moominvalley-180149@patch-2024-05-07",
   "gameId": "snufkin-melody-of-moominvalley-180149",
   "displayName": "✨New Patch Available✨",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-05-07T11:32:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear wanderers, we have prepared a few additional fixes to make sure any travels through Moominvalley are as smooth and enjoyable as possible. We in the development team want to thank you all so much once again for your continued support and kind words whilst restoring the valley to its natural beauty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch notes",
     "items": [
      {
       "text": "The game is verified for Steam Deck!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improved performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed the issue with Cedric being invisible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue with players getting stuck on a stone with the woodies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue with players getting stuck on the wrong side of the boulder.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue with players getting stuck behind the stone above Ninny.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor localization fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any other issues, please reach out to us via the Raw Fury website’s “Support” section.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "/ Snufkin Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
