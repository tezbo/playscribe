   "id": "snufkin-melody-of-moominvalley-180149@patch-2025-02-05",
   "gameId": "snufkin-melody-of-moominvalley-180149",
   "displayName": "New Patch Available Now!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-02-05T12:27:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Travelers, we're letting you know that we've implemented more fixes to make your adventures smoother! Good luck on your journey💖",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Added the base game achievements localization to in-game languages.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Implemented N. Sami LQA fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. For consoles - added banners and patched with minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Don’t forget to follow us on our social channels not to miss any updates: ✨Twitter (X), Facebook, Instagram, TikTok and Discord.✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Subscribe to our 🍃whimsical newsletter🍃",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
