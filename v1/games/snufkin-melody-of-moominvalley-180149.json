  {
   "id": "snufkin-melody-of-moominvalley-180149@post-2024-05-14",
   "gameId": "snufkin-melody-of-moominvalley-180149",
   "displayName": "✨Cutscenes Quick Fix Available✨",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-05-14T11:36:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear wanderers, we have fixed an issue with cutscene videos not playing properly causing the game to freeze. We hope that you can quickly get back at restoring the valley to its natural beauty with this new fix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you encounter any other issues, please reach out to us via the Raw Fury website’s “Support” section.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "/ Snufkin Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
