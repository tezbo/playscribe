  {
   "id": "snufkin-melody-of-moominvalley-180149@post-2024-12-18",
   "gameId": "snufkin-melody-of-moominvalley-180149",
   "displayName": "Small Patch Notes",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-12-18T16:12:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Travellers, we have fixed a series of issues we’ve found, thank you all for helping us identify them! Keep adventuring 💕 (っ˘ω˘ς )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue of getting stuck while selecting Yes/No too quickly in Snufkin: Melody of Moominvalley",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in the Fuddler’s Courtship DLC locking the player from progressing after an Yes/No interaction during the collecting buttons quest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where two frogs would appear wrongly in the Fuddler’s Courtship DLC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the in-game cursor resetting to default",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with the Firefly cutscene in the Fuddler's Courtship DLC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a broken Finnish line in the Fudller's Courtship DLC",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
