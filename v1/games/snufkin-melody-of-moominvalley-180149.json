  {
   "id": "snufkin-melody-of-moominvalley-180149@post-2024-03-14",
   "gameId": "snufkin-melody-of-moominvalley-180149",
   "displayName": "🌿Patch Notes🌿",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-03-14T10:48:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear travelers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're happy to let you know that we've released a patch to make your journeys even smoother and more enjoyable✨ See the notes below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor spoiler: Players will now be able to continue from right before the point-of-no-return when you have completed the game. This means you can now choose to explore Moominvalley as if before the end of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the issue where players were unable to change their game resolution.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue where Little My would get stuck at the entrance of a cave.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue with the save files, where the performance of the game would significantly drop and sometimes result in a crash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue with dancing police officers (while we love dancing, it was not adhering to the rules the police officers are overseeing)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
