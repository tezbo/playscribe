  },
  {
   "id": "tomba-2-the-evil-swine-return-special-edition-377890@major-2025-12-19",
   "gameId": "tomba-2-the-evil-swine-return-special-edition-377890",
   "displayName": "Update 12/19/25",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-19T14:09:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for your support of Tomba! 2: The Evil Swine Return Special Edition. The following updates have been made:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added US soundtrack to the game. Players can swap game versions by pressing left or right in the main menu. Note: save files for the JP soundtrack versions do not carry over to the US soundtrack version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Modified Game Over screen to have a 'Continue' option instead of resetting on deaths. Upon game completion, the option will be to reset.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Tomba 1 quests. They now appear when they should instead of right away. Santa's helpers no longer get in his personal space.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaked file select screen to default the option to 'Yes' when choosing to save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed analog stick being unresponsive after saving, loading, and rewind.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with fullscreen rendering at certain resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed further minor issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A huge special thanks to the passionate fans in the Tomba Club, who helped beta test the update. We appreciate you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
