   "announcedAt": "2025-12-30T20:01:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for your support of Tomba! 2: The Evil Swine Return Special Edition. The following updates have been made:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed graphical screen transition issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Spanish controller HTP screen being incorrect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where if the Japanese language was set as the default locale, loading into the game would result in a black screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Restored in-game options to the Options menu. This includes the Voices toggle, message speed, and BGM and SFX volume levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
