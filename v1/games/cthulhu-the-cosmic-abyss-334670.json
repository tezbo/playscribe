  {
   "id": "cthulhu-the-cosmic-abyss-334670@post-2026-05-13",
   "gameId": "cthulhu-the-cosmic-abyss-334670",
   "displayName": "PATCH NOTE - 13/05",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-05-13T12:53:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45528910/f9ff07d122dd690b91e247b520c7987006e3209e.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello Agents,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update is now live for Cthulhu: The Cosmic Abyss. Our focus with this patch has been to address a range of remaining issues to the overall experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We want to thank you for joining us on this journey into the abyss. Your feedback has been instrumental.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "Fixed a sonar VFX issue when the player used it the first time after reloading a save.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue that prevented players from using the jump feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a MyNacon issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed localization issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "The Excavation",
     "items": [
      {
       "text": "Fixed an issue where the player could get stuck between crates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the player could get stuck at the end of the water current in the maze.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "The Other World",
     "items": [
      {
       "text": "Fixed an issue where the water failed to render when navigating to the bottom edge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "The Citadel",
     "items": [
      {
       "text": "Fixed an issue that allowed players to walk through the floor at a specific location.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "The Last Door",
     "items": [
      {
       "text": "Fixed an issue where the Pigment sonar frequency didn’t create snapshot clues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the main stairs could disappear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the chest in the secret lodge could be opened with more sonar frequencies than expected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the star of shamash disappeared if a player used the respawn feature during a Remembrance of a Memorial.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue related to inconsistent glyph behavior.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the player could get out of bounds behind the stairs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a missing collision on a wall in “Reconstruction: Possibilities” room.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Share Your Experience",
     "items": [
      {
       "text": "Now that this update is live, we would be incredibly grateful if you could share your thoughts on the game. If you've enjoyed your journey into the mystery, please consider leaving a review on Steam. Your perspective helps others decide whether to take the plunge!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
