  {
   "id": "cthulhu-the-cosmic-abyss-334670@post-2026-04-30",
   "gameId": "cthulhu-the-cosmic-abyss-334670",
   "displayName": "PATCH NOTE - 30/04",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2026-04-30T13:04:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45528910/d23e266001c9fc70b70234918176bd358c922b22.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are back with another patch, packed with fixes for issues you've helped us identify. Your detailed reports are essential to this process, and we thank you for your continued support as we work to improve the game. Here are the full details:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "All Chapters",
     "items": [
      {
       "text": "Fixed some indications left regarding the presence of the shards even with DLCs deactivated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "The Excavation",
     "items": [
      {
       "text": "Fixed an issue where the player could get stuck in upper parts of the station due to the water currents.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the player could get stuck at the end of the water current in the maze.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "The Temple",
     "items": [
      {
       "text": "Fixed wall textures during the entrance of The Temple.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Selina hair physics issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "The Other World",
     "items": [
      {
       "text": "Fixed an issue where the player could climb over a stone pillar due to missing collision.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "The Last Door",
     "items": [
      {
       "text": "Fixed an issue where the Electrum crystals had the location tag \"Reconstruction: The Possibilities\" instead of \"Mausoleum of the Engineer\" in the Vault.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed most cases regarding the spawns and falls out of bounds indefinitely issue. We are still working on the remaining edge cases.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Star of Shamash was unable to be placed correctly on the podium.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "The Heart",
     "items": [
      {
       "text": "Fixed an issue where the light on Elsa's hair was flickering during the pre-ending cinematic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the music played on the unfolding bridge doesn't always trigger.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue when opening the pause menu at certain timings could cause the Final Choice to hang on a black screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
