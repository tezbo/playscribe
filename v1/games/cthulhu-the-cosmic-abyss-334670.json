  {
   "id": "cthulhu-the-cosmic-abyss-334670@post-2026-04-24",
   "gameId": "cthulhu-the-cosmic-abyss-334670",
   "displayName": "PATCH NOTE - 24/04",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2026-04-24T13:51:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45528910/915a7c62f1c85e424f87199f6565532070e78be2.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "A new patch is now live for PC players! We've been hard at work on another round of fixes based on your valuable feedback. Thank you for your continued support as we work to improve the game 🙏",
     "items": [
      {
       "text": "All Chapters",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "(Steam Only) Fixed AZERTY/QWERTY keyboard layout detection relative to system keyboard language (this should now also handle keyboard language swapping mid-game)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed performance issue related to evolution upgrade perks",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed scrolling in single page tutorials and add bottom spacer",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Excavation",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "(Steam Only) Fixed partial loss of controls happening on saves reloaded from the demo version",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "(Steam Only) Fixed dialogue trigger and station reboot issue when reloading a save from the demo onto the final version",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where the way out of Q2 through the water current could be hard to understand",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed Anastasia's card not returning to its last saved location after reloading in the Scientific Module",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where the use of the Respawn feature right after rebooting the station could prevent Andrew Marsh’s video log from playing",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where the use of the Respawn feature underwater, on the way to the maze, did not reload the station assets properly",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed helmet opening animation replaying after coming back into the station and using the Respawn feature",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Temple",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where the use of the Respawn feature after crossing the west or east wing would cause the lighting and water to be removed from the main part of the temple",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Other World",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed the remaining glow of Q4’s shard in the Crater area even with the DLCs deactivated",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The Last Door",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some clue names not properly revealed without the observation of the “Stele of the Overseers” even if the player had unlocked the Yith translation in The Citadel",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
