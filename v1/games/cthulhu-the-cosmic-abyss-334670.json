  {
   "id": "cthulhu-the-cosmic-abyss-334670@post-2026-04-21",
   "gameId": "cthulhu-the-cosmic-abyss-334670",
   "displayName": "PATCH NOTE - 21/04",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-04-21T14:46:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45528910/65ff33aa2913e1c7378c680848c337051975e1e1.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Our first post-launch patch is now LIVE!",
     "items": [
      {
       "text": "Since the launch of Cthulhu: The Cosmic Abyss, we have been listening closely to all your feedback. Your experiences, reports, and suggestions are incredibly valuable, and our team has been working tirelessly to address the issues you've brought to our attention.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update focuses on several key fixes that aim to improve your experience in the abyss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed fast item switching and placement that could cause it to disappear. This issue can cause loosing items such as stones in The Awakening.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed DLC shards CTO that remained visible even without the DLCs activated",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed edge case where a tutorial prompt could remain on screen forever (The Excavation)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed tutorial flow on hydrogen tanks that could sometimes be hard to understand (The Excavation)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed DLC shard in crater area that was still visible with the DLCs deactivated (The Nightmare World)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed collision that could hinder players movements (The Last Door)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "This is just the first step. We are continuing to work on further improvements and actively working on the list of known issues we've been sharing previously. We will share more news soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you once again for your incredible support, your patience, and for taking the time to share your feedback with us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Big Bad Wolf and Nacon Team.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
