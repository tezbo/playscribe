  },
  {
   "id": "papetura-121567@major-2021-08-05",
   "gameId": "papetura-121567",
   "displayName": "Papetura Update Is Here!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-08-05T16:03:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For last months I've been working on Papetura major update, and it's finally here!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The main goal was to move the game to the latest version of the engine, and by doing this, resolve many issues with game not running properly. This was also an opportunity to improve many things in Papetura, from visuals to audio, I went over everything one more time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here it is, the changelog",
     "items": [
      {
       "text": "Game engine update - fixed issue with Citrix drivers collision, and possibility to more precisely diagnose crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved/fixed some visuals, animations and sounds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Image is more crisp, reduced chromatic aberration a little bit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added characters reactions to projectile hits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased player walk speed over longer distances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Monster chase puzzle is getting easier with more tries.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dropped support for all 32bit MacOS (due to engine update)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor bugs & fixes: Have a good time playing or replaying the game!: <3: PS: If you encounter some game crashes after the update, please try to reinstall the game. Steam updater may unfortunately break some things..",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
