  {
   "id": "one-hand-clapping-103408@0.12.21",
   "gameId": "one-hand-clapping-103408",
   "displayName": "Update 0.12.21",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-07-02T08:20:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Reworked resonant rock section (the one with the flying bell)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Rebalanced wind currents section",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Rebalanced sandstorm section",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Tweaked voice recording mechanics on flowers in the beginning of Fugue Forest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved audio analysis",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Polished art in several places",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added jump buffering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed snapping to one-way platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with getting stuck in tight spaces",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Duet Desert hug drop-off bug where you would fall through the ground",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed animation walk loop issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Implemented a possible fix to prevent a rare crash in Duet Desert",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Please note that this update will not be able to load your previous save file. You can still select all previously unlocked checkpoints directly in the checkpoints menu to get very close to where you stopped last time. If you didn’t know, you can press left and right in the checkpoint menu to cycle through checkpoints inside the different biomes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
