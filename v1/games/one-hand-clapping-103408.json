  {
   "id": "one-hand-clapping-103408@0.12.48",
   "gameId": "one-hand-clapping-103408",
   "displayName": "Update 0.12.48",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-08-25T13:10:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi, friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re happy to release the second half of Fugue Forest as part of version 0.12.48, the last early access content update before the game’s full release. The following is what the update is focused on:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Descend into the dark second half of Fugue Forest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Improved art in many of the previous areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Improved audio analysis",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Added voice visualizer to help find any microphone related issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For more details and a personal word from the developers themselves visit: https://www.baddreamgames.com/devlog/early-access-second-update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
