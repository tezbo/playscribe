  {
   "id": "sunset-motel-282298@major-2026-10-15",
   "gameId": "sunset-motel-282298",
   "displayName": "❄️ Mountain Retreat – Development Update!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-15T12:44:45.000Z",
   "notes": [
    {
     "title": "Hello, Motel Owners! 👋",
     "items": [
      {
       "text": "We've been working hard on Sunset Motel: Mountain Retreat, and it's time to share some exciting progress!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "From abandoned cabins to cozy mountain getaways, here's a sneak peek at what's coming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "##",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🏡 From Ruins to Cozy Cabins!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dirty rooms, broken floors, damaged walls... There's a lot to fix!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With new renovation mechanics, you'll clean, repair, repaint, and completely transform abandoned cabins into beautiful mountain retreats.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "❄️ New Winter Challenges!",
     "items": [
      {
       "text": "Life in the mountains isn't always easy!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Clear snow with your snowblower, prepare your resort for harsh weather, and face unexpected challenges as you build your winter business.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🔨 New Building & Renovation Mechanics!",
     "items": [
      {
       "text": "We're making cabin restoration more interactive than ever!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "From replacing damaged floors and repairing roofs to installing new windows, painting walls, and cleaning every corner, each step brings your mountain cabins closer to perfection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "And this is just the beginning! More mechanics, winter activities, and exciting surprises are on the way!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Everything shown is still a work in progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Thank you for your continued support! ❤️",
     "items": [
      {
       "text": "– EFKEY Studios",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
