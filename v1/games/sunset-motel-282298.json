  {
   "id": "sunset-motel-282298@4",
   "gameId": "sunset-motel-282298",
   "displayName": "Hotfix 4",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2025-05-09T13:58:28.000Z",
   "notes": [
    {
     "title": "Welcome back to Sunset Motel, dear guests! 🌅",
     "items": [
      {
       "text": "We've rolled out a quick hotfix update to improve your stay and address a few reported issues:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🚗 Fixed the \"Car Washer!\" achievement – it should now unlock properly when completing the car wash task.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🗣️ Added a new \"AI VOICE OFF\" option to the gameplay settings. If you'd prefer a quieter stay, you can now disable the AI voice anytime you like.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thank you for your continued support and feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
