  {
   "id": "sunset-motel-282298@major-2026-08-06",
   "gameId": "sunset-motel-282298",
   "displayName": "🎨 Decoration, Furniture Snap & Buddy Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-06T11:31:19.000Z",
   "notes": [
    {
     "title": "🏨 New Update is Here!",
     "items": [
      {
       "text": "We've been working on some highly requested features, and this update brings a lot of new content to Sunset Motel!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🎨 Brand-New Decoration System",
     "items": [
      {
       "text": "A new Decoration app has been added to the tablet!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Customize your motel exactly the way you want",
     "items": [
      {
       "text": "🛎️ Reception customization (Desk, Floor, Walls, Carpet, Waiting Area & Ceiling)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🚪 Room customization (Doors & Curtains)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🏠 Every room can now have its own unique style.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📦 100+ new decorations have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🧲 Furniture Snap System",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Decorating is now much easier!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Furniture now snaps into place, making it faster and easier to create clean, organized rooms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🐕 Meet Buddy!",
     "items": [
      {
       "text": "A new furry friend has arrived at the motel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Buddy freely roams around the motel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Walks, runs and wanders with random behaviors.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If Buddy gets hungry, he'll come to eat on his own.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "❤️ Increase Buddy's friendship by taking care of him.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thank you for all your feedback and support! ❤️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More updates are already in development.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
