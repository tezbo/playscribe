  {
   "id": "sunset-motel-282298@major-2025-10-28",
   "gameId": "sunset-motel-282298",
   "displayName": "Caravan Update Releases Nov 3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-28T10:49:40.000Z",
   "notes": [
    {
     "title": "🌅 Hello Motel family!",
     "items": [
      {
       "text": "The Caravan Update — launching November 3rd. 🚐✨",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After extensive testing, fine-tuning, and a lot of care, we’re ready to refresh your caravans inside and out bring a magical open-air cinema to the motel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Highlights",
     "items": [
      {
       "text": "Interior design: brand-new furniture, floors and décor options so each caravan can have its own personality.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Exterior restoration: fix rusted panels, cracked windows and faded paint—bring your caravan back to life.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Open-air cinema: screen films under the stars and style the viewing area to match your vibe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Our team has rigorously tested performance and mechanics to make sure everything runs smoothly. Thanks for your patience and support—mark November 3rd on your calendar. See you under the stars. 🎬",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The Sunset Motel Team 💛",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
   "digest": {
    "new": 5,
