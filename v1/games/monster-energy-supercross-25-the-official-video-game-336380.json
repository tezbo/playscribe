  {
   "id": "monster-energy-supercross-25-the-official-video-game-336380@patch-2025-06-04",
   "gameId": "monster-energy-supercross-25-the-official-video-game-336380",
   "displayName": "New patch live!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-04T09:17:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Updated Pittsburgh layout after the SX IRL event",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated Denver layout after the SX IRL event",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated Salt Lake City layout after the SX IRL event",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Implemented the Dynamic Cornering Camera toggle: you can now toggle on/off the default dynamic camera (or \"look to apex\" system). Go to Game Experience to adjust this feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added active collisions in Ranked Seasons matched",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Implemented track voting in private lobbies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Untethered transmission selection from game experience: the transmission selection will now stand out from the default game experience levels. This will impact online private lobbies too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased Ranked Races penalities: addressed an issue where players exploited a too small fee to pay withdrawing from a ranked match. In addition, in 2 people matches, the withdrawal now will still shut down the match but who will leave will incur in a harsher penalty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated the default community UGC filter: the default page now will display the community creations first, facilitating the browsing of the UGC content list.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Implemented film grain option: go to Settings → Image Configuration to activate it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Revisited riders' power rankings to match IRL standings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor fixes and polishing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved stability and performance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
