  {
   "id": "monster-energy-supercross-25-the-official-video-game-336380@patch-2025-07-01",
   "gameId": "monster-energy-supercross-25-the-official-video-game-336380",
   "displayName": "New patch live!",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-07-01T13:10:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45537813/5a9d80ccead64e6cdd913c0e1138ce984e532291.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rider Animations Revamped: the new physics system put costraints on the smoothness the rider animations could reach. The rider animations should feel faster and smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Type a rider body shape : we increased the \"fitted t-shirt\" feeling of the rider suit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased mid-air movement speed: we slightly increased the speed at which you can perform mid-air whips/scrubs/generic movements, keeping it compatible with our physics system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where in Pittsburgh and Detroit tracks few soft barriers and a group of mechanics disappeared from the track leaving holes on the runway edge",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where if you exit the online hub the focus selection appeared to be on the split screen mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where if you perform multiple actions on all the game editor randomly some icons disappeared making the UI not legible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Riders power ranking revisited to match IRL standings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor fixes and polishing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved stability and performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
