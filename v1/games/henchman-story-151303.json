  {
   "id": "henchman-story-151303@1.1",
   "gameId": "henchman-story-151303",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-10-24T18:35:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings to all henchman, heroes and villains! Thank you all so much for the wonderful reception that you've given to Henchman Story since our launch last week. After monitoring player reviews, bug reports and testing the game internally, we've given the green light to Henchman Story's first ever patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "UI Updates",
     "items": [
      {
       "text": "Auto-Play has been moved from the Options Menu to the in-game Quick Menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Auto-Play Time has been added to the Options Menu. Increasing or decreasing this changes how long the pause is between each text box while Auto-Play is active.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Text Speed has been added to the Options Menu. This lets you adjust how fast dialogue and narration appears in the text box. Setting it to maximum lets them appear instantly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Workaround for a song that was not being properly unlocked in the Music Room (Baby, It's Showtime!). This song now unlocks when players complete 1 playthrough of the game. If you have already completed a playthrough, this will work retroactively, meaning you do not have to complete the game again to unlock the song.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed two instances where Madame Scorpion's VO repeated itself",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a line where the first part of Stan's VO was missing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an instance of the wrong VO file playing for one of Stan's lines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various typo and punctuation fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a Music Room song icon that wasn't highlighted when the song was playing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If you encounter any issues with the update or have any feedback to share, please use our Bug Report Form and join us on the official Silken Sail Discord!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
