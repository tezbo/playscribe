  {
   "id": "plastomorphosis-259123@1.2",
   "gameId": "plastomorphosis-259123",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-07-26T14:14:27.000Z",
   "notes": [
    {
     "title": "PLASTOMORPHOSIS Patch Notes",
     "items": [
      {
       "text": "Version 1.2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added Turkish language localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased the player's movement speed and slightly improved auto-aim range and responsiveness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Rebalanced combat by reducing the health of most enemies, with some enemies (and moving saws!) also dealing less damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted the Warped Shadow enemy:it now teleports a much shorter distance after being hit, greatly reducing the chance of it suddenly reappearing next to the player from far away.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated the Pixelation visual effect. It is now less applied across all settings and provides a bit cleaner image on 'Very Low' while preserving the retro aesthetic. (Options → Visuals → Pixelation Effect).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
