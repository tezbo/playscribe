  {
   "id": "kuroi-tsubasa-189825@1.1",
   "gameId": "kuroi-tsubasa-189825",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-04-12T09:41:16.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for over 3000 downloads! Are you all having fun with the game? For us at BWG this is a huge success, and we hope this excitement can be shared with you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we published a small patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added a disclaimer at the start of the game that the Quickmenu can be accessed by hovering the mouse cursor at the top of the screen; and also that it can be shown permanently via the settings menu",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "added an optional darker textbox that can be activated via the settings menu for higher contrast",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added a brand new CG for the Yamamii arc",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "fixed various typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Did you know that the textbox opacity can be adjusted freely in the settings as well? If you have trouble reading the text on brighter backgrounds, please do check that out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We wish you all a wonderful day~",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "BattleProgrammer, lead dev",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
