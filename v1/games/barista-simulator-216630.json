  {
   "id": "barista-simulator-216630@0.5.1",
   "gameId": "barista-simulator-216630",
   "displayName": "Hotfix 0.5.1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2023-01-15T19:28:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello dear coffee enthusiasts,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "as the nature of an early access game, we encountered many bugs on the release version of the game. We strive for a better gameplay and user experience. As a fast response for crucial bugs we are releasing a hotfix. We hope most of the bugs some players encounter will be fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes",
     "items": [
      {
       "text": "Controller issues fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Pause function added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resolution can be changed now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Machine optimisations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ui bugs fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can empty grinder content to sink",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The bug that causes power to cup after a bill payment solved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The bug that causes container gfx to disappear after game load solved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New customer names",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
