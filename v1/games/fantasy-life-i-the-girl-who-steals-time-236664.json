   "gameId": "fantasy-life-i-the-girl-who-steals-time-236664",
   "displayName": "An update is coming mid-June!　See Even Further Across the Field 👓",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-06-09T09:55:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "See Even Further Across the Field 👓",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An update is coming mid-June!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You asked, we listened. We’re adding a camera adjustment feature that lets you see much farther across the map than before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Spot towers easily while exploring or track down that monster you’re after.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy a smoother, more exploration-friendly Fantasy Life!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45495104/b1ebad47e2934a4b6cfd518e23b60968fb3cb72d.png\"][img src=\"{STEAM_CLAN_IMAGE}/45495104/4c3ed743b4a0a4b16cb0ca2b57b70aa4103bf493.png\"]",
