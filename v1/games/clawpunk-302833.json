   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey CLAWPUNKS!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The following fixes have just gone live",
     "items": [
      {
       "text": "Some VFX assets have been polished when enemies are killed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where completing 50 stages as a particular cat was not unlocking their respective card.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a more specific issue where completing 50 stages as Benny was not unlocking his respective card.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The rotten carcasses in the Sewers no longer spawn maggots infinitely.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with enemy spawning in the Sewers that impacted ranks for stages and the overall zone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Style over Fur and collecting all card achievements should now be unlocking as intended.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thanks for your support - keep letting us know what you think of the game over on Discord!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The Clawpunk Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
