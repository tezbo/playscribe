  {
   "id": "assassins-creed-unity@5",
   "gameId": "assassins-creed-unity",
   "displayName": "Patch 5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2015-02-20T13:56:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 5 for Assassin’s Creed Unity is rolling out today on PC. The patch should resolve numerous reported issues including the ‘Find Leon’ objective not showing up and the relocking of weapon and equipment rewards after they’ve been earned.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Additionally, we will be unlocking all content exclusive to Initiates and the Companion App, including both blue and gold chests. Players can still progress on the Companion App, they just will no longer be required to complete content to unlock in-game chests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PC-specific fixes that address performance, connectivity and general stability issues will be available when the PC update releases today.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "For patch notes please visit this forum post.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Live Updates Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
