       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed issues with textures on NPCs",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed black texture issues on MSAA-4x, MSAA-8x and TXAA",
       "ps5ProOnly": false,
