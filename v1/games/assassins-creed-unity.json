       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Right Control now can be assigned as a hotkey",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Minor UI fixes",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
