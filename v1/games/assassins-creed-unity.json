  {
   "id": "assassins-creed-unity@4",
   "gameId": "assassins-creed-unity",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2014-12-12T02:14:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As part of our ongoing efforts to provide the best experience for our players, we will be releasing Patch 4 for Assassin’s Creed Unity today for Steam. This patch is mainly focused on alleviating performance issues and improving the overall experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Part of the team’s effort to enhance frame rate for players involves replacing and updating portions of the Paris city map where we are seeing issues. This explains the large size of this title update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch 4 delivers a variety fixes including",
     "items": [
      {
       "text": "Performance & Stability: Frame rate drops, game crashes, lost progression",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Gameplay: Navigation, lock picking chests",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Online: Connectivity, matchmaking, companion app",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Stability, Performance and Save Game",
     "items": [
      {
       "text": "Fixed numerous random crashes both on Campaign and Coop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Implemented multiple optimizations and fixes to improve overall performance",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed save issue caused by the companion app on the main menu (loss of data)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed save issue caused by contacts list (crash occurring). Users should now have access to save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Gameplay (navigation, fight, stealth)",
     "items": [
      {
       "text": "Fixed various navigation issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with lock picking chests",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed additional haystack issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Character, AI and Crowd",
     "items": [
      {
       "text": "Fixed various character, crowd station and NPC issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Online, Matchmaking, Connectivity and Replication",
     "items": [
      {
       "text": "Fixed various matchmaking and connection issues both in matches and when starting a match.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various issues with voice chat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed join-in-progress issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed various replication issues between host and clients",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with player rank and COOP/heist rewards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with Helix credits",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issues with the My Club feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Menus and HUD",
