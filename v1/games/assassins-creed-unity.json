      },
      {
       "text": "Fixed additional issues with notifications",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Mission tweaks (campaign, coop and side content)",
     "items": [
      {
       "text": "Fixed various low occurrence walkthrough breaks in both Campaign and COOP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed various NPC issues",
       "ps5ProOnly": false,
       "pcOnly": false,
