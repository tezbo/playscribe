  {
   "id": "assassins-creed-unity@3",
   "gameId": "assassins-creed-unity",
   "displayName": "Patch 3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2014-11-25T17:58:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks to your collaboration and support via our Customer Support channels and this Live Update blog, we have assembled Patch 3 and are preparing to deploy it on console and PC this week. The rollout itself will begin later this week on PC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 3 includes over three hundred fixes designed to improve your Assassin’s Creed Unity experience. While you might notice some improvements to framerate as a result of Patch 3, we still have a future patch planned to further address framerate concerns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can find a detailed list of fixes in our Forums, but here’s a quick overview of some of the updates you’ll find in Patch 3:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Stability and Performance",
     "items": [
      {
       "text": "Fixed numerous random crashes in Campaign and Co-op modes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed specific framerate drops",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved task scheduling",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Tweaked performance for Reach High Points (Synchronization)",
       "ps5ProOnly": false,
