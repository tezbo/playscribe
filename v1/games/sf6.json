  {
   "id": "sf6@major-2025-12-16",
   "gameId": "sf6",
   "displayName": "Update including new content, battle balance adjustments!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-16T09:00:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Street Fighter 6's latest update is out now, featuring various battle balance adjustments and new contents! Check out Buckler's Boot Camp for detailed patch notes.",
       "ps5ProOnly": false
      },
      {
       "text": "https://www.streetfighter.com/6/buckler/en/information/detail/update20251216",
       "ps5ProOnly": false
      }
     ]
    },
    {
     "title": "① Personalize your Battle HUD design!",
     "items": [
      {
       "text": "Players can now customize the look of the Health Gauge, Drive Gauge, and other Battle HUD elements displayed during matches. On top of the Sim Sim themed Battle HUD given to all players, you can purchase additional themes from the SHOP.",
       "ps5ProOnly": false
      },
      {
       "text": "Designs can be changed in Battle HUD Design settings (Options > Interface > Battle HUD Settings > Battle HUD Design).",
       "ps5ProOnly": false
      },
      {
       "text": "※Design customizations will only be displayed on your own screen.[img src=\"{STEAM_CLAN_IMAGE}/42954094/8ff9fbd7d16166a340183d57a6f322d97b148ac0.jpg\"]",
       "ps5ProOnly": false
      }
     ]
    },
    {
     "title": "② Here comes a new commentator: Amaki Pururu!",
     "items": [
      {
       "text": "Member of the eSports team REJECT and popular Japanese Vtuber Streamer, Amaki Pururu, joins as a guest color commentator! Her Japanese commentary track can be set in the Color Commentators section of Commentary Settings!",
       "ps5ProOnly": false
      },
      {
       "text": "Have Pururu hype you up as you play! A special title will be made available to get from the in-game News until March 2, 11:59 PM (PT) / March 3, 7:59 AM (GMT). Don't miss out!",
       "ps5ProOnly": false
      }
     ]
    }
   ],
