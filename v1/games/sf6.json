   "id": "sf6@2.0201.000",
   "gameId": "sf6",
   "displayName": "Hotfix 2.0201.000",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-04-01T02:31:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "\\",
       "ps5ProOnly": false
      },
      {
       "text": "Following the update released on March 17, we have confirmed performance instability on some Steam environments.A Steam-only patch addressing the suspected cause was released at March 31 7PM PDT.",
       "ps5ProOnly": false
      },
      {
       "text": "With this update, the Steam version is now 【2.0201.000】.",
       "ps5ProOnly": false
      },
      {
       "text": "While this does not guarantee stability across all Steam environments, performance improvements are expected on some systems.",
       "ps5ProOnly": false
      },
      {
       "text": "If you experienced performance issues caused by the recent update, please launch the game on the latest version and check your experience.",
       "ps5ProOnly": false
      },
      {
       "text": "Thank you for your continued support, and we hope you continue to enjoy Street Fighter 6.",
       "ps5ProOnly": false
      }
     ]
    }
   ],
