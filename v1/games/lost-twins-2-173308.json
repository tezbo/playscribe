  {
   "id": "lost-twins-2-173308@major-2025-12-15",
   "gameId": "lost-twins-2-173308",
   "displayName": "Feature Update: New Skins Available",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-15T07:00:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re excited to roll out our brand-new Skins Update, giving the twins a fresh new look and more ways for you to personalize your adventure!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With this update, we wanted to add something purely fun. This update adds a way for players to express themselves while exploring the world and solving puzzles. The new skins feature lets you customize the twins with colorful, charming designs that still fit naturally into the game’s cozy atmosphere.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "✨ What’s new?",
     "items": [
      {
       "text": "Multiple new skins for the twins",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fun, expressive designs that add personality without affecting gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Easy skin switching so you can try different looks anytime",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/41223829/4a2eebbe0bc326fff99ac730531f8620a314ffe5.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/41223829/5e6523912d102fc02a6ead89a712552b38749fbe.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "This update doesn’t change how the game plays. Puzzles, mechanics, and progression stay exactly the same. Skins are all about style, creativity, and player expression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "As always, this update is based on community feedback and our desire to keep improving the game with small but meaningful additions. We’d love to hear which skin is your favorite!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Regards,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Playdew Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/1752540/Lost_Twins_2/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
