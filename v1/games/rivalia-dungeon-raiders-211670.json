  {
   "id": "rivalia-dungeon-raiders-211670@1.02",
   "gameId": "rivalia-dungeon-raiders-211670",
   "displayName": "Update 1.02",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-24T10:02:51.000Z",
   "notes": [
    {
     "title": "Halloween event details",
     "items": [
      {
       "text": "The event will be available from the 24th of October until the 2nd of November.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The lobby will be decorated with the event's own aesthetics.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemies that inhabit the graveyard will change their appearance to fit the festival.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The graveyard dungeons will also be decorated with new details, such as pumpkins and ravens.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Among these new decorations, there will be breakable pumpkins that will contain 2 new materials exclusive to this event: Pumpkin and Silver Ingot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Using the new materials will unlock 2 new exclusive rune sets available for forging: Pumpkin Rune and Moon Rune.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Once the event is over, you will keep the materials and runes obtained. The event's exclusive runes will still be available for forging in the forge, but you will no longer be able to obtain materials within the dungeons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "General",
     "items": [
      {
       "text": "If you select the controller as the default device and is disconnected, the mouse and keyboard controls will be activated until the controller is connected again.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Balance changes",
     "items": [
      {
       "text": "Increased Sacrum's magic damage and health. Increased health of Skeletons summoned by Sacrum.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased physical damage and health of Spinefeld and Marrow.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Increased Ciceron's physical and magic damage and reduced his armour.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced magic damage of Flying Cyclops.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
