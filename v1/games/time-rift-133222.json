    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello !",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Time Rift has been out for one week now, and many of you have enjoyed it! Thanks to all of you, especially those who took the time to write a Steam review 🙂",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are making our first patch today and we continue to work on small improvements. Here are today's updates:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Time Rift is now translated into Italian! 🇮🇹",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've updated the images of the Steam achievements. Unintentionally, we had released the game having left some old versions. This is now fixed!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Do you have any ideas on how to continue improving the game? Come and talk about it on the Steam forum!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
