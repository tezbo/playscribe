  {
   "id": "inspector-waffles-early-days-273621@post-2025-07-07",
   "gameId": "inspector-waffles-early-days-273621",
   "displayName": "New aspect ratio and minor fixes in UI!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-07-07T09:31:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Took me a little while, but the game is finally updated in its (probably) final form.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here a list of things I fixed",
     "items": [
      {
       "text": "* Screen ratio! You can now play in 16:9, 4:3 or native (it's really small, be prepared!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* A couple of translation fixes in the french UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "* Some UI Buttons didn't have the correct text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The ROM can't be changed or you'll all lose your saves, so.... sorry for the typos I can't fix anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Take care and see you soon for new games,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Yann",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
