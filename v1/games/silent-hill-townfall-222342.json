  {
   "id": "silent-hill-townfall-222342@1.4.0",
   "gameId": "silent-hill-townfall-222342",
   "displayName": "Update 1.4.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-08T07:26:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "On October 8, 2026, we released an update improving some systems and addressing some in-game issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please check that the version number in the lower right corner of the main menu is displayed as v1.5.154194.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "・Gameplay & AI Improvements for The Weight",
     "items": [
      {
       "text": "Grab attacks now deal heavy damage instead of causing instant death on Story Mode and Normal difficulties.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Searching behaviors have been improved to prevent The Weight from ‘camping’ in front of the player’s objective for long periods of time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Searching behaviors have been improved to prevent The Weight from repeatedly searching the same location and remaining there for long periods of time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Hunting behaviors have been improved to prevent The Weight from tracking the player too aggressively.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "・Gameplay & AI Improvements for enemies",
     "items": [
      {
       "text": "Enemy sensitivity to the sound of firearms has been reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enemy sensitivity to the sound of the player while running has been reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Enemy sensitivity to the sound of the player entering a hiding space has been reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The frequency of enemy counterattacks after successful player attacks during melee combat has been reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "With the exception of The Weight, grapple attempts from enemies while the player is actively blocking with a melee weapon have been removed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Players are now given more time to react to enemies after escaping a grapple.: ・Puzzle Information Design Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A collectible manual for the \"Remote Systems Control\" console that can be viewed for quick reference while operating the console has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The pipe layout for the \"Aux Line\" puzzle has been updated to improve clarity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "・Fixed a progress-blocking issue in Part 5 where glass could prevent the player from entering the CEG Tower.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Fixed an issue in Part 5 where the names of the Projector Slides could incorrectly display the same name.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Fixed several areas where the player could go out of bounds and break the sequence of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "・Fixed an issue where the Letterbox option would not be visible when playing on an ultrawide monitor.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Added missing key bindings for AZERTY keyboards.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・Improved frame pacing and further reduced instances of streaming stutter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
