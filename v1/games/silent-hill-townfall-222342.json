  {
   "id": "silent-hill-townfall-222342@1.6.0",
   "gameId": "silent-hill-townfall-222342",
   "displayName": "Update 1.6.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-10-29T00:50:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "On October 28, 2026, we released an update tuning gameplay and addressing some in-game issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please check that the version number in the lower right corner of the main menu is displayed as v.1.6.155963.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Addition of a new Hard difficulty mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Rebalance of gameplay elements across all difficulty modes to accommodate the introduction of the new Hard mode, creating a smoother difficulty curve for players to choose from.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Resource adjustment in some sections of the game as part of difficulty balancing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Player position now visible on the map in all difficulty modes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemy hearing sensitivity now varies by difficulty, increasing with the difficulty level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The Weight’s attack severity reduction is limited to Story Mode only.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UX / UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Nightmare difficulty warning screen now shown if first playthrough is set to Nightmare difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Difficulty selection description now shows a clearer summary of differences between the options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Improvements to valve status lighting for colourblind players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Additional player hints / tutorials added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Improvements to some puzzle hints and item wording.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Restructuring of the Options Menu to better separate options into categories.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Renamed the controls remapping menu option so that it does not explicitly mention only control pads, as keyboard and mouse commands can be remapped there too.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Other",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・DLSS Ray Reconstruction option added (PC only).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "・General improvements and bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
