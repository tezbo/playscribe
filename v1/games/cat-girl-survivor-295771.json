  {
   "id": "cat-girl-survivor-295771@1.16.6",
   "gameId": "cat-girl-survivor-295771",
   "displayName": "Update 1.16.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-22T08:16:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The adorable adventure of the Cat Girl Mages, \"Cat Girl Survivor\"!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.16.6 Update has been deployed!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The update details are as follows",
     "items": [
      {
       "text": "• Performance Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> Improved overall game stability for a smoother gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• New Feature: Skill Exclusion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> Based on player feedback, we’ve added a feature to exclude unwanted skill combinations, allowing for more strategic builds.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Status Effect Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> Fixed an issue where normal damage was not being applied to enemies affected by \"Poison\" or \"Burn\" status effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Crash Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "> Resolved an issue where the game would force close under specific circumstances.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition to the above, minor fixes and optimizations have been implemented.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please check our official X account for the update announcement as well!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to enjoy the adventures of the cute Cat Girls! We look forward to receiving lots of support and feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "©2025 Minimum Studio Corp. All rights reserved. Published by CFK.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
