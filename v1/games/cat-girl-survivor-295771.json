  {
   "id": "cat-girl-survivor-295771@1.22",
   "gameId": "cat-girl-survivor-295771",
   "displayName": "Update 1.22",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-17T02:59:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The adorable adventure of the Cat Girl Mages, \"Cat Girl Survivor\"!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.22 Update has been deployed!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new update has been released to improve the gameplay environment and support new content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🐾 New Content & Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· New DLC Character Support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The new character, \"Emer\", Guardian of the Forest, has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(You can play as this character if you own the corresponding DLC.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Item Lock Feature Added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An item lock feature has been newly added to the inventory to prevent players from accidentally selling important items.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🐾 Bug Fixes & System Improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Audio Overlap Fix",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue during the 7th Boss encounter where the dialogue BGM would continue playing even after the dialogue ended, overlapping with the boss battle BGM.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "· Level Up Stat Compensation Improvement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved an issue where stat increases upon leveling up were completely randomized, occasionally resulting in no stats increasing at all.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Now, at least 1 stat is guaranteed to increase upon leveling up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Legendary Equipment Stat Revamp",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The max level has been changed from 15 to 20, and the stat increase amount has been changed from 7% to 11%.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please check our official X account for the update announcement as well!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to enjoy the adventures of the cute Cat Girls! We look forward to receiving lots of support and feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "©2025 Minimum Studio Corp. All rights reserved. Published by CFK.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
