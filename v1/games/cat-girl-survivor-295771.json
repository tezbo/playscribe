   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-03T02:54:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The adorable adventure of the Cat Girl Mages, \"Cat Girl Survivor\"!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Version 1.12.0 User Convenience Improvement Update has been released!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The update includes the following changes",
     "items": [
      {
       "text": "① Made it possible to stop the slot machine faster.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "② Added a feature to change the BGM in Endless Mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "③ Fixed a bug where only poison damage was applied when an enemy was poisoned, preventing other damage from taking effect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "④ Fixed a bug related to Magnet item absorption.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⑤ Fixed an issue where the item acquisition speed from treasure chests was too fast, making it difficult to identify the item.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please check our official X account for the update announcement as well!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to enjoy the adventures of the cute Cat Girls! We look forward to receiving lots of feedback and support.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "©2025 Minimum Studio Corp. All rights reserved. Published by CFK.",
       "ps5ProOnly": false,
