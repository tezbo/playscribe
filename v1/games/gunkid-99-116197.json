  {
   "id": "gunkid-99-116197@0.3.3",
   "gameId": "gunkid-99-116197",
   "displayName": "Update 0.3.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2018-11-01T16:18:53.000Z",
   "notes": [
    {
     "title": "​Patch Note",
     "items": [
      {
       "text": "Pressing down will now let you drop down from platforms. A new checkbox called 'Down Lock' has been added in the Key-bindings menu, enabling this will stop you from being able to drop down from platforms with just the down button. You'd have to press 'Down + Jump' (the previous method) or double-tap 'Down' instead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now also drop down from platforms while doing a dodge-roll by pressing down. (or the other buttons combination mentioned above) Basically anything to do with moving through platforms is now smoother than before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Camera issue for certain monitor resolutions have been fixed. (If you still have problems, please feedback to me!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor hit-box adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Slightly better path-finding for Flying Slime.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where the game icon doesn't appear on the taskbar when you ctrl-tap out of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
