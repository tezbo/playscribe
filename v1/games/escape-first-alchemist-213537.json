   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We just uploaded a patch that adds / fixes issues with keybindings, gamepad controls, translations, settings options and other bugs / suggestions that you have found! Thank you to everyone who leaves feedback, we read all of it and it really helps a lot with fixing bugs!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Also, this patch has seen a few changes that should improve performance, this is an ongoing process so there will probably be more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "That being said, we are preparing a bigger update that will include a bit of extra content that didn't make it on release, so stay tuned for more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
