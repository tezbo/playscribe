   "id": "ys-vs-trails-in-the-sky-alternative-saga-326629@1.0.7",
   "gameId": "ys-vs-trails-in-the-sky-alternative-saga-326629",
   "displayName": "Patch 1.0.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-01-06T11:12:28.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]we're making the 1.0.7 update available which contains the following changes and bug fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]Fixed a bug where the duration of the items \"Critical Strike Gloves\" and \"Awakening Puppet\" was not properly set.: Fixed some effects not covering the entire screen when playing on ultrawide and narrow screens.: Fixed a message during online play that wasn't properly centered when playing on ultrawide and narrow screens.: Fixed some item names that contained garbage characters in the Japanese version.: Fixed typos on the Japanese version of the tutorial menu.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "[p align=\"start\"]Furthermore, Community Items are now available! Players who've already played for a while should have received a few trading cards. Once you craft a badge with them, you'll receive various items such as Profile Backgrounds and Emoticons to decorate your profile with ːVsMonaː",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
