  {
   "id": "ys-vs-trails-in-the-sky-alternative-saga-326629@1.0.6",
   "gameId": "ys-vs-trails-in-the-sky-alternative-saga-326629",
   "displayName": "Patch 1.0.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-26T13:55:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we're making the 1.0.6 update available which contains the following changes and bug fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved rollback drift handling to improve situations where one player might experience more rollback than the other when playing online.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where the Master Volume setting used the setting for SE Volume instead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed menu inputs registering twice on rare occasions when performance drops or there are external FPS limiters active.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Tita's 4th outfit colors used colors from the 3rd outfit instead.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug that prevented LAN Mode from working when multiple copies of the game are running.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bugs that occurred when the User Folder contained non-ASCII characters, causing potential issues with saves.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Implemented fallback crash handling implementation for debugging of issues when the automatic crash report option is not initialized (e.g. early during game initialization or when automated crash reporting is disabled).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed loading screen rendering displaying stretched by mistake on certain resolutions after gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "With this update, Ys vs. Trails in the Sky: Alternative Saga is officially Steam Deck verified! We already put some effort in features, specially arbitrary resolution and aspect ratio support, which lets the game occupy the whole 1280x800 screen during gameplay, so we're glad to receive the Verified status officially!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We're keeping an eye out for other ongoing issues such as desynchronization during certain skills, start-up issues on PC, and misbehaving accessories, and we hope to have more to share soon.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
