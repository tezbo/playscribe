  {
   "id": "the-centennial-case-a-shijima-story-191420@post-2022-06-22",
   "gameId": "the-centennial-case-a-shijima-story-191420",
   "displayName": "The Centennial Case: A Shijima Story 4K Video Pack is now available!",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2022-06-22T09:51:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Centennial Case: A Shijima Story 4K Video Pack is available as of today.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Applying this DLC will allow you to upgrade the live-action video sections of The Centennial Case: A Shijima Story to ultra high definition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please follow the steps below to download the bonus separately.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Open your library and select \"The Centennial Case: A Shijima Story\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Click \"Manage DLC\", displayed in the DLC section on the right-hand side.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Tick the box next to the DLC that you wish to download.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If the game itself is already installed, then following the steps above will install the DLC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(In order to apply this DLC, you must possess the full game. Furthermore, there must be 36GB or more of available storage in addition to that required for the full game.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In order to apply this DLC, you must possess the full game as well as 36GB or more of available storage. Please confirm your available storage space before applying the DLC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
