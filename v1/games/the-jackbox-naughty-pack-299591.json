  {
   "id": "the-jackbox-naughty-pack-299591@major-2024-11-12",
   "gameId": "the-jackbox-naughty-pack-299591",
   "displayName": "Content Update Coming To The Jackbox Naughty Pack Fall 2024!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-12T22:16:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re launching a free update for all Naughty Pack players this fall to help you close out the year in spicy fashion, including new additions to all three games! 🌶️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This update will include",
     "items": [
      {
       "text": "Additional prompts for Fakin’ It All Night Long, Dirty Drawful, and Let Me Finish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New content filters in Fakin’ It All Night Long and Let Me Finish that allow players to increase the intensity of the content they will see in their game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A brand new Quick Mode for Let Me Finish that allows you to add captions to photos and pits players against each other in rapid head-to-head rounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The ability to turn off emotes in Dirty Drawful",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other quality-of-life updates and bug fixes including updated timers in Let Me Finish that allow players more time to create",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Stay tuned here and on all Jackbox Games social channels so that you don’t miss out when the update goes live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
