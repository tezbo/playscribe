  {
   "id": "the-jackbox-naughty-pack-299591@major-2024-11-22",
   "gameId": "the-jackbox-naughty-pack-299591",
   "displayName": "The Jackbox Naughty Pack update is out now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-22T15:30:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re launching a free update for all Naughty Pack players with quality of life improvements, new content, and some changes to gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The update includes",
     "items": [
      {
       "text": "Additional Prompts: Fakin’ It All Night Long, Dirty Drawful, and Let Me Finish all have brand new prompts added to play with your foul-mouthed friends",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Content Filters: Fakin’ It All Night Long and Let Me Finish allow players to increase the intensity of the content they will see in their game. Too spicy? We got you! Not spicy enough? We also got you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Let Me Finish Mode: Quick Mode is coming to Let Me Finish! This mode allows you to add captions to photos and pits players against each other in rapid head-to-head rounds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optional Emotes: Dirty Drawful emotes can now be turned off in the settings. Why you wouldn’t want our Audio Lead, Kelly, moaning over all of your drawings is a surprise to us, but we hear you and it is now optional <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quality of Life Updates and Bug Fixes: This includes updated timers in Let Me Finish that allow players more time to create their saucy little masterpiece",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
