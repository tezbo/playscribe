     "title": "Changes",
     "items": [
      {
       "text": "Hello everybody!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've appreciated all the feedback that you've sent in. We've patched up some problem areas with bosses with the info and fixed some levels. :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed delete save data text to be less ambiguous",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Changed how the bullets interact with the player so that you aren't shoved out",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new visual option to toggle in options: We are always happy to hear from our players so feel free to reach out to us in any way possible! We'll do our best to respond.: We are looking at doing more levels, but of course we want to base whatever level update we do on a unified theme, so we are looking for any suggestions from you! Let us know in the comments!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
