  {
   "id": "the-diofield-chronicle-194209@major-2022-12-09",
   "gameId": "the-diofield-chronicle-194209",
   "displayName": "Free Update Coming March 2023",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-09T12:07:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A free update is coming to The DioField Chronicle in March 2023, which includes a new story, a new weapon, new skills, and additional challenges!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NEW STORY",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Play through a new scenario as Waltaquin and use powerful Necromancy skills with the newly added Grimoire. Summon Skeletal Knights and fearsome Skeletal Dragons to force your enemies into submission!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "NEW BOSS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Face off against the mighty Behemoth!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "EXTRA MODE",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The free update will include a new difficulty option for New Game+.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new difficulty level, Very Hard, will also be added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Follow The DioField Chronicle on Twitter for more updates!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
