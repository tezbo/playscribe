  {
   "id": "romeo-is-a-dead-man-347119@1.4.200",
   "gameId": "romeo-is-a-dead-man-347119",
   "displayName": "Patch 1.4.200",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-03-06T06:53:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released the latest update for ROMEO IS A DEAD MAN, Ver.1.4.200.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This update includes the following changes",
     "items": [
      {
       "text": "• Frame Generation has been added to the graphics settings menu.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you are using a graphics card that supports Frame Generation, you can now enable it from the settings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Fixed several minor bugs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue working to improve the game so that you can enjoy a smoother experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
