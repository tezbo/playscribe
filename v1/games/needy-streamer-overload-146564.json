   "id": "needy-streamer-overload-146564@major-2024-07-15",
   "gameId": "needy-streamer-overload-146564",
   "displayName": "Windose Major Title Update Stream Generator Implementation",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-07-15T02:44:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A major update will be released on July 15th at 11:00 (JST).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update will be the implementation of the \"Streaming Generator.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This feature allows you to create your own original \"OMGkawaiiAngel Stream.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "・For instructions, please click here",
     "items": [
      {
       "text": "*Please download the file to confirm since the manual contains many images and the data size is relatively large.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
