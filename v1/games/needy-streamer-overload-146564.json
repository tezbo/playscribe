  {
   "id": "needy-streamer-overload-146564@post-2022-04-19",
   "gameId": "needy-streamer-overload-146564",
   "displayName": "Regarding issues occuring on Windows 10 Pro",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2022-04-19T15:46:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have received reports that the previous update caused an issue on the \"Booting Windose20\" screen for users running the game on Windows 10 Pro.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "As such we have released an update to fix this issue.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you are running the game on Windows 10 Pro and still experience similar issues after updating the game, we ask that you please report the issue in the bug report thread, along with details on the system you are currently using.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
