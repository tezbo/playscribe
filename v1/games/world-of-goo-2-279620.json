  {
   "id": "world-of-goo-2-279620@post-2025-05-29",
   "gameId": "world-of-goo-2-279620",
   "displayName": "Level Editor with Steam Workshop integration",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2025-05-29T18:57:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've decided to release our in-house editor via Steam Workshop!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We built the editor just for us, and did not originally plan to share it. It's unpolished, unsupported, and gloriously unbeautiful - but it built all the levels in World of Goo 2 - and now it's publicly available for brave players to build and share their own levels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
