  {
   "id": "world-of-goo-2-279620@post-2025-05-07",
   "gameId": "world-of-goo-2-279620",
   "displayName": "World of Goo 2 bug fixes and Steam Deck compatibility improvements",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2025-05-07T17:07:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everybody!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "We've released a new update this week that adds",
     "items": [
      {
       "text": "offline mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Steam Deck improvements",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "and various other bug fixes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Download it today and stay tuned for some more exciting World of Goo 2-related news later this month!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Our Steam launch has gone well thus far and we wanted to express our appreciation to everyone for playing and helping spread the good word. If you haven't yet, please consider leaving a review on the game's store page. Special thanks to the nearly 300 World of Goo 2 owners that have already done so!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
   "digest": {
    "new": 4,
    "fixed": 0,
    "balance": 0,
