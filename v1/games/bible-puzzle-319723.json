  {
   "id": "bible-puzzle-319723@1.4.4",
   "gameId": "bible-puzzle-319723",
   "displayName": "Update 1.4.4",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-12T04:43:54.000Z",
   "notes": [
    {
     "title": "🆕 New Features",
     "items": [
      {
       "text": "The virtual keyboard is now supported in Big Picture Mode and on the Steam Deck, making text input more convenient on those platforms.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "🔁 Quality of Life",
     "items": [
      {
       "text": "When returning from a puzzle match, the Home screen will now be open with the last story and picture you selected, so you can pick up right where you left off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🎨 Visual Improvements",
     "items": [
      {
       "text": "The Leaderboard entry button is now bigger and more visually appealing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added particle effects to highlight the top 3 ranks (1st, 2nd, 3rd) on the Leaderboard.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Introduced particle effects on the \"Ranking\" label below the difficulty selection.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added informational text explaining what the Ranked difficulties mean.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "🐞 Bug Fixes",
     "items": [
      {
       "text": "Fixed a visual issue when scrolling through the picture selection screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
