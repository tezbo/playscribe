  {
   "id": "bible-puzzle-319723@1.3.2",
   "gameId": "bible-puzzle-319723",
   "displayName": "Update 1.3.2",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-03-18T03:04:00.000Z",
   "notes": [
    {
     "title": "🚀 Bible Puzzle is now available on the Apple Store!",
     "items": [
      {
       "text": "We have finally released our game on the Apple Store! Now you can take your progress with you on your iPhone, iPad, and Apple Vision.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🙌🏽 New Achievement",
     "items": [
      {
       "text": "You can now unlock the new achievement by visiting our App Store page directly from the game settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "📉 Game Size Reduction!",
     "items": [
      {
       "text": "We have restructured our video system so that only one base video is used, with different audio and subtitles for each language.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📚 Before: 600 MB",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "📚 Now: 300 MB",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This means more free space on your device and faster downloads! 🙌🏽🚀",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🧩 What's Next?",
     "items": [
      {
       "text": "📚 The story of David is nearing completion. Discover the tale of a young shepherd who had the courage to face a giant!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "💬 Feedback and Community",
     "items": [
      {
       "text": "We hope you are enjoying our game. See you on the Leaderboards! 🎉",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
