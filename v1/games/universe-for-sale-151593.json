  {
   "id": "universe-for-sale-151593@1.0.5z",
   "gameId": "universe-for-sale-151593",
   "displayName": "Update 1.0.5z",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-04-22T18:03:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We are happy to tell you that our next update will significantly improve the game's stability!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "However, to achieve this, we had to change how the game saves progress completely. The old saving system caused many issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We advise you to update to the newest version when we release it shortly. But, doing so means you will lose your existing save progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you want to keep playing on your current save, we've moved this game version (1.0.5z) to the \"old-savegame\" branch on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please set this in your Steam game settings!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
