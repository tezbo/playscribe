   "announcedAt": "2024-08-05T17:31:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Cultists,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just released a small patch note which fixes some minor graphic details, updated traditional Chinese and Korean texts, and more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Full Patch Notes",
     "items": [
      {
       "text": "Solved a bug in the market that softlock the master in an animation when entering in a market (robot) if pressed on the Robot seller when the master is walking inside.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed some minor graphic details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated credits welcoming traditional Chinese and Korean translators.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Updated traditional Chinese and Korean texts correcting many grammatical issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug (but no locker one) in the cult chapter where a contextual balloon could be opened within a dialogue between characters.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Riv Otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
