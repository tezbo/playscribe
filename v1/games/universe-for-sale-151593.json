  {
   "id": "universe-for-sale-151593@1.0.5",
   "gameId": "universe-for-sale-151593",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-01-31T17:47:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey cultists,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have released a patch to fix some of the various softlocks that have been reported plus fixing the steam overlay appearing upside down.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "War Chapter: players should now be able to progress past shooting the first set of robots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game shouldn't softlock when clicking haphazardly when entering rooms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lila’s Market: softlocks in various places of this chapter should be resolved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Teahouse: players should no longer softlock during the first universe making scene.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed small graphical bugs and typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Steam overlay no longer appears upside down when notifications pop up.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Riv otter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
