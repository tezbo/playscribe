  {
   "id": "kona-ii-brume-211242@post-2023-10-24",
   "gameId": "kona-ii-brume-211242",
   "displayName": "Patch Notes 2023-10-24",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-10-24T07:29:23.000Z",
   "notes": [
    {
     "title": "A hotfix patch is now live and here are the release notes",
     "items": [
      {
       "text": "Fixed bloody hand photo target on the Mansion's saloon door not working after waking up in the basement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the True Detective achievement not unlocking after completing the journal",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed music not playing in some areas of the mansion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the general store climbing wall that wouldn't work after reload",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added map marker for the statue to be thrown in the service lift in the mansion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a corner case where objects would disappear forever if the player opened a journal notification with an object in hands (logs, battery, jacklift, etc), consequently breaking his save",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
