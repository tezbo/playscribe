  {
   "id": "what-the-golf-87983@post-2023-11-13",
   "gameId": "what-the-golf-87983",
   "displayName": "Return of the turkey 🍗",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2023-11-13T10:26:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "“What a time to be alive!” A turkey once said, and we couldn’t agree more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "More levels, juicier and even better... We’ve fixed the old achievement bug😅If you play the levels now and get the achievement you will have it forever 🦃",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sorry you had to wait so long but NOW IT’S HERE AND IT WILL STAY FOREVER! Go to the VIP section in the main menu hub, and find our turkey friend. Bump into it 3 times and watch the magic unfold.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
