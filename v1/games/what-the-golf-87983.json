 "releases": [
  {
   "id": "what-the-golf-87983@20.5.9",
   "gameId": "what-the-golf-87983",
   "displayName": "Patch 20.5.9",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-12T16:07:10.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Well hello there!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hope you're all having A December 🎄",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The golf... santa... came into our office, drank a few coffees and then fixed a few bugs. Very strange man. Anyways here's some Patch Notes for a cheeky little fix that came early this week!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Secret Saw Achievement",
     "items": [
      {
       "text": "So sorry for all the distress concerning this bug and achievement! It unlocks retroactively now - but players will still need to enter the main campaign.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Computer 03 Achievement didn't unlock",
     "items": [
      {
       "text": "It now unlocks retroactively. Maybe there was some issue that stopped it from triggering when it should.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Players will still need to enter the main campaign to trigger this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Players get stuck in a Mario little plumber guy level",
     "items": [
      {
       "text": "It was breakable by spamming the shoot button so we've not brought in a plumber and disabling input while you’re in the pipe.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "NEXT EVENT: LET'S PAR-TEE",
     "items": [
      {
       "text": "The next event is gonna take place over NEW YEARS 🎉🍾🥂",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "from December 23rd until Jan 5th",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
