  {
   "id": "like-a-dragon-ishin-217597@major-2023-02-21",
   "gameId": "like-a-dragon-ishin-217597",
   "displayName": "Issue of DLC not displaying on Steam",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-21T12:04:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello RGG Fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing the Like a Dragon: Ishin!.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have confirmed that some purchasable DLC may not be displayed on Steam, and the team is currently investigating this issue.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Ryoma Growth Support Kit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sword Upgrade Materials Kit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gun Upgrade Materials Kit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Third Division Armament Expansion Kit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you are experiencing this issue, please check your Steam \"Inventory\" for any DLC that is not listed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Inventory is located under the \"Your Account Name\" menu at the top of the Steam menu bar, to the right of Store, Library, and Community.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*The number of purchasable DLC in your possession will decrease after you retrieve them, but the check mark will not be displayed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*DLC is only saved in the save data at the time of receipt.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "DLC may display correctly after the following",
     "items": [
      {
       "text": "Talk to Bakumatsu Bob a few times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Retrieve any other DLC you are eligible to receive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restart the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition, an issue has been identified where talking to Bakumatsu Bob while offline causes him to become stuck. Please ensure that you are online to receive the DLC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your support and patience while our team looks into these known issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to share any bugs you encounter via the Official Bug Thread.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "RGG Community Team -",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
