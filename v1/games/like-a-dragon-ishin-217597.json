  {
   "id": "like-a-dragon-ishin-217597@1.03",
   "gameId": "like-a-dragon-ishin-217597",
   "displayName": "Patch 1.03",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-03-03T01:13:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello RGG Fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.03 is now live with the following fixes and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PC version",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Stuttering when effects are first loaded",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crashes on startup (on rare occasions)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The display of some UI elements being out of position on ultra-wide displays",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Improvements to monitor selection and resolution settings displayed in a multi-monitor environment",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "All platforms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enemies unexpectedly teleporting in rare cases when activating a heat action near a door",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that prevented the use of special turrets placed on the stage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Crash bug when using the abilities of the Toranosuke and Yama-goroshi cards in certain Wanted Men mission",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that caused the progression to become impossible when bringing back a deserter from Mukurogai",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Changes in heat gauge reduction behavior that is dependent on FPS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Issue of Health Gauge not increasing even if the player unlocks \"Health Increase 1\" on the Gunman skill",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other stability improvements and bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gameplay Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The number of repeated button presses required while performing 'Ichizu Samurai (Truehearted Samurai!)' at the Singing Bar, have been reduced",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In addition, the team is currently working on the next patch that includes bug fixes and balance adjustments which we are planning to release in the near future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We appreciate your support and patience while our team addresses these known issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please continue to share any bugs you encounter via the Official Bug Thread.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "RGG Community Team -",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
