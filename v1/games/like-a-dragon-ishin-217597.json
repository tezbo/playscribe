  {
   "id": "like-a-dragon-ishin-217597@major-2023-02-17",
   "gameId": "like-a-dragon-ishin-217597",
   "displayName": "How To Access Pre-order Bonus/DLC",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-17T18:21:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello RGG Fans!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In order to access your Pre-order Bonus/DLC, we’ve put together a step-by-step guide to help you get started:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Complete Chapter 1 / Begin Chapter 2",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Go downstairs to the first floor. Before leaving the Teradaya Inn, make your way left to explore more of the inn.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Make sure not to walk to the right because it will trigger a cutscene for the story.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Take a right into the second room. Once inside, exit the room from the other side to the hallway and turn left. You will meet a man named Bakumatsu Bob where you’ll be able to redeem the pre-order bonus and as well as purchase DLC content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you’re enjoying the game so far!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "RGG Community Team -",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
