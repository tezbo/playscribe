  {
   "id": "hauntii-217008@5.2.7",
   "gameId": "hauntii-217008",
   "displayName": "Update 5.2.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-17T04:53:28.000Z",
   "notes": [
    {
     "title": "Revisions",
     "items": [
      {
       "text": "show collected/total tokens per stage on map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "add an option in the crystal menu for unequipping your hat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "add missing hats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fix various guidance and map issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "tune bells to be easier to ring, especially on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "fix various character animation issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fix camera and balance on various boss battles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fix some achievement issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fix star in Crashed Sandship stage that was unachievable after a certain point in the story",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "make sure stars in the shop show on the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Here's a preview of the new Token counter Sporeo added to your map! Now you can see exactly how many are remaining in each stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
