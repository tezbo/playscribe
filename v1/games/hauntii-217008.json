  {
   "id": "hauntii-217008@patch-2025-10-13",
   "gameId": "hauntii-217008",
   "displayName": "Unity Vulnerability Patch",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-13T04:41:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patched to fix a vulnerability discovered in the Unity engine. Be sure to grab this update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "From Unity",
     "items": [
      {
       "text": "[table equalcells=\"1\" colwidth=\"\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An important message",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A security vulnerability was identified that affects games and applications built on Unity versions 2017.1 and later for Android, Windows, Linux, and macOS operating systems. There is no evidence of any exploitation of the vulnerability, nor has there been any impact on users or customers. We have proactively provided fixes that address the vulnerability, and they are already available to all developers. The vulnerability was responsibly reported by the security researcher RyotaK, and we thank him for working with us.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Moonloop",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
