  {
   "id": "hauntii-217008@5.2.2",
   "gameId": "hauntii-217008",
   "displayName": "Update 5.2.2",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-06-06T10:28:16.000Z",
   "notes": [
    {
     "title": "Version 5.2.2",
     "items": [
      {
       "text": "add an option in the crystal menu for unequipping your hat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "add missing hats",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fix various guidance and map issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "tune bells to be easier to ring, especially on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "fix various character animation issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fix camera and balance on various boss battles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Previewing in Beta",
     "items": [
      {
       "text": "With most updates, we will keep them in the open beta branch for a day or two before setting it live. If you'd like to get an early preview (and help us identify issues!), you can use the following steps:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "right click on Hauntii in your library",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "click properties",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "select Betas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "in the Beta Participation dropdown, choose open_beta",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "then close that and allow the game to update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
