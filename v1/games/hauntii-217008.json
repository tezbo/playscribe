  {
   "id": "hauntii-217008@post-2024-05-28",
   "gameId": "hauntii-217008",
   "displayName": "Have Some Hearts",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2024-05-28T15:18:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks everyone for your feedback and discussion! We're happy to be able to bring these improvements to you:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fully restore hearts when respawning",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix various race balance and hit detection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix un-grabbable stars from certain shops",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix a few localization errors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Efficiency, memory management improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
