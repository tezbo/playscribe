  {
   "id": "hauntii-217008@5.2.13",
   "gameId": "hauntii-217008",
   "displayName": "Update 5.2.13",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-07-08T08:01:06.000Z",
   "notes": [
    {
     "title": "Updates",
     "items": [
      {
       "text": "added shop, star pedestal, and various icons to the map",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added star hint text to the map (for stars you haven't collected yet)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "improved in-game cursor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "added toggle for windowed mode",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "added accessibility setting for disabling camera lens / distortion effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "balance Eternian turrets",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "balance fireworks gun",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "added skip button to intro cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Known issues",
     "items": [
      {
       "text": "can un-haunt while map is open",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "some funky UI behavior when in window mode and window is stretched to non 16:9 ratio",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can preview these changes now by switching to the beta branch. We'll continue testing and move it over to the main branch once it's ready!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
