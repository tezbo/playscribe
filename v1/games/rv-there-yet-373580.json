  {
   "id": "rv-there-yet-373580@1.0.14453",
   "gameId": "rv-there-yet-373580",
   "displayName": "Patch 1.0.14453",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-31T11:19:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The highlight of todays patch is two crash fixes, but there is some general bug-fixes in there too",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixed wrong material on gas station.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the handbrake remained engaged when exiting a vehicle without releasing it, forcing the next driver to release it before driving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where items fell through the carpet in front of the driver's seat due to missing collision",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "When attaching winch hook back to winch we reset it like the prompt says",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix crash FWasapiDeviceEnumeration::EnumerateDefaults crash that happens when players try to enter the map without a microphone connected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Added missing (Light Flare) prompt on flares with correct keybind.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Welding machine now a have max cable length",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Moose can now be cooked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added option to disable scene captures (mirrors). Temporary fix to allow some specific cards to run the game (mostly low end). If you are running an intel integrated card this will be enabled by default. Can be turned off in settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
