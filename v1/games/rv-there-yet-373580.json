  {
   "id": "rv-there-yet-373580@1.4.1.21945",
   "gameId": "rv-there-yet-373580",
   "displayName": "Patch 1.4.1.21945",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-30T16:05:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "GURAJCHAKA childs!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]Thanks for all of your feedback. In this patch we've quickly patched up a common issue that has been affecting a lot of players with yesterday's cross-play patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep the bug reports flowing - preferably over on the discord in the relevant forum depending on your platform.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bug Fixes",
     "items": [
      {
       "text": "Fixed issue regarding floating interactable items in the world",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Note: The Nintendo Switch 2 will not receive this patch until next week some time. As such, the issue will remain if a Nintendo Switch 2 player is hosting until the Switch patch is released.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
