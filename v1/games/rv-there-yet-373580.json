  {
   "id": "rv-there-yet-373580@1.0.14956",
   "gameId": "rv-there-yet-373580",
   "displayName": "Patch 1.0.14956",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-12-02T09:51:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thanks for the patience for this patch, it was a bit delayed due to work on new content. We have tried to balance fixing the worst issues that's live with creating new content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The highlight of todays patch is the ability to ban those trolls. We will add more anti troll measures later on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixed infinite spinner when trying to join a friends game that have a different game version, and added error message about it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash on shutdown/exit game due to how we unregistered VOIP talkers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed typo in messages about relay",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Added ban button to ban those trolls.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
