  {
   "id": "rv-there-yet-373580@1.2.16856",
   "gameId": "rv-there-yet-373580",
   "displayName": "Patch 1.2.16856",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-20T09:21:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This patch brings a few smaller bugfixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug where water became invisible on Low Global Illumination",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where a client that has quit to main menu and reconnect wouldn’t be heard by other players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "If a player collected all cosmetics in a level the corresponding achievement will be given when booting the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Now Public games view is refreshed automatically when visited",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Refresh in server browser now uses F5 (R still works)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
