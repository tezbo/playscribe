   "id": "rv-there-yet-373580@1.0.14299",
   "gameId": "rv-there-yet-373580",
   "displayName": "Patch 1.0.14299",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-23T09:40:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "First of all, we want to thank everyone for the enormous support. Our 8 week game jam game exceeded all expectations. We are aware of connection issues and the crashes (and a few bugs). We are working as fast as we can to try to resolve these, please be patient with us.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch: 1.0.14299 (23/10/2025) Bugs",
     "items": [
      {
       "text": "Killbox doesn’t give frame damage to players anymore (Eating a cooked burger will heal this damage if you still have it in your save but it should be removed),",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed main menu music looping,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Filled out some holes in edges around the lake just before the town,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Potential fix for players becoming invisible,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Cleaned up among our textures to ensure they wasn't referencing nanite to see if that solves some crashes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "Added some more motor oil cans and winch controllers to the world,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Added display prompts when looking at items or attachment points you can’t interact with at the moment,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added a little sign to motor hatch to help players find where it is,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added water damage smoke vfx to engine when taking water damage",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
