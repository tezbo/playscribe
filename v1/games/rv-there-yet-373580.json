  {
   "id": "rv-there-yet-373580@1.0.14370",
   "gameId": "rv-there-yet-373580",
   "displayName": "Patch 1.0.14370",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-10-27T15:41:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today we have a smaller patch trying to solve some of the more glaring gameplay issues with the RV and a few small fixes with options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fix invert look does not work when driving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix RV disassembles into pieces when driver disconnects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Potential fix for RV going crazy and flying away or bugging out physics wise",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Add missing RT/LT gamepad icons in interaction text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Add missing water volume",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed DLSS setting to properly work in conjunction with AA",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Features",
