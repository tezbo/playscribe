  {
   "id": "rv-there-yet-373580@1.2.17120",
   "gameId": "rv-there-yet-373580",
   "displayName": "Patch 1.2.17120",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-02T12:28:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We deliver to you a complete Portuguese localization. While we also deliver 1 crashfix and 3 potential crashfixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixed crash when closing the window during boot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Potential crashfix for crash seen on sentry backend when refreshing friends list",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Potential crashfix for crash seen on sentry backend when joining a game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Added a small PSO cache to compile shaders for DX12 users during startup instead of during gameplay. This is to see if this helps users with slow drives crashing when traveling to the map",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Portuguese localization is now up to date",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
