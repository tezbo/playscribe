  {
   "id": "rv-there-yet-373580@1.2.17021",
   "gameId": "rv-there-yet-373580",
   "displayName": "Patch 1.2.17021",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-30T09:01:11.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Finally managed to fix one of our most common crashes. When playing long games and talking (~3.5h), the game would crash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixed crash when people where using VOIP for a long time",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed 2 bugs introduced in 1.2.16785 with scene capture components",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mirrors stopped working on low",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The mirror in the bathroom was enabled even when Disable Scene Capture was checked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed so that people who was crashing during startup during hardware benchmark can just start the game again, and it will startup on Low/Mid settings without running any hardware benchmarks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix bug where cosmetic achievements that were supposed to be applied retroactively were not applied",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Reduced jitter when shifting gears on client",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
