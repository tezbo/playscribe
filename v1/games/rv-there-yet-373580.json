  {
   "id": "rv-there-yet-373580@1.2.16785",
   "gameId": "rv-there-yet-373580",
   "displayName": "Patch 1.2.16785",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-03-18T10:01:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’re still working hard on our new map but in the meantime we got you a smaller patch with Achievements, and a Server Browser to make it easier to play with strangers on the internet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch: 1.2.16785 (18/3/2026)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Added Server Browser",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added Achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixed bugged out DLSS option",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed bugged out VOIP option that got the value of UI when visiting the audio page",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed autodetect settings, so that computers with integrated Intel GPUs don’t get Ultra, but Low instead",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Optimized rendering of mirrors. Only render one mirror each frame instead of 2-3 mirrors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where if a player exits to the main menu, when rejoining the game, the other players isn’t muted anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix bug where left side window couldn't be interacted with while holding item.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix bug where client used two epipens on the same player when only pressing revive once.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Restructured options graphics menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Disabled options under graphics that didn’t make any changes when other options was in use (like resolution under Borderless Fullscreen)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Now framerate limit defaults to 1.25 * screen Hz instead of 120",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Some font fixes for different languages (localization is still work in progress)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    }
   ],
