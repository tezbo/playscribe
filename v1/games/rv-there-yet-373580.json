  {
   "id": "rv-there-yet-373580@1.0.14756",
   "gameId": "rv-there-yet-373580",
   "displayName": "Patch 1.0.14756",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-20T09:42:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Todays patch is mostly debug logs for more information so that we can try to narrow down why some of you can't play multiplayer, but some gameplay fixes too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fix spelling errors in vehicle HUD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix bug where you couldn't drag a smoke on gamepad",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Remove vehicle debug window from public builds",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix bug where item/player held by disconnecting player was stuck in the air.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Potential bug fix for RV going haywire for one person when someone sits down in a seat",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Added debug logs to help us figure out why some people are getting infinite spinners during joining game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added debug logs to help us figure out why some people can’t create games",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated error message on why you can’t create game to better help people understand them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Added information in main menu about your connection status to the steam relay network",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
