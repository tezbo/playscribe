  {
   "id": "rv-there-yet-373580@1.0.14520",
   "gameId": "rv-there-yet-373580",
   "displayName": "Patch 1.0.14520",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-11-06T10:56:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch: 1.0.14520 (06/11/2025)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The highlight of todays patch is keybindings for keyboard and mouse (gamepad is yet to come). We also fixed some issues with saves and focused abit on error messages and feedback.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Bugs",
     "items": [
      {
       "text": "Fixed bug where VOIP was stuck in toggle when switching to Push To Talk until the button was pressed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where a save file could be corrupted and stuck in infinite restarts by triggering a save when RV was destroyed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where you could end up with a save file where all players online in the session are dead",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where welder can be stuck in hand and still welding when it hit max limit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Balancing",
     "items": [
      {
       "text": "Nerfed bear spawning a bit. But bears are still bears so watch out",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Tweaks",
     "items": [
      {
       "text": "Updated vehicle input hints to match the style and placement used throughout the rest of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added popup with errors when failing to create a game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added so that in coming versions, the game will tell you if it's outdated if your steam clients knows about another patch",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated how the .pak-file is generated, so in coming patches, the patches will be smaller, this one will be bigger though",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added the device to voice input so you can see what microphone that is used in the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed some gamepad button conflicts for winch controller",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Features",
     "items": [
      {
       "text": "Add rebindable keys for keyboard and mouse",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
