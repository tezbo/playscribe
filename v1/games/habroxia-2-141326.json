   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "A new major update is out adding many features, improvements and fixes to Habroxia 2.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Major highlights are",
     "items": [
      {
       "text": "-New Arcade Mode that has Online Leaderboard Functionality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-New Arcade Style Controls Options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Support for Keyboard",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Controller Detection for DualShock 4, DualSense, Xbox One controller, Xbox Series X/S controller, Xbox 360 controller, Switch Pro controller, Steam Deck and more.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new",
       "platforms": [
        "pc",
        "xboxSeries"
       ]
      },
      {
       "text": "-New Achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-Many fixes and adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
