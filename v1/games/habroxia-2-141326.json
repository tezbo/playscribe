  {
   "id": "habroxia-2-141326@major-2022-04-28",
   "gameId": "habroxia-2-141326",
   "displayName": "Habroxia 2 - New Challenges Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-04-28T12:51:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "With today's update we have added a number of things to Habroxia 2. The theme of this update is new challenges.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-We have added loads of brutal new achievements to the game that will challenge the best of players.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-We have redone the way boost-rush mode progresses, and added a new level to it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-There are new upgrades in the shop to max out your ship even further.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-A number of bugs have been fixed up.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Steam Cloud saves are now supported.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-Full Screen / Windowed Mode and Window resizing is now supported.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
