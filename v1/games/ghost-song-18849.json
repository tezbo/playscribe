  {
   "id": "ghost-song-18849@post-2022-11-08",
   "gameId": "ghost-song-18849",
   "displayName": "Some bug fixes and small adjustments",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-08T11:13:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update 1.1.8e",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Implemented fix to hopefully correct the \"pink letterboxes\" issue non-16:9 displays were sometimes experiencing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Corrected issue where some players could become locked out of the room after dying during a battle alongside an NPC.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected an issue where a certain NPC would, in a certain situation, end up with a copy of himself in the world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Hulking Fist item no longer carries over in a new New Game Plus run, as it was capable of doing terrible things to the game if available from the start.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Aim mode has been adjusted for keyboard-only players such that it's now usable, if you hold the aim mode and pressing combinations of directions. A mouse aim feature is still being considered and experimented with.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Somewhat tuned down the Skab Device, which was heinously overpowered.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now zoom in closer on the map screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
