  {
   "id": "we-are-eva-191656@1.0.135",
   "gameId": "we-are-eva-191656",
   "displayName": "Update 1.0.135",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-11-08T08:28:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Complete overhaul of the game's input system",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added support for almost every gamepad that exists and that doesn't",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added more options for key binding",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "You can now remap your controller buttons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added full Steam Input API integration (even more devices!)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Eva will no longer guess what device you're using (now SHE KNOWS)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please note that due to a complete overhaul of the input system, this update resets your in-game keybindings.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please also note that this update may not be stable and may cause bugs, crashes, or demon invocations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
