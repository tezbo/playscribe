   "announcedAt": "2023-11-25T23:27:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "With more people appearing on the leaderboards, we wanted to make them prettier:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Leaderboards now show players' avatars",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Leaderboards are now scrollable (yes, they now contain more than six entries!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now directly access players' profiles from the leaderboards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many experimental VRAM-related game performance improvements",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
