  {
   "id": "arietta-of-spirits-123473@1.2.8.0",
   "gameId": "arietta-of-spirits-123473",
   "displayName": "Update 1.2.8.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-09-12T14:54:44.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've made various bug fixes and performance improvements to the game!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here is a more detailed list of changes in this update",
     "items": [
      {
       "text": "- Various visual and performance improvements on lower end hardware",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "- Fixed collisions issues in Mine maps",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "- Improvements to hit detection with Shade Roamer",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "- Added a warning marker to \"Sunken Behemoth\" Vortex attack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "- Fixes to depth issues with various items throughout the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "- Fixed an issue where player can get stuck when talking to Almona",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Other smaller quality of life updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
