  {
   "id": "arietta-of-spirits-123473@major-2020-06-02",
   "gameId": "arietta-of-spirits-123473",
   "displayName": "Development update: The Spirit Shield",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-06-02T16:09:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "During her adventure Arietta and her sidekick Arco gain the ability to use a powerful new move called the Spirit Shield. Used in tandem with the Spirit Sword the Spirit Shield open up both defensive and offensive ways to stay in the fight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It can be used to block enemy attacks and projectiles, either with a fast block or by creating a more lasting barrier around Arietta:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Spirit Shield uses Spirit Energy and it depletes quickly, so you'll have to keep your eye on the spirit power gauge! Luckily it will recharge by itself. The Spirit Shield may be utilized in other ways too, but you'll have to figure them out by yourself ;)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you at the next update! If you haven't already, please add the game to your Wishlist!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
