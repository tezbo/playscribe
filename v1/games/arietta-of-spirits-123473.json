  {
   "id": "arietta-of-spirits-123473@1.2.9.0",
   "gameId": "arietta-of-spirits-123473",
   "displayName": "Update 1.2.9.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-06-01T19:01:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released a new update for the game! The changes consist mostly of quality of life updates, but also include a fix for a major issue when running the game at 30 fps (for example, when in Steam Deck's 30Hz power save mode).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Additionally, we've added some features to support the speedrunner community. These features include a fixed memory location that contains the current state of the game (to enable support for autosplitting tools) and a way to completely disable the conversation dialogs via a change in the game's setting file.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can discuss and learn more about these features in our Discord channel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changelog",
     "items": [
      {
       "text": "Fix for issues when running game at 30Hz (Steam Deck power save mode)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added support for speedrunning features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fix issue where player can get stuck when visiting Almona",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Italian translation fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes to pixel perfect scaling at aspect ratios other than 16:9",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
