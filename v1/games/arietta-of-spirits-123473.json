  {
   "id": "arietta-of-spirits-123473@1.0.0.6",
   "gameId": "arietta-of-spirits-123473",
   "displayName": "Update 1.0.0.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-03-17T16:06:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The demo has been updated. This update includes a highly requested feature; support for remappable controls, among other various bug fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This will probably be the last update for the demo. We're still on track to release the full game later this year!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
