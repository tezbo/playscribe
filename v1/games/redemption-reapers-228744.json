   "id": "redemption-reapers-228744@1.0.4",
   "gameId": "redemption-reapers-228744",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-02T10:03:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch notes for version 1.0.4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where the game would not able to continue when Shadewalker moved to the same block as the object.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where enemies circled around to the area beyond their range of movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the game would not able to continue when receiving Whipclaw's attack with stonesoul.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the game would not able to continue when receiving Whipclaw's attack with Sentinel Stance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue where the game would not able to continue when guarding Whipclaw's attacks with martyr.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the unavailable follow-up attacks after Karren's foresight.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
