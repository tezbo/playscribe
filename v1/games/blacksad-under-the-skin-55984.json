  {
   "id": "blacksad-under-the-skin-55984@1.04",
   "gameId": "blacksad-under-the-skin-55984",
   "displayName": "Update 1.04",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-04-23T08:59:07.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new patch for Blacksad has already been released, here is what has been done:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixes freezes when Blacksad walks or when players perform actions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• The game can now be launched properly if the Xbox One Gamepad is already used",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "• Fixes a crash that would happen when players use the Deduction Menu during a loading screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Pressing buttons during loading screens don’t create bugs anymore",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixes a bug during the loading screen in the car while players are pressing RB multiple times",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixes the bug encountered when players open the Menu while Blacksad is on the phone",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• Fixes a bug that would happen when John refuses to take Sonia’s case",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "• The catsense is now properly displayed when players try to shoot the sniper",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Looking forward to hearing your feedback on this update!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
