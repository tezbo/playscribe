   "displayName": "Update 1.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-05-08T11:47:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We’ve just released Update 1.2.0, featuring a brand-new tutorial for Oil Refinery – The Simulation! The tutorial now starts automatically the next time you launch the game and must be completed once. After that, you can replay it anytime from the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This update is based entirely on your feedback - thank you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Now we want to hear more",
     "items": [
      {
       "text": "How do you like the new tutorial?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What would you like to see added or improved in the next update?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Let us know in the comments!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
