  {
   "id": "madison-164243@patch-2022-07-12",
   "gameId": "madison-164243",
   "displayName": "ACCESSIBILITY PATCH",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-07-12T14:46:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "ACCESSIBILITY PATCH",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've paid close attention to your feedback and we've been working on this new accessibility tab since the release of the game last week. We are just a team of two, so it took as a few days to implement and test everything out in order to make a bug-free patch.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This accessibility patch includes the ability to fully customize the following features:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "•Head Movement (Head Bobbing)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "•Arms Movement (Sway)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "•Camera Shakes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "•Reduced Camera Motion option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "•AIM Transparency (UI)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "•Camera Y-Axis (invert)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Also, some other fixes were implemented as well",
     "items": [
      {
       "text": "•Retouch to the inventory system (Luca can now carry 10 items with him)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "•Minor improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "•Minor fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you so much for playing MADiSON and supporting our work. We are now working on a full performance patch which should be up in the next couple of days.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
