  {
   "id": "madison-164243@major-2022-10-25",
   "gameId": "madison-164243",
   "displayName": "HALLOWEEN UPDATE",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-10-25T17:00:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "From 25 oct. 2022 to 1 nov. 2022 you'll be able to play with a PUMPKIN INSTANT CAMERA!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enjoy the Halloween Season playing with this camera and light your way with its ORANGE FLASH!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You'll be able to purchase the game and the POSSESSED CAMERA DLC with a 20% discount.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This update also includes some minor fixes",
     "items": [
      {
       "text": "• Minor fixes regarding the unlocking of the last achievement of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Japanese, Korean and many other languages localization fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "• Added a new \"mouse smoothness\" controller under the controller settings in the menu.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "• Minor fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "We keep working in order to improve the general experience of the game, so expect a few other updates in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Lastly, we have some exciting announcements to make in the near future regarding what's next, so please stay tuned, you won't regret it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
