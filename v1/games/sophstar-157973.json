  {
   "id": "sophstar-157973@1.07",
   "gameId": "sophstar-157973",
   "displayName": "Update 1.07",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-03-29T19:05:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've updated the game to 1.07 version. This was just some minor bug-fixes which apparently no one had noticed....",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Unlockables were being unlocked automatically before the condition to unlock then were met. If you get stuff unlocked before the right time, congratulations, consider it a bonus :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Online Leaderboards wasn't updating when changing difficulty on certain occasions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any problems with this version, just report them at the usual place:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
