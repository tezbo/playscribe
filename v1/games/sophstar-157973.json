   "displayName": "Update 1.10",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-05-04T22:11:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We updated Sophstar to V1.10",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It's using a newer Steam SDK, which may make the game run with less problems when using Linux (Including Steam Deck)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We also corrected a small bug where the incorrect frame animation would be used when the ship is re-entering the screen after exploding.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As usual, if you have any trouble with this version, just shout it out at our forum!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
