  {
   "id": "sophstar-157973@1.03b",
   "gameId": "sophstar-157973",
   "displayName": "Update 1.03B",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-02-21T05:14:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've updated the game to version 1.03B",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes made",
     "items": [
      {
       "text": "Added option to turn off the right analog stick",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Warning screen if you start the game without Steam connection and that you won't be able to upload hiscores",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug that caused controller vibration to stay on even when the player turned it off in the options screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "It is no longer necessary to have the Steam Overlay turned on to upload hiscores",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "If you find any problems with this version, please report us in the topic below:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We know there are still some minor issues with the display in Tate mode, and we're working to resolve them! We are also working on adding some accessibility options for colorblind players and players with increased sensitivity to light effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
