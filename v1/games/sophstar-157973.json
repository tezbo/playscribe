    {
     "title": "Changes",
     "items": [
      {
       "text": "We updated the game to version 1.09",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It just fixes a bug with the Score Attack mode, where sometimes when playing on the ORIGINAL Scoring Mode would make the Bonus Item not give the player any points.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hope it didn't hurt many people hiscores.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Anyway, if you have any trouble with this version, let us know in our forum!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
