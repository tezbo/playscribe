  {
   "id": "sophstar-157973@1.05",
   "gameId": "sophstar-157973",
   "displayName": "Update 1.05",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-02-27T20:11:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've updated the game to version 1.05. We've added a few more filters, now you can play with C64, MSX1, NES and other palette.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also made a major overhaul on the way the game writes Japanese texts and revised all the dialogs on this language. We are still doing another revision, but we believe the game may be now more enjoyable for japanese-speaking people",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also corrected a few typos on dialogs. We found hilarious no one so far had noticed Soph says something about \"Doing *grills* to become a pilot\", LOL :D",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're still beta-testing the Linux build, but we're going to take a couple of days to rest (It's Carnaval here in Rio de Janeiro, where we're based!). We expect the Linux version to be up very soon!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
