  {
   "id": "sophstar-157973@post-2023-05-10",
   "gameId": "sophstar-157973",
   "displayName": "Rollback to previous version",
   "kind": "hotfix",
   "kindBasis": "inferred",
   "announcedAt": "2023-05-10T22:31:17.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We had a small update a few weeks ago, it was a very small change, but we had 2 reports of the game randomly crashing after that update which seems to be related to the update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "So we're rolling back to the previous version which we know it was working properly and had no game-breaking problems.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upon until we find what's the problem we'll keep this version live.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
