  {
   "id": "sophstar-157973@post-2026-06-18",
   "gameId": "sophstar-157973",
   "displayName": "1.12B",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-06-18T19:42:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "As the user who discovered this bug put it: \"can't have a new update without causing more issues.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A bug introduced in the latest update could cause the game to crash during Stage 6. This issue has now been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The problem was caused by the migration to a newer version of GameMaker. We failed to catch it before releasing the update, and for that I apologize.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Everything should be working properly now (fingers crossed!).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
