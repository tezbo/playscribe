   "id": "sophstar-157973@1.13",
   "gameId": "sophstar-157973",
   "displayName": "Update 1.13",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2026-08-17T20:12:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We corrected a bug where dying during the True Last Boss could remove 2 lives instead of 1.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Trully sorry about that, it was added when we updated the game recently to use the new Gamemaker version (And thus adding the new bullet and video options)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Should be okay now. This should have gone live sooner, but Steam was being difficult to us last week, hehe. All is well, if anyone has any trouble, as usual, let us know!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
