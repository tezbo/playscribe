      {
       "text": "We've updated Sophstar to Version 1.11",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes to this version",
     "items": [
      {
       "text": "Fixed bug with level 5 background",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
