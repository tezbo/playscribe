  {
   "id": "sophstar-157973@1.06",
   "gameId": "sophstar-157973",
   "displayName": "Update 1.06",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-03-16T20:36:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've updated Sophstar to version 1.06.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now there's a Training Mode! You can practice any levels you've beaten before, without worrying about running out of lives! (You always have 98 lives on Training Mode :D )",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Unfortunately there was no way to get the progress you already had, so you'll have to beat the levels after the update to enable training mode on them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can also practice against just the bosses... even on their Hyper Mode! And they won't revert to normal mode if you die on training mode, so you can keeping practicing as long as you wish.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can also hold Select on the gamepad or Backspace on the keyboard for a quick level restart.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Just select \"Arcade Mode\", then select \"Training Mode\" and good luck!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We tested this update enough to make sure there were no new bugs after implementing Training Mode, but if any slipped through us, please report at the usual thread and we'll try to fix it as fast as we can!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Linux version should be coming next very soon!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
