  {
   "id": "sophstar-157973@major-2021-06-17",
   "gameId": "sophstar-157973",
   "displayName": "Demo update.",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-06-17T21:25:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We pushed a small update for our playable demo. It fixes a few issues in the different options menus, most importantly one that made the game free in the \"Redifine Controller Buttons\" screen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Now you can use Enter/ESC to go forward and back at the menus, and we hope the \"Press Start/Enter\" at the title screen makes clear that Enter works as the Start button for keyboard players :)",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
