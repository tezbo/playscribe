  {
   "id": "3d-arcade-fishing-31165@1.2",
   "gameId": "3d-arcade-fishing-31165",
   "displayName": "Update 1.2",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2017-02-13T10:34:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear fishing-friends.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are very happy to announce the latest version of 3D Arcade Fishing, v1.2, which brings a lot of new features and several improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Two new fish: Eel and the Brown Trout",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A completely new lake with five fishing spots: Loch Ness in Scotland",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New items in the store: Reels to make rolling in fish easier",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Steam Leaderboards! See who managed to catch the largest fish",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Statistics-page",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Steam-Achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Minor bug fixes und usability improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "V-Sync option",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Linux version",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Please let us know what you think about the latest version and keep fishing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": ":FishingHook",
     "items": [
      {
       "text": "Best,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tassilo, bumblebee.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
