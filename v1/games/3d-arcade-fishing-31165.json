  {
   "id": "3d-arcade-fishing-31165@1.10",
   "gameId": "3d-arcade-fishing-31165",
   "displayName": "Update 1.10",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2017-01-17T19:41:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear fishermen.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have just released an update to 3D Arcade fishing, including the following changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have increased the biting chance for bait in relation to the appropriate fish (meaning a pike is now more likely to bite a wetfly and so on)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fish too heavy to be pulled are now being pulled slowly instead of not at all",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fish are now becoming heavier as you progress in level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "stats of lower levels have been increased",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "the experience required for each level is reduced (which may result in your character being at a higher level now)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "some minor localization mistakes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "some minor bugfixes: Good fishing!: Best,: Tassilo @ bumblebee.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
