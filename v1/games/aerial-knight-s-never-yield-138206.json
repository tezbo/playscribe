  {
   "id": "aerial-knight-s-never-yield-138206@major-2025-10-07",
   "gameId": "aerial-knight-s-never-yield-138206",
   "displayName": "❗Update Required❗",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-07T14:21:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/37851830/baae466eb3bd5f5d9dd8705752f0e3111c29fd4f.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hey friends,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We want to let you know about an important update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A recently identified security vulnerability within Unity has been spotted, and while there is currently no evidence of impact on users, we’re taking all relevant steps to ensure you’re on the latest and safest version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To keep you safe, we’ve released a new patch that addresses the issue. Please update your game as soon as possible to stay protected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can read more about it here: https://unity.com/security/sept-2025-01",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, our priority will be on keeping our games as safe and enjoyable for everyone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Your Headup Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
