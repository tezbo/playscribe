  {
   "id": "aerial-knight-s-never-yield-138206@major-2022-02-15",
   "gameId": "aerial-knight-s-never-yield-138206",
   "displayName": "\"Da Update\" is available now for Aerial_Knight's Never Yield!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-02-15T13:31:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Nothing but good news for you today: \"Da Update\" is now available on Steam! I was busy working on the update to optimize my game even more to bring you the ULTIMATE Aerial_Knight's Never Yield experience!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Let's celebrate this with a brand-new trailer - including a fresh tune right from the Aerial_Knight's Never Yield soundtrack:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"Da Update\" adds a massive load of additional stuff and improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Bonus Levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Music",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Endless Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Leaderboards",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "UI Overhaul",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphical Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Achievements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Level & Story Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I hope you enjoy the update - and don't hesitate to share your feedback. I am really looking forward to hear your thoughts!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Till then and take care everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Neil 'Aerial_Knight' Jones",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
