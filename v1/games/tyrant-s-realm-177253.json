  {
   "id": "tyrant-s-realm-177253@major-2025-02-01",
   "gameId": "tyrant-s-realm-177253",
   "displayName": "Tyrant’s Realm Update – Steam Deck Verified & More!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-02-01T20:57:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Adventurers, we have some exciting updates for you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Steam Deck Verified!",
     "items": [
      {
       "text": "Tyrant’s Realm is now officially Steam Deck Verified! This means you can take your adventure on the go with full support for controls, performance, and UI. Whether you’re battling through dungeons or strategizing for your next fight, you can now do it anywhere, anytime.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Steam Trading Cards Are Now Live!",
     "items": [
      {
       "text": "The wait is over—Steam Trading Cards for Tyrant’s Realm have arrived! Start collecting cards as you play, trade with friends, and unlock exclusive badges, profile backgrounds, and emoticons to show off your Realm achievements. Who will be the first to collect them all?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Ongoing QoL Fixes & Future Content Updates",
     "items": [
      {
       "text": "We’re committed to continuously improving your experience in Tyrant’s Realm. Expect minor quality-of-life improvements in upcoming patches to refine gameplay, enhance performance, and address player feedback. But that’s not all—we’re also shifting our focus towards larger content updates in the future. Stay tuned for new features, mechanics, and surprises as we continue expanding the world of Tyrant’s Realm!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for being part of this journey. Your support means everything, and we can't wait to share what’s next. Keep conquering, strategizing, and forging your legend!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
