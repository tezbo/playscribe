  {
   "id": "squirrel-with-a-gun-213473@1.3.0.1",
   "gameId": "squirrel-with-a-gun-213473",
   "displayName": "Patch 1.3.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-11-01T20:00:34.000Z",
   "notes": [
    {
     "title": "Patch Notes 1.3.0.1",
     "items": [
      {
       "text": "General quality-of-life and bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "XBox controller vibration support for when you fire guns",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "New spooky skeleton outfit in the neighborhood",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "We are paying close attention to all bug reports and issues, and are excited to roll out our first major patch of the game (more to come!). The best way to let us know about bugs is through Steam discussions or our Discord channel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
