  {
   "id": "squirrel-with-a-gun-213473@major-2025-11-14",
   "gameId": "squirrel-with-a-gun-213473",
   "displayName": "Varmint Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-11-14T18:01:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Squirrel Squad! 🐿️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We ran into a little critter trouble while working on the Varmint Update... A raccoon stole our computer and tossed it in the trash! After an epic standoff, we’ve reclaimed our tech and we’re back on track. The Varmint Update will now arrive in December!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thanks for rolling with the chaos. What's coming is worth the rescue mission! In the meantime, check out the updated Roapmap below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
