  {
   "id": "squirrel-with-a-gun-213473@1.0.2",
   "gameId": "squirrel-with-a-gun-213473",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-09-06T00:02:58.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We wanted to take a minute to say a huge THANK YOU to everyone who has played Squirrel With a Gun thus far! It has brought us so much joy to see all the shenanigans you are getting up to in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are paying close attention to all bug reports and issues, and are excited to roll out our first major patch of the game (more to come!). The best way to let us know about bugs is through Steam discussions or our Discord channel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Patch Notes 1.0.2",
     "items": [
      {
       "text": "Fixed the cause of some random crashing that was related to hint boxes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Game will auto-save when grabbing important collectables like the Golden Acorns. Currently, auto-save will only function in The Neighborhood!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added 1 Reload Wedge to the Neighborhood, so the total number of Reload Wheels is a whole number.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed bug that was ejecting players out of water slides before they reached the end.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Various smaller bug fixes and optimizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Our team at Dee Dee Creations has been hard at work on this game for over two years now, so you can imagine how exciting this week has been seeing the game finally get into your paws. Go nuts!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
