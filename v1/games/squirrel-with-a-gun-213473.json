  {
   "id": "squirrel-with-a-gun-213473@major-2025-04-15",
   "gameId": "squirrel-with-a-gun-213473",
   "displayName": "The Gravity Gun Update is here!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-04-15T16:00:26.000Z",
   "notes": [
    {
     "title": "Are you ready to irradiate your foes, Squirrel Squad?",
     "items": [
      {
       "text": "Defy gravity in Squirrel with a Gun with an all new update! Unleash the raw power of physics with the Gravity Gun to maneuver new spaces & reach new heights in the neighborhood. 🔫 🐿️",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The update includes",
     "items": [
      {
       "text": "🔫 Relativity Bunker entry pod where you will receive an all-new cutting-edge weapon: the Gravity Gun",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🌰 5 new golden acorns to collect, bringing the game total to 70",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "⚠️ Nuclear fur skin: Squirrel will glow blue & standing nearby humans causes their hair to fall out",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "🏘️ After receiving the Gravity Gun, 3 gravity gun dispensers will become available in each of the the 3 neighborhood regions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
