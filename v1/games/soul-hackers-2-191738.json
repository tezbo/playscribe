  {
   "id": "soul-hackers-2-191738@1.02",
   "gameId": "soul-hackers-2-191738",
   "displayName": "Update 1.02",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2022-11-17T00:00:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you for playing Soul Hackers 2! This release is Soul Hackers 2, version 1.02.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Newly added functions",
     "items": [
      {
       "text": "■ Dash function",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A \"Dash\" function has been added to Ringo’s movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The user can toggle between \"Normal\" and \"Dash\" at will. While in Dash Mode, Ringo's walking and slashing speeds will increase.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Due to the addition of the dash function, the effect of the Summoner Skill \"Assassin's Steps\" has been changed to: \"For a given distance, enemies will ignore Ringo.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "■ Fast Battle Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A \"Speed Up\" mode has been added to battles. Players may freely toggle between normal and high-speed combat.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "■ Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted how long loading-screen tips are shown.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed the flow of on-screen prompts during soul level increase to reduce the risk of incorrect input from accidental button presses.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the ability to teleport directly to shops from the City Map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted enemy spawn rate in dungeons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted skill inheritance rates during demon fusion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Other minor changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "■ Other changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added four new demons: Pixie (Soul Hackers Ver.), Neko Shogun, Aitvaras, and Isis.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Note: The above bonus demons do not count toward the Registration Percentage in the Demon Compendium or the achievement \"Compendium Completionist\".",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
