   "id": "touhou-luna-nights-105447@major-2021-01-18",
   "gameId": "touhou-luna-nights-105447",
   "displayName": "The Cirno Update is Here!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-01-18T18:21:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear fans,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Sorry for the wait, we have updated the game to add the Cirno boss fight on all platforms!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We hope you enjoy battling Cirno to your heart's content.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would like to thank everybody for supporting Touhou Luna Nights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The latest work from Team Ladybug, Record of Lodoss War: Deedlit in Wonder Labyrinth has also just received a major update adding stage 3+4, with a celebration discount to boot! As expected of Team Ladybug, the quality of this game is phenomenal. The title is planned to leave early access into full release this Spring along with a price revision so please take this opportunity to get in on the early access!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
