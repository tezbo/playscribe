  {
   "id": "freezer-pops-163296@1.0.1a",
   "gameId": "freezer-pops-163296",
   "displayName": "Patch 1.0.1a",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-01-24T21:14:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This patch has a few improvements/corrections only for the Brazilian Portuguese translation. Check them out:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In both routes, Alexandre mentioned the names of their partners which don’t correspond to that route. Now, we’ve fixed this;",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "There is one option on Fernando’s route which keeps appearing in English even if you are on the Brazilian Portuguese version. After months of trying to understand why this was happening, we have fixed this too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you all for supporting us and don’t forget to follow our Steam page because new games will be announced soon.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Male Doll Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
