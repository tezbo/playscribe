  {
   "id": "freezer-pops-163296@2.1.2a",
   "gameId": "freezer-pops-163296",
   "displayName": "Patch 2.1.2a",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-07-05T22:07:46.000Z",
   "notes": [
    {
     "title": "A patch to fix a few bugs. Check it out",
     "items": [
      {
       "text": "There are a few scenes in which some tracks overlapped. Now, they have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "A bug in which Fernando's scene (the image, literally speaking) freezes has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The main game now needs 1400 MB (or 1.4GB) of disk space.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The DLC now needs 230 MB of disk space.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "TO AVOID BUGS, PLEASE, PRESS F11, DELETE ALL SAVE FILES AND RESTART THE GAME!",
     "items": [
      {
       "text": "Male Doll Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
