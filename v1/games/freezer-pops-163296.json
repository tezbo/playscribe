  {
   "id": "freezer-pops-163296@1.0.2a",
   "gameId": "freezer-pops-163296",
   "displayName": "Patch 1.0.2a",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-01-30T16:30:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "--> This patch is exclusively to fix a black screen problem <--",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After we updated the game to version 1.0.1a, some people messaged us to tell us about a black screen bug. When they started the game, buttons appeared but the images don't. We've made some tests, a tester has tested this new version, and seems the bug has been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Feel free to join Discord to report any bugs you found and don't forget to follow our Steam page!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Male Doll Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
