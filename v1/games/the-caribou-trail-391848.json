 "releases": [
  {
   "id": "the-caribou-trail-391848@hotfix-2026-05-22",
   "gameId": "the-caribou-trail-391848",
   "displayName": "Field Notes - Display Hotfixes",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-05-22T15:59:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello b’ys,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What a week it’s been! Thank you to everyone who has taken interest in our game, whether you played the full game, demo, or asked questions in the community discussions. Your comments and reports are more than appreciated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This week’s hotfixes are aimed at streamlining the display settings and supporting additional resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Added fullscreen native support for ultrawide monitors",
     "items": [
      {
       "text": "2560x1080",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "3440x1440",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "3840x1600",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "“Windowed Fullscreen” now properly displays the actual resolution the game is being rendered at.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Bug fixes",
     "items": [
      {
       "text": "Fixed an issue when playing in “Windowed” mode that caused the window to be reset when returning to the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare crash when attempting to get data from a non-existent monitor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "General stability improvements when selecting Fullscreen mode.*",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "*Fullscreen mode in Unreal Engine games works best when either:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Playing the game on your “primary display”, as set in your Windows settings, at any resolution.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Playing the game on your other displays at their native resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Map fixes",
     "items": [
      {
       "text": "Following your reports, we’ve noticed that players that have a GPU just under the minimum requirements for the game - specifically GPUs with 4gb VRAM - may encounter a blurry map. We have identified a promising solution that would fix this issue for players that are slightly under spec but are still able to run the game otherwise. We still need more time to test our solution, but expect some updates soon.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Francis",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
