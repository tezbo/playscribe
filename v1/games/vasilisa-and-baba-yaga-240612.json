   "displayName": "Hotfix 1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-10-28T09:15:38.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Updated loading screen. Now the game will not crash when loading on the studio logo.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug when Vasilisa sometimes lost control after a battle with a log in the swamp.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Vasilisa could disappear when replaying any goalpost.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Vasilisa's hands could get hung up in the “Brushing Baba Yaga's Hair” mini-game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Other small fixes and improvements: Many people ask us where and when we will be able to listen to music from the game. Friends, very soon we will release the soundtrack on streaming platforms and Steam as DLC. Thank you all for your anticipation and feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
