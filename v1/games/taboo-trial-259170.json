  {
   "id": "taboo-trial-259170@major-2024-05-30",
   "gameId": "taboo-trial-259170",
   "displayName": "5/30 Update (1)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-05-30T01:53:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "1. Fixed some issues with missing descriptions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Adjusted the base effect of Wolf's Fury, now the energy consumption increases the duration linearly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. The settings interface has added a display option for damage numbers, allowing you to choose to show base damage numbers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "4. Valkyrie's Strength is guaranteed to level up successfully before level 40.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "5. To celebrate the launch of version 5.0, a double experience buff has been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: To ensure the best gaming experience, please make sure you have downloaded the latest version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
