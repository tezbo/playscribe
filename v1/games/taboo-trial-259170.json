  {
   "id": "taboo-trial-259170@major-2024-06-11",
   "gameId": "taboo-trial-259170",
   "displayName": "6/11 Update (1)",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-11T12:27:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear Player,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Greetings and Happy Dragon Boat Festival! We have prepared some token rewards for you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The contents of this update are as follows",
     "items": [
      {
       "text": "1. Fixed the issue where the Weapon Master's attribute increase was incorrect.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "2. Ascending ancient equipment with Spiritual Water will no longer reduce the properties of the ancient affix.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "3. Provided three Spiritual Water as compensation for players who have reached floor 50 in Difficulty.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note: To ensure the best gaming experience, please make sure you have downloaded the latest version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
