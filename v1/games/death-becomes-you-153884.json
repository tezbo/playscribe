  {
   "id": "death-becomes-you-153884@major-2022-04-20",
   "gameId": "death-becomes-you-153884",
   "displayName": "UPDATE: new bonus scene, fanart gallery, and more~!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-04-20T21:50:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We're excited to update the game today with a bonus epilogue! If you wanted to see more of Daniella, Apolline, Sophie, Alice, and the main character, this scene shows more of what happened after the ending.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We also have a new fanart gallery in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You'll need to have unlocked both existing epilogues to access these 2 new features, but luckily we've also added much more detail to the walkthrough so you can get those endings if you previously missed them!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
