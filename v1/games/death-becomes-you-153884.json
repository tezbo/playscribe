   "id": "death-becomes-you-153884@major-2023-06-20",
   "gameId": "death-becomes-you-153884",
   "displayName": "UPDATE: July 18th release date for Lachesis or Atropos",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-06-20T16:11:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Quill Yuri is excited to announce we're publishing 4noki's horror mystery yuri visual novel, Lachesis or Atropos, on Steam.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "We pushed the date on Valve's recommendation; the previous date had reduced algorithm visibility due to overlap with the Summer Sale. Thank you for the patience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A private investigator visits a small town after recovering from a coma. She searches for her mentor's lost beloved, but the very eyes she was born with, those that can see the black strings of hate, drag her down into the darkness of conspiracy.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
