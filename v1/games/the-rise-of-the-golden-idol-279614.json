  {
   "id": "the-rise-of-the-golden-idol-279614@1.1.0",
   "gameId": "the-rise-of-the-golden-idol-279614",
   "displayName": "Patch 1.1.0",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-02T13:31:04.000Z",
   "notes": [
    {
     "title": "In this patch we have addressed the following issues",
     "items": [
      {
       "text": "Removed white frame in full-screen mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achievements should re-trigger when you visit a scenario, if you did not receive the correct achievement after finishing a scenario.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Removed ability to break the game on Steamdeck using full-screen toggle.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Now there is a zoom functionality (accessible using mouse-wheel or button Y on a controller).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Display settings are stored per device, instead on the cloud.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "External controller disconnection should not remove Steamdeck inputs anymore.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A few minor typos fixed in the texts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
