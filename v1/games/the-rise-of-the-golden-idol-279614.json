  {
   "id": "the-rise-of-the-golden-idol-279614@1.2.0",
   "gameId": "the-rise-of-the-golden-idol-279614",
   "displayName": "Patch 1.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-12-19T10:53:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Dear detectives!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have pushed out a new update, containing the following improvements:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Numerous text tweaks in all 12 languages, thanks to your feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Option to move phrases by clicking instead of dragging.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ability to zoom into text in close-ups (we introduced this in the previous patch, but forgot to document it!).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Better controller support. Now, the settings menu contains controls mapping information, and there are button prompts when the game detects a controller.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed Z-ordering bug that sometimes made collected words visible through menus and puzzle panels.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improved visibility of certain hotspot highlights.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Some puzzles now accept alternative words as correct, to reduce the number of cases in which the player has figured out the answer but is deemed ‘wrong’ for using the unintended word.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Basic mod support, which allows for easier extending of the game with features like fan translations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
