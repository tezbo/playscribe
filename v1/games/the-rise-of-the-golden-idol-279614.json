  {
   "id": "the-rise-of-the-golden-idol-279614@1",
   "gameId": "the-rise-of-the-golden-idol-279614",
   "displayName": "Hotfix 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-03-06T16:11:20.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Important!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Due to changes in puzzle logic in the third scenario \"Sickness and Health\" your savegame maybe corrupted and the scenario will crash the game. To fix it, take the appropriate savegame from our savegame repository: Other changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved visual inconsistencies in all scenarios (e.g., weapon look in ship past and present).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Updated puzzles to be more accepting of alternative inputs (e.g., the weight puzzle in Whishbloom scenario).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a minor plothole in \"Last Orders\" scenario with the map puzzle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Addressed a few typos in the DLC texts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
