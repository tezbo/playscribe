  {
   "id": "rune-factory-guardians-of-azuma-250922@1.0.4",
   "gameId": "rune-factory-guardians-of-azuma-250922",
   "displayName": "Patch 1.0.4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-20T21:27:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Adjusted the frequency of certain Woolby voice lines.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where player names could not include character names from the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in which certain Bonding Quests and main story quests could not progress.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue in which some Ema Plaque Requests and Village Missions could not be completed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the Sacred Treasure \"Parasol\" could not ride updrafts when the framerate was too high.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Art book and soundtrack were updated with minor corrections.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor fixes and adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your patience while we address these issues. Please stay tuned for any additional updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
