  {
   "id": "rune-factory-guardians-of-azuma-250922@1.0.5",
   "gameId": "rune-factory-guardians-of-azuma-250922",
   "displayName": "Patch 1.0.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-07-15T17:04:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adds the ability to adjust village farmer behavior in the Options menu. You can now toggle the following tasks on or off: sow seeds, water fields, and harvest crops.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted the volume of certain lines for Zaza and Woolby in Japanese.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "The Sacred Sword can now harvest crops over a wider range.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new warp points for Spring Village's and Autumn Village's development zones.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a bug where players could not obtain the Evasive Leg Guards. You can now purchase them at blacksmiths once your village level is high enough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the ema plaque request \"The Divine Sword Dance is the Best!\" would not be available.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted the Blade Shard drop rate so you can now obtain them from high-level toad and fallen warrior enemies.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed bugs that halted progression during certain Bonding Quests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a crash bug upon start-up caused by failure to obtain display information.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Minor bug fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your patience while we address these issues. Please stay tuned for any additional updates.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
