  {
   "id": "rune-factory-guardians-of-azuma-250922@1.1.0",
   "gameId": "rune-factory-guardians-of-azuma-250922",
   "displayName": "Update 1.1.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-10-02T02:09:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The Rune Factory: Guardians of Azuma 1.1.0 update is now available. This update includes bug fixes and quality-of-life adjustments, but also features additional content like expanded Bond Levels and rewards, a new development zone in the Summer Village, and a challenging Boss Gauntlet. You can check out the full list of all the additions below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45172005/59fa87e16f48e77657a62f4f054b5910bfc28393.png\"][img src=\"{STEAM_CLAN_IMAGE}/45172005/e07714b89077017d300092669d3ca325cc9b6041.png\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adventuring",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added four extremely difficult boss gauntlets which you can challenge after completing the main quest “Guardians of Azuma.”: Village Life",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a new development zone to Summer Village which you can access after reaching Village Level 8.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Upon reaching Village Level 10, the maximum number of facilities you can place has increased by 5, and the maximum number of decorations you can place is now 256 across the board.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Expanded the Storage Box capacity from 810 to 1,200.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Expanded the Seeds & Such capacity from 300 to 400.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tsubame’s Early Bird Boutique will now sell Chocolate after you reach a certain Village Level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added sorting functionality to the Village Building menus, forging menus at blacksmiths, and building menus at carpenters.: Socializing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Increased the maximum Bond Level to 100.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "You will earn various recipes and items at certain Bond Levels for each character.: Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where villagers tasked with farming would sometimes harvest crops even when the action was set to Off.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bugs related to some NPC conversations during festivals and contests.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Additional minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
