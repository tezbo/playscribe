  {
   "id": "shoulders-of-giants-ultimate-309111@1.9.6",
   "gameId": "shoulders-of-giants-ultimate-309111",
   "displayName": "Patch 1.9.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-08-22T18:40:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Drop-in camera now stops moving when you pause the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed bug where magnifying glass could hit robot in best friend mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug where the Spear air attack could get stuck inside enemies with solid collisions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reworked the skill tree UI to be less prone to scaling issues/wiggles/jiggles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a case where players could lose a BFM match if the frog spawned too soon before the robot",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "The dummy/target health in the hub world scales with HEAT in the late game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Possible workaround for engine ability system crash",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Balance update: Shield knights now deflect a more forgiving angle of melee attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
