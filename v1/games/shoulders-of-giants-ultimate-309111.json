  {
   "id": "shoulders-of-giants-ultimate-309111@1.9.2",
   "gameId": "shoulders-of-giants-ultimate-309111",
   "displayName": "Hotfix 1.9.2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-08-12T20:43:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "1.9.2 Hotfix is deployed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This minor update addresses a few small issues",
     "items": [
      {
       "text": "We've added a setting to adjust the Field of View change when sprinting. The text is still being localized but we know some folks needed this, so its in right now!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an AI issue where the Bone Swarm boss would not chase you sometimes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a very rare (afaik this hasn't hit anyone outside of our team) crash bug relating to the Darkness core",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Plasma projectiles no long live forever if you shoot them into the sky",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The cracks created by the Geyser ability disappear much sooner",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased button double-press protection for gamepad players in the level select menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Have fun!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Kyle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
