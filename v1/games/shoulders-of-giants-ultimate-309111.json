  {
   "id": "shoulders-of-giants-ultimate-309111@1.9.3",
   "gameId": "shoulders-of-giants-ultimate-309111",
   "displayName": "Patch 1.9.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-08-13T20:38:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Another small set of fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where input rebindings would not get saved (big goof on our part here--this worked in development builds but not in the real installed game🙃)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted some sound effects for storm missions to be less distracting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a bug where the plasma projectiles would sometimes teleport to the center of the map for multiplayer clients",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Butterfly crystals should now be visible on goo enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localization Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Note for crossplay players: this update is still in the process of releasing everywhere else.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Have a great day!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Kyle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
