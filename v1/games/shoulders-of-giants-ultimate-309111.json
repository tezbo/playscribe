  {
   "id": "shoulders-of-giants-ultimate-309111@1.9.5",
   "gameId": "shoulders-of-giants-ultimate-309111",
   "displayName": "Update 1.9.5",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-08-16T20:48:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a networking issue that could cause butterfly shot to not work for client players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated some English ability descriptions for clarity",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Deployed turrets now consistently orient properly for client players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Best Friend Mode: sticky frog projectiles should no longer *ever* attach to your robot best friend (as opposed to merely *usually* not attaching)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You can now rebind the left and right arrow keys (fixed in 1.9.4)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added more instrumentation to crash logs (btw please press \"Send\" if the game crashes on you!). All reported game crashes have been internal GPU crashes or deep in Unreal's engine code, making them much harder to track down. This extra info will help.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
