   "announcedAt": "2024-01-10T01:03:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update ver. 1.0.1.5 for Sonic Superstars is live now! This update offers bug fixes and the option to reset Time Attack scores. Please be sure to download before playing Sonic Superstars.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*This Time Attack score reset feature will reset only your own score on the local save data. Scores shown on “Top Rank” will not be affected by this.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
