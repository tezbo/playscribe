  {
   "id": "sonic-superstars-252478@major-2023-10-20",
   "gameId": "sonic-superstars-252478",
   "displayName": "Update About Cross-Platform Play in Online Battle Mode",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-10-20T23:26:53.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today, we are releasing a patch that moves the Epic Game account login prompt from appearing at game startup to only appearing when a player starts online Battle Mode. This login is currently required to play in online Battle Mode on Steam. You should no longer see the prompt once you have synched your Epic and Steam accounts. Stay tuned to this space for future updates.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
