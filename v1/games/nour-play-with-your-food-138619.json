      {
       "text": "Updated food palette binding to Shift + Spacebar.: Spacebar acts as the food palette spawn button while the menu isn't open.: We know how inconvenient the previous binding was, it was annoying for us too. Sorry! Meant to change that a while ago tbhhh",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Visual updates to the backdrop of Hamburger scene.: the rainbow looks a lil less jank. Check it out!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "KBnM magnet control issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some pause menu items being unselectable with mouse in certain levels",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Camera movement in Donut level issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
