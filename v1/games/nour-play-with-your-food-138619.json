  {
   "id": "nour-play-with-your-food-138619@1.2.1",
   "gameId": "nour-play-with-your-food-138619",
   "displayName": "Update 1.2.1",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-08-31T09:23:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Since Nour is out on Nintendo Switch we're bringing in some optimizations to the game experience!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Meta Spawn Cap: The spawn cap for physics objects is now shared across all items and scales based on platform tier. A slider option has been added for PC players to adjust the spawn cap.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "General Fixes",
     "items": [
      {
       "text": "Addressed various issues, including tool movement bugs in the burger scene, fixed noodle creation in the meat grinder, and corrected audio instance limits.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Popcorn level Fixes",
     "items": [
      {
       "text": "Resolved issues with de-spawned food not replenishing and frozen kernels not responding to inputs. Jellyfish no longer collide with problematic stage objects in the Popcorn level.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Level Unlocks",
     "items": [
      {
       "text": "Fixed an issue where levels were not unlocking correctly after progression.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Vibration and Rumble Adjustments: Adjusted rumble intensity and fixed issues with vibration on multiple platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collider Fixes: Adjusted ground mesh colliders in the Toaster level to improve performance and fixed the egg shatter threshold.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I'm still tryna add fun stuff in future updates too, lemme know if there's any foods you're dyin to see in Nour 🍨🍜🍥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
