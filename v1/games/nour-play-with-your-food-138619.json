  {
   "id": "nour-play-with-your-food-138619@1.1",
   "gameId": "nour-play-with-your-food-138619",
   "displayName": "Update 1.1",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2023-11-01T09:52:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We don't like bugs in our food so we squished some of them. Here's some of the ones we squished:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mic feature scaling adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial failsafes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug preventing some liquids from rendering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a few missing translations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Quality of life",
     "items": [
      {
       "text": "Right analog stick can move spawners",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Blowtorch is more responsive",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tools ignore invisible walls that would otherwise obstruct them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game's framerate is limited to keep it from making everyone's GPU's way too hot. We ain't tryina cook an egg on your nvidia geforce.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "New!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Move Tool! Use R2 or Mouse1 to pick up and move foods",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Achievements!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After a lot of wrestling with tech, achievements have been added in! Apologies for the wait.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "KickStarter backers have been added to credits as well. Sorry they were missing for so long! They were meant to go in before our launch date, but we dropped the ball on prioritizing them above other technical issues that were coming up. We put a lil secret in the game for y'all that we'll outline how to reach in a KS email :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-tj",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
