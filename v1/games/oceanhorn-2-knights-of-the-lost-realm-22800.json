    {
     "title": "Changes",
     "items": [
      {
       "text": "The updated fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "an issue where controls stopped working properly when playing for a long time with high FPS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "the game not pausing automatically when the Steam overlay gets opened",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "the game not being playable on super ultra wide monitors due to overlapping UI",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
