  {
   "id": "oceanhorn-2-knights-of-the-lost-realm-22800@major-2023-07-31",
   "gameId": "oceanhorn-2-knights-of-the-lost-realm-22800",
   "displayName": "Pre-Launch Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-07-31T13:29:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi Everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "we're thrilled to release the game soon and can't wait to see Windows PC and Steam Deck players getting their hands on the game. Here's a quick tech update of what you can expect:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "FOV Slider",
     "items": [
      {
       "text": "We implemented a FOV slider. Please let us know if you make use of this kind of feature often and if you like it in Oceanhorn 2. :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Steam Deck",
     "items": [
      {
       "text": "We played the game entirely on Steam Deck and can confirm that it works from start to finish.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
