  {
   "id": "murderous-muses-190478@1.03",
   "gameId": "murderous-muses-190478",
   "displayName": "Patch 1.03",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-04-20T15:24:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Patch 1.03 is here and it's our biggest yet, with new stuff to try, find and collect...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Keyword Indicators",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new row of indicators will appear under the current keyword plaques from the second run onwards. These allow you to quickly find the videos you've never seen before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Scorecard Icons",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A new set of 31 suspect specific stamps have arrived to give your runs a rating, and will appear for everything in your run history so far.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Teleporter Chairs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New teleporter chairs have been added to each treasure room to quickly shift you back to reception. Or just run. The choice is yours!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "+ Added Higgins voiceover hints to Urn room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Added new Higgins note to reveal new keyword indicators",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ FOV slider in settings now display vertical degrees",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Camera sensitivity values below default are increasingly slower than before",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Added first run message that spacebar (X button) toggles fullscreen video during playback",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased timeouts on phone puzzle to prevent confusion with controller focus",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed shoulder inputs on controller to match direction of inventory movement and new indicators",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed puzzle keys persisting in day mode if left at night",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed experimental VR code",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
