  {
   "id": "murderous-muses-190478@1.04",
   "gameId": "murderous-muses-190478",
   "displayName": "Patch 1.04",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-05-24T12:10:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Update 1.04 includes a new room to explore, new ways to consume content, new help videos, hints and more Eyes of Mordechai to discover! We hope you enjoy this last major update for Murderous Muses, and from all three of us here, thank you for playing <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PATCH NOTES",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ New replay room behind urn room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Full playback wall to show lifetime unlocked video memories",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Suspect video screens that show related clips (fragments) together",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Central TVs replay unlocked Mirlhaven's Unsolved Mysteries",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ Suspect lore plaques now activate to show video sequence that revealed painting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ New hint TV video appears in tutorial first run, night one",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ New hint TV video appears in tips hotline from night two permanently",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ New restoration table in NightGallery1, which will appear for new playthroughs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ New hints",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "+ New Eyes of Mordechai to find beyond staffroom",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ".Disable hints in settings with 'skip tutorial'",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ".Sasha loan note removed to stop people trying to re-watch phonecall on reception TV",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ".Branched Higgins note to avoid confusion for players who knew how to solve police walls",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ".Staffroom only accessible from night 2 on first run, to avoid overwhelming some players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ".Smoothed out the stairs collider in ball-roll puzzle to avoid player being caught on the bottom",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ".Fixed numeral indicators for branching and puzzle keywords to show the act they currently appear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ".Fixed subtitle display for some Turkish characters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ".Potential fix for Mac OS \"hang on accuse\" issue",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
