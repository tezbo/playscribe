  {
   "id": "agatha-christie-the-abc-murders-17470@post-2016-02-19",
   "gameId": "agatha-christie-the-abc-murders-17470",
   "displayName": "You can now play Agatha Christie - The ABC Murders in Russian!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2016-02-19T16:26:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello detectives!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "You've been waiting for it since our previous announcement, the Russian language is now available for Agatha Christie - The ABC Murders!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It took a bit longer than expected but we wanted to be sure that the translations were good enough for all our Russian players and we hope that they'll meet your expectations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As promised, the Portuguese language will follow soon, so please stay around.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
