  {
   "id": "agatha-christie-the-abc-murders-17470@major-2016-04-20",
   "gameId": "agatha-christie-the-abc-murders-17470",
   "displayName": "Update for Agatha Christie - The ABC Murders !",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2016-04-20T14:49:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In order to provide you with a better gaming experience during your investigations, we’ve improved the game’s graphics, sound and gameplay!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here’s a summary of the improvements we’ve made",
     "items": [
      {
       "text": "• Polish added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Brazilian-Portuguese added",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Various improvements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "• Correction of minor bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "GRAPHICS AND ANIMATIONS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": " Corrected lip-synchronization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": " Improvement of certain characters’ animations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": " Improvement of looks exchanged by characters during certain dialogues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "SOUNDS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": " Added/corrected voices",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": " Some sounds have been improved and added (puddle, doors opening, suitcase, movements, etc.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "TEXT",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": " Corrected texts",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": " Size of emotion text improved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "GAMEPLAY",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": " Improved camera and camera animations in certain scenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": " Certain collision zones in the puzzles have been reworked",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": " Some collision adjustments in the “little grey cells” menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
