  {
   "id": "agatha-christie-the-abc-murders-17470@major-2020-10-06",
   "gameId": "agatha-christie-the-abc-murders-17470",
   "displayName": "Agatha Christie - The ABC Murder: Major update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-10-06T16:03:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we are publishing a major update for Agatha Christie – The ABC Murders.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "With this update we reworked several aspects of the game",
     "items": [
      {
       "text": "· A brand-new \"Brain cells\" interface reinforcing player’s immersion",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· A smoother gameplay to provide a better experience",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Now 4K compatible",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Framerate increased from locked 30FPS to 60FPS",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Addition of multiple tutorials to guide players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· New lighting effects",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· Reworked sound design",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "· New anti-aliasing more on par with the artistic direction of the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "With those new additions, there is no better time to rediscover one of Hercule Poirot's most famous investigations!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
