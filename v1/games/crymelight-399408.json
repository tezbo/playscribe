  {
   "id": "crymelight-399408@major-2026-09-19",
   "gameId": "crymelight-399408",
   "displayName": "Full Demo Update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-09-19T13:25:37.000Z",
   "notes": [
    {
     "title": "♠ Full Demo Updated",
     "items": [
      {
       "text": "Since the Full Demo launched on September 17, many of you have played it. Thank you very much.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The development team has been delighted to see your impressions coming in through our official Discord and X since the demo launched. We also thank everyone who has submitted information through the bug report form in the Steam Community. We sincerely apologize for any inconvenience caused by these issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "In response to your reports, we worked on fixes and updated the Full Demo on Steam® today, Saturday, September 19, at 9:00 p.m. JST. We have also enhanced some of the game’s presentation.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "♠ Update Details",
     "items": [
      {
       "text": "・Revised the English translation of how the White Rabbit refers to themselves in some lines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted Dum’s attack power in Story Mode and Normal Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where scenario auto-play would not remain enabled",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Enhanced some presentation elements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed an issue where the interaction UI would not appear at the hub",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Corrected the activation conditions for certain skills",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Fixed other minor bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The development team reviews each piece of feedback and every bug report we receive.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To report a bug, please use our official Discord or the bug report form linked in the Steam Community thread below.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Official Discord",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Steam Community Thread with Bug Report Form",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "▼Play the Full Demo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[dynamiclink href=\"https://store.steampowered.com/app/3891160/CRYMELIGHT/\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
