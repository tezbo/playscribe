   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed bugs with some achievement logic",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where random photos weren't selected properly in Procedural Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where bonus level keys could be found in Litter Box Mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where tutorial prompts could display incorrect inputs",
       "ps5ProOnly": false,
       "pcOnly": false,
