  {
   "id": "catlateral-damage-remeowstered-135589@1.1.5",
   "gameId": "catlateral-damage-remeowstered-135589",
   "displayName": "Patch 1.1.5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-09-14T17:07:00.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello again! Almost another whole year has passed since Remeowstered launched! As a small celebration, a new patch with some fixes, adjustments, and additions has been released.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Here are the full patch notes (v1.1.5)",
     "items": [
      {
       "text": "Fixed a bug where charged swats weren’t working",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where an empty photos UI would show on the pawse screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where procedural goals could have photo rewards when all photos had been collected",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Updated flying insect movement to prevent it from going too high or under the floor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the maximum camera sensitivity value again",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Added achievement descriptions to the HUD pop-up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added a different icon to the energy meter while using catnip",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added functionality to open the Steam Overlay when pressing a controller’s home button",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added support for Steam Dynamic Cloud Sync",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "(This patch will go live on consoles over the coming days.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thanks for enjoying the game and being the best cats you can be! :nippy2: :wil2: :lyn2:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
