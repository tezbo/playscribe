  {
   "id": "shakedown-hawaii-14694@1.1.7",
   "gameId": "shakedown-hawaii-14694",
   "displayName": "Update 1.1.7",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-12-05T16:59:48.000Z",
   "notes": [
    {
     "title": "v1.1.7 - December 5th, 2025",
     "items": [
      {
       "text": "A new Shakedown: Hawaii update is now live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "This quality-of-life update focuses on UI refinements, bug fixes, and optimizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Many improvements that made their way into the game when it was ported to mobile have now been brought over to the PC version. Most notably, mouse controls have been improved throughout the UI, minigames, and map screen (thanks to refinements made for touch screens).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thanks, again for playing! I hope this update makes the game an even smoother experience for all of you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Brian, Developer of Shakedown: Hawaii",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
