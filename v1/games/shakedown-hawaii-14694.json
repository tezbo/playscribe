  {
   "id": "shakedown-hawaii-14694@1.1.2",
   "gameId": "shakedown-hawaii-14694",
   "displayName": "Update 1.1.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-10-31T18:18:47.000Z",
   "notes": [
    {
     "title": "v1.1.2 (PC) - October 31, 2020",
     "items": [
      {
       "text": "The new v1.1.2 update is now live!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added PS5 DualSense controller support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "PS4 controllers can now use R2 as an alternate fire button.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added new polished pixel art for the circuit board shakedown minigame.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The \"daily revenue\" icon now shows both corporate and protection revenue, not just corporate.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Enemy AI improved in the \"Catch a Break\" shakedown mission.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Enemies in missions \"Ceramic Parable\" and \"Clean Sweep\" now attack more aggressively if the player tries to use a vehicle to take them down (when playing under normal difficulty).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a shakedown bug which caused some missions to be stuck in a \"Mission Failed\" loop.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Adjusted the car export garage's max cars per week to 5.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "balance",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed some visual glitches in 1X zoom mode.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed a map zoom bug.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Misc. optimizations for low end PCs.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Misc. minor bug fixes and improvements.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thanks so much for playing! I hope these improvements make the game even better for you. If you discover any game bugs or issues, don't hesitate to email support.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "For more information on the previous updates, check out this post (v1.1.0) and this post (v1.1.1).",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
