  {
   "id": "nanoapostle-279485@major-2024-09-18",
   "gameId": "nanoapostle-279485",
   "displayName": "Update: Boss Fixes & More",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-18T15:59:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've got a larger update to address some of the issues in the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Anita",
     "items": [
      {
       "text": "Enhanced the values of certain modules.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted the \"Injury Plague\" module, adding a cooldown for Infect application and reducing the energy gain reduction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where the status of some modules was not correctly displayed on the HUD.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Charge Shoot would apply more infections than the maximum allowed to bosses, causing some infections to not trigger.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Commander",
     "items": [
      {
       "text": "Reduced the health of all Drones to decrease the time players spend dealing with them (Commander’s health has been increased to balance the difficulty).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Drones now immediately attack for the player after being hacked, rather than waiting for the right moment. Hacked drones now only require one shot to hack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Molter",
     "items": [
      {
       "text": "Fixed an issue where Molter would instantly generate spikes during Armor Repair.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where scene masks would block danger warning icons.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Reaper",
     "items": [
      {
       "text": "Fixed an issue where Reaper's Level Achievement displayed an incorrect number of required tasks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Hunter",
     "items": [
      {
       "text": "Hunter’s arc-based abilities will no longer cast repeatedly during their effect period to reduce combat confusion. (For example, as long as BombArrow/Trap is still \"Falling\" to the field, no additional BombArrow/Trap abilities will be cast.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased the self-destruct speed of Hunter’s traps and enlarged their hitbox to make them easier to clear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where Hunter’s arrows would flip direction, preventing attacks outside the warning range.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Kurozan",
     "items": [
      {
       "text": "Fixed an issue where Kurozan would get stuck after being hit by Charge Shoot.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted some visual errors and behaviors for Kurozan.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Adjusted the time management logic to prevent scenarios where the game would speed up abnormally.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted certain visual effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Updated the tutorial for Charge Attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "PQube & 18Light",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
