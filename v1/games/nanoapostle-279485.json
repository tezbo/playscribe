  {
   "id": "nanoapostle-279485@4",
   "gameId": "nanoapostle-279485",
   "displayName": "Hotfix 4",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-09-19T16:49:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "NanoApostle continues to improve thanks to the feedback of the community!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Players",
     "items": [
      {
       "text": "Adjusted control inputs to allow using Spin Slash immediately after a charged attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Commander",
     "items": [
      {
       "text": "Added hacking method prompts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Reaper",
     "items": [
      {
       "text": "All attack warning effects for Reaper and its clones now appear in front of the fog, allowing players to see attack warnings even in foggy areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Enhanced the visual effects when Reaper’s clones fly back to the main body after death, with a gradual acceleration to increase visibility in foggy areas.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Kurozan",
     "items": [
      {
       "text": "Fixed an issue where the lights in the scene did not turn on after skipping phase transitions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where using Jump Slash after a Grapple Hook would significantly reduce the movement distance of the Jump Slash.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Slightly adjusted Kurozan's behavior tree and animations, and resized some hitboxes to better match the visuals.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Fixed a bug where pausing the game during a grab-throw action didn’t pause the game correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
