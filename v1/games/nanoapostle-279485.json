  {
   "id": "nanoapostle-279485@7",
   "gameId": "nanoapostle-279485",
   "displayName": "Hotfix 7",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-11-27T11:28:55.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Further fixes for NanoApostle, thank you all for the continued feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Players",
     "items": [
      {
       "text": "Optimize the aiming assist system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increase the hitbox width for shooting, reducing the chances of missed shots.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix the issue where regular blocking would override the spin slash state, causing a block failure.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Hunter",
     "items": [
      {
       "text": "Increase the margin of error for the Level Achievement where the player is hit less than N times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Kurozan",
     "items": [
      {
       "text": "Increase the margin of error for the Level Achievement where the player is hit less than N times.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Fix some minor bugs and issues where the process may get stuck.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Provide a unified visual cue when enemies perform attacks that require charged blocking.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
