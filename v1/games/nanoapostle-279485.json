  {
   "id": "nanoapostle-279485@5",
   "gameId": "nanoapostle-279485",
   "displayName": "Hotfix 5",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-09-20T16:09:44.000Z",
   "notes": [
    {
     "title": "Players",
     "items": [
      {
       "text": "Fixed an issue where the player would sometimes not play the correct animation after dying.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Commander",
     "items": [
      {
       "text": "Adjusted the interval for Commander’s Cross Laser Drone attack to be more reasonable. It will no longer be used too frequently or infrequently (e.g., immediately reusing after clearing the drones or not using them at all during the entire fight).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Hunter",
     "items": [
      {
       "text": "Added a damage accumulation progress indicator during Hunter’s self-repair.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where Hunter’s various shots would sometimes not aim at the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed unnecessary visual effects that would sometimes play for Hunter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Reaper",
     "items": [
      {
       "text": "Improved certain combat experiences and visual details.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed an issue where Reaper could get stuck in certain situations (still being monitored; if this issue occurs, please report it using F10, thank you).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Kurozan",
     "items": [
      {
       "text": "Fixed an issue where Kurozan's grapple would ignore the player's invincibility state and still grab them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Kurozan's ground rupture damage area could be cleared by the player's charged attack.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
