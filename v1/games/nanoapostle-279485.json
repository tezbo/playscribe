  {
   "id": "nanoapostle-279485@2",
   "gameId": "nanoapostle-279485",
   "displayName": "Hotfix 2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-09-13T17:00:52.000Z",
   "notes": [
    {
     "title": "Thank you all for the feedback so far!",
     "items": [
      {
       "text": "The team are hard at work at implimenting your feedback into the game. Here are a list of new fixes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added full-screen toggle options in the settings menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Adjusted the input conditions for charged attacks to make them easier to trigger and no longer get stuck in other states, while also making the effects more noticeable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed display layer errors for certain visual effects.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Kurozan's split shuriken could not be eliminate by the Pulse Slicer, and some errors related to shuriken throwing direction.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where the damage range of Commander’s Drone Laser sometimes did not match the warning area.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted some player visual effects to make them more prominent on the battlefield.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed various issues with boss's grabbing abilities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed execute's inconsistent key prompts.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some triggering conditions for Molter's Level Achievement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where button icons displayed incorrectly when using the Nintendo Switch joystick.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
