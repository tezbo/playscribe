  {
   "id": "nanoapostle-279485@6",
   "gameId": "nanoapostle-279485",
   "displayName": "Hotfix 6",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-10-07T15:11:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Further fixes for NanoApostle, thank you all for the continued feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Players",
     "items": [
      {
       "text": "Optimized the shooting and aiming experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Commander",
     "items": [
      {
       "text": "Fixed some visual effect display and damage detection errors for Commander.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Attempted to fix an issue where Commander could get stuck during phase transitions. (Still under observation, if this error occurs, please report it using F10, thank you.)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Kurozan",
     "items": [
      {
       "text": "Deactivated the damage detection for explosion attacks earlier.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where the phase 3 cutscene for Kurozan was interrupted by actions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Adjusted Kurozan's combat experience, including reducing the execution time of Iai Slash in phase 3.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "Wenny",
     "items": [
      {
       "text": "Fixed an issue where players could no longer speak with Wenny after clearing the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a new interaction to hug Wenny in the later stages of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Other",
     "items": [
      {
       "text": "Boss health will no longer display as 00.0% when it’s extremely low.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed the timing for some Boss music triggers.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Level Achievement progress will now be displayed in real-time in the pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where certain Level Achievements based on taking fewer hits were not correctly achieved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a Bug Report button in the pause menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
