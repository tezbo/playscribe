  {
   "id": "nanoapostle-279485@3",
   "gameId": "nanoapostle-279485",
   "displayName": "Hotfix 3",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2024-09-16T11:00:08.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "More fixes incoming!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted player module values, and adjusted boss health and attack power",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed a bug where Challenge Level’s Level Achievement could be repeatedly achieved and reset",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where players could use the mouse to purchase locked modules",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fixed an issue where Molter could get stuck when repairing armor, where repeated destruction points prevented triggering, and some visual effects playback issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Spin Slash could trigger twice under certain conditions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where Berserker would continue attacking during the Phase 2 cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where Kurozan had unusually long idle times, and significantly adjusted its behavior and various details, making it more challenging",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the invincibility time from Commander’s grab ability",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjusted some timing and recoil parameters for player’s Charge Attack",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Fixed an issue where some buttons on the NS Pro controller couldn’t be bound",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
