  {
   "id": "stray-110248@1",
   "gameId": "stray-110248",
   "displayName": "Hotfix 1",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2022-07-20T23:55:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi all,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for playing Stray! This patch fixes a few common \"fall through the world\" bugs reported by a number of you as well as a progression blocker at the end of the first zurk chase. Thank you to everyone who kindly reported these bugs and helped by sending along detailed reports and dxdiags.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have another patch planned in the coming days to address some GPU driver issues. We'll keep you all updated!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    }
   ],
