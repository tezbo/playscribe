  {
   "id": "stray-110248@2",
   "gameId": "stray-110248",
   "displayName": "Hotfix 2",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2022-07-22T20:40:56.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Friends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 2 is now available!! This patch contains a lot of things everyone has been asking for. Just to run down a little bit of what is in this:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adds additional fullscreen options including proper exclusive fullscreen support",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Engine fix for some users who are unable to boot due to GPU driver issues",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Additional checks to prevent VR headsets from interfering with the game client",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Collision fixes to prevent going out of world",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Uncapped framerate option is now on the right instead of the left",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Localization fixes for German",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for scratch trophy for keyboard and mouse players",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Thank you all for all of your wonderful support of the game and to those of you who sent us detailed bug reports. We are so grateful for the information and look forward to Patch 3! We'll keep you all updated as we continue to improve Stray!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
