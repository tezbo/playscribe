  {
   "id": "stray-110248@3",
   "gameId": "stray-110248",
   "displayName": "Patch 3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2022-08-03T21:53:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you all for all the amazing bug reports, crash dumps and well wishes! We're all excited to bring you Patch 3 which handles a lot more issues you all have been reporting. We'll be continuing to look into things so please send us your dumps, dxdiags and reports as before.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Various fixes for falling through the world (we've tried to preserve speed runner skips)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional fixes for GPU crash on boot issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for the cat going out of bounds when jumping on gutters",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for the cat going out of bounds when landing on barrells",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Improve low FPS camera controls w/ keyboard and mouse",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Fix getting stuck on giving Seamus the tracker",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix being able to talk to mahjong players during the breakdown",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix multiple issues around VR headset render context issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix various Polish typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix various French typos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "and more!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
