  {
   "id": "stray-110248@4",
   "gameId": "stray-110248",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-08-10T15:55:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Cats and friends of Cats!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The long awaited Patch 4 has arrived! Thank you all for your patience as we've been working hard with our small team to prepare this patch as well as prepare additional platforms. We continue to appreciate seeing all of the notes and details from the community here and it helps us immensely!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some Pawtch notes below!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed localization issues across multiple languages",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added accessibility options for players who have difficulty with rapid tapping",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "* Toggle run",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Toggle defluxor",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "* Toggle to shake Zurks",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added an option to hide cat death (it is too sad)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A large number of crash fixes across many situations (too many to list and some quite nasty)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes for audio decompression errors and stuttering on certain configurations",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Collision and navmesh fixes throughout the game (Cats are liquid so it's difficult!)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you everyone for the precious feedback. Oscar hopes you will enjoy this pawtch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
