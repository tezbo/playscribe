 "releases": [
  {
   "id": "majotori-22023@2.2.0",
   "gameId": "majotori-22023",
   "displayName": "Update 2.2.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2017-10-26T17:12:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In this time of witches, what's scarier than your own ignorance?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To celebrate Halloween, we are updating Majotori with a new batch of questions to help keep the collection up to date and relevant. I also includes some corrections and a new compression method that reduces the disk size of the game by about 40%. Not that that means much since the game is already pretty light, but hey!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also, in case you missed it, remember that now you can make your own custom questions file to use in the game. More info here:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you have any doubt or problem, you can reach us on the Steam forums or send us an email at contact@majorariatto.com",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
   "digest": {
    "new": 0,
    "fixed": 0,
    "balance": 0,
