  {
   "id": "remorse-the-list-115393@major-2023-02-22",
   "gameId": "remorse-the-list-115393",
   "displayName": "Important update regarding the console versions and the DLC!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-02-22T19:01:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings, survivors!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we have two new pieces of information to give to you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First and foremost is that the DLC, Another Past, will be available on Steam through an update tomorrow, February 23rd at 17:00 GMT. We will be looking forward to your opinions and thoughts about the content of the DLC which we hope you enjoy!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "The second piece of news is that the console versions coming out tomorrow for the Switch and Xbox will only contain the base game and the DLC will come at a later date through an update. This is due to an unexpected technical issue, so we beg you to be patient and enjoy the base game for now.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "xboxSeries"
       ]
      }
     ]
    }
   ],
