  {
   "id": "monarchy-260435@post-2024-11-09",
   "gameId": "monarchy-260435",
   "displayName": "Added a new map with no enemies and fixed some issues",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-09T16:28:59.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added a new map, Safe Lands. There are no enemies in this map and no wining or lose conditions: Playing this map in easy mode will use the summer tileset, in normal the autumn and in expert mode the winter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added an sfx when you activate the windmill",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed a gamepad issues when you go back to welcome screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a soft lock in The Siege, to build the trebuchet you now need to advance to the castle. It is no longer required that the trebuchet is inside the safe zone (between last wall and ground banner).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a particle effect for farms when the windmill is activated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
