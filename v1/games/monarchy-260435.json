  {
   "id": "monarchy-260435@post-2024-11-08",
   "gameId": "monarchy-260435",
   "displayName": "Updated difficulty and balance adjustments",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2024-11-08T23:06:31.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added difficulty levels, easy, normal and expert",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Horse has higher stamina on normal and easy levels",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Upgrading to a tent costs 2 coins less",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Horses at stables costs 2 coin less",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Increased distance from the outer wall to the ground banner",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Adjusted costs of catapult tower to be cheaper",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "When completing a scenario you go back to the welcome screen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue in the siege map with the cutscene where enemy guards could spawn too close to the player.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Reduced the number of squirrels in the forest",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Upgrade tree costs 1 coin less",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where the beggar picking up a coin would not play an sfx",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
