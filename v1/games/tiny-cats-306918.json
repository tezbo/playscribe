    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We want to express our heartfelt thanks for playing our game and for all the valuable suggestions and mentions you've shared!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’re excited to let you know that the Achievement issue has been resolved. We apologize for not catching it earlier—lesson learned for future releases! 😅",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, we've addressed several minor issues that both you and our team discovered. If you encounter anything else that seems off, please don't hesitate to reach out—we’re committed to investigating and resolving any concerns.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Once again, thank you for your support. It means the world to us. And of course... MiaowWWWW! 🐾",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
