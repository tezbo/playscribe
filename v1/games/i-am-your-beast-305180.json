  {
   "id": "i-am-your-beast-305180@major-2024-09-11",
   "gameId": "i-am-your-beast-305180",
   "displayName": "Update Notes 11th September 2024",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-11T14:00:23.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Slightly lowered S rank threshold for Story level 15",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bear Traps can be used on knocked down enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "'New' will no longer show on challenge tab after attempting the newly unlocked level",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fix for achievement not unlocking on Story level 25 (might have to replay this one to unlock it, but it's at least a short one)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix to stop an enemies weapons from occassionally falling through the ground when dropped (particularly in Story level 2)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
