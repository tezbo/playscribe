  {
   "id": "i-am-your-beast-305180@major-2024-09-14",
   "gameId": "i-am-your-beast-305180",
   "displayName": "Update Notes for 14th of September",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-14T12:30:19.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Another small patch out for those of you playing over the weekend. This one contains:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An end of level pop up to tell you when you've unlocked a new level (as well as the conditions to unlock the next level)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A fix for the ammo indicator sometimes displaying incorrectly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improved enemy detection for claymore mines",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "A potential fix for the falling through ground issue some players have reported",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Backup saves and a catch for if a save game gets corrupted by the game being closed during the save process",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
