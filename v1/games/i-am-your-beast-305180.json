  {
   "id": "i-am-your-beast-305180@major-2024-09-12",
   "gameId": "i-am-your-beast-305180",
   "displayName": "Update Notes 12th of September",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-12T20:07:30.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Got some fixes and quality of life stuff in here for you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "The biggest ones",
     "items": [
      {
       "text": "Fix for the Story level 23 achievement not unlocking",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for the S-ranking all Story/Challenge levels achievements not unlocking: In both cases, these should unlock automatically for you if you've already met the criteria when opening the level selection menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Additional stuff",
     "items": [
      {
       "text": "Screenshake intensity can now be changed in settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To help with motion sickness, weapon recoil can now be applied to the reticle instead of camera motion with a settings toggle",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Equipment (bear traps, claymores, RPGs) can now be rebound in the settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Throwing knife kills now count towards objectives if an enemy has been knocked down: Happy hunting, folks!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
