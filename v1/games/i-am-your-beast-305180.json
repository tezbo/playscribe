  {
   "id": "i-am-your-beast-305180@major-2024-09-27",
   "gameId": "i-am-your-beast-305180",
   "displayName": "Update Notes 27th September",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-27T20:45:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Just a small hodge podge of fixes and quality of life stuff before the weekend.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quality of Life",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Expanded framerate limit options (including unlimited framerate)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Independent volume sliders for effects and dialogue/cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mouse sensitivity options extended (can now go as high as 500%): Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "A fix for players who were getting lingering temporary files when using the clip beta feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A fix for weapons falling through the ground on occassion after an enemy drops them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "a fix for an issue where reaching the top of a climbing wall or ladder would occassionally fling people into space: These are \"fingers crossed, should be fixed\" so please tell us if you see these issues occurring still; we appreciate it!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
