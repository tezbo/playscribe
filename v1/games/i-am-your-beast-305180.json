  {
   "id": "i-am-your-beast-305180@major-2024-11-22",
   "gameId": "i-am-your-beast-305180",
   "displayName": "Story Expansion Update out now!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-11-22T15:22:25.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It’s finally here! The new story expansion sees a new epilogue added to the end of the game where you’ll sit in as a part of the COI Support Group. Tall tales are swapped across nine levels, with ten new cutscenes and extreme situations for Harding to force his opponents through that you don't typically experience in the main game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve said it before, and we’re going to keep saying it, but this wouldn’t be possible without you! Your support of the game has enabled us to make these new levels and have fun with such a cool concept.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Look forward to more support for the game in 2025--and see you around the internet!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Strange Scaffold",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
