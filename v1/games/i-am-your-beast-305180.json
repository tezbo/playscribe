  {
   "id": "i-am-your-beast-305180@major-2024-09-16",
   "gameId": "i-am-your-beast-305180",
   "displayName": "Update for 16th September",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-09-16T21:13:51.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Smaller one today, fixing some stuttering that was occurring after the last update as well as (hopefully) fixing an unfortunate issue that some very patient players (thank you) are having on the start screen after crashes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Bullet points",
     "items": [
      {
       "text": "Stuttering should be remedied for players experiencing that after the September 14th update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Save files now create backups, which can be restored if the game crashes while saving",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Headway has, fingers crossed, been made on the start screen lock up bug",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
