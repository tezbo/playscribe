     "title": "Changes",
     "items": [
      {
       "text": "■ Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The following issues have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue where the game would become stuck on the ending credits on the first clear of a playthrough.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue where the game would become stuck upon selecting an unregistered technique in the Training Hall.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
