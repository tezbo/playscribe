  {
   "id": "romancing-saga-2-revenge-of-the-seven-306154@1.0.2",
   "gameId": "romancing-saga-2-revenge-of-the-seven-306154",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2024-12-12T03:27:52.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Greetings rulers of Varennes,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First and foremost, we want to sincerely thank you for your unwavering support and passion for Romancing SaGa 2: Revenge of the Seven. We hope the game continues to bring you joy and fun.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch 1.0.2 is live!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Please read the full changelog below",
     "items": [
      {
       "text": "■ Additional Features",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The following features have been added.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Restart Battles: Players will now be able to return to their last save point or return to the title screen while in mid-battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Display Obtained Formations: The Emperor appointment screen will now show whether or not the Formation tied to that class has already been obtained.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Battle Menu Shortcut: Players will be able to return to the top of their Tech and Spell menus during battle via a shortcut button. (△ of the PlayStation controller, Y of the Xbox controller)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5",
        "xboxSeries"
       ]
      },
      {
       "text": "Adjust Camera Speed: Added another increment level for adjusting camera speed in Settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Bug Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The following issues have been fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue where a debug character would appear during gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue where recruitable characters in the tavern would not experience appropriate attribute gains.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Issues when attempting to buy or sell items at shops.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue where Shadow Servant and magic shield spell effects would not stack properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "An issue where TP would not be distributed properly to retinue members who did not take action during an encounter.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor bug fixes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
