  {
   "id": "fading-echo-347887@1",
   "gameId": "fading-echo-347887",
   "displayName": "Update 1",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-04T09:47:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Legends,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The Æther's still thin across Corel, but we've patched a few cracks in the current. This update leads with fixes, a couple of balance tweaks, and three new skins to change up how you look while you're out there.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed a case where dying during a specific final battle animation could send you into the wrong reality",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Dying in a final battle no longer boots you to the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the stretched source icon when unleashing an Æther source",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Æther core UI sticking around after it should've faded",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Chinese characters appearing in the Japanese localization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed corruption agents occasionally grabbing you instantly with no wind-up",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a portal loading the wrong reality preview when areas were loaded out of order",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed post-corrupted immunity not applying when using a cannonball while corrupted",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the Corruption Cloud (pink clouds in the last island) draining XP",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a rare case where force-closing the game could make the water wave spell disappear",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Removed the difficulty option from the main menu (it wasn't applying changes correctly there)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Balance & combat",
     "items": [
      {
       "text": "Combat Camera Assist: in low-assist mode, the assist no longer keeps pulling after you've deactivated it",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "Reduced a pushback exploit",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      }
     ]
    },
    {
     "title": "New skins",
     "items": [
      {
       "text": "You wishlisted us past 100K, so here's three new looks to celebrate:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Helgur One (Fire Skin)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Gamma One (Waste Skin)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Æther One (Water Skin)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Glitch One (Corruption Skin)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Marcel Bob (French Skin)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Plus updated localization across the board.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "As always, if something's still off, drop it in the Steam bug thread or hop on our Discord so we can take a look. Thanks for playing, and see you in the Corel. 💙🐟",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
