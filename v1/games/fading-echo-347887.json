      {
       "text": "The 2nd cutscene can be out of sync with the voice over (the audio is early. the visuals are… catching up).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We’ve got more updates on the way, and we’ll keep shipping them as they’re ready!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
