   "announcedAt": "2026-02-26T15:12:43.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey Legends,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A major update is coming to Fading Echo Demo, focused on one thing: clarity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Clearer status effects. Clearer enemy tells. Clearer UI. Better feel.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Also. We heard you. No more movement lock in dialogue. Keep moving. Keep flowing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "🔥 TL;DR",
     "items": [
      {
       "text": "Burning is less punishing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fights are easier to read: updated attack signs + improved combat HUD",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Jump + Push attacks reworked to better match One’s height",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Exploration upgrades: chest counters in the Bastion + improved portal visuals",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tutorial is cleaner + slightly easier (less blah blah, more flow)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
