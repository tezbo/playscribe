  {
   "id": "fading-echo-347887@1.0.27953",
   "gameId": "fading-echo-347887",
   "displayName": "Update 1.0.27953",
   "kind": "hotfix",
   "kindBasis": "studio",
   "announcedAt": "2026-07-24T08:24:12.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello Legends!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "First of all, the entire team would like to thank you for the incredible welcome you've given Fading Echo. Your support means the world to us! 🩵🌊",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We've been carefully reading all of your feedback-both the kind words (thank you 🥹) and your suggestions for improvement. Every comment helps us make the game even better!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Today, we're deploying our first hotfix, which includes",
     "items": [
      {
       "text": "Updated localization for Japanese, Korean, Simplified Chinese, and Traditional Chinese, including character customization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue where XP could disappear after dying during the final battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where dying to Corruption during the final battles could send players back to the main menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Have a wonderful journey through the Echoverse!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "– The Fading Echo Team",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
