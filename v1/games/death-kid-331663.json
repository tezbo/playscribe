   "gameId": "death-kid-331663",
   "displayName": "Update 1.0.3",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-09-04T18:06:34.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I’ve just released an update that adds local co-op to the game. You can enable it before starting a new game or when continuing. Co-op is available only in stage battles, where the second player controls a clone of the first player. The difficulty in co-op mode is significantly increased, so expect more of a challenge.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adam",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
