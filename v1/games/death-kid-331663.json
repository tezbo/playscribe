   "announcedAt": "2025-04-01T20:03:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Demo Update 1.0.4",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed getting stuck in range mode when unpausing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "the game now pauses when the Steam overlay is open or when a gamepad disconnects",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "fixed dash getting stuck when dashing briefly after charging",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "pin kick now has an additional hitbox at the very start of the animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "spin kick is now easier to control",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "enemies are harder to push away from feeding on the souls (higher distance)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed pixel shimmering on the middle pillar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "adjusted dialogue text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "balance"
      },
      {
       "text": "I also released update 1.0.3 a couple of weeks ago, but I didn’t create an event for it, so now I don’t remember exactly what I changed. Probably some fixes?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
