  {
   "id": "damon-and-baby-351213@1.01",
   "gameId": "damon-and-baby-351213",
   "displayName": "Patch 1.01",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-02-25T05:21:14.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you very much for playing the \"DAMON and BABY\" demo and for providing us with so much valuable feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To ensure a more comfortable and enjoyable experience for everyone, we have released a new patch featuring the following adjustments:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Changes & Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Newly added Recovery Item to the Cave of Beginnings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Increased health recovered from Recovery Items",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Reduced the power of some enemies",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Adjusted the price and health recovery value of the \"Hamburger\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "(Added on Feb 24 at 21:45 PM PT)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\\[Notice regarding Version Display]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After applying the patch, the title screen may still display \"Ver. 1.00.\" Please be assured that your game has been correctly updated to Ver. 1.01.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are planning to release a fix for this display issue later today.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We apologize for any confusion or inconvenience this may cause.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Future Updates",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Based on feedback, we are considering displaying the player's location on the map by default.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We review all the feedback we receive, and we look forward to hearing more of your thoughts and suggestions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
