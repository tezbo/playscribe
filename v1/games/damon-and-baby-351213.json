  {
   "id": "damon-and-baby-351213@1.02",
   "gameId": "damon-and-baby-351213",
   "displayName": "Patch 1.02",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-02-25T07:59:03.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you very much for playing the \"DAMON and BABY\" demo and for providing us with so much valuable feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To ensure a more comfortable and enjoyable experience for everyone, we have released a new patch featuring the following adjustments:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ \\[Ver. 1.02] Changes & Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・The player’s current position on the map will now be displayed by default upon obtaining the map.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Spikes in the Ruins Area will now instantly defeat enemies when stepped on.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We review all the feedback we receive, and we look forward to hearing more of your thoughts and suggestions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
