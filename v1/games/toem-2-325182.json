  {
   "id": "toem-2-325182@2",
   "gameId": "toem-2-325182",
   "displayName": "Patch 2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-06-15T19:28:15.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "If you have already played the demo you'll need to reapply your Camera Rotation Option as it's separated into two different options, sorry!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Added / Improved",
     "items": [
      {
       "text": "More stamp jingles!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Main Menu music",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Improved readability on pipes inside Fountain Maintenance room",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Plum's Finale Cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Separated invert the option \"Invert Camera Rotation\" into two new options Overworld Camera Rotation and Photo mode camera rotation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Rotation speed inside Options is not displayed as percentage instead of numbers",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
    {
     "title": "Fixed",
     "items": [
      {
       "text": "Steam not initializing properly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Settings not getting reverted when starting a new game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Some trash pieces floating in the air",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fish food pipe clipping into itself",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Stoves having incorrect material",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Plum's finale not being saved sometimes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Soft lock due to saving taking place in the middle of dialogues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Could not turn of Custom Mouse Cursor using the options menu",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Now don't you dare break more things you hear!! <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
