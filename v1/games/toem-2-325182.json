  {
   "id": "toem-2-325182@1.0.7",
   "gameId": "toem-2-325182",
   "displayName": "Patch 1.0.7",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-01T13:07:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "\"Overworld\" camera is now being rotate by holding left click for consistency as reported here",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Ability to swap Zoom & Pan input buttons inside the camera menu on request by user aranol as reported here",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game locking up when choosing a photo (Solves infamous grandma \"dies\" bug)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Rotating photo camera by dragging mouse & taking a photo softlocks input",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Game crashing when alt-tabbing while with \"Exclusive Fullscreen\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Game becoming really dark while playing using \"Exclusive Fullscreen\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Escape room's planks not rendering correctly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Whirlhill's minimap being incorrect",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Crystal Cave's sight photo is only active while it's glowing",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
