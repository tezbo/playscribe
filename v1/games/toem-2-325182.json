  {
   "id": "toem-2-325182@1.0.8",
   "gameId": "toem-2-325182",
   "displayName": "Patch 1.0.8",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-10-07T08:23:50.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Music track \"A Milion Different Colours\" is added to inventory once player visits Whirlhill festival",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Quality of life tweak where the Compendium section is opened instead of album when Donkey Owner asks for a photo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tried our best to disable Unity Analytics based on this post",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Steam Cloud not syncing properly between systems",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Escape Room light bulb disappearing, making the whole thing unsolvable",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "\"Landscape\" being misspelled inside Taletorp's region description",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hikelady could play music over Whirlhill festival's special music if entered region with \"Repeat\" turned on",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
