  {
   "id": "unpacking-115843@major-2020-09-15",
   "gameId": "unpacking-115843",
   "displayName": "Demo update",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-09-15T09:41:05.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've released a minor quality of life update to the Unpacking demo!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes include",
     "items": [
      {
       "text": "Made the \"Witch Beam\" whisper quieter so it's not as scary",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added control-click for turning items for our one button Mac mouse friends",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Several items have been marked up to be allowed in more places",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Caught an issue where the game might not auto save if you quit too quickly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue where room icons could show up wrong on load",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Escape key no longer immediately quits from the main menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you've already successfully played through the demo these changes are unlikely to give you a different experience but we're hopeful they'll make things a little bit nicer for anyone who checks it out between now and the end of PAX.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "But of course you can play it again if you'd like, that's totally allowed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
