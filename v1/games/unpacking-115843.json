  {
   "id": "unpacking-115843@post-2021-11-06",
   "gameId": "unpacking-115843",
   "displayName": "Fixes and updates",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2021-11-06T01:45:27.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This update addresses an input rebinding issue and fixes some smaller issues and placement rules",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Input rebinding allowed binding the esc key over the primary action input, resulting in menus that couldn't be navigated. This is now prevented and if you had bound it this way the game will revert your input bindings on start",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed a Steam integration issue that was blocking progression in rare cases",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed issue where items could be placed in the corner of a shower and not retrieved",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed issue that occasionally caused items in drawers to be very hard to select if there was an item on the floor behind them",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixed a \"vanishing book\" issue caused by holding a book over a shelf while changing rooms",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "added a missing sprite to a toothpaste in 2012 and fixed issue where an item in 2018 could be hung on hooks and towel racks when it wasn't meant to be",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "tweaked the dining-room reverb in 2007",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed an issue that was causing red validation outlines to render with visual artefacts on specific screen resolutions",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "several items have had some extra areas assigned to them either because they should have been that way originally or we saw it in someone's stream and were like \"yeah, fair\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "fixed other various visual issues",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Save files and progress should be unaffected.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Features and improvements",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Big Picture mode now uses a virtual keyboard when naming your album",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "the pulsing button effect that signals that other rooms have unpacked boxes has been reduced slightly",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The pulsing can also be turned off entirely by adding",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "nopulse",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "to Launch Options - this is considered a workaround and will hopefully have an in-game menu option in future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
