  {
   "id": "unpacking-115843@2",
   "gameId": "unpacking-115843",
   "displayName": "Update 2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2020-09-17T10:19:35.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Another minor update! Don't mind us!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes include",
     "items": [
      {
       "text": "The sound the Star makes when you put everything in valid places no longer plays repeatedly if you keep moving things about - we were watching people stream the demo and it got super annoying, honestly it's the only reason we're doing this update",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "esc button on the main menu will skip the logo sequence for people who are in a hurry to play our extremely chill slow paced game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
