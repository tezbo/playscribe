  {
   "id": "pretty-girls-tile-match-219695@1.0.2",
   "gameId": "pretty-girls-tile-match-219695",
   "displayName": "Update 1.0.2",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2023-04-13T00:24:04.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Pretty Girls Tile Match update Ver. 1.0.2 is now available!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Version 1.0.2 Update",
     "items": [
      {
       "text": "Fixed a bug where clearing all mahjong tiles may not result in a stage clear.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the \"MOVE\" feature in support may not function properly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where opening the pause menu immediately after clearing a stage may cause the game to become unplayable.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where character and stamp operation buttons may not be displayed in the dressing room diorama under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Made other minor adjustments and changes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Be the first to hear about updates and sales on the Steam \"Products\" community hub!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Be sure to subscribe to our wishlist and follow our products so you don't miss out on the latest news!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
