  {
   "id": "demon-turf-134564@1.0.1",
   "gameId": "demon-turf-134564",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2023-03-09T16:50:29.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We've just updated Demon Turf Tower fixing some reported issues & slightly balancing some meta movement tech!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Check out the patch notes",
     "items": [
      {
       "text": "Gliding out of a wall cling or cyclone now acts like gliding in the air giving you no recovery options. Only gliding from the ground allows you to jump out of it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Gliding from the ground no longer gives you the chance to do another glide in the air, whether the fairy is equipped or not.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dying in the Hub area after unlocking the checkpoint hex no longer soft locks the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Cannons no longer have a chance of getting stuck in the horizontal rotation.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hookshotting near teleport doors no longer messes up the teleports.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Teleport hookshotting out of vents no longer give you infinite jumps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Interacting with a door during a hookshot doesn't have the rare chance of locking your camera movement anymore.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Community voted on keeping the fairy knockback momentum bug, but it is slightly nerfed to only give you one floor worth of height at best.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added a new sign to the first floor mentioning the importance of angling your camera forwards during jumps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "You can no longer get stuck infinitely between the bouncer & wall in floor 22.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added missing knockback colliders to poles in floor 41.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Music no longer \"wobbles\" in the end menu at the end of a run.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
