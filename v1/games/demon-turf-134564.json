  {
   "id": "demon-turf-134564@1.1",
   "gameId": "demon-turf-134564",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2021-12-22T18:15:37.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today's the day! The Demon Turf Level Creator is OUT NOW!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Get ready to create, play and share your level designs with the new content update. Need help getting started? We've got you covered with our handy set-up guide: https://demonturf.com/custom_level.html",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "But wait, we have some more news...",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Say hello to the 1.1 patch!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We have fixes, adjustments and features galore. For the full 1.1 patch specs, please see everything we have done via: https://demonturf.com/patch_notes.html",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
