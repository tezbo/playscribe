   "announcedAt": "2025-02-28T08:56:40.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "In this update, we continue to focus on addressing the aspects that were considered least predominant by the majority.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "List of major changes",
     "items": [
      {
       "text": "Graphics. The game has undergone many visible graphical improvements. The visual elements are now even more realistic.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Narrative. The format and sequence of the storyline have been changed for greater clarity.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Settings. Now, settings that were previously only available for changes in the menu can be adjusted at any point during the gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Miscellaneous. The game has undergone various changes that positively impact overall optimization and player immersion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
