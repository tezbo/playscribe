  {
   "id": "cursed-new-year-323512@10.01",
   "gameId": "cursed-new-year-323512",
   "displayName": "Update 10.01",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-10T15:56:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "The first correctional update for \"Cursed New Year\", which focuses on correcting the main points that previously hindered a comfortable gameplay, as well as adding elements for greater immersion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Graphics. The overall game graphics have been partially changed for the better, and the location has gained more illumination due to redesigned lighting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Optimization. The results of in-game tests of the updated version confirm a more efficient use of device resources compared to the previous version. This results in improved performance and smoother gameplay.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other. According to statistics and feedback from players, the previous version of the game had problems with the achievement system. Achievements have been adjusted in the latest update.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
