   "announcedAt": "2025-12-06T13:54:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Added Remix mode. This mode features a dungeon from the original jam version with minor adjustments and a different final boss.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added 4 new enemy types to spice up the exploration.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added 4 new player classes.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Expanded the in-game soundtrack with suitable tracks from DR2 and DR2A.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Minor adjustments to game balance.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Other minor fixes and adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
