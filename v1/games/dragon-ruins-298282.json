  {
   "id": "dragon-ruins-298282@major-2024-06-18",
   "gameId": "dragon-ruins-298282",
   "displayName": "Update Notes for June 18, Part Deux: Electric Boogaloo -- Final",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-06-18T04:51:09.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed a long-standing bug that could softlock the game if the player died while moving through doors or between battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "I apologize for the long delay with this issue. This bug was difficult to track down since it required almost frame-perfect precision and hundreds of attempts to reproduce, fix, and confirm.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "On another note, you can press ESC+D to generate a dump file (gamestate.dmp) if you encounter a game-breaking issue. The file will be located at c:\\Users\\user\\AppData\\LocalLow\\Graverobber Foundation\\Dragon Ruins\\, next to the logs and save files.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "If you provide a dump along with the logs, this will make troubleshooting a lot easier in the future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
