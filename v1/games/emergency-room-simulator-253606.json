  {
   "id": "emergency-room-simulator-253606@major-2026-08-20",
   "gameId": "emergency-room-simulator-253606",
   "displayName": "First Update – Thank You for Your Feedback!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-20T12:19:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44211198/1949982e0d61fae74984e87808f0612e52023783.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are very happy to have already received so much valuable feedback from you during the first week after release. A huge thank you to everyone who has helped us improve Emergency Room Simulator with constructive feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "To implement your wishes and suggestions as quickly as possible, we have already prepared our first update for you.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What's new",
     "items": [
      {
       "text": "The IV can be easily attached to the IV stand on the stretcher now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The inventory can already be opened during the tutorial now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Switching between running and walking works correctly now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Now there is more variety of medical cases from the start",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The control of the stretcher is improved now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "The paramedic at the ambulance car has working clothes on now",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Of course, we are continuing to work on implementing your feedback and bringing your wishes into the game. This is only the beginning.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Until then, we hope you continue to enjoy the game, and we look forward to hearing more of your feedback!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
