  {
   "id": "emergency-room-simulator-253606@major-2026-08-18",
   "gameId": "emergency-room-simulator-253606",
   "displayName": "Update in Progress",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-08-18T13:50:48.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/44211198/c051088b666ab8a1a25f2d2ec1e741911aae499b.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Hello everyone,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for all your feedback on Emergency Room Simulator! We are currently working on a new patch, which is expected to be released later this week. We've taken your feedback into account and are implementing several improvements to make the gameplay experience even better.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The update is currently planned to include the following changes:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IV bags can be properly attached to the stretcher's IV pole.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The inventory can be opened during the tutorial.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Switching between walking and running will work correctly.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A greater variety of medical cases will be available from the start of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The stretcher controls will be improved.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We would like to thank everyone who has shared feedback and reported issues. Your input helps us continue improving Emergency Room Simulator and shape the game's future.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
