  {
   "id": "path-to-purge-220461@0.06",
   "gameId": "path-to-purge-220461",
   "displayName": "Update 0.06",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-28T12:41:57.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Ver0.06",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "IMPOTANT!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since we made a great change to the growth system, we highly recommend users who update from v0.04 choose \"Start New Game\" to avoid any possible errors. For users updating from v0.05 can choose \"Continue\" to play but need reset weapon ranks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Enemies stats during Stages growth smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Exp required for Levelup decrease.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Readjust weapon damage, reload speed and weapon skills for Andras and Amdusias",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Temporarily removed Elite enemies' weapon skill drop off system, the system will be back after proper adjustion.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "fixes serveral bugs.",
