  {
   "id": "path-to-purge-220461@0.05",
   "gameId": "path-to-purge-220461",
   "displayName": "Update 0.05",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-12-24T10:04:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "WARNING",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Since this is a big update, we highly recommend our current users START NEW GAME",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "to enjoy our fresh new skills, abilities, systems and battle experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "New Features",
     "items": [
      {
       "text": "Weapon Ability system replaced Weapon Upgrade system.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Weapon specified skills can be drop off when elite enemy defeated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added 31 skills in skill pool(9 bomb type, 8 ice type, 7 poison type and 7 thunder type), fixed some applied skills, current skill pool has 44 skills.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Japanese supported.: Fixes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "improved SoulStone layout.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "improved WeaponRankUp layout.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimized keyboard operation.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Optimized picture resources and improved game running efficiency.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Optimized skill effects and improved game running efficiency.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Numerical growth of enemies in the level will be smoother.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Tuned numerical strength of SoulStone interface and PrayStone interface.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Weapon growth no longer increases player's HP, and the enemies' attack is also greatly reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Modified Box drop method.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Modified skill drop off method, drop skill will be dynamically adjusted by player's choice.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Modify the NPC function, NPCs will no longer be asking for skill only but not give any back.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Maps fusion in two big Area: SingAllNight and Commercial Street. Each Area has 30 stages.: P.S. Since this is a heavy update, we may not able to add new Area, stages and characters. However,: we have made many new attempts on gameplay, if there's any unreasonable or mistake during your gameplay,: please feel free to contact us and we'll improve as soon as possible. Thanks for your supports. We are also: making new contents, including new stages and characters, so stay tuned!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    }
   ],
