  {
   "id": "path-to-purge-220461@1.0.0",
   "gameId": "path-to-purge-220461",
   "displayName": "Update 1.0.0",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-17T08:59:02.000Z",
   "notes": [
    {
     "title": "New content",
     "items": [
      {
       "text": "-: Chapter 4- West Wild, New Enemies, New Arch angel in West Wild!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-: The growth system has been remade, and character growth only occurs during battles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-: Add sprint action.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-: Endless Mode!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-: Add \"Demon Ritua\", in which skills, characters, and character attribute bonuses can be unlocked.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "-: Supports Steam Deck.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-: Support Steam Cloud!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "-: Support Steam achievements!",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "Update",
     "items": [
      {
       "text": "-: Significantly adjusted the game UI interface and added visual feedback.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-: The animation of boss come on stage can be skipped by pressing ESC (button B).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-: Modify bugs that affect the gaming experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "To old friends",
     "items": [
      {
       "text": "-There have been many changes in the version 1.0, and the savedata files are not compatible with Early Access version.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-The content unlocked in Early Access may need to be unlocked again in the official version, please be aware.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Finally, thank you to every player who participated in the Early Access version. Version 1.0 has finally been launched!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
