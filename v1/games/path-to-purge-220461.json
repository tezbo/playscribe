   "id": "path-to-purge-220461@1.0.6",
   "gameId": "path-to-purge-220461",
   "displayName": "Update 1.0.6",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-01-24T09:33:36.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Based on the feedback from our players, we have made the following adjustments:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Modified contents",
     "items": [
      {
       "text": ": Optimized the playback of sound effects, making it no longer harsh to play a large number of sound effects at the same time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ": Sing all night and Street maps have fixed the detection of physical collisions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ": Flying objects fired by the Dealer Girl and Tea Lady can no longer pass through obstacles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": ": The prepare time for the close-range slash attack of the final boss in the Street stage has been increased, and the summoned characters have been corrected to the characters that appear in the Street stage.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
