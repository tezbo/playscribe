  {
   "id": "it-reaches-373840@5",
   "gameId": "it-reaches-373840",
   "displayName": "Patch 5",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-07-14T08:09:17.000Z",
   "notes": [
    {
     "title": "The following issues were resolved",
     "items": [
      {
       "text": "Some places where the player is stuck were fixed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "No inspectable description on inspectables where no text is showing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Pause Menu UI adjustments for different display resolutions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Object in hand disappearing when player takes knife out.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Faster elevator speed in \"Hideout\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "If there are more issues you encounter, please leave your experiences in the forums! Thank you! <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
