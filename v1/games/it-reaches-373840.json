  {
   "id": "it-reaches-373840@4",
   "gameId": "it-reaches-373840",
   "displayName": "Patch 4",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-27T11:15:49.000Z",
   "notes": [
    {
     "title": "In this update we changed and fixed the following issues",
     "items": [
      {
       "text": "Added a short additional sequence at the end of the game to better explain the story ending",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed the issue that some people could not progress in the final chapter",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added a \"Q to leave\" tutorial on the generator widget",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some other smaller issues: We hope this patch will make the game better! Thank you for reporting and your support! <3",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
