  {
   "id": "it-reaches-373840@3",
   "gameId": "it-reaches-373840",
   "displayName": "Patch 3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-05-20T18:17:41.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Fixed the possibility that the achievement for fully upgrading one weapon might not have triggered. If this happened to you, just search for a workbench and you will get the achievement right away. Also make sure that you have scrolled down and really activated all upgrades.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Patched some translations: We hope the game runs smooth now and no bugs happen in the future. If so, don't hesitate to write us in the duscussions forum! Thank you!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
