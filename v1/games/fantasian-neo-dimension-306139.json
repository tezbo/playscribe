  {
   "id": "fantasian-neo-dimension-306139@major-2025-01-31",
   "gameId": "fantasian-neo-dimension-306139",
   "displayName": "Update Notice",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2025-01-31T03:36:32.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "We have released a patch update to provide a smoother and more enjoyable gameplay experience. This update includes improvements to camera adjustment and controls, and a new feature related to difficulty settings.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "■ Changes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Adjustments to movement control with the analogue stick when the camera shifts during field movement.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Vibration” option has been added to settings, allowing controller vibration settings to be changed.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "“Camera Interpolation Time” option has been added to settings, allowing the speed at which the camera rotates when moving through the field to be adjusted.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "For a second or subsequent playthrough, “Custom Difficulty” can now be selected from the difficulty options.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The length of time required to press and hold down the “Fast Forward” or “Skip” button has been reduced.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
