  {
   "id": "hunter-x-hunter-nen-x-impact-281740@1.0.6",
   "gameId": "hunter-x-hunter-nen-x-impact-281740",
   "displayName": "Patch 1.0.6",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-08-05T07:27:26.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today, we have released a new patch with the following updates to improve your gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Patch Details (V1.0.6)",
     "items": [
      {
       "text": "Optimization of processes and adjustment of data processing volume to address an issue identified in certain network environments, where an excessive number of rollback frames were being generated.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Platforms",
     "items": [
      {
       "text": "PlayStation®5",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Steam®",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Notes",
     "items": [
      {
       "text": "Please update to the latest version (Ver.1.0.6) from your respective platform's store and continue enjoying the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We remain committed to delivering a smooth and stable competitive experience by continually improving network performance, addressing bugs, and enhancing the overall quality and reliability of the online environment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additionally, through the upcoming user survey, we aim to sincerely listen to your feedback and better understand your playing conditions, so that we can create an even more enjoyable and trustworthy gameplay experience.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
