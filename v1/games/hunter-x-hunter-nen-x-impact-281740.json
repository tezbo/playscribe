    {
     "title": "■Patch Details (V1.0.5)",
     "items": [
      {
       "text": "Fixed an issue where the hit detection of Aura Arts could be delayed under certain conditions.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where a desync error could occur when Eject Attack hit.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where a desync could occur during character switching.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue where a desync could happen when Hisoka used \"Bungee Gum \\.\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where a desync error could occur during midair piercing attacks.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "■Platforms",
     "items": [
      {
