  {
   "id": "hunter-x-hunter-nen-x-impact-281740@major-2026-06-18",
   "gameId": "hunter-x-hunter-nen-x-impact-281740",
   "displayName": "Major Update Adds Zeno and Balance Adjustments!",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2026-06-18T02:25:47.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "[p align=\"start\"]We have released a patch that includes an additional character and character balance adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Details (Ver1.4.1)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added DLC Character: Zeno",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45090923/8104eadb4f7074e410bb804f4b9122ff259820c4.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "A long-range combat specialist utilizing the Dragon Lance and Dragon Head.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Dragon Lance boasts incredible versatility—master it to overwhelm your opponents from well outside their range! The wide-ranging Aura Art, Dragon Dive, is also a powerful follow-up attack after catching your opponent.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Keep your enemies at bay with powerful long-range attacks and dominate the battlefield!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Zeno can be used by players who own any of the following",
     "items": [
      {
       "text": "・Season Pass 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Additional Playable Character: “Zeno”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "・Deluxe Edition",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Improvement to Training Mode Easy Character Selection",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "When changing characters from the Easy Character Selection, if you reorganize the team using only previously selected characters (including the opponent's team), the changes will now be reflected without having to reload the battle.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "*Colors and costumes will be selected automatically.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Character Balance Adjustments",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45090923/ba87f9622eeb79a90ae7af3bbfc5a01a132a11f9.jpg\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Please update to the latest version (Ver.1.4.1) from your respective platform's store and continue enjoying the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We will continue to take your feedback into account as we strive to maintain and improve a fair and comfortable battle environment.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
