       ]
      },
      {
       "text": "Steam®",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "■Notes",
     "items": [
      {
       "text": "Please update to the latest version (v1.0.5) via your platform’s store before playing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
