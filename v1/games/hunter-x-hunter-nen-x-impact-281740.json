  {
   "id": "hunter-x-hunter-nen-x-impact-281740@1.3.2",
   "gameId": "hunter-x-hunter-nen-x-impact-281740",
   "displayName": "Patch 1.3.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2026-04-16T01:38:46.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Today, we have released a new patch introducing an additional character.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[img src=\"{STEAM_CLAN_IMAGE}/45090923/bf354626c0c21defe6d424936000b32ba392f460.jpg\"]Shizuku excels at breaking through her opponent’s guard and armor.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Use attacks with her materialized vacuum, “Blinky,” along with assist combos to keep your opponent guessing!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Her Aura Art, “Cleaning Complete!”, deals increased damage based on the number of consecutive hits landed just before it.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Mastering your combo count is the key to victory!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Shizuku can be used by players who own any of the following",
     "items": [
      {
       "text": "Season Pass 1",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Additional Playable Character: “Shizuku”",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Deluxe Edition",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]Fixed various bugs",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed an issue with the replay feature",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Notes",
     "items": [
      {
       "text": "[p align=\"start\"]Please update your game to the latest version (Ver. 1.3.2) from your platform’s store before playing.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "[p align=\"start\"]Thank you for your continued support of HUNTER×HUNTER NEN×IMPACT!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
