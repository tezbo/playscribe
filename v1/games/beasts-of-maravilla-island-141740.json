 "releases": [
  {
   "id": "beasts-of-maravilla-island-141740@major-2022-08-30",
   "gameId": "beasts-of-maravilla-island-141740",
   "displayName": "Update Notes for 8/29/22",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2022-08-30T04:30:54.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hi everyone! I know its been quite some time since we have landed an update on the game. We probably owe a little bit of an explanation!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "After our first few months of maintainence on Beasts, many of our teammates started new opportunities and things became a lot busier for all of us. Since we are a team thats run by folks who also have full-time work and just did beasts on the side, after completing our big release push for fixes, our work on Beasts slowed down significantly so we could refocus a little bit on our main jobs and responsibilities.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We spent time tinkering here and there throughout the year adding polish, fixing bugs, and adding some acessibility features. We finally are getting it out to you all!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you all for playing our game and for the continued support, and we hope you enjoy this new version of Beasts with more things ironed out and some additional polish added :)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Patch Notes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added new acessibility features to the pause menu for brightness and contrast",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added the ability to read journal pages in high-contrast plain text",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed some wonkiness with certain jumps being difficult to start",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed bug that prevented cursor from disappearing sometimes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Several polish fixes for incorrect playerposition after cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixes for cutscene music improperly playing if you loaded in to the final checkpoint",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fix for \"Apology\" achievement not completing if you skipped the related cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixes added for the game sometimes freezing up at the tutorial",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed Baby binkeys sometimes not being visible outside of camera mode",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Mitigated issue where sometimes game can crash during credits if players have taken hundreds of photos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Update to chapter select in beach sometimes not displaying the proper lighting",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added some more particle effects to Griffin sequences",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixes to some occlusion areas being very visually severe",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed some materials not being double sided",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Added ability to reset defaults in settings",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Several small bug fixes tod reduce areas of jitteriness or wonky animal movement",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Tons of tiny fixes to create an overall smoother experience :heart: (edited)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
