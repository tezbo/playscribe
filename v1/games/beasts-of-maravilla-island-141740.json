  {
   "id": "beasts-of-maravilla-island-141740@major-2021-06-16",
   "gameId": "beasts-of-maravilla-island-141740",
   "displayName": "Update Notes for 6/15/21",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-06-16T04:58:06.000Z",
   "notes": [
    {
     "title": "We've fixed some things! Patch notes",
     "items": [
      {
       "text": "-Fixed bugs involving Marina getting stuck in midair",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fixed journal pages that were flipped in Traditional Chinese and Japanese",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fixed bug where the griffin could gust you into the air",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fixed opening cutscene not starting for some players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Improved optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fixed bug where options weren't clickable in Plateau",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Fixed bug where players could photograph an invisible binkey",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Made the rotation of the camera when exiting photo mode more consistent",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Snail tweaked in the River",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Cursor is now locked to the game in full-screen and free otherwise",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "-Japanese translation for Maravilla changed to マラビラ",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "IF YOU GOT STUCK IN THE AIR AFTER BEING GUSTED BY THE GRIFFIN, YOUR SAVE FILE SHOULD BE FIXED NOW",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
