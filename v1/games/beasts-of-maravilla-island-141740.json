  {
   "id": "beasts-of-maravilla-island-141740@major-2021-07-14",
   "gameId": "beasts-of-maravilla-island-141740",
   "displayName": "Update Notes for 7/13/21",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-07-14T00:28:02.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "-All cutscenes are able to be skipped if you press pause during the cutscene and select \"Skip\"!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-No longer possible to get teleported underneath geometry when you open your journal in certain spots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed issue where Marina could get stuck for a few seconds after she got gusted by the griffin, even though she had returned to her idle animation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-(Hopefully) fixed players being able to get gusted out of the play area in the plateau",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Players who were unable to get the Draguar to gust at the teetering rock should now be able to get him to gust!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Edge detection refactor (should not run into issues with being able to walk on air or getting stuck on odd branches)",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed issue where marina visibly snapped to the ground every time she returned from being frozen",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed a few jittering creatures in the plateau",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed bugs relating to chapter select sometimes not taking you to the right location",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Birds/Bats should no longer stop in midair during cutscenes",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Areas where occlusion was causing things to flicker fixed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed issue where players could get caught when climbing down off of the first vine",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed bug where the character could freeze if you opened photobook from camera",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed bug where players could open a broken journal from the photobook",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed issue where if you had two photos and deleted one, it would show the incorrect one as the main photo",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Save file will show correct location even after chapter select",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed small white line on the edge of fullscreen photos",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed issue where final game modal was sometimes really huge on certain sized monitors",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Improved framerate of final cutscene",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Some tweaked level design to help draw attention to certain flowers, climbable vines, and pathways.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed bug where basilisk lizards could get caught underwater",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Many other tiny bug fixes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
