  {
   "id": "beasts-of-maravilla-island-141740@major-2021-06-21",
   "gameId": "beasts-of-maravilla-island-141740",
   "displayName": "Update Notes for 6/21/21",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2021-06-21T11:37:13.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "IF YOU WERE STUCK ANYWHERE BEFORE, YOUR SAVE FILE SHOULD NOW BE FIXED!!!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed the opening and final cutscene videos not playing for some players",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed issue where Snail could get under spring plants and cause the player to get stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed issue where multiple options were highlighted when you paused the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Fixed issue where resolution would get reset every time you loaded into a level when windowed",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added more barriers around levels to prevent players from getting stuck",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Improved Save System that will always load you into valid areas",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Improved Optimization",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Improved Radar",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Improved trophy rotation",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Improved camera dithering",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "-Added ability to fast forward credits scroll by pressing any button then holding \"Confirm\"",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
