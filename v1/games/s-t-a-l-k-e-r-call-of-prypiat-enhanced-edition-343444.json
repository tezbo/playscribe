  {
   "id": "s-t-a-l-k-e-r-call-of-prypiat-enhanced-edition-343444@1.0.1",
   "gameId": "s-t-a-l-k-e-r-call-of-prypiat-enhanced-edition-343444",
   "displayName": "Patch 1.0.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-23T09:18:22.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello, stalkers. Today, we are rolling out the first patch for S.T.A.L.K.E.R.: Legends of the Zone Trilogy Enhanced Edition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "What is fixed already?",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The games will not crash on start on unsupported PC hardware and will provide a clear message pop-up (ENG only for now) that GPU doesn't meet the minimum system requirements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed several popular crashes on PC, Xbox, and PlayStation platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
