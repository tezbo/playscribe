  {
   "id": "s-t-a-l-k-e-r-call-of-prypiat-enhanced-edition-343444@1.0.2",
   "gameId": "s-t-a-l-k-e-r-call-of-prypiat-enhanced-edition-343444",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-05-26T16:52:01.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Stalkers, we continue working on the Zone. Today, we are releasing the Patch 1.0.2, aiming to address the visual and input-related issues on PC.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      }
     ]
    },
    {
     "title": "What is already fixed?",
     "items": [
      {
       "text": "Fixed various NPC appearance issues.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue preventing players from binding custom buttons for the mouse.",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "fixed",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Implemented the first round of fixes for issues that caused image blurriness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several rendering-related issues with SSGI (Screen Space Global Illumination) that caused visual distortion and blurriness.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "More fixes for visual anomalies are on the way.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Changes will take an effect only after following steps",
     "items": [
      {
       "text": "Go to Options",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Set graphical settings to Medium",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Set them back to Maximum and press Apply",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Reboot the game",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always, thank you for feedback and support. You help us to make Zone a better place — for seasoned veterans of original games, and for rookies experiencing it for the first time.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We're committed to improving the experience and have more updates on the way.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "See you in the Zone.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
