  {
   "id": "s-t-a-l-k-e-r-call-of-prypiat-enhanced-edition-343444@1.1",
   "gameId": "s-t-a-l-k-e-r-call-of-prypiat-enhanced-edition-343444",
   "displayName": "Patch 1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-12T11:15:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Stalkers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today, we are ready to share Patch 1.1 for S.T.A.L.K.E.R.: Legends of the Zone Trilogy — Enhanced Edition. The main focus of this patch is fixing crashes and savefiles issues across all titles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed save-loading issue for the Asian region localizations.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Stability improvements – fixed multiple crashes on all platforms.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue that caused the game to crash while looking up at the rainy sky.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue that caused the title to crash while eating or using items from the corpse’s inventory.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected misspelling and naming issues in several localizations in all titles.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed sound scattering issues that caused incorrect indoor-outdoor transition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed misleading description for Crouching options for Ukrainian localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several incorrect icons in dialogue logs.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed indistinctive pop-up with information about unsupported hardware.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed user interface issues that allowed users to turn on FSR and antialiasing simultaneously.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Shadow of Chornobyl",
     "items": [
      {
       "text": "Fixed noticeable transition in shadow casting.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed performance drop issue on Ahroprom.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Medkit and bandage hotkeys are now set to F1 and F2 accordingly by default, but users are able to change them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Clear Sky",
     "items": [
      {
       "text": "Fixed audio stuttering on Swamps.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Screen space reflections issue is fixed at the Hospital.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed issue with inability to save the game on Polish text localization.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    },
    {
     "title": "Call of Prypiat",
     "items": [
      {
       "text": "Fixed “Drop multiple items” user interface issue with incorrect slider size.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Please disable mods and check if the game works before launching it. After that, enable your mods again — if everything works correctly, the mod does not need to be updated. However, if you encounter any issues, the mod needs to be updated to the latest version of the game.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Some mods may not work with the updated version of S.T.A.L.K.E.R.: Legends of the Zone Trilogy — Enhanced Edition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you for your support and understanding. Good hunting, and keep that feedback rolling!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
