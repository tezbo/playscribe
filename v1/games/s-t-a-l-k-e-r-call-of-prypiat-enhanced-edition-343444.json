   "announcedAt": "2025-09-12T14:04:18.000Z",
   "notes": [
    {
     "title": "Stalkers,",
     "items": [
      {
       "text": "We’re excited to share what we’ve been working on for the past two months. Patch 1.3 brings numerous bug fixes, a major font overhaul for a more familiar look, and a new quality-of-life feature.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "What’s New",
     "items": [
      {
       "text": "QoL Feature: Added quick slots for Shadow of Chornobyl (SoC) and Clear Sky (CS), functioning the same as in Call of Prypiat (CoP).",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Open the settings menu",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Proceed to “Game” tab",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Use “Enable quick slots” checkbox to toggle the quick slots",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Fixed mouse simulation gyroscope support for better experience on Steam Deck",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "new",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added auto-switching between gamepad and keyboard input on consoles",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      }
     ]
    },
