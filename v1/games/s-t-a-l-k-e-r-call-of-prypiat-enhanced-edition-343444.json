  {
   "id": "s-t-a-l-k-e-r-call-of-prypiat-enhanced-edition-343444@1.1.1",
   "gameId": "s-t-a-l-k-e-r-call-of-prypiat-enhanced-edition-343444",
   "displayName": "Patch 1.1.1",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-30T13:05:24.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Stalkers,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Today we are releasing a minor patch to tackle different issues you were encountering during your adventures.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "So, what is fixed",
     "items": [
      {
       "text": "Stability improvements - fixed several popular crashes. \\[All titles]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed an issue with incorrect screen scaling on ultra performance preset on PS5 Pro console. \\",
       "ps5ProOnly": true,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "ps5"
       ]
      },
      {
       "text": "Fixed freeze on loading saved game if user has more than 400-500 save files. \\[All titles]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed crash while using 'Alt+Enter' key combination. \\[Shadow of Chornobyl]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed issue with K&M setup on Xbox platform with inability to pick up items. \\[Call of Prypiat]\\XBOX:",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed",
       "platforms": [
        "xboxSeries"
       ]
      },
      {
       "text": "Fixed reloading issues with modified RP-74. \\[Clear Sky]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed several modded configs unpacking issues. \\[All titles]",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Thank you for your support, we continue working on further updates for S.T.A.L.K.E.R.: Legends of the Zone Trilogy — Enhanced Edition.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Good hunting, stalkers!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
