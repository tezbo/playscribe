  {
   "id": "the-midnight-walk-317621@post-2025-06-03",
   "gameId": "the-midnight-walk-317621",
   "displayName": "New improvements on Steam!",
   "kind": "major",
   "kindBasis": "inferred",
   "announcedAt": "2025-06-03T15:31:39.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Thank you again for the great reception our game has been getting. We have been working on some requested updates - including a fix for DLSS, options for turn speed and more haptics - and are happy to let you know that the following has now been implemented:",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "DLSS: Fixed an issue where DLSS could not be activated.,",
       "ps5ProOnly": false,
       "pcOnly": true,
       "category": "other",
       "platforms": [
        "pc"
       ]
      },
      {
       "text": "Added options for turn speeds in standard mode and VR.,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Added additional haptics,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Changed standard VR brightness to 60%,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "VR vignette settings fixes.,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Fixed a bug where the player was unable to progress past finding the singing clay head.,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Fixed a bug where the cutscene showing Housy getting kidnapped was not playing.,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "General collision fixes.,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Audio improvements were made.,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Made performance improvements when ShadowQuality is set to low.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Thank you again from us and from Potboy!🔥",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
