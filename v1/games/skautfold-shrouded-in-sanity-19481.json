  {
   "id": "skautfold-shrouded-in-sanity-19481@post-2019-08-29",
   "gameId": "skautfold-shrouded-in-sanity-19481",
   "displayName": "Moonless Knight release date!",
   "kind": "patch",
   "kindBasis": "inferred",
   "announcedAt": "2019-08-29T19:25:06.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "October 31st 2019.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Yes, in two months.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "I could release early October but I rather make sure I polish it up as much as possible.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It already contains more options and comfort settings than all 3 of my games combined, which is hard as the engine can be a total headache.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Overall this game will feature the widest spectrum of gameplay styles of my games yet, with the absolute most open structure yet. More open than basically any Metroidvania, but not falling over the edge into open world.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "It has been a really hard time for me both due to financial difficulties and struggling with depression, still I feel like this will be by far my best work yet.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
