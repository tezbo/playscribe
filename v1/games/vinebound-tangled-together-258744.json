  {
   "id": "vinebound-tangled-together-258744@1.0.3",
   "gameId": "vinebound-tangled-together-258744",
   "displayName": "Patch 1.0.3",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-06-05T00:04:21.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hey all, we've just released a small update adding support to additional languages and with some minor bug fixes!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The game is now localized in Spanish, French, Traditional Chinese, German, and Japanese!,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Added d-pad support to select a character before the run.,",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Bug Fix: Fixed QuickLeaf Boots issue where if both characters had the boots, whenever one of the character upgraded their boots the other one would lose their buff.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Bug Fix: Fixed language not being saved after changing it in the options menu.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "As always thanks for all the positive feedback so far!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
