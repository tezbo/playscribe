  {
   "id": "vinebound-tangled-together-258744@major-2024-02-12",
   "gameId": "vinebound-tangled-together-258744",
   "displayName": "- New Update - Steam Remote Play Together",
   "kind": "major",
   "kindBasis": "studio",
   "announcedAt": "2024-02-12T19:12:33.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "Hello everyone!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "We are part of the Remote Play Together Fest! And because of that, we decided to release a new update to our demo!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "This update includes",
     "items": [
      {
       "text": "New Sauce: Shocking Mustard - When hitting enemies you have the chance to create electric attacks that jump to nearby enemies and deal damage to them.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Item: Smackback Helmet - When you take damage, you deal damage to neaby enemies too.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "New Item: Veggie Puff Pump - Makes all your attacks bigger!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Reroll Feature: Now you can refresh your upgrade options during level up! You can reroll up to 3 times per run to find that card you are looking for.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "New Elite Enemies behaviors and art.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "new"
      },
      {
       "text": "Balancing adjustments.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "Go call a friend and play together locally or online (with remote play)!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    }
   ],
