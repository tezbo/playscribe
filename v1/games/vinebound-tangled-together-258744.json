  {
   "id": "vinebound-tangled-together-258744@1.0.2",
   "gameId": "vinebound-tangled-together-258744",
   "displayName": "Patch 1.0.2",
   "kind": "patch",
   "kindBasis": "studio",
   "announcedAt": "2025-04-26T21:27:45.000Z",
   "notes": [
    {
     "title": "Changes",
     "items": [
      {
       "text": "This patch brings some small changes we were able to address right away!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      },
      {
       "text": "The main change is the removal of character swapping in single-player mode. After seeing how it impacted gameplay, we decided it wasn’t improving the experience as intended. Let us know if you have any thoughts on this change!",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Changes",
     "items": [
      {
       "text": "Removed the ability to swap character controls in single-player mode.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "other"
      }
     ]
    },
    {
     "title": "Fixes",
     "items": [
      {
       "text": "Fixed issues that could prevent completing the Juice Extravaganza and Pest Control achievements.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      },
      {
       "text": "Corrected small text errors in some cards.",
       "ps5ProOnly": false,
       "pcOnly": false,
       "category": "fixed"
      }
     ]
    }
   ],
