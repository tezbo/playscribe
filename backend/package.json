{
  "name": "playscribe-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx --no-warnings=ExperimentalWarning src/index.ts",
    "ingest": "node --import tsx --no-warnings=ExperimentalWarning src/cli/ingest.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-sqlite --no-warnings=ExperimentalWarning \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "fast-xml-parser": "5.11.2",
    "hono": "4.13.13",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
